    "format\tcrexx-rag.profile/1\nprofile\twindow-profile\t1\nconcept\tperson\nconcept\tplace\nrelationship\trelated-to\trelated-to\tfalse\nchunk\t6000\t180\tplain,markdown\nweight\tlexical\t1000000\nprompt\tadvisory\t1\twindow-advisory\nprompt\textractor\t1\twindow-extractor\nvalidator\tdirection-required\n")
