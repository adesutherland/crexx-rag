execute_process(COMMAND ${offline} "${CPRAG_PROBE}" "${CPRAG_MODEL}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
file(WRITE "${CPRAG_WORK_DIR}/probe.log" "${output}${error}")
if(NOT result EQUAL 0 OR NOT output MATCHES "EMBEDDING_WINDOWS_OK")
    message(FATAL_ERROR "Native window contract failed: ${output}${error}")
endif()

