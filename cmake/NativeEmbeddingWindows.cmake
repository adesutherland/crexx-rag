string(JSON job GET "${last_output}" records 0 fields job_id)
# Interrupt after the whole multi-vector response is durable but before its
# second link can commit. The same task must recover the saved complete list.
sql("UPDATE job_items SET priority=CASE WHEN json_extract(input_json,'$.text') LIKE 'The travellers%' THEN 1000 ELSE 0 END;CREATE TRIGGER window_link_fault BEFORE INSERT ON revision_chunk_embeddings WHEN (SELECT count(*) FROM revision_chunk_embeddings WHERE revision_chunk_id=NEW.revision_chunk_id)=1 BEGIN SELECT RAISE(ABORT,'injected second window link failure'); END;" "")
execute_process(COMMAND ${cli} --access control worker run --once --job "${job}"
    RESULT_VARIABLE status OUTPUT_VARIABLE interrupted ERROR_VARIABLE error TIMEOUT 30)
file(APPEND "${CPRAG_WORK_DIR}/commands.log" "receipt fault\nstatus=${status}\n${interrupted}${error}\n")
if(NOT "${status}" MATCHES "^[0-9]+$" OR status EQUAL 0)
    message(FATAL_ERROR "Second window link fault did not interrupt publication: ${interrupted}${error}")
endif()
sql("SELECT count(*) FROM embeddings" "0")
sql("SELECT count(*) FROM revision_chunk_embeddings" "0")
sql("SELECT count(*) FROM job_items WHERE state='processed'" "0")
sql("SELECT count(*) FROM job_events WHERE event_type='provider-response'" "1")
sql("DROP TRIGGER window_link_fault;UPDATE job_items SET lease_until=unixepoch()-1 WHERE state='running';" "")
