# Seed one source-backed graph fact in this test-only library so replacement
# proves preservation of nonempty graph rows, not only zero counts.
sql("INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('castle','Edinburgh Castle','place','active',1),('rock','Castle Rock','place','active',1);INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('castle-rock','castle','related-to','rock','forward','{}','window-fixture',1);INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) SELECT 'castle-support','castle-rock',revision_chunk_id,0,length(CAST(text AS BLOB)),'positive','asserted','direct','','castle-lineage','window-fixture',1 FROM revision_chunks JOIN chunk_contents USING(content_id) WHERE text LIKE 'Edinburgh Castle%';" "")
execute_process(COMMAND "${sqlite_cli}" "${library}/library.sqlite"
    "SELECT * FROM concepts ORDER BY concept_id;SELECT * FROM claims ORDER BY claim_id;SELECT * FROM claim_support ORDER BY support_id;"
    OUTPUT_VARIABLE before_graph OUTPUT_STRIP_TRAILING_WHITESPACE)
