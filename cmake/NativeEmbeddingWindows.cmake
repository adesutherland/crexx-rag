file(WRITE "${CPRAG_WORK_DIR}/source/islands.txt" "${long_text}At the end of their voyage they visited the abbey on Iona.\n")
file(WRITE "${CPRAG_WORK_DIR}/source/edinburgh.txt" "Edinburgh Castle stands on Castle Rock above the city of Edinburgh.\n")
file(READ "${CPRAG_CONFIG_TEMPLATE}" config)
string(CONFIGURE "${config}" config @ONLY)
string(REPLACE "profiles = it-architecture-profile" "profiles = window-profile\nprofile.window-profile.file = ./window.profile.tsv" config "${config}")
string(REPLACE "discovery.mode = all" "discovery.mode = maintenance" config "${config}")
string(REPLACE "provider.gemini-embed.kind = gemini" "provider.gemini-embed.kind = llama" config "${config}")
string(REPLACE "provider.gemini-embed.base_url = http://127.0.0.1:1/gemini/v1beta" "provider.gemini-embed.base_url = llama://local" config "${config}")
string(REPLACE "provider.gemini-embed.model = gemini-embedding-2" "provider.gemini-embed.model = bge-small-en-v1.5\nprovider.gemini-embed.model_path = ${CPRAG_MODEL}" config "${config}")
string(REPLACE "provider.gemini-embed.credential = env:CPRAG_FIXTURE_GEMINI_KEY" "provider.gemini-embed.credential = none" config "${config}")
string(REPLACE "gemini-embed" "local-bge" config "${config}")
string(REPLACE "budget.item_limit = 2" "budget.item_limit = 20" config "${config}")
string(REPLACE "budget.model_calls = 2" "budget.model_calls = 20" config "${config}")
string(REPLACE "budget.input_tokens = 8192" "budget.input_tokens = 65536" config "${config}")
string(APPEND config "\nmaintenance.mode = automatic\nmaintenance.batch_items = 4\nmaintenance.window_seconds = 60\nvector.centroids = 1\nvector.probes = 1\n")
set(config_file "${CPRAG_WORK_DIR}/local.conf")
file(WRITE "${config_file}" "${config}")
set(library "${CPRAG_WORK_DIR}/library")
set(cli "${CMAKE_COMMAND}" -E env "CREXXRAG_SELF=${CPRAG_NATIVE_APPLICATION}"
    ${offline} "${CPRAG_NATIVE_APPLICATION}" --library "${library}"
    --config-file "${config_file}" --profile window-profile --format json --progress plain)
function(run_cli)
    execute_process(COMMAND ${cli} ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "${ARGN}\nstatus=${status}\n${output}${error}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Native embedding command failed: ${ARGN}\n${output}${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(sql query expected)
    execute_process(COMMAND "${sqlite_cli}" "${library}/library.sqlite" "${query}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
        message(FATAL_ERROR "Native embedding assertion: ${query}\nexpected=${expected}; actual=${output}\n${error}")
    endif()
endfunction()
run_cli(config check)
# Native route validation must fail before a model can be called.
foreach(bad IN ITEMS model credential)
    if(bad STREQUAL "model")
        string(REPLACE "provider.local-bge.model = bge-small-en-v1.5" "provider.local-bge.model = unqualified-model" bad_config "${config}")
    else()
        string(REPLACE "provider.local-bge.credential = none" "provider.local-bge.credential = env:SHOULD_NOT_BE_USED" bad_config "${config}")
    endif()
    file(WRITE "${config_file}" "${bad_config}")
    execute_process(COMMAND ${cli} config check RESULT_VARIABLE status OUTPUT_VARIABLE rejected ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${status}" MATCHES "^[0-9]+$" OR status EQUAL 0)
        message(FATAL_ERROR "Native invalid ${bad} accepted: ${rejected}${error}")
    endif()
endforeach()
file(WRITE "${config_file}" "${config}")
run_cli(--access admin library init)
run_cli(--access plan ingest plan --source-set architecture-docs)
string(JSON plan GET "${last_output}" records 0 fields canonical_plan)
string(JSON digest GET "${last_output}" records 0 fields digest)
