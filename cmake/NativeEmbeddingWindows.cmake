sql("SELECT count(*) FROM revision_chunk_embeddings WHERE revision_chunk_id IN(SELECT revision_chunk_id FROM revision_chunks JOIN chunk_contents USING(content_id) WHERE text LIKE 'Edinburgh Castle%')" "1")
