    run_cli(--access control maintain retry "${task}" --reason duplicate)
    string(JSON duplicate GET "${last_output}" records 0 fields retry_request_id)
    if(NOT request STREQUAL duplicate)
        message(FATAL_ERROR "Item/task retry did not reuse the durable request")
    endif()
endforeach()
