            string(JSON item GET "${detail}" item_id)
            string(JSON task GET "${detail}" task_id)
            if(item STREQUAL limit_item)
                set(limit_task "${task}")
            elseif(item STREQUAL unknown_item)
                set(unknown_task "${task}")
            endif()
        endif()
    endforeach()
    if(NOT limit_task OR NOT unknown_task)
        message(FATAL_ERROR "Public item discovery omitted held task identities")
    endif()
    run_cli(--access read maintain inspect "${unknown_task}")
    if(NOT last_output MATCHES "provider-outcome-uncertain")
        message(FATAL_ERROR "Public task inspection omitted unknown outcome hold")
    endif()
    execute_process(COMMAND ${cli} --access control maintain waive "${limit_task}" --reason "Accept this missing embedding for this evidence and policy"
        RESULT_VARIABLE waiver_status OUTPUT_VARIABLE waiver_output ERROR_VARIABLE waiver_errors TIMEOUT 30)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "maintain waive limit task\n${waiver_output}${waiver_errors}\n")
    if(NOT waiver_status EQUAL 0)
        string(APPEND journey_errors " Public reasoned waiver unavailable: ${waiver_output}${waiver_errors}")
    else()
        string(JSON waiver_id GET "${waiver_output}" records 0 fields waiver_id)
        run_cli(--access control maintain waive "${limit_task}" --reason "Duplicate request retains original reason")
        string(JSON duplicate GET "${last_output}" records 0 fields waiver_id)
        if(NOT duplicate STREQUAL waiver_id)
            message(FATAL_ERROR "Repeated waiver created a new decision")
        endif()
        call_mcp(rag_task_waive "{\"id\":\"${unknown_task}\",\"reason\":\"must be denied\"}" read)
        if(last_status EQUAL 0)
            message(FATAL_ERROR "Read-only MCP caller could waive work")
        endif()
        call_mcp(rag_task_waive "{\"id\":\"${unknown_task}\"}" control)
        if(last_status EQUAL 0)
            message(FATAL_ERROR "MCP accepted a waiver without a reason")
        endif()
        call_mcp(rag_task_waive "{\"id\":\"${unknown_task}\",\"reason\":\"Close operator work, provider outcome remains unknown\"}" control)
        if(NOT last_status EQUAL 0)
            message(FATAL_ERROR "MCP reasoned waiver failed: ${last_output}${last_error}")
        endif()
        run_cli(--access read job status "${closed_job}")
        string(JSON uncertain GET "${last_output}" records 0 fields uncertain_items)
        string(JSON unknown_times GET "${last_output}" records 0 fields timestamp_unknown_runs)
        if(NOT uncertain EQUAL 1 OR NOT unknown_times EQUAL historic_calls)
            message(FATAL_ERROR "Waiver hid uncertain outcomes or incomplete historic timestamps")
        endif()
        run_cli(--access read maintain tasks --id "${limit_task}")
        if(NOT last_output MATCHES "waived")
            message(FATAL_ERROR "Task list hides operator waiver")
        endif()
        report_coverage(3)
        check_recovery_report(3 0 2)
        apply_window()
        set(backlog "${window_backlog}")
        string(JSON missing GET "${backlog}" embedding_missing)
        string(JSON waived GET "${backlog}" waived_tasks)
        if(NOT missing EQUAL 2 OR NOT waived EQUAL 2)
            message(FATAL_ERROR "Waiver hides missing coverage or active disposition: ${backlog}")
        endif()
        assert_sql("SELECT count(*) FROM maintenance_task_items;" "8")
        assert_sql("SELECT count(*) FROM provider_runs;" "10")
        assert_sql("SELECT count(*) FROM maintenance_task_waivers WHERE state='active';" "2")
        # Retry reopens work; neither an exhausted ceiling nor uncertainty is reset.
        foreach(task IN ITEMS "${limit_task}" "${unknown_task}")
            run_cli(--access control maintain retry "${task}" --reason "Reconsider without increasing allowance")
            run_cli(--access read maintain inspect "${task}")
            if(NOT last_output MATCHES "reopened")
                message(FATAL_ERROR "Retry did not retain and reopen the waiver")
            endif()
        endforeach()
        assert_sql("SELECT count(*) FROM maintenance_task_waivers WHERE state='reopened';" "2")
        assert_sql("SELECT count(*) FROM retry_requests WHERE state='pending' AND disposition IN('attempt-limit','provider-outcome-uncertain') AND task_id NOT LIKE 'task:matrix-%';" "2")
        apply_window()
        assert_sql("SELECT count(*) FROM maintenance_task_items;" "8")
        report_coverage(3)
        check_recovery_report(3 2 0)
        query(history_after_waiver "${history_sql}")
        if(NOT history_before STREQUAL history_after_waiver)
            message(FATAL_ERROR "Waive/reopen changed historical attempts, receipts or usage")
        endif()
    endif()
endif()
assert_sql("SELECT sum(reserved_calls+reserved_tokens+reserved_cost+reserved_codex_turns) FROM jobs;" "0")
assert_sql("PRAGMA integrity_check;" "ok")
assert_sql("PRAGMA foreign_key_check;" "")
run_cli(--access diagnose library verify)
if(journey_errors)
    message(FATAL_ERROR "PUBLIC_RECOVERY_GAPS: ${journey_errors}")
endif()
message(STATUS "LIFECYCLE_RECOVERY_OK failures=5 calls=${successful} history=preserved requests=durable live-owner=deduplicated")
