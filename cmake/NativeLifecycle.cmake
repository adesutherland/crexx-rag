UPDATE job_items SET state='dead_letter',fence=1 WHERE job_id='${closed_job}';
INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,provider_run_id,started_at,completed_at)
 SELECT 'historic-'||item_id,item_id,'historic-worker',1,input_hash,'quota-rejected','dead_letter','historic-'||item_id,'historic','historic' FROM job_items WHERE job_id='${closed_job}';
INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at)
 SELECT job_id,item_id,'historic-'||item_id,'fixture-history','retain original failure','historic' FROM job_items WHERE job_id='${closed_job}';
UPDATE maintenance_tasks SET state='failed' WHERE task_id IN(SELECT task_id FROM maintenance_task_items WHERE window_id IN(SELECT window_id FROM maintenance_windows WHERE job_id='${closed_job}'));
UPDATE maintenance_windows SET state='complete',closed_epoch=1,deadline_epoch=1 WHERE job_id='${closed_job}';
UPDATE jobs SET state='completed' WHERE job_id='${closed_job}'; COMMIT;")
