endif()
set(history_sql "SELECT json_group_array(json(record)) FROM(SELECT json_object('item_id',i.item_id,'input',i.input_json,'input_hash',i.input_hash,'item_state',i.state,'fence',i.fence,'attempt_id',a.attempt_id,'attempt_input',a.input_hash,'attempt_outcome',a.outcome,'validation',a.validation_state,'worker',a.worker_id,'run',p.provider_run_id,'outcome',p.outcome,'input_tokens',p.input_tokens,'output_tokens',p.output_tokens,'cost',p.cost_microunits,'duration',p.duration_ms,'recovery',p.recovery_json) AS record FROM job_items i JOIN attempts a ON a.item_id=i.item_id JOIN provider_runs p ON p.provider_run_id=a.provider_run_id WHERE i.job_id='${closed_job}' ORDER BY a.attempt_id);")
