function(run_cli)
    execute_process(COMMAND ${cli} ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "${ARGN}\nstatus=${status}\n${output}${errors}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Lifecycle command failed: ${ARGN}\n${output}${errors}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(call_mcp tool arguments access)
    string(REPLACE "\n" "" arguments "${arguments}")
    file(WRITE "${CPRAG_WORK_DIR}/request.jsonl"
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n"
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"${tool}\",\"arguments\":${arguments}}}\n")
    execute_process(COMMAND ${cli} --access "${access}" serve mcp
        WORKING_DIRECTORY "${CPRAG_WORK_DIR}" INPUT_FILE "${CPRAG_WORK_DIR}/request.jsonl"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "MCP ${tool} ${arguments}\nexit=${status}\n${output}${errors}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "MCP process failed: ${status}\n${output}${errors}")
    endif()
    # Parse each response by ID, rather than accepting a success from another call.
    file(WRITE "${CPRAG_WORK_DIR}/response.jsonl" "${output}")
    file(STRINGS "${CPRAG_WORK_DIR}/response.jsonl" responses ENCODING UTF-8)
    set(found 0)
    foreach(response IN LISTS responses)
        string(JSON id GET "${response}" id)
        if(id EQUAL 2)
            math(EXPR found "${found}+1")
            string(JSON result ERROR_VARIABLE parse_error GET "${response}" result structuredContent)
            if(parse_error)
                string(JSON status GET "${response}" error code)
                string(JSON errors GET "${response}" error message)
                set(result "")
            else()
                string(JSON status GET "${result}" exit_code)
            endif()
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "MCP did not return exactly one response for ID 2")
    endif()
    set(last_status "${status}" PARENT_SCOPE)
    set(last_output "${result}" PARENT_SCOPE)
    set(last_error "${errors}" PARENT_SCOPE)
endfunction()
# Public counts must describe the same snapshot and distinguish an allowance
# from actual work. Checks accumulate so held fixture providers are released.
function(check_job_counts expected_items)
    string(JSON planned GET "${last_output}" records 0 fields planned_total)
    string(JSON item_limit ERROR_VARIABLE missing_limit GET "${last_output}" records 0 fields item_limit)
    set(total 0)
    foreach(state queued running processed skipped dead_letter cancelled)
        string(JSON count GET "${last_output}" records 0 fields "${state}")
        math(EXPR total "${total}+${count}")
    endforeach()
    if(NOT planned EQUAL expected_items OR NOT total EQUAL expected_items OR missing_limit OR NOT item_limit EQUAL 100)
        set(journey_errors "${journey_errors} Public job denominator: expected ${expected_items} items and separate limit 100; planned=${planned}, states=${total}, limit=${item_limit}." PARENT_SCOPE)
    endif()
endfunction()
function(report_coverage expected)
    run_cli(--access read library report --narrative off)
    string(JSON count LENGTH "${last_output}" records)
    math(EXPR end "${count}-1")
    set(found FALSE)
    foreach(i RANGE 0 ${end})
        string(JSON kind GET "${last_output}" records ${i} kind)
        if(kind STREQUAL "vector-stat")
            string(JSON covered GET "${last_output}" records ${i} fields active_embeddings)
            if(NOT covered EQUAL expected)
                message(FATAL_ERROR "Public coverage changed: expected ${expected}, got ${covered}")
            endif()
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Public report omitted vector coverage")
    endif()
endfunction()
function(check_recovery_report expected_resolved expected_actionable expected_waived)
    run_cli(--access read library report --narrative off)
    string(JSON count LENGTH "${last_output}" records)
    math(EXPR end "${count}-1")
    set(found 0)
    foreach(i RANGE 0 ${end})
        string(JSON kind GET "${last_output}" records ${i} kind)
        if(kind STREQUAL "maintenance-backlog")
            foreach(metric resolved actionable waived)
                string(JSON value ERROR_VARIABLE missing GET "${last_output}" records ${i} fields "${metric}_dead_letters")
                if(missing OR NOT value EQUAL expected_${metric})
                    set(journey_errors "${journey_errors} Public report ${metric} failures: expected ${expected_${metric}}, got ${value}." PARENT_SCOPE)
                endif()
            endforeach()
            math(EXPR found "${found}+1")
        elseif(kind STREQUAL "durable-maintenance-backlog")
            string(JSON waived ERROR_VARIABLE missing GET "${last_output}" records ${i} fields waived_tasks)
            string(JSON open GET "${last_output}" records ${i} fields open_tasks)
            string(JSON unwaived ERROR_VARIABLE missing_open GET "${last_output}" records ${i} fields unwaived_open_tasks)
            if(missing OR missing_open OR NOT waived EQUAL expected_waived)
                set(journey_errors "${journey_errors} Public report omits operator dispositions." PARENT_SCOPE)
            else()
                math(EXPR combined "${unwaived}+${waived}")
                if(NOT combined EQUAL open)
                    message(FATAL_ERROR "Disposition hides original unresolved outcomes")
                endif()
            endif()
            math(EXPR found "${found}+1")
        endif()
    endforeach()
    if(NOT found EQUAL 2)
        message(FATAL_ERROR "Public recovery report omitted its backlog records")
    endif()
endfunction()
function(query output sql)
    execute_process(COMMAND "${sqlite_cli}" -cmd ".timeout 5000" "${library}/library.sqlite" "${sql}"
        RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE errors OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Lifecycle SQL: ${sql}\n${errors}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(assert_sql sql expected)
    query(value "${sql}")
    if(NOT value STREQUAL "${expected}")
        message(FATAL_ERROR "Lifecycle assertion: ${sql}\nExpected ${expected}; got ${value}")
    endif()
endfunction()
function(await_file path pattern)
    foreach(poll RANGE 1 500)
        if(EXISTS "${path}")
            file(READ "${path}" content)
            if(content MATCHES "${pattern}")
                return()
            endif()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.02)
    endforeach()
    message(FATAL_ERROR "Lifecycle rendezvous missing: ${path} ${pattern}")
endfunction()
