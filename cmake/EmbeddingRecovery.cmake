# Product recovery through the public native CLI and local Gemini protocol.
foreach(required_var CPRAG_NATIVE_APPLICATION CPRAG_LOOPBACK CPRAG_CONFIG_TEMPLATE CPRAG_WORK_DIR)
    if(NOT DEFINED ${required_var})
        message(FATAL_ERROR "${required_var} is required")
    endif()
endforeach()
find_program(sqlite_cli sqlite3 REQUIRED)
file(REMOVE_RECURSE "${CPRAG_WORK_DIR}")
file(MAKE_DIRECTORY "${CPRAG_WORK_DIR}/source")
set(documents 32)
set(requests 34)
set(scenario embedding-recovery)
if(CPRAG_EXHAUSTION)
    set(documents 2)
    set(requests 7)
    set(scenario embedding-exhaustion)
endif()
foreach(item RANGE 1 ${documents})
    file(WRITE "${CPRAG_WORK_DIR}/source/${item}.txt"
        "Document ${item}. BillingService depends on CustomerDatabase.\n")
endforeach()
set(CPRAG_FIXTURE_PORT 19031)
if(CPRAG_EXHAUSTION)
    set(CPRAG_FIXTURE_PORT 19032)
endif()
set(CPRAG_FIXTURE_SOURCE "${CPRAG_WORK_DIR}/source")
set(CPRAG_FIXTURE_GLOSSARY "${CPRAG_WORK_DIR}/glossary.tsv")
file(WRITE "${CPRAG_FIXTURE_GLOSSARY}" "format\tcrexx-rag.glossary/1\n")
file(READ "${CPRAG_CONFIG_TEMPLATE}" config)
string(CONFIGURE "${config}" config @ONLY)
string(REPLACE "budget.item_limit = 2" "budget.item_limit = 1000" config "${config}")
string(REPLACE "budget.model_calls = 2" "budget.model_calls = 1000" config "${config}")
string(REPLACE "worker.processes = 2" "worker.processes = 8" config "${config}")
string(REPLACE "provider.gemini-embed.max_attempts = 1" "provider.gemini-embed.max_attempts = 6" config "${config}")
string(APPEND config "\nmaintenance.mode = automatic\nmaintenance.window_seconds = 180\nmaintenance.maximum_attempts = 6\nmaintenance.batch_items = 8\nprovider.gemini-embed.initial_backoff_ms = 1000\nprovider.gemini-embed.maximum_backoff_ms = 60000\nprovider.gemini-embed.jitter_ms = 0\nprovider.gemini-embed.concurrent_requests = 1\nprovider.gemini-embed.requests_per_minute = 1000\nprovider.gemini-embed.tokens_per_minute = 1000000\n")
file(WRITE "${CPRAG_WORK_DIR}/recovery.conf" "${config}")
set(library "${CPRAG_WORK_DIR}/library")
set(cli "${CMAKE_COMMAND}" -E env "CPRAG_FIXTURE_GEMINI_KEY=synthetic-product-gemini-key"
    "CREXXRAG_SELF=${CPRAG_NATIVE_APPLICATION}" "${CPRAG_NATIVE_APPLICATION}"
    --library "${library}" --config-file "${CPRAG_WORK_DIR}/recovery.conf"
    --profile it-architecture-profile --format json --progress plain)
function(run_cli)
    execute_process(COMMAND ${cli} ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "${ARGN}\nstatus=${status}\n${output}${errors}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Embedding recovery command failed: ${ARGN}\n${output}${errors}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(sql query expected)
    execute_process(COMMAND "${sqlite_cli}" "${library}/library.sqlite" "${query}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
        message(FATAL_ERROR "Embedding assertion: ${query}\nExpected ${expected}; got ${output}\n${errors}")
    endif()
endfunction()
run_cli(--access admin library init)
run_cli(--access plan ingest plan --source-set architecture-docs)
string(JSON plan GET "${last_output}" records 0 fields canonical_plan)
string(JSON digest GET "${last_output}" records 0 fields digest)
run_cli(--access ingest ingest apply --plan-json "${plan}" --expect-digest "${digest}")
string(JSON ingestion GET "${last_output}" records 0 fields job_id)
run_cli(--access control job pause "${ingestion}")
run_cli(--access plan maintain plan --embeddings-only --minutes 3)
string(JSON plan GET "${last_output}" records 0 fields canonical_plan)
string(JSON digest GET "${last_output}" records 0 fields digest)
run_cli(--access curate maintain apply --plan-json "${plan}" --expect-digest "${digest}")
string(JSON job GET "${last_output}" records 0 fields job_id)
set(server_out "${CPRAG_WORK_DIR}/server.out")
set(server_err "${CPRAG_WORK_DIR}/server.err")
set(server_status "${CPRAG_WORK_DIR}/server.status")
execute_process(COMMAND /bin/sh -c
    "( \"$1\" \"$2\" ${requests} ${scenario}; printf '%s' $? >\"$5\" ) >\"$3\" 2>\"$4\" &"
    embedding-recovery "${CPRAG_LOOPBACK}" "${CPRAG_FIXTURE_PORT}" "${server_out}" "${server_err}" "${server_status}")
foreach(poll RANGE 1 200)
    if(EXISTS "${server_out}")
        file(READ "${server_out}" output)
        if(output MATCHES "READY ${CPRAG_FIXTURE_PORT}")
            break()
        endif()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.02)
endforeach()
run_cli(--access control worker start --count 8 --job "${job}" --poll-ms 20)
file(STRINGS "${server_out}" observed_calls REGEX "^EMBEDDING_CALL ")
foreach(observed IN LISTS observed_calls)
    if(observed MATCHES "identity=([^ ]+) attempt=([0-9]+) status=([0-9]+) epoch_ms=([0-9]+)")
        string(SHA256 identity_key "${CMAKE_MATCH_1}")
        set(ordinal "${CMAKE_MATCH_2}")
        set(timestamp "${CMAKE_MATCH_4}")
        if(ordinal GREATER 1)
            math(EXPR spacing "${timestamp}-${last_${identity_key}}")
            math(EXPR required_spacing "1000 * (1 << (${ordinal}-2))")
            if(spacing LESS required_spacing)
                message(FATAL_ERROR "Retry ${ordinal} arrived early: ${spacing}ms < ${required_spacing}ms")
            endif()
        endif()
        set(last_${identity_key} "${timestamp}")
    endif()
endforeach()
if(CPRAG_EXHAUSTION)
    sql("SELECT count(*) FROM provider_runs WHERE outcome='failed';" "6")
    sql("SELECT count(*) FROM provider_runs WHERE outcome='succeeded';" "1")
    sql("SELECT count(*) FROM job_items WHERE job_id='${job}' AND state='dead_letter';" "1")
    sql("SELECT state FROM jobs WHERE job_id='${job}';" "completed_with_errors")
    sql("SELECT sum(reserved_calls+reserved_tokens+reserved_cost+reserved_codex_turns) FROM jobs;" "0")
    sql("SELECT count(*) FROM attempts WHERE outcome='running';" "0")
    # Represent a held phase-two task carrying prior provider history. The
    # next embedding window must preserve it and enforce the call ceiling
    # through a newly discovered embedding task, not the old failed task.
    sql("UPDATE maintenance_tasks SET kind='phase-two-held',state='pending' WHERE task_id IN(SELECT m.task_id FROM maintenance_task_items m JOIN job_items i USING(item_id) WHERE i.job_id='${job}' AND i.state='dead_letter');" "")
    # A fresh controller and a fresh maintenance window cannot reset six calls.
    run_cli(--access control worker start --count 8 --job "${job}" --poll-ms 20)
    run_cli(--access plan maintain plan --embeddings-only --minutes 3)
    string(JSON plan GET "${last_output}" records 0 fields canonical_plan)
    string(JSON digest GET "${last_output}" records 0 fields digest)
    run_cli(--access curate maintain apply --plan-json "${plan}" --expect-digest "${digest}")
    string(JSON second_job GET "${last_output}" records 0 fields job_id)
    run_cli(--access control worker start --count 8 --job "${second_job}" --poll-ms 20)
    sql("SELECT count(*) FROM provider_runs;" "7")
    sql("SELECT count(*) FROM maintenance_tasks WHERE kind='phase-two-held' AND state='pending';" "1")
    sql("SELECT count(*) FROM revision_chunks r WHERE NOT EXISTS(SELECT 1 FROM revision_chunk_embeddings e WHERE e.revision_chunk_id=r.revision_chunk_id AND e.visible_to_generation IS NULL);" "1")
    sql("SELECT state FROM jobs WHERE job_id='${ingestion}';" "paused")
    file(READ "${server_status}" server_exit)
    if(NOT server_exit STREQUAL "0")
        message(FATAL_ERROR "Exhaustion fixture did not observe exactly seven calls")
    endif()
    message(STATUS "EMBEDDING_EXHAUSTION_OK workers=8 calls=7 ceiling=6 restarts=preserved incomplete=reported")
    return()
endif()
sql("SELECT count(*) FROM job_items WHERE job_id='${job}' AND item_type='embedding' AND state='processed';" "32")
sql("SELECT count(*) FROM job_items WHERE job_id='${job}' AND item_type<>'embedding';" "0")
