sql("INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) SELECT 'cache-job','cache-plan','{}',config_snapshot_id,'queued',1,1,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at FROM jobs WHERE job_id='${ingestion}'; INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) SELECT 'cache-item','cache-job','embedding','queued',100,'cache-key',input_hash,input_json,created_at,updated_at FROM job_items WHERE job_id='${ingestion}' AND item_type='embedding' ORDER BY item_id LIMIT 1;" "")
