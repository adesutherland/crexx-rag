function(sql query expected)
    execute_process(COMMAND "${sqlite_cli}" -cmd ".timeout 5000" "${database}" "${query}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors
        OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 20)
    if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
        message(FATAL_ERROR "SQL fixture/assertion failed: ${query}\nExpected ${expected}; got ${output}\n${errors}")
    endif()
endfunction()

function(call_cli format)
    execute_process(COMMAND ${cli} --format "${format}" ${ARGN}
        WORKING_DIRECTORY "${CPRAG_WORK_DIR}" RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "CLI ${format} ${ARGN}\nexit=${status}\n${output}${errors}\n")
    set(last_status "${status}" PARENT_SCOPE)
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${errors}" PARENT_SCOPE)
endfunction()

function(call_mcp tool arguments access)
    string(REPLACE "\n" "" arguments "${arguments}")
    file(WRITE "${CPRAG_WORK_DIR}/request.jsonl"
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n"
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"${tool}\",\"arguments\":${arguments}}}\n")
    execute_process(COMMAND ${cli} --access "${access}" serve mcp
        WORKING_DIRECTORY "${CPRAG_WORK_DIR}" INPUT_FILE "${CPRAG_WORK_DIR}/request.jsonl"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    file(APPEND "${CPRAG_WORK_DIR}/commands.log" "MCP ${tool} ${arguments}\nexit=${status}\n${output}${errors}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "MCP process failed: ${status}\n${output}${errors}")
    endif()
    # Parse each response by ID, rather than accepting a success from another call.
    file(WRITE "${CPRAG_WORK_DIR}/response.jsonl" "${output}")
    file(STRINGS "${CPRAG_WORK_DIR}/response.jsonl" responses ENCODING UTF-8)
    set(found 0)
    foreach(response IN LISTS responses)
        string(JSON id GET "${response}" id)
        if(id EQUAL 2)
            math(EXPR found "${found}+1")
            string(JSON result ERROR_VARIABLE parse_error GET "${response}" result structuredContent)
            if(parse_error)
                string(JSON status GET "${response}" error code)
                string(JSON errors GET "${response}" error message)
                set(result "")
            else()
                string(JSON status GET "${result}" exit_code)
            endif()
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "MCP did not return exactly one response for ID 2")
    endif()
    set(last_status "${status}" PARENT_SCOPE)
    set(last_output "${result}" PARENT_SCOPE)
    set(last_error "${errors}" PARENT_SCOPE)
endfunction()

macro(require_status expected)
    if(NOT "${last_status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected exit ${expected}, got ${last_status}: ${last_output}${last_error}")
    endif()
endmacro()

macro(require_json expected)
    string(JSON actual GET "${last_output}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${actual}")
    endif()
endmacro()

# These are ordinary failing assertions, never WILL_FAIL or a skipped test.
# Recognize a known diagnosis only after the positive control has succeeded.
macro(expect_repaired issue known_message)
    if(NOT "${last_status}" STREQUAL "0")
        if(NOT "${last_output}${last_error}" MATCHES "${known_message}")
            message(FATAL_ERROR "Unexpected failure in ${issue}: ${last_status}: ${last_output}${last_error}")
        endif()
        list(APPEND defects "${issue}: ${surface}: ${known_message}")
    endif()
endmacro()

