            foreach(page RANGE 0 101)
                set(cursor_option)
                if(NOT cursor STREQUAL "")
                    set(cursor_option --cursor "${cursor}")
                endif()
                call_cli(json --access read review list --limit "${limit}" ${cursor_option})
                require_status(0)
                string(JSON count LENGTH "${last_output}" records)
                set(cursor "")
                if(count GREATER 0)
                    math(EXPR end "${count}-1")
                    foreach(row RANGE 0 ${end})
                        string(JSON kind GET "${last_output}" records ${row} kind)
                        if(kind STREQUAL "page")
                            string(JSON cursor GET "${last_output}" records ${row} fields next_cursor)
                        else()
                            string(JSON identity GET "${last_output}" records ${row} fields identity)
                            string(REGEX REPLACE "^review-0*" "" ordinal "${identity}")
