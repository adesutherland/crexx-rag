                                set(ordinal 0)
                            endif()
                            if(NOT ordinal EQUAL seen)
                                message(FATAL_ERROR "limit=${limit}: missing, repeated or unordered row ${identity}; wanted ${seen}")
                            endif()
                            math(EXPR seen "${seen}+1")
