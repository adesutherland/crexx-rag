file(WRITE "${CPRAG_FIXTURE_GLOSSARY}" "format\tcrexx-rag.glossary/1\n")
foreach(path IN ITEMS wanted.txt extra.txt note.md nested/wanted.txt nested/extra.md nested/deep/last.txt ignored.pdf)
