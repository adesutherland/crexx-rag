options levelb

import rxfnsb
import sqlite_boundary
import record_boundary
import record_facade

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_REC_01_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 1 then return 2
database_path = args[1]
errors = 0
database = .binary
errors = errors + check(sqliteopenmode(database_path, "create", database) = 0, "plugin database open")
errors = errors + check(sqliteexec(database, "CREATE TABLE typed_rows(sequence INTEGER PRIMARY KEY,passage TEXT NOT NULL,score REAL NOT NULL,note TEXT,fingerprint BLOB NOT NULL); INSERT INTO typed_rows VALUES(1,'Alpha',1.25,NULL,x'0102030405060708'),(2,'Gràdh 中',2.5,'',x'1112131415161718'),(3,'Gamma',3.75,'note-3',x'2122232425262728'),(4,'Delta',4.0,NULL,x'3132333435363738'),(5,'Epsilon',5.5,'note-5',x'4142434445464748'),(6,'Zeta',6.25,'last',x'5152535455565758')") = 0, "plugin typed seed")

direct = .typedrow[]
direct = loadrecords(database, 0, 2)
errors = errors + check(direct.0 = 2 & direct[1].sequence() = 1 & direct[2].sequence() = 2, "Level B record array return")
errors = errors + check(direct[1].passage() = "Alpha" & direct[2].passage() = "Gràdh 中", "typed text and Unicode")
errors = errors + check(direct[1].score() = (1.25 as .float) & direct[2].score() = (2.5 as .float), "typed real")
errors = errors + check(direct[1].note_kind() = "null" & direct[2].note_kind() = "text" & direct[2].note() = "", "typed null and empty")
direct_fingerprint = direct[1].fingerprint()
errors = errors + check(binlength(direct_fingerprint) = 8 & <at..u8>(0) direct_fingerprint = 1 & <at..u8>(7) direct_fingerprint = 8, "typed blob ownership")

facade = .typedrecordfacade()
middle = .typedrow[]
middle = facade.page(database, 2, 2)
errors = errors + check(middle.0 = 2 & middle[1].sequence() = 3 & middle[2].sequence() = 4, "Level G record array return")
errors = errors + check(facade.checksum(middle) = recordchecksum(middle), "Level G array invocation")

tail = .typedrow[]
tail = facade.page(database, 4, 4)
errors = errors + check(tail.0 = 2 & tail[1].sequence() = 5 & tail[2].sequence() = 6, "partial typed page")
tail_fingerprint = tail[2].fingerprint()
errors = errors + check(binlength(tail_fingerprint) = 8 & <at..u8>(0) tail_fingerprint = 81 & <at..u8>(7) tail_fingerprint = 88, "blob through Level G")
empty = .typedrow[]
empty = facade.page(database, 6, 2)
errors = errors + check(empty.0 = 0, "empty typed page")

checksum = recordchecksum(direct) + facade.checksum(middle) + recordchecksum(tail)
errors = errors + check(checksum > 0, "crossing checksum")
errors = errors + check(sqliteclose(database) = 0, "plugin database close")

if errors \= 0 then do
  say "P1_REC_01_ERRORS=" || errors
  return 1
end
say "P1_REC_01_OK plugin_columns=typed levelb_records=2 levelg_records=4 pages=2,2,2,0 blob_bytes=8 corpus_json_bytes=0 checksum=" || checksum
return 0
