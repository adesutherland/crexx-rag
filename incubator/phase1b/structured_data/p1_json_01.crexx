options levelg

import rxfnsb
import rxjson

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_JSON_01_FAIL=" || label
    return 1
  end
  return 0

bounded_json_object: procedure = .int
  arg keys = .string[], encoded_values = .string[], maximum_bytes = .int, expose encoded = .string, expose error = .string
  encoded = ""
  error = ""
  if keys.0 \= encoded_values.0 then do
    error = "key/value count mismatch"
    return -1
  end
  if maximum_bytes < 2 then do
    error = "maximum bytes must allow an empty object"
    return -1
  end
  candidate = "{"
  do i = 1 to keys.0
    separator = ""
    if i > 1 then separator = ","
    pair = separator || jsonquote(keys[i]) || ":" || encoded_values[i]
    if binlength(candidate as .binary) + binlength(pair as .binary) + 1 > maximum_bytes then do
      error = "encoded JSON exceeds " || maximum_bytes || " bytes"
      return -2
    end
    candidate = candidate || pair
  end
  encoded = candidate || "}"
  return 0

main: procedure = .int
arg args = .string[]
errors = 0

payload = '{"unicode":"Gr\u00e0dh \u4e2d \ud83d\ude00","null_value":null,"empty_text":"","empty_array":[],"empty_object":{},"items":["alpha",9223372036854775807,-1.25,false,null,[],{}],"escaped_key":{"a.b":"value"}}'
document = .jsondocument(payload)
root = document.root()
errors = errors + check(document.valid() = 1 & document.error_code() = "none", "valid parse-once document")
errors = errors + check(document.source() = payload & document.source_bytes() = binlength(payload as .binary), "source retained")
errors = errors + check(document.index_bytes() > 0 & document.node_count() >= 15, "owned structural index")
errors = errors + check(document.node_type(root) = "object" & document.node_count(root) = 7, "root object")

root_children = .int[]
errors = errors + check(document.children(root, root_children) = 7, "root iteration count")
expected_names = .string[]
expected_names[1] = "unicode"
expected_names[2] = "null_value"
expected_names[3] = "empty_text"
expected_names[4] = "empty_array"
expected_names[5] = "empty_object"
expected_names[6] = "items"
expected_names[7] = "escaped_key"
do i = 1 to expected_names.0
  errors = errors + check(document.node_name(root_children[i]) = expected_names[i], "object iteration name " || i)
end

unicode_node = document.member(root, "unicode")
unicode_value = ""
errors = errors + check(document.node_string(unicode_node, unicode_value) = 0 & unicode_value = "Gràdh 中 😀", "Unicode scalar decode")
missing_node = document.member(root, "missing")
null_node = document.member(root, "null_value")
empty_text_node = document.member(root, "empty_text")
empty_array_node = document.member(root, "empty_array")
empty_object_node = document.member(root, "empty_object")
empty_text = "sentinel"
errors = errors + check(missing_node = 0 & document.type("missing") = "missing", "missing distinction")
errors = errors + check(document.node_type(null_node) = "null" & document.node_get(null_node) = "null", "null distinction")
errors = errors + check(document.node_type(empty_text_node) = "string" & document.node_string(empty_text_node, empty_text) = 0 & empty_text = "", "empty string distinction")
errors = errors + check(document.node_type(empty_array_node) = "array" & document.node_count(empty_array_node) = 0, "empty array distinction")
errors = errors + check(document.node_type(empty_object_node) = "object" & document.node_count(empty_object_node) = 0, "empty object distinction")

items_node = document.member(root, "items")
items = .int[]
errors = errors + check(document.children(items_node, items) = 7, "typed array iteration")
expected_types = .string[]
expected_types[1] = "string"
expected_types[2] = "number"
expected_types[3] = "number"
expected_types[4] = "boolean"
expected_types[5] = "null"
expected_types[6] = "array"
expected_types[7] = "object"
do i = 1 to expected_types.0
  errors = errors + check(document.node_type(items[i]) = expected_types[i] & document.node_name(items[i]) = "" || i, "typed array element " || i)
end
text_value = ""
integer_value = 0
float_value = 0.0
boolean_value = 1
errors = errors + check(document.node_string(items[1], text_value) = 0 & text_value = "alpha", "typed string")
errors = errors + check(document.node_int(items[2], integer_value) = 0 & integer_value = 9223372036854775807, "typed int64")
errors = errors + check(document.node_float(items[3], float_value) = 0 & float_value = (-1.25 as .float), "typed real")
errors = errors + check(document.node_boolean(items[4], boolean_value) = 0 & boolean_value = 0, "typed boolean")
errors = errors + check(document.node_int(items[3], integer_value) = -3, "non-integral integer rejection")

escaped_object = document.member(root, "escaped_key")
errors = errors + check(document.node_get(document.member(escaped_object, "a.b")) = "value", "exact non-path member")
errors = errors + check(document.member(items_node, "invalid") = -2 & document.element(root, 1) = -2, "container-kind validation")

keys = .string[]
encoded_values = .string[]
keys[1] = "message"
keys[2] = "count"
keys[3] = "empty"
encoded_values[1] = jsonquote(unicode_value)
encoded_values[2] = "7"
encoded_values[3] = jsonquote("")
encoded = ""
encoding_error = ""
errors = errors + check(bounded_json_object(keys, encoded_values, 256, encoded, encoding_error) = 0, "bounded encoding success")
encoded_bytes = binlength(encoded as .binary)
encoded_document = .jsondocument(encoded)
errors = errors + check(encoded_document.valid() = 1 & encoded_document.get("message") = unicode_value & encoded_document.get("count") = "7" & encoded_document.type("empty") = "string", "encoded round-trip")
exact_encoded = ""
errors = errors + check(bounded_json_object(keys, encoded_values, encoded_bytes, exact_encoded, encoding_error) = 0 & exact_encoded = encoded, "exact byte bound")
overflow = "sentinel"
errors = errors + check(bounded_json_object(keys, encoded_values, encoded_bytes - 1, overflow, encoding_error) = -2 & overflow = "" & pos("exceeds", encoding_error) > 0, "bounded encoding rejection")

invalid = .jsondocument('{"unicode":"\ud83d"}')
errors = errors + check(invalid.valid() = 0 & invalid.error_code() = "truncated" & invalid.error_position() > 0 & pos("surrogate", invalid.error()) > 0, "invalid Unicode diagnostic")

if errors \= 0 then do
  say "P1_JSON_01_ERRORS=" || errors
  return 1
end
say "P1_JSON_01_OK parser=installed-rxjson parse_once=1 nodes=" || document.node_count() || " typed_items=" || items.0 || " unicode=1 missing_null_empty=1 encoded_bytes=" || encoded_bytes || " overflow=-2"
return 0
