options levelb

import rxfnsb
import rxjson

elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_JSON_02_FAIL=" || label
    return 1
  end
  return 0

make_provider_payload: procedure = .string
  dimension = 64
  embedding = .string[]
  do i = 1 to dimension
    embedding[i] = ((i % 17) - 8) || ".125"
  end
  return '{"id":"local-fixture-001","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"Gr\u00e0dh \u4e2d answer"},"finish_reason":"stop"}],"usage":{"prompt_tokens":17,"completion_tokens":5,"total_tokens":22},"data":[{"index":0,"embedding":' || jsonarray(embedding) || '}],"model":"synthetic-local"}'

make_evidence_page: procedure = .string
  arg page = .int, page_size = .int, total_rows = .int
  items = .string[]
  start_row = ((page - 1) * page_size) + 1
  end_row = start_row + page_size - 1
  if end_row > total_rows then end_row = total_rows
  item_index = 0
  do row = start_row to end_row
    item_index = item_index + 1
    subject = "Service " || row
    object = "Store " || ((row % 5) + 1)
    passage = "Passage " || row || " Gràdh 中"
    items[item_index] = '{"rank":' || row || ',"passage":' || jsonquote(passage) || ',"supportedClaim":{"subject":' || jsonquote(subject) || ',"predicate":"depends_on","object":' || jsonquote(object) || ',"direction":"subject-to-object"},"citation":' || jsonquote("fixture://evidence/revision-2#p" || row) || ',"ambiguity":null}'
  end
  has_more = "false"
  if end_row < total_rows then has_more = "true"
  return '{"page":' || page || ',"page_size":' || page_size || ',"has_more":' || has_more || ',"items":' || jsonarray(items) || '}'

main: procedure = .int
arg args = .string[]
errors = 0

provider = make_provider_payload()
provider_bytes = binlength(provider as .binary)
legacy_provider_sum = 0.0
started = time("us")
legacy_content = jsonget(provider, "choices.1.message.content")
legacy_tokens = jsonget(provider, "usage.total_tokens") as .int
legacy_dimension = jsoncount(provider, "data.1.embedding")
do i = 1 to legacy_dimension
  legacy_provider_sum = legacy_provider_sum + (jsonget(provider, "data.1.embedding." || i) as .float)
end
legacy_provider_us = elapsed_us(started)

started = time("us")
provider_document = .jsondocument(provider)
provider_parse_us = elapsed_us(started)
started = time("us")
provider_root = provider_document.root()
choices_node = provider_document.member(provider_root, "choices")
choice_node = provider_document.element(choices_node, 1)
message_node = provider_document.member(choice_node, "message")
content_node = provider_document.member(message_node, "content")
indexed_content = ""
errors = errors + check(provider_document.node_string(content_node, indexed_content) = 0, "provider typed content")
usage_node = provider_document.member(provider_root, "usage")
tokens_node = provider_document.member(usage_node, "total_tokens")
indexed_tokens = 0
errors = errors + check(provider_document.node_int(tokens_node, indexed_tokens) = 0, "provider typed usage")
data_node = provider_document.member(provider_root, "data")
data_item = provider_document.element(data_node, 1)
embedding_node = provider_document.member(data_item, "embedding")
embedding_nodes = .int[]
indexed_dimension = provider_document.children(embedding_node, embedding_nodes)
indexed_provider_sum = 0.0
do i = 1 to indexed_dimension
  number = 0.0
  errors = errors + check(provider_document.node_float(embedding_nodes[i], number) = 0, "provider typed embedding " || i)
  indexed_provider_sum = indexed_provider_sum + number
end
indexed_provider_us = elapsed_us(started)
errors = errors + check(provider_document.valid() = 1 & legacy_content = indexed_content & indexed_content = "Gràdh 中 answer", "provider content equality")
errors = errors + check(legacy_tokens = indexed_tokens & indexed_tokens = 22, "provider usage equality")
errors = errors + check(legacy_dimension = indexed_dimension & indexed_dimension = 64, "provider dimension equality")
errors = errors + check(legacy_provider_sum = indexed_provider_sum, "provider numeric equality")

page_count = 4
page_size = 8
total_rows = page_count * page_size
pages = .string[]
do page = 1 to page_count
  pages[page] = make_evidence_page(page, page_size, total_rows)
end

legacy_evidence_checksum = 0
legacy_rows = 0
started = time("us")
do page = 1 to page_count
  row_count = jsoncount(pages[page], "items")
  legacy_rows = legacy_rows + row_count
  do row = 1 to row_count
    prefix = "items." || row || "."
    rank = jsonget(pages[page], prefix || "rank") as .int
    passage = jsonget(pages[page], prefix || "passage")
    subject = jsonget(pages[page], prefix || "supportedClaim.subject")
    object = jsonget(pages[page], prefix || "supportedClaim.object")
    citation = jsonget(pages[page], prefix || "citation")
    legacy_evidence_checksum = legacy_evidence_checksum + rank + length(passage) + length(subject) + length(object) + length(citation)
  end
end
legacy_evidence_us = elapsed_us(started)

indexed_evidence_checksum = 0
indexed_rows = 0
evidence_parse_us = 0
evidence_access_us = 0
do page = 1 to page_count
  started = time("us")
  evidence_document = .jsondocument(pages[page])
  evidence_parse_us = evidence_parse_us + elapsed_us(started)
  started = time("us")
  evidence_root = evidence_document.root()
  page_node = evidence_document.member(evidence_root, "page")
  page_value = 0
  errors = errors + check(evidence_document.node_int(page_node, page_value) = 0 & page_value = page, "evidence page number")
  items_node = evidence_document.member(evidence_root, "items")
  evidence_items = .int[]
  row_count = evidence_document.children(items_node, evidence_items)
  indexed_rows = indexed_rows + row_count
  do row = 1 to row_count
    item = evidence_items[row]
    rank_node = evidence_document.member(item, "rank")
    passage_node = evidence_document.member(item, "passage")
    claim_node = evidence_document.member(item, "supportedClaim")
    subject_node = evidence_document.member(claim_node, "subject")
    object_node = evidence_document.member(claim_node, "object")
    citation_node = evidence_document.member(item, "citation")
    rank = 0
    passage = ""
    subject = ""
    object = ""
    citation = ""
    errors = errors + check(evidence_document.node_int(rank_node, rank) = 0, "typed evidence rank")
    errors = errors + check(evidence_document.node_string(passage_node, passage) = 0, "typed evidence passage")
    errors = errors + check(evidence_document.node_string(subject_node, subject) = 0, "typed evidence subject")
    errors = errors + check(evidence_document.node_string(object_node, object) = 0, "typed evidence object")
    errors = errors + check(evidence_document.node_string(citation_node, citation) = 0, "typed evidence citation")
    indexed_evidence_checksum = indexed_evidence_checksum + rank + length(passage) + length(subject) + length(object) + length(citation)
  end
  evidence_access_us = evidence_access_us + elapsed_us(started)
end
errors = errors + check(legacy_rows = indexed_rows & indexed_rows = total_rows, "paged evidence row equality")
errors = errors + check(legacy_evidence_checksum = indexed_evidence_checksum, "paged evidence semantic equality")

if errors \= 0 then do
  say "P1_JSON_02_ERRORS=" || errors
  return 1
end
say "P1_JSON_02_PROVIDER legacy_us=" || legacy_provider_us || " parse_us=" || provider_parse_us || " indexed_access_us=" || indexed_provider_us || " bytes=" || provider_bytes || " dimension=" || indexed_dimension || " checksum=" || indexed_provider_sum
say "P1_JSON_02_EVIDENCE legacy_us=" || legacy_evidence_us || " indexed_parse_us=" || evidence_parse_us || " indexed_access_us=" || evidence_access_us || " pages=" || page_count || " rows=" || indexed_rows || " checksum=" || indexed_evidence_checksum
say "P1_JSON_02_OK same_session=1 semantic_equal=1 provider=1 paged_evidence=1 parser=installed-rxjson"
return 0
