options levelb

import rxfnsb
import sqlite_boundary

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_SQL_03_FAIL=" || label
    return 1
  end
  return 0

read_int: procedure = .int
  arg db = .binary, sql = .string, expose value = .int
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return 1
  if sqlitestep(statement) \= 100 then return 1
  if sqlitecolumnint(statement, 0, value) \= 0 then return 1
  if sqlitefinalize(statement) \= 0 then return 1
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 1 then return 2
path = args[1]
errors = 0
db = .binary
db2 = .binary
statement = .binary

errors = errors + check(sqliteopen(path, db) = 0, "open")
fts5 = 0
json1 = 0
errors = errors + check(sqlitecapability(db, "fts5", fts5) = 0 & fts5 = 1, "FTS5 capability")
errors = errors + check(sqlitecapability(db, "json1", json1) = 0 & json1 = 1, "JSON1 capability")
unknown = 0
errors = errors + check(sqlitecapability(db, "unknown", unknown) = -1, "unknown capability")

errors = errors + check(sqliteexec(db, "PRAGMA foreign_keys=ON") = 0, "foreign keys on")
errors = errors + check(sqliteexec(db, "CREATE TABLE tx_values(v INTEGER); CREATE TABLE reusable(v INTEGER); CREATE TABLE parent(id INTEGER PRIMARY KEY); CREATE TABLE child(parent_id INTEGER REFERENCES parent(id))") = 0, "create tables")
errors = errors + check(sqliteexec(db, "BEGIN") = 0, "begin")
errors = errors + check(sqliteexec(db, "INSERT INTO tx_values VALUES(1)") = 0, "transaction insert")
errors = errors + check(sqliteexec(db, "SAVEPOINT nested") = 0, "savepoint")
errors = errors + check(sqliteexec(db, "INSERT INTO tx_values VALUES(2)") = 0, "savepoint insert")
errors = errors + check(sqliteexec(db, "ROLLBACK TO nested") = 0, "rollback savepoint")
errors = errors + check(sqliteexec(db, "RELEASE nested") = 0, "release savepoint")
errors = errors + check(sqliteexec(db, "COMMIT") = 0, "commit")
count = 0
errors = errors + check(read_int(db, "SELECT count(*) FROM tx_values", count) = 0 & count = 1, "savepoint result")
errors = errors + check(sqliteexec(db, "BEGIN; INSERT INTO tx_values VALUES(3); ROLLBACK") = 0, "whole rollback")
errors = errors + check(read_int(db, "SELECT count(*) FROM tx_values", count) = 0 & count = 1, "rollback result")

errors = errors + check(sqliteprepare(db, "INSERT INTO reusable VALUES(?1)", statement) = 0, "prepare reusable")
do value = 10 to 14
  errors = errors + check(sqlitebindint(statement, 1, value) = 0, "reuse bind")
  errors = errors + check(sqlitestep(statement) = 101, "reuse step")
  errors = errors + check(sqlitereset(statement) = 0, "reuse reset")
  errors = errors + check(sqliteclearbindings(statement) = 0, "reuse clear")
end
errors = errors + check(sqlitefinalize(statement) = 0, "reuse finalize")

statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT v FROM reusable ORDER BY v", statement) = 0, "prepare paged cursor")
rows = 0
pages = 0
page_rows = 0
sum = 0
do forever
  status = sqlitestep(statement)
  if status = 101 then leave
  current = 0
  errors = errors + check(status = 100 & sqlitecolumnint(statement, 0, current) = 0, "paged row")
  if page_rows = 0 then pages = pages + 1
  rows = rows + 1
  page_rows = page_rows + 1
  sum = sum + current
  if page_rows = 2 then page_rows = 0
end
errors = errors + check(rows = 5 & pages = 3 & sum = 60, "cursor paging")
errors = errors + check(sqlitefinalize(statement) = 0, "paged finalize")

errors = errors + check(sqliteexec(db, "CREATE VIRTUAL TABLE search_text USING fts5(body); INSERT INTO search_text(body) VALUES('alpha boundary phrase'),('unrelated')") = 0, "FTS5 setup")
statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT rowid FROM search_text WHERE search_text MATCH ?1", statement) = 0, "FTS5 prepare")
errors = errors + check(sqlitebindtext(statement, 1, "boundary") = 0 & sqlitestep(statement) = 100, "FTS5 query")
fts_row = 0
errors = errors + check(sqlitecolumnint(statement, 0, fts_row) = 0 & fts_row = 1, "FTS5 row")
errors = errors + check(sqlitefinalize(statement) = 0, "FTS5 finalize")

json_value = 0
errors = errors + check(read_int(db, "SELECT json_extract(char(123,34,110,34,58,55,125), '$.n')", json_value) = 0 & json_value = 7, "JSON1 query")
errors = errors + check(sqliteexec(db, "INSERT INTO parent VALUES(1)") = 0, "foreign key parent")
errors = errors + check(sqliteexec(db, "INSERT INTO child VALUES(99)") = -6, "foreign key reject")
code = 0
sqlite_code = 0
extended_code = 0
operation = ""
message = ""
errors = errors + check(sqliteerrorextended(code, sqlite_code, extended_code, operation, message) = -6 & sqlite_code = 19 & extended_code = 787, "foreign key extended code")

statement = .binary
errors = errors + check(sqliteprepare(db, "PRAGMA journal_mode=WAL", statement) = 0 & sqlitestep(statement) = 100, "WAL pragma")
journal_mode = ""
errors = errors + check(sqlitecolumntext(statement, 0, journal_mode) = 0 & journal_mode = "wal", "WAL enabled")
errors = errors + check(sqlitefinalize(statement) = 0, "WAL finalize")
errors = errors + check(sqliteopen(path, db2) = 0, "second connection")
errors = errors + check(sqlitebusytimeout(db2, 25) = 0, "busy timeout")
errors = errors + check(sqliteexec(db, "BEGIN IMMEDIATE") = 0, "writer lock")
errors = errors + check(sqliteexec(db2, "INSERT INTO reusable VALUES(99)") = -6, "busy result")
errors = errors + check(sqliteerrorextended(code, sqlite_code, extended_code, operation, message) = -6 & sqlite_code = 5, "busy classification")
errors = errors + check(sqliteexec(db, "ROLLBACK") = 0, "unlock")
errors = errors + check(sqliteclose(db2) = 0, "close second connection")
log_frames = -2
checkpointed_frames = -2
errors = errors + check(sqlitecheckpoint(db, "truncate", log_frames, checkpointed_frames) = 0, "WAL checkpoint")
errors = errors + check(log_frames >= -1 & checkpointed_frames >= -1, "checkpoint counters")
errors = errors + check(sqlitecheckpoint(db, "invalid", log_frames, checkpointed_frames) = -1, "checkpoint mode validation")
errors = errors + check(sqliteclose(db) = 0, "close")

if errors <> 0 then do
  say "P1_SQL_03_ERRORS=" || errors
  return 1
end

say "P1_SQL_03_OK transaction=1 savepoint=1 reuse=5 pages=" || pages || " fts5=" || fts5 || " json1=" || json1 || " foreign_keys=1 wal=" || journal_mode || " busy=5 checkpoint=" || checkpointed_frames
return 0
