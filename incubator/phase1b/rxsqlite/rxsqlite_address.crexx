options levelb

namespace rxsqlite_address expose sqliteaddressenvironment

import _rxsysb
import rxfnsb
import sqlite_boundary

sqliteaddressenvironment: class implements .addressenvironment .addressinstance .addressfunctionenvironment
  _database = .binary
  _environment_name = .string
  _environment_id = .string
  _open = .int
  _status = .int
  _error = .string

  *: factory
    arg env_name = .string
    _environment_name = _address_normalize_environment_name(env_name)
    _environment_id = "rexx:" || _environment_name
    _open = 0
    _status = 0
    _error = ""
    return

  bind_environment: method = .void
    arg env_name = .string, instance_id = .string
    _environment_name = _address_normalize_environment_name(env_name)
    _environment_id = instance_id
    if _environment_id = "" then _environment_id = "rexx:" || _environment_name
    return

  environment_name: method = .string
    return _environment_name

  environment_id: method = .string
    return _environment_id

  execute: method = .addressresponse
    arg request = .addressrequest
    original = strip(request.get_command())
    normalized = _address_normalize_command(original)
    verb = word(normalized, 1)

    if verb = "OPEN" then return _execute_open(request, original)
    if verb = "EXEC" then return _execute_exec(original)
    if verb = "VALUE" then return _execute_value(request, original)
    if normalized = "CLOSE" then return _execute_close()
    return _address_unknown_command_response(_environment_name, request.get_command())

  invoke: method = .addressfunctionresponse
    arg request = .addressfunctionrequest
    name = _address_normalize_environment_name(request.get_function_name())
    if name = "ID" then return .addressfunctionresponse(0, _environment_id)
    if name = "NAME" then return .addressfunctionresponse(0, _environment_name)
    if name = "STATUS" then return .addressfunctionresponse(0, "" || _status)
    if name = "ERROR" then return .addressfunctionresponse(0, _error)
    return .addressfunctionresponse(-3, "", "FAILURE")

  _execute_open: method = .addressresponse
    arg request = .addressrequest, command = .string
    if words(command) < 2 | words(command) > 3 then return _local_failure(-1, "OPEN requires a path anchor and optional mode")
    if _open = 1 then do
      status = sqliteclose(_database)
      _open = 0
      if status \= 0 then return _sqlite_failure(status)
    end
    path = rxsqlite_resolve_host_text(request, word(command, 2))
    mode = "create"
    if words(command) = 3 then mode = lower(word(command, 3))
    status = sqliteopenmode(path, mode, _database)
    if status \= 0 then return _sqlite_failure(status)
    _open = 1
    _status = 0
    _error = ""
    return .addressresponse(0)

  _execute_exec: method = .addressresponse
    arg command = .string
    if _open \= 1 then return _local_failure(-3, "database is not open")
    sql = strip(substr(command, 5))
    if sql = "" then return _local_failure(-1, "EXEC requires SQL text")
    status = sqliteexec(_database, sql)
    if status \= 0 then return _sqlite_failure(status)
    _status = 0
    _error = ""
    return .addressresponse(0)

  _execute_value: method = .addressresponse
    arg request = .addressrequest, command = .string
    if _open \= 1 then return _local_failure(-3, "database is not open")
    marker = lastpos(" INTO ", upper(command))
    if marker <= 7 then return _local_failure(-1, "VALUE requires SQL and INTO ${target}")
    sql = strip(substr(command, 7, marker - 7))
    target = rxsqlite_host_anchor_name(strip(substr(command, marker + 6)))
    if target = "" then return _local_failure(-1, "VALUE target must be a host-variable anchor")

    statement = .binary
    status = sqliteprepare(_database, sql, statement)
    if status \= 0 then return _sqlite_failure(status)
    status = sqlitestep(statement)
    if status \= 100 then do
      call sqlitefinalize statement
      if status = 101 then return _local_failure(-1, "VALUE query returned no row")
      return _sqlite_failure(status)
    end
    value_type = ""
    status = sqlitecolumntype(statement, 0, value_type)
    if status \= 0 then do
      call sqlitefinalize statement
      return _sqlite_failure(status)
    end
    value = ""
    if value_type = "null" then value = "NULL"
    else if value_type = "integer" then do
      integer_value = 0
      status = sqlitecolumnint(statement, 0, integer_value)
      value = "" || integer_value
    end
    else if value_type = "real" then do
      real_value = 0.0
      status = sqlitecolumnreal(statement, 0, real_value)
      value = "" || real_value
    end
    else if value_type = "text" then status = sqlitecolumntext(statement, 0, value)
    else do
      call sqlitefinalize statement
      return _local_failure(-7, "VALUE does not serialize blob results")
    end
    if status \= 0 then do
      call sqlitefinalize statement
      return _sqlite_failure(status)
    end
    status = sqlitestep(statement)
    if status \= 101 then do
      call sqlitefinalize statement
      if status = 100 then return _local_failure(-1, "VALUE query returned more than one row")
      return _sqlite_failure(status)
    end
    status = sqlitefinalize(statement)
    if status \= 0 then return _sqlite_failure(status)

    response = .addressresponse(0)
    call response.add_updated_binding("var", target, target, value, "")
    _status = 0
    _error = ""
    return response

  _execute_close: method = .addressresponse
    if _open \= 1 then return _local_failure(-3, "database is not open")
    status = sqliteclose(_database)
    _open = 0
    if status \= 0 then return _sqlite_failure(status)
    _status = 0
    _error = ""
    return .addressresponse(0)

  _sqlite_failure: method = .addressresponse
    arg status = .int
    code = 0
    sqlite_code = 0
    extended_code = 0
    operation = ""
    message = ""
    call sqliteerrorextended code, sqlite_code, extended_code, operation, message
    _status = status
    _error = operation || ": sqlite=" || sqlite_code || " extended=" || extended_code || " " || message
    response = .addressresponse(8, "FAILURE")
    call response.add_diagnostic(_error)
    return response

  _local_failure: method = .addressresponse
    arg status = .int, message = .string
    _status = status
    _error = message
    response = .addressresponse(8, "FAILURE")
    call response.add_diagnostic(message)
    return response

rxsqlite_resolve_host_text: procedure = .string
  arg request = .addressrequest, token = .string
  anchor = rxsqlite_host_anchor_name(token)
  if anchor = "" then return token
  return request.get_binding_value(anchor)

rxsqlite_host_anchor_name: procedure = .string
  arg token = .string
  if length(token) > 1 & left(token, 1) = ":" then return substr(token, 2)
  if length(token) > 3 & left(token, 2) = "${" & right(token, 1) = "}" then return substr(token, 3, length(token) - 3)
  return ""
