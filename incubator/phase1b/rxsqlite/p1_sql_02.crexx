options levelg

import rxfnsb
import sqlite_boundary

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_SQL_02_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
errors = 0
db = .binary
statement = .binary
errors = errors + check(sqliteopen(":memory:", db) = 0, "open")
errors = errors + check(sqliteexec(db, "CREATE TABLE typed_values(n, min_i INTEGER, max_i INTEGER, r REAL, t TEXT, empty_t TEXT, b BLOB, empty_b BLOB, large_t TEXT, large_b BLOB)") = 0, "create typed table")
errors = errors + check(sqliteprepare(db, "INSERT INTO typed_values VALUES(:n,:min_i,:max_i,:r,:t,:empty_t,:b,:empty_b,:large_t,:large_b)", statement) = 0, "prepare typed insert")

min_i = -9223372036854775807 - 1
max_i = 9223372036854775807
unicode_text = "Gràdh 中 ☺"
embedded_nul = "41004200ff"x as .binary
empty_blob = .binary
large_text = copies("t", 1100005)
large_blob = copies("b", 1100005) as .binary

index = 0
errors = errors + check(sqlitebindindex(statement, ":n", index) = 0 & index = 1, "named null index")
errors = errors + check(sqlitebindnull(statement, index) = 0, "bind null")
errors = errors + check(sqlitebindindex(statement, ":min_i", index) = 0 & sqlitebindint(statement, index, min_i) = 0, "bind min int64")
errors = errors + check(sqlitebindindex(statement, ":max_i", index) = 0 & sqlitebindint(statement, index, max_i) = 0, "bind max int64")
errors = errors + check(sqlitebindindex(statement, ":r", index) = 0 & sqlitebindreal(statement, index, 3.25) = 0, "bind real")
errors = errors + check(sqlitebindindex(statement, ":t", index) = 0 & sqlitebindtext(statement, index, unicode_text) = 0, "bind Unicode text")
errors = errors + check(sqlitebindindex(statement, ":empty_t", index) = 0 & sqlitebindtext(statement, index, "") = 0, "bind empty text")
errors = errors + check(sqlitebindindex(statement, ":b", index) = 0 & sqlitebindblob(statement, index, embedded_nul) = 0, "bind embedded-NUL blob")
errors = errors + check(sqlitebindindex(statement, ":empty_b", index) = 0 & sqlitebindblob(statement, index, empty_blob) = 0, "bind empty blob")
errors = errors + check(sqlitebindindex(statement, ":large_t", index) = 0 & sqlitebindtext(statement, index, large_text) = 0, "bind large text")
errors = errors + check(sqlitebindindex(statement, ":large_b", index) = 0 & sqlitebindblob(statement, index, large_blob) = 0, "bind large blob")
errors = errors + check(sqlitebindindex(statement, ":missing", index) = -1, "missing named parameter")
errors = errors + check(sqlitestep(statement) = 101, "insert done")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize insert")

statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT n,min_i,max_i,r,t,empty_t,b,empty_b,large_t,large_b FROM typed_values", statement) = 0 & sqlitestep(statement) = 100, "select typed row")
kind = ""
is_null = 0
read_min = 0
read_max = 0
read_real = 0.0
read_text = ""
read_empty_text = "x"
read_blob = .binary
read_empty_blob = "01"x as .binary
read_large_text = ""
read_large_blob = .binary
errors = errors + check(sqlitecolumntype(statement, 0, kind) = 0 & kind = "null", "null type")
errors = errors + check(sqlitecolumnisnull(statement, 0, is_null) = 0 & is_null = 1, "null value")
errors = errors + check(sqlitecolumnint(statement, 0, read_min) = -7, "null not integer")
errors = errors + check(sqlitecolumnint(statement, 1, read_min) = 0 & read_min = min_i, "read min int64")
errors = errors + check(sqlitecolumnint(statement, 2, read_max) = 0 & read_max = max_i, "read max int64")
errors = errors + check(sqlitecolumnreal(statement, 3, read_real) = 0 & read_real = 3.25, "read real")
errors = errors + check(sqlitecolumntext(statement, 4, read_text) = 0 & read_text = unicode_text, "read Unicode text")
errors = errors + check(sqlitecolumntext(statement, 5, read_empty_text) = 0 & read_empty_text = "", "read empty text")
errors = errors + check(sqlitecolumnblob(statement, 6, read_blob) = 0 & bin2x(read_blob) = "41004200FF", "read embedded-NUL blob")
errors = errors + check(sqlitecolumntype(statement, 7, kind) = 0 & kind = "blob", "empty blob type")
errors = errors + check(sqlitecolumnblob(statement, 7, read_empty_blob) = 0 & binlength(read_empty_blob) = 0, "read empty blob")
errors = errors + check(sqlitecolumntext(statement, 8, read_large_text) = 0 & length(read_large_text) = 1100005, "read large text")
errors = errors + check(sqlitecolumnblob(statement, 9, read_large_blob) = 0 & binlength(read_large_blob) = 1100005, "read large blob")
errors = errors + check(sqlitestep(statement) = 101, "typed cursor done")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize typed select")

errors = errors + check(sqliteexec(db, "CREATE TABLE many_values(v INTEGER)") = 0, "create result table")
errors = errors + check(sqliteexec(db, "WITH RECURSIVE seq(v) AS (VALUES(1) UNION ALL SELECT v+1 FROM seq WHERE v<20000) INSERT INTO many_values SELECT v FROM seq") = 0, "seed large result")
statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT v FROM many_values ORDER BY v", statement) = 0, "prepare large cursor")
rows = 0
sum = 0
do forever
  status = sqlitestep(statement)
  if status = 101 then leave
  errors = errors + check(status = 100, "large cursor row status")
  value = 0
  errors = errors + check(sqlitecolumnint(statement, 0, value) = 0, "large cursor typed value")
  rows = rows + 1
  sum = sum + value
end
errors = errors + check(rows = 20000 & sum = 200010000, "large cursor result")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize large cursor")
errors = errors + check(sqliteclose(db) = 0, "close")

if errors <> 0 then do
  say "P1_SQL_02_ERRORS=" || errors
  return 1
end

say "P1_SQL_02_OK typed=null,int64,real,text,blob text_bytes=1100005 blob_bytes=1100005 rows=" || rows || " sum=" || sum
return 0
