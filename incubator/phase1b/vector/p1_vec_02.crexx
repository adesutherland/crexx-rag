options levelg

import rxfnsb
import rxfnsg
import rxvector
import sqlite_boundary
import vector_codec
import vector_search

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_VEC_02_FAIL=" || label
    return 1
  end
  return 0

makevector: procedure = .int
  arg first = .float, second = .float, dimension = .int, dense_tail = .int, expose payload = .binary
  values = .float[]
  values[1] = first
  values[2] = second
  do i = 3 to dimension
    if dense_tail = 0 then values[i] = 0.0
    else do
      pattern = i % 4
      if pattern = 0 then values[i] = -1.0
      else if pattern = 1 then values[i] = -0.5
      else if pattern = 2 then values[i] = 0.5
      else values[i] = 1.0
    end
  end
  return encodef32(values, payload)

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
errors = 0
row_total = 11684
dimension = 768
page_size = 128
top_k = 10

query_payload = .binary
background_payload = .binary
top1_payload = .binary
tie_payload = .binary
top4_payload = .binary
errors = errors + check(makevector(1.0, 0.0, dimension, 0, query_payload) = 0, "query fixture")
errors = errors + check(makevector(0.0, 1.0, dimension, 1, background_payload) = 0, "background fixture")
errors = errors + check(makevector(1.0, 0.0, dimension, 0, top1_payload) = 0, "top-1 fixture")
errors = errors + check(makevector(0.8, 0.6, dimension, 0, tie_payload) = 0, "tie fixture")
errors = errors + check(makevector(0.6, 0.8, dimension, 0, top4_payload) = 0, "top-4 fixture")
query_vector = rxvector..decodef32le(query_payload)
errors = errors + check(query_vector.size() = dimension, "query conversion")

db = .binary
statement = .binary
errors = errors + check(sqliteopen(database_path, db) = 0, "open scratch database")
schema = "CREATE TABLE vector_fixture(identity INTEGER PRIMARY KEY,codec TEXT NOT NULL CHECK(codec='f32le-v1'),element_count INTEGER NOT NULL CHECK(element_count=768),dimensional_meaning TEXT NOT NULL CHECK(dimensional_meaning='embedding'),payload BLOB NOT NULL CHECK(length(payload)=element_count*4))"
errors = errors + check(sqliteexec(db, schema) = 0, "create vector schema")
errors = errors + check(sqliteexec(db, "BEGIN IMMEDIATE") = 0, "begin fixture transaction")
errors = errors + check(sqliteprepare(db, "INSERT INTO vector_fixture(identity,codec,element_count,dimensional_meaning,payload) VALUES(?1,?2,?3,?4,?5)", statement) = 0, "prepare fixture insert")
insert_status = 0
do identity = 1 to row_total
  row_payload = background_payload
  if identity = 101 then row_payload = top1_payload
  else if identity = 202 | identity = 303 then row_payload = tie_payload
  else if identity = 404 then row_payload = top4_payload
  if sqlitebindint(statement, 1, identity) \= 0 | sqlitebindtext(statement, 2, f32codecversion()) \= 0 | sqlitebindint(statement, 3, dimension) \= 0 | sqlitebindtext(statement, 4, "embedding") \= 0 | sqlitebindblob(statement, 5, row_payload) \= 0 then do
    insert_status = -1
    leave
  end
  if sqlitestep(statement) \= 101 | sqlitereset(statement) \= 0 then do
    insert_status = -1
    leave
  end
end
errors = errors + check(insert_status = 0, "insert representative fixture")
errors = errors + check(sqlitefinalize(statement) = 0 & sqliteexec(db, "COMMIT") = 0, "commit representative fixture")

statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT identity,codec,element_count,dimensional_meaning,payload FROM vector_fixture WHERE identity>?1 ORDER BY identity LIMIT ?2", statement) = 0, "prepare keyset page")
last_identity = 0
page_count = 0
rows_seen = 0
transfer_bytes = 0
global_ids = .int[]
global_scores = .float[]
search_status = 0
do forever
  if sqlitebindint(statement, 1, last_identity) \= 0 | sqlitebindint(statement, 2, page_size) \= 0 then do
    search_status = -1
    leave
  end
  page_id_owner = .packedint(page_size)
  page_wire = .binary
  page_rows = 0
  do forever
    step_status = sqlitestep(statement)
    if step_status = 101 then leave
    if step_status \= 100 then do
      search_status = -1
      leave
    end
    identity = 0
    codec = ""
    count = 0
    meaning = ""
    payload = .binary
    if sqlitecolumnint(statement, 0, identity) \= 0 | sqlitecolumntext(statement, 1, codec) \= 0 | sqlitecolumnint(statement, 2, count) \= 0 | sqlitecolumntext(statement, 3, meaning) \= 0 | sqlitecolumnblob(statement, 4, payload) \= 0 then do
      search_status = -1
      leave
    end
    if validatef32blob(codec, count, meaning, payload) \= 0 then do
      search_status = -1
      leave
    end
    call page_id_owner.set(page_rows, identity)
    call binappend page_wire, payload
    page_rows = page_rows + 1
    transfer_bytes = transfer_bytes + binlength(payload)
    last_identity = identity
  end
  if sqlitereset(statement) \= 0 then search_status = -1
  if search_status \= 0 then leave
  if page_rows = 0 then leave
  page_count = page_count + 1
  rows_seen = rows_seen + page_rows
  call page_id_owner.resize(page_rows)
  page_vectors = rxvector..decodef32le(page_wire)
  page_result_ids = .packedint(0)
  page_result_scores = .packedfloat(0)
  page_requested = top_k
  if page_requested > page_rows then page_requested = page_rows
  call rxvector..topkcosine(page_vectors, page_id_owner, dimension, query_vector, page_requested, page_result_ids, page_result_scores)
  page_top_ids = .int[]
  page_top_scores = .float[]
  do i = 0 to page_result_ids.size() - 1
    page_top_ids[i + 1] = page_result_ids.get(i)
    page_top_scores[i + 1] = page_result_scores.get(i)
  end
  combined_ids = .int[]
  combined_scores = .float[]
  combined_count = 0
  do i = 1 to global_ids.0
    combined_count = combined_count + 1
    combined_ids[combined_count] = global_ids[i]
    combined_scores[combined_count] = global_scores[i]
  end
  do i = 1 to page_top_ids.0
    combined_count = combined_count + 1
    combined_ids[combined_count] = page_top_ids[i]
    combined_scores[combined_count] = page_top_scores[i]
  end
  next_ids = .int[]
  next_scores = .float[]
  if selecttopk(combined_ids, combined_scores, top_k, next_ids, next_scores) \= 0 then do
    search_status = -1
    leave
  end
  global_ids = next_ids
  global_scores = next_scores
end
errors = errors + check(search_status = 0 & sqlitefinalize(statement) = 0, "paged exact search")
errors = errors + check(rows_seen = row_total & page_count = 92 & transfer_bytes = 35893248, "representative workload shape")
errors = errors + check(global_ids.0 = top_k & global_ids[1] = 101 & global_ids[2] = 202 & global_ids[3] = 303 & global_ids[4] = 404 & global_ids[5] = 1 & global_ids[6] = 2 & global_ids[7] = 3 & global_ids[8] = 4 & global_ids[9] = 5 & global_ids[10] = 6, "closed-form oracle ordering")
errors = errors + check(global_scores[1] > 0.99999 & global_scores[2] = global_scores[3] & global_scores[2] > 0.79999 & global_scores[2] < 0.80001 & global_scores[4] > 0.59999 & global_scores[4] < 0.60001 & global_scores[5] = 0.0, "closed-form oracle scores")
errors = errors + check(sqliteclose(db) = 0, "close scratch database")

if errors \= 0 then do
  say "P1_VEC_02_ERRORS=" || errors || " cell=" || cell
  return 1
end
say "P1_VEC_02_OK cell=" || cell || " rows=11684 dimension=768 page_size=128 pages=92 bytes=35893248 top_k=10 top_ids=101,202,303,404,1,2,3,4,5,6 tie=202,303 tie_rule=score_desc_identity_asc oracle=closed_form"
return 0
