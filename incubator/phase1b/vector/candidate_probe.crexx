options levelg

import vector_codec
import vector_search

main: procedure = .int
left_values = .float[]
left_values[1] = 1.0
left_values[2] = 0.0
right_values = .float[]
right_values[1] = 0.5
right_values[2] = 0.5
left_payload = .binary
right_payload = .binary
if encodef32(left_values, left_payload) \= 0 then return 1
if encodef32(right_values, right_payload) \= 0 then return 1
if validatef32blob(f32codecversion(), 2, "coordinates", left_payload) \= 0 then return 1
score = 0.0
if cosinef32(left_payload, 2, right_payload, 2, score) \= 0 then return 1
if score < 0.70 | score > 0.71 then return 1
say "P2_09_VECTOR_CANDIDATE_OK codec=f32le-v1 dimension=2 deterministic=1"
return 0
