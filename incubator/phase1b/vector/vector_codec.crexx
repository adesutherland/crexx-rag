options levelg

namespace vector_codec expose vectorblob f32codecversion validatef32blob encodef32 decodef32

import rxfnsb

vectorblob: class
  _codec = .string
  _element_count = .int
  _dimensional_meaning = .string
  _payload = .binary

  *: factory
    arg codec = .string, element_count = .int, dimensional_meaning = .string, payload = .binary
    _codec = codec
    _element_count = element_count
    _dimensional_meaning = dimensional_meaning
    _payload = payload
    return

  codec: method = .string
    return _codec
  element_count: method = .int
    return _element_count
  dimensional_meaning: method = .string
    return _dimensional_meaning
  payload: method = .binary
    return _payload
  valid: method = .int
    return validatef32blob(_codec, _element_count, _dimensional_meaning, _payload) = 0

f32codecversion: procedure = .string
  return "f32le-v1"

validatef32blob: procedure = .int
  arg codec = .string, element_count = .int, dimensional_meaning = .string, payload = .binary
  if codec \= f32codecversion() then return -1
  if element_count <= 0 then return -2
  if dimensional_meaning = "" then return -3
  if binlength(payload) \= element_count * 4 then return -4
  return 0

encodef32: procedure = .int
  arg values = .float[], expose payload = .binary
  payload = .binary
  call binresize payload, 0
  if values.0 <= 0 then return -2
  call binresize payload, values.0 * 4
  do i = 1 to values.0
    <at..f32>((i - 1) * 4) payload = values[i]
  end
  return 0

decodef32: procedure = .int
  arg codec = .string, element_count = .int, dimensional_meaning = .string, payload = .binary, expose values = .float[]
  values = .float[]
  status = validatef32blob(codec, element_count, dimensional_meaning, payload)
  if status \= 0 then return status
  do i = 1 to element_count
    values[i] = <at..f32>((i - 1) * 4) payload
  end
  return 0
