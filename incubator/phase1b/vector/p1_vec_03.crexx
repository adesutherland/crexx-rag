options levelb

import rxfnsb
import sqlite_boundary
import vector_codec
import vector_search

elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

makevector: procedure = .int
  arg first = .float, second = .float, dimension = .int, dense_tail = .int, expose payload = .binary
  values = .float[]
  values[1] = first
  values[2] = second
  do i = 3 to dimension
    if dense_tail = 0 then values[i] = 0.0
    else do
      pattern = i % 4
      if pattern = 0 then values[i] = -1.0
      else if pattern = 1 then values[i] = -0.5
      else if pattern = 2 then values[i] = 0.5
      else values[i] = 1.0
    end
  end
  return encodef32(values, payload)

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
row_total = 11684
dimension = 768
page_size = 128
top_k = 10
status = 0

query_payload = .binary
background_payload = .binary
top1_payload = .binary
tie_payload = .binary
top4_payload = .binary
if makevector(1.0, 0.0, dimension, 0, query_payload) \= 0 then status = -1
if makevector(0.0, 1.0, dimension, 1, background_payload) \= 0 then status = -1
if makevector(1.0, 0.0, dimension, 0, top1_payload) \= 0 then status = -1
if makevector(0.8, 0.6, dimension, 0, tie_payload) \= 0 then status = -1
if makevector(0.6, 0.8, dimension, 0, top4_payload) \= 0 then status = -1

db = .binary
statement = .binary
fixture_start = time("us")
if sqliteopen(database_path, db) \= 0 then status = -1
schema = "CREATE TABLE vector_fixture(identity INTEGER PRIMARY KEY,codec TEXT NOT NULL CHECK(codec='f32le-v1'),element_count INTEGER NOT NULL CHECK(element_count=768),dimensional_meaning TEXT NOT NULL CHECK(dimensional_meaning='embedding'),payload BLOB NOT NULL CHECK(length(payload)=element_count*4))"
if sqliteexec(db, schema) \= 0 then status = -1
if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then status = -1
if sqliteprepare(db, "INSERT INTO vector_fixture(identity,codec,element_count,dimensional_meaning,payload) VALUES(?1,?2,?3,?4,?5)", statement) \= 0 then status = -1
do identity = 1 to row_total while status = 0
  row_payload = background_payload
  if identity = 101 then row_payload = top1_payload
  else if identity = 202 | identity = 303 then row_payload = tie_payload
  else if identity = 404 then row_payload = top4_payload
  if sqlitebindint(statement, 1, identity) \= 0 | sqlitebindtext(statement, 2, f32codecversion()) \= 0 | sqlitebindint(statement, 3, dimension) \= 0 | sqlitebindtext(statement, 4, "embedding") \= 0 | sqlitebindblob(statement, 5, row_payload) \= 0 then status = -1
  if status = 0 then do
    if sqlitestep(statement) \= 101 | sqlitereset(statement) \= 0 then status = -1
  end
end
if sqlitefinalize(statement) \= 0 then status = -1
if sqliteexec(db, "COMMIT") \= 0 then status = -1
fixture_elapsed = elapsed_us(fixture_start)

transfer_elapsed = 0
decode_elapsed = 0
arithmetic_elapsed = 0
selection_elapsed = 0
transfer_bytes = 0
decode_checksum = 0
score_checksum = 0.0
page_count = 0
rows_seen = 0
last_identity = 0
global_ids = .int[]
global_scores = .float[]

total_start = time("us")
statement = .binary
if sqliteprepare(db, "SELECT identity,codec,element_count,dimensional_meaning,payload FROM vector_fixture WHERE identity>?1 ORDER BY identity LIMIT ?2", statement) \= 0 then status = -1
do while status = 0
  transfer_start = time("us")
  if sqlitebindint(statement, 1, last_identity) \= 0 | sqlitebindint(statement, 2, page_size) \= 0 then status = -1
  page_ids = .int[]
  page_codecs = .string[]
  page_counts = .int[]
  page_meanings = .string[]
  page_payloads = .binary[]
  page_rows = 0
  do while status = 0
    step_status = sqlitestep(statement)
    if step_status = 101 then leave
    if step_status \= 100 then do
      status = -1
      leave
    end
    identity = 0
    codec = ""
    count = 0
    meaning = ""
    payload = .binary
    if sqlitecolumnint(statement, 0, identity) \= 0 | sqlitecolumntext(statement, 1, codec) \= 0 | sqlitecolumnint(statement, 2, count) \= 0 | sqlitecolumntext(statement, 3, meaning) \= 0 | sqlitecolumnblob(statement, 4, payload) \= 0 then do
      status = -1
      leave
    end
    page_rows = page_rows + 1
    page_ids[page_rows] = identity
    page_codecs[page_rows] = codec
    page_counts[page_rows] = count
    page_meanings[page_rows] = meaning
    page_payloads[page_rows] = payload
    transfer_bytes = transfer_bytes + binlength(payload)
    last_identity = identity
  end
  if sqlitereset(statement) \= 0 then status = -1
  transfer_elapsed = transfer_elapsed + elapsed_us(transfer_start)
  if status \= 0 | page_rows = 0 then leave
  page_count = page_count + 1
  rows_seen = rows_seen + page_rows

  decode_start = time("us")
  do i = 1 to page_rows
    if validatef32blob(page_codecs[i], page_counts[i], page_meanings[i], page_payloads[i]) \= 0 then status = -1
    decode_checksum = decode_checksum + binlength(page_payloads[i])
  end
  decode_elapsed = decode_elapsed + elapsed_us(decode_start)
  if status \= 0 then leave

  page_scores = .float[]
  arithmetic_start = time("us")
  if cosinesf32(page_payloads, page_counts, query_payload, dimension, page_scores) \= 0 then status = -1
  arithmetic_elapsed = arithmetic_elapsed + elapsed_us(arithmetic_start)
  if status \= 0 then leave
  do i = 1 to page_scores.0
    score_checksum = score_checksum + page_scores[i]
  end

  selection_start = time("us")
  page_top_ids = .int[]
  page_top_scores = .float[]
  if selecttopk(page_ids, page_scores, top_k, page_top_ids, page_top_scores) \= 0 then status = -1
  combined_ids = .int[]
  combined_scores = .float[]
  combined_count = 0
  do i = 1 to global_ids.0
    combined_count = combined_count + 1
    combined_ids[combined_count] = global_ids[i]
    combined_scores[combined_count] = global_scores[i]
  end
  do i = 1 to page_top_ids.0
    combined_count = combined_count + 1
    combined_ids[combined_count] = page_top_ids[i]
    combined_scores[combined_count] = page_top_scores[i]
  end
  next_ids = .int[]
  next_scores = .float[]
  if selecttopk(combined_ids, combined_scores, top_k, next_ids, next_scores) \= 0 then status = -1
  global_ids = next_ids
  global_scores = next_scores
  selection_elapsed = selection_elapsed + elapsed_us(selection_start)
end
if sqlitefinalize(statement) \= 0 then status = -1
total_elapsed = elapsed_us(total_start)

top_checksum = 0
do i = 1 to global_ids.0
  top_checksum = top_checksum + global_ids[i]
end
estimated_working_bytes = page_size * dimension * 4 + binlength(query_payload) + page_size * 24 + top_k * 32

say cell || ",fixture_build," || fixture_elapsed || "," || row_total || "," || transfer_bytes || "," || row_total || ",ok"
say cell || ",sqlite_transfer," || transfer_elapsed || "," || rows_seen || "," || transfer_bytes || "," || last_identity || ",ok"
say cell || ",decode," || decode_elapsed || "," || rows_seen || "," || transfer_bytes || "," || decode_checksum || ",ok"
say cell || ",arithmetic," || arithmetic_elapsed || "," || (rows_seen * dimension) || "," || transfer_bytes || "," || score_checksum || ",ok"
say cell || ",selection," || selection_elapsed || "," || rows_seen || ",0," || top_checksum || ",ok"
say cell || ",estimated_working_memory,0," || page_size || "," || estimated_working_bytes || "," || estimated_working_bytes || ",ok"
say cell || ",total," || total_elapsed || "," || rows_seen || "," || transfer_bytes || "," || top_checksum || ",ok"

if rows_seen \= row_total | page_count \= 92 | transfer_bytes \= 35893248 then status = -1
if global_ids.0 \= top_k then status = -1
else if global_ids[1] \= 101 | global_ids[2] \= 202 | global_ids[3] \= 303 | global_ids[4] \= 404 | global_ids[5] \= 1 | global_ids[10] \= 6 then status = -1
if top_checksum \= 1031 then status = -1
if sqliteclose(db) \= 0 then status = -1
if status \= 0 then do
  say "P1_VEC_03_FAIL cell=" || cell || " status=" || status
  return 1
end
say "P1_VEC_03_OK cell=" || cell || " rows=11684 dimension=768 pages=92 top_checksum=1031 components=sqlite_transfer,decode,arithmetic,selection,estimated_working_memory,total"
return 0
