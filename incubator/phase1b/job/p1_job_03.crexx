options levelb

import rxfnsb
import sqlite_boundary
import job_queue
import job_budget

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_JOB_03_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
errors = 0
db = .binary
errors = errors + check(sqliteopen(database_path, db) = 0 & jobschema(db) = 0 & budgetschema(db) = 0, "scratch schemas")
errors = errors + check(createjob(db, "job-budget", "local-openai-compatible", "fixture-model") = 0, "create job")
errors = errors + check(configurebudget(db, "job-budget", 2, 2, 150, 30, 799, 1, 100, 20, 500) = 0, "configure hard ceilings")

errors = errors + check(admititem(db, "job-budget", "item-budget-1", "idem-budget-1", "budgeted work") = 0 & admititem(db, "job-budget", "item-budget-2", "idem-budget-2", "second work") = 0, "admit item ceiling")
before_item_denial = scalarcount(db, "SELECT total_changes()")
errors = errors + check(admititem(db, "job-budget", "item-budget-3", "idem-budget-3", "denied work") = -10 & scalarcount(db, "SELECT total_changes()") = before_item_denial, "item ceiling zero-write denial")

fence = 0; attempt = ""; lease = 0
errors = errors + check(claimitem(db, "item-budget-1", "worker-budget", 120, fence, attempt, lease) = 0, "claim budgeted item")
reservation1 = ""
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 100, 20, 500, reservation1) = 0 & reservation1 = "job-budget#call-1", "pre-call maximum reservation")
inflight_denied = ""
before_inflight_denial = scalarcount(db, "SELECT total_changes()")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 1, 1, 1, inflight_denied) = -16 & scalarcount(db, "SELECT total_changes()") = before_inflight_denial, "single-process inflight ceiling")
call1_output = providerwork("budgeted provider call one")
errors = errors + check(settlecall(db, reservation1, 60, 12, 300) = 0 & length(call1_output) > 0, "settle actual one and release difference")

denied = ""
before_denials = scalarcount(db, "SELECT total_changes()")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 100, 1, 1, denied) = -12, "token ceiling")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 80, 19, 1, denied) = -13, "cost ceiling")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 80, 15, 501, denied) = -15, "per-call time cap")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 80, 15, 500, denied) = -14, "job time ceiling")
errors = errors + check(scalarcount(db, "SELECT total_changes()") = before_denials, "denied reservations zero-write")

reservation2 = ""
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 80, 15, 400, reservation2) = 0 & reservation2 = "job-budget#call-2", "second pre-call reservation")
call2_output = providerwork("budgeted provider call two")
errors = errors + check(settlecall(db, reservation2, 70, 14, 350) = 0 & length(call2_output) > 0, "settle actual two")
denied = ""
before_call_denial = scalarcount(db, "SELECT total_changes()")
errors = errors + check(reservecall(db, "item-budget-1", "worker-budget", fence, attempt, 1, 1, 1, denied) = -11 & scalarcount(db, "SELECT total_changes()") = before_call_denial, "call ceiling zero-write denial")

status = readbudget(db, "job-budget")
errors = errors + check(status.item_ceiling() = 2 & status.items_admitted() = 2 & status.call_ceiling() = 2 & status.calls_admitted() = 2 & status.calls_actual() = 2 & status.calls_inflight() = 0, "item and call status")
errors = errors + check(status.tokens_reserved() = 0 & status.tokens_actual() = 130 & status.cost_reserved() = 0 & status.cost_actual() = 26 & status.time_reserved() = 0 & status.time_actual() = 650, "reserved and actual usage")
errors = errors + check(status.maximum_inflight_calls() = 1 & status.maximum_inflight_tokens() = 100 & status.maximum_inflight_cost() = 20 & status.maximum_inflight_time() = 500, "documented maximum in-flight exposure")
errors = errors + check(promoteitem(db, "item-budget-1", "worker-budget", fence, attempt, "support-budget", call1_output || ";" || call2_output) = 0, "promote after settled calls")

errors = errors + check(sqliteclose(db) = 0, "close")
if errors \= 0 then do
  say "P1_JOB_03_ERRORS=" || errors
  return 1
end
say "P1_JOB_03_OK cell=" || cell || " item_ceiling=2 item_denial=-10 call_ceiling=2 call_denial=-11 token_denial=-12 cost_denial=-13 time_denial=-14 per_call_cap_denial=-15 inflight_denial=-16 calls_actual=2 tokens_reserved=0 tokens_actual=130 cost_reserved=0 cost_actual=26 time_reserved_ms=0 time_actual_ms=650 max_inflight_calls=1 max_inflight_tokens=100 max_inflight_cost=20 max_inflight_time_ms=500 denied_writes=0"
return 0
