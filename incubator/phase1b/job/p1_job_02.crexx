options levelg

import rxfnsb
import sqlite_boundary
import job_queue
import job_faults

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_JOB_02_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
stage = args[1]
database_path = args[2]
cell = args[3]
db = .binary
if sqliteopen(database_path, db) \= 0 then return 3

if stage = "init" then do
  errors = 0
  errors = errors + check(jobschema(db) = 0, "schema")
  errors = errors + check(createjob(db, "job-before-call", "synthetic", "fixture") = 0 & createitem(db, "job-before-call", "item-before-call", "idem-before-call", "before call") = 0, "before-call item")
  errors = errors + check(createjob(db, "job-after-call", "synthetic", "fixture") = 0 & createitem(db, "job-after-call", "item-after-call", "idem-after-call", "after call") = 0, "after-call item")
  errors = errors + check(createjob(db, "job-during-promotion", "synthetic", "fixture") = 0 & createitem(db, "job-during-promotion", "item-during-promotion", "idem-during-promotion", "during promotion") = 0, "during-promotion item")
  errors = errors + check(createjob(db, "job-after-promotion", "synthetic", "fixture") = 0 & createitem(db, "job-after-promotion", "item-after-promotion", "idem-after-promotion", "after promotion") = 0, "after-promotion item")
  call sqliteclose db
  if errors \= 0 then return 1
  say "P1_JOB_02_STAGE cell=" || cell || " stage=init state=queued items=4"
  return 0
end

if stage = "crash-before-call" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-before-call", "worker-a", 0, fence, attempt, lease) \= 0 | fence \= 1 then return 4
  say "P1_JOB_02_STAGE cell=" || cell || " stage=crash-before-call forced=1 fence=1 claim_committed=1 provider_calls=0"
  return 71
end

if stage = "recover-before-call" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-before-call", "worker-b", 60, fence, attempt, lease) \= 0 | fence \= 2 then return 5
  output = providerwork("before call")
  if promoteitem(db, "item-before-call", "worker-b", fence, attempt, "support-before-call", output) \= 0 then return 6
  if promoteitem(db, "item-before-call", "worker-a", 1, "item-before-call#attempt-1", "support-before-call", "STALE") \= -4 then return 7
  call sqliteclose db
  say "P1_JOB_02_STAGE cell=" || cell || " stage=recover-before-call fence=2 stale_rejected=1 supports=1"
  return 0
end

if stage = "crash-after-call" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-after-call", "worker-a", 0, fence, attempt, lease) \= 0 | fence \= 3 then return 8
  output = providerwork("after call")
  say "P1_JOB_02_STAGE cell=" || cell || " stage=crash-after-call forced=1 fence=3 provider_calls=1 output_uncommitted=1"
  return 72
end

if stage = "recover-after-call" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-after-call", "worker-b", 60, fence, attempt, lease) \= 0 | fence \= 4 then return 9
  output = providerwork("after call")
  if promoteitem(db, "item-after-call", "worker-b", fence, attempt, "support-after-call", output) \= 0 then return 10
  call sqliteclose db
  say "P1_JOB_02_STAGE cell=" || cell || " stage=recover-after-call fence=4 repeated_provider_call=1 duplicate_support=0"
  return 0
end

if stage = "crash-during-promotion" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-during-promotion", "worker-a", 0, fence, attempt, lease) \= 0 | fence \= 5 then return 11
  output = providerwork("during promotion")
  if stagepromotion(db, "item-during-promotion", "worker-a", fence, attempt, "support-during-promotion", output) \= 0 then return 12
  say "P1_JOB_02_STAGE cell=" || cell || " stage=crash-during-promotion forced=1 fence=5 transaction_open=1 staged_support=1 commit=0"
  return 73
end

if stage = "recover-during-promotion" then do
  if scalarcount(db, "SELECT count(*) FROM promoted_support") \= 2 then return 13
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-during-promotion", "worker-b", 60, fence, attempt, lease) \= 0 | fence \= 6 then return 14
  output = providerwork("during promotion")
  if promoteitem(db, "item-during-promotion", "worker-b", fence, attempt, "support-during-promotion", output) \= 0 then return 15
  call sqliteclose db
  say "P1_JOB_02_STAGE cell=" || cell || " stage=recover-during-promotion fence=6 uncommitted_support_rolled_back=1 duplicate_support=0"
  return 0
end

if stage = "crash-after-promotion" then do
  fence = 0; attempt = ""; lease = 0
  if claimitem(db, "item-after-promotion", "worker-a", 60, fence, attempt, lease) \= 0 | fence \= 7 then return 16
  output = providerwork("after promotion")
  if promoteitem(db, "item-after-promotion", "worker-a", fence, attempt, "support-after-promotion", output) \= 0 then return 17
  say "P1_JOB_02_STAGE cell=" || cell || " stage=crash-after-promotion forced=1 fence=7 promotion_committed=1"
  return 74
end

if stage = "recover-after-promotion" then do
  errors = 0
  output = providerwork("after promotion")
  errors = errors + check(promoteitem(db, "item-after-promotion", "worker-a", 7, "item-after-promotion#attempt-7", "support-after-promotion", output) = 1, "idempotent committed promotion")
  errors = errors + check(scalarcount(db, "SELECT count(*) FROM promoted_support") = 4 & scalarcount(db, "SELECT count(*) FROM fence_tokens") = 7 & scalarcount(db, "SELECT count(*) FROM attempts") = 7, "durable recovery counts")
  errors = errors + check(scalarcount(db, "SELECT count(*) FROM attempts WHERE state='expired'") = 3 & scalarcount(db, "SELECT count(*) FROM attempts WHERE state='succeeded'") = 4, "attempt history")
  errors = errors + check(scalarcount(db, "SELECT count(*) FROM jobs WHERE state='completed'") = 4 & scalarcount(db, "SELECT count(*) FROM job_items WHERE state='processed'") = 4, "all work complete")
  call sqliteclose db
  if errors \= 0 then return 1
  say "P1_JOB_02_OK cell=" || cell || " forced_boundaries=before-call,after-call,during-promotion,after-promotion fences=7 attempts=7 expired_attempts=3 succeeded_attempts=4 stale_rejected=1 uncommitted_rollback=1 committed_replay=idempotent supports=4 duplicate_support=0 maximum_provider_replay=1"
  return 0
end

call sqliteclose db
return 20
