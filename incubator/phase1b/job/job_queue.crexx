options levelb

namespace job_queue expose jobstatus jobschema createjob createitem claimitem heartbeat providerwork promoteitem requestcancel acknowledgecancel readstatus dbnow scalarcount

import rxfnsb
import sqlite_boundary

jobstatus: class
  _job_key = .string
  _state = .string
  _planned_total = .int
  _queued = .int
  _running = .int
  _processed = .int
  _cancelled = .int
  _failed_attempts = .int
  _current_item = .string

  *: factory
    arg job_key = .string, state = .string, planned_total = .int, queued = .int, running = .int, processed = .int, cancelled = .int, failed_attempts = .int, current_item = .string
    _job_key = job_key; _state = state; _planned_total = planned_total
    _queued = queued; _running = running; _processed = processed
    _cancelled = cancelled; _failed_attempts = failed_attempts
    _current_item = current_item
    return
  job_key: method = .string
    return _job_key
  state: method = .string
    return _state
  planned_total: method = .int
    return _planned_total
  queued: method = .int
    return _queued
  running: method = .int
    return _running
  processed: method = .int
    return _processed
  cancelled: method = .int
    return _cancelled
  failed_attempts: method = .int
    return _failed_attempts
  current_item: method = .string
    return _current_item

jobschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "PRAGMA foreign_keys=ON") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE fence_tokens(token INTEGER PRIMARY KEY AUTOINCREMENT)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE jobs(job_key TEXT PRIMARY KEY,state TEXT NOT NULL CHECK(state IN('queued','running','cancel_requested','cancelled','completed','failed')),planned_total INTEGER NOT NULL DEFAULT 0,provider TEXT NOT NULL,model TEXT NOT NULL,created_at INTEGER NOT NULL DEFAULT(CAST(strftime('%s','now') AS INTEGER)))") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE job_items(item_key TEXT PRIMARY KEY,job_key TEXT NOT NULL REFERENCES jobs(job_key),idempotency_key TEXT NOT NULL,input TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN('queued','running','cancel_requested','cancelled','processed')),worker_id TEXT NOT NULL DEFAULT '',lease_until INTEGER NOT NULL DEFAULT 0,fence INTEGER NOT NULL DEFAULT 0,attempt_count INTEGER NOT NULL DEFAULT 0,current_attempt TEXT NOT NULL DEFAULT '',output TEXT NOT NULL DEFAULT '',last_error TEXT NOT NULL DEFAULT '',UNIQUE(job_key,idempotency_key))") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE attempts(attempt_key TEXT PRIMARY KEY,item_key TEXT NOT NULL REFERENCES job_items(item_key),fence INTEGER NOT NULL,worker_id TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN('running','succeeded','expired','cancelled','failed')),started_at INTEGER NOT NULL,heartbeat_at INTEGER NOT NULL,completed_at INTEGER,UNIQUE(item_key,fence))") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE promoted_support(item_key TEXT NOT NULL REFERENCES job_items(item_key),support_key TEXT NOT NULL,output TEXT NOT NULL,fence INTEGER NOT NULL,PRIMARY KEY(item_key,support_key))") \= 0 then return -1
  return 0

createjob: procedure = .int
  arg db = .binary, job_key = .string, provider = .string, model = .string
  statement = .binary
  if sqliteprepare(db, "INSERT INTO jobs(job_key,state,provider,model) VALUES(?1,'queued',?2,?3)", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, job_key
  call sqlitebindtext statement, 2, provider
  call sqlitebindtext statement, 3, model
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

createitem: procedure = .int
  arg db = .binary, job_key = .string, item_key = .string, idempotency_key = .string, input = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  statement = .binary
  if sqliteprepare(db, "INSERT INTO job_items(item_key,job_key,idempotency_key,input,state) VALUES(?1,?2,?3,?4,'queued')", statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, job_key
  call sqlitebindtext statement, 3, idempotency_key
  call sqlitebindtext statement, 4, input
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE jobs SET planned_total=planned_total+1 WHERE job_key=?1 AND state='queued'", job_key) \= 0 then return _rollback(db)
  if scalarcount(db, "SELECT changes()") \= 1 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

claimitem: procedure = .int
  arg db = .binary, item_key = .string, worker_id = .string, lease_seconds = .int, expose fence = .int, expose attempt_key = .string, expose lease_until = .int
  fence = 0; attempt_key = ""; lease_until = 0
  if lease_seconds < 0 then return -7
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""; job_state = ""; current_fence = 0; current_attempt = ""; current_lease = 0; job_key = ""; current_worker = ""; output = ""
  if _read_item(db, item_key, state, job_state, job_key, current_worker, current_lease, current_fence, current_attempt, output) \= 0 then return _rollback(db)
  now = dbnow(db)
  if state = "processed" then do; call sqliteexec db, "ROLLBACK"; return -2; end
  if state = "cancelled" | state = "cancel_requested" | job_state = "cancel_requested" | job_state = "cancelled" then do; call sqliteexec db, "ROLLBACK"; return -5; end
  if state = "running" & current_lease > now then do; call sqliteexec db, "ROLLBACK"; return -3; end
  if state = "running" & current_attempt \= "" then do
    if _bound_text_exec(db, "UPDATE attempts SET state='expired',completed_at=CAST(strftime('%s','now') AS INTEGER) WHERE attempt_key=?1 AND state='running'", current_attempt) \= 0 then return _rollback(db)
  end
  if sqliteexec(db, "INSERT INTO fence_tokens DEFAULT VALUES") \= 0 then return _rollback(db)
  fence = scalarcount(db, "SELECT last_insert_rowid()")
  if fence <= current_fence then return _rollback(db)
  attempt_key = item_key || "#attempt-" || fence

  statement = .binary
  sql = "UPDATE job_items SET state='running',worker_id=?1,lease_until=CAST(strftime('%s','now') AS INTEGER)+?2,fence=?3,attempt_count=attempt_count+1,current_attempt=?4,last_error='' WHERE item_key=?5 AND (state='queued' OR (state='running' AND lease_until<=CAST(strftime('%s','now') AS INTEGER)))"
  if sqliteprepare(db, sql, statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, worker_id
  call sqlitebindint statement, 2, lease_seconds
  call sqlitebindint statement, 3, fence
  call sqlitebindtext statement, 4, attempt_key
  call sqlitebindtext statement, 5, item_key
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 | scalarcount(db, "SELECT changes()") \= 1 then return _rollback(db)

  statement = .binary
  if sqliteprepare(db, "INSERT INTO attempts(attempt_key,item_key,fence,worker_id,state,started_at,heartbeat_at) VALUES(?1,?2,?3,?4,'running',CAST(strftime('%s','now') AS INTEGER),CAST(strftime('%s','now') AS INTEGER))", statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, attempt_key
  call sqlitebindtext statement, 2, item_key
  call sqlitebindint statement, 3, fence
  call sqlitebindtext statement, 4, worker_id
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE jobs SET state='running' WHERE job_key=?1 AND state='queued'", job_key) \= 0 then return _rollback(db)
  lease_until = _item_lease(db, item_key)
  if lease_until < 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

heartbeat: procedure = .int
  arg db = .binary, item_key = .string, worker_id = .string, fence = .int, attempt_key = .string, lease_seconds = .int, expose lease_until = .int
  lease_until = 0
  if lease_seconds < 0 then return -7
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""; job_state = ""; job_key = ""; current_worker = ""; current_lease = 0; current_fence = 0; current_attempt = ""; output = ""
  if _read_item(db, item_key, state, job_state, job_key, current_worker, current_lease, current_fence, current_attempt, output) \= 0 then return _rollback(db)
  if state = "cancel_requested" | job_state = "cancel_requested" then do; call sqliteexec db, "ROLLBACK"; return -5; end
  if state \= "running" | current_worker \= worker_id | current_fence \= fence | current_attempt \= attempt_key then do; call sqliteexec db, "ROLLBACK"; return -4; end
  if current_lease <= dbnow(db) then do; call sqliteexec db, "ROLLBACK"; return -6; end
  statement = .binary
  sql = "UPDATE job_items SET lease_until=CAST(strftime('%s','now') AS INTEGER)+?1 WHERE item_key=?2 AND worker_id=?3 AND fence=?4 AND current_attempt=?5 AND state='running'"
  if sqliteprepare(db, sql, statement) \= 0 then return _rollback(db)
  call sqlitebindint statement, 1, lease_seconds
  call sqlitebindtext statement, 2, item_key
  call sqlitebindtext statement, 3, worker_id
  call sqlitebindint statement, 4, fence
  call sqlitebindtext statement, 5, attempt_key
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 | scalarcount(db, "SELECT changes()") \= 1 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE attempts SET heartbeat_at=CAST(strftime('%s','now') AS INTEGER) WHERE attempt_key=?1 AND state='running'", attempt_key) \= 0 then return _rollback(db)
  if scalarcount(db, "SELECT changes()") \= 1 then return _rollback(db)
  lease_until = _item_lease(db, item_key)
  if lease_until < 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

providerwork: procedure = .string
  arg input = .string
  return translate(input) || ":COMPLETE"

promoteitem: procedure = .int
  arg db = .binary, item_key = .string, worker_id = .string, fence = .int, attempt_key = .string, support_key = .string, output = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""; job_state = ""; job_key = ""; current_worker = ""; lease_until = 0; current_fence = 0; current_attempt = ""; current_output = ""
  if _read_item(db, item_key, state, job_state, job_key, current_worker, lease_until, current_fence, current_attempt, current_output) \= 0 then return _rollback(db)
  if current_fence \= fence | current_attempt \= attempt_key | current_worker \= worker_id then do; call sqliteexec db, "ROLLBACK"; return -4; end
  if state = "processed" then do
    existing = _support_count(db, item_key, support_key, output)
    call sqliteexec db, "COMMIT"
    if existing = 1 & current_output = output then return 1
    return -8
  end
  if state = "cancel_requested" | job_state = "cancel_requested" then do; call sqliteexec db, "ROLLBACK"; return -5; end
  if state \= "running" then do; call sqliteexec db, "ROLLBACK"; return -3; end
  if lease_until <= dbnow(db) then do; call sqliteexec db, "ROLLBACK"; return -6; end
  if _insert_support(db, item_key, support_key, output, fence) \= 0 then return _rollback(db)
  if _finish_promotion(db, item_key, job_key, attempt_key, output) \= 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

requestcancel: procedure = .int
  arg db = .binary, job_key = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  if _bound_text_exec(db, "UPDATE jobs SET state='cancel_requested' WHERE job_key=?1 AND state IN('queued','running')", job_key) \= 0 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE job_items SET state='cancelled' WHERE job_key=?1 AND state='queued'", job_key) \= 0 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE job_items SET state='cancel_requested' WHERE job_key=?1 AND state='running'", job_key) \= 0 then return _rollback(db)
  statement = .binary
  if sqliteprepare(db, "UPDATE jobs SET state='cancelled' WHERE job_key=?1 AND NOT EXISTS(SELECT 1 FROM job_items WHERE job_key=?1 AND state='cancel_requested')", statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, job_key
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

acknowledgecancel: procedure = .int
  arg db = .binary, item_key = .string, worker_id = .string, fence = .int, attempt_key = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""; job_state = ""; job_key = ""; current_worker = ""; lease_until = 0; current_fence = 0; current_attempt = ""; output = ""
  if _read_item(db, item_key, state, job_state, job_key, current_worker, lease_until, current_fence, current_attempt, output) \= 0 then return _rollback(db)
  if state \= "cancel_requested" | current_worker \= worker_id | current_fence \= fence | current_attempt \= attempt_key then do; call sqliteexec db, "ROLLBACK"; return -4; end
  if _bound_text_exec(db, "UPDATE job_items SET state='cancelled',lease_until=0 WHERE item_key=?1", item_key) \= 0 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE attempts SET state='cancelled',completed_at=CAST(strftime('%s','now') AS INTEGER) WHERE attempt_key=?1 AND state='running'", attempt_key) \= 0 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE jobs SET state='cancelled' WHERE job_key=?1", job_key) \= 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

readstatus: procedure = .jobstatus
  arg db = .binary, job_key = .string
  invalid = .jobstatus("", "missing", 0, 0, 0, 0, 0, 0, "")
  statement = .binary
  sql = "SELECT j.state,j.planned_total,sum(CASE WHEN i.state='queued' THEN 1 ELSE 0 END),sum(CASE WHEN i.state IN('running','cancel_requested') THEN 1 ELSE 0 END),sum(CASE WHEN i.state='processed' THEN 1 ELSE 0 END),sum(CASE WHEN i.state='cancelled' THEN 1 ELSE 0 END),(SELECT count(*) FROM attempts a JOIN job_items ai ON ai.item_key=a.item_key WHERE ai.job_key=j.job_key AND a.state IN('expired','failed')) FROM jobs j LEFT JOIN job_items i ON i.job_key=j.job_key WHERE j.job_key=?1 GROUP BY j.job_key,j.state,j.planned_total"
  if sqliteprepare(db, sql, statement) \= 0 then return invalid
  call sqlitebindtext statement, 1, job_key
  if sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return invalid; end
  state = ""; planned = 0; queued = 0; running = 0; processed = 0; cancelled = 0; failed_attempts = 0
  call sqlitecolumntext statement, 0, state
  call sqlitecolumnint statement, 1, planned
  call sqlitecolumnint statement, 2, queued
  call sqlitecolumnint statement, 3, running
  call sqlitecolumnint statement, 4, processed
  call sqlitecolumnint statement, 5, cancelled
  call sqlitecolumnint statement, 6, failed_attempts
  call sqlitefinalize statement
  current_item = ""
  statement = .binary
  if sqliteprepare(db, "SELECT item_key FROM job_items WHERE job_key=?1 AND state IN('running','cancel_requested') ORDER BY item_key LIMIT 1", statement) = 0 then do
    call sqlitebindtext statement, 1, job_key
    if sqlitestep(statement) = 100 then call sqlitecolumntext statement, 0, current_item
    call sqlitefinalize statement
  end
  return .jobstatus(job_key, state, planned, queued, running, processed, cancelled, failed_attempts, current_item)

dbnow: procedure = .int
  arg db = .binary
  return scalarcount(db, "SELECT CAST(strftime('%s','now') AS INTEGER)")

scalarcount: procedure = .int
  arg db = .binary, sql = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  if sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -1; end
  value = -1
  call sqlitecolumnint statement, 0, value
  call sqlitefinalize statement
  return value

_read_item: procedure = .int
  arg db = .binary, item_key = .string, expose state = .string, expose job_state = .string, expose job_key = .string, expose worker_id = .string, expose lease_until = .int, expose fence = .int, expose attempt_key = .string, expose output = .string
  statement = .binary
  sql = "SELECT i.state,j.state,i.job_key,i.worker_id,i.lease_until,i.fence,i.current_attempt,i.output FROM job_items i JOIN jobs j ON j.job_key=i.job_key WHERE i.item_key=?1"
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  if sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -2; end
  call sqlitecolumntext statement, 0, state
  call sqlitecolumntext statement, 1, job_state
  call sqlitecolumntext statement, 2, job_key
  call sqlitecolumntext statement, 3, worker_id
  call sqlitecolumnint statement, 4, lease_until
  call sqlitecolumnint statement, 5, fence
  call sqlitecolumntext statement, 6, attempt_key
  call sqlitecolumntext statement, 7, output
  call sqlitefinalize statement
  return 0

_insert_support: procedure = .int
  arg db = .binary, item_key = .string, support_key = .string, output = .string, fence = .int
  statement = .binary
  if sqliteprepare(db, "INSERT OR IGNORE INTO promoted_support(item_key,support_key,output,fence) VALUES(?1,?2,?3,?4)", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, support_key
  call sqlitebindtext statement, 3, output
  call sqlitebindint statement, 4, fence
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

_finish_promotion: procedure = .int
  arg db = .binary, item_key = .string, job_key = .string, attempt_key = .string, output = .string
  statement = .binary
  if sqliteprepare(db, "UPDATE job_items SET state='processed',output=?1,lease_until=0 WHERE item_key=?2", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, output
  call sqlitebindtext statement, 2, item_key
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status \= 101 then return -1
  if _bound_text_exec(db, "UPDATE attempts SET state='succeeded',completed_at=CAST(strftime('%s','now') AS INTEGER) WHERE attempt_key=?1 AND state='running'", attempt_key) \= 0 then return -1
  statement = .binary
  if sqliteprepare(db, "UPDATE jobs SET state='completed' WHERE job_key=?1 AND NOT EXISTS(SELECT 1 FROM job_items WHERE job_key=?1 AND state IN('queued','running','cancel_requested'))", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, job_key
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

_support_count: procedure = .int
  arg db = .binary, item_key = .string, support_key = .string, output = .string
  statement = .binary
  if sqliteprepare(db, "SELECT count(*) FROM promoted_support WHERE item_key=?1 AND support_key=?2 AND output=?3", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, support_key
  call sqlitebindtext statement, 3, output
  if sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -1; end
  count = 0
  call sqlitecolumnint statement, 0, count
  call sqlitefinalize statement
  return count

_item_lease: procedure = .int
  arg db = .binary, item_key = .string
  statement = .binary
  if sqliteprepare(db, "SELECT lease_until FROM job_items WHERE item_key=?1", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  if sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -1; end
  lease_until = -1
  call sqlitecolumnint statement, 0, lease_until
  call sqlitefinalize statement
  return lease_until

_bound_text_exec: procedure = .int
  arg db = .binary, sql = .string, value = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, value
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

_rollback: procedure = .int
  arg db = .binary
  call sqliteexec db, "ROLLBACK"
  return -1
