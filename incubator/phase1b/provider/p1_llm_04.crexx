options levelg

import provider_contract
import provider_catalog
import provider_facade
import industrial_provider
import openai_compatible_provider
import rxfnsb

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_LLM_04_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
host = args[1]
port = args[2] as .int
cell = args[3]
errors = 0
schema = '{"type":"object","required":["answer"],"properties":{"answer":{"type":"string"}}}'
unused_inputs = .string[]
unused_inputs[1] = "unused"

errors = errors + check(knownmodelcount() = 8, "model catalog count")
openai_model = lookupmodelcapability("openai", "gpt-5.6-luna")
anthropic_model = lookupmodelcapability("anthropic", "claude-haiku-4-5")
gemini_embedding_model = lookupmodelcapability("gemini", "gemini-embedding-2")
errors = errors + check(openai_model.structured() = 1 & openai_model.cost_tier() = "low" & openai_model.input_usd_micros_per_million() = 200000, "OpenAI model capabilities and cost")
errors = errors + check(anthropic_model.context_tokens() = 200000 & anthropic_model.max_output_tokens() = 64000, "Anthropic model limits")
errors = errors + check(gemini_embedding_model.operations() = "embed|embed_batch" & gemini_embedding_model.input_modalities() = "text|image_url|document_url|audio_url", "Gemini embedding modalities")

openai = .industrialprovider("openai", host, port, 0, "/openai/v1", "synthetic-openai-key", "local")
openai_facade = .normalizedproviderfacade(openai)
openai_capabilities = openai_facade.capabilities()
errors = errors + check(openai_capabilities.request_format() = "openai-responses" & openai_capabilities.batch_embeddings() = 1, "OpenAI adapter capabilities")
openai_messages = .providermessage[]
openai_messages[1] = .providermessage("system", "Inspect the supplied image")
openai_messages[2] = .providermessage("user", "", "image_url", "image/png", "https://fixture.invalid/image.png")
openai_request = .providerrequest("generate_structured", "vision", "gpt-5.6-luna", openai_messages, unused_inputs, schema, 2000, 1, "public", "openai-generate-" || cell, "openai-generate-" || cell, 16, 0, 0, 0)
openai_result = openai_facade.generate_structured(openai_request)
openai_usage = openai_result.usage()
errors = errors + check(openai_result.status() = 0 & openai_result.content() = '{"answer":"openai"}' & pos("loopback-request-", openai_result.request_id()) = 1, "OpenAI Responses shape")
errors = errors + check(openai_usage.input_tokens() = 11 & openai_usage.output_tokens() = 5, "OpenAI usage")

openai_inputs = .string[]
openai_inputs[1] = "index one"
openai_inputs[2] = "index two"
openai_embedding_request = .providerrequest("embed_batch", "indexing", "text-embedding-3-small", openai_messages, openai_inputs, "", 2000, 1, "public", "openai-embed-" || cell, "openai-embed-" || cell, 0, 3, 0)
openai_embedding_result = openai_facade.embed_batch(openai_embedding_request)
openai_vectors = openai_embedding_result.embeddings()
errors = errors + check(openai_embedding_result.status() = 0 & openai_vectors.0 = 2, "OpenAI batch embedding shape")
if openai_vectors.0 = 2 then errors = errors + check(openai_vectors[1].count() = 3 & openai_vectors[2].valid() = 1, "OpenAI embedding projection")

anthropic = .industrialprovider("anthropic", host, port, 0, "/anthropic/v1", "synthetic-anthropic-key", "local")
anthropic_capabilities = anthropic.capabilities()
errors = errors + check(anthropic_capabilities.request_format() = "anthropic-messages" & anthropic_capabilities.embeddings() = 0, "Anthropic adapter capabilities")
anthropic_messages = .providermessage[]
anthropic_messages[1] = .providermessage("system", "Extract from the supplied document")
anthropic_messages[2] = .providermessage("user", "", "document_url", "application/pdf", "https://fixture.invalid/source.pdf")
anthropic_request = .providerrequest("generate_structured", "document", "claude-haiku-4-5", anthropic_messages, unused_inputs, schema, 2000, 1, "public", "anthropic-generate-" || cell, "anthropic-generate-" || cell, 16, 0, 0, 0)
anthropic_result = anthropic.generate_structured(anthropic_request)
anthropic_usage = anthropic_result.usage()
errors = errors + check(anthropic_result.status() = 0 & anthropic_result.content() = '{"answer":"anthropic"}' & anthropic_result.finish_reason() = "end_turn", "Anthropic Messages shape")
errors = errors + check(anthropic_usage.input_tokens() = 12 & anthropic_usage.output_tokens() = 5, "Anthropic usage")
anthropic_embedding_request = .providerrequest("embed", "indexing", "none", anthropic_messages, unused_inputs, "", 2000, 1, "public", "anthropic-embed-" || cell, "anthropic-embed-" || cell, 0, 0, 0)
anthropic_embedding_result = anthropic.embed(anthropic_embedding_request)
anthropic_embedding_error = anthropic_embedding_result.error()
errors = errors + check(anthropic_embedding_result.status() = -120 & anthropic_embedding_error.category() = "unsupported", "Anthropic embeddings unsupported")

gemini = .industrialprovider("gemini", host, port, 0, "/gemini/v1beta", "synthetic-gemini-key", "local")
gemini_capabilities = gemini.capabilities()
errors = errors + check(gemini_capabilities.request_format() = "gemini-generateContent" & gemini_capabilities.input_modalities() = "text|image_url|document_url|audio_url", "Gemini adapter modalities")
gemini_messages = .providermessage[]
gemini_messages[1] = .providermessage("system", "Classify the supplied audio")
gemini_messages[2] = .providermessage("user", "", "audio_url", "audio/wav", "https://fixture.invalid/audio.wav")
gemini_request = .providerrequest("generate_structured", "audio", "gemini-2.5-flash-lite", gemini_messages, unused_inputs, schema, 2000, 1, "public", "gemini-generate-" || cell, "gemini-generate-" || cell, 16, 0, 0, 0)
gemini_result = gemini.generate_structured(gemini_request)
gemini_usage = gemini_result.usage()
errors = errors + check(gemini_result.status() = 0 & gemini_result.content() = '{"answer":"gemini"}' & gemini_result.finish_reason() = "STOP", "Gemini generateContent shape")
errors = errors + check(gemini_usage.input_tokens() = 13 & gemini_usage.output_tokens() = 5, "Gemini usage")

gemini_inputs = .string[]
gemini_inputs[1] = "vector one"
gemini_inputs[2] = "vector two"
gemini_embedding_request = .providerrequest("embed_batch", "indexing", "gemini-embedding-2", gemini_messages, gemini_inputs, "", 2000, 1, "public", "gemini-embed-" || cell, "gemini-embed-" || cell, 0, 3, 0)
gemini_embedding_result = gemini.embed_batch(gemini_embedding_request)
gemini_vectors = gemini_embedding_result.embeddings()
errors = errors + check(gemini_embedding_result.status() = 0 & gemini_vectors.0 = 2, "Gemini batch embedding shape")
if gemini_vectors.0 = 2 then errors = errors + check(gemini_vectors[1].valid() = 1 & gemini_vectors[2].count() = 3, "Gemini embedding projection")

local_messages = .providermessage[]
local_messages[1] = .providermessage("system", "Answer from the local fixture")
local_messages[2] = .providermessage("user", "Generate Gràdh 中")
local_provider = .openaicompatibleprovider(host, port, 0, "/v1", "", "local-openai-compatible", "local")
local_request = .providerrequest("generate", "answerer", "local-chat", local_messages, unused_inputs, "", 2000, 1, "local", "local-" || cell, "local-" || cell, 0, 0, 0, 0)
local_result = local_provider.generate(local_request)
errors = errors + check(local_result.status() = 0 & local_result.content() = "loopback OpenAI generation Gràdh 中", "local provider shape")

if errors \= 0 then do
  say "P1_LLM_04_ERRORS=" || errors
  return 1
end
say "P1_LLM_04_OK cell=" || cell || " providers=local,openai,anthropic,gemini facade=openai-level-g generation=structured modalities=image,document,audio embeddings=openai-batch,gemini-batch model_catalog=8"
return 0
