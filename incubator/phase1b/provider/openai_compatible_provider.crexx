options levelg

namespace openai_compatible_provider expose openaicompatibleprovider

import rxfnsb
import rxjson
import rxfnsg
import provider_contract

openaicompatibleprovider: class implements .provider
  _host = .string
  _port = .int
  _tls = .int
  _base_path = .string
  _api_key = .string
  _provider_name = .string
  _route_class = .string

  *: factory
    arg host = .string, port = .int, tls = .int, base_path = .string, api_key = .string, provider_name = .string, route_class = "local"
    _host = host
    _port = port
    _tls = tls
    _base_path = base_path
    _api_key = api_key
    _provider_name = provider_name
    _route_class = route_class
    return

  capabilities: method = .providercapabilities
    return .providercapabilities(_provider_name, 1, 1, 1, 1, 0, 0, 0, 2048, "text", "text|f32le", "openai-chat-completions", 0)

  generate: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "generate")
    if validation.code() \= 0 then return _failed_result(request, validation)
    messages = request.messages()
    do i = 1 to messages.0
      if messages[i].modality() \= "text" then return _unsupported(request, "non-text message modality")
    end
    return _generate(request, 0)

  generate_structured: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "generate_structured")
    if validation.code() \= 0 then return _failed_result(request, validation)
    messages = request.messages()
    do i = 1 to messages.0
      if messages[i].modality() \= "text" then return _unsupported(request, "non-text message modality")
    end
    return _generate(request, 1)

  embed: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "embed")
    if validation.code() \= 0 then return _failed_result(request, validation)
    return _embed(request, 0)

  embed_batch: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "embed_batch")
    if validation.code() \= 0 then return _failed_result(request, validation)
    return _embed(request, 1)

  cancel: method = .providerresult
    arg request_id = .string
    result = .providerresult()
    call result.set_failure(_provider_name, "", request_id, .providererror("unsupported", -120, 0, 0, 0, "cancellation is not supported"))
    return result

  _endpoint: method = .string
    arg suffix = .string
    if _base_path = "" then return suffix
    if right(_base_path, 1) = "/" then return left(_base_path, length(_base_path) - 1) || suffix
    return _base_path || suffix

  _post: method = .httpresponse
    arg client = .httpclient, path = .string, body = .string, request = .providerrequest
    headers = .httpheaders.json()
    call headers.add("Idempotency-Key", request.idempotency_key())
    call headers.add("X-Client-Request-Id", request.request_id())
    if _api_key \= "" then call headers.add("Authorization", "Bearer " || _api_key)
    return client.post(path, body, headers)

  _client: method = .httpclient
    arg timeout = .int
    bounded_timeout = timeout
    if bounded_timeout > 600000 then bounded_timeout = 600000
    policy = .httppolicy.safe()
    call policy.set_timeouts(bounded_timeout, bounded_timeout, bounded_timeout, bounded_timeout, bounded_timeout, bounded_timeout)
    scheme = "http://"
    if _tls \= 0 then scheme = "https://"
    return .httpclient.pooled(scheme || _host || ":" || _port, 1, 2, 8388608, policy)

  _generation_body: method = .string
    arg request = .providerrequest, structured = .int
    messages = request.messages()
    encoded_messages = .string[]
    do i = 1 to messages.0
      keys = .string[]
      values = .string[]
      keys[1] = "role"
      values[1] = jsonquote(messages[i].role())
      keys[2] = "content"
      values[2] = jsonquote(messages[i].content())
      encoded_messages[i] = jsonobject(keys, values)
    end
    keys = .string[]
    values = .string[]
    keys[1] = "model"
    values[1] = jsonquote(request.model())
    keys[2] = "messages"
    values[2] = jsonarray(encoded_messages)
    keys[3] = "stream"
    values[3] = "false"
    next = 4
    if request.max_output_tokens() > 0 then do
      keys[next] = "max_completion_tokens"
      values[next] = request.max_output_tokens()
      next = next + 1
    end
    if request.temperature_millionths() >= 0 then do
      keys[next] = "temperature"
      values[next] = request.temperature_millionths() / 1000000.0
      next = next + 1
    end
    if structured \= 0 then do
      schema_keys = .string[]
      schema_values = .string[]
      schema_keys[1] = "name"
      schema_values[1] = jsonquote("cprag_response")
      schema_keys[2] = "strict"
      schema_values[2] = "true"
      schema_keys[3] = "schema"
      schema_values[3] = request.schema()
      format_keys = .string[]
      format_values = .string[]
      format_keys[1] = "type"
      format_values[1] = jsonquote("json_schema")
      format_keys[2] = "json_schema"
      format_values[2] = jsonobject(schema_keys, schema_values)
      keys[next] = "response_format"
      values[next] = jsonobject(format_keys, format_values)
    end
    return jsonobject(keys, values)

  _embedding_body: method = .string
    arg request = .providerrequest, batch = .int
    inputs = request.inputs()
    keys = .string[]
    values = .string[]
    keys[1] = "model"
    values[1] = jsonquote(request.model())
    keys[2] = "input"
    if batch = 0 then values[2] = jsonquote(inputs[1])
    else do
      encoded_inputs = .string[]
      do i = 1 to inputs.0
        encoded_inputs[i] = jsonquote(inputs[i])
      end
      values[2] = jsonarray(encoded_inputs)
    end
    keys[3] = "encoding_format"
    values[3] = jsonquote("float")
    if request.embedding_dimensions() > 0 then do
      keys[4] = "dimensions"
      values[4] = request.embedding_dimensions()
    end
    return jsonobject(keys, values)

  _generate: method = .providerresult
    arg request = .providerrequest, structured = .int
    route_error = validateproviderroute(request, _route_class)
    if route_error.code() \= 0 then return _failed_result(request, route_error)
    if request.stream_requested() \= 0 then return _unsupported(request, "streaming")
    client = _client(request.timeout_ms())
    result = _generate_with_client(request, structured, client)
    call client.close()
    return result

  _generate_with_client: method = .providerresult
    arg request = .providerrequest, structured = .int, client = .httpclient
    started = time("us")
    retry_delay_ms = 0
    do attempt = 1 to request.max_attempts()
      response = _post(client, _endpoint("/chat/completions"), _generation_body(request, structured), request)
      if response.succeeded() = 0 then do
        failure = _transport_error(response, attempt)
        if failure.retryable() \= 0 & attempt < request.max_attempts() then do
          delay_ms = _retry_delay_ms(attempt)
          call _wait_ms delay_ms
          retry_delay_ms = retry_delay_ms + delay_ms
          iterate
        end
        return _failed_result(request, failure, .providerusage(0, 0, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      end
      document = .jsondocument(response.body())
      if document.valid() = 0 then return _failed_result(request, .providererror("malformed_response", -102, response.status(), 0, attempt, "response is not valid JSON: " || document.error()), .providerusage(0, 0, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      root = document.root()
      provider_error = document.member(root, "error")
      if provider_error > 0 then do
        message_node = document.member(provider_error, "message")
        message = document.node_get(message_node)
        return _failed_result(request, .providererror("provider", -103, response.status(), 0, attempt, message), .providerusage(0, 0, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      end
      choices = document.member(root, "choices")
      choice = document.element(choices, 1)
      message_node = document.member(choice, "message")
      content_node = document.member(message_node, "content")
      finish_node = document.member(choice, "finish_reason")
      content = ""
      finish_reason = ""
      if document.node_string(content_node, content) \= 0 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, attempt, "generated content is missing"), .providerusage(0, 0, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      if document.node_string(finish_node, finish_reason) \= 0 then finish_reason = "unknown"
      if structured \= 0 then do
        structured_error = validatestructuredresponse(content, request.schema())
        if structured_error.code() \= 0 then return _failed_result(request, structured_error, .providerusage(0, 0, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      end
      usage_node = document.member(root, "usage")
      input_tokens = _optional_int(document, usage_node, "prompt_tokens")
      output_tokens = _optional_int(document, usage_node, "completion_tokens")
      response_id = request.request_id()
      id_node = document.member(root, "id")
      if document.node_type(id_node) = "string" then ignored = document.node_string(id_node, response_id)
      result = .providerresult()
      call result.set_generation(_provider_name, request.model(), response_id, content, finish_reason, .providerusage(input_tokens, output_tokens, 1, 0, attempt, retry_delay_ms), _elapsed_us(started))
      return result
    end
    return _failed_result(request, .providererror("internal", -199, 0, 0, request.max_attempts(), "retry loop exhausted"))

  _embed: method = .providerresult
    arg request = .providerrequest, batch = .int
    route_error = validateproviderroute(request, _route_class)
    if route_error.code() \= 0 then return _failed_result(request, route_error)
    inputs = request.inputs()
    if batch = 0 & inputs.0 \= 1 then return _failed_result(request, .providererror("invalid_request", -101, 0, 0, 0, "single embedding requires exactly one input"))
    if inputs.0 > 2048 then return _failed_result(request, .providererror("invalid_request", -101, 0, 0, 0, "embedding batch exceeds provider limit"))
    client = _client(request.timeout_ms())
    result = _embed_with_client(request, batch, client)
    call client.close()
    return result

  _embed_with_client: method = .providerresult
    arg request = .providerrequest, batch = .int, client = .httpclient
    inputs = request.inputs()
    started = time("us")
    retry_delay_ms = 0
    do attempt = 1 to request.max_attempts()
      response = _post(client, _endpoint("/embeddings"), _embedding_body(request, batch), request)
      if response.succeeded() = 0 then do
        failure = _transport_error(response, attempt)
        if failure.retryable() \= 0 & attempt < request.max_attempts() then do
          delay_ms = _retry_delay_ms(attempt)
          call _wait_ms delay_ms
          retry_delay_ms = retry_delay_ms + delay_ms
          iterate
        end
        return _failed_result(request, failure, .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
      end
      document = .jsondocument(response.body())
      if document.valid() = 0 then return _failed_result(request, .providererror("malformed_response", -102, response.status(), 0, attempt, "response is not valid JSON: " || document.error()), .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
      data = document.member(document.root(), "data")
      if document.node_count(data) \= inputs.0 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, attempt, "embedding result count does not match input count"), .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
      vectors = .embeddingrecord[]
      do i = 1 to inputs.0
        item = document.element(data, i)
        if _optional_int(document, item, "index") \= i - 1 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, attempt, "embedding result index is out of order"), .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
        embedding_node = document.member(item, "embedding")
        packed = .binary
        projection_error = ""
        projection_status = document.node_f32_array(embedding_node, -1, packed, projection_error)
        dimensions = document.node_count(embedding_node)
        if projection_status \= 0 | dimensions <= 0 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, attempt, "embedding is invalid: " || projection_error), .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
        if request.embedding_dimensions() > 0 & dimensions \= request.embedding_dimensions() then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, attempt, "embedding dimensions do not match request"), .providerusage(0, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
        vectors[i] = .embeddingrecord("f32le-v1", dimensions, packed)
      end
      usage_node = document.member(document.root(), "usage")
      input_tokens = _optional_int(document, usage_node, "prompt_tokens")
      result = .providerresult()
      call result.set_embeddings(_provider_name, request.model(), request.request_id(), vectors, .providerusage(input_tokens, 0, inputs.0, 0, attempt, retry_delay_ms), _elapsed_us(started))
      return result
    end
    return _failed_result(request, .providererror("internal", -199, 0, 0, request.max_attempts(), "retry loop exhausted"))

  _failed_result: method = .providerresult
    arg request = .providerrequest, failure = .providererror, usage = .providerusage(), latency_us = 0
    result = .providerresult()
    call result.set_failure(_provider_name, request.model(), request.request_id(), failure, usage, latency_us)
    return result

  _unsupported: method = .providerresult
    arg request = .providerrequest, capability = .string
    return _failed_result(request, .providererror("unsupported", -120, 0, 0, 0, capability || " is not supported"))

  _transport_error: method = .providererror
    arg response = .httpresponse, attempt = .int
    transport_status = response.transport_status()
    http_status = response.status()
    code = transport_status
    if code = 0 then code = http_status
    category = "http"
    retryable = 0
    if transport_status = -6 | transport_status = -10 | transport_status = -11 | transport_status = -12 then do; category = "timeout"; code = -5; retryable = 1; end
    else if transport_status = -1 | transport_status = -2 | transport_status = -3 | transport_status = -7 | transport_status = -8 then do; category = "connection"; code = -3; retryable = 1; end
    else if http_status = 408 | http_status = 429 | http_status >= 500 then retryable = 1
    message = response.error()
    response_body = response.body()
    if response_body \= "" then do
      document = .jsondocument(response_body)
      if document.valid() = 1 then do
        error_node = document.member(document.root(), "error")
        message_node = document.member(error_node, "message")
        if document.node_type(message_node) = "string" then ignored = document.node_string(message_node, message)
      end
    end
    return .providererror(category, code, http_status, retryable, attempt, message)

_optional_int: procedure = .int
  arg document = .jsondocument, parent = .int, name = .string
  if parent <= 0 then return 0
  node = document.member(parent, name)
  value = 0
  if document.node_int(node, value) \= 0 then return 0
  return value

_elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

_retry_delay_ms: procedure = .int
  arg failed_attempt = .int
  delay_ms = 1
  do i = 2 to failed_attempt
    delay_ms = delay_ms * 2
  end
  if delay_ms > 1000 then delay_ms = 1000
  return delay_ms

_wait_ms: procedure = .void
  arg milliseconds = .int
  if milliseconds <= 0 then return
  seconds = milliseconds / 1000.0
  address crexx "sleep " || seconds
  return
