options levelb

namespace openai_compatible_provider expose openaicompatibleprovider

import rxfnsb
import rxhttp
import rxjson
import provider_contract

openaicompatibleprovider: class implements .provider
  _host = .string
  _port = .int
  _tls = .int
  _base_path = .string
  _api_key = .string
  _provider_name = .string

  *: factory
    arg host = .string, port = .int, tls = .int, base_path = .string, api_key = .string, provider_name = .string
    _host = host
    _port = port
    _tls = tls
    _base_path = base_path
    _api_key = api_key
    _provider_name = provider_name
    return

  capabilities: method = .providercapabilities
    return .providercapabilities(_provider_name, 1, 0, 1, 0, 0, 0, 0, 1)

  generate: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "generate")
    if validation.code() \= 0 then return _failed_result(request, validation)
    started = time("us")
    client = .httpclient(_host, _port, request.timeout_ms(), _tls)
    body = _generation_body(request)
    response = _post(client, _endpoint("/chat/completions"), body)
    if client.status() \= 0 then return _transport_failure(request, client, response)
    document = .jsondocument(response)
    if document.valid() = 0 then return _failed_result(request, .providererror("malformed_response", -102, client.httpStatus(), 0, 1, "response is not valid JSON: " || document.error()))
    root = document.root()
    provider_error = document.member(root, "error")
    if provider_error > 0 then do
      message_node = document.member(provider_error, "message")
      message = document.node_get(message_node)
      return _failed_result(request, .providererror("provider", -103, client.httpStatus(), 0, 1, message))
    end
    choices = document.member(root, "choices")
    choice = document.element(choices, 1)
    message_node = document.member(choice, "message")
    content_node = document.member(message_node, "content")
    finish_node = document.member(choice, "finish_reason")
    content = ""
    finish_reason = ""
    if document.node_string(content_node, content) \= 0 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, 1, "generated content is missing"))
    if document.node_string(finish_node, finish_reason) \= 0 then finish_reason = "unknown"
    usage_node = document.member(root, "usage")
    input_tokens = _optional_int(document, usage_node, "prompt_tokens")
    output_tokens = _optional_int(document, usage_node, "completion_tokens")
    response_id = request.request_id()
    id_node = document.member(root, "id")
    if document.node_type(id_node) = "string" then ignored = document.node_string(id_node, response_id)
    result = .providerresult()
    call result.set_generation(_provider_name, request.model(), response_id, content, finish_reason, .providerusage(input_tokens, output_tokens, 1, 0), _elapsed_us(started))
    return result

  generate_structured: method = .providerresult
    arg request = .providerrequest
    return _unsupported(request, "structured generation")

  embed: method = .providerresult
    arg request = .providerrequest
    validation = validateprovideroperation(request, "embed")
    if validation.code() \= 0 then return _failed_result(request, validation)
    started = time("us")
    client = .httpclient(_host, _port, request.timeout_ms(), _tls)
    body = _embedding_body(request)
    response = _post(client, _endpoint("/embeddings"), body)
    if client.status() \= 0 then return _transport_failure(request, client, response)
    document = .jsondocument(response)
    if document.valid() = 0 then return _failed_result(request, .providererror("malformed_response", -102, client.httpStatus(), 0, 1, "response is not valid JSON: " || document.error()))
    root = document.root()
    data = document.member(root, "data")
    item = document.element(data, 1)
    embedding_node = document.member(item, "embedding")
    packed = .binary
    projection_error = ""
    projection_status = document.node_f32_array(embedding_node, -1, packed, projection_error)
    dimensions = document.node_count(embedding_node)
    if projection_status \= 0 | dimensions <= 0 then return _failed_result(request, .providererror("malformed_response", -102, 200, 0, 1, "embedding is invalid: " || projection_error))
    vectors = .embeddingrecord[]
    vectors[1] = .embeddingrecord("f32le-v1", dimensions, packed)
    usage_node = document.member(root, "usage")
    input_tokens = _optional_int(document, usage_node, "prompt_tokens")
    response_id = request.request_id()
    result = .providerresult()
    call result.set_embeddings(_provider_name, request.model(), response_id, vectors, .providerusage(input_tokens, 0, 1, 0), _elapsed_us(started))
    return result

  embed_batch: method = .providerresult
    arg request = .providerrequest
    return _unsupported(request, "batch embeddings")

  cancel: method = .providerresult
    arg request_id = .string
    result = .providerresult()
    call result.set_failure(_provider_name, "", request_id, .providererror("unsupported", -120, 0, 0, 0, "cancellation is not supported"))
    return result

  _endpoint: method = .string
    arg suffix = .string
    if _base_path = "" then return suffix
    if right(_base_path, 1) = "/" then return left(_base_path, length(_base_path) - 1) || suffix
    return _base_path || suffix

  _post: method = .string
    arg client = .httpclient, path = .string, body = .string
    if _api_key = "" then return client.post(path, body, "application/json")
    headers = .string[]
    headers[1] = "Authorization: Bearer " || _api_key
    return client.postWithHeaders(path, body, "application/json", headers)

  _generation_body: method = .string
    arg request = .providerrequest
    messages = request.messages()
    encoded_messages = .string[]
    do i = 1 to messages.0
      keys = .string[]
      values = .string[]
      keys[1] = "role"
      values[1] = jsonquote(messages[i].role())
      keys[2] = "content"
      values[2] = jsonquote(messages[i].content())
      encoded_messages[i] = jsonobject(keys, values)
    end
    keys = .string[]
    values = .string[]
    keys[1] = "model"
    values[1] = jsonquote(request.model())
    keys[2] = "messages"
    values[2] = jsonarray(encoded_messages)
    keys[3] = "stream"
    values[3] = "false"
    return jsonobject(keys, values)

  _embedding_body: method = .string
    arg request = .providerrequest
    inputs = request.inputs()
    keys = .string[]
    values = .string[]
    keys[1] = "model"
    values[1] = jsonquote(request.model())
    keys[2] = "input"
    values[2] = jsonquote(inputs[1])
    keys[3] = "encoding_format"
    values[3] = jsonquote("float")
    return jsonobject(keys, values)

  _failed_result: method = .providerresult
    arg request = .providerrequest, failure = .providererror
    result = .providerresult()
    call result.set_failure(_provider_name, request.model(), request.request_id(), failure)
    return result

  _unsupported: method = .providerresult
    arg request = .providerrequest, capability = .string
    return _failed_result(request, .providererror("unsupported", -120, 0, 0, 0, capability || " is not supported"))

  _transport_failure: method = .providerresult
    arg request = .providerrequest, client = .httpclient, response = .string
    code = client.status()
    category = "http"
    retryable = 0
    if code = -5 then do; category = "timeout"; retryable = 1; end
    else if code = -3 | code = -8 then do; category = "connection"; retryable = 1; end
    else if client.httpStatus() = 408 | client.httpStatus() = 429 | client.httpStatus() >= 500 then retryable = 1
    message = client.error()
    if response \= "" then do
      document = .jsondocument(response)
      if document.valid() = 1 then do
        error_node = document.member(document.root(), "error")
        message_node = document.member(error_node, "message")
        if document.node_type(message_node) = "string" then ignored = document.node_string(message_node, message)
      end
    end
    return _failed_result(request, .providererror(category, code, client.httpStatus(), retryable, 1, message))

_optional_int: procedure = .int
  arg document = .jsondocument, parent = .int, name = .string
  if parent <= 0 then return 0
  node = document.member(parent, name)
  value = 0
  if document.node_int(node, value) \= 0 then return 0
  return value

_elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed
