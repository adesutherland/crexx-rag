options levelb

import provider_contract
import provider_catalog
import openai_compatible_provider

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_LLM_03_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
host = args[1]
port = args[2] as .int
cell = args[3]
errors = 0
backend = .openaicompatibleprovider(host, port, 0, "/v1", "", "local-openai-compatible", "local")
capabilities = backend.capabilities()
errors = errors + check(capabilities.structured() = 1 & capabilities.batch_embeddings() = 1, "hardening capabilities")
errors = errors + check(capabilities.streaming() = 0 & capabilities.cancellation() = 0 & capabilities.connection_reuse() = 0, "truthful transport capabilities")
errors = errors + check(capabilities.input_modalities() = "text" & capabilities.output_modalities() = "text|f32le", "modality capabilities")

model_capability = .providermodelcapability("local-openai-compatible", "batch-local", "synthetic", "embed|embed_batch", "text", "f32le", 0, 0, 0, 0, "3", "2026-08-03")
errors = errors + check(model_capability.operations() = "embed|embed_batch" & model_capability.embedding_dimensions() = "3", "model capability record")

messages = .providermessage[]
messages[1] = .providermessage("system", "Return the requested object")
messages[2] = .providermessage("user", "Give the test answer")
unused_inputs = .string[]
unused_inputs[1] = "unused"
schema = '{"type":"object","required":["answer"],"properties":{"answer":{"type":"string"}}}'

structured_request = .providerrequest("generate_structured", "extractor", "structured-valid", messages, unused_inputs, schema, 2000, 1, "local", "structured-valid-" || cell, "structured-valid-" || cell, 32, 0, 0)
structured = backend.generate_structured(structured_request)
structured_usage = structured.usage()
errors = errors + check(structured.status() = 0 & structured.content() = '{"answer":"ok","score":1}', "structured generation")
errors = errors + check(structured_usage.input_tokens() = 7 & structured_usage.output_tokens() = 6 & structured_usage.attempts() = 1, "structured usage")

invalid_request = .providerrequest("generate_structured", "extractor", "structured-invalid", messages, unused_inputs, schema, 2000, 1, "local", "structured-invalid-" || cell, "structured-invalid-" || cell, 32, 0, 0)
invalid_result = backend.generate_structured(invalid_request)
invalid_error = invalid_result.error()
errors = errors + check(invalid_result.status() = -123 & invalid_error.category() = "structured_validation", "structured schema rejection")

batch_inputs = .string[]
batch_inputs[1] = "alpha"
batch_inputs[2] = "beta"
batch_request = .providerrequest("embed_batch", "indexing", "batch-local", messages, batch_inputs, "", 2000, 1, "local", "batch-" || cell, "batch-" || cell, 0, 3, 0)
batch_result = backend.embed_batch(batch_request)
vectors = batch_result.embeddings()
batch_usage = batch_result.usage()
errors = errors + check(batch_result.status() = 0 & vectors.0 = 2, "batch embedding result count")
if vectors.0 = 2 then do
  errors = errors + check(vectors[1].valid() = 1 & vectors[1].count() = 3 & vectors[2].valid() = 1 & vectors[2].count() = 3, "batch embedding records")
end
errors = errors + check(batch_usage.input_count() = 2 & batch_usage.input_tokens() = 4 & batch_usage.attempts() = 1, "batch embedding usage")

retry_request = .providerrequest("generate", "answerer", "retry-local-" || cell, messages, unused_inputs, "", 2000, 3, "local", "retry-" || cell, "retry-" || cell, 16, 0, 0)
retry_result = backend.generate(retry_request)
retry_usage = retry_result.usage()
errors = errors + check(retry_result.status() = 0 & retry_result.content() = "retry complete", "bounded retry result")
errors = errors + check(retry_usage.attempts() = 3 & retry_usage.retry_delay_ms() = 3 & retry_result.latency_us() >= 3000, "bounded exponential backoff")

nonretry_request = .providerrequest("generate", "answerer", "nonretry-local", messages, unused_inputs, "", 2000, 3, "local", "nonretry-" || cell, "nonretry-" || cell, 16, 0, 0)
nonretry_result = backend.generate(nonretry_request)
nonretry_error = nonretry_result.error()
nonretry_usage = nonretry_result.usage()
errors = errors + check(nonretry_result.status() = 400 & nonretry_error.http_status() = 400 & nonretry_error.retryable() = 0 & nonretry_usage.attempts() = 1, "non-retryable HTTP result")

stream_request = .providerrequest("generate", "answerer", "local-chat", messages, unused_inputs, "", 2000, 1, "local", "stream-" || cell, "stream-" || cell, 16, 0, 1)
stream_result = backend.generate(stream_request)
stream_error = stream_result.error()
errors = errors + check(stream_result.status() = -120 & stream_error.category() = "unsupported", "explicit unsupported streaming")

cancel_result = backend.cancel("cancel-" || cell)
cancel_error = cancel_result.error()
errors = errors + check(cancel_result.status() = -120 & cancel_error.category() = "unsupported", "explicit unsupported cancellation")

hosted = .openaicompatibleprovider(host, port, 0, "/v1", "secret-not-sent", "hosted-openai-compatible", "hosted")
denied_request = .providerrequest("generate", "answerer", "local-chat", messages, unused_inputs, "", 2000, 1, "restricted", "denied-" || cell, "denied-" || cell, 16, 0, 0)
denied_result = hosted.generate(denied_request)
denied_error = denied_result.error()
errors = errors + check(denied_result.status() = -121 & denied_error.category() = "privacy_denied", "pre-transport privacy denial")

benchmark_messages = .providermessage[]
benchmark_messages[1] = .providermessage("system", "Answer from the local fixture")
benchmark_messages[2] = .providermessage("user", "Generate Gràdh 中")
benchmark_total_us = 0
do i = 1 to 25
  benchmark_request = .providerrequest("generate", "benchmark", "local-chat", benchmark_messages, unused_inputs, "", 2000, 1, "local", "benchmark-" || cell || "-" || i, "benchmark-" || cell || "-" || i, 0, 0, 0)
  benchmark_result = backend.generate(benchmark_request)
  errors = errors + check(benchmark_result.status() = 0, "sequential HTTP benchmark call")
  benchmark_total_us = benchmark_total_us + benchmark_result.latency_us()
end
benchmark_average_us = benchmark_total_us / 25

if errors \= 0 then do
  say "P1_LLM_03_ERRORS=" || errors
  return 1
end
say "P1_LLM_03_OK cell=" || cell || " structured=validated batch=2 retry_attempts=3 retry_delay_ms=3 streaming=unsupported cancellation=unsupported denied=pre_transport connection_reuse=unsupported sequential_http_calls=25 total_us=" || benchmark_total_us || " average_us=" || benchmark_average_us
return 0
