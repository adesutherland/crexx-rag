options levelg

namespace p7_hosted_provider_probe

import rxfnsb
import provider_contract
import industrial_provider

failure_line: procedure = .string
  arg operation = .string, result = .providerresult
  failure = result.error()
  usage = result.usage()
  return "P7_HOSTED_PROVIDER operation=" || operation || " status=failed provider=openai credential_reference=env:OPENAI_API_KEY category=" || failure.category() || " code=" || failure.code() || " http_status=" || failure.http_status() || " attempts=" || usage.attempts()

main: procedure = .int
  arg args = .string[]
  cell = "manual"
  if args.0 > 0 then cell = args[1]
  if cell = "" then cell = "manual"
  key = strip(changestr("0A"x, changestr("0D"x, getenv("OPENAI_API_KEY"), ""), ""))
  if key = "" then do
    say "P7_HOSTED_PROVIDER status=unavailable credential_reference=env:OPENAI_API_KEY"
    return 2
  end
  provider = .industrialprovider("openai", "api.openai.com", 443, 1, "/v1", key, "hosted")
  messages = .providermessage[]
  messages[1] = .providermessage("system", "Return only the requested JSON object.")
  messages[2] = .providermessage("user", "Set answer to ok.")
  unused_inputs = .string[]
  unused_inputs[1] = "unused"
  schema = '{"type":"object","required":["answer"],"properties":{"answer":{"type":"string"}},"additionalProperties":false}'
  generation_request = .providerrequest("generate_structured", "qualification", "gpt-5.6-luna", messages, unused_inputs, schema, 120000, 1, "public", "p7-openai-generation-" || cell, "p7-openai-generation-" || cell, 32, 0, 0, -1)
  generation = provider.generate_structured(generation_request)
  if generation.status() \= 0 then do
    say failure_line("generate_structured", generation)
    return 1
  end
  generation_usage = generation.usage()
  say "P7_HOSTED_PROVIDER operation=generate_structured status=ok provider=openai model=gpt-5.6-luna credential_reference=env:OPENAI_API_KEY temperature=provider-default max_attempts=1 input_tokens=" || generation_usage.input_tokens() || " output_tokens=" || generation_usage.output_tokens()

  inputs = .string[]
  inputs[1] = "industrial vector indexing"
  inputs[2] = "provider qualification"
  embedding_request = .providerrequest("embed_batch", "indexing", "text-embedding-3-small", messages, inputs, "", 120000, 1, "public", "p7-openai-embedding-" || cell, "p7-openai-embedding-" || cell, 0, 128, 0)
  embedding = provider.embed_batch(embedding_request)
  if embedding.status() \= 0 then do
    say failure_line("embed_batch", embedding)
    return 1
  end
  vectors = embedding.embeddings()
  if vectors.0 \= 2 | vectors[1].count() \= 128 | vectors[2].count() \= 128 then do
    say "P7_HOSTED_PROVIDER operation=embed_batch status=failed provider=openai credential_reference=env:OPENAI_API_KEY category=shape code=-102 attempts=1"
    return 1
  end
  embedding_usage = embedding.usage()
  say "P7_HOSTED_PROVIDER operation=embed_batch status=ok provider=openai model=text-embedding-3-small credential_reference=env:OPENAI_API_KEY input_count=2 dimensions=128 max_attempts=1 input_tokens=" || embedding_usage.input_tokens()
  say "P7_HOSTED_PROVIDER_SUMMARY status=ok provider=openai credential_reference=env:OPENAI_API_KEY calls=2 generation=1 embedding_batches=1 max_attempts=1"
  return 0
