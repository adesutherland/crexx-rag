options levelg

import rxfnsb
import provider_contract
import provider_catalog
import provider_http
import industrial_provider

clean_env: procedure = .string
  arg name = .string
  return strip(changestr("0A"x, changestr("0D"x, getenv(name), ""), ""))

report_failure: procedure = .int
  arg provider = .string, model = .string, result = .providerresult
  failure = result.error()
  usage = result.usage()
  say "P1_LLM_04_HOSTED provider=" || provider || " model=" || model || " status=failed category=" || failure.category() || " code=" || failure.code() || " http_status=" || failure.http_status() || " attempts=" || usage.attempts()
  return 1

report_generation: procedure = .int
  arg provider = .string, model = .string, result = .providerresult
  if result.status() \= 0 then return report_failure(provider, model, result)
  usage = result.usage()
  say "P1_LLM_04_HOSTED provider=" || provider || " model=" || model || " operation=generate_structured status=ok input_tokens=" || usage.input_tokens() || " output_tokens=" || usage.output_tokens() || " estimated_cost_usd_micros=" || usage.cost_microunits() || " latency_us=" || result.latency_us()
  return 0

report_embedding: procedure = .int
  arg provider = .string, model = .string, result = .providerresult, expected_count = .int
  if result.status() \= 0 then return report_failure(provider, model, result)
  vectors = result.embeddings()
  if vectors.0 \= expected_count then do
    say "P1_LLM_04_HOSTED provider=" || provider || " model=" || model || " operation=embed_batch status=failed category=shape code=-102 http_status=200 attempts=1"
    return 1
  end
  dimensions = 0
  if vectors.0 > 0 then dimensions = vectors[1].count()
  usage = result.usage()
  say "P1_LLM_04_HOSTED provider=" || provider || " model=" || model || " operation=embed_batch status=ok input_count=" || usage.input_count() || " input_tokens=" || usage.input_tokens() || " dimensions=" || dimensions || " latency_us=" || result.latency_us()
  return 0

main: procedure = .int
errors = 0
schema = '{"type":"object","required":["answer"],"properties":{"answer":{"type":"string"}},"additionalProperties":false}'
messages = .providermessage[]
messages[1] = .providermessage("system", "Return only the requested JSON object.")
messages[2] = .providermessage("user", "Set answer to ok.")
unused_inputs = .string[]
unused_inputs[1] = "unused"

openai_key = clean_env("OPENAI_API_KEY")
anthropic_key = clean_env("ANTHROPIC_API_KEY")
gemini_key = clean_env("GEMINI_API_KEY")
if openai_key = "" | anthropic_key = "" | gemini_key = "" then do
  say "P1_LLM_04_HOSTED status=failed category=configuration missing_required_credentials=1"
  return 2
end

openai_model = clean_env("CPRAG_OPENAI_MODEL")
if openai_model = "" then openai_model = defaultgenerationmodel("openai")
openai = .industrialprovider("openai", "api.openai.com", 443, 1, "/v1", openai_key, "hosted")
openai_request = .providerrequest("generate_structured", "qualification", openai_model, messages, unused_inputs, schema, 120000, 1, "public", "hosted-openai-generation", "hosted-openai-generation", 32, 0, 0)
openai_result = openai.generate_structured(openai_request)
errors = errors + report_generation("openai", openai_model, openai_result)

openai_embedding_model = clean_env("CPRAG_OPENAI_EMBEDDING_MODEL")
if openai_embedding_model = "" then openai_embedding_model = defaultembeddingmodel("openai")
openai_inputs = .string[]
openai_inputs[1] = "industrial vector indexing"
openai_inputs[2] = "provider qualification"
openai_embedding_request = .providerrequest("embed_batch", "indexing", openai_embedding_model, messages, openai_inputs, "", 120000, 1, "public", "hosted-openai-embedding", "hosted-openai-embedding", 0, 128, 0)
openai_embedding_result = openai.embed_batch(openai_embedding_request)
errors = errors + report_embedding("openai", openai_embedding_model, openai_embedding_result, 2)

anthropic_model = clean_env("CPRAG_ANTHROPIC_MODEL")
if anthropic_model = "" then anthropic_model = defaultgenerationmodel("anthropic")
anthropic = .industrialprovider("anthropic", "api.anthropic.com", 443, 1, "/v1", anthropic_key, "hosted")
anthropic_request = .providerrequest("generate_structured", "qualification", anthropic_model, messages, unused_inputs, schema, 120000, 1, "public", "hosted-anthropic-generation", "hosted-anthropic-generation", 32, 0, 0)
anthropic_result = anthropic.generate_structured(anthropic_request)
errors = errors + report_generation("anthropic", anthropic_model, anthropic_result)

gemini_model = clean_env("CPRAG_GEMINI_MODEL")
if gemini_model = "" then gemini_model = defaultgenerationmodel("gemini")
gemini = .industrialprovider("gemini", "generativelanguage.googleapis.com", 443, 1, "/v1beta", gemini_key, "hosted")
gemini_request = .providerrequest("generate_structured", "qualification", gemini_model, messages, unused_inputs, schema, 120000, 1, "public", "hosted-gemini-generation", "hosted-gemini-generation", 32, 0, 0)
gemini_result = gemini.generate_structured(gemini_request)
errors = errors + report_generation("gemini", gemini_model, gemini_result)

gemini_embedding_model = clean_env("CPRAG_GEMINI_EMBEDDING_MODEL")
if gemini_embedding_model = "" then gemini_embedding_model = defaultembeddingmodel("gemini")
gemini_inputs = .string[]
gemini_inputs[1] = "industrial vector indexing"
gemini_inputs[2] = "provider qualification"
gemini_embedding_request = .providerrequest("embed_batch", "indexing", gemini_embedding_model, messages, gemini_inputs, "", 120000, 1, "public", "hosted-gemini-embedding", "hosted-gemini-embedding", 0, 128, 0)
gemini_embedding_result = gemini.embed_batch(gemini_embedding_request)
errors = errors + report_embedding("gemini", gemini_embedding_model, gemini_embedding_result, 2)

if errors \= 0 then do
  say "P1_LLM_04_HOSTED_SUMMARY status=failed failures=" || errors || " calls=5 max_attempts=1 max_output_tokens=32"
  return 1
end
say "P1_LLM_04_HOSTED_SUMMARY status=ok providers=3 calls=5 generation=3 embedding_batches=2 max_attempts=1 max_output_tokens=32"
return 0
