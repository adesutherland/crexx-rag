options levelg

namespace provider_facade expose normalizedproviderfacade

import provider_contract

normalizedproviderfacade: class
  _backend = .provider

  *: factory
    arg backend = .provider
    _backend = backend
    return

  capabilities: method = .providercapabilities
    return _backend.capabilities()
  generate: method = .providerresult
    arg request = .providerrequest
    return _backend.generate(request)
  generate_structured: method = .providerresult
    arg request = .providerrequest
    return _backend.generate_structured(request)
  embed: method = .providerresult
    arg request = .providerrequest
    return _backend.embed(request)
  embed_batch: method = .providerresult
    arg request = .providerrequest
    return _backend.embed_batch(request)
  cancel: method = .providerresult
    arg request_id = .string
    return _backend.cancel(request_id)
