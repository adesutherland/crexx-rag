options levelg

namespace claim_store expose claimschema promoteclaim retractrevision claimstate supportcitation

import rxfnsb
import sqlite_boundary

claimschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "CREATE TABLE claims(claim_key TEXT PRIMARY KEY,subject_id TEXT NOT NULL,subject_type TEXT NOT NULL,predicate TEXT NOT NULL,object_id TEXT NOT NULL,object_type TEXT NOT NULL,direction TEXT NOT NULL CHECK(direction='subject-to-object'),state TEXT NOT NULL CHECK(state IN('accepted','retracted')))") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE claim_support(support_key TEXT PRIMARY KEY,claim_key TEXT NOT NULL REFERENCES claims(claim_key),revision_key TEXT NOT NULL REFERENCES source_revisions(revision_key),chunk_key TEXT NOT NULL REFERENCES chunk_contents(chunk_key),span_start INTEGER NOT NULL CHECK(span_start>=0),span_end INTEGER NOT NULL CHECK(span_end>span_start),passage TEXT NOT NULL,polarity TEXT NOT NULL CHECK(polarity='support'),stance TEXT NOT NULL CHECK(stance='direct'),active INTEGER NOT NULL CHECK(active IN(0,1)),UNIQUE(claim_key,revision_key,chunk_key,span_start,span_end))") \= 0 then return -1
  return 0

promoteclaim: procedure = .int
  arg db = .binary, revision_key = .string, ordinal = .int, span_start = .int, span_end = .int, expected_passage = .string, subject_id = .string, subject_type = .string, predicate = .string, object_id = .string, object_type = .string, expose claim_key = .string, expose support_key = .string
  claim_key = translate(subject_id) || "|" || translate(predicate) || "|" || translate(object_id)
  chunk_key = ""
  body = ""
  status = _active_occurrence(db, revision_key, ordinal, chunk_key, body)
  if status \= 1 then return -2
  if span_start < 0 | span_end <= span_start | span_end > length(body) then return -3
  passage = substr(body, span_start + 1, span_end - span_start)
  if passage \= expected_passage then return -4
  support_key = claim_key || "|" || revision_key || "|" || chunk_key || "#b" || span_start || "-" || span_end
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1

  statement = .binary
  if sqliteprepare(db, "INSERT OR IGNORE INTO claims(claim_key,subject_id,subject_type,predicate,object_id,object_type,direction,state) VALUES(?1,?2,?3,?4,?5,?6,'subject-to-object','accepted')", statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, claim_key
  call sqlitebindtext statement, 2, subject_id
  call sqlitebindtext statement, 3, subject_type
  call sqlitebindtext statement, 4, predicate
  call sqlitebindtext statement, 5, object_id
  call sqlitebindtext statement, 6, object_type
  step_status = sqlitestep(statement)
  call sqlitefinalize statement
  if step_status \= 101 then return _rollback(db)

  statement = .binary
  if sqliteprepare(db, "INSERT OR IGNORE INTO claim_support(support_key,claim_key,revision_key,chunk_key,span_start,span_end,passage,polarity,stance,active) VALUES(?1,?2,?3,?4,?5,?6,?7,'support','direct',1)", statement) \= 0 then return _rollback(db)
  call sqlitebindtext statement, 1, support_key
  call sqlitebindtext statement, 2, claim_key
  call sqlitebindtext statement, 3, revision_key
  call sqlitebindtext statement, 4, chunk_key
  call sqlitebindint statement, 5, span_start
  call sqlitebindint statement, 6, span_end
  call sqlitebindtext statement, 7, passage
  step_status = sqlitestep(statement)
  call sqlitefinalize statement
  if step_status \= 101 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE claims SET state='accepted' WHERE claim_key=?1", claim_key) \= 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

retractrevision: procedure = .int
  arg db = .binary, revision_key = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  if _bound_text_exec(db, "UPDATE source_revisions SET active=0 WHERE revision_key=?1 AND active=1", revision_key) \= 0 then return _rollback(db)
  if _bound_text_exec(db, "UPDATE claim_support SET active=0 WHERE revision_key=?1 AND active=1", revision_key) \= 0 then return _rollback(db)
  sql = "UPDATE claims SET state='retracted' WHERE NOT EXISTS(SELECT 1 FROM claim_support s WHERE s.claim_key=claims.claim_key AND s.active=1)"
  if sqliteexec(db, sql) \= 0 then return _rollback(db)
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

claimstate: procedure = .int
  arg db = .binary, claim_key = .string, expose state = .string, expose active_supports = .int
  state = ""
  active_supports = 0
  statement = .binary
  sql = "SELECT c.state,(SELECT count(*) FROM claim_support s WHERE s.claim_key=c.claim_key AND s.active=1) FROM claims c WHERE c.claim_key=?1"
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, claim_key
  status = sqlitestep(statement)
  if status = 100 then do
    call sqlitecolumntext statement, 0, state
    call sqlitecolumnint statement, 1, active_supports
  end
  call sqlitefinalize statement
  if status = 100 then return 0
  if status = 101 then return -2
  return -1

supportcitation: procedure = .int
  arg db = .binary, support_key = .string, expose citation = .string, expose passage = .string
  citation = ""
  passage = ""
  statement = .binary
  if sqliteprepare(db, "SELECT revision_key,span_start,span_end,passage FROM claim_support WHERE support_key=?1", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, support_key
  status = sqlitestep(statement)
  if status = 100 then do
    revision_key = ""; span_start = 0; span_end = 0
    call sqlitecolumntext statement, 0, revision_key
    call sqlitecolumnint statement, 1, span_start
    call sqlitecolumnint statement, 2, span_end
    call sqlitecolumntext statement, 3, passage
    citation = revision_key || "#b" || span_start || "-" || span_end
  end
  call sqlitefinalize statement
  if status = 100 then return 0
  if status = 101 then return -2
  return -1

_active_occurrence: procedure = .int
  arg db = .binary, revision_key = .string, ordinal = .int, expose chunk_key = .string, expose body = .string
  chunk_key = ""; body = ""
  statement = .binary
  sql = "SELECT o.chunk_key,c.body FROM revision_chunks o JOIN chunk_contents c ON c.chunk_key=o.chunk_key JOIN source_revisions r ON r.revision_key=o.revision_key WHERE o.revision_key=?1 AND o.ordinal=?2 AND r.active=1"
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, revision_key
  call sqlitebindint statement, 2, ordinal
  status = sqlitestep(statement)
  if status = 100 then do
    call sqlitecolumntext statement, 0, chunk_key
    call sqlitecolumntext statement, 1, body
  end
  call sqlitefinalize statement
  if status = 100 then return 1
  if status = 101 then return 0
  return -1

_bound_text_exec: procedure = .int
  arg db = .binary, sql = .string, value = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, value
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

_rollback: procedure = .int
  arg db = .binary
  call sqliteexec db, "ROLLBACK"
  return -1
