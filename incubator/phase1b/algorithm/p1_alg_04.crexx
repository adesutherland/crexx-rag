options levelg

import rxfnsb
import sqlite_boundary
import source_store
import source_lifecycle
import claim_store
import evidence_packet
import vector_codec
import vector_search

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_ALG_04_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
errors = 0
db = .binary
errors = errors + check(sqliteopen(database_path, db) = 0 & sourceschema(db) = 0 & claimschema(db) = 0 & evidenceschema(db) = 0, "scratch schemas")

passage = "Identity Gateway depends on Cedar Store."
content = passage || "0A0A"x || "Gateway may refer to the identity or API boundary."
ingest = ingestartifact(db, "fixture://phase1b/evidence-source", content)
claim_key = ""; support_key = ""
errors = errors + check(ingest.status() = 0 & promoteclaim(db, ingest.revision_key(), 1, 0, length(passage), passage, "concept:identity-gateway", "service", "depends_on", "concept:cedar-store", "data-store", claim_key, support_key) = 0, "source and claim")
errors = errors + check(addambiguity(db, "ambiguity:gateway", "Gateway", "concept:identity-gateway") = 0 & addambiguity(db, "ambiguity:gateway", "Gateway", "concept:api-gateway") = 0, "explicit ambiguity")

query_values = .float[]; candidate_values = .float[]
query_values[1] = 1.0; query_values[2] = 0.0
candidate_values[1] = 0.8; candidate_values[2] = 0.6
query_payload = .binary; candidate_payload = .binary; vector_score = 0.0
errors = errors + check(encodef32(query_values, query_payload) = 0 & encodef32(candidate_values, candidate_payload) = 0 & cosinef32(query_payload, 2, candidate_payload, 2, vector_score) = 0, "vector lead arithmetic")
lead = .vectorlead("chunk:semantic-neighbor", vector_score, "cosine-neighbor")
packet = buildpacket(db, "Cedar", lead)
errors = errors + check(packet.valid() = 1 & packet.passage_kind() = "lexical-passage" & packet.passage() = passage, "lexical passage")
errors = errors + check(packet.claim_kind() = "accepted-typed-claim" & packet.claim_key() = claim_key & packet.subject_id() = "concept:identity-gateway" & packet.predicate() = "depends_on" & packet.object_id() = "concept:cedar-store" & packet.direction() = "subject-to-object", "typed claim")
errors = errors + check(packet.support_citation() = ingest.revision_key() || "#b0-" || length(passage), "normalized support")
errors = errors + check(packet.ambiguity_key() = "ambiguity:gateway" & packet.ambiguity_surface() = "Gateway" & packet.ambiguity_candidates() = 2, "ambiguity")
errors = errors + check(packet.vector_kind() = "vector-lead" & packet.vector_identity() = "chunk:semantic-neighbor" & packet.vector_score() > 0.79 & packet.vector_score() < 0.81 & length(packet.limitation()) > 0, "bounded vector lead")

errors = errors + check(sqliteclose(db) = 0, "close")
if errors \= 0 then do
  say "P1_ALG_04_ERRORS=" || errors
  return 1
end
say "P1_ALG_04_OK cell=" || cell || " lexical_passages=1 accepted_claims=1 normalized_supports=1 ambiguities=1 ambiguity_candidates=2 vector_leads=1 vector_is_fact=0 direction=subject-to-object limitation=explicit"
return 0
