options levelb

import rxfnsb
import sqlite_boundary
import source_store

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_ALG_01_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
errors = 0
db = .binary
errors = errors + check(sqliteopen(database_path, db) = 0, "open scratch database")
errors = errors + check(sourceschema(db) = 0, "scratch schema")

uri = "fixture://phase1b/architecture/current"
content = "Identity Gateway depends on Cedar Store." || "0A0A"x || "Vault Service supplies short-lived credentials." || "0A0A"x || "Deployment ownership remains unresolved."
revision_key = ""
chunk_count = 0
errors = errors + check(firstingest(db, uri, content, revision_key, chunk_count) = 0, "initial ingest")
errors = errors + check(chunk_count = 3 & revision_key = uri || "@fixture-v1:" || fixturefingerprint(content), "deterministic revision and chunks")
errors = errors + check(scalarcount(db, "SELECT count(*) FROM source_artifacts") = 1 & scalarcount(db, "SELECT count(*) FROM source_revisions WHERE active=1") = 1 & scalarcount(db, "SELECT count(*) FROM chunk_contents") = 3 & scalarcount(db, "SELECT count(*) FROM revision_chunks") = 3, "scratch row counts")

cedar = lexicalsearch(db, "Cedar", 10)
errors = errors + check(cedar.0 = 1 & cedar[1].ordinal() = 1 & cedar[1].revision_key() = revision_key & cedar[1].body() = "Identity Gateway depends on Cedar Store.", "lexical Cedar hit")
credentials = lexicalsearch(db, '"short-lived"', 10)
errors = errors + check(credentials.0 = 1 & credentials[1].ordinal() = 2, "lexical phrase hit")
missing = lexicalsearch(db, "nonexistent", 10)
errors = errors + check(missing.0 = 0, "lexical miss")

first_chunk_key = "chunk-fixture-v1:" || fixturefingerprint("Identity Gateway depends on Cedar Store.")
errors = errors + check(cedar[1].chunk_key() = first_chunk_key, "content-owned chunk identity")
errors = errors + check(sqliteclose(db) = 0, "close")
if errors \= 0 then do
  say "P1_ALG_01_ERRORS=" || errors
  return 1
end
say "P1_ALG_01_OK cell=" || cell || " scratch_schema=1 production_schema=0 paragraphs=3 deterministic=1 active_revisions=1 lexical_hits=1,1,0 chunk_identity=content-owned fingerprint=fixture-v1"
return 0
