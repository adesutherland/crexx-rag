options levelg

namespace evidence_packet expose vectorlead evidencepacket evidenceschema addambiguity buildpacket

import rxfnsb
import sqlite_boundary
import source_store

vectorlead: class
  _identity = .string
  _score = .float
  _reason = .string

  *: factory
    arg identity = .string, score = .float, reason = .string
    _identity = identity
    _score = score
    _reason = reason
    return
  identity: method = .string
    return _identity
  score: method = .float
    return _score
  reason: method = .string
    return _reason

evidencepacket: class
  _valid = .int
  _passage = .string
  _passage_kind = .string
  _claim_key = .string
  _claim_kind = .string
  _subject_id = .string
  _predicate = .string
  _object_id = .string
  _direction = .string
  _support_citation = .string
  _ambiguity_key = .string
  _ambiguity_surface = .string
  _ambiguity_candidates = .int
  _vector_identity = .string
  _vector_score = .float
  _vector_kind = .string
  _limitation = .string

  *: factory
    arg valid = .int, passage = .string, passage_kind = .string, claim_key = .string, claim_kind = .string, subject_id = .string, predicate = .string, object_id = .string, direction = .string, support_citation = .string, ambiguity_key = .string, ambiguity_surface = .string, ambiguity_candidates = .int, vector_identity = .string, vector_score = .float, vector_kind = .string, limitation = .string
    _valid = valid; _passage = passage; _passage_kind = passage_kind
    _claim_key = claim_key; _claim_kind = claim_kind; _subject_id = subject_id
    _predicate = predicate; _object_id = object_id; _direction = direction
    _support_citation = support_citation; _ambiguity_key = ambiguity_key
    _ambiguity_surface = ambiguity_surface; _ambiguity_candidates = ambiguity_candidates
    _vector_identity = vector_identity; _vector_score = vector_score
    _vector_kind = vector_kind; _limitation = limitation
    return

  valid: method = .int
    return _valid
  passage: method = .string
    return _passage
  passage_kind: method = .string
    return _passage_kind
  claim_key: method = .string
    return _claim_key
  claim_kind: method = .string
    return _claim_kind
  subject_id: method = .string
    return _subject_id
  predicate: method = .string
    return _predicate
  object_id: method = .string
    return _object_id
  direction: method = .string
    return _direction
  support_citation: method = .string
    return _support_citation
  ambiguity_key: method = .string
    return _ambiguity_key
  ambiguity_surface: method = .string
    return _ambiguity_surface
  ambiguity_candidates: method = .int
    return _ambiguity_candidates
  vector_identity: method = .string
    return _vector_identity
  vector_score: method = .float
    return _vector_score
  vector_kind: method = .string
    return _vector_kind
  limitation: method = .string
    return _limitation

evidenceschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "CREATE TABLE ambiguity_candidates(ambiguity_key TEXT NOT NULL,surface TEXT NOT NULL,candidate_id TEXT NOT NULL,state TEXT NOT NULL CHECK(state='unresolved'),PRIMARY KEY(ambiguity_key,candidate_id))") \= 0 then return -1
  return 0

addambiguity: procedure = .int
  arg db = .binary, ambiguity_key = .string, surface = .string, candidate_id = .string
  statement = .binary
  if sqliteprepare(db, "INSERT OR IGNORE INTO ambiguity_candidates(ambiguity_key,surface,candidate_id,state) VALUES(?1,?2,?3,'unresolved')", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, ambiguity_key
  call sqlitebindtext statement, 2, surface
  call sqlitebindtext statement, 3, candidate_id
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

buildpacket: procedure = .evidencepacket
  arg db = .binary, lexical_query = .string, lead = .vectorlead
  invalid = .evidencepacket(0, "", "", "", "", "", "", "", "", "", "", "", 0, "", 0.0, "", "")
  hits = lexicalsearch(db, lexical_query, 1)
  if hits.0 \= 1 then return invalid

  statement = .binary
  sql = "SELECT c.claim_key,c.subject_id,c.predicate,c.object_id,c.direction,s.revision_key,s.span_start,s.span_end FROM claims c JOIN claim_support s ON s.claim_key=c.claim_key WHERE c.state='accepted' AND s.active=1 AND s.chunk_key=?1 ORDER BY c.claim_key,s.support_key LIMIT 1"
  if sqliteprepare(db, sql, statement) \= 0 then return invalid
  call sqlitebindtext statement, 1, hits[1].chunk_key()
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return invalid
  end
  claim_key = ""; subject_id = ""; predicate = ""; object_id = ""; direction = ""; revision_key = ""; span_start = 0; span_end = 0
  call sqlitecolumntext statement, 0, claim_key
  call sqlitecolumntext statement, 1, subject_id
  call sqlitecolumntext statement, 2, predicate
  call sqlitecolumntext statement, 3, object_id
  call sqlitecolumntext statement, 4, direction
  call sqlitecolumntext statement, 5, revision_key
  call sqlitecolumnint statement, 6, span_start
  call sqlitecolumnint statement, 7, span_end
  call sqlitefinalize statement

  statement = .binary
  if sqliteprepare(db, "SELECT ambiguity_key,surface,count(*) FROM ambiguity_candidates WHERE state='unresolved' GROUP BY ambiguity_key,surface ORDER BY ambiguity_key LIMIT 1", statement) \= 0 then return invalid
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return invalid
  end
  ambiguity_key = ""; ambiguity_surface = ""; ambiguity_candidates = 0
  call sqlitecolumntext statement, 0, ambiguity_key
  call sqlitecolumntext statement, 1, ambiguity_surface
  call sqlitecolumnint statement, 2, ambiguity_candidates
  call sqlitefinalize statement

  citation = revision_key || "#b" || span_start || "-" || span_end
  limitation = "vector proximity and unresolved ambiguity are discovery leads, not typed claims"
  return .evidencepacket(1, hits[1].body(), "lexical-passage", claim_key, "accepted-typed-claim", subject_id, predicate, object_id, direction, citation, ambiguity_key, ambiguity_surface, ambiguity_candidates, lead.identity(), lead.score(), "vector-lead", limitation)
