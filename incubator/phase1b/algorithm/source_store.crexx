/* Phase-1B scratch source store using installed binary-safe SHA-256 content
 * digests. Connector URI remains the logical source identity. */
options levelg

namespace source_store expose lexicalhit sourceschema firstingest lexicalsearch active_revision contentdigest splitchunks totalchanges scalarcount

import rxfnsb
import rxhash
import sqlite_boundary

lexicalhit: class
  _chunk_key = .string
  _revision_key = .string
  _ordinal = .int
  _body = .string
  _rank = .float

  *: factory
    arg chunk_key = .string, revision_key = .string, ordinal = .int, body = .string, rank = .float
    _chunk_key = chunk_key
    _revision_key = revision_key
    _ordinal = ordinal
    _body = body
    _rank = rank
    return

  chunk_key: method = .string
    return _chunk_key
  revision_key: method = .string
    return _revision_key
  ordinal: method = .int
    return _ordinal
  body: method = .string
    return _body
  rank: method = .float
    return _rank

sourceschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "PRAGMA foreign_keys=ON") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE source_artifacts(uri TEXT PRIMARY KEY)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE source_revisions(revision_key TEXT PRIMARY KEY,uri TEXT NOT NULL REFERENCES source_artifacts(uri),content_fingerprint TEXT NOT NULL,content TEXT NOT NULL,active INTEGER NOT NULL CHECK(active IN(0,1)))") \= 0 then return -1
  if sqliteexec(db, "CREATE UNIQUE INDEX one_active_revision ON source_revisions(uri) WHERE active=1") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE chunk_contents(chunk_key TEXT PRIMARY KEY,content_fingerprint TEXT NOT NULL,body TEXT NOT NULL)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE revision_chunks(revision_key TEXT NOT NULL REFERENCES source_revisions(revision_key),ordinal INTEGER NOT NULL,chunk_key TEXT NOT NULL REFERENCES chunk_contents(chunk_key),PRIMARY KEY(revision_key,ordinal))") \= 0 then return -1
  if sqliteexec(db, "CREATE VIRTUAL TABLE chunk_fts USING fts5(revision_key UNINDEXED,ordinal UNINDEXED,chunk_key UNINDEXED,body)") \= 0 then return -1
  return 0

firstingest: procedure = .int
  arg db = .binary, uri = .string, content = .string, expose revision_key = .string, expose chunk_count = .int
  revision_key = uri || "@sha256:" || contentdigest(content)
  chunk_count = 0
  current = ""
  status = active_revision(db, uri, current)
  if status < 0 then return status
  if status = 1 then return -2
  paragraphs = .string[]
  call splitchunks content, paragraphs
  if paragraphs.0 = 0 then return -3
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1

  statement = .binary
  if sqliteprepare(db, "INSERT INTO source_artifacts(uri) VALUES(?1)", statement) \= 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitebindtext statement, 1, uri
  step_status = sqlitestep(statement)
  call sqlitefinalize statement
  if step_status \= 101 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end

  statement = .binary
  if sqliteprepare(db, "INSERT INTO source_revisions(revision_key,uri,content_fingerprint,content,active) VALUES(?1,?2,?3,?4,1)", statement) \= 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitebindtext statement, 1, revision_key
  call sqlitebindtext statement, 2, uri
  call sqlitebindtext statement, 3, contentdigest(content)
  call sqlitebindtext statement, 4, content
  step_status = sqlitestep(statement)
  call sqlitefinalize statement
  if step_status \= 101 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end

  do ordinal = 1 to paragraphs.0
    body = paragraphs[ordinal]
    fingerprint = contentdigest(body)
    chunk_key = "chunk-sha256:" || fingerprint
    statement = .binary
    if sqliteprepare(db, "INSERT OR IGNORE INTO chunk_contents(chunk_key,content_fingerprint,body) VALUES(?1,?2,?3)", statement) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    call sqlitebindtext statement, 1, chunk_key
    call sqlitebindtext statement, 2, fingerprint
    call sqlitebindtext statement, 3, body
    step_status = sqlitestep(statement)
    call sqlitefinalize statement
    if step_status \= 101 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end

    statement = .binary
    if sqliteprepare(db, "INSERT INTO revision_chunks(revision_key,ordinal,chunk_key) VALUES(?1,?2,?3)", statement) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    call sqlitebindtext statement, 1, revision_key
    call sqlitebindint statement, 2, ordinal
    call sqlitebindtext statement, 3, chunk_key
    step_status = sqlitestep(statement)
    call sqlitefinalize statement
    if step_status \= 101 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end

    statement = .binary
    if sqliteprepare(db, "INSERT INTO chunk_fts(revision_key,ordinal,chunk_key,body) VALUES(?1,?2,?3,?4)", statement) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    call sqlitebindtext statement, 1, revision_key
    call sqlitebindint statement, 2, ordinal
    call sqlitebindtext statement, 3, chunk_key
    call sqlitebindtext statement, 4, body
    step_status = sqlitestep(statement)
    call sqlitefinalize statement
    if step_status \= 101 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
  end
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  chunk_count = paragraphs.0
  return 0

lexicalsearch: procedure = .lexicalhit[]
  arg db = .binary, query = .string, limit = .int
  hits = .lexicalhit[]
  if query = "" | limit <= 0 then return hits
  statement = .binary
  sql = "SELECT f.chunk_key,f.revision_key,CAST(f.ordinal AS INTEGER),f.body,bm25(chunk_fts) FROM chunk_fts f JOIN source_revisions r ON r.revision_key=f.revision_key WHERE chunk_fts MATCH ?1 AND r.active=1 ORDER BY bm25(chunk_fts),f.chunk_key LIMIT ?2"
  if sqliteprepare(db, sql, statement) \= 0 then return hits
  if sqlitebindtext(statement, 1, query) \= 0 | sqlitebindint(statement, 2, limit) \= 0 then do
    call sqlitefinalize statement
    return hits
  end
  do forever
    status = sqlitestep(statement)
    if status = 101 then leave
    if status \= 100 then do
      call sqlitefinalize statement
      hits = .lexicalhit[]
      return hits
    end
    chunk_key = ""; revision_key = ""; ordinal = 0; body = ""; rank = 0.0
    if sqlitecolumntext(statement, 0, chunk_key) \= 0 | sqlitecolumntext(statement, 1, revision_key) \= 0 | sqlitecolumnint(statement, 2, ordinal) \= 0 | sqlitecolumntext(statement, 3, body) \= 0 | sqlitecolumnreal(statement, 4, rank) \= 0 then do
      call sqlitefinalize statement
      hits = .lexicalhit[]
      return hits
    end
    hits[hits.0 + 1] = .lexicalhit(chunk_key, revision_key, ordinal, body, rank)
  end
  call sqlitefinalize statement
  return hits

active_revision: procedure = .int
  arg db = .binary, uri = .string, expose revision_key = .string
  revision_key = ""
  statement = .binary
  if sqliteprepare(db, "SELECT revision_key FROM source_revisions WHERE uri=?1 AND active=1", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, uri
  status = sqlitestep(statement)
  if status = 100 then call sqlitecolumntext statement, 0, revision_key
  call sqlitefinalize statement
  if status = 100 then return 1
  if status = 101 then return 0
  return -1

contentdigest: procedure = .string
  arg text = .string
  return lower(bin2x(rxhash..sha256(text as .binary)))

splitchunks: procedure
  arg text = .string, expose chunks = .string[]
  chunks = .string[]
  if text = "" then return
  start = 1
  separator = "0A0A"x
  do forever
    boundary = pos(separator, text, start)
    if boundary = 0 then do
      chunks[chunks.0 + 1] = substr(text, start)
      leave
    end
    chunks[chunks.0 + 1] = substr(text, start, boundary - start)
    start = boundary + 2
  end
  return

totalchanges: procedure = .int
  arg db = .binary
  return scalarcount(db, "SELECT total_changes()")

scalarcount: procedure = .int
  arg db = .binary, sql = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return -1
  end
  value = -1
  call sqlitecolumnint statement, 0, value
  call sqlitefinalize statement
  return value
