options levelg

import rxfnsb
import sqlite_boundary
import source_store
import source_lifecycle
import claim_store
import evidence_packet

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1_ALG_05_FAIL=" || label
    return 1
  end
  return 0

elapsed_us: procedure = .int
  arg start = .int
  elapsed = time("us") - start
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
database_path = args[1]
cell = args[2]
errors = 0
db = .binary
errors = errors + check(sqliteopen(database_path, db) = 0 & sourceschema(db) = 0 & claimschema(db) = 0 & evidenceschema(db) = 0, "scratch schemas")

decision_uri = "fixture://it/auth/current"
operations_uri = "fixture://it/operations/corroboration"
passage = "Identity Gateway depends on Cedar Store."
decision_content = passage || "0A0A"x || "Gateway may refer to the identity or API boundary."
operations_content = "Operations confirms Cedar Store is required."
decision = ingestartifact(db, decision_uri, decision_content)
operations = ingestartifact(db, operations_uri, operations_content)
errors = errors + check(decision.status() = 0 & operations.status() = 0, "two-source ingest")

before_noop = totalchanges(db)
same = ingestartifact(db, decision_uri, decision_content)
errors = errors + check(same.disposition() = "identical-no-op" & same.library_writes() = 0 & same.provider_calls() = 0 & totalchanges(db) = before_noop, "oracle-compatible no-op")

edited_content = passage || "0A0A"x || "Gateway remains explicitly unresolved."
edited = ingestartifact(db, decision_uri, edited_content)
errors = errors + check(edited.status() = 0 & edited.reused_chunks() = 1 & edited.created_chunks() = 1, "paragraph reuse")

claim_key = ""; support_key = ""
errors = errors + check(promoteclaim(db, edited.revision_key(), 1, 0, length(passage), passage, "entity:identity-gateway", "service", "depends-on", "entity:cedar-store", "data-object", claim_key, support_key) = 0, "directional accepted claim")
errors = errors + check(addambiguity(db, "ambiguity:gateway", "Gateway", "entity:identity-gateway") = 0 & addambiguity(db, "ambiguity:gateway", "Gateway", "entity:api-gateway") = 0, "ambiguity")
packet = buildpacket(db, "Cedar", .vectorlead("chunk:semantic-neighbor", 0.8, "cosine-neighbor"))
errors = errors + check(packet.valid() = 1 & packet.claim_kind() = "accepted-typed-claim" & packet.direction() = "subject-to-object" & packet.vector_kind() = "vector-lead" & packet.ambiguity_candidates() = 2, "evidence parity")

two_source_hits = lexicalsearch(db, '"Cedar Store"', 10)
errors = errors + check(two_source_hits.0 = 2, "two-source lexical retrieval")
errors = errors + check(retractrevision(db, operations.revision_key()) = 0, "source retraction")
one_source_hits = lexicalsearch(db, '"Cedar Store"', 10)
errors = errors + check(one_source_hits.0 = 1 & one_source_hits[1].revision_key() = edited.revision_key(), "retracted source absent from retrieval")
state = ""; active_supports = 0
errors = errors + check(claimstate(db, claim_key, state, active_supports) = 0 & state = "accepted" & active_supports = 1, "independent retraction preserves claim")
errors = errors + check(retractrevision(db, edited.revision_key()) = 0 & claimstate(db, claim_key, state, active_supports) = 0 & state = "retracted" & active_supports = 0, "support retraction updates claim")

iterations = 2000
checksum = 0
start = time("us")
do i = 1 to iterations
  benchmark_text = "Identity Gateway depends on Cedar Store and Vault Service " || i
  fingerprint = fixturefingerprint(benchmark_text)
  chunks = .string[]
  call splitchunks benchmark_text || "0A0A"x || "Deployment owner unresolved.", chunks
  checksum = checksum + length(fingerprint) + chunks.0 + pos("Cedar Store", chunks[1])
end
algorithm_us = elapsed_us(start)
errors = errors + check(checksum > 0, "algorithm profile checksum")
say "P1_ALG_05_PROFILE cell=" || cell || " algorithm_2000_us=" || algorithm_us || " threshold_us=10000 checksum=" || checksum

errors = errors + check(sqliteclose(db) = 0, "close")
if errors \= 0 then do
  say "P1_ALG_05_ERRORS=" || errors
  return 1
end
say "P1_ALG_05_OK cell=" || cell || " native_records=9 deterministic_chunking=1 lexical_sources=2,1 identical_writes=0 paragraph_reuse=1 direction=forward accepted_claim=1 exact_support=1 ambiguity=explicit vector_is_fact=0 retracted_claim=1 algorithm_2000_us=" || algorithm_us || " threshold_us=10000 checksum=" || checksum
return 0
