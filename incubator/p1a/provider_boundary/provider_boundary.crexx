options levelg

namespace provider_boundary expose llm_request embeddingrecord llm_result llm_error geminicall

import rxfnsb
import rxjson
import rxfnsg

/* Application schema owns element type, count and dimensional meaning. The
 * payload itself is production rxjson's owning headerless little-endian bytes. */
embeddingrecord: class
  _element_type = .string
  _count = .int
  _dimensions = .int
  _payload = .binary

  *: factory
    arg element_type = .string, count = .int, dimensions = .int, payload = .binary
    _element_type = element_type
    _count = count
    _dimensions = dimensions
    _payload = payload

  valid: method = .int
    if _element_type \= "f32le" | _count < 0 | _dimensions \= _count then return 0
    if binlength(_payload) \= _count * 4 then return 0
    return 1
  element_type: method = .string
    return _element_type
  count: method = .int
    return _count
  dimensions: method = .int
    return _dimensions
  byte_length: method = .int
    return binlength(_payload)
  value: method = .float
    arg index = .int
    if index < 1 | index > _count then return 0.0
    return <at..f32>((index - 1) * 4) _payload
  payload: method = .binary
    return _payload

llm_request: class
  _operation = .string
  _model = .string
  _input = .string
  _timeout_ms = .int
  _dimensions = .int

  *: factory
    arg operation = .string, model = .string, input = .string, timeout_ms = 30000, dimensions = 0
    _operation = operation
    _model = model
    _input = input
    _timeout_ms = timeout_ms
    _dimensions = dimensions

  operation: method = .string
    return _operation
  model: method = .string
    return _model
  input: method = .string
    return _input
  timeout_ms: method = .int
    return _timeout_ms
  dimensions: method = .int
    return _dimensions

llm_result: class
  _provider = .string
  _model = .string
  _text = .string
  _embedding = .embeddingrecord
  _input_tokens = .int
  _output_tokens = .int

  *: factory
    empty_payload = .binary
    _provider = ""
    _model = ""
    _text = ""
    _embedding = .embeddingrecord("f32le", 0, 0, empty_payload)
    _input_tokens = 0
    _output_tokens = 0

  set_generation: method = .int
    arg provider = .string, model = .string, text = .string, input_tokens = 0, output_tokens = 0
    _provider = provider
    _model = model
    _text = text
    _input_tokens = input_tokens
    _output_tokens = output_tokens
    return 0

  set_embedding: method = .int
    arg provider = .string, model = .string, embedding = .embeddingrecord, input_tokens = 0
    _provider = provider
    _model = model
    _text = ""
    _embedding = embedding
    _input_tokens = input_tokens
    _output_tokens = 0
    return 0

  provider: method = .string
    return _provider
  model: method = .string
    return _model
  text: method = .string
    return _text
  embedding: method = .embeddingrecord
    return _embedding
  input_tokens: method = .int
    return _input_tokens
  output_tokens: method = .int
    return _output_tokens

llm_error: class
  _category = .string
  _code = .int
  _http_status = .int
  _retryable = .int
  _message = .string

  *: factory
    _category = "none"
    _code = 0
    _http_status = 0
    _retryable = 0
    _message = ""

  set: method = .int
    arg category = .string, code = .int, http_status = .int, retryable = .int, message = .string
    _category = category
    _code = code
    _http_status = http_status
    _retryable = retryable
    _message = message
    return code

  category: method = .string
    return _category
  code: method = .int
    return _code
  http_status: method = .int
    return _http_status
  retryable: method = .int
    return _retryable
  message: method = .string
    return _message

geminicall: procedure = .int
  arg request = .llm_request, host = .string, port = .int, tls = .int, api_key = .string, expose result = .llm_result, expose error = .llm_error
  result = .llm_result()
  error = .llm_error()
  if api_key = "" then return error.set("authentication", -100, 0, 0, "API key is empty")
  if request.timeout_ms() <= 0 then return error.set("invalid_request", -101, 0, 0, "timeout must be positive")
  if request.operation() \= "generate" & request.operation() \= "embed" then return error.set("invalid_request", -101, 0, 0, "operation must be generate or embed")
  if request.operation() = "embed" & request.dimensions() < 0 then return error.set("invalid_request", -101, 0, 0, "embedding dimensions cannot be negative")

  headers = .httpheaders.json()
  call headers.add("x-goog-api-key", api_key)
  policy = .httppolicy.safe()
  timeout_ms = request.timeout_ms()
  if timeout_ms > 600000 then timeout_ms = 600000
  call policy.set_timeouts(timeout_ms, timeout_ms, timeout_ms, timeout_ms, timeout_ms, timeout_ms)
  scheme = "http://"
  if tls <> 0 then scheme = "https://"
  client = .httpclient.pooled(scheme || host || ":" || port, 1, 2, 8388608, policy)
  path = _gemini_path(request)
  body = _gemini_body(request)
  response = client.post(path, body, headers)
  call client.close()
  if response.succeeded() = 0 then return _transport_error(response, error)
  document = .jsondocument(response.body())
  if document.valid() = 0 then return error.set("malformed_response", -102, response.status(), 0, "provider response is not valid JSON: " || document.error())
  if document.type("error.message") = "string" then return error.set("provider", -103, response.status(), 0, document.get("error.message"))
  if request.operation() = "generate" then return _generation_result(request, document, result, error)
  return _embedding_result(request, document, result, error)

_gemini_path: procedure = .string
  arg request = .llm_request
  model = request.model()
  if left(model, 7) \= "models/" then model = "models/" || model
  if request.operation() = "generate" then return "/v1beta/" || model || ":generateContent"
  return "/v1beta/" || model || ":embedContent"

_gemini_body: procedure = .string
  arg request = .llm_request
  part_keys = .string[]
  part_values = .string[]
  parts = .string[]
  content_keys = .string[]
  content_values = .string[]
  part_keys[1] = "text"
  part_values[1] = jsonquote(request.input())
  parts[1] = jsonobject(part_keys, part_values)
  content_keys[1] = "parts"
  content_values[1] = jsonarray(parts)
  content = jsonobject(content_keys, content_values)

  keys = .string[]
  values = .string[]
  if request.operation() = "generate" then do
    contents = .string[]
    contents[1] = content
    keys[1] = "contents"
    values[1] = jsonarray(contents)
  end
  else do
    keys[1] = "model"
    model = request.model()
    if left(model, 7) \= "models/" then model = "models/" || model
    values[1] = jsonquote(model)
    keys[2] = "content"
    values[2] = content
    if request.dimensions() > 0 then do
      /* The current REST service accepts this compatibility field at the
       * request top level.  The nested SDK-shaped form was measured returning
       * the full 3,072-value embedding and is retained as a provider issue. */
      keys[3] = "outputDimensionality"
      values[3] = request.dimensions()
    end
  end
  return jsonobject(keys, values)

_transport_error: procedure = .int
  arg response = .httpresponse, expose error = .llm_error
  transport_status = response.transport_status()
  http_status = response.status()
  code = transport_status
  if code = 0 then code = http_status
  message = response.error()
  response_body = response.body()
  if response_body \= "" then do
    document = .jsondocument(response_body)
    if document.valid() = 1 & document.type("error.message") = "string" then message = document.get("error.message")
  end
  if transport_status = -6 | transport_status = -10 | transport_status = -11 | transport_status = -12 then return error.set("timeout", -5, http_status, 1, message)
  if transport_status = -1 | transport_status = -2 | transport_status = -3 | transport_status = -7 | transport_status = -8 then return error.set("connection", -3, http_status, 1, message)
  if http_status >= 500 then return error.set("http", http_status, http_status, 1, message)
  if http_status = 408 | http_status = 429 then return error.set("http", http_status, http_status, 1, message)
  return error.set("http", code, http_status, 0, message)

_generation_result: procedure = .int
  arg request = .llm_request, document = .jsondocument, expose result = .llm_result, expose error = .llm_error
  if document.type("candidates.1.content.parts.1.text") \= "string" then return error.set("malformed_response", -102, 200, 0, "generated text is missing")
  text = document.get("candidates.1.content.parts.1.text")
  input_tokens = 0
  output_tokens = 0
  if document.type("usageMetadata.promptTokenCount") = "number" then input_tokens = document.get("usageMetadata.promptTokenCount") as .int
  if document.type("usageMetadata.candidatesTokenCount") = "number" then output_tokens = document.get("usageMetadata.candidatesTokenCount") as .int
  ignored = result.set_generation("google-gemini", request.model(), text, input_tokens, output_tokens)
  return 0

_embedding_result: procedure = .int
  arg request = .llm_request, document = .jsondocument, expose result = .llm_result, expose error = .llm_error
  root = document.root()
  embedding_node = document.member(root, "embedding")
  values_node = document.member(embedding_node, "values")
  expected_count = request.dimensions()
  if expected_count = 0 then expected_count = -1
  packed = .binary
  projection_error = ""
  projection_status = document.node_f32_array(values_node, expected_count, packed, projection_error)
  count = document.node_count(values_node)
  embedding = .embeddingrecord("f32le", count, count, packed)
  if projection_status \= 0 | embedding.valid() = 0 | count <= 0 then return error.set("malformed_response", -102, 200, 0, "embedding values are invalid: " || projection_error)
  input_tokens = 0
  if document.type("usageMetadata.promptTokenCount") = "number" then input_tokens = document.get("usageMetadata.promptTokenCount") as .int
  ignored = result.set_embedding("google-gemini", request.model(), embedding, input_tokens)
  return 0
