/* External typed contract for the status-evidence operation. */
options levelb

namespace surface_operation expose statusoperation statusrequest statusresult claimresult

statusoperation: interface
  status_evidence: method = .statusresult
    arg request = .statusrequest

statusrequest: interface
  operation: method = .string

statusresult: interface
  status: method = .string
  operation: method = .string
  passage: method = .string
  claim: method = .claimresult
  citation: method = .string
  gap: method = .string

claimresult: interface
  subject: method = .string
  predicate: method = .string
  object: method = .string
  direction: method = .string
