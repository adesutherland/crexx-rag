/* Phase-1A application slice.  Product lifecycle, schema, support semantics,
 * and evidence assembly intentionally remain Level-B cREXX. */
options levelb

namespace algorithm_slice expose algschema ingestartifact promoteclaim retireartifact evidencepacket

import rxfnsb
import rxjson
import sqlite_boundary

algschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "CREATE TABLE source_artifacts(uri TEXT PRIMARY KEY)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE source_revisions(revision_key TEXT PRIMARY KEY, uri TEXT NOT NULL, content_fingerprint TEXT NOT NULL, content TEXT NOT NULL, active INTEGER NOT NULL CHECK(active IN(0,1)))") \= 0 then return -1
  if sqliteexec(db, "CREATE UNIQUE INDEX one_active_revision ON source_revisions(uri) WHERE active=1") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE derived_chunks(derived_key TEXT PRIMARY KEY, body TEXT NOT NULL)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE chunks(chunk_key TEXT PRIMARY KEY, revision_key TEXT NOT NULL, ordinal INTEGER NOT NULL, derived_key TEXT NOT NULL, body TEXT NOT NULL, UNIQUE(revision_key,ordinal))") \= 0 then return -1
  if sqliteexec(db, "CREATE VIRTUAL TABLE chunk_fts USING fts5(chunk_key UNINDEXED, revision_key UNINDEXED, body)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE claims(claim_key TEXT PRIMARY KEY, subject TEXT NOT NULL, predicate TEXT NOT NULL, object TEXT NOT NULL, direction TEXT NOT NULL CHECK(direction='subject-to-object'))") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE supports(claim_key TEXT NOT NULL, revision_key TEXT NOT NULL, chunk_key TEXT NOT NULL, active INTEGER NOT NULL CHECK(active IN(0,1)), PRIMARY KEY(claim_key,revision_key,chunk_key))") \= 0 then return -1
  return 0

ingestartifact: procedure = .int
  arg db = .binary, uri = .string, content = .string, expose revision_key = .string, expose disposition = .string, expose library_writes = .int, expose provider_calls = .int, expose reused_derived = .int
  provider_calls = 0
  reused_derived = 0
  library_writes = 0
  revision_key = uri || "@" || _alg_fingerprint(content)
  current_revision = ""
  status = _alg_active_revision(db, uri, current_revision)
  if status < 0 then return status
  if current_revision = revision_key then do
    disposition = "identical-no-op"
    return 0
  end
  before_changes = _alg_total_changes(db)
  if before_changes < 0 then return -1
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1

  if current_revision \= "" then do
    if _alg_bound_exec(db, "UPDATE source_revisions SET active=0 WHERE revision_key=?1", current_revision) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    if _alg_bound_exec(db, "UPDATE supports SET active=0 WHERE revision_key=?1", current_revision) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    if _alg_bound_exec(db, "DELETE FROM chunk_fts WHERE revision_key=?1", current_revision) \= 0 then do
      call sqliteexec db, "ROLLBACK"
      return -1
    end
  end

  statement = .binary
  if sqliteprepare(db, "INSERT OR IGNORE INTO source_artifacts(uri) VALUES(?1)", statement) \= 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitebindtext statement, 1, uri
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement

  statement = .binary
  if sqliteprepare(db, "INSERT INTO source_revisions(revision_key,uri,content_fingerprint,content,active) VALUES(?1,?2,?3,?4,1)", statement) \= 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitebindtext statement, 1, revision_key
  call sqlitebindtext statement, 2, uri
  call sqlitebindtext statement, 3, _alg_fingerprint(content)
  call sqlitebindtext statement, 4, content
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement

  paragraphs = .string[]
  call _alg_paragraphs content, paragraphs
  do ordinal = 1 to paragraphs.0
    body = paragraphs[ordinal]
    derived_key = "derived:" || _alg_fingerprint(body)
    if _alg_text_exists(db, "SELECT count(*) FROM derived_chunks WHERE derived_key=?1", derived_key) = 1 then reused_derived = reused_derived + 1
    else do
      stmt_derived = .binary
      call sqliteprepare db, "INSERT INTO derived_chunks(derived_key,body) VALUES(?1,?2)", stmt_derived
      call sqlitebindtext stmt_derived, 1, derived_key
      call sqlitebindtext stmt_derived, 2, body
      if sqlitestep(stmt_derived) \= 101 then do
        call sqlitefinalize stmt_derived
        call sqliteexec db, "ROLLBACK"
        return -1
      end
      call sqlitefinalize stmt_derived
    end
    chunk_key = revision_key || "#p" || ordinal
    stmt_chunk = .binary
    call sqliteprepare db, "INSERT INTO chunks(chunk_key,revision_key,ordinal,derived_key,body) VALUES(?1,?2,?3,?4,?5)", stmt_chunk
    call sqlitebindtext stmt_chunk, 1, chunk_key
    call sqlitebindtext stmt_chunk, 2, revision_key
    call sqlitebindint stmt_chunk, 3, ordinal
    call sqlitebindtext stmt_chunk, 4, derived_key
    call sqlitebindtext stmt_chunk, 5, body
    if sqlitestep(stmt_chunk) \= 101 then do
      call sqlitefinalize stmt_chunk
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    call sqlitefinalize stmt_chunk
    stmt_fts = .binary
    call sqliteprepare db, "INSERT INTO chunk_fts(chunk_key,revision_key,body) VALUES(?1,?2,?3)", stmt_fts
    call sqlitebindtext stmt_fts, 1, chunk_key
    call sqlitebindtext stmt_fts, 2, revision_key
    call sqlitebindtext stmt_fts, 3, body
    if sqlitestep(stmt_fts) \= 101 then do
      call sqlitefinalize stmt_fts
      call sqliteexec db, "ROLLBACK"
      return -1
    end
    call sqlitefinalize stmt_fts
  end
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  library_writes = _alg_total_changes(db) - before_changes
  if current_revision = "" then disposition = "first-load"
  else disposition = "superseding-edit"
  return 0

promoteclaim: procedure = .int
  arg db = .binary, revision_key = .string, ordinal = .int, subject = .string, predicate = .string, object = .string, expose claim_key = .string
  claim_key = translate(subject) || "|" || translate(predicate) || "|" || translate(object)
  chunk_key = revision_key || "#p" || ordinal
  if _alg_text_exists(db, "SELECT count(*) FROM chunks WHERE chunk_key=?1", chunk_key) \= 1 then return -2
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  statement = .binary
  call sqliteprepare db, "INSERT OR IGNORE INTO claims(claim_key,subject,predicate,object,direction) VALUES(?1,?2,?3,?4,'subject-to-object')", statement
  call sqlitebindtext statement, 1, claim_key
  call sqlitebindtext statement, 2, subject
  call sqlitebindtext statement, 3, predicate
  call sqlitebindtext statement, 4, object
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement
  statement = .binary
  call sqliteprepare db, "INSERT OR IGNORE INTO supports(claim_key,revision_key,chunk_key,active) SELECT ?1,?2,?3,1 WHERE EXISTS(SELECT 1 FROM source_revisions WHERE revision_key=?2 AND active=1)", statement
  call sqlitebindtext statement, 1, claim_key
  call sqlitebindtext statement, 2, revision_key
  call sqlitebindtext statement, 3, chunk_key
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

retireartifact: procedure = .int
  arg db = .binary, uri = .string
  current_revision = ""
  if _alg_active_revision(db, uri, current_revision) \= 1 then return -2
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  if _alg_bound_exec(db, "UPDATE source_revisions SET active=0 WHERE revision_key=?1", current_revision) \= 0 then return -1
  if _alg_bound_exec(db, "UPDATE supports SET active=0 WHERE revision_key=?1", current_revision) \= 0 then return -1
  if _alg_bound_exec(db, "DELETE FROM chunk_fts WHERE revision_key=?1", current_revision) \= 0 then return -1
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

evidencepacket: procedure = .int
  arg db = .binary, uri = .string, expose packet = .string
  statement = .binary
  sql = "SELECT c.body,cl.subject,cl.predicate,cl.object,s.revision_key,c.ordinal FROM supports s JOIN claims cl ON cl.claim_key=s.claim_key JOIN chunks c ON c.chunk_key=s.chunk_key JOIN source_revisions r ON r.revision_key=s.revision_key WHERE r.uri=?1 AND r.active=1 AND s.active=1 ORDER BY cl.claim_key LIMIT 1"
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, uri
  status = sqlitestep(statement)
  if status = 101 then do
    call sqlitefinalize statement
    packet = '{"passage":null,"supportedClaim":null,"lead":{"kind":"gap","value":"no current support"},"citation":null,"gap":"current source support is unavailable"}'
    return 0
  end
  if status \= 100 then do
    call sqlitefinalize statement
    return -1
  end
  passage = ""; subject = ""; predicate = ""; object = ""; revision = ""; ordinal = 0
  call sqlitecolumntext statement, 0, passage
  call sqlitecolumntext statement, 1, subject
  call sqlitecolumntext statement, 2, predicate
  call sqlitecolumntext statement, 3, object
  call sqlitecolumntext statement, 4, revision
  call sqlitecolumnint statement, 5, ordinal
  call sqlitefinalize statement
  citation = revision || "#p" || ordinal
  packet = '{"passage":' || jsonquote(passage) || ',"supportedClaim":{"subject":' || jsonquote(subject) || ',"predicate":' || jsonquote(predicate) || ',"object":' || jsonquote(object) || ',"direction":"subject-to-object"},"lead":{"kind":"ambiguity","value":"Gateway alias remains unresolved"},"citation":' || jsonquote(citation) || ',"gap":"deployment owner is not evidenced"}'
  return 0

_alg_fingerprint: procedure = .string
  arg text = .string
  checksum = 0
  do i = 1 to length(text)
    checksum = checksum + c2d(substr(text, i, 1)) * i
  end
  return "r" || length(text) || "-" || checksum

_alg_paragraphs: procedure
  arg text = .string, expose paragraphs = .string[]
  paragraphs = .string[]
  start = 1
  count = 0
  separator = "0A0A"x
  do forever
    boundary = pos(separator, text, start)
    count = count + 1
    if boundary = 0 then do
      paragraphs[count] = substr(text, start)
      leave
    end
    paragraphs[count] = substr(text, start, boundary - start)
    start = boundary + 2
  end
  return

_alg_active_revision: procedure = .int
  arg db = .binary, uri = .string, expose revision = .string
  revision = ""
  statement = .binary
  if sqliteprepare(db, "SELECT revision_key FROM source_revisions WHERE uri=?1 AND active=1", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, uri
  status = sqlitestep(statement)
  if status = 100 then call sqlitecolumntext statement, 0, revision
  call sqlitefinalize statement
  if status = 100 then return 1
  if status = 101 then return 0
  return -1

_alg_total_changes: procedure = .int
  arg db = .binary
  statement = .binary
  if sqliteprepare(db, "SELECT total_changes()", statement) \= 0 then return -1
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return -1
  end
  value = -1
  call sqlitecolumnint statement, 0, value
  call sqlitefinalize statement
  return value

_alg_text_exists: procedure = .int
  arg db = .binary, sql = .string, value = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, value
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return -1
  end
  count = 0
  call sqlitecolumnint statement, 0, count
  call sqlitefinalize statement
  if count > 0 then return 1
  return 0

_alg_bound_exec: procedure = .int
  arg db = .binary, sql = .string, value = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 then return -1
  call sqlitebindtext statement, 1, value
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1
