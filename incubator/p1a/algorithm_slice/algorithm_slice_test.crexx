options levelb

import rxfnsb
import sqlite_boundary
import rxjson
import algorithm_slice

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1A_ALG_FAIL=" || label
    return 1
  end
  return 0

scalar: procedure = .int
  arg db = .binary, sql = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 | sqlitestep(statement) \= 100 then return -1
  value = -1
  call sqlitecolumnint statement, 0, value
  call sqlitefinalize statement
  return value

main: procedure = .int
errors = 0
db = .binary
errors = errors + check(sqliteopen(":memory:", db) = 0 & algschema(db) = 0, "scratch schema")
uri = "fixture://it/architecture/current"
first = "Identity Gateway depends on Cedar Store." || "0A0A"x || "Vault Service supplies credentials."
edited = "Identity Gateway depends on Cedar Store." || "0A0A"x || "Vault Service supplies short-lived credentials."

revision1 = ""; disposition = ""; writes = -1; calls = -1; reused = -1
errors = errors + check(ingestartifact(db, uri, first, revision1, disposition, writes, calls, reused) = 0, "first ingest")
errors = errors + check(disposition = "first-load" & writes > 0 & calls = 0 & reused = 0, "first load result")
errors = errors + check(scalar(db, "SELECT count(*) FROM chunks") = 2 & scalar(db, "SELECT count(*) FROM chunk_fts WHERE chunk_fts MATCH 'Cedar'") = 1, "deterministic chunk and FTS")

changes_before = scalar(db, "SELECT total_changes()")
same_revision = ""; disposition = ""; writes = -1; calls = -1; reused = -1
errors = errors + check(ingestartifact(db, uri, first, same_revision, disposition, writes, calls, reused) = 0, "identical ingest")
changes_after = scalar(db, "SELECT total_changes()")
errors = errors + check(same_revision = revision1 & disposition = "identical-no-op" & writes = 0 & calls = 0 & changes_after = changes_before, "identical zero-write/provider no-op")

revision2 = ""; disposition = ""; writes = -1; calls = -1; reused = -1
errors = errors + check(ingestartifact(db, uri, edited, revision2, disposition, writes, calls, reused) = 0, "paragraph edit")
errors = errors + check(revision2 \= revision1 & disposition = "superseding-edit" & calls = 0 & reused = 1, "safe derived reuse")
errors = errors + check(scalar(db, "SELECT count(*) FROM source_revisions WHERE active=1") = 1 & scalar(db, "SELECT count(*) FROM derived_chunks") = 3 & scalar(db, "SELECT count(*) FROM chunk_fts WHERE chunk_fts MATCH 'Cedar'") = 1, "immutable revision publication")

claim_key = ""
errors = errors + check(promoteclaim(db, revision2, 1, "Identity Gateway", "depends_on", "Cedar Store", claim_key) = 0, "directional promotion")
errors = errors + check(scalar(db, "SELECT count(*) FROM supports WHERE active=1") = 1, "exact active support")

packet = ""
errors = errors + check(evidencepacket(db, uri, packet) = 0, "evidence packet")
document = .jsondocument(packet)
errors = errors + check(document.valid() = 1 & document.get("passage") = "Identity Gateway depends on Cedar Store.", "packet passage")
errors = errors + check(document.get("supportedClaim.subject") = "Identity Gateway" & document.get("supportedClaim.predicate") = "depends_on" & document.get("supportedClaim.object") = "Cedar Store" & document.get("supportedClaim.direction") = "subject-to-object", "packet supported claim")
errors = errors + check(document.get("lead.kind") = "ambiguity" & document.get("citation") = revision2 || "#p1" & length(document.get("gap")) > 0, "packet lead citation gap")
packet_again = ""
errors = errors + check(evidencepacket(db, uri, packet_again) = 0 & packet_again = packet, "stable citation and packet")

errors = errors + check(retireartifact(db, uri) = 0, "source removal")
errors = errors + check(scalar(db, "SELECT count(*) FROM supports WHERE active=1") = 0 & scalar(db, "SELECT count(*) FROM chunk_fts") = 0, "support and index retraction")
gap_packet = ""
errors = errors + check(evidencepacket(db, uri, gap_packet) = 0, "gap packet")
gap_document = .jsondocument(gap_packet)
errors = errors + check(gap_document.valid() = 1 & gap_document.type("passage") = "null" & gap_document.type("supportedClaim") = "null" & gap_document.get("lead.kind") = "gap" & length(gap_document.get("gap")) > 0, "explicit removal gap")

errors = errors + check(sqliteclose(db) = 0, "close")
if errors \= 0 then do
  say "P1A_ALG_ERRORS=" || errors
  return 1
end
say "P1A_ALG_OK first_load=1 identical_no_writes=1 paragraph_reuse=1 active_revisions=1 directional_claim=1 exact_support=1 retracted=1 stable_citation=1 passage=1 ambiguity_lead=1 gap=1 provider_calls=0"
return 0
