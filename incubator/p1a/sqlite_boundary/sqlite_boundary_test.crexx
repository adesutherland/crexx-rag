options levelb

import rxfnsb
import sqlite_boundary

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1A_SQLITE_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
errors = 0
db = .binary
statement = .binary
status = sqliteopen(":memory:", db)
errors = errors + check(status = 0, "open")
threadsafe = 0
session_affinity = 0
errors = errors + check(sqlitecapability(db, "threadsafe", threadsafe) = 0 & threadsafe = 1, "SQLite mutex capability")
errors = errors + check(sqlitecapability(db, "session_affinity", session_affinity) = 0 & session_affinity = 1, "RXPA session entered")

/* A copied native handle retains ownership; destroying the copy leaves the
 * original usable. */
db_copy = db
db_copy = .binary
status = sqliteexec(db, "CREATE TABLE typed_values(n, min_i INTEGER, max_i INTEGER, r REAL, t TEXT, e TEXT, b BLOB, long_t TEXT)")
errors = errors + check(status = 0, "copied handle ownership")

status = sqliteprepare(db, "INSERT INTO typed_values VALUES(?1,?2,?3,?4,?5,?6,?7,?8)", statement)
errors = errors + check(status = 0, "prepare typed insert")
min_i = -9223372036854775807 - 1
max_i = 9223372036854775807
unicode_text = "Gràdh 中 ☺"
embedded_nul = "41004200ff"x as .binary
large_text = copies("x", 1100005)
errors = errors + check(sqlitebindnull(statement, 1) = 0, "bind null")
errors = errors + check(sqlitebindint(statement, 2, min_i) = 0, "bind int min")
errors = errors + check(sqlitebindint(statement, 3, max_i) = 0, "bind int max")
errors = errors + check(sqlitebindreal(statement, 4, 3.25) = 0, "bind real")
errors = errors + check(sqlitebindtext(statement, 5, unicode_text) = 0, "bind Unicode text")
errors = errors + check(sqlitebindtext(statement, 6, "") = 0, "bind empty text")
errors = errors + check(sqlitebindblob(statement, 7, embedded_nul) = 0, "bind embedded-NUL blob")
errors = errors + check(sqlitebindtext(statement, 8, large_text) = 0, "bind text beyond old buffer")
errors = errors + check(sqlitestep(statement) = 101, "insert done")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize insert")

statement = .binary
status = sqliteprepare(db, "SELECT n,min_i,max_i,r,t,e,b,long_t FROM typed_values", statement)
errors = errors + check(status = 0 & sqlitestep(statement) = 100, "typed row cursor")
kind = ""
is_null = 0
read_min = 0
read_max = 0
read_real = 0.0
read_text = ""
read_empty = "not empty"
read_blob = .binary
read_large = ""
errors = errors + check(sqlitecolumntype(statement, 0, kind) = 0 & kind = "null", "read null type")
errors = errors + check(sqlitecolumnisnull(statement, 0, is_null) = 0 & is_null = 1, "read null")
errors = errors + check(sqlitecolumnint(statement, 1, read_min) = 0 & read_min = min_i, "read int min")
errors = errors + check(sqlitecolumnint(statement, 2, read_max) = 0 & read_max = max_i, "read int max")
errors = errors + check(sqlitecolumnreal(statement, 3, read_real) = 0 & read_real = 3.25, "read real")
errors = errors + check(sqlitecolumntext(statement, 4, read_text) = 0 & read_text = unicode_text, "read Unicode text")
errors = errors + check(sqlitecolumntext(statement, 5, read_empty) = 0 & read_empty = "", "read empty text")
errors = errors + check(sqlitecolumnblob(statement, 6, read_blob) = 0 & bin2x(read_blob) = "41004200FF", "read embedded-NUL blob")
errors = errors + check(sqlitecolumntext(statement, 7, read_large) = 0 & length(read_large) = 1100005, "read text beyond old buffer")
errors = errors + check(sqlitestep(statement) = 101, "cursor done")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize select")

/* Cursor iteration and deterministic ordering. */
errors = errors + check(sqliteexec(db, "CREATE TABLE numbers(v INTEGER)") = 0, "create cursor table")
errors = errors + check(sqliteexec(db, "INSERT INTO numbers VALUES(3),(1),(2)") = 0, "seed cursor table")
statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT v FROM numbers ORDER BY v", statement) = 0, "prepare cursor")
sum = 0
rows = 0
do forever
  status = sqlitestep(statement)
  if status = 101 then leave
  errors = errors + check(status = 100, "cursor row status")
  value = 0
  errors = errors + check(sqlitecolumnint(statement, 0, value) = 0, "cursor typed read")
  sum = sum + value
  rows = rows + 1
end
errors = errors + check(rows = 3 & sum = 6, "cursor iteration")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize cursor")

/* Transaction rollback. */
errors = errors + check(sqliteexec(db, "CREATE TABLE rollback_values(v INTEGER)") = 0, "create rollback table")
errors = errors + check(sqliteexec(db, "BEGIN") = 0, "begin")
errors = errors + check(sqliteexec(db, "INSERT INTO rollback_values VALUES(9)") = 0, "transaction insert")
errors = errors + check(sqliteexec(db, "ROLLBACK") = 0, "rollback")
statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT count(*) FROM rollback_values", statement) = 0 & sqlitestep(statement) = 100, "rollback count query")
count = -1
errors = errors + check(sqlitecolumnint(statement, 0, count) = 0 & count = 0, "rollback removed row")
errors = errors + check(sqlitefinalize(statement) = 0, "finalize rollback query")

/* FTS5 is required at the boundary. */
errors = errors + check(sqliteexec(db, "CREATE VIRTUAL TABLE search_text USING fts5(body)") = 0, "FTS5 available")
errors = errors + check(sqliteexec(db, "INSERT INTO search_text(body) VALUES('alpha boundary phrase'),('unrelated')") = 0, "FTS5 seed")
statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT rowid FROM search_text WHERE search_text MATCH ?1 ORDER BY rowid", statement) = 0, "FTS5 prepare")
errors = errors + check(sqlitebindtext(statement, 1, "boundary") = 0 & sqlitestep(statement) = 100, "FTS5 match")
fts_row = 0
errors = errors + check(sqlitecolumnint(statement, 0, fts_row) = 0 & fts_row = 1, "FTS5 result")
errors = errors + check(sqlitefinalize(statement) = 0, "FTS5 finalize")

/* Structured errors retain both boundary and SQLite classifications. */
status = sqliteexec(db, "SELECT FROM")
error_code = 0
sqlite_code = 0
operation = ""
message = ""
errors = errors + check(status = -6, "invalid SQL status")
errors = errors + check(sqliteerror(error_code, sqlite_code, operation, message) = -6 & error_code = -6 & sqlite_code > 0 & operation = "exec" & length(message) > 0, "structured SQLite error")
error_json = sqliteerrorjson()
errors = errors + check(pos('"code":-6', error_json) > 0 & pos('"operation":"exec"', error_json) > 0, "structured error JSON")

/* Closing a database invalidates its statements and every handle copy. */
stale_statement = .binary
errors = errors + check(sqliteprepare(db, "SELECT 1", stale_statement) = 0, "prepare stale case")
errors = errors + check(sqliteclose(db) = 0, "close database")
errors = errors + check(sqlitestep(stale_statement) = -3, "closed statement rejected")
errors = errors + check(sqliteexec(db, "SELECT 1") = -3, "closed database rejected")
error_code = 0
sqlite_code = 0
operation = ""
message = ""
errors = errors + check(sqliteerror(error_code, sqlite_code, operation, message) = -3 & operation = "exec", "closed handle structured error")

/* Forced cleanup closes all still-live resources and makes their opaque
 * values safely stale. */
cleanup_db = .binary
cleanup_statement = .binary
errors = errors + check(sqliteopen(":memory:", cleanup_db) = 0, "cleanup open")
errors = errors + check(sqliteprepare(cleanup_db, "SELECT 1", cleanup_statement) = 0, "cleanup prepare")
closed_count = sqlitecleanup()
errors = errors + check(closed_count >= 2, "forced cleanup count")
errors = errors + check(sqlitestep(cleanup_statement) = -3, "forced cleanup statement stale")
errors = errors + check(sqliteexec(cleanup_db, "SELECT 1") = -3, "forced cleanup database stale")

if errors <> 0 then do
  say "P1A_SQLITE_ERRORS=" || errors
  return 1
end

say "P1A_SQLITE_OK typed=null,int64,real,text,blob cursor_rows=3 rollback_rows=0 fts5=1 threadsafe=1 session_affinity=1 large_text_bytes=1100005 stale_rejected=1 cleanup_closed=" || closed_count
return 0
