/* Retained CRI-02 downstream evidence. The exposed/direct variants are
 * controls; production callers use ordinary read-only by-value helpers unless
 * direct access is naturally the simplest hot loop. */
options levelb

import rxfnsb

read_by_value: procedure = .int
  arg data = .binary, offset = .int
  return <at..u32>(offset) data

read_exposed: procedure = .int
  arg expose data = .binary, offset = .int
  return <at..u32>(offset) data

elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

main: procedure = .int
arg argv = .string[]
dimension = 3072
iterations = 10
if argv[0] >= 1 then dimension = argv[1] as .int
if argv[0] >= 2 then iterations = argv[2] as .int

data = .binary
call binresize data, dimension * 4
do i = 1 to dimension
  <at..u32>((i - 1) * 4) data = i
end

by_value_sum = 0
started = time("us")
do iteration = 1 to iterations
  do i = 1 to dimension
    by_value_sum = by_value_sum + read_by_value(data, (i - 1) * 4)
  end
end
by_value_us = elapsed_us(started)

exposed_sum = 0
started = time("us")
do iteration = 1 to iterations
  do i = 1 to dimension
    exposed_sum = exposed_sum + read_exposed(data, (i - 1) * 4)
  end
end
exposed_us = elapsed_us(started)

direct_sum = 0
started = time("us")
do iteration = 1 to iterations
  do i = 1 to dimension
    direct_sum = direct_sum + <at..u32>((i - 1) * 4) data
  end
end
direct_us = elapsed_us(started)

expected = (dimension * (dimension + 1) / 2) * iterations
if by_value_sum \= expected | exposed_sum \= expected | direct_sum \= expected then do
  say "P1A_BINARY_ARGUMENT_PROBE_FAIL=checksum"
  return 1
end
say "P1A_BINARY_ARGUMENT_PROBE variant=by_value elapsed_us=" || by_value_us || " dimension=" || dimension || " iterations=" || iterations
say "P1A_BINARY_ARGUMENT_PROBE variant=exposed elapsed_us=" || exposed_us || " dimension=" || dimension || " iterations=" || iterations
say "P1A_BINARY_ARGUMENT_PROBE variant=direct elapsed_us=" || direct_us || " dimension=" || dimension || " iterations=" || iterations
say "P1A_BINARY_ARGUMENT_PROBE_OK checksum=" || expected
return 0
