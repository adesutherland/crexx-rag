options levelb

import rxfnsb
import rxjson

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P1A_RXJSON_PROJECTION_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
arg args = .string[]
runtime = "unknown"
if args.0 > 0 then runtime = args[1]
errors = 0

document = .jsondocument('{"f32":[0.25,-0.5,0.75],"i64":[-7,0,9223372036854775807],"bad":[1,"two"]}')
root = document.root()
f32_node = document.member(root, "f32")
i64_node = document.member(root, "i64")
errors = errors + check(document.valid() = 1 & document.node_type(root) = "object", "production parse-once document")
errors = errors + check(document.node_count(f32_node) = 3 & document.node_count(i64_node) = 3, "application-owned counts")

f32 = .binary
projection_error = ""
status = document.node_f32_array(f32_node, 3, f32, projection_error)
errors = errors + check(status = 0 & binlength(f32) = 12, "headerless f32 payload")
errors = errors + check(<at..f32>(0) f32 = 0.25 & <at..f32>(4) f32 = -0.5 & <at..f32>(8) f32 = 0.75, "f32 little-endian values")

i64 = .binary
status = document.node_i64_array(i64_node, 3, i64, projection_error)
errors = errors + check(status = 0 & binlength(i64) = 24, "headerless i64 payload")
errors = errors + check(<at..i64>(0) i64 = -7 & <at..i64>(8) i64 = 0 & <at..i64>(16) i64 = 9223372036854775807, "i64 little-endian values")

status = document.node_f32_array(f32_node, 2, f32, projection_error)
errors = errors + check(status = -4 & binlength(f32) = 0 & pos("count mismatch", projection_error) > 0, "count mismatch clears output")
bad_node = document.member(root, "bad")
status = document.node_f32_array(bad_node, 2, f32, projection_error)
errors = errors + check(status = -5 & binlength(f32) = 0 & pos("element 2", projection_error) > 0, "typed element failure")

if errors \= 0 then return 1
say "P1A_RXJSON_PROJECTION_OK runtime=" || runtime || " parser=rxjson type=f32le count=3 dimensions=3 f32_bytes=12 i64_bytes=24 envelope=none"
return 0
