/* Phase-1A durable-item experiment.  Claim, fencing, and promotion semantics
 * remain Level-B cREXX over the generic SQLite mechanism. */
options levelb

namespace job_slice expose jobschema createitem claimitem performwork promoteitem itemstate

import rxfnsb
import sqlite_boundary

jobschema: procedure = .int
  arg db = .binary
  if sqliteexec(db, "CREATE TABLE fence_tokens(token INTEGER PRIMARY KEY AUTOINCREMENT)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE durable_items(item_key TEXT PRIMARY KEY, state TEXT NOT NULL CHECK(state IN('ready','running','done')), fence INTEGER NOT NULL, worker TEXT NOT NULL, input TEXT NOT NULL, output TEXT NOT NULL)") \= 0 then return -1
  if sqliteexec(db, "CREATE TABLE promoted_support(item_key TEXT NOT NULL, support_key TEXT NOT NULL, fence INTEGER NOT NULL, output TEXT NOT NULL, PRIMARY KEY(item_key,support_key))") \= 0 then return -1
  return 0

createitem: procedure = .int
  arg db = .binary, item_key = .string, input = .string
  statement = .binary
  if sqliteprepare(db, "INSERT INTO durable_items(item_key,state,fence,worker,input,output) VALUES(?1,'ready',0,'',?2,'')", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, input
  status = sqlitestep(statement)
  call sqlitefinalize statement
  if status = 101 then return 0
  return -1

claimitem: procedure = .int
  arg db = .binary, item_key = .string, worker = .string, replace_running = 0, expose fence = .int
  fence = 0
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""
  current_fence = 0
  if _job_read(db, item_key, state, current_fence, "") < 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  if state = "done" then do
    call sqliteexec db, "ROLLBACK"
    return -2
  end
  if state = "running" & replace_running = 0 then do
    call sqliteexec db, "ROLLBACK"
    return -3
  end
  if sqliteexec(db, "INSERT INTO fence_tokens DEFAULT VALUES") \= 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  fence = _job_scalar(db, "SELECT last_insert_rowid()")
  if fence <= current_fence then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  statement = .binary
  call sqliteprepare db, "UPDATE durable_items SET state='running',fence=?1,worker=?2,output='' WHERE item_key=?3", statement
  call sqlitebindint statement, 1, fence
  call sqlitebindtext statement, 2, worker
  call sqlitebindtext statement, 3, item_key
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

/* Pure work: the caller invokes this only after claimitem has committed. */
performwork: procedure = .string
  arg input = .string
  return translate(input) || ":COMPLETE"

promoteitem: procedure = .int
  arg db = .binary, item_key = .string, fence = .int, support_key = .string, output = .string
  if sqliteexec(db, "BEGIN IMMEDIATE") \= 0 then return -1
  state = ""
  current_fence = 0
  current_output = ""
  if _job_read(db, item_key, state, current_fence, current_output) < 0 then do
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  if current_fence \= fence then do
    call sqliteexec db, "ROLLBACK"
    return -4
  end
  if state = "done" then do
    existing = _job_support_count(db, item_key, support_key)
    call sqliteexec db, "COMMIT"
    if existing = 1 & current_output = output then return 1
    return -5
  end
  if state \= "running" then do
    call sqliteexec db, "ROLLBACK"
    return -3
  end
  statement = .binary
  call sqliteprepare db, "INSERT OR IGNORE INTO promoted_support(item_key,support_key,fence,output) VALUES(?1,?2,?3,?4)", statement
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, support_key
  call sqlitebindint statement, 3, fence
  call sqlitebindtext statement, 4, output
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement
  statement = .binary
  call sqliteprepare db, "UPDATE durable_items SET state='done',output=?1 WHERE item_key=?2 AND fence=?3 AND state='running'", statement
  call sqlitebindtext statement, 1, output
  call sqlitebindtext statement, 2, item_key
  call sqlitebindint statement, 3, fence
  if sqlitestep(statement) \= 101 then do
    call sqlitefinalize statement
    call sqliteexec db, "ROLLBACK"
    return -1
  end
  call sqlitefinalize statement
  if sqliteexec(db, "COMMIT") \= 0 then return -1
  return 0

itemstate: procedure = .int
  arg db = .binary, item_key = .string, expose state = .string, expose fence = .int, expose output = .string
  return _job_read(db, item_key, state, fence, output)

_job_read: procedure = .int
  arg db = .binary, item_key = .string, expose state = .string, expose fence = .int, expose output = .string
  state = ""; fence = 0; output = ""
  statement = .binary
  if sqliteprepare(db, "SELECT state,fence,output FROM durable_items WHERE item_key=?1", statement) \= 0 then return -1
  call sqlitebindtext statement, 1, item_key
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return -2
  end
  call sqlitecolumntext statement, 0, state
  call sqlitecolumnint statement, 1, fence
  call sqlitecolumntext statement, 2, output
  call sqlitefinalize statement
  return 0

_job_scalar: procedure = .int
  arg db = .binary, sql = .string
  statement = .binary
  if sqliteprepare(db, sql, statement) \= 0 | sqlitestep(statement) \= 100 then return -1
  value = -1
  call sqlitecolumnint statement, 0, value
  call sqlitefinalize statement
  return value

_job_support_count: procedure = .int
  arg db = .binary, item_key = .string, support_key = .string
  statement = .binary
  call sqliteprepare db, "SELECT count(*) FROM promoted_support WHERE item_key=?1 AND support_key=?2", statement
  call sqlitebindtext statement, 1, item_key
  call sqlitebindtext statement, 2, support_key
  if sqlitestep(statement) \= 100 then do
    call sqlitefinalize statement
    return -1
  end
  count = 0
  call sqlitecolumnint statement, 0, count
  call sqlitefinalize statement
  return count
