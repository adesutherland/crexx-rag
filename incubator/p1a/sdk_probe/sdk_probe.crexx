options levelb

import rxfnsb
import sdk_probe

arg args = .string[]
if args.0 < 1 then exit 2
expected_version = args[1]
version = sdkversion()
sum = addints(20, 22)
if version \= expected_version then do
  say "unexpected SDK/runtime version:" version
  exit 1
end
if sum <> 42 then do
  say "unexpected add result:" sum
  exit 1
end
say "SDK_VERSION=" || version
say "SDK_ADD_RESULT=" || sum
exit 0
