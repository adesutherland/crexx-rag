{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Local Debug build using Ninja, matching CLion's preferred generator.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Local Release build using Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Fast development checks",
      "configurePreset": "debug",
      "filter": {
        "include": {
          "label": "^tier-fast$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8,
        "stopOnFailure": true,
        "noTestsAction": "error"
      }
    },
    {
      "name": "fast",
      "inherits": "debug",
      "displayName": "Fast development checks"
    },
    {
      "name": "component",
      "inherits": "debug",
      "displayName": "Component checks (filter by name for iteration)",
      "filter": {
        "include": {
          "label": "^tier-component$"
        }
      }
    },
    {
      "name": "integration",
      "inherits": "debug",
      "displayName": "Additional integration cases",
      "filter": {
        "include": {
          "label": "^tier-integration$"
        }
      }
    },
    {
      "name": "regression",
      "configurePreset": "debug",
      "displayName": "Formal gate: every required case once",
      "output": {
        "outputOnFailure": true,
        "outputLogFile": "${sourceDir}/cmake-build-debug/regression.log"
      },
      "execution": {
        "jobs": 8,
        "stopOnFailure": true,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^tier-(fast|component|integration)$"
        }
      }
    },
    {
      "name": "scale",
      "inherits": "debug",
      "displayName": "Explicit scale and boundary workload checks",
      "filter": {
        "include": {
          "label": "^tier-scale$"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "regression",
      "displayName": "Configure, build and run the full regression gate",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "fast"
        },
        {
          "type": "test",
          "name": "component"
        },
        {
          "type": "test",
          "name": "integration"
        }
      ]
    }
  ]
}
