options levelg
import rxfnsb
import rxjson

/* Run beside crexxrag.conf and library. Compile with crexx --noexec.
   One plan; configured workers; batches of at most batch work attempts.
   One fixed deadline is owned by cREXX-RAG, including planning and corrections.
   Change timing or batch and recompile. Late overnight starts are skipped. */
main: procedure = .int
  timing = "--minutes 30"; batch = 100
  /* Alternatives: --overnight 18:00-06:00 or --until 2026-09-10T06:00:00+01:00 */
  config = run("config explain")
  workers = field(config,"worker_processes") as .int
  items = (batch / workers) as .int
  if items < 1 then return 2
  plan = run("--access plan maintain plan " || timing)
  if field(plan,"disposition") = "skipped" then do; say "Maintenance skipped: outside its time window"; return 0; end
  applied = run("--access curate maintain apply --plan-json " || quoted(field(plan,"canonical_plan")) || " --expect-digest " || quoted(field(plan,"digest")))
  if field(applied,"disposition") = "skipped" then return 0
  job = quoted(field(applied,"job_id"))
  say "Maintenance job:" field(applied,"job_id")
  do forever
    result = run("--access control worker start --max-items " || items || " --job " || job)
    if field(result,"vector_state") \= "pending-work" then leave
  end
  return 0

run: procedure = .jsondocument
  arg command = .string
  lines = .string[]
  address SYSTEM ("crexxrag --format json " || command) output lines
  status = rc
  if status \= 0 then do
    do i = 1 to lines.0; say lines[i]; end
    exit status
  end
  return .jsondocument(lines[1])

field: procedure = .string
  arg document = .jsondocument, name = .string
  records = document.member(document.root(),"records"); value = ""
  do i = 1 to document.node_count(records)
    fields = document.member(document.element(records,i),"fields")
    node = document.member(fields,name)
    if document.node_type(node) = "integer" | document.node_type(node) = "number" then do
      number = 0; ignored = document.node_int(node,number); return number || ""
    end
    if document.node_string(node,value) = 0 then return value
  end
  say "Maintenance response omitted" name
  exit 10

quoted: procedure = .string
  arg value = .string
  return "'" || changestr("'",value,"2722272227"x) || "'"
