    {
      "decision_id": "decision-maintenance:9402de4d414409cf8fc8618983d626e0a48ae8c54d0fac2e6376fb11162311d5",
      "task_id": "task:de11481a7e4919baa4bdef732c53171b14b5f87ca4d2957725943d2d888173d7",
      "item_id": "item-maintenance:99e3ce29eefe750007ce8ee8905b455dbbb3fa43e1ec7ee35703669afe33bca8",
      "provider_run_id": "provider-run-sha256:f9ee41cd5fdcd2ca1db9dcf8a5df323263a373bbf2ea79d694f510dc1832b3c7",
      "response_json": "{\"action\":\"retain\",\"object_id\":\"concept-sha256:15ede89faddd3d5134859f642b2fe83082dd77c956eeef2ffb950acb182bd01a\",\"target_concept_id\":\"\",\"canonical_label\":\"Iter\",\"concept_type\":\"artefact\",\"successors\":[],\"reason\":\"The source describes Iter as a route or itinerary proceeding between geographic stations, supporting the current artefact classification rather than the competing place identity.\",\"evidence\":[{\"evidence_id\":\"mention-sha256:f1b8a96184351b7b1d96f437561a5e7bf59ba5fce52cadd7f7a31c2c724fa159\",\"quote\":\"From the Dee at Peter-Culter, the Iter proceeded on the right of \\nAchlea, Fiddy, and Kinmundy, and from thence in a north-north-west \\ndirection, it went through a plain district, till it reached the site or \\nKintore on the Don, and thence it followed, according to the Roman \\npractice, the strath of the river to the head of the Don, where there \\nis a ford, at the same place where the high road has always passed \\nthe same river to Inver-urie. The Romans then passed the Urie, \\nand pushed on in a north-north-west course, through a moorish district \\nto the sources of the Ithan, the Ztuna of Richard, where the camp of \\nGlen-mailen was placed, an extended course of twenty-six statute \\nmiles between these itinerary stations.\"}],\"effective_from\":\"\",\"effective_to\":\"\",\"qualifiers_json\":\"{}\",\"question\":\"\"}",
      "grounding_json": "[{\"evidence_id\":\"mention-sha256:f1b8a96184351b7b1d96f437561a5e7bf59ba5fce52cadd7f7a31c2c724fa159\",\"revision_chunk_id\":\"occurrence-sha256:82df48c2c0a5939b6d412a439697ecd4ae3ef2fb077977596bf531b51ff5d298\",\"span_start\":0,\"span_end\":726}]",
      "disposition": "retain:resolved",
      "applied_generation": 24926,
      "created_epoch": 1789316864
    },
