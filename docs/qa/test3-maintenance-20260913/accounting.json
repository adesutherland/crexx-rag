      "response_json": "{\"action\":\"retain\",\"object_id\":\"concept-sha256:0dc12170a84f787b5615c536838b046f1247e3d291965199daeee5816d84bb5b\",\"target_concept_id\":\"\",\"canonical_label\":\"Comgal\",\"concept_type\":\"person\",\"successors\":[],\"reason\":\"The source identifies Comgal as the son\u2019s parent, supporting a person classification; no evidence supports changing the concept or splitting it.\",\"evidence\":[{\"evidence_id\":\"mention-sha256:6bb952c88c50deed9127952e758d0beccf5d3463494b57a364a1e4fe3f1be987\",\"quote\":\"Conal, the son of Comgal then succeeded in five hundred and fifty-\"}],\"effective_from\":\"\",\"effective_to\":\"\",\"qualifiers_json\":\"{}\",\"question\":\"\"}",
