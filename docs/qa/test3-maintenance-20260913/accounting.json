  "decisions": [
    {
      "decision_id": "decision-maintenance:f1aaa6c364cea79c0b160ff01cb4d168b4a3ac566a524a3a4d228ed9d273a8e0",
      "task_id": "task:4acddd1f3c91c13e610f4d2fc44c9cba82c94656697370c989768bd5bd4a93cc",
      "item_id": "item-maintenance:07543cb5d81be14f377c95fcd1e60eab7597882548e52a858e42c706674f16a3",
      "provider_run_id": "provider-run-sha256:275f14cf3d21a1afd8bb8f74c46707312620970dd015a02ba5bd66615db0d275",
      "response_json": "{\"action\":\"retain\",\"object_id\":\"concept-sha256:13f6c6b64a8da9e9a2944ccb0327c05ecc5e839034e558f74bd1e3c6b1095d13\",\"target_concept_id\":\"\",\"canonical_label\":\"Ogilvie\",\"concept_type\":\"person\",\"successors\":[],\"reason\":\"The supplied passages consistently use Ogilvie as a person: a lord issuing a commission, a named executed individual, and one of the lords joining Charles. No supplied passage supports reclassifying this concept as a place.\",\"evidence\":[{\"evidence_id\":\"mention-sha256:63e52f6181d33331f6b3038a4a18817fc1b565793116898cbca3ce733c186688\",\"quote\":\"my \\nlord  Ogilvie  having  his  Royal  Highness\u2019s  approbation,  gave  me  a commission\"},{\"evidence_id\":\"mention-sha256:9eeb946099cd766256e79e694e8a6710c40fd7a9ab079036746af4352d1c0527\",\"quote\":\"Execution of Sirs William Rollock, and Philip Nisbet, and Ogilvie, younger of Inverquharity\"},{\"evidence_id\":\"mention-sha256:c2e26813ec54bfc02d4d42902f8f0f903ae751f9847c44b64695ca73139157b7\",\"quote\":\"At  Perth,  Charles  was  joined  by  the  duke  of  Perth,  the  lords  Ogilvie  and  Strathallan\"},{\"evidence_id\":\"mention-sha256:c7707e840f821594cbe0bcef2de0dbbe6edcf02b573fb252debb7f2d409e3967\",\"quote\":\"the execution of Nisbet and Ogilvie, was heard to utter this  barbarous expression\"}],\"effective_from\":\"\",\"effective_to\":\"\",\"qualifiers_json\":\"{}\",\"question\":\"\"}",
      "grounding_json": "[{\"evidence_id\":\"mention-sha256:63e52f6181d33331f6b3038a4a18817fc1b565793116898cbca3ce733c186688\",\"revision_chunk_id\":\"occurrence-sha256:cbd7654e9142a8e96c29932091bbf51b0e1654c787c30203f170131cb0db62b3\",\"span_start\":257,\"span_end\":346},{\"evidence_id\":\"mention-sha256:9eeb946099cd766256e79e694e8a6710c40fd7a9ab079036746af4352d1c0527\",\"revision_chunk_id\":\"occurrence-sha256:5872b66ac3aed48df678dd4d338bf40e731cca962f9e5017d0322d35e0465f09\",\"span_start\":183,\"span_end\":275},{\"evidence_id\":\"mention-sha256:c2e26813ec54bfc02d4d42902f8f0f903ae751f9847c44b64695ca73139157b7\",\"revision_chunk_id\":\"occurrence-sha256:d0000710f697cc904357c8e55bef63f1909388fa2b62bb4b72a558ed04a3510b\",\"span_start\":0,\"span_end\":98},{\"evidence_id\":\"mention-sha256:c7707e840f821594cbe0bcef2de0dbbe6edcf02b573fb252debb7f2d409e3967\",\"revision_chunk_id\":\"occurrence-sha256:5807ba540bf9a54d2243d6086a6e102f6e46776cf4546ef3d58312b2a92ac4ff\",\"span_start\":1019,\"span_end\":1101}]",
      "disposition": "retain:resolved",
