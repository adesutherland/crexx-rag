options levelg

import rxfnsb
import rag_address_environment

main: procedure = .int
  arg args = .string[]
  status_lines = .string[]; evidence_lines = .string[]; close_lines = .string[]
  address RAG 'LIBRARY OPEN ./library --config-file ./crexx-rag.conf --profile it-architecture-profile --access read --format json'
  if rc \= 0 then return rc
  address RAG 'LIBRARY STATUS' output status_lines
  if rc \= 0 then return rc
  address RAG 'QUERY EVIDENCE "What does BillingService depend on?" --mode lexical' output evidence_lines
  if rc \= 0 then return rc
  address RAG 'LIBRARY CLOSE' output close_lines
  if rc \= 0 then return rc
  do i = 1 to status_lines.0; say status_lines[i]; end
  do i = 1 to evidence_lines.0; say evidence_lines[i]; end
  return 0
