options levelg

namespace ragcanonical expose ragsha256 canonicalconfig canonicalsemanticconfig canonicaloperationalconfig canonicalprofile canonicalproviderroute

import rxfnsb
import rxjson
import rxhash
import ragconfig
import ragprofile

ragsha256: procedure = .string
  arg value = .string
  return lower(bin2x(rxhash..sha256(value)))

canonicalconfig: procedure = .string
  arg config = .ragconfig
  output = "{" || jsonquote("config_id") || ":" || jsonquote(config.config_id()) || "," || jsonquote("version") || ":" || jsonquote(config.version())
  output = output || "," || jsonquote("plan_ttl_seconds") || ":" || config.plan_ttl_seconds()
  output = output || "," || jsonquote("source_sets") || ":["
  source_sets = config.source_sets()
  do i = 1 to source_sets.0
    if i > 1 then output = output || ","
    source = source_sets[i]; patterns = source.include_patterns()
    output = output || "{" || jsonquote("id") || ":" || jsonquote(source.source_set_id()) || "," || jsonquote("connector") || ":" || jsonquote(source.connector()) || "," || jsonquote("root") || ":" || jsonquote(source.root()) || "," || jsonquote("stable_key") || ":" || jsonquote(source.stable_key()) || "," || jsonquote("privacy") || ":" || jsonquote(source.privacy()) || "," || jsonquote("retain_raw_artifact") || ":" || _boolean(source.retain_raw_artifact()) || "," || jsonquote("include_patterns") || ":["
    do j = 1 to patterns.0
      if j > 1 then output = output || ","
      output = output || jsonquote(patterns[j])
    end
    output = output || "]," || jsonquote("maximum_file_bytes") || ":" || source.maximum_file_bytes() || "," || jsonquote("maximum_depth") || ":" || source.maximum_depth() || "}"
  end
  output = output || "]," || jsonquote("providers") || ":["
  providers = config.providers()
  do i = 1 to providers.0
    if i > 1 then output = output || ","
    provider = providers[i]
    output = output || "{" || jsonquote("id") || ":" || jsonquote(provider.provider_id()) || "," || jsonquote("kind") || ":" || jsonquote(provider.kind()) || "," || jsonquote("base_url") || ":" || jsonquote(provider.base_url()) || "," || jsonquote("model") || ":" || jsonquote(provider.model()) || "," || jsonquote("route_class") || ":" || jsonquote(provider.route_class()) || "," || jsonquote("privacy_policy") || ":" || jsonquote(provider.privacy_policy()) || "," || jsonquote("charging_basis") || ":" || jsonquote(provider.charging_basis()) || "," || jsonquote("credential_ref") || ":" || jsonquote(provider.credential().ref_string()) || "," || jsonquote("timeout_ms") || ":" || provider.timeout_ms() || "," || jsonquote("max_attempts") || ":" || provider.max_attempts() || "," || jsonquote("requests_per_minute") || ":" || provider.requests_per_minute() || "," || jsonquote("tokens_per_minute") || ":" || provider.tokens_per_minute() || "," || jsonquote("concurrent_requests") || ":" || provider.concurrent_requests() || "," || jsonquote("initial_backoff_ms") || ":" || provider.initial_backoff_ms() || "," || jsonquote("maximum_backoff_ms") || ":" || provider.maximum_backoff_ms() || "," || jsonquote("jitter_ms") || ":" || provider.jitter_ms() || "," || jsonquote("context_tokens") || ":" || provider.context_tokens() || "," || jsonquote("maximum_output_tokens") || ":" || provider.maximum_output_tokens() || "," || jsonquote("embedding_dimensions_minimum") || ":" || provider.embedding_dimensions_minimum() || "," || jsonquote("embedding_dimensions_maximum") || ":" || provider.embedding_dimensions_maximum() || "," || jsonquote("maximum_batch_size") || ":" || provider.maximum_batch_size() || "," || jsonquote("input_price_microunits_per_million") || ":" || provider.input_price_microunits_per_million() || "," || jsonquote("output_price_microunits_per_million") || ":" || provider.output_price_microunits_per_million() || "," || jsonquote("catalog_observed_date") || ":" || jsonquote(provider.catalog_observed_date())
    if provider.reasoning_effort() \= "" then output = output || "," || jsonquote("reasoning_effort") || ":" || jsonquote(provider.reasoning_effort())
    output = output || "}"
  end
  output = output || "]," || jsonquote("roles") || ":["
  roles = config.roles()
  do i = 1 to roles.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("role") || ":" || jsonquote(roles[i].role()) || "," || jsonquote("provider_id") || ":" || jsonquote(roles[i].provider_id()) || "," || jsonquote("maximum_input_tokens") || ":" || roles[i].maximum_input_tokens() || "," || jsonquote("maximum_output_tokens") || ":" || roles[i].maximum_output_tokens() || "," || jsonquote("maximum_call_cost_microunits") || ":" || roles[i].maximum_call_cost_microunits() || "," || jsonquote("embedding_dimensions") || ":" || roles[i].embedding_dimensions() || "," || jsonquote("batch_size") || ":" || roles[i].batch_size() || "," || jsonquote("temperature_millionths") || ":" || roles[i].temperature_millionths() || "," || jsonquote("system_prompt") || ":" || jsonquote(roles[i].system_prompt()) || "}"
  end
  output = output || "]," || jsonquote("profile_ids") || ":["
  ids = config.profile_ids()
  do i = 1 to ids.0
    if i > 1 then output = output || ","
    output = output || jsonquote(ids[i])
  end
  output = output || "]," || jsonquote("profile_files") || ":["
  profile_files = config.profile_files()
  do i = 1 to profile_files.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("profile_id") || ":" || jsonquote(profile_files[i].profile_id()) || "," || jsonquote("path") || ":" || jsonquote(profile_files[i].path()) || "}"
  end
  budget = config.budget(); workers = config.workers()
  output = output || "]," || jsonquote("budget") || ":{" || jsonquote("minutes") || ":" || budget.minutes() || "," || jsonquote("item_limit") || ":" || budget.item_limit() || "," || jsonquote("model_calls") || ":" || budget.model_calls() || "," || jsonquote("input_tokens") || ":" || budget.input_tokens() || "," || jsonquote("output_tokens") || ":" || budget.output_tokens() || "," || jsonquote("cost_microunits") || ":" || budget.cost_microunits() || "," || jsonquote("codex_turns") || ":" || budget.codex_turns() || "," || jsonquote("minimum_codex_allowance_percent") || ":" || budget.minimum_codex_allowance_percent() || "}"
  output = output || "," || jsonquote("workers") || ":{" || jsonquote("processes") || ":" || workers.processes() || "," || jsonquote("max_in_flight") || ":" || workers.max_in_flight() || "," || jsonquote("lease_seconds") || ":" || workers.lease_seconds() || "," || jsonquote("poll_ms") || ":" || workers.poll_ms() || "," || jsonquote("guided_deadline_seconds") || ":" || workers.guided_deadline_seconds() || "}"
  discovery = config.discovery(); vector = config.vector(); retrieval = config.retrieval(); maintenance = config.maintenance(); observation = config.observation()
  output = output || "," || jsonquote("discovery") || ":{" || jsonquote("mode") || ":" || jsonquote(discovery.mode()) || "," || jsonquote("glossary_file") || ":" || jsonquote(discovery.glossary_path()) || "," || jsonquote("ranked_limit") || ":" || discovery.ranked_limit() || "," || jsonquote("max_mentions") || ":" || discovery.max_mentions() || "," || jsonquote("max_relationships") || ":" || discovery.max_relationships() || "," || jsonquote("max_notes") || ":" || discovery.max_notes() || "}"
  output = output || "," || jsonquote("vector") || ":{" || jsonquote("algorithm") || ":" || jsonquote(vector.algorithm()) || "," || jsonquote("centroids") || ":" || vector.centroids() || "," || jsonquote("probes") || ":" || vector.probes() || "," || jsonquote("iterations") || ":" || vector.iterations() || "," || jsonquote("recall_minimum_millionths") || ":" || vector.recall_minimum_millionths() || "," || jsonquote("maximum_rows") || ":" || vector.maximum_rows() || "," || jsonquote("maximum_sidecar_bytes") || ":" || vector.maximum_sidecar_bytes() || "," || jsonquote("embedding_maximum_items") || ":" || vector.embedding_maximum_items() || "}"
  output = output || "," || jsonquote("retrieval") || ":{" || jsonquote("lexical_candidates") || ":" || retrieval.lexical_candidates() || "," || jsonquote("vector_candidates") || ":" || retrieval.vector_candidates() || "," || jsonquote("vector_scan_limit") || ":" || retrieval.vector_scan_limit() || "," || jsonquote("graph_hops") || ":" || retrieval.graph_hops() || "," || jsonquote("passage_limit") || ":" || retrieval.passage_limit() || "," || jsonquote("claim_limit") || ":" || retrieval.claim_limit() || "," || jsonquote("lead_limit") || ":" || retrieval.lead_limit() || "," || jsonquote("rrf_k") || ":" || retrieval.rrf_k() || "," || jsonquote("graph_boost_millionths") || ":" || retrieval.graph_boost_millionths() || "," || jsonquote("graph_decay_millionths") || ":" || retrieval.graph_decay_millionths() || "," || jsonquote("directness_bonus_millionths") || ":" || retrieval.directness_bonus_millionths() || "," || jsonquote("graph_direction") || ":" || jsonquote(retrieval.graph_direction()) || "," || jsonquote("maximum_evidence_bytes") || ":" || retrieval.maximum_evidence_bytes() || "}"
  output = output || "," || jsonquote("maintenance") || ":{" || jsonquote("sparse_max_degree") || ":" || maintenance.sparse_max_degree() || "," || jsonquote("query_gap_min_occurrences") || ":" || maintenance.query_gap_min_occurrences() || "," || jsonquote("batch_items") || ":" || maintenance.batch_items() || "," || jsonquote("mode") || ":" || jsonquote(maintenance.mode()) || "," || jsonquote("window_seconds") || ":" || maintenance.window_seconds() || "," || jsonquote("automatic_actions") || ":" || jsonquote(maintenance.automatic_actions()) || "," || jsonquote("maximum_impact") || ":" || maintenance.maximum_impact() || "," || jsonquote("maximum_attempts") || ":" || maintenance.maximum_attempts() || "," || jsonquote("retry_seconds") || ":" || maintenance.retry_seconds() || "," || jsonquote("maximum_evidence_bytes") || ":" || maintenance.maximum_evidence_bytes() || "," || jsonquote("resolution_prompt") || ":" || jsonquote(maintenance.resolution_prompt()) || "}"
  output = output || "," || jsonquote("observation") || ":{" || jsonquote("capture_threshold") || ":" || observation.capture_threshold() || "," || jsonquote("cooldown_seconds") || ":" || observation.cooldown_seconds() || "," || jsonquote("maximum_staleness_seconds") || ":" || observation.maximum_staleness_seconds() || "," || jsonquote("work_minimum_change") || ":" || observation.work_minimum_change() || "," || jsonquote("work_relative_millionths") || ":" || observation.work_relative_millionths() || "," || jsonquote("dead_letter_minimum_change") || ":" || observation.dead_letter_minimum_change() || "," || jsonquote("review_minimum_change") || ":" || observation.review_minimum_change() || "," || jsonquote("narrative_output_tokens") || ":" || observation.narrative_output_tokens() || "}"
  output = output || "," || jsonquote("schedules") || ":["
  schedules = config.schedules()
  do i = 1 to schedules.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("id") || ":" || jsonquote(schedules[i].schedule_id()) || "," || jsonquote("operation") || ":" || jsonquote(schedules[i].operation()) || "," || jsonquote("trigger") || ":" || jsonquote(schedules[i].trigger()) || "," || jsonquote("enabled") || ":" || _boolean(schedules[i].enabled()) || "}"
  end
  output = output || "]}"
  return output

/* Semantic identity records the policy for subsequent work, without rewriting
 * existing evidence or requiring corpus re-ingestion. Runtime ceilings,
 * retry timing, worker topology, schedules, and rebuildable ANN tuning are
 * deliberately excluded. */
canonicalsemanticconfig: procedure = .string
  arg config = .ragconfig
  output = "{" || jsonquote("schema") || ":" || jsonquote("crexx-rag.semantic-config/1") || "," || jsonquote("config_id") || ":" || jsonquote(config.config_id()) || "," || jsonquote("source_sets") || ":["
  sources = config.source_sets()
  do i = 1 to sources.0
    if i > 1 then output = output || ","
    source = sources[i]; patterns = source.include_patterns()
    output = output || "{" || jsonquote("id") || ":" || jsonquote(source.source_set_id()) || "," || jsonquote("connector") || ":" || jsonquote(source.connector()) || "," || jsonquote("root") || ":" || jsonquote(source.root()) || "," || jsonquote("stable_key") || ":" || jsonquote(source.stable_key()) || "," || jsonquote("privacy") || ":" || jsonquote(source.privacy()) || "," || jsonquote("retain_raw_artifact") || ":" || _boolean(source.retain_raw_artifact()) || "," || jsonquote("include_patterns") || ":["
    do j = 1 to patterns.0
      if j > 1 then output = output || ","
      output = output || jsonquote(patterns[j])
    end
    output = output || "]}"
  end
  output = output || "]," || jsonquote("providers") || ":["
  providers = config.providers()
  do i = 1 to providers.0
    if i > 1 then output = output || ","
    provider = providers[i]
    output = output || "{" || jsonquote("id") || ":" || jsonquote(provider.provider_id()) || "," || jsonquote("kind") || ":" || jsonquote(provider.kind()) || "," || jsonquote("base_url") || ":" || jsonquote(provider.base_url()) || "," || jsonquote("model") || ":" || jsonquote(provider.model()) || "," || jsonquote("route_class") || ":" || jsonquote(provider.route_class()) || "," || jsonquote("privacy_policy") || ":" || jsonquote(provider.privacy_policy()) || "," || jsonquote("credential_ref") || ":" || jsonquote(provider.credential().ref_string()) || "," || jsonquote("context_tokens") || ":" || provider.context_tokens() || "," || jsonquote("maximum_output_tokens") || ":" || provider.maximum_output_tokens() || "," || jsonquote("embedding_dimensions_minimum") || ":" || provider.embedding_dimensions_minimum() || "," || jsonquote("embedding_dimensions_maximum") || ":" || provider.embedding_dimensions_maximum()
    if provider.reasoning_effort() \= "" then output = output || "," || jsonquote("reasoning_effort") || ":" || jsonquote(provider.reasoning_effort())
    output = output || "}"
  end
  output = output || "]," || jsonquote("roles") || ":["
  roles = config.roles()
  do i = 1 to roles.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("role") || ":" || jsonquote(roles[i].role()) || "," || jsonquote("provider_id") || ":" || jsonquote(roles[i].provider_id()) || "," || jsonquote("maximum_input_tokens") || ":" || roles[i].maximum_input_tokens() || "," || jsonquote("maximum_output_tokens") || ":" || roles[i].maximum_output_tokens() || "," || jsonquote("embedding_dimensions") || ":" || roles[i].embedding_dimensions() || "," || jsonquote("temperature_millionths") || ":" || roles[i].temperature_millionths() || "," || jsonquote("system_prompt") || ":" || jsonquote(roles[i].system_prompt()) || "}"
  end
  output = output || "]," || jsonquote("profile_ids") || ":["
  profiles = config.profile_ids()
  do i = 1 to profiles.0
    if i > 1 then output = output || ","
    output = output || jsonquote(profiles[i])
  end
  discovery = config.discovery()
  output = output || "]," || jsonquote("discovery") || ":{" || jsonquote("mode") || ":" || jsonquote(discovery.mode()) || "," || jsonquote("glossary_file") || ":" || jsonquote(discovery.glossary_path()) || "," || jsonquote("ranked_limit") || ":" || discovery.ranked_limit() || "," || jsonquote("max_mentions") || ":" || discovery.max_mentions() || "," || jsonquote("max_relationships") || ":" || discovery.max_relationships() || "," || jsonquote("max_notes") || ":" || discovery.max_notes() || "}}"
  return output

canonicaloperationalconfig: procedure = .string
  arg config = .ragconfig
  output = "{" || jsonquote("schema") || ":" || jsonquote("crexx-rag.operational-config/1") || "," || jsonquote("config_id") || ":" || jsonquote(config.config_id()) || "," || jsonquote("version") || ":" || jsonquote(config.version()) || "," || jsonquote("providers") || ":["
  providers = config.providers()
  do i = 1 to providers.0
    if i > 1 then output = output || ","
    provider = providers[i]
    output = output || "{" || jsonquote("id") || ":" || jsonquote(provider.provider_id()) || "," || jsonquote("timeout_ms") || ":" || provider.timeout_ms() || "," || jsonquote("max_attempts") || ":" || provider.max_attempts() || "," || jsonquote("requests_per_minute") || ":" || provider.requests_per_minute() || "," || jsonquote("tokens_per_minute") || ":" || provider.tokens_per_minute() || "," || jsonquote("concurrent_requests") || ":" || provider.concurrent_requests() || "," || jsonquote("initial_backoff_ms") || ":" || provider.initial_backoff_ms() || "," || jsonquote("maximum_backoff_ms") || ":" || provider.maximum_backoff_ms() || "," || jsonquote("jitter_ms") || ":" || provider.jitter_ms() || "," || jsonquote("maximum_batch_size") || ":" || provider.maximum_batch_size() || "," || jsonquote("input_price_microunits_per_million") || ":" || provider.input_price_microunits_per_million() || "," || jsonquote("output_price_microunits_per_million") || ":" || provider.output_price_microunits_per_million() || "," || jsonquote("catalog_observed_date") || ":" || jsonquote(provider.catalog_observed_date()) || "}"
  end
  output = output || "]," || jsonquote("roles") || ":["
  roles = config.roles()
  do i = 1 to roles.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("role") || ":" || jsonquote(roles[i].role()) || "," || jsonquote("provider_id") || ":" || jsonquote(roles[i].provider_id()) || "," || jsonquote("maximum_call_cost_microunits") || ":" || roles[i].maximum_call_cost_microunits() || "," || jsonquote("batch_size") || ":" || roles[i].batch_size() || "}"
  end
  budget = config.budget(); workers = config.workers(); vector = config.vector(); retrieval = config.retrieval(); maintenance = config.maintenance(); observation = config.observation()
  output = output || "]," || jsonquote("budget") || ":{" || jsonquote("minutes") || ":" || budget.minutes() || "," || jsonquote("item_limit") || ":" || budget.item_limit() || "," || jsonquote("model_calls") || ":" || budget.model_calls() || "," || jsonquote("input_tokens") || ":" || budget.input_tokens() || "," || jsonquote("output_tokens") || ":" || budget.output_tokens() || "," || jsonquote("cost_microunits") || ":" || budget.cost_microunits() || "," || jsonquote("codex_turns") || ":" || budget.codex_turns() || "," || jsonquote("minimum_codex_allowance_percent") || ":" || budget.minimum_codex_allowance_percent() || "}"
  output = output || "," || jsonquote("workers") || ":{" || jsonquote("processes") || ":" || workers.processes() || "," || jsonquote("max_in_flight") || ":" || workers.max_in_flight() || "," || jsonquote("lease_seconds") || ":" || workers.lease_seconds() || "," || jsonquote("poll_ms") || ":" || workers.poll_ms() || "," || jsonquote("guided_deadline_seconds") || ":" || workers.guided_deadline_seconds() || "}"
  output = output || "," || jsonquote("vector") || ":{" || jsonquote("algorithm") || ":" || jsonquote(vector.algorithm()) || "," || jsonquote("centroids") || ":" || vector.centroids() || "," || jsonquote("probes") || ":" || vector.probes() || "," || jsonquote("iterations") || ":" || vector.iterations() || "," || jsonquote("recall_minimum_millionths") || ":" || vector.recall_minimum_millionths() || "," || jsonquote("maximum_rows") || ":" || vector.maximum_rows() || "," || jsonquote("maximum_sidecar_bytes") || ":" || vector.maximum_sidecar_bytes() || "," || jsonquote("embedding_maximum_items") || ":" || vector.embedding_maximum_items() || "}"
  output = output || "," || jsonquote("retrieval") || ":{" || jsonquote("lexical_candidates") || ":" || retrieval.lexical_candidates() || "," || jsonquote("vector_candidates") || ":" || retrieval.vector_candidates() || "," || jsonquote("vector_scan_limit") || ":" || retrieval.vector_scan_limit() || "," || jsonquote("graph_hops") || ":" || retrieval.graph_hops() || "," || jsonquote("passage_limit") || ":" || retrieval.passage_limit() || "," || jsonquote("claim_limit") || ":" || retrieval.claim_limit() || "," || jsonquote("lead_limit") || ":" || retrieval.lead_limit() || "," || jsonquote("rrf_k") || ":" || retrieval.rrf_k() || "," || jsonquote("graph_boost_millionths") || ":" || retrieval.graph_boost_millionths() || "," || jsonquote("graph_decay_millionths") || ":" || retrieval.graph_decay_millionths() || "," || jsonquote("directness_bonus_millionths") || ":" || retrieval.directness_bonus_millionths() || "," || jsonquote("graph_direction") || ":" || jsonquote(retrieval.graph_direction()) || "," || jsonquote("maximum_evidence_bytes") || ":" || retrieval.maximum_evidence_bytes() || "}"
  output = output || "," || jsonquote("maintenance") || ":{" || jsonquote("sparse_max_degree") || ":" || maintenance.sparse_max_degree() || "," || jsonquote("query_gap_min_occurrences") || ":" || maintenance.query_gap_min_occurrences() || "," || jsonquote("batch_items") || ":" || maintenance.batch_items() || "," || jsonquote("mode") || ":" || jsonquote(maintenance.mode()) || "," || jsonquote("window_seconds") || ":" || maintenance.window_seconds() || "," || jsonquote("automatic_actions") || ":" || jsonquote(maintenance.automatic_actions()) || "," || jsonquote("maximum_impact") || ":" || maintenance.maximum_impact() || "," || jsonquote("maximum_attempts") || ":" || maintenance.maximum_attempts() || "," || jsonquote("retry_seconds") || ":" || maintenance.retry_seconds() || "," || jsonquote("maximum_evidence_bytes") || ":" || maintenance.maximum_evidence_bytes() || "," || jsonquote("resolution_prompt") || ":" || jsonquote(maintenance.resolution_prompt()) || "}"
  output = output || "," || jsonquote("observation") || ":{" || jsonquote("capture_threshold") || ":" || observation.capture_threshold() || "," || jsonquote("cooldown_seconds") || ":" || observation.cooldown_seconds() || "," || jsonquote("maximum_staleness_seconds") || ":" || observation.maximum_staleness_seconds() || "," || jsonquote("work_minimum_change") || ":" || observation.work_minimum_change() || "," || jsonquote("work_relative_millionths") || ":" || observation.work_relative_millionths() || "," || jsonquote("dead_letter_minimum_change") || ":" || observation.dead_letter_minimum_change() || "," || jsonquote("review_minimum_change") || ":" || observation.review_minimum_change() || "," || jsonquote("narrative_output_tokens") || ":" || observation.narrative_output_tokens() || "}"
  output = output || "," || jsonquote("schedules") || ":["
  schedules = config.schedules()
  do i = 1 to schedules.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("id") || ":" || jsonquote(schedules[i].schedule_id()) || "," || jsonquote("operation") || ":" || jsonquote(schedules[i].operation()) || "," || jsonquote("trigger") || ":" || jsonquote(schedules[i].trigger()) || "," || jsonquote("enabled") || ":" || _boolean(schedules[i].enabled()) || "}"
  end
  output = output || "]," || jsonquote("plan_ttl_seconds") || ":" || config.plan_ttl_seconds() || "," || jsonquote("source_limits") || ":["
  sources = config.source_sets()
  do i = 1 to sources.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("id") || ":" || jsonquote(sources[i].source_set_id()) || "," || jsonquote("maximum_file_bytes") || ":" || sources[i].maximum_file_bytes() || "," || jsonquote("maximum_depth") || ":" || sources[i].maximum_depth() || "}"
  end
  return output || "]}"

canonicalprofile: procedure = .string
  arg profile = .ragprofile
  output = "{" || jsonquote("profile_id") || ":" || jsonquote(profile.profile_id()) || "," || jsonquote("version") || ":" || jsonquote(profile.version())
  output = output || "," || jsonquote("concept_types") || ":["
  values = profile.concept_types()
  do i = 1 to values.0
    if i > 1 then output = output || ","
    output = output || jsonquote(values[i])
  end
  output = output || "]," || jsonquote("relationship_types") || ":["
  relationships = profile.relationship_types()
  do i = 1 to relationships.0
    if i > 1 then output = output || ","
    relationship = relationships[i]
    output = output || "{" || jsonquote("id") || ":" || jsonquote(relationship.relationship_id()) || "," || jsonquote("inverse_id") || ":" || jsonquote(relationship.inverse_id()) || "," || jsonquote("directional") || ":" || _boolean(relationship.directional()) || "}"
  end
  output = output || "]," || jsonquote("aliases") || ":["
  aliases = profile.aliases()
  do i = 1 to aliases.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("surface") || ":" || jsonquote(aliases[i].surface()) || "," || jsonquote("canonical") || ":" || jsonquote(aliases[i].canonical()) || "}"
  end
  chunk = profile.chunk_policy(); formats = chunk.formats()
  output = output || "]," || jsonquote("chunk_policy") || ":{" || jsonquote("max_characters") || ":" || chunk.max_characters() || "," || jsonquote("overlap_characters") || ":" || chunk.overlap_characters() || "," || jsonquote("formats") || ":["
  do i = 1 to formats.0
    if i > 1 then output = output || ","
    output = output || jsonquote(formats[i])
  end
  output = output || "]}," || jsonquote("ranking_weights") || ":["
  weights = profile.ranking_weights()
  do i = 1 to weights.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("name") || ":" || jsonquote(weights[i].name()) || "," || jsonquote("value") || ":" || weights[i].value() || "}"
  end
  output = output || "]," || jsonquote("prompts") || ":["
  prompts = profile.prompts()
  do i = 1 to prompts.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("role") || ":" || jsonquote(prompts[i].role()) || "," || jsonquote("version") || ":" || jsonquote(prompts[i].version()) || "," || jsonquote("template_id") || ":" || jsonquote(prompts[i].template_id()) || "}"
  end
  output = output || "]," || jsonquote("validators") || ":["
  validators = profile.validators()
  do i = 1 to validators.0
    if i > 1 then output = output || ","
    output = output || jsonquote(validators[i])
  end
  output = output || "]}"
  return output

canonicalproviderroute: procedure = .string
  arg config = .ragconfig
  output = "{" || jsonquote("providers") || ":["
  providers = config.providers()
  do i = 1 to providers.0
    if i > 1 then output = output || ","
    provider = providers[i]
    output = output || "{" || jsonquote("id") || ":" || jsonquote(provider.provider_id()) || "," || jsonquote("route_class") || ":" || jsonquote(provider.route_class()) || "," || jsonquote("privacy_policy") || ":" || jsonquote(provider.privacy_policy()) || "," || jsonquote("charging_basis") || ":" || jsonquote(provider.charging_basis()) || "}"
  end
  output = output || "]," || jsonquote("roles") || ":["
  roles = config.roles()
  do i = 1 to roles.0
    if i > 1 then output = output || ","
    output = output || "{" || jsonquote("role") || ":" || jsonquote(roles[i].role()) || "," || jsonquote("provider_id") || ":" || jsonquote(roles[i].provider_id()) || "}"
  end
  output = output || "]}"
  return output

_boolean: procedure = .string
  arg value = .int
  if value = 1 then return "true"
  return "false"
