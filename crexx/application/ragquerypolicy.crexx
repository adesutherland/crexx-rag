options levelg

namespace ragquerypolicy expose queryrouteallowed querypreflight queryansweroutputlimit queryanswercontextlimit queryusagewithin queryprivacy

import ragconfig
import ragadmission
import provider_contract
import provider_catalog

/* Query calls are intentionally governed as one bounded command.  Keeping
 * this policy separate makes every ceiling independently testable without an
 * endpoint, while the dispatcher remains responsible for library snapshots
 * and evidence validation. */
queryrouteallowed: procedure = .int
  arg provider = .ragproviderconfig, privacy = .string
  /* The operator selects the provider. Source privacy is retained metadata,
   * not an additional application veto on that configured route. */
  if provider.provider_id() = "" then return 0
  return 1

querypreflight: procedure = .int
  arg budget = .ragbudget, embedding_provider = .ragproviderconfig, embedding_planned = .int, answer_provider = .ragproviderconfig, answer_planned = .int, expose error = .string, requested_output_tokens = 0, embedding_maximum_input_tokens = 65536, answer_maximum_input_tokens = 65536
  error = ""; planned_calls = embedding_planned + answer_planned
  if aggregatefits(budget.model_calls(),0,planned_calls,budget.zero_unlimited())=0 then do; error = "query provider calls exceed the configured per-command ceiling"; return -1; end
  if embedding_planned = 1 & (embedding_provider.timeout_ms() < 1 | embedding_provider.max_attempts() < 1) then do; error = "query embedding timeout or retry policy is invalid"; return -1; end
  if answer_planned = 1 & (answer_provider.timeout_ms() < 1 | answer_provider.max_attempts() < 1) then do; error = "query answer timeout or retry policy is invalid"; return -1; end
  if answer_planned = 1 & answer_provider.kind() = "codex" & aggregatefits(budget.codex_turns(),0,1,budget.zero_unlimited())=0 then do; error = "query answer exceeds the configured Codex turn ceiling"; return -1; end
  monetary_routes = _monetary(embedding_provider, embedding_planned) + _monetary(answer_provider, answer_planned)
  if monetary_routes > 0 & aggregatefits(budget.cost_microunits(),0,1,budget.zero_unlimited())=0 then do; error = "monetary query providers require a positive configured cost ceiling"; return -1; end
  if planned_calls > 0 & aggregatefits(budget.input_tokens(),0,1,budget.zero_unlimited())=0 then do; error = "query providers require a positive configured input-token ceiling"; return -1; end
  if answer_planned = 1 & aggregatefits(budget.output_tokens(),0,1,budget.zero_unlimited())=0 then do; error = "query answer requires a positive configured output-token ceiling"; return -1; end
  maximum_input = 0
  input_cap=embedding_maximum_input_tokens; if answer_maximum_input_tokens>input_cap then input_cap=answer_maximum_input_tokens
  if planned_calls > 0 then maximum_input = aggregatecap(budget.input_tokens(),input_cap,planned_calls,budget.zero_unlimited())
  embedding_input = maximum_input; if embedding_input > embedding_maximum_input_tokens then embedding_input = embedding_maximum_input_tokens
  answer_input = maximum_input; if answer_input > answer_maximum_input_tokens then answer_input = answer_maximum_input_tokens
  maximum_output = queryansweroutputlimit(budget)
  if requested_output_tokens > 0 then maximum_output = requested_output_tokens
  if aggregatefits(budget.output_tokens(),0,maximum_output,budget.zero_unlimited())=0 then do; error = "requested provider output exceeds the configured output-token ceiling"; return -1; end
  maximum_cost = 0
  if embedding_planned = 1 & embedding_provider.charging_basis() = "monetary-api" then do
    route_cost = _configuredcost(embedding_provider, embedding_input, 0)
    if route_cost < 0 then do; error = "query embedding monetary pricing is unavailable"; return -1; end
    maximum_cost = maximum_cost + route_cost * embedding_provider.max_attempts()
  end
  if answer_planned = 1 & answer_provider.charging_basis() = "monetary-api" then do
    route_cost = _configuredcost(answer_provider, answer_input, maximum_output)
    if route_cost < 0 then do; error = "query answer monetary pricing is unavailable"; return -1; end
    maximum_cost = maximum_cost + route_cost * answer_provider.max_attempts()
  end
  if aggregatefits(budget.cost_microunits(),0,maximum_cost,budget.zero_unlimited())=0 then do; error = "worst-case query monetary usage exceeds the configured cost ceiling"; return -1; end
  return 0

queryansweroutputlimit: procedure = .int
  arg budget = .ragbudget, configured_maximum = 1024
  maximum = budget.output_tokens(); if maximum=0 & budget.zero_unlimited()=1 then maximum=configured_maximum
  if maximum > configured_maximum then maximum = configured_maximum
  return maximum

queryanswercontextlimit: procedure = .int
  arg budget=.ragbudget, provider=.ragproviderconfig, role_input=.int, output_tokens=.int, embedding_planned=.int, prompt_schema_bytes=.int, evidence_bytes=.int, expose error=.string
  error=""
  input_limit=aggregatecap(budget.input_tokens(),role_input,1+embedding_planned,budget.zero_unlimited())
  if input_limit>role_input then input_limit=role_input
  if input_limit>provider.context_tokens()-output_tokens then input_limit=provider.context_tokens()-output_tokens
  /* Same conservative three-byte estimate as maintenance, with prompt/schema
   * bytes and 256 framing tokens reserved. This is not a model tokenizer;
   * provider-reported input/output usage is checked after generation as well. */
  limit=input_limit*3-prompt_schema_bytes-768
  if limit<1 then do;error="answer context cannot fit prompt, schema and output within the configured token envelope";return -1;end
  if limit>evidence_bytes then limit=evidence_bytes
  return limit

queryusagewithin: procedure = .int
  arg budget = .ragbudget, embedding_provider = .ragproviderconfig, embedding_usage = .providerusage, embedding_called = .int, answer_provider = .ragproviderconfig, answer_usage = .providerusage, answer_called = .int
  input_tokens = 0; output_tokens = 0; cost = 0
  if embedding_called = 1 then do
    if embedding_provider.charging_basis() = "monetary-api" & embedding_usage.cost_microunits() < 0 then return 0
    input_tokens = input_tokens + embedding_usage.input_tokens(); output_tokens = output_tokens + embedding_usage.output_tokens(); if embedding_usage.cost_microunits() > 0 then cost = cost + embedding_usage.cost_microunits()
  end
  if answer_called = 1 then do
    if answer_provider.charging_basis() = "monetary-api" & answer_usage.cost_microunits() < 0 then return 0
    input_tokens = input_tokens + answer_usage.input_tokens(); output_tokens = output_tokens + answer_usage.output_tokens(); if answer_usage.cost_microunits() > 0 then cost = cost + answer_usage.cost_microunits()
  end
  return aggregatefits(budget.input_tokens(),0,input_tokens,budget.zero_unlimited())=1 & aggregatefits(budget.output_tokens(),0,output_tokens,budget.zero_unlimited())=1 & aggregatefits(budget.cost_microunits(),0,cost,budget.zero_unlimited())=1

_monetary: procedure = .int
  arg provider = .ragproviderconfig, planned = .int
  if planned = 1 & provider.charging_basis() = "monetary-api" then return 1
  return 0

_backend: procedure = .string
  arg kind = .string
  if kind = "openai-compatible" then return "openai"
  return kind

_configuredcost: procedure = .int
  arg provider = .ragproviderconfig, input_tokens = .int, output_tokens = .int
  input_price = provider.input_price_microunits_per_million(); output_price = provider.output_price_microunits_per_million()
  if input_price >= 0 & output_price >= 0 then return (input_tokens * input_price + output_tokens * output_price) / 1000000
  /* Formats 1 and 2 retain the compiled catalogue solely as an explicitly
   * labelled compatibility projection. Config/3 supplies reviewed prices. */
  return estimatecostmicrounits(_backend(provider.kind()), provider.model(), input_tokens, output_tokens)

/* Shared effective configuration/citation helpers consumed by domain services. */
queryprivacy: procedure = .string
  arg config = .ragconfig
  privacy = "public"; sources = config.source_sets()
  do i = 1 to sources.0
    if sources[i].privacy() = "local" then return "local"
    if sources[i].privacy() = "restricted" | sources[i].privacy() = "internal" then privacy = "restricted"
  end
  return privacy
