options levelg

namespace ragfolder expose collectfolderobservations

import rxfnsb
import rxjson
import rxhash
import rxfs
import ragfile
import ragingest

/* The folder connector owns discovery and stable relative-path keys. File I/O
 * remains in the bounded Level-B ragfile exception; all identity and ingestion
 * policy remains in Level G. */
collectfolderobservations: procedure = .int
  arg root = .string, source_set_id = .string, retain_raw = .int, maximum_file_bytes = .int, captured_at = .string, expose observations = .ragsourceobservation[], expose error = .string, include_patterns = .string[], maximum_depth = 64
  clear observations
  error = ""
  if root = "" | source_set_id = "" | captured_at = "" | (retain_raw \= 0 & retain_raw \= 1) | maximum_file_bytes < 1 | maximum_depth < 0 | maximum_depth > 256 | rxfs..isdir(root) \= 1 then do
    error = "folder source set, root, retention policy, or file ceiling is invalid"
    return -1
  end
  if _walk(root, "", source_set_id, retain_raw, maximum_file_bytes, captured_at, 0, observations, error, include_patterns, maximum_depth) \= 0 then do
    clear observations
    return -2
  end
  call _sortobservations observations
  return observations.0

_walk: procedure = .int
  arg root = .string, relative = .string, source_set_id = .string, retain_raw = .int, maximum_file_bytes = .int, captured_at = .string, depth = .int, expose observations = .ragsourceobservation[], expose error = .string, include_patterns = .string[], maximum_depth = .int
  if depth > maximum_depth then do; error = "folder nesting exceeds the connector ceiling"; return -1; end
  path = root
  if relative \= "" then path = root || "/" || relative
  entries = .string[]
  count = rxfs..listdir(path, entries)
  if count < 0 then do; error = "could not enumerate source folder"; return -1; end
  call arraysort entries
  do i = 1 to entries.0
    entry = entries[i]
    if entry = "" | entry = "." | entry = ".." | pos("/", entry) > 0 | pos("\\", entry) > 0 | pos("00"x, entry) > 0 then do
      error = "source folder returned an unsafe entry"
      return -1
    end
    child_relative = entry
    if relative \= "" then child_relative = relative || "/" || entry
    child_path = root || "/" || child_relative
    if rxfs..isdir(child_path) = 1 then do
      if _walk(root, child_relative, source_set_id, retain_raw, maximum_file_bytes, captured_at, depth + 1, observations, error, include_patterns, maximum_depth) \= 0 then return -1
    end
    else if rxfs..isfile(child_path) = 1 & _supported(child_relative) = 1 then do
      if _included(child_relative, include_patterns) = 0 then iterate
      raw = .binary; bytes = 0
      if ragfile..readbinaryfilebounded(child_path, maximum_file_bytes, raw, bytes, error) \= 0 then return -1
      format = _format(child_relative); mime = _mime(format)
      connector = "folder:" || source_set_id
      uri = "file:" || child_path
      metadata = "{" || jsonquote("relative_path") || ":" || jsonquote(child_relative) || "," || jsonquote("byte_count") || ":" || bytes || "}"
      external_reference = ""; expected_digest = ""
      if retain_raw = 0 then do
        external_reference = uri
        expected_digest = rxhash..sha256hex(raw)
      end
      observations[observations.0 + 1] = .ragsourceobservation(connector, child_relative, "", uri, child_relative, mime, "utf-8", format, raw, retain_raw, external_reference, expected_digest, metadata, captured_at)
    end
  end
  return 0

/* Patterns are relative to the source root. * and ? match within a path
 * component; a whole ** component matches zero or more components. Both
 * planning and apply filter here, before opening or hashing file contents. */
_included: procedure = .int
  arg path = .string, patterns = .string[]
  components = _components(path)
  do p = 1 to patterns.0
    pattern = _components(patterns[p])
    previous = .int[]; previous[1] = 1
    do j = 1 to components.0; previous[j + 1] = 0; end
    do i = 1 to pattern.0
      current = .int[]; current[1] = 0
      if pattern[i] = "**" then current[1] = previous[1]
      do j = 1 to components.0
        current[j + 1] = 0
        if pattern[i] = "**" then current[j + 1] = previous[j + 1] | current[j]
        else if previous[j] = 1 then current[j + 1] = _componentmatches(components[j], pattern[i])
      end
      previous = current
    end
    if previous[components.0 + 1] = 1 then return 1
  end
  return 0

_components: procedure = .string[]
  arg path = .string
  output = .string[]; remaining = path
  do while pos("/", remaining) > 0
    separator = pos("/", remaining)
    output[output.0 + 1] = left(remaining, separator - 1)
    remaining = substr(remaining, separator + 1)
  end
  output[output.0 + 1] = remaining
  return output

_componentmatches: procedure = .int
  arg value = .string, pattern = .string
  v = 1; p = 1; star = 0; retry = 0
  do while v <= length(value)
    token = substr(pattern, p, 1)
    if p <= length(pattern) & token \= "*" & (token = "?" | token = substr(value, v, 1)) then do
      v = v + 1; p = p + 1
    end
    else if p <= length(pattern) & token = "*" then do
      star = p; retry = v; p = p + 1
    end
    else if star > 0 then do
      retry = retry + 1; v = retry; p = star + 1
    end
    else return 0
  end
  do while p <= length(pattern) & substr(pattern, p, 1) = "*"; p = p + 1; end
  return p > length(pattern)

_supported: procedure = .int
  arg path = .string
  extension = lower(_extension(path))
  return extension = "md" | extension = "markdown" | extension = "txt" | extension = "rexx" | extension = "crexx"

_format: procedure = .string
  arg path = .string
  extension = lower(_extension(path))
  if extension = "md" | extension = "markdown" then return "markdown"
  if extension = "rexx" | extension = "crexx" then return "rexx"
  return "plain"

_mime: procedure = .string
  arg format = .string
  if format = "markdown" then return "text/markdown"
  if format = "rexx" then return "text/x-crexx"
  return "text/plain"

_extension: procedure = .string
  arg path = .string
  dot = lastpos(".", path)
  slash = lastpos("/", path)
  if dot = 0 | dot < slash then return ""
  return substr(path, dot + 1)

_sortobservations: procedure
  arg expose observations = .ragsourceobservation[]
  do i = 1 to observations.0
    do j = i + 1 to observations.0
      if observations[j].stable_key() < observations[i].stable_key() then do
        temporary = observations[i]
        observations[i] = observations[j]
        observations[j] = temporary
      end
    end
  end
  return
