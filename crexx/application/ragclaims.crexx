options levelg

namespace ragclaims expose ragclaimpolicy ragextractionproposal ragproposalvalidation ragproposalresult ragtraversalstep ragextractionrank promotemention rankchunk validateproposal applyproposal applyclaimedproposal retractsupport traverseclaims

import rxfnsb
import rxjson
import rxhash
import sqlite_boundary
import ragstore

/* Phase-4 graph policy stays in Level G. Provider output is represented by an
 * immutable typed proposal and cannot write graph state directly. */
ragclaimpolicy: class
  _policy_version = .string
  _concept_types = .string
  _relationships = .string
  _assertion_weight = .int
  _quotation_weight = .int
  _report_weight = .int
  _negation_weight = .int
  _speculation_weight = .int

  *: factory
    arg policy_version = .string, concept_types = .string, relationships = .string, assertion_weight = .int, quotation_weight = .int, report_weight = .int, negation_weight = .int, speculation_weight = .int
    _policy_version = policy_version
    _concept_types = concept_types
    _relationships = relationships
    _assertion_weight = assertion_weight
    _quotation_weight = quotation_weight
    _report_weight = report_weight
    _negation_weight = negation_weight
    _speculation_weight = speculation_weight
    return

  policy_version: method = .string
    return _policy_version
  permits_type: method = .int
    arg concept_type = .string
    return _tokencontains(_concept_types, concept_type)
  permits_relationship: method = .int
    arg relationship = .string
    return _tokencontains(_relationships, relationship)
  stance_weight: method = .int
    arg stance = .string
    if stance = "assertion" then return _assertion_weight
    if stance = "quotation" then return _quotation_weight
    if stance = "report" then return _report_weight
    if stance = "negation" then return _negation_weight
    if stance = "speculation" then return _speculation_weight
    return 0

