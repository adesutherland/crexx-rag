    _confidence_millionths = confidence_millionths
    _provider_id = provider_id; _model = model; _request_id = request_id
    _prompt_version = prompt_version; _extractor_identity = extractor_identity
    _source_scope = source_scope; _profile_id = profile_id; _external = external
    return

  schema: method = .string
