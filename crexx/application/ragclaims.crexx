    if _schema = "crexx-rag.extraction-proposal/2" then extra = "," || jsonquote("assessment") || ":" || _assessment_json
    return "{" || jsonquote("schema") || ":" || jsonquote(_schema) || "," || jsonquote("proposal_id") || ":" || jsonquote(_proposal_id) || "," || jsonquote("kind") || ":" || jsonquote(_kind) || "," || jsonquote("source_concept_id") || ":" || jsonquote(_source_concept_id) || "," || jsonquote("source_label") || ":" || jsonquote(_source_label) || "," || jsonquote("source_type") || ":" || jsonquote(_source_type) || "," || jsonquote("relationship_type") || ":" || jsonquote(_relationship_type) || "," || jsonquote("target_concept_id") || ":" || jsonquote(_target_concept_id) || "," || jsonquote("target_label") || ":" || jsonquote(_target_label) || "," || jsonquote("target_type") || ":" || jsonquote(_target_type) || "," || jsonquote("direction") || ":" || jsonquote(_direction) || "," || jsonquote("qualifiers") || ":" || _qualifiers_json || "," || jsonquote("effective_from") || ":" || jsonquote(_effective_from) || "," || jsonquote("effective_to") || ":" || jsonquote(_effective_to) || "," || jsonquote("revision_chunk_id") || ":" || jsonquote(_revision_chunk_id) || "," || jsonquote("span_start") || ":" || _span_start || "," || jsonquote("span_end") || ":" || _span_end || "," || jsonquote("polarity") || ":" || jsonquote(_polarity) || "," || jsonquote("stance") || ":" || jsonquote(_stance) || "," || jsonquote("directness") || ":" || jsonquote(_directness) || "," || jsonquote("attribution") || ":" || jsonquote(_attribution) || "," || jsonquote("lineage_group") || ":" || jsonquote(_lineage_group) || "," || jsonquote("confidence_millionths") || ":" || _confidence_millionths || "," || jsonquote("provider_id") || ":" || jsonquote(_provider_id) || "," || jsonquote("model") || ":" || jsonquote(_model) || "," || jsonquote("request_id") || ":" || jsonquote(_request_id) || "," || jsonquote("prompt_version") || ":" || jsonquote(_prompt_version) || "," || jsonquote("extractor_identity") || ":" || jsonquote(_extractor_identity) || "," || jsonquote("source_scope") || ":" || jsonquote(_source_scope) || "," || jsonquote("profile_id") || ":" || jsonquote(_profile_id) || "," || jsonquote("external") || ":" || _external || extra || "}"

