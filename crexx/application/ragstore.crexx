options levelg

namespace ragstore expose ragstorehandle ragreadsnapshot ragstorestatus ragverifyresult applymigrations validatemigrations initragstore openragstore closeragstore storagestatus beginreadsnapshot closereadsnapshot begingeneration commitgeneration abortgeneration rollbackgeneration writemanifesttemporary publishmanifest manifeststate recovermanifest verifyragstore

import rxfnsb
import rxjson
import rxfs
import sqlite_boundary
import ragschema
import ragfile

ragstorehandle: class
  _database = .binary
  _path = .string
  _access = .string
  _open = .int

  *: factory
    arg database = .binary, path = .string, access = .string
    _database = database
    _path = path
    _access = access
    _open = 1
    return

  database: method = .binary
    return _database
  path: method = .string
    return _path
  access: method = .string
    return _access
  open: method = .int
    return _open
  writable: method = .int
    return _open = 1 & _access = "readwrite"
  markclosed: method
    _open = 0
    return

ragreadsnapshot: class
  _database = .binary
  _generation = .int
  _open = .int

  *: factory
    arg database = .binary, generation = .int
    _database = database
    _generation = generation
    _open = 1
    return

  database: method = .binary
    return _database
  generation: method = .int
    return _generation
  open: method = .int
    return _open
  markclosed: method
    _open = 0
    return

ragstorestatus: class
  _library_id = .string
  _schema_version = .int
  _published_generation = .int
  _next_generation = .int
  _profile_id = .string
  _profile_hash = .string
  _manifest_state = .string

  *: factory
    arg library_id = .string, schema_version = .int, published_generation = .int, next_generation = .int, profile_id = .string, profile_hash = .string, manifest_state = .string
    _library_id = library_id
    _schema_version = schema_version
    _published_generation = published_generation
    _next_generation = next_generation
    _profile_id = profile_id
    _profile_hash = profile_hash
    _manifest_state = manifest_state
    return

  library_id: method = .string
    return _library_id
  schema_version: method = .int
    return _schema_version
  published_generation: method = .int
    return _published_generation
  next_generation: method = .int
    return _next_generation
  profile_id: method = .string
    return _profile_id
  profile_hash: method = .string
    return _profile_hash
  manifest_state: method = .string
    return _manifest_state

ragverifyresult: class
  _issues = .int
  _summary = .string

  *: factory
    arg issues = .int, summary = .string
    _issues = issues
    _summary = summary
    return

  ok: method = .int
    return _issues = 0
  issue_count: method = .int
    return _issues
  summary: method = .string
    return _summary

applymigrations: procedure = .int
  arg database = .binary, tool_version = .string, maximum_version = .int, expose error = .string
  error = ""
  if tool_version = "" | maximum_version < 1 | maximum_version > ragschemaversion() then do
    error = "invalid migration request"
    return -1
  end
  if sqliteexec(database, "PRAGMA foreign_keys=ON") \= 0 then return _sqlitefailure("enable foreign keys", error)
  has_migrations = _tableexists(database, "schema_migrations", error)
  if has_migrations < 0 then return -3
  if has_migrations = 1 then do
    recorded_max = _scalarint(database, "SELECT coalesce(max(version),0) FROM schema_migrations", error)
    if recorded_max < 0 then return -3
    if recorded_max > ragschemaversion() then do
      error = "database schema is newer than this application"
      return -4
    end
    if recorded_max > maximum_version then do
      error = "migration downgrade is prohibited"
      return -4
    end
  end
  if sqliteexec(database, "BEGIN IMMEDIATE") \= 0 then return _sqlitefailure("begin migration", error)
  changed = 0
  do version = 1 to maximum_version
    recorded_name = ""; recorded_checksum = ""
    present = _migrationrecord(database, version, recorded_name, recorded_checksum, error)
    if present < 0 then do
      call sqliteexec database, "ROLLBACK"
      return -3
    end
    expected_name = migrationname(version)
    expected_checksum = migrationchecksum(version)
    if present = 1 then do
      if recorded_name \= expected_name | recorded_checksum \= expected_checksum then do
        call sqliteexec database, "ROLLBACK"
        error = "migration identity mismatch at version " || version
        return -4
      end
    end
    else do
      changed = 1
      statements = .string[]
      statement_count = migrationstatements(version, statements)
      if statement_count < 1 then do
        call sqliteexec database, "ROLLBACK"
        error = "migration definition missing at version " || version
        return -4
      end
      do i = 1 to statements.0
        if sqliteexec(database, statements[i]) \= 0 then do
          detail = ""
          ignored = _sqlitefailure("apply migration " || version || " statement " || i, detail)
          call sqliteexec database, "ROLLBACK"
          error = detail
          return -3
        end
      end
      prepared = .binary
      sql = "INSERT INTO schema_migrations(version,name,checksum,applied_at,tool_version) VALUES(?1,?2,?3,strftime('%Y-%m-%dT%H:%M:%fZ','now'),?4)"
      if sqliteprepare(database, sql, prepared) \= 0 then do
        ignored = _sqlitefailure("prepare migration record", error)
        call sqliteexec database, "ROLLBACK"
        return -3
      end
      bind_status = sqlitebindint(prepared, 1, version)
      bind_status = bind_status | sqlitebindtext(prepared, 2, expected_name)
      bind_status = bind_status | sqlitebindtext(prepared, 3, expected_checksum)
      bind_status = bind_status | sqlitebindtext(prepared, 4, tool_version)
      step_status = sqlitestep(prepared)
      call sqlitefinalize prepared
      if bind_status \= 0 | step_status \= 101 then do
        ignored = _sqlitefailure("record migration " || version, error)
        call sqliteexec database, "ROLLBACK"
        return -3
      end
    end
  end
  if changed = 1 & _tableexists(database, "library_meta", error) = 1 then do
    if sqliteexec(database, "UPDATE library_meta SET schema_version=" || maximum_version || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE singleton=1") \= 0 then do
      ignored = _sqlitefailure("update schema version", error)
      call sqliteexec database, "ROLLBACK"
      return -3
    end
  end
  if sqliteexec(database, "COMMIT") \= 0 then do
    ignored = _sqlitefailure("commit migration", error)
    call sqliteexec database, "ROLLBACK"
    return -3
  end
  return 0

validatemigrations: procedure = .int
  arg database = .binary, expose error = .string
  error = ""
  if _tableexists(database, "schema_migrations", error) \= 1 then do
    if error = "" then error = "schema_migrations is missing"
    return -4
  end
  if _scalarint(database, "SELECT count(*) FROM schema_migrations", error) \= ragschemaversion() then do
    if error = "" then error = "migration count does not match schema version"
    return -4
  end
  do version = 1 to ragschemaversion()
    recorded_name = ""; recorded_checksum = ""
    present = _migrationrecord(database, version, recorded_name, recorded_checksum, error)
    if present \= 1 then do
      if error = "" then error = "migration record missing at version " || version
      return -4
    end
    if recorded_name \= migrationname(version) | recorded_checksum \= migrationchecksum(version) then do
      error = "migration identity mismatch at version " || version
      return -4
    end
  end
  if _scalarint(database, "SELECT count(*) FROM library_meta WHERE singleton=1 AND schema_version=" || ragschemaversion(), error) \= 1 then do
    if error = "" then error = "library metadata schema version is invalid"
    return -4
  end
  return 0

initragstore: procedure = .int
  arg path = .string, library_id = .string, config_snapshot_id = .string, config_id = .string, config_version = .string, profile_id = .string, profile_hash = .string, config_hash = .string, effective_json = .string, expose store = .ragstorehandle, expose error = .string
  error = ""
  if path = "" | library_id = "" | config_snapshot_id = "" | config_id = "" | config_version = "" | profile_id = "" | profile_hash = "" | config_hash = "" | effective_json = "" then do
    error = "initial library identity and snapshot fields are required"
    return -1
  end
  if rxfs..isdir(path) = 1 then do
    error = "library path already exists"
    return -2
  end
  if rxfs..mkdir(path) \= 0 then do
    error = "could not create library path"
    return -2
  end
  database = .binary
  if sqliteopenmode(path || "/library.sqlite", "create", database) \= 0 then do
    ignored = _sqlitefailure("create library database", error)
    call rxfs..rmdir path
    return -3
  end
  if _configurereadwrite(database, error) \= 0 | applymigrations(database, "crexx-rag-p2-03", ragschemaversion(), error) \= 0 then do
    call sqliteclose database
    call _removefailedlibrary path
    return -3
  end
  if sqliteexec(database, "BEGIN IMMEDIATE") \= 0 then do
    ignored = _sqlitefailure("begin library initialization", error)
    call sqliteclose database
    call _removefailedlibrary path
    return -3
  end
  prepared = .binary
  sql = "INSERT INTO config_snapshots(config_snapshot_id,config_id,config_version,profile_id,profile_hash,config_hash,effective_json,created_at) VALUES(?1,?2,?3,?4,?5,?6,?7,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then return _initfailure(database, path, "prepare initial config snapshot", error)
  bind_status = sqlitebindtext(prepared, 1, config_snapshot_id)
  bind_status = bind_status | sqlitebindtext(prepared, 2, config_id)
  bind_status = bind_status | sqlitebindtext(prepared, 3, config_version)
  bind_status = bind_status | sqlitebindtext(prepared, 4, profile_id)
  bind_status = bind_status | sqlitebindtext(prepared, 5, profile_hash)
  bind_status = bind_status | sqlitebindtext(prepared, 6, config_hash)
  bind_status = bind_status | sqlitebindtext(prepared, 7, effective_json)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then return _initfailure(database, path, "insert initial config snapshot", error)
  if _insertinitialrecords(database, library_id, config_snapshot_id, profile_id, profile_hash, error) \= 0 then do
    call sqliteexec database, "ROLLBACK"
    call sqliteclose database
    call _removefailedlibrary path
    return -3
  end
  if sqliteexec(database, "COMMIT") \= 0 then do
    ignored = _sqlitefailure("commit library initialization", error)
    call sqliteclose database
    call _removefailedlibrary path
    return -3
  end
  store = .ragstorehandle(database, path, "readwrite")
  if publishmanifest(store, error) \= 0 then return -7
  return 0

openragstore: procedure = .int
  arg path = .string, access = .string, expose store = .ragstorehandle, expose error = .string
  error = ""
  if access \= "readonly" & access \= "readwrite" then do
    error = "access must be readonly or readwrite"
    return -1
  end
  if rxfs..isfile(path || "/library.sqlite") \= 1 then do
    error = "library database does not exist"
    return -2
  end
  database = .binary
  if access = "readonly" then do
    if _openreadonlydatabase(path || "/library.sqlite", database, error) \= 0 then return -3
    if _configurereadonly(database, error) \= 0 | validatemigrations(database, error) \= 0 then do
      call sqliteclose database
      return -4
    end
  end
  else do
    if sqliteopenmode(path || "/library.sqlite", access, database) \= 0 then return _sqlitefailure("open library database", error)
    if _configurereadwrite(database, error) \= 0 | applymigrations(database, "crexx-rag-p2-03", ragschemaversion(), error) \= 0 then do
      call sqliteclose database
      return -4
    end
  end
  store = .ragstorehandle(database, path, access)
  return 0

closeragstore: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  error = ""
  if store.open() \= 1 then do
    error = "store is already closed"
    return -5
  end
  if store.writable() = 1 then do
    /* A stable closed bundle uses rollback-journal mode, so later read-only
     * opens need no WAL coordination files. Busy conversion is best-effort. */
    call sqliteexec store.database(), "PRAGMA wal_checkpoint(TRUNCATE)"
    call sqliteexec store.database(), "PRAGMA journal_mode=DELETE"
  end
  if sqliteclose(store.database()) \= 0 then return _sqlitefailure("close library database", error)
  call store.markclosed()
  return 0

storagestatus: procedure = .int
  arg store = .ragstorehandle, expose status = .ragstorestatus, expose error = .string
  error = ""
  if store.open() \= 1 then do
    error = "store is closed"
    return -5
  end
  prepared = .binary
  sql = "SELECT m.library_id,m.schema_version,m.published_generation,m.next_generation,c.profile_id,c.profile_hash FROM library_meta m JOIN published_generations g ON g.generation=m.published_generation JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE m.singleton=1 AND g.state='published'"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then return _sqlitefailure("prepare storage status", error)
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    error = "library metadata is incomplete"
    return -4
  end
  library_id = ""; schema_version = 0; generation = 0; next_generation = 0; profile_id = ""; profile_hash = ""
  column_status = sqlitecolumntext(prepared, 0, library_id)
  column_status = column_status | sqlitecolumnint(prepared, 1, schema_version)
  column_status = column_status | sqlitecolumnint(prepared, 2, generation)
  column_status = column_status | sqlitecolumnint(prepared, 3, next_generation)
  column_status = column_status | sqlitecolumntext(prepared, 4, profile_id)
  column_status = column_status | sqlitecolumntext(prepared, 5, profile_hash)
  call sqlitefinalize prepared
  if column_status \= 0 then return _sqlitefailure("read storage status", error)
  manifest_state = ""; detail = ""
  manifest_status = manifeststate(store, manifest_state, detail)
  if manifest_status \= 0 then manifest_state = "invalid"
  status = .ragstorestatus(library_id, schema_version, generation, next_generation, profile_id, profile_hash, manifest_state)
  return 0

beginreadsnapshot: procedure = .int
  arg path = .string, expose read_snapshot = .ragreadsnapshot, expose error = .string
  error = ""
  database = .binary
  if _openreadonlydatabase(path || "/library.sqlite", database, error) \= 0 then return -3
  if _configurereadonly(database, error) \= 0 | validatemigrations(database, error) \= 0 then do
    call sqliteclose database
    return -4
  end
  if sqliteexec(database, "BEGIN") \= 0 then do
    ignored = _sqlitefailure("begin read snapshot", error)
    call sqliteclose database
    return -3
  end
  generation = _scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  if generation < 1 then do
    call sqliteexec database, "ROLLBACK"
    call sqliteclose database
    if error = "" then error = "published generation is invalid"
    return -4
  end
  read_snapshot = .ragreadsnapshot(database, generation)
  return 0

closereadsnapshot: procedure = .int
  arg read_snapshot = .ragreadsnapshot, expose error = .string
  error = ""
  if read_snapshot.open() \= 1 then do
    error = "read snapshot is already closed"
    return -5
  end
  rollback_status = sqliteexec(read_snapshot.database(), "ROLLBACK")
  close_status = sqliteclose(read_snapshot.database())
  call read_snapshot.markclosed()
  if rollback_status \= 0 | close_status \= 0 then return _sqlitefailure("close read snapshot", error)
  return 0

begingeneration: procedure = .int
  arg store = .ragstorehandle, expected_parent = .int, config_snapshot_id = .string, summary = .string, expose generation = .int, expose error = .string
  error = ""; generation = 0
  if store.writable() \= 1 then do
    error = "generation publication requires readwrite access"
    return -5
  end
  if sqliteexec(store.database(), "BEGIN IMMEDIATE") \= 0 then return _sqlitefailure("begin generation", error)
  current = _scalarint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  generation = _scalarint(store.database(), "SELECT next_generation FROM library_meta WHERE singleton=1", error)
  if current < 1 | generation < 2 then do
    call sqliteexec store.database(), "ROLLBACK"
    return -4
  end
  if current \= expected_parent then do
    call sqliteexec store.database(), "ROLLBACK"
    error = "published generation changed from the expected parent"
    generation = 0
    return -6
  end
  if _scalarint(store.database(), "SELECT count(*) FROM config_snapshots WHERE config_snapshot_id=" || _sqlquote(config_snapshot_id), error) \= 1 then do
    call sqliteexec store.database(), "ROLLBACK"
    if error = "" then error = "config snapshot does not exist"
    generation = 0
    return -6
  end
  prepared = .binary
  sql = "INSERT INTO published_generations(generation,parent_generation,state,config_snapshot_id,summary,created_at) VALUES(?1,?2,'staging',?3,?4,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then do
    ignored = _sqlitefailure("prepare generation", error)
    call sqliteexec store.database(), "ROLLBACK"
    generation = 0
    return -3
  end
  bind_status = sqlitebindint(prepared, 1, generation)
  bind_status = bind_status | sqlitebindint(prepared, 2, current)
  bind_status = bind_status | sqlitebindtext(prepared, 3, config_snapshot_id)
  bind_status = bind_status | sqlitebindtext(prepared, 4, summary)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then do
    ignored = _sqlitefailure("insert staging generation", error)
    call sqliteexec store.database(), "ROLLBACK"
    generation = 0
    return -3
  end
  return 0

commitgeneration: procedure = .int
  arg store = .ragstorehandle, generation = .int, expose error = .string
  error = ""
  if store.writable() \= 1 then do
    error = "generation publication requires readwrite access"
    return -5
  end
  parent = _scalarint(store.database(), "SELECT parent_generation FROM published_generations WHERE generation=" || generation || " AND state='staging'", error)
  current = _scalarint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  if parent < 1 | current \= parent then do
    call sqliteexec store.database(), "ROLLBACK"
    if error = "" then error = "staging generation is not based on the published generation"
    return -6
  end
  if sqliteexec(store.database(), "UPDATE published_generations SET state='published',published_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE generation=" || generation || " AND state='staging'") \= 0 then return _generationfailure(store.database(), "publish generation", error)
  if sqliteexec(store.database(), "UPDATE library_meta SET published_generation=" || generation || ",next_generation=" || (generation + 1) || ",active_profile_id=(SELECT c.profile_id FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.generation=" || generation || "),active_profile_hash=(SELECT c.profile_hash FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.generation=" || generation || "),updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE singleton=1 AND published_generation=" || parent) \= 0 then return _generationfailure(store.database(), "advance generation pointer", error)
  sql = "INSERT INTO publication_events(generation,previous_generation,event_type,reason,occurred_at) VALUES(" || generation || "," || parent || ",'publish','generation publication',strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteexec(store.database(), sql) \= 0 then return _generationfailure(store.database(), "record generation publication", error)
  if sqliteexec(store.database(), "COMMIT") \= 0 then return _generationfailure(store.database(), "commit generation publication", error)
  return 0

abortgeneration: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  error = ""
  if store.writable() \= 1 then do
    error = "generation abort requires readwrite access"
    return -5
  end
  if sqliteexec(store.database(), "ROLLBACK") \= 0 then return _sqlitefailure("abort generation", error)
  return 0

rollbackgeneration: procedure = .int
  arg store = .ragstorehandle, expected_current = .int, target_generation = .int, reason = .string, expose error = .string
  error = ""
  if store.writable() \= 1 then do
    error = "generation rollback requires readwrite access"
    return -5
  end
  if target_generation < 1 | reason = "" then do
    error = "rollback target and reason are required"
    return -1
  end
  if sqliteexec(store.database(), "BEGIN IMMEDIATE") \= 0 then return _sqlitefailure("begin generation rollback", error)
  current = _scalarint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  if current \= expected_current then do
    call sqliteexec store.database(), "ROLLBACK"
    error = "published generation changed from the expected rollback source"
    return -6
  end
  sql = "WITH RECURSIVE lineage(generation) AS (SELECT " || current || " UNION ALL SELECT p.parent_generation FROM published_generations p JOIN lineage l ON p.generation=l.generation WHERE p.parent_generation IS NOT NULL) SELECT count(*) FROM lineage JOIN published_generations p USING(generation) WHERE generation=" || target_generation || " AND p.state='published'"
  if _scalarint(store.database(), sql, error) \= 1 then do
    call sqliteexec store.database(), "ROLLBACK"
    if error = "" then error = "rollback target is not a published ancestor"
    return -6
  end
  rollback_manifest = ""
  if _manifestprojectiongeneration(store.database(), target_generation, rollback_manifest, error) \= 0 then do
    call sqliteexec store.database(), "ROLLBACK"
    return -4
  end
  if _writemanifestcontent(store, rollback_manifest, error) \= 0 then do
    call sqliteexec store.database(), "ROLLBACK"
    return -2
  end
  if _renamemanifest(store, error) \= 0 then do
    call sqliteexec store.database(), "ROLLBACK"
    return -2
  end
  if sqliteexec(store.database(), "DELETE FROM chunks_fts") \= 0 then return _generationfailure(store.database(), "clear rollback FTS projection", error)
  fts_sql = "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) SELECT r.revision_chunk_id,r.content_id,c.text FROM revision_chunks r JOIN chunk_contents c ON c.content_id=r.content_id WHERE r.visible_from_generation<=" || target_generation || " AND (r.visible_to_generation IS NULL OR r.visible_to_generation>" || target_generation || ") ORDER BY r.revision_chunk_id"
  if sqliteexec(store.database(), fts_sql) \= 0 then return _generationfailure(store.database(), "rebuild rollback FTS projection", error)
  if sqliteexec(store.database(), "UPDATE library_meta SET published_generation=" || target_generation || ",active_profile_id=(SELECT c.profile_id FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.generation=" || target_generation || "),active_profile_hash=(SELECT c.profile_hash FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.generation=" || target_generation || "),updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE singleton=1 AND published_generation=" || current) \= 0 then return _generationfailure(store.database(), "move rollback pointer", error)
  prepared = .binary
  sql = "INSERT INTO publication_events(generation,previous_generation,event_type,reason,occurred_at) VALUES(?1,?2,'rollback',?3,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then return _generationfailure(store.database(), "prepare rollback event", error)
  bind_status = sqlitebindint(prepared, 1, target_generation)
  bind_status = bind_status | sqlitebindint(prepared, 2, current)
  bind_status = bind_status | sqlitebindtext(prepared, 3, reason)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then return _generationfailure(store.database(), "record rollback event", error)
  if sqliteexec(store.database(), "COMMIT") \= 0 then return _generationfailure(store.database(), "commit generation rollback", error)
  return 0

writemanifesttemporary: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  error = ""
  if store.writable() \= 1 then do
    error = "manifest publication requires readwrite access"
    return -5
  end
  manifest = ""
  if _manifestprojection(store.database(), manifest, error) \= 0 then return -4
  return _writemanifestcontent(store, manifest, error)

_writemanifestcontent: procedure = .int
  arg store = .ragstorehandle, manifest = .string, expose error = .string
  temporary = store.path() || "/manifest.json.new"
  if rxfs..isfile(temporary) = 1 & rxfs..delete(temporary) \= 0 then do
    error = "could not replace temporary manifest"
    return -2
  end
  if lineout(temporary, manifest) \= 0 then do
    error = "could not write temporary manifest"
    return -2
  end
  call lineout temporary
  return 0

publishmanifest: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  error = ""
  if writemanifesttemporary(store, error) \= 0 then return -2
  return _renamemanifest(store, error)

_renamemanifest: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  temporary = store.path() || "/manifest.json.new"
  final = store.path() || "/manifest.json"
  if rxfs..rename(temporary, final) \= 0 then do
    error = "could not atomically publish manifest"
    return -2
  end
  return 0

manifeststate: procedure = .int
  arg store = .ragstorehandle, expose state = .string, expose error = .string
  error = ""; state = "invalid"
  if store.open() \= 1 then do
    error = "store is closed"
    return -5
  end
  temporary_present = rxfs..isfile(store.path() || "/manifest.json.new") = 1
  if rxfs..isfile(store.path() || "/manifest.json") \= 1 then do
    state = "missing"
    if temporary_present then state = "missing-temp"
    return 0
  end
  content = loadtext(store.path() || "/manifest.json")
  document = .jsondocument(content)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" then do
    error = "manifest JSON is invalid"
    return -7
  end
  manifest_format = 0; manifest_generation = 0; manifest_schema = 0; manifest_library = ""; manifest_profile = ""; manifest_hash = ""; created_at = ""; updated_at = ""
  root = document.root()
  required_capabilities = document.member(root, "required_capabilities")
  sidecars = document.member(root, "sidecars")
  migration_pending = document.member(root, "migration_pending")
  recovery_pending = document.member(root, "recovery_pending")
  migration_value = 1; recovery_value = 1; required_capability = ""
  if document.node_int(document.member(root, "bundle_format_version"), manifest_format) \= 0 | document.node_int(document.member(root, "published_generation"), manifest_generation) \= 0 | document.node_int(document.member(root, "schema_version"), manifest_schema) \= 0 | document.node_string(document.member(root, "library_id"), manifest_library) \= 0 | document.node_string(document.member(root, "profile_id"), manifest_profile) \= 0 | document.node_string(document.member(root, "profile_hash"), manifest_hash) \= 0 | document.node_string(document.member(root, "created_at"), created_at) \= 0 | document.node_string(document.member(root, "updated_at"), updated_at) \= 0 then do
    error = "manifest projection fields are invalid"
    return -7
  end
  if manifest_format \= 2 | created_at = "" | updated_at = "" | document.node_type(required_capabilities) \= "array" | document.node_count(required_capabilities) \= 1 | document.node_string(document.element(required_capabilities, 1), required_capability) \= 0 | required_capability \= "sqlite-boundary-v1" | document.node_type(sidecars) \= "array" | document.node_boolean(migration_pending, migration_value) \= 0 | migration_value \= 0 | document.node_boolean(recovery_pending, recovery_value) \= 0 | recovery_value \= 0 then do
    error = "manifest capability or recovery fields are invalid"
    return -7
  end
  database_library = ""; database_schema = 0; database_generation = 0; database_profile = ""; database_hash = ""
  if _statusprojection(store.database(), database_library, database_schema, database_generation, database_profile, database_hash, error) \= 0 then return -4
  if manifest_library \= database_library | manifest_schema \= database_schema then do
    state = "invalid"
    error = "manifest identity does not agree with SQLite"
    return -7
  end
  if manifest_generation < database_generation then state = "stale"
  else if manifest_generation > database_generation then state = "ahead"
  else if manifest_profile \= database_profile | manifest_hash \= database_hash then do
    state = "invalid"
    error = "manifest profile does not agree with SQLite"
    return -7
  end
  else do
    sidecar_state = _manifestsidecarstate(document, sidecars, store.database(), manifest_generation, store.path(), error)
    if sidecar_state = 1 then state = "aligned"
    else if sidecar_state = 0 then state = "stale-sidecars"
    else do
      state = "invalid"
      if error = "" then error = "manifest sidecars do not agree with SQLite or the bundle"
      return -7
    end
  end
  if temporary_present then state = state || "-temp"
  return 0

recovermanifest: procedure = .int
  arg store = .ragstorehandle, expose error = .string
  error = ""
  if store.writable() \= 1 then do
    error = "manifest recovery requires readwrite access"
    return -5
  end
  return publishmanifest(store, error)

verifyragstore: procedure = .int
  arg store = .ragstorehandle, require_manifest = .int, expose result = .ragverifyresult, expose error = .string
  error = ""; issues = 0; summary = ""
  if store.open() \= 1 then do
    error = "store is closed"
    return -5
  end
  integrity_ok = 0; integrity_details = ""
  if sqliteintegrity(store.database(), "full", 20, integrity_ok, integrity_details) \= 0 then return _sqlitefailure("verify SQLite integrity", error)
  if integrity_ok \= 1 then do
    issues = issues + 1
    summary = _addissue(summary, "sqlite-integrity")
  end
  if _rowcount(store.database(), "PRAGMA foreign_key_check", error) \= 0 then do
    issues = issues + 1
    summary = _addissue(summary, "foreign-keys")
  end
  detail = ""
  if validatemigrations(store.database(), detail) \= 0 then do
    issues = issues + 1
    summary = _addissue(summary, "migrations")
  end
  generation = _scalarint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  if generation < 1 | _scalarint(store.database(), "SELECT count(*) FROM published_generations WHERE state='published' AND generation=" || generation, error) \= 1 then do
    issues = issues + 1
    summary = _addissue(summary, "generation-pointer")
  end
  visibility_sql = "SELECT (SELECT count(*) FROM sources WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM source_revisions WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM revision_chunks WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM candidate_mentions WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM concepts WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM aliases WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM mentions WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM claims WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM claim_support WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM claim_conflicts WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM ambiguity_candidates WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)+(SELECT count(*) FROM revision_chunk_embeddings WHERE visible_to_generation IS NOT NULL AND visible_to_generation<=visible_from_generation)"
  if _scalarint(store.database(), visibility_sql, error) \= 0 then do
    issues = issues + 1
    summary = _addissue(summary, "visibility-bounds")
  end
  fts_sql = "SELECT abs((SELECT count(*) FROM chunks_fts)-(SELECT count(*) FROM revision_chunks WHERE visible_from_generation<=" || generation || " AND (visible_to_generation IS NULL OR visible_to_generation>" || generation || ")))+(SELECT count(*) FROM chunks_fts f LEFT JOIN revision_chunks r ON r.revision_chunk_id=f.revision_chunk_id LEFT JOIN chunk_contents c ON c.content_id=r.content_id WHERE r.revision_chunk_id IS NULL OR r.visible_from_generation>" || generation || " OR (r.visible_to_generation IS NOT NULL AND r.visible_to_generation<=" || generation || ") OR c.content_id<>f.content_id OR c.text<>f.body)+(SELECT count(*) FROM revision_chunks r LEFT JOIN chunks_fts f ON f.revision_chunk_id=r.revision_chunk_id WHERE r.visible_from_generation<=" || generation || " AND (r.visible_to_generation IS NULL OR r.visible_to_generation>" || generation || ") AND f.rowid IS NULL)"
  if _scalarint(store.database(), fts_sql, error) \= 0 then do
    issues = issues + 1
    summary = _addissue(summary, "fts-parity")
  end
  if _scalarint(store.database(), "SELECT count(*) FROM embeddings WHERE length(vector)<>dimension*4", error) \= 0 then do
    issues = issues + 1
    summary = _addissue(summary, "embedding-dimensions")
  end
  sidecar_sql = "SELECT count(*) FROM vector_generations v LEFT JOIN published_generations g ON g.generation=v.semantic_generation LEFT JOIN embedding_profiles p ON p.embedding_profile_id=v.embedding_profile_id WHERE v.state NOT IN('published','superseded') OR g.generation IS NULL OR p.embedding_profile_id IS NULL OR length(v.sidecar_checksum)<>64 OR v.sidecar_checksum GLOB '*[^0-9a-f]*' OR v.sidecar_name='' OR instr(v.sidecar_name,'/')>0 OR instr(v.sidecar_name,char(92))>0 OR (v.state='published' AND v.published_at IS NULL)"
  if _scalarint(store.database(), sidecar_sql, error) \= 0 | _activesidecarfilesvalid(store.database(), generation, store.path(), error) \= 1 then do
    issues = issues + 1
    summary = _addissue(summary, "sidecars")
  end
  if require_manifest = 1 then do
    manifest_state = ""
    manifest_status = manifeststate(store, manifest_state, detail)
    if manifest_status \= 0 | manifest_state \= "aligned" then do
      issues = issues + 1
      summary = _addissue(summary, "manifest-" || manifest_state)
    end
  end
  if issues = 0 then summary = "ok"
  result = .ragverifyresult(issues, summary)
  return 0

_configurereadwrite: procedure = .int
  arg database = .binary, expose error = .string
  if sqliteexec(database, "PRAGMA foreign_keys=ON") \= 0 then return _sqlitefailure("enable foreign keys", error)
  if sqlitebusytimeout(database, 5000) \= 0 then return _sqlitefailure("set busy timeout", error)
  if sqliteexec(database, "PRAGMA journal_mode=WAL") \= 0 then return _sqlitefailure("enable WAL", error)
  if sqliteexec(database, "PRAGMA synchronous=FULL") \= 0 then return _sqlitefailure("set synchronous policy", error)
  return 0

_openreadonlydatabase: procedure = .int
  arg database_path = .string, expose database = .binary, expose error = .string
  if sqliteopenmode(database_path, "readonly", database) \= 0 then return _sqlitefailure("open library database readonly", error)
  return 0

_configurereadonly: procedure = .int
  arg database = .binary, expose error = .string
  if sqliteexec(database, "PRAGMA foreign_keys=ON") \= 0 then return _sqlitefailure("enable foreign keys", error)
  if sqlitebusytimeout(database, 5000) \= 0 then return _sqlitefailure("set busy timeout", error)
  return 0

_insertinitialrecords: procedure = .int
  arg database = .binary, library_id = .string, config_snapshot_id = .string, profile_id = .string, profile_hash = .string, expose error = .string
  prepared = .binary
  sql = "INSERT INTO published_generations(generation,parent_generation,state,config_snapshot_id,summary,created_at,published_at) VALUES(1,NULL,'published',?1,'initial library generation',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then return _sqlitefailure("prepare initial generation", error)
  bind_status = sqlitebindtext(prepared, 1, config_snapshot_id)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then return _sqlitefailure("insert initial generation", error)
  prepared = .binary
  sql = "INSERT INTO library_meta(singleton,library_id,bundle_format_version,schema_version,published_generation,next_generation,active_profile_id,active_profile_hash,required_capabilities,created_at,updated_at) VALUES(1,?1,2,?2,1,2,?3,?4,'sqlite-boundary-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then return _sqlitefailure("prepare library metadata", error)
  bind_status = sqlitebindtext(prepared, 1, library_id)
  bind_status = bind_status | sqlitebindint(prepared, 2, ragschemaversion())
  bind_status = bind_status | sqlitebindtext(prepared, 3, profile_id)
  bind_status = bind_status | sqlitebindtext(prepared, 4, profile_hash)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then return _sqlitefailure("insert library metadata", error)
  if sqliteexec(database, "INSERT INTO publication_events(generation,previous_generation,event_type,reason,occurred_at) VALUES(1,NULL,'publish','initial library generation',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") \= 0 then return _sqlitefailure("record initial publication", error)
  return 0

_manifestprojection: procedure = .int
  arg database = .binary, expose manifest = .string, expose error = .string
  generation = _scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1", error)
  if generation < 1 then return -4
  return _manifestprojectiongeneration(database, generation, manifest, error)

_manifestprojectiongeneration: procedure = .int
  arg database = .binary, generation = .int, expose manifest = .string, expose error = .string
  library_id = _scalartext(database, "SELECT library_id FROM library_meta WHERE singleton=1", error)
  schema_version = _scalarint(database, "SELECT schema_version FROM library_meta WHERE singleton=1", error)
  created_at = _scalartext(database, "SELECT created_at FROM library_meta WHERE singleton=1", error)
  profile_id = _scalartext(database, "SELECT c.profile_id FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.state='published' AND g.generation=" || generation, error)
  profile_hash = _scalartext(database, "SELECT c.profile_hash FROM published_generations g JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE g.state='published' AND g.generation=" || generation, error)
  updated_at = _scalartext(database, "SELECT strftime('%Y-%m-%dT%H:%M:%fZ','now')", error)
  sidecars = ""
  if _sidecarprojection(database, generation, sidecars, error) \= 0 then return -4
  if library_id = "" | schema_version < 1 | created_at = "" | profile_id = "" | profile_hash = "" | updated_at = "" then return -4
  manifest = "{" || jsonquote("bundle_format_version") || ":2," || jsonquote("schema_version") || ":" || schema_version || "," || jsonquote("library_id") || ":" || jsonquote(library_id) || "," || jsonquote("created_at") || ":" || jsonquote(created_at) || "," || jsonquote("published_generation") || ":" || generation || "," || jsonquote("profile_id") || ":" || jsonquote(profile_id) || "," || jsonquote("profile_hash") || ":" || jsonquote(profile_hash) || "," || jsonquote("required_capabilities") || ":[" || jsonquote("sqlite-boundary-v1") || "]," || jsonquote("sidecars") || ":[" || sidecars || "]," || jsonquote("migration_pending") || ":false," || jsonquote("recovery_pending") || ":false," || jsonquote("updated_at") || ":" || jsonquote(updated_at) || "}"
  return 0

_sidecarprojection: procedure = .int
  arg database = .binary, generation = .int, expose projection = .string, expose error = .string
  projection = ""
  prepared = .binary
  sql = "SELECT vector_generation_id,semantic_generation,embedding_profile_id,sidecar_name,sidecar_checksum,dimension FROM vector_generations WHERE state='published' AND semantic_generation=?1 ORDER BY embedding_profile_id,vector_generation_id"
  if sqliteprepare(database, sql, prepared) \= 0 then return _sqlitefailure("prepare sidecar projection", error)
  call sqlitebindint prepared, 1, generation
  do forever
    step_status = sqlitestep(prepared)
    if step_status = 101 then leave
    if step_status \= 100 then do
      call sqlitefinalize prepared
      return _sqlitefailure("step sidecar projection", error)
    end
    vector_generation_id = ""; semantic_generation = 0; embedding_profile_id = ""; sidecar_name = ""; sidecar_checksum = ""; dimension = 0
    column_status = sqlitecolumntext(prepared, 0, vector_generation_id)
    column_status = column_status | sqlitecolumnint(prepared, 1, semantic_generation)
    column_status = column_status | sqlitecolumntext(prepared, 2, embedding_profile_id)
    column_status = column_status | sqlitecolumntext(prepared, 3, sidecar_name)
    column_status = column_status | sqlitecolumntext(prepared, 4, sidecar_checksum)
    column_status = column_status | sqlitecolumnint(prepared, 5, dimension)
    if column_status \= 0 then do
      call sqlitefinalize prepared
      return _sqlitefailure("read sidecar projection", error)
    end
    if projection \= "" then projection = projection || ","
    projection = projection || "{" || jsonquote("vector_generation_id") || ":" || jsonquote(vector_generation_id) || "," || jsonquote("semantic_generation") || ":" || semantic_generation || "," || jsonquote("embedding_profile_id") || ":" || jsonquote(embedding_profile_id) || "," || jsonquote("name") || ":" || jsonquote(sidecar_name) || "," || jsonquote("sha256") || ":" || jsonquote(sidecar_checksum) || "," || jsonquote("dimension") || ":" || dimension || "}"
  end
  call sqlitefinalize prepared
  return 0

_manifestsidecarstate: procedure = .int
  arg document = .jsondocument, sidecars = .int, database = .binary, generation = .int, path = .string, expose error = .string
  manifest_count = document.node_count(sidecars)
  database_count = _scalarint(database, "SELECT count(*) FROM vector_generations WHERE state='published' AND semantic_generation=" || generation, error)
  if database_count < 0 then return -1
  do i = 1 to manifest_count
    item = document.element(sidecars, i)
    vector_generation_id = ""; semantic_generation = 0; embedding_profile_id = ""; sidecar_name = ""; sidecar_checksum = ""; dimension = 0
    if document.node_type(item) \= "object" | document.node_string(document.member(item, "vector_generation_id"), vector_generation_id) \= 0 | document.node_int(document.member(item, "semantic_generation"), semantic_generation) \= 0 | document.node_string(document.member(item, "embedding_profile_id"), embedding_profile_id) \= 0 | document.node_string(document.member(item, "name"), sidecar_name) \= 0 | document.node_string(document.member(item, "sha256"), sidecar_checksum) \= 0 | document.node_int(document.member(item, "dimension"), dimension) \= 0 then return -1
    if semantic_generation \= generation | dimension < 1 | _safesidecarname(sidecar_name) \= 1 | _validsha256(sidecar_checksum) \= 1 | rxfs..isfile(path || "/" || sidecar_name) \= 1 then return -1
    sql = "SELECT count(*) FROM vector_generations WHERE state='published' AND vector_generation_id=" || _sqlquote(vector_generation_id) || " AND semantic_generation=" || semantic_generation || " AND embedding_profile_id=" || _sqlquote(embedding_profile_id) || " AND sidecar_name=" || _sqlquote(sidecar_name) || " AND sidecar_checksum=" || _sqlquote(sidecar_checksum) || " AND dimension=" || dimension
    if _scalarint(database, sql, error) \= 1 then return -1
  end
  if manifest_count = database_count then return 1
  if manifest_count < database_count then return 0
  return -1

_activesidecarfilesvalid: procedure = .int
  arg database = .binary, generation = .int, path = .string, expose error = .string
  prepared = .binary
  if sqliteprepare(database, "SELECT sidecar_name,sidecar_checksum FROM vector_generations WHERE state='published' AND semantic_generation=?1", prepared) \= 0 then return -1
  call sqlitebindint prepared, 1, generation
  do forever
    step_status = sqlitestep(prepared)
    if step_status = 101 then leave
    if step_status \= 100 then do
      call sqlitefinalize prepared
      return -1
    end
    sidecar_name = ""; expected_checksum = ""
    column_status = sqlitecolumntext(prepared, 0, sidecar_name)
    column_status = column_status | sqlitecolumntext(prepared, 1, expected_checksum)
    actual_checksum = ""; byte_count = 0; detail = ""
    if column_status \= 0 | _safesidecarname(sidecar_name) \= 1 | rxfs..isfile(path || "/" || sidecar_name) \= 1 | ragfile..sha256filebounded(path || "/" || sidecar_name, 2147483647, actual_checksum, byte_count, detail) \= 0 | actual_checksum \= expected_checksum then do
      call sqlitefinalize prepared
      if detail \= "" then error = detail
      return 0
    end
  end
  call sqlitefinalize prepared
  return 1

_safesidecarname: procedure = .int
  arg value = .string
  if value = "" | length(value) > 180 | pos("/", value) > 0 | pos("\\", value) > 0 | pos("..", value) > 0 then return 0
  return verify(value, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-") = 0

_validsha256: procedure = .int
  arg value = .string
  return length(value) = 64 & verify(value, "0123456789abcdef") = 0

_statusprojection: procedure = .int
  arg database = .binary, expose library_id = .string, expose schema_version = .int, expose generation = .int, expose profile_id = .string, expose profile_hash = .string, expose error = .string
  prepared = .binary
  sql = "SELECT m.library_id,m.schema_version,m.published_generation,c.profile_id,c.profile_hash FROM library_meta m JOIN published_generations g ON g.generation=m.published_generation JOIN config_snapshots c ON c.config_snapshot_id=g.config_snapshot_id WHERE m.singleton=1 AND g.state='published'"
  if sqliteprepare(database, sql, prepared) \= 0 then return _sqlitefailure("prepare manifest projection", error)
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    error = "published generation projection is missing"
    return -4
  end
  library_id = ""; schema_version = 0; generation = 0; profile_id = ""; profile_hash = ""
  status = sqlitecolumntext(prepared, 0, library_id)
  status = status | sqlitecolumnint(prepared, 1, schema_version)
  status = status | sqlitecolumnint(prepared, 2, generation)
  status = status | sqlitecolumntext(prepared, 3, profile_id)
  status = status | sqlitecolumntext(prepared, 4, profile_hash)
  call sqlitefinalize prepared
  if status \= 0 then return _sqlitefailure("read manifest projection", error)
  return 0

_migrationrecord: procedure = .int
  arg database = .binary, version = .int, expose name = .string, expose checksum = .string, expose error = .string
  name = ""; checksum = ""
  if _tableexists(database, "schema_migrations", error) \= 1 then return 0
  prepared = .binary
  if sqliteprepare(database, "SELECT name,checksum FROM schema_migrations WHERE version=?1", prepared) \= 0 then return _sqlitefailure("prepare migration lookup", error)
  call sqlitebindint prepared, 1, version
  step_status = sqlitestep(prepared)
  if step_status = 100 then do
    column_status = sqlitecolumntext(prepared, 0, name)
    column_status = column_status | sqlitecolumntext(prepared, 1, checksum)
    call sqlitefinalize prepared
    if column_status \= 0 then return _sqlitefailure("read migration lookup", error)
    return 1
  end
  call sqlitefinalize prepared
  if step_status = 101 then return 0
  return _sqlitefailure("step migration lookup", error)

_tableexists: procedure = .int
  arg database = .binary, table_name = .string, expose error = .string
  prepared = .binary
  if sqliteprepare(database, "SELECT count(*) FROM sqlite_master WHERE type IN('table','view') AND name=?1", prepared) \= 0 then return _sqlitefailure("prepare table lookup", error)
  call sqlitebindtext prepared, 1, table_name
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    return _sqlitefailure("step table lookup", error)
  end
  found = 0
  status = sqlitecolumnint(prepared, 0, found)
  call sqlitefinalize prepared
  if status \= 0 then return _sqlitefailure("read table lookup", error)
  return found

_scalarint: procedure = .int
  arg database = .binary, sql = .string, expose error = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 then do
    ignored = _sqlitefailure("prepare integer query", error)
    return -1
  end
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    ignored = _sqlitefailure("step integer query", error)
    return -1
  end
  value = 0
  status = sqlitecolumnint(prepared, 0, value)
  call sqlitefinalize prepared
  if status \= 0 then do
    ignored = _sqlitefailure("read integer query", error)
    return -1
  end
  return value

_scalartext: procedure = .string
  arg database = .binary, sql = .string, expose error = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 then do
    ignored = _sqlitefailure("prepare text query", error)
    return ""
  end
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    ignored = _sqlitefailure("step text query", error)
    return ""
  end
  value = ""
  status = sqlitecolumntext(prepared, 0, value)
  call sqlitefinalize prepared
  if status \= 0 then do
    ignored = _sqlitefailure("read text query", error)
    return ""
  end
  return value

_rowcount: procedure = .int
  arg database = .binary, sql = .string, expose error = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 then do
    ignored = _sqlitefailure("prepare row query", error)
    return -1
  end
  count = 0
  do forever
    status = sqlitestep(prepared)
    if status = 101 then leave
    if status \= 100 then do
      call sqlitefinalize prepared
      ignored = _sqlitefailure("step row query", error)
      return -1
    end
    count = count + 1
  end
  call sqlitefinalize prepared
  return count

_sqlquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "''") || "'"

_sqlitefailure: procedure = .int
  arg prefix = .string, expose error = .string
  boundary_code = 0; sqlite_code = 0; sqlite_extended = 0; operation = ""; message = ""
  call sqliteerrorextended boundary_code, sqlite_code, sqlite_extended, operation, message
  error = prefix || ": " || message || " [boundary=" || boundary_code || ",sqlite=" || sqlite_code || ",extended=" || sqlite_extended || ",operation=" || operation || "]"
  return -3

_generationfailure: procedure = .int
  arg database = .binary, prefix = .string, expose error = .string
  ignored = _sqlitefailure(prefix, error)
  call sqliteexec database, "ROLLBACK"
  return -3

_initfailure: procedure = .int
  arg database = .binary, path = .string, prefix = .string, expose error = .string
  ignored = _sqlitefailure(prefix, error)
  call sqliteexec database, "ROLLBACK"
  call sqliteclose database
  call _removefailedlibrary path
  return -3

_removefailedlibrary: procedure
  arg path = .string
  call rxfs..delete path || "/manifest.json.new"
  call rxfs..delete path || "/manifest.json"
  call rxfs..delete path || "/library.sqlite-wal"
  call rxfs..delete path || "/library.sqlite-shm"
  call rxfs..delete path || "/library.sqlite"
  call rxfs..rmdir path
  return

_addissue: procedure = .string
  arg summary = .string, issue = .string
  if summary = "" then return issue
  return summary || "," || issue
