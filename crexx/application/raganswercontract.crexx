options levelg
namespace raganswercontract expose answercontractversion answerprompt answermessages answerresponseschema
import provider_contract

answercontractversion: procedure = .string
  return "crexx-rag.answer-contract/2"

answerprompt: procedure = .string
  arg objective=.string
  return objective || "0A"x || "Citation contract: use only citation IDs present in this request. For answer-context/3 these are short references such as E1; copy them exactly into the citations array. Put prose in answer, without citation labels or IDs. Footnote numbers, speaker labels and names in source text are not citation IDs. The application restores canonical source citations after validation."

answermessages: procedure = .providermessage[]
  arg objective=.string,context=.string
  messages=.providermessage[]
  messages[1]=.providermessage("system",answerprompt(objective))
  messages[2]=.providermessage("user",context)
  return messages

answerresponseschema: procedure = .string
  return '{"type":"object","additionalProperties":false,"required":["grounding","answer","citations"],"properties":{"grounding":{"type":"string","enum":["supported","partial","insufficient"]},"answer":{"type":"string"},"citations":{"type":"array","items":{"type":"string"}}}}'
