options levelg

namespace ragqueryprovider expose generatequeryembedding generatequeryanswer generatereportnarrative

import rxfnsb
import rxfs
import provider_contract
import industrial_provider
import llama_provider
import codex_provider
import ragconfig
import raganswercontract
import ragreportcontract
import ragproviderdiagnostics

/* Read-only query calls use the same generic provider protocol as durable
 * workers. They deliberately return provider results to the application for
 * RAG-specific validation; no provider output can change library state. */
generatequeryembedding: procedure = .int
  arg provider_config = .ragproviderconfig, question = .string, privacy = .string, dimension = .int, request_identity = .string, expose result = .providerresult, expose error = .string
  result = .providerresult(); error = ""
  if question = "" | dimension < 1 | request_identity = "" then do; error = "query embedding input is invalid"; return -1; end
  if provider_config.kind() = "codex" then do; error = "Codex does not provide embedding generation"; return -1; end
  if provider_config.kind() = "llama" then do
    local_backend = .llamaprovider(provider_config.model_path(),provider_config.timeout_ms())
    local_messages = .providermessage[]; local_inputs = .string[]; local_inputs[1] = question
    local_request = .providerrequest("embed","query-embedding",provider_config.model(),local_messages,local_inputs,"",provider_config.timeout_ms(),1,privacy,request_identity,request_identity,0,dimension)
    result = local_backend.embed(local_request)
    call local_backend.close()
    if result.status() \= 0 then do; error = _providererror(result,"local query embedding failed"); return -2; end
    local_vectors = result.embeddings()
    if local_vectors.0 \= 1 | local_vectors[1].valid() \= 1 | local_vectors[1].count() \= dimension then do; error = "local query embedding shape is invalid"; return -2; end
    return 0
  end
  host = ""; base_path = ""; port = 0; tls = 0
  if _parseurl(provider_config.base_url(), host, port, tls, base_path) \= 0 then do; error = "query embedding provider URL is invalid"; return -1; end
  secret = _secret(provider_config, error)
  if error \= "" then return -1
  protocol = provider_config.kind()
  backend = .industrialprovider(protocol, host, port, tls, base_path, secret, provider_config.route_class(), provider_config.input_price_microunits_per_million(), provider_config.output_price_microunits_per_million(), provider_config.maximum_batch_size())
  messages = .providermessage[]; inputs = .string[]; inputs[1] = question
  request = .providerrequest("embed", "embedding", provider_config.model(), messages, inputs, "", provider_config.timeout_ms(), provider_config.max_attempts(), privacy, request_identity, request_identity, 0, dimension, 0, -1, provider_config.initial_backoff_ms(), provider_config.maximum_backoff_ms(), provider_config.jitter_ms())
  result = backend.embed(request)
  if result.status() \= 0 then do; error = _providererror(result, "query embedding provider failed"); return -2; end
  if result.provider() \= _backendidentity(provider_config.kind()) | result.model() \= provider_config.model() | result.request_id() \= request_identity then do; error = "query embedding provider identity is invalid"; return -2; end
  vectors = result.embeddings()
  if vectors.0 \= 1 | vectors[1].valid() \= 1 | vectors[1].count() \= dimension then do; error = "query embedding provider returned an incompatible vector"; return -2; end
  return 0

generatequeryanswer: procedure = .int
  arg provider_config = .ragproviderconfig, answer_context = .string, privacy = .string, maximum_output_tokens = .int, minimum_allowance = .int, request_identity = .string, expose result = .providerresult, expose allowance_before = .int, expose allowance_after = .int, expose error = .string, system_prompt = .string, temperature_millionths = 0
  result = .providerresult(); allowance_before = -1; allowance_after = -1; error = ""
  if answer_context = "" | request_identity = "" | maximum_output_tokens < 1 | system_prompt = "" then do; error = "query answer input is invalid"; return -1; end
  messages=answermessages(system_prompt,answer_context);inputs=.string[]
  schema=answerresponseschema()
  request = .providerrequest("generate_structured", "answerer", provider_config.model(), messages, inputs, schema, provider_config.timeout_ms(), provider_config.max_attempts(), privacy, request_identity, request_identity, maximum_output_tokens, 0, 0, temperature_millionths, provider_config.initial_backoff_ms(), provider_config.maximum_backoff_ms(), provider_config.jitter_ms(), provider_config.reasoning_effort())
  if provider_config.kind() = "codex" then return _codexanswer(provider_config, request, minimum_allowance, result, allowance_before, allowance_after, error)
  host = ""; base_path = ""; port = 0; tls = 0
  if _parseurl(provider_config.base_url(), host, port, tls, base_path) \= 0 then do; error = "query answer provider URL is invalid"; return -1; end
  secret = _secret(provider_config, error)
  if error \= "" then return -1
  protocol = provider_config.kind()
  backend = .industrialprovider(protocol, host, port, tls, base_path, secret, provider_config.route_class(), provider_config.input_price_microunits_per_million(), provider_config.output_price_microunits_per_million(), provider_config.maximum_batch_size())
  result = backend.generate_structured(request)
  if result.status() \= 0 then do; error = _providererror(result, "query answer provider failed"); return -2; end
  if result.provider() \= _backendidentity(provider_config.kind()) | result.model() \= provider_config.model() | result.request_id() = "" then do; error = "query answer provider identity is invalid"; return -2; end
  return 0

generatereportnarrative: procedure = .int
  arg provider_config = .ragproviderconfig, report_context = .string, privacy = .string, maximum_output_tokens = .int, minimum_allowance = .int, request_identity = .string, expose result = .providerresult, expose allowance_before = .int, expose allowance_after = .int, expose error = .string, system_prompt = .string, temperature_millionths = 0
  result = .providerresult(); allowance_before = -1; allowance_after = -1; error = ""
  if report_context = "" | request_identity = "" | maximum_output_tokens < 1 | system_prompt = "" then do; error = "library report narrative input is invalid"; return -1; end
  messages=reportmessages(system_prompt,report_context);inputs=.string[]
  schema=reportresponseschema()
  request = .providerrequest("generate_structured", "advisory", provider_config.model(), messages, inputs, schema, provider_config.timeout_ms(), provider_config.max_attempts(), privacy, request_identity, request_identity, maximum_output_tokens, 0, 0, temperature_millionths, provider_config.initial_backoff_ms(), provider_config.maximum_backoff_ms(), provider_config.jitter_ms(), provider_config.reasoning_effort())
  if provider_config.kind() = "codex" then return _codexanswer(provider_config, request, minimum_allowance, result, allowance_before, allowance_after, error)
  host = ""; base_path = ""; port = 0; tls = 0
  if _parseurl(provider_config.base_url(), host, port, tls, base_path) \= 0 then do; error = "library report narrative provider URL is invalid"; return -1; end
  secret = _secret(provider_config, error)
  if error \= "" then return -1
  protocol = provider_config.kind()
  backend = .industrialprovider(protocol, host, port, tls, base_path, secret, provider_config.route_class(), provider_config.input_price_microunits_per_million(), provider_config.output_price_microunits_per_million(), provider_config.maximum_batch_size())
  result = backend.generate_structured(request)
  if result.status() \= 0 then do; error = _providererror(result, "library report narrative provider failed"); return -2; end
  if result.provider() \= _backendidentity(provider_config.kind()) | result.model() \= provider_config.model() | result.request_id() = "" then do; error = "library report narrative provider identity is invalid"; return -2; end
  return 0

_codexanswer: procedure = .int
  arg provider_config = .ragproviderconfig, request = .providerrequest, minimum_allowance = .int, expose result = .providerresult, expose allowance_before = .int, expose allowance_after = .int, expose error = .string
  executable = codexexecutable()
  if executable = "" then do; error = "Codex executable is unavailable"; return -1; end
  working_directory = _temporarydirectory(error)
  if working_directory = "" then return -1
  observer = .codexnoopobserver(); backend = .codexprovider(executable, working_directory, observer)
  account_type = ""; plan_type = ""; used_percent = -1
  if backend.account_status(provider_config.timeout_ms(), account_type, plan_type, used_percent, error) \= 0 then do; call backend.close(); call rxfs..rmdir working_directory; return -2; end
  if used_percent >= 0 then allowance_before = 100 - used_percent
  if allowance_before >= 0 & allowance_before < minimum_allowance then do
    call backend.close(); call rxfs..rmdir working_directory
    error = "Codex remaining allowance is below the configured minimum"
    return -2
  end
  result = backend.generate_structured(request)
  after_account = ""; after_plan = ""; used_after = -1; allowance_error = ""
  if backend.account_status(provider_config.timeout_ms(), after_account, after_plan, used_after, allowance_error) = 0 & used_after >= 0 then allowance_after = 100 - used_after
  call backend.close(); call rxfs..rmdir working_directory
  if result.status() \= 0 then do; error = _providererror(result, "Codex query answer failed"); return -2; end
  if result.provider() \= "codex" | result.model() \= provider_config.model() | result.request_id() = "" then do; error = "Codex query answer identity is invalid"; return -2; end
  return 0

_secret: procedure = .string
  arg provider_config = .ragproviderconfig, expose error = .string
  error = ""; credential = provider_config.credential(); secret = ""
  if credential.empty() = 0 then secret = getenv(credential.name())
  if provider_config.route_class() = "hosted" & secret = "" then do; error = "provider credential reference is unavailable"; return ""; end
  if pos("0A"x, secret) > 0 | pos("0D"x, secret) > 0 then do; error = "provider credential is invalid"; return ""; end
  return secret

_temporarydirectory: procedure = .string
  arg expose error = .string
  error = ""; root = getenv("TMPDIR"); if root = "" then root = "/tmp/"
  if right(root, 1) \= "/" then root = root || "/"
  seed = time("us")
  do attempt = 1 to 32
    path = root || "crexxrag-codex-query-" || seed || "-" || attempt
    if rxfs..mkdir(path) = 0 then return path
  end
  error = "cannot create an isolated Codex query directory"
  return ""

_parseurl: procedure = .int
  arg url = .string, expose host = .string, expose port = .int, expose tls = .int, expose base_path = .string
  host = ""; base_path = ""; port = 0; tls = 0; rest = ""
  if left(url, 8) = "https://" then do; tls = 1; port = 443; rest = substr(url, 9); end
  else if left(url, 7) = "http://" then do; rest = substr(url, 8); port = 80; end
  else return -1
  slash = pos("/", rest)
  if slash = 0 then authority = rest
  else do; authority = left(rest, slash - 1); base_path = substr(rest, slash); end
  colon = lastpos(":", authority)
  if colon > 0 then do
    port_text = substr(authority, colon + 1); host = left(authority, colon - 1)
    if datatype(port_text, "W") \= 1 then return -1
    port = port_text as .int
  end
  else host = authority
  if host = "" | port < 1 | port > 65535 | pos("00"x, base_path) > 0 then return -1
  return 0

_backendidentity: procedure = .string
  arg kind = .string
  if kind = "openai-compatible" then return "openai"
  return kind

_providererror: procedure = .string
  arg result = .providerresult, fallback = .string
  failure = result.error(); message = failure.message()
  if message = "" then return fallback
  return fallback || ": " || message
