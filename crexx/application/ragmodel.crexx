options levelg

namespace ragmodel expose ragerror ragoperationresult ragrequestoptions ragplan ragtrace ragpathresult ragtimelineentry ragtimelineresult ragreviewitem ragreviewpage ragvalidationissue ragvalidationresult validregistryid validenvname

import rxfnsb

ragerror: class
  _category = .string
  _code = .int
  _retryable = .int
  _message = .string

  *: factory
    arg category = "none", code = 0, retryable = 0, message = ""
    _category = category
    _code = code
    _retryable = retryable
    _message = message
    return

  category: method = .string
    return _category
  code: method = .int
    return _code
  retryable: method = .int
    return _retryable
  message: method = .string
    return _message
  ok: method = .int
    return _code = 0

ragoperationresult: class
  _operation = .string
  _status = .string
  _error = .ragerror

  *: factory
    arg operation = .string, status = .string, error = .ragerror
    _operation = operation
    _status = status
    _error = error
    return

  operation: method = .string
    return _operation
  status: method = .string
    return _status
  error: method = .ragerror
    return _error
  ok: method = .int
    return _error.ok()

ragrequestoptions: class
  _profile_id = .string
  _cursor = .string
  _limit = .int
  _include_trace = .int

  *: factory
    arg profile_id = .string, cursor = "", limit = 50, include_trace = 1
    _profile_id = profile_id
    _cursor = cursor
    _limit = limit
    _include_trace = include_trace
    return

  profile_id: method = .string
    return _profile_id
  cursor: method = .string
    return _cursor
  limit: method = .int
    return _limit
  include_trace: method = .int
    return _include_trace

