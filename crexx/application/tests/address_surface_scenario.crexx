options levelg

namespace address_surface_scenario expose main

import rxfnsb
import rxjson
import rxhash
import ragfile
import rag_address_environment

main: procedure = .int
  arg args = .string[]
  if args.0 \= 2 then return 2
  library = args[1]; config_file = args[2]
  environment = addressenv("rag")
  if environment.environment_name() \= "RAG" | environment.environment_id() \= "rexx:RAG" then return 4
  lines = .string[]
  command = "LIBRARY OPEN " || library || " --config architecture-local --profile generic-profile --access plan --format json"
  address RAG (command) output lines
  if rc \= 0 | lines.0 \= 1 then do; say "ADDRESS_SURFACE_FAIL=open"; return 10; end
  if pos('"operation":"library.open"', lines[1]) = 0 then return 11
  clear lines
  address RAG "LIBRARY STATUS" output lines
  if rc \= 0 | lines.0 \= 1 | pos('"operation":"library.status"', lines[1]) = 0 | pos('"status":"ok"', lines[1]) = 0 then return 12
  status_document = .jsondocument(lines[1]); library_id = ""
  clear lines
  address RAG "QUERY INSPECT synthetic --limit 200" output lines
  if rc \= 0 | pos('"effective_passage_limit":200',lines[1]) = 0 then do;say "ADDRESS_SURFACE_FAIL=query limit 200";return 47;end
  clear lines
  address RAG "QUERY INSPECT synthetic --limit 201" output lines
  if rc \= 2 then do;say "ADDRESS_SURFACE_FAIL=query limit 201 accepted";return 48;end
  clear lines
  address RAG "QUERY INSPECT synthetic" output lines
  if rc \= 0 | pos('"effective_passage_limit":12',lines[1]) = 0 then do;say "ADDRESS_SURFACE_FAIL=query default changed";return 49;end
  records_node = status_document.member(status_document.root(), "records")
  record_node = status_document.element(records_node, 1)
  fields_node = status_document.member(record_node, "fields")
  if status_document.node_string(status_document.member(fields_node, "library_id"), library_id) \= 0 then return 13
  clear lines
  address RAG "LIBRARY REPORT --top 3" output lines
  if rc \= 0 | lines.0 \= 1 | pos('"operation":"library.report"', lines[1]) = 0 | pos('"schema":"crexx-rag.library-report/1"', lines[1]) = 0 | pos('"provider_calls":0', lines[1]) = 0 then return 22
  clear lines
  address RAG "LIBRARY TREND --limit 5" output lines
  if rc \= 0 | lines.0 \= 1 | pos('"operation":"library.trend"', lines[1]) = 0 | pos('"state":"no-observations"', lines[1]) = 0 then return 23
  clear lines
  address RAG "LIBRARY SNAPSHOT --trigger manual --reason denied" output lines
  if rc \= 4 then return 24
  clear lines
  address RAG "MAINTAIN PLAN" output lines
  if rc \= 0 | lines.0 \= 1 | pos('"operation":"maintain.plan"', lines[1]) = 0 | pos('"maintenance_digest":', lines[1]) = 0 then return 20
  clear lines
  address RAG "MAINTAIN APPLY --plan-json {} --expect-digest 00" output lines
  if rc \= 4 then return 21
  clear lines
  failed_open = "LIBRARY OPEN " || library || " --config does-not-match --config-file " || "22"x || config_file || "22"x || " --profile generic-profile --access read --format json"
  address RAG (failed_open) output lines
  if rc \= 2 then return 14
  clear lines
  address RAG "LIBRARY STATUS" output lines
  if rc \= 0 | pos(library_id, lines[1]) = 0 then return 15
  clear lines
  config_open = "LIBRARY OPEN " || library || " --config-file " || "22"x || config_file || "22"x || " --profile generic-profile --access read --format json"
  address RAG (config_open) output lines
  if rc \= 0 | pos('"config_id":"google-gemini"', lines[1]) = 0 then return 16
  clear lines
  address RAG "PROVIDER STATUS" output lines
  if rc \= 0 | pos('"provider_id":"gemini-generate"', lines[1]) = 0 then return 17
  clear lines
  address RAG "INGEST APPLY --plan-json {} --expect-digest 00" output lines
  if rc \= 4 then return 18
  clear lines
  address RAG "LIBRARY CLOSE" output lines
  if rc \= 0 | lines.0 \= 1 then return 19
  /* The session must see edits to its selected file, including invalid-file
     holds and repair. Never modify the repository fixture. */
  raw = .binary; bytes = 0; error = ""
  if ragfile..readbinaryfilebounded(config_file,65536,raw,bytes,error) \= 0 then return 25
  policy_path = library || "/address-policy.conf"; replacement_path = library || "/address-replacement.conf"
  if ragfile..writebinaryfile(policy_path,raw,error) \= 0 | ragfile..writebinaryfile(replacement_path,raw,error) \= 0 then return 26
  clear lines
  command = "LIBRARY OPEN " || library || " --config-file " || "22"x || policy_path || "22"x || " --profile generic-profile --access admin --format json"
  address RAG (command) output lines
  if rc \= 0 then return 27
  clear lines
  address RAG "CONFIG PROMPT --role answerer" output lines
  if rc \= 0 | pos('"configured_objective":',lines[1]) = 0 then return 28
  clear lines
  command = 'CONFIG SET --key role.answerer.system_prompt --value "ADDRESS updated objective." --expect-sha256 ' || rxhash..sha256hex(raw)
  address RAG (command) output lines
  if rc \= 0 then do;say "ADDRESS_POLICY_FAIL edit " || lines[1];return 29;end
  clear lines
  address RAG "CONFIG PROMPT --role answerer" output lines
  if rc \= 0 | pos('"configured_objective":"ADDRESS updated objective."',lines[1]) = 0 then do;say "ADDRESS_POLICY_FAIL stale prompt " || lines[1];return 30;end
  function_args = .string[]
  function_args[1]="--config-file=" || policy_path; function_args[2]="--profile=generic-profile"
  function_args[3]="config"; function_args[4]="prompt"; function_args[5]="--role=answerer"
  function_environment = addressenv("rag") as .addressfunctionenvironment
  function_result = function_environment.invoke(.addressfunctionrequest("RAG","COMMAND",function_args,.standardaddresssandbox()))
  if function_result.get_rc() \= 0 | pos('"configured_objective":"ADDRESS updated objective."',function_result.get_result()) = 0 then do;say "ADDRESS_POLICY_FAIL function stale prompt";return 43;end
  broken = "format = broken" || "0A"x
  if ragfile..writebinaryfile(policy_path,broken as .binary,error) \= 0 then return 31
  clear lines
  address RAG "CONFIG PROMPT --role answerer" output lines
  if rc \= 3 then do;say "ADDRESS_POLICY_FAIL invalid file reused registry";return 32;end
  clear lines
  address RAG "CONFIG SHOW" output lines
  if rc \= 0 | pos('"valid":false',lines[1]) = 0 then return 33
  clear lines
  clear function_args
  function_args[1]="--config-file=" || policy_path; function_args[2]="--access=admin"
  function_args[3]="config"; function_args[4]="replace"; function_args[5]="--input=" || replacement_path
  function_args[6]="--expect-sha256=" || rxhash..sha256hex(broken as .binary)
  address RAG "LIBRARY CLOSE" output lines
  if rc \= 0 then return 44
  unbound_environment = addressenv("rag") as .addressfunctionenvironment
  function_result = unbound_environment.invoke(.addressfunctionrequest("RAG","COMMAND",function_args,.standardaddresssandbox()))
  if function_result.get_rc() \= 0 then do;say "ADDRESS_POLICY_FAIL unbound repair " || function_result.get_result();return 34;end
  clear lines
  command = "LIBRARY OPEN " || library || " --config-file " || "22"x || policy_path || "22"x || " --profile generic-profile --access admin --format json"
  address RAG (command) output lines
  if rc \= 0 then return 45
  clear lines
  address RAG "CONFIG PROMPT --role answerer" output lines
  if rc \= 0 | pos('"configured_objective":"ADDRESS updated objective."',lines[1]) > 0 then return 35
  if ragfile..readbinaryfilebounded(policy_path,65536,raw,bytes,error) \= 0 then return 36
  clear lines
  command = 'CONFIG SET --key config.id --value address-edited --expect-sha256 ' || rxhash..sha256hex(raw)
  address RAG (command) output lines
  if rc \= 0 then return 37
  clear lines
  address RAG "CONFIG CHECK" output lines
  if rc \= 0 | pos('"config_id":"address-edited"',lines[1]) = 0 then do;say "ADDRESS_POLICY_FAIL stale config identity " || lines[1];return 38;end
  if ragfile..readbinaryfilebounded(policy_path,65536,raw,bytes,error) \= 0 then return 39
  clear lines
  command = 'CONFIG SET --key profiles --value it-architecture-profile --expect-sha256 ' || rxhash..sha256hex(raw)
  address RAG (command) output lines
  if rc \= 0 then return 40
  clear lines
  address RAG "CONFIG PROMPT --role answerer" output lines
  if rc \= 5 then do;say "ADDRESS_POLICY_FAIL removed profile reused registry";return 41;end
  clear lines
  address RAG "LIBRARY CLOSE" output lines
  if rc \= 0 then return 42
  say "ADDRESS_SURFACE_OK library_id=" || library_id || " report=deterministic trend=empty snapshot=denied maintenance=plan maintenance_apply=denied access_denial=ingest config_file=bound failed_open=atomic"
  return 0
