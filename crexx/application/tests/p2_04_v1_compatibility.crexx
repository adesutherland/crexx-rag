options levelg

import rxfnsb
import sqlite_boundary
import ragstore
import ragcompat
import system

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_04_FAIL=" || label
    return 1
  end
  return 0

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    return -1
  end
  value = -1
  status = sqlitecolumnint(prepared, 0, value)
  call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

createv1fixture: procedure = .int
  arg path = .string
  errors = 0
  errors = errors + check(createdir(path) = 0, "create version-1 fixture directory")
  errors = errors + check(lineout(path || "/manifest.json", '{"format":"crexx-rag-library","version":1,"database":"library.sqlite","vector_index":"vectors.faiss"}') = 0, "write version-1 manifest")
  errors = errors + check(lineout(path || "/manifest.json") = 0, "close version-1 manifest")
  if errors \= 0 then return 1
  database = .binary
  errors = errors + check(sqliteopenmode(path || "/library.sqlite", "create", database) = 0, "create version-1 database")
  if errors \= 0 then return 1
  schema = "PRAGMA foreign_keys=ON;"
  schema = schema || "CREATE TABLE entities(id TEXT PRIMARY KEY,node_type TEXT NOT NULL DEFAULT 'entity',label TEXT NOT NULL,description TEXT NOT NULL,metadata_json TEXT NOT NULL DEFAULT '{}');"
  schema = schema || "CREATE TABLE edges(id INTEGER PRIMARY KEY AUTOINCREMENT,source_id TEXT NOT NULL,target_id TEXT NOT NULL,relationship_type TEXT NOT NULL DEFAULT 'relationship',label TEXT NOT NULL,weight REAL NOT NULL DEFAULT 1.0,metadata_json TEXT NOT NULL DEFAULT '{}',FOREIGN KEY(source_id) REFERENCES entities(id),FOREIGN KEY(target_id) REFERENCES entities(id));"
  schema = schema || "CREATE TABLE documents(id INTEGER PRIMARY KEY AUTOINCREMENT,source_uri TEXT NOT NULL UNIQUE,title TEXT NOT NULL,content_hash TEXT NOT NULL,file_type INTEGER NOT NULL DEFAULT 0,source_type TEXT NOT NULL DEFAULT 'unknown',confidence REAL NOT NULL DEFAULT 1.0,captured_at TEXT NOT NULL DEFAULT '',event_start_at TEXT NOT NULL DEFAULT '',event_end_at TEXT NOT NULL DEFAULT '',metadata_json TEXT NOT NULL DEFAULT '{}',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);"
  schema = schema || "CREATE TABLE chunks(id INTEGER PRIMARY KEY AUTOINCREMENT,document_id INTEGER NOT NULL,chunk_index INTEGER NOT NULL,text TEXT NOT NULL,length INTEGER NOT NULL,start_offset INTEGER NOT NULL DEFAULT -1,end_offset INTEGER NOT NULL DEFAULT -1,source_type TEXT NOT NULL DEFAULT 'unknown',confidence REAL NOT NULL DEFAULT 1.0,captured_at TEXT NOT NULL DEFAULT '',event_start_at TEXT NOT NULL DEFAULT '',event_end_at TEXT NOT NULL DEFAULT '',metadata_json TEXT NOT NULL DEFAULT '{}',FOREIGN KEY(document_id) REFERENCES documents(id),UNIQUE(document_id,chunk_index));"
  schema = schema || "CREATE TABLE chunk_embeddings(chunk_id INTEGER NOT NULL,embedding_model TEXT NOT NULL,embedding_profile TEXT NOT NULL DEFAULT 'raw-text-v1',dimension INTEGER NOT NULL,vector BLOB NOT NULL,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(chunk_id,embedding_model),FOREIGN KEY(chunk_id) REFERENCES chunks(id));"
  schema = schema || "CREATE TABLE candidate_mentions(id INTEGER PRIMARY KEY AUTOINCREMENT,profile_id TEXT NOT NULL,source_uri TEXT NOT NULL DEFAULT '',chunk_id INTEGER NOT NULL,stage TEXT NOT NULL DEFAULT 'stage1',extractor TEXT NOT NULL DEFAULT 'deterministic',candidate TEXT NOT NULL,normalized_candidate TEXT NOT NULL,priority INTEGER NOT NULL DEFAULT 0,proper_count INTEGER NOT NULL DEFAULT 0,known_count INTEGER NOT NULL DEFAULT 0,cue_count INTEGER NOT NULL DEFAULT 0,metadata_json TEXT NOT NULL DEFAULT '{}',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,FOREIGN KEY(chunk_id) REFERENCES chunks(id),UNIQUE(profile_id,source_uri,chunk_id,stage,extractor,normalized_candidate));"
  schema = schema || "CREATE TABLE candidate_adjudications(profile_id TEXT NOT NULL,normalized_candidate TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',candidate_type TEXT NOT NULL DEFAULT '',canonical_label TEXT NOT NULL DEFAULT '',aliases TEXT NOT NULL DEFAULT '',disambiguation TEXT NOT NULL DEFAULT '',confidence REAL NOT NULL DEFAULT 0.0,adjudicator TEXT NOT NULL DEFAULT '',metadata_json TEXT NOT NULL DEFAULT '{}',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(profile_id,normalized_candidate));"
  schema = schema || "CREATE TABLE work_queue(profile_id TEXT NOT NULL,queue_name TEXT NOT NULL DEFAULT 'default',item_type TEXT NOT NULL DEFAULT 'work-item',item_id TEXT NOT NULL,subject_id INTEGER NOT NULL DEFAULT 0,source_uri TEXT NOT NULL DEFAULT '',title TEXT NOT NULL DEFAULT '',item_index INTEGER NOT NULL DEFAULT 0,score REAL NOT NULL DEFAULT 0.0,status TEXT NOT NULL DEFAULT 'pending',reason TEXT NOT NULL DEFAULT '',metadata_json TEXT NOT NULL DEFAULT '{}',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(profile_id,queue_name,item_id));"
  schema = schema || "CREATE TABLE work_attempts(id INTEGER PRIMARY KEY AUTOINCREMENT,profile_id TEXT NOT NULL,queue_name TEXT NOT NULL DEFAULT 'default',item_type TEXT NOT NULL DEFAULT 'work-item',item_id TEXT NOT NULL,subject_id INTEGER NOT NULL DEFAULT 0,worker TEXT NOT NULL DEFAULT '',model TEXT NOT NULL DEFAULT '',status TEXT NOT NULL DEFAULT '',accepted_nodes INTEGER NOT NULL DEFAULT 0,accepted_relationships INTEGER NOT NULL DEFAULT 0,raw_output TEXT NOT NULL DEFAULT '',metadata_json TEXT NOT NULL DEFAULT '{}',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);"
  errors = errors + check(sqliteexec(database, schema) = 0, "install version-1 schema")
  data = "INSERT INTO documents(id,source_uri,title,content_hash,file_type,source_type,confidence,captured_at,metadata_json) VALUES(1,'fixture://one','One','legacy-hash-one',1,'fixture',0.9,'2026-08-01T10:00:00Z','{}'),(2,'fixture://two','Two','legacy-hash-two',1,'fixture',0.8,'2026-08-02T10:00:00Z','{}');"
  data = data || "INSERT INTO chunks(id,document_id,chunk_index,text,length,start_offset,end_offset,source_type,metadata_json) VALUES(1,1,0,'Alpha architecture',18,0,18,'fixture','{}'),(2,1,1,'Beta service',12,19,31,'fixture','{}'),(3,2,0,'Gamma platform',14,0,14,'fixture','{}');"
  data = data || "INSERT INTO entities(id,node_type,label,description,metadata_json) VALUES('alpha','system','Alpha','Alpha system','{}'),('beta','service','Beta','Beta service','{}');"
  data = data || "INSERT INTO edges(id,source_id,target_id,relationship_type,label,weight,metadata_json) VALUES(1,'alpha','beta','depends-on','depends on',0.7,'{}');"
  data = data || "INSERT INTO chunk_embeddings(chunk_id,embedding_model,embedding_profile,dimension,vector) VALUES(1,'fixture-model','raw-text-v1',2,X'0000803F00000040'),(2,'broken-model','raw-text-v1',3,X'0000803F');"
  data = data || "INSERT INTO candidate_mentions(id,profile_id,source_uri,chunk_id,stage,extractor,candidate,normalized_candidate,priority,proper_count,metadata_json) VALUES(1,'fixture','fixture://one',1,'stage1','deterministic','Alpha','alpha',10,1,'{}');"
  data = data || "INSERT INTO candidate_adjudications(profile_id,normalized_candidate,status,candidate_type,canonical_label,aliases,confidence,adjudicator,metadata_json) VALUES('fixture','alpha','accepted','system','Alpha','alpha',0.9,'fixture','{}');"
  data = data || "INSERT INTO work_queue(profile_id,queue_name,item_type,item_id,subject_id,source_uri,title,item_index,score,status,reason,metadata_json) VALUES('fixture','extract','chunk','work-1',1,'fixture://one','One',0,0.5,'pending','fixture','{}');"
  data = data || "INSERT INTO work_attempts(id,profile_id,queue_name,item_type,item_id,subject_id,worker,model,status,accepted_nodes,accepted_relationships,raw_output,metadata_json) VALUES(1,'fixture','extract','chunk','work-1',1,'worker-1','fixture-model','completed',1,0,'{}','{}');"
  errors = errors + check(sqliteexec(database, data) = 0, "populate version-1 fixture")
  errors = errors + check(sqliteclose(database) = 0, "close version-1 fixture")
  if errors \= 0 then return 1
  say "P2_04_FIXTURE_OK documents=2 chunks=3 entities=2 edges=1 embeddings=2 candidates=2 work=1 attempts=1"
  return 0

dryrunscenario: procedure = .int
  arg cell = .string, source_path = .string, target_path = .string
  errors = 0; error = ""; report = .ragv1conversionreport
  errors = errors + check(planv1conversion(source_path, target_path, report, error) = 0, "plan conversion " || error)
  errors = errors + check(report.dry_run() = 1 & report.document_count() = 2 & report.chunk_count() = 3 & report.entity_count() = 2 & report.edge_count() = 1, "dry-run source counts")
  errors = errors + check(report.embedding_count() = 2 & report.imported_embedding_count() = 1 & report.candidate_count() = 2 & report.work_count() = 1 & report.attempt_count() = 1, "dry-run compatibility counts")
  errors = errors + check(report.quarantined_count() = 10 & report.source_writes() = 0 & report.target_created() = 0 & report.target_generation() = 0, "dry-run write and quarantine contract")
  errors = errors + check(pos("legacy digests", report.warnings()) > 0 & testdir(target_path) \= 0, "dry-run warnings and zero target")
  if errors \= 0 then return 1
  say "P2_04_DRY_RUN_OK cell=" || cell || " source_writes=0 target_created=0 documents=2 chunks=3 imported_embeddings=1 quarantined=10"
  return 0

importscenario: procedure = .int
  arg cell = .string, source_path = .string, target_path = .string
  errors = 0; error = ""; report = .ragv1conversionreport
  errors = errors + check(importv1library(source_path, target_path, "library-p2-04-" || cell, report, error) = 0, "import conversion " || error)
  errors = errors + check(report.dry_run() = 0 & report.source_writes() = 0 & report.target_created() = 1 & report.target_generation() = 2, "import publication report")
  if errors \= 0 then return 1
  store = .ragstorehandle; status = .ragstorestatus; verification = .ragverifyresult
  errors = errors + check(openragstore(target_path, "readonly", store, error) = 0, "open imported target " || error)
  if errors \= 0 then return 1
  errors = errors + check(storagestatus(store, status, error) = 0 & status.schema_version() = 2 & status.published_generation() = 2 & status.manifest_state() = "aligned", "imported schema and publication state")
  database = store.database()
  errors = errors + check(scalarint(database, "SELECT count(*) FROM sources") = 2 & scalarint(database, "SELECT count(*) FROM source_artifacts") = 2 & scalarint(database, "SELECT count(*) FROM source_revision_texts") = 2 & scalarint(database, "SELECT count(*) FROM source_revisions") = 2, "document and revision mappings")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM chunk_contents") = 3 & scalarint(database, "SELECT count(*) FROM revision_chunks") = 3 & scalarint(database, "SELECT count(*) FROM normalization_maps") = 3 & scalarint(database, "SELECT count(*) FROM chunks_fts") = 3, "chunk and search mappings")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM concepts") = 2 & scalarint(database, "SELECT count(*) FROM claims") = 0, "concept import and unverified edge quarantine")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM embedding_profiles") = 1 & scalarint(database, "SELECT count(*) FROM embeddings") = 1 & scalarint(database, "SELECT count(*) FROM revision_chunk_embeddings") = 1, "valid embedding import and invalid embedding exclusion")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM reviews") = 10 & scalarint(database, "SELECT count(*) FROM reviews WHERE review_type='legacy-unverified-claim'") = 1 & scalarint(database, "SELECT count(*) FROM reviews WHERE review_type='legacy-work-not-resumed'") = 1, "legacy quarantine review set")
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "verify imported target " || verification.summary() || " " || error)
  errors = errors + check(closeragstore(store, error) = 0, "close imported target " || error)
  replay = .ragv1conversionreport
  errors = errors + check(importv1library(source_path, target_path, "duplicate", replay, error) = -2, "existing conversion target rejected")
  if errors \= 0 then return 1
  say "P2_04_IMPORT_OK cell=" || cell || " source_writes=0 schema=2 generation=2 sources=2 chunks=3 concepts=2 claims=0 embeddings=1 reviews=10 verified=1"
  return 0

createinvalidfixture: procedure = .int
  arg path = .string
  errors = 0
  errors = errors + check(createdir(path) = 0, "create invalid fixture directory")
  errors = errors + check(lineout(path || "/manifest.json", '{"format":"crexx-rag-library","version":2,"database":"library.sqlite","vector_index":"vectors.faiss"}') = 0, "write invalid manifest")
  errors = errors + check(lineout(path || "/manifest.json") = 0, "close invalid manifest")
  database = .binary
  errors = errors + check(sqliteopenmode(path || "/library.sqlite", "create", database) = 0 & sqliteclose(database) = 0, "create invalid fixture database")
  if errors \= 0 then return 1
  say "P2_04_INVALID_FIXTURE_OK"
  return 0

invalidscenario: procedure = .int
  arg cell = .string, source_path = .string, target_path = .string
  error = ""; report = .ragv1conversionreport
  if planv1conversion(source_path, target_path, report, error) \= -2 | testdir(target_path) = 0 then do
    say "P2_04_FAIL=invalid version-1 identity was not rejected without a target"
    return 1
  end
  say "P2_04_INVALID_OK cell=" || cell || " unsupported_version=rejected target_created=0"
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
cell = args[1]
mode = args[2]
source_path = args[3]
if mode = "create" then return createv1fixture(source_path)
if mode = "create-invalid" then return createinvalidfixture(source_path)
if args.0 < 4 then return 2
target_path = args[4]
if mode = "dry-run" then return dryrunscenario(cell, source_path, target_path)
if mode = "import" then return importscenario(cell, source_path, target_path)
if mode = "invalid" then return invalidscenario(cell, source_path, target_path)
return 2
