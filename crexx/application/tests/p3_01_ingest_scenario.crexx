options levelg

import rxfnsb
import rxhash
import sqlite_boundary
import ragstore
import ragrepository
import ragingest

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P3_INGEST_FAIL=" || label
    return 1
  end
  return 0

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = -1; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  value = ""; status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

observation: procedure = .ragsourceobservation
  arg stable_key = .string, previous_key = .string, title = .string, format = .string, content = .string, metadata = .string
  return .ragsourceobservation("folder:architecture-mini", stable_key, previous_key, "fixture://architecture-mini/" || stable_key, title, "text/plain", "utf-8", format, content as .binary, 1, "", "", metadata, "2026-08-23T12:00:00Z")

makeplan: procedure = .int
  arg store = .ragstorehandle, observations = .ragsourceobservation[], parser_version = .string, expose plan = .ragingestplan, expose error = .string
  return createingestplan(store, "folder:architecture-mini", "config-p3", "phase3-policy-v1", parser_version, 256, observations, plan, error)

seedreuse: procedure = .int
  arg database = .binary, generation = .int
  chunk_id = scalartext(database, "SELECT c.revision_chunk_id FROM revision_chunks c JOIN source_revisions r ON r.revision_id=c.revision_id JOIN sources s ON s.source_id=r.source_id WHERE s.stable_key='a.md' AND c.ordinal=1 AND c.visible_to_generation IS NULL")
  if chunk_id = "" then return -1
  sql = "INSERT INTO embedding_profiles VALUES('embed-p3','fixture','fixture-embed',2,'phase3-policy-v1','2026-08-23T12:00:00Z');"
  sql = sql || "INSERT INTO embeddings VALUES('embedding-p3','input-p3','embed-p3',x'0000803F00000040',2,NULL,'2026-08-23T12:00:00Z');"
  sql = sql || "INSERT INTO revision_chunk_embeddings VALUES('" || chunk_id || "','embedding-p3'," || generation || ",NULL);"
  sql = sql || "INSERT INTO concepts VALUES('concept-p3-a','Identity Gateway','service','active'," || generation || ",NULL);"
  sql = sql || "INSERT INTO concepts VALUES('concept-p3-b','Cedar Store','service','active'," || generation || ",NULL);"
  sql = sql || "INSERT INTO claims VALUES('claim-p3','concept-p3-a','depends-on','concept-p3-b','forward','{}',NULL,NULL,'fixture-policy'," || generation || ",NULL);"
  sql = sql || "INSERT INTO claim_support VALUES('support-p3','claim-p3','" || chunk_id || "',0,16,'supports','assertion','direct','fixture','fixture-lineage','fixture-extractor',NULL," || generation || ",NULL)"
  return sqliteexec(database, sql)

normalizationchecks: procedure = .int
  errors = 0; error = ""; normalized = .ragnormalizedsource
  raw = ("Alpha" || "0D0A"x || "Gràdh 中" || "0D"x || "Omega") as .binary
  errors = errors + check(normalizebytes(raw, "utf-8", normalized, error) = 0, "normalize UTF-8 and CRLF " || error)
  errors = errors + check(normalized.text() = "Alpha" || "0A"x || "Gràdh 中" || "0A"x || "Omega", "canonical line endings")
  raw_starts = normalized.raw_starts(); raw_ends = normalized.raw_ends(); lines = normalized.lines(); columns = normalized.unicode_columns()
  errors = errors + check(normalized.map_count() = length(normalized.text()) & raw_ends[6] - raw_starts[6] = 2 & lines[7] = 2, "raw to normalized spans")
  unicode_index = pos("à", normalized.text())
  errors = errors + check(raw_ends[unicode_index] - raw_starts[unicode_index] = 2 & columns[unicode_index + 1] = columns[unicode_index] + 1, "UTF-8 byte span preserves Unicode column")
  invalid = "00FFC328"x as .binary
  errors = errors + check(normalizebytes(invalid, "utf-8", normalized, error) = -1 & error = "source bytes are not valid UTF-8", "invalid UTF-8 is rejected deterministically before string conversion")

  chunks = .ragchunk[]
  errors = errors + check(chunktext("One" || "0A0A"x || "Two", "plain", 64, "parser-v1", "policy-v1", chunks, error) = 0 & chunks.0 = 2 & chunks[1].text() = "One" & chunks[2].text() = "Two", "plain chunk golden")
  markdown = "# Alpha" || "0A"x || "Intro" || "0A0A"x || "```rexx" || "0A"x || "say 1" || "0A0A"x || "say 2" || "0A"x || "```" || "0A0A"x || "# Beta" || "0A"x || "End"
  markdown_status = chunktext(markdown, "markdown", 256, "parser-v1", "policy-v1", chunks, error)
  errors = errors + check(markdown_status = 0 & chunks.0 = 3 & chunks[2].evidence_class() = "code", "Markdown heading and fence golden count=" || chunks.0)
  rexx = "first: procedure" || "0A"x || "  say 1" || "0A0A"x || "second: procedure" || "0A"x || "  say 2"
  rexx_status = chunktext(rexx, "rexx", 256, "parser-v1", "policy-v1", chunks, error)
  errors = errors + check(rexx_status = 0 & chunks.0 = 2 & chunks[1].evidence_class() = "source-code", "Rexx procedure golden count=" || chunks.0)
  return errors

runscenario: procedure = .int
  arg cell = .string, path = .string
  errors = normalizationchecks(); error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-p3-" || cell, "config-p3", "architecture-local", "1", "generic-profile", "profile-hash-p3", "config-hash-p3", '{}', store, error) = 0, "initialize Phase 3 library " || error)
  if errors \= 0 then return 1

  first_text = "Identity Gateway depends on Cedar Store." || "0A0A"x || "Vault Service supplies credentials."
  observations = .ragsourceobservation[]
  observations[1] = observation("a.md", "", "Architecture A", "markdown", first_text, '{"owner":"architecture"}')
  observations[2] = observation("duplicate.md", "", "Architecture duplicate", "markdown", first_text, '{"owner":"architecture"}')
  plan = .ragingestplan
  errors = errors + check(makeplan(store, observations, "parser-v1", plan, error) = 0 & plan.schema() = "crexx-rag.ingest-plan/1" & length(plan.digest()) = 64, "create immutable initial plan " || error)
  initial = applyingestplan(store, plan, observations)
  errors = errors + check(initial.ok() = 1 & initial.generation() = 2 & initial.sources_added() = 2 & initial.chunks_created() = 2 & initial.chunks_reused() = 2 & initial.occurrences_created() = 4 & initial.provider_calls() = 0 & initial.items_queued() = 8, "initial reconciliation " || initial.error())
  errors = errors + check(scalarint(store.database(), "SELECT count(*) FROM source_artifacts") = 1 & scalarint(store.database(), "SELECT count(*) FROM source_revision_texts") = 1 & scalarint(store.database(), "SELECT count(*) FROM chunks_fts") = 4, "deduplicated artifact/text and occurrence FTS")

  changes_before = scalarint(store.database(), "SELECT total_changes()")
  noop_plan = .ragingestplan
  errors = errors + check(makeplan(store, observations, "parser-v1", noop_plan, error) = 0, "plan identical observations")
  noop = applyingestplan(store, noop_plan, observations)
  changes_after = scalarint(store.database(), "SELECT total_changes()")
  errors = errors + check(noop.ok() = 1 & noop.disposition() = "identical-no-op" & noop.library_writes() = 0 & noop.provider_calls() = 0 & noop.sources_observed() = 2 & noop.sources_unchanged() = 2 & noop.generation() = 2 & changes_before = changes_after, "identical zero write and provider call")

  errors = errors + check(seedreuse(store.database(), 2) = 0, "seed imported support and embedding")
  edited_text = "Identity Gateway depends on Cedar Store." || "0A0A"x || "Vault Service supplies short-lived credentials."
  edited = .ragsourceobservation[]
  edited[1] = observation("a.md", "", "Architecture A", "markdown", edited_text, '{"owner":"architecture"}')
  edited[2] = observations[2]
  edit_plan = .ragingestplan
  errors = errors + check(makeplan(store, edited, "parser-v1", edit_plan, error) = 0, "plan one paragraph edit")
  old_snapshot = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(path, old_snapshot, error) = 0 & old_snapshot.generation() = 2, "pin pre-edit reader")
  edit = applyingestplan(store, edit_plan, edited)
  errors = errors + check(edit.ok() = 1 & edit.generation() = 3 & edit.sources_changed() = 1 & edit.chunks_reused() = 1 & edit.chunks_created() = 1 & edit.embeddings_reused() = 1 & edit.support_reanchored() = 1 & edit.support_retracted() = 0 & edit.items_queued() = 2, "incremental paragraph reuse changed=" || edit.sources_changed() || " reused=" || edit.chunks_reused() || " created=" || edit.chunks_created() || " embeddings=" || edit.embeddings_reused() || " reanchored=" || edit.support_reanchored() || " retracted=" || edit.support_retracted() || " items=" || edit.items_queued() || " " || edit.error())
  errors = errors + check(scalarint(old_snapshot.database(), "SELECT count(*) FROM chunks_fts") = 4, "pinned reader sees wholly old FTS")
  call closereadsnapshot old_snapshot, error

  changed_chunk = scalartext(store.database(), "SELECT c.revision_chunk_id FROM revision_chunks c JOIN source_revisions r ON r.revision_id=c.revision_id JOIN sources s ON s.source_id=r.source_id WHERE s.stable_key='a.md' AND c.ordinal=2 AND c.visible_to_generation IS NULL")
  sql = "INSERT INTO claim_support VALUES('support-p3-removed','claim-p3','" || changed_chunk || "',0,13,'supports','assertion','direct','fixture','fixture-lineage-removed','fixture-extractor',NULL,3,NULL)"
  errors = errors + check(sqliteexec(store.database(), sql) = 0, "seed removable support")
  removed = .ragsourceobservation[]
  removed[1] = observation("a.md", "", "Architecture A", "markdown", "Identity Gateway depends on Cedar Store.", '{"owner":"architecture"}')
  removed[2] = observations[2]
  remove_plan = .ragingestplan
  errors = errors + check(makeplan(store, removed, "parser-v1", remove_plan, error) = 0, "plan paragraph removal")
  removal = applyingestplan(store, remove_plan, removed)
  errors = errors + check(removal.ok() = 1 & removal.generation() = 4 & removal.support_reanchored() = 1 & removal.support_retracted() = 1, "removed text retracts dependent support " || removal.error())
  errors = errors + check(scalarint(store.database(), "SELECT count(*) FROM claim_support WHERE visible_to_generation IS NULL") = 1, "only unaffected support remains active")

  stale_plan = .ragingestplan
  errors = errors + check(makeplan(store, removed, "parser-v1", stale_plan, error) = 0, "capture generation-bound stale plan")
  appended = .ragsourceobservation[]
  appended[1] = observation("a.md", "", "Architecture A", "markdown", "Identity Gateway depends on Cedar Store." || "0A0A"x || "Telemetry Broker receives audit events.", '{"owner":"architecture"}')
  appended[2] = observations[2]
  append_plan = .ragingestplan
  errors = errors + check(makeplan(store, appended, "parser-v1", append_plan, error) = 0, "plan append")
  append_result = applyingestplan(store, append_plan, appended)
  errors = errors + check(append_result.ok() = 1 & append_result.sources_changed() = 1 & append_result.chunks_created() = 1 & append_result.chunks_reused() = 1 & append_result.support_reanchored() = 1, "append preserves unchanged identity")
  stale_before = scalarint(store.database(), "SELECT total_changes()")
  stale_result = applyingestplan(store, stale_plan, removed)
  errors = errors + check(stale_result.status() = -2 & scalarint(store.database(), "SELECT total_changes()") = stale_before, "stale generation plan rejected before writes")

  reordered = .ragsourceobservation[]
  reordered[1] = appended[1]
  reordered[2] = observation("duplicate.md", "", "Architecture duplicate", "markdown", "Vault Service supplies credentials." || "0A0A"x || "Identity Gateway depends on Cedar Store.", '{"owner":"architecture"}')
  reorder_plan = .ragingestplan
  errors = errors + check(makeplan(store, reordered, "parser-v1", reorder_plan, error) = 0, "plan paragraph reorder")
  reorder_result = applyingestplan(store, reorder_plan, reordered)
  errors = errors + check(reorder_result.ok() = 1 & reorder_result.sources_changed() = 1 & reorder_result.chunks_created() = 0 & reorder_result.chunks_reused() = 2 & reorder_result.items_queued() = 0, "reorder preserves content identities and converges")

  renamed = .ragsourceobservation[]
  renamed[1] = reordered[2]
  renamed[2] = observation("renamed.md", "a.md", "Architecture A renamed", "markdown", "Identity Gateway depends on Cedar Store." || "0A0A"x || "Telemetry Broker receives audit events.", '{"owner":"architecture"}')
  rename_plan = .ragingestplan
  errors = errors + check(makeplan(store, renamed, "parser-v1", rename_plan, error) = 0, "plan mapped rename")
  rename_result = applyingestplan(store, rename_plan, renamed)
  errors = errors + check(rename_result.ok() = 1 & rename_result.sources_renamed() = 1 & rename_result.sources_added() = 0 & rename_result.sources_deleted() = 0, "mapped rename preserves source identity " || rename_result.error())

  metadata = .ragsourceobservation[]
  metadata[1] = reordered[2]
  metadata[2] = observation("renamed.md", "", "Architecture A renamed", "markdown", "Identity Gateway depends on Cedar Store." || "0A0A"x || "Telemetry Broker receives audit events.", '{"owner":"platform"}')
  metadata_plan = .ragingestplan
  errors = errors + check(makeplan(store, metadata, "parser-v1", metadata_plan, error) = 0, "plan metadata-only change")
  metadata_result = applyingestplan(store, metadata_plan, metadata)
  errors = errors + check(metadata_result.ok() = 1 & metadata_result.sources_changed() = 1 & metadata_result.chunks_reused() = 2 & metadata_result.chunks_created() = 0, "metadata-only revision reuses content")

  parser_plan = .ragingestplan
  errors = errors + check(makeplan(store, metadata, "parser-v2", parser_plan, error) = 0, "plan parser version change")
  parser_result = applyingestplan(store, parser_plan, metadata)
  errors = errors + check(parser_result.ok() = 1 & parser_result.sources_changed() = 2 & parser_result.chunks_created() = 3 & parser_result.chunks_reused() = 1 & parser_result.items_queued() = 8, "parser change invalidates bounded chunk inputs changed=" || parser_result.sources_changed() || " created=" || parser_result.chunks_created() || " items=" || parser_result.items_queued() || " " || parser_result.error())

  statistics = .ragtermstatistics
  errors = errors + check(termstatistics(store, "identity", "phase3-policy-v1", statistics, error) = 0 & statistics.occurrences() = 2 & statistics.chunks() = 2 & statistics.source_diversity() = 2 & length(statistics.input_fingerprint()) = 64, "versioned rarity and source-diversity input " || error)
  errors = errors + check(scalarint(store.database(), "SELECT count(*) FROM candidate_decisions WHERE policy_version='phase3-policy-v1'") > 0 & scalarint(store.database(), "SELECT count(*) FROM candidate_decisions WHERE state='accepted'") > 0, "candidate census collation and versioned adjudication")

  deleted = .ragsourceobservation[]; deleted[1] = metadata[2]
  delete_plan = .ragingestplan
  errors = errors + check(makeplan(store, deleted, "parser-v2", delete_plan, error) = 0, "plan deletion")
  delete_result = applyingestplan(store, delete_plan, deleted)
  errors = errors + check(delete_result.ok() = 1 & delete_result.sources_deleted() = 1 & scalarint(store.database(), "SELECT count(*) FROM sources WHERE lifecycle_state='active' AND visible_to_generation IS NULL") = 1, "deletion retires missing source and dependencies")

  unmapped = .ragsourceobservation[]
  unmapped[1] = observation("unmapped-rename.md", "", "Architecture unmapped rename", "markdown", metadata[2].raw() as .string, '{"owner":"platform"}')
  unmapped_plan = .ragingestplan
  errors = errors + check(makeplan(store, unmapped, "parser-v2", unmapped_plan, error) = 0, "plan unmapped rename")
  unmapped_result = applyingestplan(store, unmapped_plan, unmapped)
  errors = errors + check(unmapped_result.ok() = 1 & unmapped_result.sources_added() = 1 & unmapped_result.sources_deleted() = 1 & unmapped_result.sources_renamed() = 0, "unmapped rename is explicit add plus retirement")

  external_raw = "Verified external reference" as .binary
  external_digest = rxhash..sha256hex(external_raw)
  external = .ragsourceobservation[]
  external[1] = .ragsourceobservation("folder:external-reference", "external.txt", "", "fixture://external/reference", "External reference", "text/plain", "utf-8", "plain", external_raw, 0, "file:/verified/external.txt", external_digest, '{}', "2026-08-23T12:00:00Z")
  external_plan = .ragingestplan
  external_status = createingestplan(store, "folder:external-reference", "config-p3", "phase3-policy-v1", "parser-v2", 256, external, external_plan, error)
  external_result = applyingestplan(store, external_plan, external)
  errors = errors + check(external_status = 0 & external_result.ok() = 1 & scalarint(store.database(), "SELECT count(*) FROM source_artifacts WHERE raw_digest='" || external_digest || "' AND bytes IS NULL AND external_reference='file:/verified/external.txt'") = 1, "verified external reference retains SHA-256 identity without copied bytes")

  verification = .ragrepositoryverifyresult; final_snapshot = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(path, final_snapshot, error) = 0 & verifyrepositories(final_snapshot, verification, error) = 0 & verification.ok() = 1, "final repository invariants " || verification.summary() || " " || error)
  call closereadsnapshot final_snapshot, error
  errors = errors + check(closeragstore(store, error) = 0, "close Phase 3 library")
  if errors \= 0 then do; say "P3_INGEST_ERRORS=" || errors; return 1; end
  say "P3_INGEST_OK cell=" || cell || " schema=2 initial_incremental=shared no_op_writes=0 provider_calls=0 raw_identity=sha256 revision_identity=sha256 span_maps=canonical chunkers=3 reuse=content_and_occurrence support_reanchor=1 support_retract=1 embeddings_reused=1 candidates=versioned fts=atomic parser_invalidation=bounded"
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
return runscenario(args[1], args[2])
