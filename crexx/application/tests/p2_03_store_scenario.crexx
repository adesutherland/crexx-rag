options levelg

import rxfnsb
import sqlite_boundary
import ragstore
import system

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_03_FAIL=" || label
    return 1
  end
  return 0

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  if sqlitestep(prepared) \= 100 then do
    call sqlitefinalize prepared
    return -1
  end
  value = -1
  status = sqlitecolumnint(prepared, 0, value)
  call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

insertsource: procedure = .int
  arg database = .binary, source_id = .string, stable_key = .string, generation = .int
  prepared = .binary
  sql = "INSERT INTO sources(source_id,connector_type,stable_key,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES(?1,'fixture',?2,'active',?3,?4,?5)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  status = sqlitebindtext(prepared, 1, source_id)
  status = status | sqlitebindtext(prepared, 2, stable_key)
  status = status | sqlitebindtext(prepared, 3, "fixture://" || stable_key)
  status = status | sqlitebindtext(prepared, 4, "Fixture " || stable_key)
  status = status | sqlitebindint(prepared, 5, generation)
  step_status = sqlitestep(prepared)
  call sqlitefinalize prepared
  if status \= 0 | step_status \= 101 then return -1
  return 0

stagecontent: procedure = .int
  arg database = .binary, generation = .int
  sql = "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,external_reference,created_at) VALUES('artifact-2','raw-digest-2','text/plain','utf-8','fixture://artifact-2',strftime('%Y-%m-%dT%H:%M:%fZ','now'));"
  sql = sql || "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-2','text-digest-2','alpha storage evidence','extractor-v1','normalize-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'));"
  sql = sql || "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-2','source-2','revision-digest-2','artifact-2','text-2','metadata-2',strftime('%Y-%m-%dT%H:%M:%fZ','now')," || generation || ");"
  sql = sql || "UPDATE sources SET current_revision_id='revision-2' WHERE source_id='source-2';"
  sql = sql || "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-2','content-digest-2','alpha storage evidence','input-2');"
  sql = sql || "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('revision-chunk-2','revision-2',1,0,22,'content-2','continuity-2','parser-v1','direct'," || generation || ");"
  sql = sql || "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('revision-chunk-2','content-2','alpha storage evidence')"
  if sqliteexec(database, sql) \= 0 then return -1
  return 0

visiblecount: procedure = .int
  arg database = .binary, generation = .int
  return scalarint(database, "SELECT count(*) FROM sources WHERE visible_from_generation<=" || generation || " AND (visible_to_generation IS NULL OR visible_to_generation>" || generation || ")")

initfixture: procedure = .int
  arg path = .string, expose store = .ragstorehandle, expose error = .string
  return initragstore(path, "library-p2-03", "config-snapshot-1", "architecture-local", "1", "generic", "profile-hash-1", "config-hash-1", '{"config_id":"architecture-local","profile_id":"generic"}', store, error)

fullscenario: procedure = .int
  arg cell = .string, path = .string
  errors = 0; error = ""
  status = .ragstorestatus
  verification = .ragverifyresult
  old_snapshot = .ragreadsnapshot
  new_snapshot = .ragreadsnapshot
  store = .ragstorehandle
  errors = errors + check(initfixture(path, store, error) = 0, "init " || error)
  if errors \= 0 then return 1
  errors = errors + check(storagestatus(store, status, error) = 0, "status " || error)
  errors = errors + check(status.library_id() = "library-p2-03" & status.schema_version() = 5 & status.published_generation() = 1 & status.next_generation() = 2 & status.manifest_state() = "aligned", "initial authoritative state")
  required_tables = "'schema_migrations','library_meta','published_generations','config_snapshots','provider_runs','sources','source_artifacts','source_revision_texts','source_revisions','normalization_maps','chunk_contents','revision_chunks','chunks_fts','candidate_mentions','candidate_decisions','concepts','aliases','mentions','claims','claim_support','claim_conflicts','ambiguity_candidates','embedding_profiles','embeddings','revision_chunk_embeddings','vector_generations','jobs','job_items','attempts','job_events','reviews','publication_events','runtime_instances'"
  errors = errors + check(scalarint(store.database(), "SELECT count(*) FROM sqlite_master WHERE type IN('table','view') AND name IN(" || required_tables || ")") = 33, "complete current logical table set")
  errors = errors + check(scalarint(store.database(), "SELECT count(*) FROM schema_migrations") = 5, "ordered migration records")
  errors = errors + check(beginreadsnapshot(path, old_snapshot, error) = 0 & old_snapshot.generation() = 1, "pin old read snapshot " || error)
  generation = 0
  errors = errors + check(begingeneration(store, 1, "config-snapshot-1", "publish first source", generation, error) = 0 & generation = 2, "begin generation 2 " || error)
  errors = errors + check(insertsource(store.database(), "source-2", "source-2", generation) = 0, "stage generation source")
  errors = errors + check(stagecontent(store.database(), generation) = 0, "stage revision, chunk, and FTS projection")
  errors = errors + check(commitgeneration(store, generation, error) = 0, "commit SQLite generation " || error)
  errors = errors + check(sqliteexec(store.database(), "UPDATE published_generations SET summary='forbidden' WHERE generation=2") = -6 & sqliteexec(store.database(), "DELETE FROM published_generations WHERE generation=2") = -6, "published generations are immutable")
  manifest_state = ""
  errors = errors + check(manifeststate(store, manifest_state, error) = 0 & manifest_state = "stale", "manifest trails committed SQLite")
  errors = errors + check(visiblecount(old_snapshot.database(), old_snapshot.generation()) = 0, "old snapshot retains generation-1 visibility")
  errors = errors + check(beginreadsnapshot(path, new_snapshot, error) = 0 & new_snapshot.generation() = 2, "pin new read snapshot " || error)
  errors = errors + check(visiblecount(new_snapshot.database(), new_snapshot.generation()) = 1 & scalarint(new_snapshot.database(), "SELECT count(*) FROM revision_chunks WHERE visible_from_generation<=2 AND (visible_to_generation IS NULL OR visible_to_generation>2)") = 1, "new snapshot observes generation-2 visibility")
  errors = errors + check(closereadsnapshot(new_snapshot, error) = 0, "close new snapshot " || error)
  errors = errors + check(closereadsnapshot(old_snapshot, error) = 0, "close old snapshot " || error)
  errors = errors + check(publishmanifest(store, error) = 0, "publish manifest " || error)
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "verify complete library " || verification.summary() || " " || error)
  errors = errors + check(rollbackgeneration(store, 2, 1, "operator rollback fixture", error) = 0, "ordered semantic rollback " || error)
  errors = errors + check(visiblecount(store.database(), 1) = 0 & scalarint(store.database(), "SELECT count(*) FROM chunks_fts") = 0 & scalarint(store.database(), "SELECT count(*) FROM publication_events WHERE event_type='rollback'") = 1, "rollback visibility, FTS, and audit event")
  manifest_state = ""
  errors = errors + check(manifeststate(store, manifest_state, error) = 0 & manifest_state = "aligned", "rollback manifest ordering never leads SQLite")
  errors = errors + check(storagestatus(store, status, error) = 0 & status.published_generation() = 1 & status.next_generation() = 3 & status.manifest_state() = "aligned", "rollback preserves monotonic allocation")
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "verify rolled-back library " || verification.summary() || " " || error)
  errors = errors + check(closeragstore(store, error) = 0, "close full scenario store " || error)
  if errors \= 0 then do
    say "P2_03_ERRORS=" || errors
    return 1
  end
  say "P2_03_FULL_OK cell=" || cell || " levelg=1 schema=5 migrations=5 tables=33 generations=2 snapshots=2 manifest_recovery=1 rollback=1"
  return 0

migrationscenario: procedure = .int
  arg cell = .string, path = .string
  errors = 0; error = ""
  database = .binary
  errors = errors + check(sqliteopenmode(path || "-upgrade.sqlite", "create", database) = 0, "open migration database")
  errors = errors + check(applymigrations(database, "p2-03-test", 1, error) = 0, "apply migration 1 " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM schema_migrations") = 1 & scalarint(database, "SELECT count(*) FROM sqlite_master WHERE name='provider_runs'") = 0, "version-1 boundary")
  errors = errors + check(applymigrations(database, "p2-03-test", 2, error) = 0, "upgrade to migration 2 " || error)
  changes_before = scalarint(database, "SELECT total_changes()")
  errors = errors + check(applymigrations(database, "p2-03-test", 2, error) = 0, "repeat migrations " || error)
  changes_after = scalarint(database, "SELECT total_changes()")
  errors = errors + check(changes_before = changes_after, "current migration open is zero-write")
  errors = errors + check(applymigrations(database, "p2-03-test", 1, error) = -4, "migration downgrade prohibited")
  errors = errors + check(sqliteexec(database, "UPDATE schema_migrations SET checksum='ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff' WHERE version=1") = 0, "install checksum fault")
  errors = errors + check(applymigrations(database, "p2-03-test", 2, error) = -4, "migration checksum fault rejected")
  call sqliteclose database

  failed = .binary
  errors = errors + check(sqliteopenmode(path || "-failed.sqlite", "create", failed) = 0, "open failed-upgrade database")
  errors = errors + check(applymigrations(failed, "p2-03-test", 1, error) = 0, "prepare failed upgrade")
  errors = errors + check(sqliteexec(failed, "CREATE TABLE source_artifacts(blocker INTEGER)") = 0, "install upgrade fault")
  errors = errors + check(applymigrations(failed, "p2-03-test", 2, error) = -3, "failed migration rejected")
  errors = errors + check(scalarint(failed, "SELECT count(*) FROM schema_migrations WHERE version=2") = 0 & scalarint(failed, "SELECT count(*) FROM sqlite_master WHERE name='provider_runs'") = 0, "failed upgrade rolls back prior DDL")
  call sqliteclose failed
  if errors \= 0 then return 1
  say "P2_03_MIGRATION_OK cell=" || cell || " ordered=2 checksums=verified upgrade=1 idempotent=1 downgrade=denied failed_upgrade=rolled_back"
  return 0

readonlyscenario: procedure = .int
  arg cell = .string, path = .string, expected_generation = .int, expected_manifest = .string
  errors = 0; error = ""; store = .ragstorehandle; status = .ragstorestatus
  errors = errors + check(openragstore(path, "readonly", store, error) = 0, "readonly open " || error)
  if errors \= 0 then return 1
  errors = errors + check(storagestatus(store, status, error) = 0, "readonly status " || error)
  errors = errors + check(status.published_generation() = expected_generation & status.manifest_state() = expected_manifest, "readonly authoritative generation and manifest report")
  errors = errors + check(closeragstore(store, error) = 0, "readonly close " || error)
  if errors \= 0 then return 1
  say "P2_03_READONLY_OK cell=" || cell || " generation=" || expected_generation || " manifest=" || expected_manifest || " writes=0 repairs=0 migrations=0"
  return 0

missingreadonlyscenario: procedure = .int
  arg cell = .string, path = .string
  error = ""; store = .ragstorehandle
  if openragstore(path, "readonly", store, error) \= -2 then do
    say "P2_03_FAIL=missing readonly open was not rejected"
    return 1
  end
  say "P2_03_MISSING_READONLY_OK cell=" || cell || " created=0 migrated=0"
  return 0

recoveryscenario: procedure = .int
  arg cell = .string, path = .string, expected_generation = .int
  errors = 0; error = ""; store = .ragstorehandle; status = .ragstorestatus; verification = .ragverifyresult
  errors = errors + check(openragstore(path, "readwrite", store, error) = 0, "recovery open " || error)
  if errors \= 0 then return 1
  errors = errors + check(recovermanifest(store, error) = 0, "authorized manifest recovery " || error)
  errors = errors + check(storagestatus(store, status, error) = 0 & status.published_generation() = expected_generation & status.manifest_state() = "aligned", "recovered projection agrees")
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "verify recovered library " || verification.summary())
  errors = errors + check(closeragstore(store, error) = 0, "recovery close " || error)
  if errors \= 0 then return 1
  say "P2_03_RECOVERY_OK cell=" || cell || " generation=" || expected_generation || " manifest=aligned authorized=1"
  return 0

crashsetup: procedure = .int
  arg path = .string
  error = ""; store = .ragstorehandle
  if initfixture(path, store, error) \= 0 then do
    say "P2_03_FAIL=crash setup " || error
    return 1
  end
  if closeragstore(store, error) \= 0 then return 1
  say "P2_03_CRASH_SETUP_OK generation=1 manifest=aligned"
  return 0

crashbeforecommit: procedure = .int
  arg path = .string, marker = .string
  error = ""; store = .ragstorehandle; generation = 0
  if openragstore(path, "readwrite", store, error) \= 0 then return 1
  if begingeneration(store, 1, "config-snapshot-1", "crash before commit", generation, error) \= 0 then return 1
  if insertsource(store.database(), "source-uncommitted", "source-uncommitted", generation) \= 0 then return 1
  call lineout marker, "P2_03_CRASH_POINT=before-db-commit generation=2"
  call lineout marker
  call _wait 60000
  return 73

crashafterdatabase: procedure = .int
  arg path = .string, marker = .string
  error = ""; store = .ragstorehandle; generation = 0
  if openragstore(path, "readwrite", store, error) \= 0 then return 1
  if begingeneration(store, 1, "config-snapshot-1", "crash after SQLite commit", generation, error) \= 0 then return 1
  if insertsource(store.database(), "source-committed-2", "source-committed-2", generation) \= 0 then return 1
  if commitgeneration(store, generation, error) \= 0 then return 1
  call lineout marker, "P2_03_CRASH_POINT=after-db-commit generation=2"
  call lineout marker
  call _wait 60000
  return 74

crashaftertemporary: procedure = .int
  arg path = .string, marker = .string
  error = ""; store = .ragstorehandle; generation = 0
  if openragstore(path, "readwrite", store, error) \= 0 then return 1
  if begingeneration(store, 2, "config-snapshot-1", "crash after manifest temporary", generation, error) \= 0 then return 1
  if insertsource(store.database(), "source-committed-3", "source-committed-3", generation) \= 0 then return 1
  if commitgeneration(store, generation, error) \= 0 then return 1
  if writemanifesttemporary(store, error) \= 0 then return 1
  call lineout marker, "P2_03_CRASH_POINT=after-manifest-temp generation=3"
  call lineout marker
  call _wait 60000
  return 75

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
cell = args[1]
mode = args[2]
path = args[3]
if mode = "full" then return fullscenario(cell, path)
if mode = "migration" then return migrationscenario(cell, path)
if mode = "readonly-missing" then return missingreadonlyscenario(cell, path)
if mode = "readonly" then do
  if args.0 < 5 then return 2
  return readonlyscenario(cell, path, args[4] as .int, args[5])
end
if mode = "recover" then do
  if args.0 < 4 then return 2
  return recoveryscenario(cell, path, args[4] as .int)
end
if mode = "crash-setup" then return crashsetup(path)
if mode = "crash-before-commit" then do
  if args.0 < 4 then return 2
  return crashbeforecommit(path, args[4])
end
if mode = "crash-after-database" then do
  if args.0 < 4 then return 2
  return crashafterdatabase(path, args[4])
end
if mode = "crash-after-temporary" then do
  if args.0 < 4 then return 2
  return crashaftertemporary(path, args[4])
end
return 2
