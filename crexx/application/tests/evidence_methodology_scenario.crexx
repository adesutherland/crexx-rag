options levelg

import rxfnsb
import rxsqlite
import rxjson
import ragstore
import ragretrieval
import ragquery
import ragevidencejson
import generic_profile

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "EVIDENCE_METHODOLOGY_FAIL=" || label
  return 1

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

claimpresent: procedure = .int
  arg claims = .ragacceptedclaim[], claim_id = .string
  do i = 1 to claims.0
    if claims[i].claim_id() = claim_id then return 1
  end
  return 0

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-evidence-methodology", "snapshot-evidence", "evidence-methodology", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors > 0 then return 1
  database = store.database()
  errors = errors + check(sqliteexec(database, "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-evidence','raw-evidence','text/plain','utf-8',NULL,'fixture://evidence',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "artifact")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-evidence','text-digest-evidence','Alpha links Beta in 1603.\nGamma links Alpha.','fixture-v1','utf8-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "revision text")
  errors = errors + check(sqliteexec(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-evidence','fixture','evidence','revision-evidence','active','fixture://evidence','Evidence corpus',1)") = 0, "source")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-evidence','source-evidence','revision-envelope-evidence','artifact-evidence','text-evidence','metadata-evidence','2026-01-01T00:00:00Z',1)") = 0, "revision")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-out','digest-out','Alpha links Beta in 1603.','input-out'),('content-in','digest-in','Gamma links Alpha.','input-in')") = 0, "contents")
  errors = errors + check(sqliteexec(database, "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-out','revision-evidence',1,0,25,'content-out','continuity-out','fixture-v1','direct',1),('chunk-in','revision-evidence',2,26,44,'content-in','continuity-in','fixture-v1','direct',1)") = 0, "chunks")
  /* FTS is deliberately empty: Alpha is a catalogue anchor, so the passages
   * and claims below can only enter through the selected directed graph route. */
  errors = errors + check(sqliteexec(database, "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-alpha','Alpha','concept','active',1),('concept-beta','Beta','concept','active',1),('concept-gamma','Gamma','concept','active',1)") = 0, "concepts")
  errors = errors + check(sqliteexec(database, "INSERT INTO mentions(mention_id,concept_id,ambiguity_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-alpha-out','concept-alpha',NULL,'chunk-out',0,5,1),('mention-beta','concept-beta',NULL,'chunk-out',12,16,1),('mention-gamma','concept-gamma',NULL,'chunk-in',0,5,1),('mention-alpha-in','concept-alpha',NULL,'chunk-in',12,17,1)") = 0, "mentions")
  errors = errors + check(sqliteexec(database, "INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('claim-alpha-beta','concept-alpha','related-to','concept-beta','outbound','{}','fixture-v1',1),('claim-gamma-alpha','concept-gamma','related-to','concept-alpha','outbound','{}','fixture-v1',1)") = 0, "claims")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,decision_id,visible_from_generation) VALUES('support-alpha-beta','claim-alpha-beta','chunk-out',0,25,'support','assertion','direct','','lineage-out','fixture',NULL,1),('support-gamma-alpha','claim-gamma-alpha','chunk-in',0,18,'support','assertion','direct','','lineage-in','fixture',NULL,1)") = 0, "supports")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-alpha','insight','Alpha deserves further analysis',850000,250000,'Inspect corroborating passages','active','{}','fixture',1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "analysis note")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-alpha','note-alpha','chunk','chunk-out','chunk-out',0,5)") = 0, "analysis note link")
  errors = errors + check(publishmanifest(store, error) = 0, "manifest " || error)
  if errors > 0 then return 1

  empty_wire = .binary
  outbound_options = .ragretrievaloptions("evidence-methodology-v1", "", empty_wire, 8, 1, 1, 1, 8, 8, 8, 60, "outbound")
  inbound_options = .ragretrievaloptions("evidence-methodology-v1", "", empty_wire, 8, 1, 1, 1, 8, 8, 8, 60, "inbound")
  both_options = .ragretrievaloptions("evidence-methodology-v1", "", empty_wire, 8, 1, 1, 1, 8, 8, 8, 60, "both")

  /* Give the indexed frequency test one searchable Alpha document. The row is
   * removed before the graph tests so those remain graph-only by construction. */
  errors = errors + check(sqliteexec(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-out','content-out','Alpha links Beta in 1603.')") = 0, "indexed frequency fixture")
  quoted_plan = .ragqueryplan
  errors = errors + check(planquery(store, genericprofile(), "What is 'Alpha links'?", "evidence-methodology-v1", quoted_plan, error) = 0, "single-quoted query plan " || error)
  quoted_variants = .ragqueryvariant[]; quoted_variants = quoted_plan.variants()
  errors = errors + check(quoted_variants.0 > 0 & quoted_variants[1].kind() = "exact-phrase" & quoted_variants[1].query() = '"alpha links"', "natural single quotes become the first exact phrase")
  frequency_plan = .ragqueryplan
  errors = errors + check(planquery(store, genericprofile(), "Alpha Missing", "evidence-methodology-v1", frequency_plan, error) = 0, "frequency-ordered query plan " || error)
  frequency_variants = .ragqueryvariant[]; frequency_variants = frequency_plan.variants()
  errors = errors + check(frequency_variants.0 >= 3 & frequency_variants[2].query() = "missing" & frequency_variants[3].query() = "alpha", "focused terms are ordered rarest first")
  partial = .ragretrievalresult
  partial_status = retrieveevidence(store, genericprofile(), "Alpha Quantum", both_options, partial, error)
  partial_gaps = .string[]; partial_claims = .ragacceptedclaim[]; partial_gap_found = 0
  if partial_status = 0 then do; partial_gaps = partial.evidence().gaps(); partial_claims = partial.evidence().claims(); end
  do i = 1 to partial_gaps.0
    if pos("quantum", lower(partial_gaps[i])) > 0 then partial_gap_found = 1
  end
  errors = errors + check(partial_status = 0 & partial_claims.0 > 0 & partial_gap_found = 1, "partial evidence records the absent query term without suppressing useful claims " || error)
  errors = errors + check(sqliteexec(database, "DELETE FROM chunks_fts") = 0, "clear frequency fixture")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-out','content-out','Noise')") = 0, "lexical decoy fixture")
  decoy = .ragretrievalresult
  errors = errors + check(retrieveevidence(store, genericprofile(), "Noise", both_options, decoy, error) = 0 & decoy.graph_candidates() = 0, "lexical candidates do not become implicit graph anchors " || error)
  errors = errors + check(sqliteexec(database, "DELETE FROM chunks_fts") = 0, "restore graph-only fixture")
  outbound = .ragretrievalresult; inbound = .ragretrievalresult; both = .ragretrievalresult
  errors = errors + check(retrieveevidence(store, genericprofile(), "Alpha", outbound_options, outbound, error) = 0, "outbound retrieval " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "Alpha", inbound_options, inbound, error) = 0, "inbound retrieval " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "Alpha", both_options, both, error) = 0, "both retrieval " || error)
  outbound_claims = .ragacceptedclaim[]; inbound_claims = .ragacceptedclaim[]; both_claims = .ragacceptedclaim[]
  outbound_claims = outbound.evidence().claims(); inbound_claims = inbound.evidence().claims(); both_claims = both.evidence().claims()
  errors = errors + check(outbound_claims.0 = 1 & claimpresent(outbound_claims, "claim-alpha-beta") = 1 & outbound_claims[1].subject() = "Alpha" & outbound_claims[1].object() = "Beta" & outbound_claims[1].direction() = "outbound", "outbound preserves stored Alpha-to-Beta direction")
  errors = errors + check(inbound_claims.0 = 1 & claimpresent(inbound_claims, "claim-gamma-alpha") = 1 & inbound_claims[1].subject() = "Gamma" & inbound_claims[1].object() = "Alpha" & inbound_claims[1].direction() = "outbound", "inbound traversal returns stored Gamma-to-Alpha without inventing an inverse")
  errors = errors + check(both_claims.0 = 2 & claimpresent(both_claims, "claim-alpha-beta") = 1 & claimpresent(both_claims, "claim-gamma-alpha") = 1, "both traversal returns exactly both stored claims")
  leads = .raggraphlead[]; notes = .raganalysisnote[]
  leads = outbound.evidence().leads(); notes = outbound.evidence().analysis_notes()
  errors = errors + check(leads.0 >= 1 & leads[1].reason() = "co-mention passage worth inspecting" & pos("do not establish", leads[1].limitation()) > 0, "co-mention remains an explicit non-claim analysis lead")
  note_citations = .ragcitation[]
  if notes.0 = 1 then note_citations = notes[1].citations()
  errors = errors + check(notes.0 = 1 & notes[1].note_id() = "note-alpha" & notes[1].kind() = "insight" & note_citations.0 = 1 & note_citations[1].span_start() = 0 & note_citations[1].span_end() = 5, "durable analysis note and exact citation retrieval")
  encoded = ""; answer_context = ""
  errors = errors + check(encodeevidence(outbound.evidence(), 65536, encoded, error) = 0 & pos('"analysis_notes":[{"note_id":"note-alpha"', encoded) > 0, "evidence serialization " || error)
  errors = errors + check(encodeanswercontext(outbound.evidence(), 65536, answer_context, error) = 0 & pos('"factual_status":"analysis-only"', answer_context) > 0, "analysis-only answer context " || error)
  /* A small context must not replace its best source passage with a related
   * graph claim that does not contain the requested fact. Provenance travels
   * intact with whichever whole records fit. */
  metadata='{"qualification":"' || copies("q",1100) || '"}'
  citation=.ragcitation("crexx-rag:source-answer","source","revision",0,43)
  packet_passages=.ragpassage[];channels=.string[];scores=.ragscore[]
  packet_passages[1]=.ragpassage(citation,"Source","The manuscript was lost in France.","book",1.0,"","","","direct","direct",channels,scores,metadata)
  packet_supports=.ragsupportcitation[];packet_supports[1]=.ragsupportcitation(citation,"support","assertion","","independent","","direct","{}",metadata)
  packet_claims=.ragacceptedclaim[];empty_strings=.string[]
  packet_claims[1]=.ragacceptedclaim("related-claim","manuscript","located-in","College", "outbound",1.0,"","","",packet_supports,scores,empty_strings)
  empty_leads=.raggraphlead[];empty_notes=.raganalysisnote[]
  packet=.ragevidence("crexx-rag.evidence/2","fixture",1,"In which country was it lost?",empty_strings,packet_passages,packet_claims,empty_strings,empty_leads,empty_notes,empty_strings,outbound.evidence().trace(),"Preserve uncertainty.")
  errors=errors+check(encodeanswercontext(packet,65536,answer_context,error)=0 & pos('"claim_id":"related-claim"',answer_context)>0 & pos("lost in France",answer_context)>0,"source and graph retained when both fit")
  errors=errors+check(encodeanswercontext(packet,2500,answer_context,error)=0 & pos("lost in France",answer_context)>0 & pos('"truncation":{"incomplete":true',answer_context)>0 & pos(metadata,answer_context)>0,"best source survives tight context with provenance and explicit omissions " || error)
  roomy=""
  errors=errors+check(encodeevidence(packet,65536,roomy,error)=0 & pos('"truncation"',roomy)=0,"fitting public evidence stays complete")
  /* Q03-shaped graph fanout: the passage fits, but whole cited claims with
   * qualification/provenance exceed the normal public 262144-byte ceiling. */
  wide_metadata='{"qualification":"' || copies("q",30000) || '"}'
  graph_supports=.ragsupportcitation[]
  graph_supports[1]=.ragsupportcitation(citation,"support","assertion","","independent","","direct","{}",wide_metadata)
  graph_claims=.ragacceptedclaim[]
  do i=1 to 12
    graph_claims[i]=.ragacceptedclaim("graph-claim-" || i,"manuscript","related-to","place-" || i,"outbound",1.0,"","","",graph_supports,scores,empty_strings,'{"qualification":"qualified"}')
  end
  graph_packet=.ragevidence("crexx-rag.evidence/2","fixture",1,"In which country was it lost?",empty_strings,packet_passages,graph_claims,empty_strings,empty_leads,empty_notes,empty_strings,outbound.evidence().trace(),"Preserve uncertainty.")
  bounded=""
  bounded_status=encodeevidence(graph_packet,262144,bounded,error)
  errors=errors+check(bounded_status=0 & binlength(bounded as .binary)<=262144 & pos('"truncation":{"incomplete":true',bounded)>0,"graph packet returns bounded incomplete evidence " || error)
  if bounded_status=0 then do
    bounded_doc=.jsondocument(bounded)
    retained=bounded_doc.node_count(bounded_doc.member(bounded_doc.root(),"claims"))
    truncation=bounded_doc.member(bounded_doc.root(),"truncation")
    omitted=bounded_doc.member(truncation,"omitted")
    errors=errors+check(retained>0 & retained<12 & bounded_doc.node_get(bounded_doc.member(omitted,"claims"))=(12-retained) & pos('"citation":{"id":"crexx-rag:source-answer"',bounded)>0 & pos('"qualifiers":{"qualification":"qualified"}',bounded)>0 & pos(wide_metadata,bounded)>0,"whole graph claims retain citations, qualifications and exact omitted count")
  end
  rejected=""
  errors=errors+check(encodeevidence(packet,100,rejected,error)=-2 & rejected="" & pos("mandatory evidence metadata",error)>0,"ceiling still refuses mandatory metadata overflow")
  answered_graph=graph_packet.with_generated_answer("The manuscript was lost in France [crexx-rag:source-answer].")
  errors=errors+check(encodeevidence(answered_graph,262144,rejected,error)=-2 & rejected="" & pos("serialized evidence exceeds",error)>0,"answer citations are not silently separated from omitted evidence")
  wide_gaps=.string[]
  do i=1 to 3;wide_gaps[i]="gap-" || i || ":" || copies("g",3500);end
  no_claims=.ragacceptedclaim[]
  gaps_packet=.ragevidence("crexx-rag.evidence/2","fixture",1,"In which country was it lost?",empty_strings,packet_passages,no_claims,empty_strings,empty_leads,empty_notes,wide_gaps,outbound.evidence().trace(),"Preserve uncertainty.")
  bounded_gaps=""
  gaps_status=encodeevidence(gaps_packet,6000,bounded_gaps,error)
  errors=errors+check(gaps_status=0 & binlength(bounded_gaps as .binary)<=6000 & pos('"citation":{"id":"crexx-rag:source-answer"',bounded_gaps)>0,"diagnostic string overflow retains the cited source passage " || error)
  if gaps_status=0 then do
    gaps_document=.jsondocument(bounded_gaps)
    gaps_omitted=gaps_document.member(gaps_document.member(gaps_document.root(),"truncation"),"omitted")
    gaps_retained=gaps_document.node_count(gaps_document.member(gaps_document.root(),"gaps"))
    errors=errors+check(gaps_retained<3 & gaps_retained+gaps_document.node_get(gaps_document.member(gaps_omitted,"gaps"))=3,"diagnostic strings have exact omission counts")
  end
  ambiguities_packet=.ragevidence("crexx-rag.evidence/2","fixture",1,"In which country was it lost?",empty_strings,packet_passages,no_claims,wide_gaps,empty_leads,empty_notes,empty_strings,outbound.evidence().trace(),"Preserve uncertainty.")
  bounded_ambiguities=""
  ambiguities_status=encodeevidence(ambiguities_packet,6000,bounded_ambiguities,error)
  if ambiguities_status=0 then do
    ambiguities_document=.jsondocument(bounded_ambiguities)
    ambiguities_omitted=ambiguities_document.member(ambiguities_document.member(ambiguities_document.root(),"truncation"),"omitted")
    ambiguities_retained=ambiguities_document.node_count(ambiguities_document.member(ambiguities_document.root(),"ambiguities"))
    errors=errors+check(binlength(bounded_ambiguities as .binary)<=6000 & ambiguities_retained<3 & ambiguities_retained+ambiguities_document.node_get(ambiguities_document.member(ambiguities_omitted,"ambiguities"))=3,"ambiguity strings retain exact whole-record omission counts")
  end
  else errors=errors+check(0,"ambiguity string overflow should return bounded evidence " || error)
  trace_json = ""; paths_json = ""; timeline_json = ""
  errors = errors + check(encodetraceprojection(outbound.evidence(), 65536, trace_json, error) = 0 & pos('"schema":"crexx-rag.query-trace/1"', trace_json) > 0, "dedicated trace projection " || error)
  errors = errors + check(encodepathprojection(outbound.evidence(), 65536, paths_json, error) = 0 & pos('"schema":"crexx-rag.query-paths/2"', paths_json) > 0 & pos('"follow_question":', paths_json) > 0, "dedicated path and follow-up projection " || error)
  errors = errors + check(encodetimelineprojection(outbound.evidence(), 65536, timeline_json, error) = 0 & pos('"schema":"crexx-rag.query-timeline/2"', timeline_json) > 0 & pos('"year":"1603"', timeline_json) > 0, "dedicated cited timeline projection " || error)
  parsed_library = ""; parsed_citation = .ragcitation
  stable_id = "crexx-rag:library-evidence-methodology:source-sha256:" || copies("a", 64) || ":revision-sha256:" || copies("b", 64) || ":utf8-10-25"
  errors = errors + check(parsecitation(stable_id, parsed_library, parsed_citation, error) = 0 & parsed_library = "library-evidence-methodology" & parsed_citation.span_start() = 10 & parsed_citation.span_end() = 25, "canonical public citation parsing " || error)

  missing = .ragretrievalresult
  missing_status = retrieveevidence(store, genericprofile(), "What does Missing depend on?", both_options, missing, error)
  missing_gaps = .string[]
  if missing_status = 0 then missing_gaps = missing.evidence().gaps()
  errors = errors + check(missing_status = 0 & missing_gaps.0 > 0, "gap-producing retrieval " || error)
  fair_limit_found = 0; missing_notes = .string[]; missing_notes = missing.evidence().trace().notes()
  do i = 1 to missing_notes.0
    if pos("per-variant-limit=", missing_notes[i]) > 0 & pos("per-variant-limit=8", missing_notes[i]) = 0 then fair_limit_found = 1
  end
  errors = errors + check(fair_limit_found = 1, "multi-variant lexical plans reserve a fair candidate allowance")
  recorded = 0
  errors = errors + check(recordquerygaps(store, missing.evidence(), recorded, error) = 0 & recorded > 0, "first durable query gap " || error)
  errors = errors + check(recordquerygaps(store, missing.evidence(), recorded, error) = 0 & recorded > 0, "repeated durable query gap " || error)
  errors = errors + check(scalarint(database, "SELECT min(occurrence_count) FROM query_gaps WHERE normalized_question='what does missing depend on?'") = 2, "repeated gaps increment their deterministic occurrence census")
  /* Independent broad-net fixture: 200 distinct passages from one source.
     Unique contents prevent deduplication from disguising a twelve-row cap. */
  full_text = ""
  do i = 1 to 200
    full_text = full_text || "WideNet evidence " || right("000" || i,3) || "." || "0A"x
  end
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-wide','digest-wide','" || full_text || "','fixture','utf8','fixture');INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-wide','fixture','wide','revision-wide','active','fixture://wide','Wide net',1);INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-wide','source-wide','envelope-wide','artifact-evidence','text-wide','metadata-wide','2026-01-01T00:00:00Z',1)") = 0,"wide source")
  errors = errors + check(sqliteexec(database,"BEGIN") = 0,"wide fixture transaction")
  offset = 0
  do i = 1 to 200
    body = "WideNet evidence " || right("000" || i,3) || "."; end_offset = offset + length(body)
    sql = "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('wide-content-" || i || "','wide-digest-" || i || "','" || body || "','wide-input-" || i || "');INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('wide-chunk-" || i || "','revision-wide'," || i || "," || offset || "," || end_offset || ",'wide-content-" || i || "','wide-continuity-" || i || "','fixture','direct',1);INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('wide-chunk-" || i || "','wide-content-" || i || "','" || body || "')"
    errors = errors + check(sqliteexec(database,sql) = 0,"wide passage " || i)
    offset = end_offset + 1
  end
  errors = errors + check(sqliteexec(database,"COMMIT") = 0,"wide fixture commit")
  /* The quoted word has three query variants. Give each its 200-row share. */
  wide_options = .ragretrievaloptions("wide-net","",''x as .binary,600,12,100000,0,200,0,0)
  wide = .ragretrievalresult
  errors = errors + check(retrieveevidence(store,genericprofile(),'"WideNet"',wide_options,wide,error) = 0,"wide retrieval " || error)
  wide_passages = wide.evidence().passages()
  errors = errors + check(wide_passages.0 = 200,"all two hundred distinct passages returned; actual=" || wide_passages.0)
  if wide_passages.0 \= 200 then do
    wide_notes = wide.evidence().trace().notes()
    do i = 1 to wide_notes.0
      say wide_notes[i]
    end
  end
  encoded = ""
  errors = errors + check(encodeevidence(wide.evidence(),1048576,encoded,error) = 0,"two hundred passages serialize within configured ceiling " || error)
  do i = 1 to wide_passages.0
    resolved = .ragpassage
    errors = errors + check(resolvecitation(store,wide_passages[i].citation(),resolved,error) = 0 & resolved.text() = wide_passages[i].text(),"wide source citation " || i)
  end
  errors = errors + check(closeragstore(store, error) = 0, "close " || error)
  if errors > 0 then return 1
  say "EVIDENCE_METHODOLOGY_OK graph=explicit-anchors+outbound+inbound+both lexical_feedback=0 stored_direction=preserved inverse_claims=0 co_mentions=analysis-leads notes=durable+cited+analysis-only query_plans=quoted+frequency+fair query_gaps=partial+repeated projections=trace+path+timeline citation=parsed"
  return 0
