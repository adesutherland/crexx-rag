options levelg
import rxfnsb
import rxjson
import rxsqlite
import rxhash
import ragcommand
import ragproduct
import ragmcp
import operator_registry
import ragextractioncontract
import ragresolutioncontract
import ragresolutionreferences
import raganswerreferences
import raganswercontract
import ragquotationcontract
import ragassessment
import ragenrich
import generic_profile

main: procedure = .int
  arg args=.string[]
  errors=0
  subjects="chunk alias-issue concept note claim conflict alias mention support ambiguity provenance-chunk"
  do s=1 to words(subjects)
    do workflow=0 to 1
      schema=.jsondocument(resolutionresponseschema(word(subjects,s),workflow))
      strict_error=""
      if schema.valid()<>1 | strictschema(schema,schema.root(),"root",strict_error)<>1 then do
        say "PROMPT_FAIL resolution strict schema " || word(subjects,s) || " workflow=" || workflow || ": " || strict_error
        errors=errors+1
      end
    end
  end
  if errors>0 then return 1
  legacy_input='{"resolution_contract":"crexx-rag.resolution-contract/7","required_capability":"advanced-reasoning","evidence_expected":0}'
  legacy_prompt='04266e71a6959391c3af8eb47ee422213122e958a17884b52b93f7d3ed22bb0c'
  legacy_schema='fb5cbc3c4b7de68015a31328d0bca0cadeff4dffbec6d0ceb3297ebcde7bdd66'
  if resolutionlegacybinding(legacy_input,"Synthetic objective","chunk",0,legacy_prompt,legacy_schema)<>1 then do;say "PROMPT_FAIL authentic v7 frozen binding";return 1;end
  if resolutionlegacybinding(legacy_input,"Synthetic objective","chunk",0,legacy_prompt,changestr("fb5c",legacy_schema,"ffff"))=1 then do;say "PROMPT_FAIL tampered frozen schema accepted";return 1;end
  if resolutionlegacybinding(changestr("/7",legacy_input,"/6"),"Synthetic objective","chunk",0,legacy_prompt,legacy_schema)=1 then do;say "PROMPT_FAIL unsupported frozen version accepted";return 1;end
  legacy8_input='{"resolution_contract":"crexx-rag.resolution-contract/8","required_capability":"advanced-reasoning","evidence_expected":0}'
  legacy8_prompt='a278560de3a285935860be8a7788df557f00d6e4ddd1c0b6f7837d829db71488'
  legacy8_schema='6d60c87300f294bbcd72c26e402392d9b89ce2631845044bc3332bc40700b949'
  if resolutionlegacybinding(legacy8_input,"Synthetic objective","concept",0,legacy8_prompt,legacy8_schema)<>1 then do;say "PROMPT_FAIL authentic v8 frozen concept binding";return 1;end
  if resolutionlegacybinding(legacy8_input,"Synthetic objective","concept",0,legacy8_prompt,changestr("6d60",legacy8_schema,"ffff"))=1 then do;say "PROMPT_FAIL tampered v8 frozen schema accepted";return 1;end
  legacy9_input='{"resolution_contract":"crexx-rag.resolution-contract/9","required_capability":"advanced-reasoning","evidence_expected":0}'
  legacy9_prompt='9fad3306788a3d1df653f37703064d6c4aefecb041ccca54bed6d50e4404df69'
  legacy9_schema='046e73dddc15484cb8cb9d9b360ed5c838dbe3eca9c35f71f7817f39472d4b25'
  if resolutionlegacybinding(legacy9_input,"Synthetic objective","concept",0,legacy9_prompt,legacy9_schema)<>1 then do;say "PROMPT_FAIL authentic v9 frozen concept binding";return 1;end
  if resolutionlegacybinding(legacy9_input,"Synthetic objective","concept",0,legacy9_prompt,changestr("046e",legacy9_schema,"ffff"))=1 then do;say "PROMPT_FAIL tampered v9 frozen schema accepted";return 1;end
  legacy10_input='{"resolution_contract":"crexx-rag.resolution-contract/10","required_capability":"advanced-reasoning","evidence_expected":0}'
  legacy10_prompt='3178b9c3b05954c1cd5e28dd3c92fb5cacba4d3ea5f653e2f93f16809ce37301'
  legacy10_schema='960485b2d63e502d58281ea9fbc792a3f2bb748ab9d880b90f8a2ecf3fa0361a'
  if resolutionlegacybinding(legacy10_input,"Synthetic objective","concept",0,legacy10_prompt,legacy10_schema)<>1 then do;say "PROMPT_FAIL authentic v10 frozen concept binding";return 1;end
  if resolutionlegacybinding(legacy10_input,"Synthetic objective","concept",0,legacy10_prompt,changestr("9604",legacy10_schema,"ffff"))=1 then do;say "PROMPT_FAIL tampered v10 frozen schema accepted";return 1;end
  legacy11_input=changestr('resolution-contract/10',legacy10_input,'resolution-contract/11')
  current11_prompt=resolutioninputprompt(legacy11_input,"Synthetic objective","concept")
  wait_marker=" For an incomplete packet at the last reasoning call"
  wait_start=pos(wait_marker,current11_prompt)
  if wait_start=0 then do;say "PROMPT_FAIL scoped-wait instruction is absent";return 1;end
  frozen11_prompt=left(current11_prompt,wait_start-1)
  frozen11_schema=changestr(',"acquisition-wait"',resolutionresponseschema("concept",0),"")
  frozen11_prompt_hash=rxhash..sha256hex(frozen11_prompt as .binary)
  frozen11_schema_hash=rxhash..sha256hex(frozen11_schema as .binary)
  if resolutionlegacybinding(legacy11_input,"Synthetic objective","concept",0,frozen11_prompt_hash,frozen11_schema_hash)<>1 then do;say "PROMPT_FAIL authentic v11 frozen binding";return 1;end
  if resolutionlegacybinding(legacy11_input,"Synthetic objective","concept",0,frozen11_prompt_hash,changestr(left(frozen11_schema_hash,4),frozen11_schema_hash,"ffff"))=1 then do;say "PROMPT_FAIL tampered v11 frozen schema accepted";return 1;end
  answer_input='{"schema":"crexx-rag.answer-context/2","passages":[{"citation":"crexx-rag:long-source-one","text":"Literal E1 and crexx-rag:long-source-one","source_metadata":{"citation":"untouched"}}],"accepted_claims":[{"subject":"Philip Miller","object":"Johnson","direction":"outbound","supports":[{"citation":"crexx-rag:long-source-two","stance":"assertion"},{"citation":"crexx-rag:long-source-one"}]}],"analysis_notes":[{"citations":["crexx-rag:long-source-two"],"text":"Philips is a different person"}],"graph_leads":[{"limitation":"unproved"}],"gaps":["unknown"]}'
  answer_refs=.raganswerreferences(answer_input);answer_error=""
  projected=answer_refs.input()
  if pos('"citation":"E1"',projected)=0 | pos('"citation":"E2"',projected)=0 | pos('"citations":["E2"]',projected)=0 | pos('"schema":"crexx-rag.answer-context/3"',projected)=0 then do;say "PROMPT_FAIL answer reference projection";return 1;end
  if pos('Literal E1 and crexx-rag:long-source-one',projected)=0 | pos('"source_metadata":{"citation":"untouched"}',projected)=0 | pos('"direction":"outbound"',projected)=0 | pos('"limitation":"unproved"',projected)=0 then do;say "PROMPT_FAIL answer source or graph altered";return 1;end
  if answer_refs.mapping()<>'{"E1":"crexx-rag:long-source-one","E2":"crexx-rag:long-source-two"}' then do;say "PROMPT_FAIL answer mapping";return 1;end
  if answer_refs.canonical("E2")<>"crexx-rag:long-source-two" | answer_refs.canonical("E99")<>"" | answer_refs.canonical("crexx-rag:long-source-one")<>"" then do;say "PROMPT_FAIL unknown or full answer ID bypass";return 1;end
  different_refs=.raganswerreferences(changestr("long-source-two",answer_input,"other-source"))
  if different_refs.canonical("E2")=answer_refs.canonical("E2") then do;say "PROMPT_FAIL answer mapping leaked across requests";return 1;end
  if binlength(projected as .binary)>=binlength(answer_input as .binary) then do;say "PROMPT_FAIL aliases did not reduce context";return 1;end
  if pos("short references",answerprompt("objective"))=0 then do;say "PROMPT_FAIL answer reference instruction missing";return 1;end
  ordinary=resolutioninputprompt('{"required_capability":"ordinary","evidence_expected":0}',"Ordinary objective","alias-issue")
  advanced=resolutioninputprompt('{"required_capability":"advanced-reasoning","evidence_expected":0}',"Final objective","alias-issue")
  if pos("target_concept_id must be a concept_id from evidence.subject.candidates",ordinary)=0 then do;say "PROMPT_FAIL reuse target mapping";errors=errors+1;end
  if pos('For no-change, object_id and target_concept_id must both be empty',advanced)=0 then do;say "PROMPT_FAIL explicit no-change fields";errors=errors+1;end
  if pos("Unresolved is a valid decision",ordinary)>0 | pos("Unresolved is a valid decision",advanced)>0 then do;say "PROMPT_FAIL contradictory unresolved fallback";errors=errors+1;end
  if errors>0 then return 1
  if pos("Stored questions may describe unresolved uncertainty",ordinary)=0 | pos("Stored questions may describe unresolved uncertainty",advanced)=0 then do;say "PROMPT_FAIL legacy question outcome guidance";return 1;end
  corrected=resolutioncorrectionmessage('{"required_capability":"advanced-reasoning"}',"original quote failed")
  if pos("original quote failed",corrected)=0 | pos("final no-change",corrected)=0 | pos("choose unresolved",corrected)>0 | pos("updating mention indexes",corrected)>0 then do;say "PROMPT_FAIL advanced correction outcome";return 1;end
  corrected=resolutioncorrectionmessage('{"required_capability":"ordinary"}',"original quote failed")
  if pos("choose escalate",corrected)=0 | pos("choose unresolved",corrected)>0 then do;say "PROMPT_FAIL ordinary correction outcome";return 1;end
  guidance=.string[];guidance[1]=ordinary;guidance[2]=advanced;guidance[3]=corrected
  guidance[4]=resolutioncorrectionmessage('{"required_capability":"advanced-reasoning"}',"original quote failed")
  do g=1 to guidance.0
    if pos("restore requires a retired concept",guidance[g])=0 | pos("synonym must not collide with another active concept",guidance[g])=0 then do;say "PROMPT_FAIL lifecycle preconditions route " || g;return 1;end
  end
  if pos("updating mention indexes",correctionmessage("original quote failed"))=0 then do;say "PROMPT_FAIL extraction correction preserved";return 1;end
  corrected=resolutioncorrectionmessage('{"required_capability":"advanced-reasoning","evidence":{"subject":{"type":"provenance-chunk"}}}',"original quote failed")
  if pos("final no-change",corrected)>0 | pos("one assessment per supplied support_id",corrected)=0 then do;say "PROMPT_FAIL provenance correction retains its own envelope";return 1;end
  if pos("must not reproduce the parent",ordinary)=0 | pos("Kingsburgh",ordinary)=0 then do;say "PROMPT_FAIL split parent rule and example";return 1;end
  if pos("must not reproduce the parent",resolutioncorrectionmessage('{"required_capability":"advanced-reasoning"}',"bad split"))=0 then do;say "PROMPT_FAIL shared split correction";return 1;end
  if pos('An-\nother',quotationcontract())=0 | pos("literal backslash",correctionmessage("bad quotation"))=0 then do;say "PROMPT_FAIL OCR and escape examples";return 1;end
  marker="Complete no-change example: ";begin=pos(marker,advanced)+length(marker);finish=pos(". If citations",advanced,begin)
  example=.jsondocument(substr(advanced,begin,finish-begin));value="unexpected"
  if example.valid()<>1 | example.node_string(example.member(example.root(),"object_id"),value)<>0 | value<>"" then do;say "PROMPT_FAIL valid no-change example";return 1;end
  input='{"evidence":{"passages":[{"evidence_id":"selected-Dundee","text":"Écosse: Dundee left. At Dundee, Mary waited. Dundee.","span_start":25,"span_end":31}]},"required_capability":"ordinary","evidence_expected":0}'
  messages=resolutionmessages(genericprofile(),input,"ordinary objective","concept")
  if pos("selected UTF-8 bytes 25:31",messages[2].content())=0 | pos("Context for selected-Dundee",messages[2].content())=0 | pos("At Dundee, Mary waited.",messages[2].content())=0 | pos("Écosse",messages[2].content())=0 then do;say "PROMPT_FAIL selected Unicode context";return 1;end
  ref_input='{"resolution_contract":"crexx-rag.resolution-contract/5","evidence":{"subject":{"type":"alias-issue","id":"issue-original","candidates":[{"concept_id":"concept-original","canonical_label":"Argyle","concept_type":"person"}]},"catalogue":[],"passages":[{"evidence_id":"evidence-original","text":"made \nArgyle waited.","span_start":6,"span_end":12}]},"required_capability":"ordinary","evidence_expected":0}'
  messages=resolutionmessages(genericprofile(),ref_input,"ordinary objective","alias-issue")
  if pos('"id":"S1"',messages[2].content())=0 | pos('"concept_id":"C1"',messages[2].content())=0 | pos('"evidence_id":"E1"',messages[2].content())=0 then do;say "PROMPT_FAIL model short reference projection";return 1;end
  if pos("made " || "0A"x || "Argyle waited.",messages[2].content())=0 then do;say "PROMPT_FAIL readable source newlines";return 1;end
  refs=.ragresolutionreferences(ref_input);restored=.ragresolutionreferences(ref_input);ref_error=""
  if refs.mapping()<>'{"S1":"issue-original","C1":"concept-original","E1":"evidence-original"}' | refs.mapping()<>restored.mapping() then do;say "PROMPT_FAIL deterministic retained mapping";return 1;end
  encoded='{"action":"reuse","object_id":"S1","target_concept_id":"C1","evidence":[{"evidence_id":"E1","quote":"Argyle"}],"reason":"literal C1 and evidence-original remain source data"}'
  expanded=refs.response(encoded,ref_error)
  if ref_error<>"" | expanded<>'{"action":"reuse","object_id":"issue-original","target_concept_id":"concept-original","evidence":[{"evidence_id":"evidence-original","quote":"Argyle"}],"reason":"literal C1 and evidence-original remain source data"}' then do;say "PROMPT_FAIL canonical field expansion " || ref_error;return 1;end
  if restored.response(encoded,ref_error)<>expanded then do;say "PROMPT_FAIL frozen correction/recovery mapping";return 1;end
  target_input='{"resolution_contract":"crexx-rag.resolution-contract/12","evidence":{"subject":{"type":"concept","id":"subject-original","competing_identities":[{"concept_id":"concept-original"}]},"catalogue":[{"concept_id":"concept-original"}],"passages":[]}}'
  target_refs=.ragresolutionreferences(target_input)
  if pos('"concept_id":"C',target_refs.input())=0 then do;say "PROMPT_FAIL inspected competing identity projection";return 1;end
  target_alias="C2"
  if pos('"C2":"concept-original"',target_refs.mapping())=0 then do;say "PROMPT_FAIL competing identity alias mapping";return 1;end
  target_response='{"action":"inspect","question":"catalogue-target","object_id":' || jsonquote(target_alias) || '}'
  target_expanded=target_refs.response(target_response,ref_error)
  if target_alias="" | target_expanded<>'{"action":"inspect","question":"catalogue-target","object_id":"concept-original"}' | ref_error<>"" then do;say "PROMPT_FAIL catalogue target alias round trip " || ref_error || " " || target_expanded;return 1;end
  if target_refs.response('{"action":"inspect","question":"catalogue","object_id":"C1"}',ref_error)<>'{"action":"inspect","question":"catalogue","object_id":"C1"}' | ref_error<>"" then do;say "PROMPT_FAIL raw catalogue cursor changed";return 1;end
  if target_refs.response('{"action":"inspect","question":"catalogue-target","object_id":"concept-raw"}',ref_error)<>'{"action":"inspect","question":"catalogue-target","object_id":"concept-raw"}' | ref_error<>"" then do;say "PROMPT_FAIL raw target changed";return 1;end
  ignored=target_refs.response('{"action":"inspect","question":"catalogue-target","object_id":"C99"}',ref_error)
  if ref_error="" then do;say "PROMPT_FAIL unknown catalogue target reference accepted";return 1;end
  ignored=target_refs.response('{"action":"inspect","question":"catalogue-target","object_id":"S1"}',ref_error)
  if ref_error="" then do;say "PROMPT_FAIL wrong-kind catalogue target reference accepted";return 1;end
  ignored=refs.response(changestr('"C1"',encoded,'"E1"'),ref_error)
  if ref_error="" | pos("target_concept_id",ref_error)=0 then do;say "PROMPT_FAIL wrong-kind reference accepted";return 1;end
  ignored=refs.response(changestr('"E1"',encoded,'"E99"'),ref_error)
  if ref_error="" | pos("evidence_id",ref_error)=0 then do;say "PROMPT_FAIL unknown evidence reference accepted";return 1;end
  ignored=refs.response(changestr('"E1"',encoded,'"evidence-original"'),ref_error)
  if ref_error="" then do;say "PROMPT_FAIL model full-ID bypass accepted";return 1;end
  control='{"action":"no-change","object_id":"","target_concept_id":"","evidence":[]}'
  if refs.response(control,ref_error)<>control | ref_error<>"" then do;say "PROMPT_FAIL empty control references";return 1;end
  control='{"action":"read","object_id":"crexx-rag:library:source:revision:utf8-0-12","target_concept_id":"","evidence":[]}'
  if refs.response(control,ref_error)<>control | ref_error<>"" then do;say "PROMPT_FAIL exact read citation changed";return 1;end
  oldrefs=.ragresolutionreferences(changestr('resolution-contract/5',ref_input,'resolution-contract/4'))
  if oldrefs.enabled()<>0 | oldrefs.response(expanded,ref_error)<>expanded then do;say "PROMPT_FAIL legacy full-ID input changed";return 1;end
  newrefs=.ragresolutionreferences(changestr('evidence-original',ref_input,'different-evidence'))
  if newrefs.mapping()=refs.mapping() | restored.response(encoded,ref_error)<>expanded then do;say "PROMPT_FAIL refreshed input changed old mapping";return 1;end
  feedback=resolutionquotationfeedback(refs.input(),'{"evidence":[{"evidence_id":"E1","quote":"Invented quote"}]}')
  if pos("field=evidence[0]",feedback)=0 | pos("selected UTF-8 bytes 6:12",feedback)=0 | pos("Argyle",feedback)=0 then do;say "PROMPT_FAIL selected occurrence feedback";return 1;end
  feedback=resolutionquotationfeedback(refs.input(),'{"evidence":[{"evidence_id":"E99","quote":"Argyle"}]}')
  if pos("reference is not supplied",feedback)=0 then do;say "PROMPT_FAIL wrong-ID feedback";return 1;end
  plain=extractionprompt("operator objective");enriched=extractionprompt("operator objective",1)
  if left(plain,18)\="operator objective" | enriched\=plain || "0A"x || assessmentprompt() then return 1
  if wordpos("split",resolutionactions("claim",0))>0 | wordpos("retract",resolutionactions("claim",0))=0 then return 1
  if wordpos("move",resolutionactions("support",0))>0 | wordpos("move",resolutionactions("support",1))=0 then return 1
  if resolutioncontractversion()<>"crexx-rag.resolution-contract/12" | wordpos("inspect",resolutionactions("concept",0))=0 | wordpos("acquisition-wait",resolutionactions("concept",0))=0 | wordpos("propose-relationship",resolutionactions("concept",0))=0 | wordpos("propose-relationship",resolutionactions("concept",1))>0 | wordpos("propose-relationship",resolutionactions("claim",0))>0 then return 1
  if pos('"relationship_type","resolution_text"]',resolutionresponseschema("concept",0))=0 | pos("source-scoped catalogue",resolutionprompt("objective","concept"))=0 | pos("human semantic review",resolutionprompt("objective","concept"))=0 then return 1
  if resolutionresponseschema("provenance-chunk",0)\=enrichmentschema() then return 1
  if resolutionprompt("ignored","provenance-chunk")\=enrichmentprompt() || "0A"x || quotationcontract() then return 1
  final_prompt=resolutioninputprompt('{"required_capability":"advanced-reasoning","evidence_expected":0,"remaining_calls_including_this":1,"remaining_evidence_reads":0}',"Final objective","chunk")
  if pos("final reasoning route",final_prompt)=0 | pos("defer is forbidden",final_prompt)=0 | pos("including this one: 1",final_prompt)=0 | pos("action extract",final_prompt)=0 then return 1
  if wordpos("extract",resolutionactions("chunk",0))=0 | wordpos("extract",resolutionactions("claim",0))>0 then return 1
  feedback=quotationfeedback("Alpha",'{"mentions":[{"label":"Beta","evidence_quote":"Beta"}],"relationships":[],"notes":[]}')
  if pos("Detected citation problems=1",feedback)=0 | pos(feedback,correctionmessage(feedback))=0 then return 1
  database=.binary
  if sqliteopenmode(args[1] || "/prompt-schema.sqlite","create",database)\=0 then return 1
  schema=.jsondocument(enrichextractionschema(database,extractionresponseschema(genericprofile())))
  call sqliteclose database
  properties=schema.member(schema.root(),"properties");relationships=schema.member(properties,"relationships");item=schema.member(relationships,"items")
  if schema.node_count(schema.member(item,"required"))\=6 then return 1
  if schema.node_type(schema.member(schema.member(item,"properties"),"assessment"))\="object" then return 1
  access=.string[];access[1]="read";command_options=.ragcommandoption[];positionals=.string[]
  command_options[1]=.ragcommandoption("role","extractor",0)
  request=.ragcommandrequest("","architecture-local","generic-profile","","json","off",access,"config","prompt","config.prompt",command_options,positionals)
  result=dispatchproduct(request,operatorregistry());error="";output=""
  if result.exit_code()\=0 | rendercommandresult(result,"json",output,error)\=0 then do;say "PROMPT_INSPECTION_FAIL typed dispatch " || error;return 1;end
  if pos("Source quotation rules:",output)=0 | pos('"response_schema":',output)=0 then return 1
  response=mcpdispatch('{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rag_config_prompt","arguments":{"role":"extractor"}}}',"","architecture-local","generic-profile","read")
  if pos('"isError":false',response)=0 | pos("Source quotation rules:",response)=0 then do;say response;return 1;end
  response=mcpdispatch('{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rag_config_prompt","arguments":{"role":"extractor","unexpected":"x"}}}',"","architecture-local","generic-profile","read")
  if pos('"code":-32602',response)=0 then return 1
  clear access;access=.string[]
  denied=.ragcommandrequest("","architecture-local","generic-profile","","json","off",access,"config","prompt","config.prompt",command_options,positionals)
  result=dispatchproduct(denied,operatorregistry())
  if result.exit_code()\=4 then return 1
  say "PROMPT_INSPECTION_OK"
  return 0

/* Check the actual domain-generated schema at every object and array level.
 * Strict structured output requires an exact required/properties match. */
strictschema: procedure = .int
  arg schema=.jsondocument,node=.int,path=.string,expose error=.string
  kind="";ignored=schema.node_string(schema.member(node,"type"),kind)
  if kind="object" then do
    properties=schema.member(node,"properties");required=schema.member(node,"required")
    if schema.node_type(properties)<>"object" | schema.node_type(required)<>"array" | schema.node_get(schema.member(node,"additionalProperties"))<>"false" then do
      error=path || " needs properties, required and additionalProperties:false";return 0
    end
    members=.int[];ignored=schema.children(properties,members)
    if schema.node_count(required)<>members.0 then do;error=path || " required/properties count differs";return 0;end
    do i=1 to members.0
      name=schema.node_name(members[i]);seen=0
      do j=1 to schema.node_count(required)
        candidate="";if schema.node_string(schema.element(required,j),candidate)<>0 then do;error=path || " has a nonstring required entry";return 0;end
        if candidate=name then seen=seen+1
      end
      if seen<>1 then do;error=path || "." || name || " must appear exactly once in required";return 0;end
      if strictschema(schema,members[i],path || "." || name,error)<>1 then return 0
    end
    return 1
  end
  if kind="array" then do
    item=schema.member(node,"items")
    if schema.node_type(item)<>"object" then do;error=path || " needs one items schema";return 0;end
    return strictschema(schema,item,path || "[]",error)
  end
  if wordpos(kind,"string integer number boolean")=0 then do;error=path || " has unsupported schema type " || kind;return 0;end
  return 1
