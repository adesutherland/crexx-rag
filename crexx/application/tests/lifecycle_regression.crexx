options levelg

import rxfnsb
import rxsqlite
import rxjson
import ragstore
import ragwork
import ragworktypes
import raglifecycle

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do; say "LIFECYCLE_FAIL=" || label; return 1; end
  return 0

number: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database,sql,prepared) = 0 then if sqlitestep(prepared) = 100 then call sqlitecolumnint prepared,0,value
  call sqlitefinalize prepared
  return value

seed: procedure = .int
  arg database = .binary, id = .string, parent = .string, state = .string
  policy = '{"maximum_attempts":3}'
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('" || id || "','" || id || "','{}','snapshot-lifecycle','" || parent || "',10,10,1000,1000,1000,'fixture','fixture'); INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('" || id || "','" || id || "','claim-extraction','" || state || "',1,'" || id || "','input','{}','fixture','fixture'); INSERT INTO job_events(job_id,event_type,message,occurred_at) VALUES('" || id || "','budget-policy','" || policy || "','fixture')"
  return sqliteexec(database,sql)

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(args[1],"library-lifecycle","snapshot-lifecycle","lifecycle","1","generic-profile","profile-hash","config-hash",'{}',store,error)=0,"initialise " || error)
  if errors \= 0 then return 2
  database = store.database()
  errors = errors + check(lifecyclejobstate("running",0,1,0,0,"complete")="completed_with_errors","closed window retains dead letters")
  errors = errors + check(lifecyclejobstate("running",1,0,0,0,"deadline")="paused","closed window retains live ownership")
  errors = errors + check(lifecyclejobstate("paused",1,0,0,0,"")="paused","pause remains sticky")
  errors = errors + check(lifecyclejobstate("running",0,1,0,1,"")="paused","uncertainty holds drained job")
  errors = errors + check(lifecyclejobstate("cancel_requested",0,0,1,0,"")="cancelled","cancel drains terminally")
  errors = errors + check(lifecyclejobstate("running",0,0,1,0,"budget-exhausted")="completed","uncalled window remainder is checkpointed")
  parents = "queued running paused cancel_requested cancelled completed completed_with_errors"
  do i = 1 to words(parents)
    parent = word(parents,i); id = "parent-" || parent
    errors = errors + check(seed(database,id,parent,"dead_letter")=0,"seed parent " || parent)
    accepted = 0
    errors = errors + check(retrydeadletter(store,id,id,"parent matrix",accepted,error)=0 & accepted=1,"accept parent " || parent || " " || error)
    receipt = retryrequestjson(database,"",id)
    errors = errors + check(retrydeadletter(store,id,id,"duplicate",accepted,error)=0 & accepted=0,"deduplicate parent " || parent)
    if wordpos(parent,"paused cancel_requested cancelled")>0 then errors = errors + check(number(database,"SELECT count(*) FROM job_items WHERE item_id='" || id || "' AND state='dead_letter'")=1,"request does not resume " || parent)
  end
  states = "queued running cancel_requested cancelled dead_letter processed skipped"
  do i = 1 to words(states)
    state = word(states,i); id = "item-" || state
    errors = errors + check(seed(database,id,"paused",state)=0,"seed item " || state)
    accepted = 0
    errors = errors + check(retrydeadletter(store,id,id,"item matrix",accepted,error)=0 & accepted=1,"accept item " || state || " " || error)
    errors = errors + check(number(database,"SELECT count(*) FROM job_items WHERE item_id='" || id || "' AND state='" || state || "'")=1,"accept preserves " || state)
  end
  errors = errors + check(seed(database,"exhausted","completed_with_errors","dead_letter")=0,"seed ceiling")
  do i = 1 to 3
    errors = errors + check(sqliteexec(database,"INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('limit-" || i || "','exhausted','historic'," || i || ",'input','historic failure','dead_letter','fixture','fixture')")=0,"retain bounded attempts")
  end
  accepted = 0
  errors = errors + check(retrydeadletter(store,"exhausted","exhausted","attempt limit",accepted,error)=0 & accepted=1,"exhausted request accepted")
  errors = errors + check(pos('"retry_disposition":"attempt-limit"',retryrequestjson(database,"","exhausted"))>0,"limit explicitly held")
  empty = .ragworkclaim
  errors = errors + check(claimnext(store,"exhausted","no-new-work",30,3,empty,error)=1,"request cannot reset attempts")
  errors = errors + check(seed(database,"uncertain","completed_with_errors","dead_letter")=0,"seed uncertain")
  errors = errors + check(sqliteexec(database,"INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('uncertain-attempt','uncertain','historic',1,'input','unknown','expired','fixture','fixture'); INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES('uncertain','uncertain','uncertain-attempt','provider-intent','{}','fixture')")=0,"retain intent without response")
  errors = errors + check(retrydeadletter(store,"uncertain","uncertain","uncertain request",accepted,error)=0,"uncertain acceptance")
  errors = errors + check(pos('"retry_disposition":"provider-outcome-uncertain"',retryrequestjson(database,"","uncertain"))>0,"unknown call is held before explanatory event")
  errors = errors + check(claimnext(store,"uncertain","no-duplicate-call",30,3,empty,error)=1,"uncertain request cannot claim")
  errors = errors + check(seed(database,"live","queued","queued")=0,"seed live")
  live = .ragworkclaim
  errors = errors + check(claimnext(store,"live","owner",30,3,live,error)=0,"claim real live owner " || error)
  errors = errors + check(retrydeadletter(store,"live","live","live request",accepted,error)=0 & accepted=1,"accept beside owner")
  errors = errors + check(claimnext(store,"live","competitor",30,3,empty,error)=1,"no duplicate claim")
  errors = errors + check(number(database,"SELECT count(*) FROM attempts WHERE item_id='live'")=1,"request preserves fence and attempt")
  errors = errors + check(skipitem(store,live,"no supported claims",error)=0,"owner completes " || error)
  errors = errors + check(pos('"retry_state":"completed"',retryrequestjson(database,"","live"))>0,"completion resolves request")
  errors = errors + check(resumejob(store,"parent-paused",error)=0,"explicit resume " || error)
  errors = errors + check(claimnext(store,"parent-paused","resumed",30,3,live,error)=0,"pending retry follows explicit resume " || error)
  errors = errors + check(skipitem(store,live,"resumed no-claim output",error)=0,"complete resumed retry")
  errors = errors + check(seed(database,"progress","queued","queued")=0,"seed multi-item progress")
  errors = errors + check(sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('progress-peer','progress','claim-extraction','queued',1,'progress-peer','input','{}','fixture','fixture')")=0,"seed remaining peer")
  errors = errors + check(claimnext(store,"progress","progress-owner",30,3,live,error)=0,"claim progress item")
  errors = errors + check(sqliteexec(database,"UPDATE jobs SET updated_at='before-settlement' WHERE job_id='progress'")=0,"freeze previous progress time")
  errors = errors + check(skipitem(store,live,"completed progress item",error)=0,"settle while peer remains queued")
  errors = errors + check(number(database,"SELECT count(*) FROM jobs WHERE job_id='progress' AND state='running' AND updated_at<>'before-settlement'")=1,"progress time advances without changing running state")
  errors = errors + check(seed(database,"pause-failure","queued","queued")=0,"seed pause-failure")
  errors = errors + check(claimnext(store,"pause-failure","pause-owner",30,3,live,error)=0,"claim before pause-failure")
  errors = errors + check(retrydeadletter(store,"pause-failure","pause-failure","retry beside failure",accepted,error)=0,"accept before pause-failure")
  errors = errors + check(pausejob(store,"pause-failure",error)=0,"operator pauses before settlement")
  errors = errors + check(failattempt(store,live,0,1,3,"retained failure",error)=0,"settle failure under pause")
  errors = errors + check(number(database,"SELECT count(*) FROM jobs j JOIN job_items i USING(job_id) WHERE j.job_id='pause-failure' AND j.state='paused' AND i.state='dead_letter'")=1,"failure cannot implicitly resume pending retry")
  errors = errors + check(seed(database,"missing-policy","completed_with_errors","dead_letter")=0,"seed missing-policy")
  errors = errors + check(sqliteexec(database,"DELETE FROM job_events WHERE job_id='missing-policy' AND event_type='budget-policy'")=0,"represent legacy missing policy")
  errors = errors + check(retrydeadletter(store,"missing-policy","missing-policy","no inferred budget",accepted,error)=0,"accept legacy request without granting policy")
  errors = errors + check(pos('"retry_disposition":"policy-unavailable"',retryrequestjson(database,"","missing-policy"))>0,"missing policy held")
  errors = errors + check(seed(database,"replay-root","completed","dead_letter")=0,"seed terminal replay root")
  replay_policy = '{"time_budget_ms":10000,"maximum_call_input_tokens":128,"maximum_call_output_tokens":64,"maximum_call_cost":0,"maximum_call_time_ms":5000,"maximum_inflight_calls":1,"maximum_attempts":3}'
  replay_id = ""; replayed = 0
  errors = errors + check(replaydeadletters(store,"replay-root","","snapshot-lifecycle","reviewed replay",10,10,1000,1000,1000,0,replay_policy,replay_id,replayed,error)=0 & replayed=1,"replay completed parent " || error)
  errors = errors + check(retrydeadletter(store,"replay-root","replay-root","source beside replay",accepted,error)=0,"source request beside replay")
  errors = errors + check(pos('"retry_disposition":"existing-work"',retryrequestjson(database,"","replay-root"))>0,"source cannot duplicate descendant")
  duplicate_id = ""; duplicate_count = 0
  errors = errors + check(replaydeadletters(store,"replay-root","","snapshot-lifecycle","duplicate replay",10,10,1000,1000,1000,0,replay_policy,duplicate_id,duplicate_count,error)\=0,"second active replay rejected")
  errors = errors + check(claimnext(store,replay_id,"replay-owner",30,3,live,error)=0,"claim replay descendant")
  errors = errors + check(skipitem(store,live,"completed descendant",error)=0,"complete replay descendant")
  errors = errors + check(pos('"retry_state":"completed"',retryrequestjson(database,"","replay-root"))>0,"descendant completion settles ancestor request without resubmission")
  errors = errors + check(retrydeadletter(store,"replay-root","replay-root","covered descendant",accepted,error)=0,"covered source accepted")
  errors = errors + check(pos('"retry_disposition":"already-complete"',retryrequestjson(database,"","replay-root"))>0,"covered source completes request")
  errors = errors + check(replaydeadletters(store,"replay-root","","snapshot-lifecycle","covered replay",10,10,1000,1000,1000,0,replay_policy,duplicate_id,duplicate_count,error)\=0,"completed replay rejected")
  errors = errors + check(replaydeadletters(store,"uncertain","","snapshot-lifecycle","unknown replay",10,10,1000,1000,1000,0,replay_policy,duplicate_id,duplicate_count,error)\=0,"uncertain source replay rejected")
  errors = errors + check(number(database,"SELECT count(*) FROM job_replay_items WHERE source_item_id='replay-root'")=1,"one immutable replay lineage")
  errors = errors + check(sqliteexec(database,"UPDATE retry_requests SET reason='changed'")\=0,"request reason immutable")
  errors = errors + check(sqliteexec(database,"DELETE FROM retry_requests")\=0,"request history immutable")
  /* Operational waiver history is separate from completion and retry limits. */
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_tasks(task_id,kind,subject_type,subject_id,evidence_fingerprint,policy_fingerprint,evidence_json,question,state,priority,created_epoch,updated_epoch) VALUES('task:waiver','fixture','chunk','fixture','evidence','policy','{}','fixture question','failed',1,0,0)")=0,"waiver task fixture")
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"begin waiver ledger fixture")
  waiver="";again=""
  errors=errors+check(recordtaskwaiver(database,"task:waiver","",waiver,error)<>0,"waiver needs an explicit reason")
  errors=errors+check(sqliteexec(database,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES('waiver-review','fixture','task:waiver','pending','{}','fixture')")=0,"waiver pending review fixture")
  errors=errors+check(recordtaskwaiver(database,"task:waiver","not while reviewing",waiver,error)<>0,"waiver cannot bypass pending review")
  errors=errors+check(sqliteexec(database,"UPDATE reviews SET state='dismissed' WHERE review_id='waiver-review'")=0,"settle waiver review")
  errors=errors+check(recordtaskwaiver(database,"task:waiver","keep missing coverage explicit",waiver,error)=0,"record explicit waiver " || error)
  errors=errors+check(recordtaskwaiver(database,"task:waiver","duplicate reason",again,error)=0 & waiver=again,"waiver idempotence")
  errors=errors+check(pos('keep missing coverage explicit',taskwaiverjson(database,"task:waiver"))>0 & number(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='task:waiver' AND state='failed' AND attempt_count=0")=1,"waiver preserves original reason and task outcome")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_task_waivers SET reason='changed'")<>0 & sqliteexec(database,"DELETE FROM maintenance_task_waivers")<>0,"waiver identity and history are immutable")
  reopened="";accepted=0
  errors=errors+check(recordretryrequest(database,"task:waiver","","explicit reconsideration",reopened,accepted,error)=0 & accepted=1,"retry reopens waived question " || error)
  errors=errors+check(pos('reopened',taskwaiverjson(database,"task:waiver"))>0,"reopen retains the waiver")
  duplicate=""
  errors=errors+check(recordretryrequest(database,"task:waiver","","repeat reconsideration",duplicate,accepted,error)=0 & duplicate=reopened & accepted=0,"reopened retry identity survives repeats")
  second_waiver=""
  errors=errors+check(recordtaskwaiver(database,"task:waiver","close again with history",second_waiver,error)=0 & second_waiver<>waiver,"later waiver has a distinct retained identity")
  errors=errors+check(number(database,"SELECT count(*) FROM retry_requests WHERE task_id='task:waiver' AND state='completed' AND disposition='waived'")=1,"waiver closes the old retry without deleting it")
  second_retry=""
  errors=errors+check(recordretryrequest(database,"task:waiver","","reconsider again",second_retry,accepted,error)=0 & second_retry<>reopened & accepted=1,"new waiver can reopen without changing evidence or attempts")
  errors=errors+check(number(database,"SELECT count(*) FROM maintenance_task_waivers WHERE task_id='task:waiver' AND state='reopened'")=2 & number(database,"SELECT attempt_count FROM maintenance_tasks WHERE task_id='task:waiver'")=0,"all closure history and attempt ceilings remain")
  errors=errors+check(sqliteexec(database,"COMMIT")=0,"commit waiver ledger fixture")
  errors = errors + check(number(database,"SELECT count(*) FROM provider_runs")=0,"no fabricated provider calls")
  errors = errors + check(number(database,"SELECT count(*) FROM pragma_foreign_key_check")=0,"foreign keys intact")
  errors = errors + check(closeragstore(store,error)=0,"close " || error)
  if errors \= 0 then return 1
  say "LIFECYCLE_REGRESSION_OK states=14 requests=deduplicated ceilings=preserved unknown=held owner=fenced"
  return 0
