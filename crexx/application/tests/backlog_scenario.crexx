  graph_before=scalartext(database,"SELECT (SELECT count(*) FROM claims)||':'||(SELECT count(*) FROM maintenance_tasks)||':'||(SELECT count(*) FROM maintenance_decisions)||':'||(SELECT count(*) FROM reviews)||':'||(SELECT count(*) FROM provider_runs)")
