  errors = errors + check(scalartext(database,"SELECT hex(vector) FROM embeddings WHERE embedding_id='fixture-vector'") = "0000803F" & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer", "all lifecycle work preserves source text and vector bytes")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "full workflow SQLite integrity")
