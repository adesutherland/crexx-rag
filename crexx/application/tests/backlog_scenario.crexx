options levelg

import rxfnsb
import rxsqlite
import ragstore
import ragmaintain
import rxhash
import rxjson
import ragbacklog
import ragwork
import ragclaims
import ragprofile
import ragcanonical
import generic_profile

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "DURABLE_BACKLOG_FAIL=" || label
  return 1

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

fixtureprovider: class implements .ragworkprovider
  _response = .string
  *: factory
    arg response = .string
    _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(0,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)
    call result.resolution(_response,genericprofile())
    return result

/* Invoke the second worker while the first owns the final call reservation.
 * This forces the admission race without depending on timing or sleeps. */
budgetpeerprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _peer_status = .int
  _peer_disposition = .string
  _peer_error = .string
  *: factory
    arg store = .ragstorehandle
    _store = store; _peer_status = -99
    return
  peer_status: method = .int
    return _peer_status
  peer_disposition: method = .string
    return _peer_disposition
  peer_error: method = .string
    return _peer_error
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    peer = .fixtureprovider(responsejson("unresolved"))
    policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    _peer_status = runworkeronce(_store,claim.job_id(),"budget-peer",60,1,policy,peer,_peer_disposition,_peer_error,genericprofile())
    return peer.process(claim)

/* Close the window while extraction is in flight, then return its last result.
 * The worker must reconcile it before returning, even without another poll. */
closingextractionprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _closed = .int
  *: factory
    arg store = .ragstorehandle
    _store = store; _closed = 0
    return
  closed: method = .int
    return _closed
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    error = ""
    ignored = sqliteexec(_store.database(),"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || claim.job_id() || "'")
    _closed = tickbacklogwindow(_store,claim.job_id(),error)
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(0,"fixture","fixture","close-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

staleprovider: class implements .ragworkprovider
  _database = .binary
  _response = .string
  *: factory
    arg database = .binary, response = .string
    _database = database; _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    ignored = sqliteexec(_database,"UPDATE concepts SET canonical_label='Survivor revised during call' WHERE concept_id='concept-survivor'")
    provider = .fixtureprovider(_response)
    return provider.process(claim)

/* A response validated before the merge still carries the old catalogue ID.
 * Publication must resolve its mention again while it owns the writer. */
mergingextractionprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]; aliases = .string[]
    aliases[1] = "peer"
    mentions[1] = .ragworkmention("candidate-rel013","Peer","concept",9,13,aliases,"concept-peer")
    return .ragworkproviderresult(0,"fixture","fixture","request-rel013",10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

responsejson: procedure = .string
  arg action = .string, target = "", successors = "[]", evidence = "[]", object_id = "", question = "", qualifiers = "{}", effective_from = "", effective_to = ""
  return '{"action":' || jsonquote(action) || ',"object_id":' || jsonquote(object_id) || ',"target_concept_id":' || jsonquote(target) || ',"canonical_label":"","concept_type":"","successors":' || successors || ',"reason":"fixture evidence-based decision","evidence":' || evidence || ',"effective_from":' || jsonquote(effective_from) || ',"effective_to":' || jsonquote(effective_to) || ',"qualifiers_json":' || jsonquote(qualifiers) || ',"question":' || jsonquote(question) || '}'

runresolution: procedure = .int
  arg store = .ragstorehandle, job_id = .string, task_id = .string, response = .string, expose error = .string
  database = store.database()
  if tickbacklogwindow(store,job_id,error) < 0 then return -1
  /* The fixture explicitly selects the question being exercised. */
  if sqliteexec(database,"UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || task_id || "') AND state='queued'") \= 0 then return -1
  provider = .fixtureprovider(response); disposition = ""
  policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
  status = runworkeronce(store,job_id,"backlog-fixture",60,3,policy,provider,disposition,error,genericprofile())
  if status = 0 & disposition \= "resolution-recorded" & disposition \= "resolution-stale" then do; error = disposition; return -1; end
  return status

nextwindow: procedure = .int
  arg store = .ragstorehandle, policy_json = .string, expose job_id = .string, expose error = .string
  if job_id \= "" & scalarint(store.database(),"SELECT count(*) FROM maintenance_windows WHERE job_id='" || job_id || "' AND state='active'") = 1 then do
    if pausejob(store,job_id,error) \= 0 | tickbacklogwindow(store,job_id,error) < 0 then return -1
  end
  database = store.database(); generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  texts = .string[]; scores = .int[]
  census = .ragmaintenancecensus(generation,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  digest = rxhash..sha256hex((scalarint(database,"SELECT count(*) FROM maintenance_windows") || "fixture-next-window") as .binary)
  run_id = ""; items = 0
  return startbacklogwindow(store,census,"snapshot-lifecycle",digest,policy_json,run_id,job_id,items,error)

connectiontask: procedure = .string
  arg database = .binary, workflow = .string, kind = .string
  return scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='" || kind || "' AND state='dispatched' ORDER BY updated_epoch DESC,task_id LIMIT 1")

timingchecks: procedure = .int
  arg database = .binary
  errors = 0; error = ""; timing = ""
  starts = .string[]
  starts[1] = "2026-09-07T21:00:00Z"; starts[2] = "2026-09-07T23:30:00Z"; starts[3] = "2026-09-08T04:30:00Z"
  do i = 1 to starts.0
    now = scalarint(database,"SELECT unixepoch('" || starts[i] || "')")
    errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0,"resolve overnight " || error)
    errors = errors + check(pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0 & pos('"skipped":0',timing) > 0,"same closing morning before and after midnight")
  end
  now = scalarint(database,"SELECT unixepoch('2026-09-08T05:05:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"late overnight launch skips instead of adding a day")
  now = scalarint(database,"SELECT unixepoch('2026-09-08T05:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"closing boundary is exclusive")
  now = scalarint(database,"SELECT unixepoch('2026-03-28T22:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-03-29T05:00:00Z"',timing) > 0,"spring clock change preserves six local")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-01:30",7200,timing,error,now) < 0,"reject nonexistent spring closing time")
  now = scalarint(database,"SELECT unixepoch('2026-10-24T21:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-10-25T06:00:00Z"',timing) > 0,"autumn clock change preserves six local")
  now = scalarint(database,"SELECT unixepoch('2026-09-08T00:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"120","","",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-09-08T02:00:00Z"',timing) > 0,"duration counts elapsed time")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-08T06:00:00+01:00","",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0,"explicit offset deadline")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-07T06:00:00Z","",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"past exact deadline skips")
  errors = errors + check(resolvemaintenancetime(database,"120","","18:00-06:00",7200,timing,error,now) < 0,"reject competing timing controls")
  errors = errors + check(resolvemaintenancetime(database,"0","","",7200,timing,error,now) < 0 & resolvemaintenancetime(database,"999999999999999999999","","",7200,timing,error,now) < 0,"reject invalid duration safely")
  errors = errors + check(resolvemaintenancetime(database,"","2026-02-30T06:00:00Z","",7200,timing,error,now) < 0,"reject impossible date")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-09T06:00:00","",7200,timing,error,now) < 0,"exact deadline requires timezone offset")
  errors = errors + check(resolvemaintenancetime(database,"","","06:00-18:00",7200,timing,error,now) < 0 & resolvemaintenancetime(database,"","","25:00-06:00",7200,timing,error,now) < 0,"reject invalid overnight window")
  return errors

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  /* Applicability is a request contract as well as an apply-time guard. */
  note_schema = backlogschema("note",0); alias_schema = backlogschema("alias-issue",0)
  errors = errors + check(pos('"reuse"',note_schema) = 0 & pos('"distinct"',note_schema) = 0 & pos('"retain"',note_schema) > 0,"note schema excludes alias-only actions")
  errors = errors + check(pos('"reuse"',alias_schema) > 0 & pos('"distinct"',alias_schema) > 0 & pos('"split"',alias_schema) = 0,"alias schema offers identity resolution")
  kinds = "alias mention support claim note ambiguity"
  do i = 1 to words(kinds)
    schema = backlogschema(word(kinds,i),1)
    errors = errors + check(pos('"move"',schema) > 0 & pos('"retract"',schema) > 0 & pos('"reuse"',schema) = 0,"workflow connection schema " || word(kinds,i))
  end
  conflict_schema = backlogschema("conflict",1); gap_schema = backlogschema("gap",0)
  errors = errors + check(pos('"qualify"',conflict_schema) > 0 & pos('"move"',conflict_schema) = 0,"conflict schema retains supported claim resolution")
  errors = errors + check(pos('"investigate"',gap_schema) > 0 & pos('"split"',gap_schema) = 0 & pos('"reuse"',gap_schema) = 0,"gap schema offers only supported decisions")
  errors = errors + check(initragstore(path, "library-lifecycle-methodology", "snapshot-lifecycle", "lifecycle-methodology", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors > 0 then return 1
  database = store.database()
  errors = errors + timingchecks(database)
  errors = errors + check(sqliteexec(database, "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-lifecycle','raw-lifecycle','text/plain','utf-8',NULL,'fixture://lifecycle',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "artifact")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-lifecycle','text-digest-lifecycle','Platform Peer','fixture-v1','utf8-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "revision text")
  errors = errors + check(sqliteexec(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-lifecycle','fixture','lifecycle','revision-lifecycle','active','fixture://lifecycle','Lifecycle corpus',1)") = 0, "source")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-lifecycle','source-lifecycle','revision-envelope-lifecycle','artifact-lifecycle','text-lifecycle','metadata-lifecycle','fixture-time',1)") = 0, "revision")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-lifecycle','content-digest-lifecycle','Platform Peer','input-lifecycle')") = 0, "content")
  errors = errors + check(sqliteexec(database, "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-lifecycle','revision-lifecycle',1,0,13,'content-lifecycle','continuity-lifecycle','fixture-v1','direct',1)") = 0, "chunk")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-lifecycle','content-lifecycle','Platform Peer')") = 0, "FTS")
  errors = errors + check(sqliteexec(database, "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-parent','Platform','concept','active',1),('concept-peer','Peer','concept','active',1),('concept-survivor','Survivor','concept','active',1)") = 0, "concepts")
  errors = errors + check(sqliteexec(database, "INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('concept-parent',1,'Platform','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-peer',1,'Peer','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-survivor',1,'Survivor','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "concept versions")
  errors = errors + check(sqliteexec(database, "INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,ambiguity_id,decision_id,visible_from_generation) VALUES('alias-parent','platform','concept-parent',NULL,NULL,1)") = 0, "alias")
  errors = errors + check(sqliteexec(database, "INSERT INTO mentions(mention_id,concept_id,ambiguity_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-parent','concept-parent',NULL,'chunk-lifecycle',0,8,1),('mention-peer','concept-peer',NULL,'chunk-lifecycle',9,13,1)") = 0, "mentions")
  errors = errors + check(sqliteexec(database, "INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('claim-parent-peer','concept-parent','related-to','concept-peer','outbound','{}','fixture-v1',1),('claim-peer-survivor','concept-peer','related-to','concept-survivor','outbound','{}','fixture-v1',1)") = 0, "claims")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,decision_id,visible_from_generation) VALUES('support-parent-peer','claim-parent-peer','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1),('support-peer-survivor','claim-peer-survivor','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1)") = 0, "claim supports")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-parent','claim-parent-peer','claim-peer-survivor','pending',1)") = 0, "claim conflict")
  errors = errors + check(sqliteexec(database, "INSERT INTO ambiguity_candidates(ambiguity_id,concept_id,revision_chunk_id,decision_id,visible_from_generation) VALUES('ambiguity-parent','concept-parent','chunk-lifecycle',NULL,1)") = 0, "ambiguity candidate")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-parent','lead','Review Platform',800000,200000,'','active','{}','fixture',1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "analysis note")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-parent','note-parent','concept','concept-parent','chunk-lifecycle',0,8)") = 0, "analysis note link")
  errors = errors + check(publishmanifest(store, error) = 0, "initial manifest " || error)
  if errors > 0 then return 1


  policy_json = '{"mode":"automatic","window_seconds":1000,"automatic_actions":"reuse distinct split merge synonym type-correction retire restore move retract qualify retain investigate","maximum_impact":100,"maximum_attempts":3,"retry_seconds":1,"maximum_evidence_bytes":65536,"batch_items":100,"resolution_prompt":"Fixture resolution","knowledge_policy":"fixture-v1","provider_id":"fixture","model":"fixture","charging_basis":"local-compute","privacy":"public","profile_id":"generic-profile","discovery_context":"{}","input_tokens":100000,"output_tokens":10000,"cost_microunits":0,"time_ms":1000,"inflight":1,"item_limit":100,"model_calls":100,"input_budget":10000000,"output_budget":1000000,"cost_budget":0,"codex_turns":0}'
  policy = .jsondocument(policy_json); task_id = ""
  errors = errors + check(enqueuebacklogtask(database,"lifecycle","concept","concept-parent","","",999999,policy,task_id,error) = 0, "queue split decision " || error)
  grounds = ""
  errors = errors + check(validatebacklogresponse(database,task_id,responsejson("reuse"),grounds,error) \= 0 & error = "resolution action is not applicable to its subject","reject identity-only answer on a concept task")
  first_task = task_id
  errors = errors + check(enqueuebacklogtask(database,"lifecycle","concept","concept-parent","","",999999,policy,task_id,error) = 0 & task_id = first_task & scalarint(database,"SELECT count(*) FROM maintenance_tasks") = 1, "unchanged task is deduplicated")
  texts = .string[]; scores = .int[]
  census = .ragmaintenancecensus(1,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  run_id = ""; job_id = ""; items = 0
  errors = errors + check(startbacklogwindow(store,census,"snapshot-lifecycle",copies("d",64),policy_json,run_id,job_id,items,error) = 0 & items > 0, "start shared maintenance window " || error)
  if errors > 0 then return 1
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  successors = '[{"canonical_label":"Platform Alpha","concept_type":"concept"},{"canonical_label":"Platform Beta","concept_type":"concept"}]'
  split = responsejson("split","",successors,evidence,"concept-parent")
  grounds = ""
  errors = errors + check(validatebacklogresponse(database,first_task,changestr('"quote":"Platform"',split,'"quote":"Invented"'),grounds,error) \= 0, "invented resolution evidence rejected")
  error = ""
  errors = errors + check(runresolution(store,job_id,first_task,split,error) = 0, "apply split through fenced worker " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "migration-parent", "split retains migration parent")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_workflows") = 1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='connection'") = 6, "split atomically fans out the full support, ambiguity and conflict impact census")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE disposition='split:resolved'") = 1, "split decision retained")
  child = scalartext(database,"SELECT child_concept_id FROM concept_lineage WHERE parent_concept_id='concept-parent' ORDER BY child_concept_id LIMIT 1")
  workflow = scalartext(database,"SELECT workflow_id FROM maintenance_workflows")
  /* Pause the window with work remaining, then resume it as a fresh bounded
   * window. The source job and its decisions remain historical records. */
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "pause durable window " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE state='dispatched'") = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE state='pending'") > 0, "unstarted decisions survive pause")
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  census = .ragmaintenancecensus(generation,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  errors = errors + check(startbacklogwindow(store,census,"snapshot-lifecycle",copies("e",64),policy_json,run_id,job_id,items,error) = 0, "resume backlog in second window " || error)
  mention_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='mention' AND subject_id='mention-parent'")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,mention_task,responsejson("move",child,"[]",evidence),error) = 0, "move individual grounded mention " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || child || "' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM mentions WHERE mention_id='mention-parent' AND visible_to_generation IS NOT NULL") = 1, "mention movement preserves old evidence")
  alias_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='alias'")
  errors = errors + check(runresolution(store,job_id,alias_task,responsejson("unresolved"),error) = 0, "uncertain alias is an unresolved decision " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || alias_task || "'") = "superseded", "changed catalogue prevents stale answers before paid calls")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh independent note evidence")
  note_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE kind='analysis-lead' AND subject_id='note-parent' AND state='dispatched'")
  errors = errors + check(runresolution(store,job_id,note_task,responsejson("unresolved"),error) = 0, "uncertainty is a valid decision " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || note_task || "'") = "unresolved", "uncertainty remains explicit")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "checkpoint makes no provider calls")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM source_artifacts") = 1 & scalarint(database,"SELECT count(*) FROM revision_chunks") = 1 & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer", "source records and text preserved")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0, "foreign-key integrity")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = 3, "exact bounded fixture call count with zero-call stale rejection")
  /* Complete every connection category rather than considering split creation
   * itself a completed migration. Refresh windows through the public lifecycle. */
  errors = errors + check(sqliteexec(database,"UPDATE aliases SET normalized_alias='platform revised' WHERE alias_id='alias-parent'") = 0, "fixture changes alias evidence after unresolved interpretation")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "resume remaining connection decisions " || error)
  alias_task = connectiontask(database,workflow,"alias")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  errors = errors + check(alias_task \= "" & runresolution(store,job_id,alias_task,responsejson("move",child,"[]",evidence),error) = 0, "move alias with retained source anchor " || error)
  support_task = connectiontask(database,workflow,"support")
  evidence = '[{"evidence_id":"support-parent-peer","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("move",child,"[]",evidence),error) = 0, "move individually grounded claim support " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id='" || child || "' AND target_concept_id='concept-peer' AND direction='outbound' AND visible_to_generation IS NULL") = 1, "support move preserves relationship direction")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE support_id='support-parent-peer' AND visible_to_generation IS NOT NULL") = 1, "support movement preserves original source history")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_conflicts f JOIN claims c ON c.claim_id=f.claim_id WHERE c.source_concept_id='" || child || "' AND f.review_state='pending' AND f.visible_to_generation IS NULL") = 1, "claim movement preserves the pending conflict on its new identity")
  note_task = connectiontask(database,workflow,"note")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  evidence = '[{"evidence_id":"link-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,note_task,responsejson("move",child,"[]",evidence),error) = 0, "move linked analysis note " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_link_history WHERE note_id='note-parent' AND object_id='concept-parent'") = 1 & scalarint(database,"SELECT count(*) FROM analysis_note_links WHERE note_id='note-parent' AND object_id='concept-parent'") = 0, "note link keeps historical parent and current successor")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_link_history WHERE link_id='link-parent' AND revision_chunk_id='chunk-lifecycle' AND span_start=0 AND span_end=8 AND from_generation=1") = 1 & pos('link-parent',inspectbacklog(database,workflow)) > 0, "note movement preserves addressable source span and historical link inspection")
  ambiguity_task = connectiontask(database,workflow,"ambiguity")
  evidence = '[{"evidence_id":"ambiguity-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,ambiguity_task,responsejson("move",child,"[]",evidence),error) = 0, "move explicit ambiguity candidate " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM ambiguity_candidates WHERE concept_id='concept-parent' AND visible_to_generation IS NOT NULL") = 1, "ambiguity history preserved")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh retirement census " || error)
  retire_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND kind='retirement' AND state='dispatched'")
  errors = errors + check(retire_task \= "" & runresolution(store,job_id,retire_task,responsejson("retire","","[]","[]","concept-parent"),error) = 0, "retire only after complete impact census " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "retired" & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='" || workflow || "'") = "complete", "split workflow reaches durable completion")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM concept_versions WHERE concept_id='concept-parent'") = 3, "original, migration and retired versions retained")

  /* A response settled immediately before process death is reused under the
   * replacement lease. The fixture's next response is deliberately malformed. */
  recovery_task = ""
  errors = errors + check(enqueuebacklogtask(database,"recovery-test","concept","concept-survivor","","",999999,policy,recovery_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue recovery fixture")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select recovery fixture")
  claim = .ragworkclaim; reservation = .ragcallreservation
  errors = errors + check(claimnext(store,job_id,"crashed-fixture",60,3,claim,error) = 0 & reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0, "claim and reserve before crash " || error)
  settled_run = ""; response = responsejson("unresolved")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","settled-before-crash","succeeded",10,10,0,1,settled_run,error,"","local-compute",1,"",response,ragsha256(canonicalprofile(genericprofile()))) = 0, "atomically retain successful answer and usage " || error)
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET lease_until=0 WHERE item_id='" || claim.item_id() || "'") = 0, "simulate process death after settlement")
  provider = .fixtureprovider("MUST NOT CALL AGAIN"); disposition = ""; claim_policy = .ragclaimpolicy("fixture-v1","concept","related-to",1000000,750000,500000,-1000000,250000)
  errors = errors + check(runworkeronce(store,job_id,"replacement-fixture",60,3,claim_policy,provider,disposition,error,genericprofile()) = 0 & disposition = "resolution-recorded", "recover settled answer without another call " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || recovery_task || "'") = "unresolved", "recovery keeps exact paid call count")
  errors = errors + check(completebacklogdecision(store,job_id,claim.item_id(),claim.attempt_id(),claim.worker_id(),claim.fence(),settled_run,response,genericprofile(),error) = 0, "decision replay is idempotent")

  /* Supervised policy records an actionable proposal, then the ordinary
   * operator review path validates the same evidence before applying it. */
  supervised = changestr('"mode":"automatic"',policy_json,'"mode":"supervised"')
  review_task = ""
  errors = errors + check(enqueuebacklogtask(database,"review-test","concept",child,"","",999999,policy,review_task,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "start supervised resolution window")
  evidence_id = scalartext(database,"SELECT mention_id FROM mentions WHERE concept_id='" || child || "' AND visible_to_generation IS NULL LIMIT 1")
  evidence = '[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform"}]'
  response = changestr('"canonical_label":""',responsejson("synonym","","[]",evidence,child),'"canonical_label":"Platform Alias"')
  errors = errors + check(runresolution(store,job_id,review_task,response,error) = 0 & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || review_task || "'") = "review", "supervised resolution awaits review " || error)
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || review_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0, "accept grounded resolution review " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM aliases WHERE target_concept_id='" || child || "' AND normalized_alias='platform alias' AND visible_to_generation IS NULL") = 1, "review publishes validated synonym")
  errors = errors + check(inspectbacklog(database,workflow) \= "" & inspectbacklog(database,review_task) \= "", "tasks and workflow are inspectable")
  investigation_task = ""
  errors = errors + check(enqueuebacklogtask(database,"investigation-review","concept",child,"","",999999,policy,investigation_task,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "queue supervised investigation")
  errors = errors + check(runresolution(store,job_id,investigation_task,responsejson("investigate","","[]","[]","","Which source distinguishes the two Platform meanings?"),error) = 0, "record supervised investigation")
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || investigation_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE parent_task_id='" || investigation_task || "' AND kind='follow-up' AND question='Which source distinguishes the two Platform meanings?'") = 1, "reviewed investigation creates its focused durable follow-up " || error)

  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'") = 0 & tickbacklogwindow(store,job_id,error) = 1, "deadline closes window")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "deadline" & scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND state='queued'") = 0, "deadline checkpoints unstarted work")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "final SQLite integrity")
  /* Merge uses the same durable fan-out, with one explicitly selected
   * survivor. A resulting self-edge must be retracted, never silently copied. */
  merge_task = ""
  errors = errors + check(enqueuebacklogtask(database,"merge-test","concept","concept-peer","","",999999,policy,merge_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue merge workflow " || error)
  evidence = '[{"evidence_id":"mention-peer","quote":"Peer"}]'
  errors = errors + check(runresolution(store,job_id,merge_task,responsejson("merge",child,"[]",evidence,"concept-peer"),error) = 0, "create grounded merge workflow " || error)
  merge_workflow = scalartext(database,"SELECT workflow_id FROM maintenance_workflows WHERE parent_concept_id='concept-peer'")
  errors = errors + check(merge_workflow \= "" & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-peer'") = "migration-parent", "merge keeps its parent until migration completes")
  /* The survivor can already own the old spelling while the parent still
   * has connections to migrate. It must be the only extraction identity. */
  generation = scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(sqliteexec(database,"INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,visible_from_generation) VALUES('alias-merging-peer','peer','" || child || "'," || generation || ")") = 0,"seed survivor alias before parent retirement")
  merging_label = ""; merging_identity = ""
  errors = errors + check(resolveknownconcept(database,"Peer","concept",merging_label,merging_identity,error) = 1 & merging_identity = child,"REL-013 resolves active survivor while merge parent remains visible")
  extraction_input = '{"revision_chunk_id":"chunk-lifecycle","charging_basis":"local-compute"}'
  errors = errors + check(sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('job-rel013','" || rxhash..sha256hex('job-rel013' as .binary) || "','{}','snapshot-lifecycle','queued',1,1,128,64,0,'fixture','fixture'); INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-rel013','job-rel013','claim-extraction','queued',1,'idem-rel013','" || rxhash..sha256hex(extraction_input as .binary) || "','" || extraction_input || "','fixture','fixture')") = 0,"REL-013 extraction fixture")
  errors = errors + check(configurejobbudget(store,"job-rel013",10000,128,64,0,5000,1,1,error) = 0,"REL-013 budget " || error)
  extracting_provider = .mergingextractionprovider(); extracting_disposition = ""
  errors = errors + check(runworkeronce(store,"job-rel013","extracting-worker",60,1,claim_policy,extracting_provider,extracting_disposition,error,genericprofile()) = 0 & extracting_disposition = "concepts-and-notes","REL-013 publishes stale response against active survivor " || extracting_disposition || " " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items WHERE item_id='item-rel013' AND state='processed'") = 1 & scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || child || "' AND span_start=9 AND span_end=13") > 0,"REL-013 completes item and grounds survivor mention")
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-peer'") = "migration-parent","REL-013 never revives merge parent")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "dispatch merge connections")
  mention_task = connectiontask(database,merge_workflow,"mention")
  errors = errors + check(runresolution(store,job_id,mention_task,responsejson("move",child,"[]",evidence),error) = 0, "move merge mention " || error)
  support_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN claim_support s ON s.support_id=t.subject_id JOIN claims c ON c.claim_id=s.claim_id WHERE t.workflow_id='" || merge_workflow || "' AND t.state='dispatched' AND c.target_concept_id='concept-peer'")
  support_id = scalartext(database,"SELECT subject_id FROM maintenance_tasks WHERE task_id='" || support_task || "'")
  evidence = '[{"evidence_id":' || jsonquote(support_id) || ',"quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("retract","","[]",evidence),error) = 0, "explicitly retract self-edge support during merge " || error)
  support_task = connectiontask(database,merge_workflow,"support")
  support_id = scalartext(database,"SELECT subject_id FROM maintenance_tasks WHERE task_id='" || support_task || "'")
  evidence = '[{"evidence_id":' || jsonquote(support_id) || ',"quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("move",child,"[]",evidence),error) = 0, "move remaining independent merge support " || error)
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh merge retirement census")
  retire_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || merge_workflow || "' AND kind='retirement' AND state='dispatched'")
  errors = errors + check(retire_task \= "" & runresolution(store,job_id,retire_task,responsejson("retire","","[]","[]","concept-peer"),error) = 0, "complete merge retirement " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='" || merge_workflow || "'") = "complete" & scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id=target_concept_id AND visible_to_generation IS NULL") = 0, "merge completes without self relationships")

  /* A conflict answer must address every support and preserve the original
   * claim, its quotations and the unaffected competing claim as history. */
  live_claim = scalartext(database,"SELECT claim_id FROM claims WHERE source_concept_id='" || child || "' AND target_concept_id='concept-survivor' AND visible_to_generation IS NULL")
  live_support = scalartext(database,"SELECT support_id FROM claim_support WHERE claim_id='" || live_claim || "' AND visible_to_generation IS NULL LIMIT 1")
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) SELECT 'claim-context-test',source_concept_id,relationship_type,target_concept_id,direction,json_object('scope','other'),policy_version," || generation || " FROM claims WHERE claim_id='" || live_claim || "'") = 0, "seed scoped competing claim")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) SELECT 'support-context-test','claim-context-test',revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity," || generation || " FROM claim_support WHERE support_id='" || live_support || "'") = 0, "seed competing source support")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-context-test','" || live_claim || "','claim-context-test','pending'," || generation || ")") = 0, "seed contextual conflict")
  conflict_task = ""
  errors = errors + check(enqueuebacklogtask(database,"qualification-test","conflict","conflict-context-test","","",999999,policy,conflict_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue source-scoped conflict resolution")
  evidence = '[{"evidence_id":' || jsonquote(live_support) || ',"quote":"Platform Peer"}]'
  errors = errors + check(validatebacklogresponse(database,conflict_task,responsejson("qualify","","[]",evidence,live_claim,"",'{"scope":"documented"}',"1689","1690"),grounds,error) \= 0, "reject conflict answer that omits competing support")
  evidence = left(evidence,length(evidence)-1) || ',{"evidence_id":"support-context-test","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,conflict_task,responsejson("qualify","","[]",evidence,live_claim,"",'{"scope":"documented"}',"1689","1690"),error) = 0, "apply supported temporal and scope qualification " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='" || live_claim || "' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE effective_from='1689' AND effective_to='1690' AND json_extract(qualifiers_json,'$.scope')='documented' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='claim-context-test' AND visible_to_generation IS NULL") = 1, "qualification preserves old claim and unaffected competing claim")

  /* Missing links reuse the authoritative SQLite vector, without embedding
   * calls or changing source/chunk identities. */
  embedding_policy = '{"embedding_profile":"fixture-embedding","embedding_envelope":"fixture-envelope",' || substr(policy_json,2)
  digest = rxhash..sha256hex(("content-digest-lifecycle" || "00"x || "fixture-envelope") as .binary)
  errors = errors + check(sqliteexec(database,"INSERT INTO embedding_profiles(embedding_profile_id,provider_id,model,dimension,input_envelope_fingerprint,created_at) VALUES('fixture-embedding','fixture','fixture',1,'fixture','fixture'); INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,created_at) VALUES('fixture-vector','" || digest || "','fixture-embedding',X'0000803F',1,'fixture')") = 0, "seed authoritative vector without link")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  previous_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(nextwindow(store,embedding_policy,job_id,error) = 0, "discover missing embedding link " || error)
  errors = errors + check(scalarint(database,"SELECT visible_from_generation FROM revision_chunk_embeddings WHERE embedding_id='fixture-vector'") > previous_generation, "cached embedding repair publishes a new membership without changing historic generations")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM revision_chunk_embeddings WHERE embedding_id='fixture-vector' AND revision_chunk_id='chunk-lifecycle' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "SQLite vector link recovery makes zero provider calls")
  errors = errors + check(scalartext(database,"SELECT hex(vector) FROM embeddings WHERE embedding_id='fixture-vector'") = "0000803F" & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer", "all lifecycle work preserves source text and vector bytes")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "full workflow SQLite integrity")
  /* Explicit identity questions reuse established typed concepts and retain
   * different senses without treating spelling equality as identity. */
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,visible_from_generation) VALUES('alias-peer-survivor','peer','" || child || "'," || generation || "); INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('candidate-reuse','chunk-lifecycle','peer',9,13,'fixture-resolution'," || generation || "),('candidate-distinct','chunk-lifecycle','peer',9,13,'fixture-resolution'," || generation || "); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('candidate-reuse-decision','candidate-reuse',1,'accepted','{}','fixture','fixture'),('candidate-distinct-decision','candidate-distinct',1,'accepted','{}','fixture','fixture')") = 0, "seed identity questions")
  aliases = .string[]; aliases[1] = "Peer"
  errors = errors + check(recordaliasissue(database,"candidate-reuse","Peer","concept",aliases,error) = 0, "preserve unresolved reuse question")
  label = ""; selected = ""
  errors = errors + check(resolveknownconcept(database,"PEER","concept",label,selected,error) = 1 & selected = child, "unique typed catalogue reuse is deterministic")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "dispatch identity resolution")
  alias_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN maintenance_alias_issues i ON i.issue_id=t.subject_id WHERE i.candidate_id='candidate-reuse' AND t.state='dispatched'")
  evidence = '[{"evidence_id":"candidate-reuse","quote":"peer"}]'
  errors = errors + check(runresolution(store,job_id,alias_task,responsejson("reuse",child,"[]",evidence),error) = 0, "apply quoted catalogue reuse " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE candidate_id='candidate-reuse' AND state='resolved'") = 1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind LIKE 'alias-follow-up:%'") = 1, "identity answer queues a durable extraction follow-up")
  errors = errors + check(recordaliasissue(database,"candidate-distinct","Peer","source-artifact",aliases,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "dispatch distinct sense")
  alias_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN maintenance_alias_issues i ON i.issue_id=t.subject_id WHERE i.candidate_id='candidate-distinct' AND t.state='dispatched'")
  evidence = '[{"evidence_id":"candidate-distinct","quote":"Peer"}]'
  response = changestr('"canonical_label":""',responsejson("distinct","","[]",evidence),'"canonical_label":"Peer Document"')
  response = changestr('"concept_type":""',response,'"concept_type":"source-artifact"')
  errors = errors + check(runresolution(store,job_id,alias_task,response,error) = 0, "retain distinct typed sense " || error)
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || alias_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind LIKE 'alias-follow-up:%'") = 2, "reviewed identity decision also retains its extraction follow-up " || error)

  errors = errors + check(scalarint(database,"SELECT count(DISTINCT target_concept_id) FROM aliases WHERE normalized_alias='peer' AND target_concept_id IS NOT NULL AND visible_to_generation IS NULL") = 2 & scalarint(database,"SELECT count(*) FROM aliases WHERE normalized_alias='peer' AND ambiguity_id IS NOT NULL AND visible_to_generation IS NULL") > 0, "shared spelling retains both identities and explicit ambiguity")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE state='open'") = 0, "automatic and supervised identity workflows settle their questions")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0, "identity resolution foreign keys")
  /* A concurrent evidence edit after admission must retain the paid decision
   * without publishing an empty or stale semantic generation. */
  stale_task = ""
  errors = errors + check(enqueuebacklogtask(database,"stale-after-call","concept","concept-survivor","","",999999,policy,stale_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue post-call stale decision")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || stale_task || "') AND state='queued'") = 0, "select post-call stale fixture")
  previous_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  stale_provider = .staleprovider(database,responsejson("retire","","[]","[]","concept-survivor"))
  errors = errors + check(runworkeronce(store,job_id,"stale-fixture",60,3,claim_policy,stale_provider,disposition,error,genericprofile()) = 0, "settle stale result " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || stale_task || "'") = "superseded" & scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = previous_generation, "stale result creates no semantic generation")

  /* A settled response remains usable in the next window even when the
   * original task has already consumed its one permitted paid call. */
  recovery_task = ""
  capped_policy = changestr('"maximum_attempts":3',policy_json,'"maximum_attempts":1')
  errors = errors + check(enqueuebacklogtask(database,"closed-window-recovery","concept","concept-survivor","","",999999,policy,recovery_task,error) = 0 & nextwindow(store,capped_policy,job_id,error) = 0, "queue capped recovery fixture")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select capped recovery")
  errors = errors + check(claimnext(store,job_id,"crashed-window-fixture",60,1,claim,error) = 0 & reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0, "claim capped recovery")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","settled-at-window-boundary","succeeded",10,10,0,1,settled_run,error,"","local-compute",1,"",responsejson("unresolved"),ragsha256(canonicalprofile(genericprofile()))) = 0, "settle at window boundary")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'; UPDATE job_items SET lease_until=0 WHERE item_id='" || claim.item_id() || "'") = 0 & tickbacklogwindow(store,job_id,error) >= 0, "close expired window")
  recovery_claim = .ragworkclaim
  errors = errors + check(claimnext(store,"","recovery-only",60,1,recovery_claim,error,0) = 1 & nextwindow(store,capped_policy,job_id,error) = 0, "recover lease before next window " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select cached cross-window result")
  errors = errors + check(runworkeronce(store,job_id,"new-window-worker",60,1,claim_policy,provider,disposition,error,genericprofile()) = 0 & disposition = "resolution-recorded", "reuse settled output at paid-attempt cap " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || recovery_task || "'") = "unresolved" & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "cross-window recovery makes zero duplicate calls")

  /* An already considered prefix must not close a small-batch census before
   * later notes are seen. Manual collection stays zero-call, then automatic
   * mode can resume its unattempted questions. */
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "pause before cursor fixture")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET state='resolved' WHERE state IN('pending','review','dispatched')") = 0, "simulate previously considered task prefix")
  do i = 1 to 5
    id = "zz-cursor-note-" || i
    errors = errors + check(sqliteexec(database,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('" || id || "','lead','Platform Peer',1,1,'','active','{}','fixture',1,'fixture','fixture'); INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('" || id || "-link','" || id || "','chunk','chunk-lifecycle','chunk-lifecycle',0,13)") = 0, "seed cursor note")
  end
  manual_policy = changestr('"mode":"automatic"',changestr('"batch_items":100',policy_json,'"batch_items":1'),'"mode":"manual"')
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(nextwindow(store,manual_policy,job_id,error) = 0, "start manual small-batch census")
  do tick = 1 to 100
    if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") \= "active" then leave
    if tickbacklogwindow(store,job_id,error) < 0 then do; errors = errors+check(0,"manual census " || error); leave; end
  end
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_id LIKE 'zz-cursor-note-%' AND state='review'") = 5 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "complete cursor coverage and zero-call manual collection")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_id LIKE 'zz-cursor-note-%' AND state='dispatched'") = 5, "automatic window resumes manually collected work")
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "close test window")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "final backlog integrity")
  /* A diagnostic is not a search question. Preserve the recorded question
   * in the provider packet and use it to select source evidence. */
  gap_warning = "One or more query names remain ambiguous; do not transfer facts between senses."
  gap_question = 'How does "Platform" relate to Peer?'
  errors = errors + check(sqliteexec(database,"INSERT INTO query_gaps(gap_id,question_hash,normalized_question,gap_text,trace_id,observed_generation,occurrence_count,state,first_observed_at,last_observed_at) VALUES('gap-platform','question-platform','" || gap_question || "','" || gap_warning || "','trace-platform',1,1,'open','fixture','fixture'),('gap-missing','question-missing','Where is Vestiarium Scoticum?','" || gap_warning || "','trace-missing',1,1,'open','fixture','fixture'),('gap-stopwords','question-stopwords','what which how','" || gap_warning || "','trace-stopwords',1,1,'open','fixture','fixture')") = 0,"seed different query questions with the same warning")
  packet = ""; fingerprint = ""
  errors = errors + check(buildbacklogevidence(database,"gap","gap-platform","",65536,packet,fingerprint,error) = 0,"build original query evidence " || error)
  errors = errors + check(pos('"question":' || jsonquote(gap_question),packet) > 0 & pos('"text":' || jsonquote(gap_warning),packet) > 0,"gap packet retains question and diagnostic separately")
  errors = errors + check(pos('"revision_chunk_id":"chunk-lifecycle"',packet) > 0 & pos('"text":"Platform Peer"',packet) > 0,"gap selects source passage using question subject")
  errors = errors + check(buildbacklogevidence(database,"gap","gap-missing","",65536,packet,fingerprint,error) = 0 & pos('"passages":[]',packet) > 0,"same warning with absent question terms returns no invented evidence")
  errors = errors + check(buildbacklogevidence(database,"gap","gap-stopwords","",65536,packet,fingerprint,error) = 0 & pos('"passages":[]',packet) > 0,"empty useful question never falls back to warning words")
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_tasks(task_id,kind,subject_type,subject_id,evidence_fingerprint,policy_fingerprint,evidence_json,question,state,priority,created_epoch,updated_epoch) VALUES('task:legacy-gap','query-gap','gap','gap-platform','old-warning-only-evidence','fixture-v1','{}','Investigate the issue','unresolved',750000,0,0)") = 0,"seed unresolved warning-only maintenance record")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs"); previous_generation = scalarint(database,"SELECT published_generation FROM library_meta")
  gap_task = ""; replay_task = ""
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,gap_task,error) = 0 & gap_task \= "","refresh existing gap with original question " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='task:legacy-gap'") = "superseded","new evidence supersedes unresolved warning-only interpretation")
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,replay_task,error) = 0 & replay_task = gap_task,"corrected gap task is idempotent")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalarint(database,"SELECT published_generation FROM library_meta") = previous_generation & scalarint(database,"SELECT count(*) FROM query_gaps WHERE state='open'") = 3,"evidence refresh preserves gaps and generation with zero provider calls")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0,"normal maintenance discovers corrected query gaps " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_type='gap' AND state='dispatched'") = 3,"all query gaps enter ordinary durable maintenance")
  evidence = '[{"evidence_id":"chunk-lifecycle","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,gap_task,responsejson("retain","","[]",evidence),error) = 0 & scalartext(database,"SELECT state FROM query_gaps WHERE gap_id='gap-platform'") = "resolved","grounded maintenance can settle an investigated gap " || error)
  gap_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE subject_id='gap-missing' AND state='dispatched'")
  errors = errors + check(runresolution(store,job_id,gap_task,responsejson("unresolved"),error) = 0 & scalartext(database,"SELECT state FROM query_gaps WHERE gap_id='gap-missing'") = "open" & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || gap_task || "'") = "unresolved","missing source evidence stays explicitly unresolved " || error)
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"close query-gap test window")
  errors = errors + check(scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer" & scalartext(database,"SELECT hex(vector) FROM embeddings WHERE embedding_id='fixture-vector'") = "0000803F" & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"query-gap maintenance preserves source and vector state")
  /* Budget completion is a successful boundary, with uncalled tasks retained
   * for the next window and no failed attempt manufactured by the loser. */
  bounded_policy = changestr('"maximum_attempts":3',changestr('"model_calls":100',changestr('"inflight":1',policy_json,'"inflight":2'),'"model_calls":1'),'"maximum_attempts":1')
  budget_first = ""; budget_peer = ""
  errors = errors + check(enqueuebacklogtask(database,"budget-first","concept","concept-survivor","","",1000000,policy,budget_first,error) = 0 & enqueuebacklogtask(database,"budget-peer","concept","concept-survivor","","",1000000,policy,budget_peer,error) = 0 & nextwindow(store,bounded_policy,job_id,error) = 0,"start final-call race fixture " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000002 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || budget_first || "'); UPDATE job_items SET priority=1000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || budget_peer || "')") = 0,"select budget race claims")
  peer_provider = .budgetpeerprovider(store)
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(runworkeronce(store,job_id,"budget-owner",60,1,claim_policy,peer_provider,disposition,error,genericprofile()) = 0,"finish admitted final call " || error)
  errors = errors + check(peer_provider.peer_status() = 1 & peer_provider.peer_disposition() = "budget-deferred" & peer_provider.peer_error() = "","peer waits cleanly at reserved call limit " || peer_provider.peer_error())
  errors = errors + check(runworkeronce(store,job_id,"budget-owner",60,1,claim_policy,provider,disposition,error,genericprofile()) = 1 & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "budget-exhausted","worker stops normally after final settlement " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous+1 & scalarint(database,"SELECT count(*) FROM attempts a JOIN job_items i USING(item_id) WHERE i.job_id='" || job_id || "' AND a.outcome IN('failed','dead_letter')") = 0,"one paid call and no budget failure")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || budget_peer || "'") = "pending" & scalarint(database,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m USING(item_id) WHERE m.task_id='" || budget_peer || "' AND a.provider_run_id IS NOT NULL") = 0 & scalarint(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='" || job_id || "'") = 0,"uncalled peer keeps its full retry allowance and reservations are drained")
  errors = errors + check(nextwindow(store,bounded_policy,job_id,error) = 0 & runresolution(store,job_id,budget_peer,responsejson("unresolved"),error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous+2,"next plan resumes uncalled work " || error)
  errors = errors + check(tickbacklogwindow(store,job_id,error) >= 0 & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"final-call fixture integrity")
  /* Closing the window after claims were taken must still let admitted work
   * settle, while the uncalled claim returns to the backlog without error. */
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & claimnext(store,job_id,"deadline-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"deadline-peer",60,1,recovery_claim,error) = 0,"claim deadline race peers")
  errors = errors + check(reservecall(store,claim,100001,10000,0,1000,reservation,error) < 0 & error = "provider call exceeds the per-call cap","invalid reservation remains an error")
  errors = errors + check(reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0,"reserve before window close")
  duplicate = .ragcallreservation
  errors = errors + check(reservecall(store,claim,100000,10000,0,1000,duplicate,error) < 0 & scalartext(database,"SELECT outcome FROM attempts WHERE attempt_id='" || claim.attempt_id() || "'") = "running","duplicate reservation cannot defer an admitted call")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'") = 0 & tickbacklogwindow(store,job_id,error) = 1 & reservecall(store,recovery_claim,100000,10000,0,1000,duplicate,error) = 1 & error = "","closed window defers its uncalled claim cleanly")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","deadline-final-call","succeeded",10,10,0,1,settled_run,error) = 0 & skipitem(store,claim,"fixture settled admitted call",error) = 0,"finish call admitted before deadline " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM jobs WHERE job_id='" || job_id || "'") = "completed" & scalarint(database,"SELECT count(*) FROM maintenance_tasks t JOIN maintenance_task_items m USING(task_id) WHERE m.item_id='" || recovery_claim.item_id() || "' AND t.state='pending'") = 1,"deadline completes job and preserves uncalled task")
  closed_epoch = scalarint(database,"SELECT closed_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks t JOIN maintenance_task_items m USING(task_id) WHERE m.item_id='" || claim.item_id() || "' AND t.state='resolved'") = 1,"closed window reconciles its final settled task " || error)
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalarint(database,"SELECT closed_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'") = closed_epoch & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "deadline","closed reconciliation is idempotent and cannot reopen work")
  /* Two overlapping calls may accumulate more provider minutes than wall
   * minutes. Disabling the explicit provider cap must admit both and continue. */
  closing_task = ""
  errors = errors + check(enqueuebacklogtask(database,"alias-follow-up:closed-worker","chunk","chunk-lifecycle","","",1000000,policy,closing_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"queue final extraction fixture " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000002 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || closing_task || "')") = 0,"select closing extraction")
  closing_provider = .closingextractionprovider(store)
  errors = errors + check(runworkeronce(store,job_id,"last-worker",60,1,claim_policy,closing_provider,disposition,error,genericprofile()) = 0 & closing_provider.closed() = 1,"finish extraction after concurrent window closure " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || closing_task || "'") = "resolved" & scalarint(database,"SELECT reserved_calls FROM jobs WHERE job_id='" || job_id || "'") = 0,"last worker reconciles before stopping without another poll")

  time_policy = changestr('"time_ms":1000',changestr('"inflight":1',policy_json,'"inflight":2'),'"time_ms":700000')
  resolved_timing = ""
  errors = errors + check(resolvemaintenancetime(database,"","","",1000,resolved_timing,error) = 0,"resolve a fixed deadline before apply")
  time_policy = '{"timing":' || jsonquote(resolved_timing) || ',"provider_time_budget_ms":0,' || substr(time_policy,2)
  errors = errors + check(nextwindow(store,time_policy,job_id,error) = 0,"open independent wall-time window " || error)
  original_deadline = scalarint(database,"SELECT json_extract('" || resolved_timing || "','$.deadline_epoch')")
  errors = errors + check(scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'") = original_deadline,"apply preserves the planned deadline")
  errors = errors + check(claimnext(store,job_id,"time-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"time-peer",60,1,recovery_claim,error) = 0,"claim parallel time peers")
  errors = errors + check(reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0 & reservecall(store,recovery_claim,100000,10000,0,700000,duplicate,error) = 0,"parallel reservations do not consume wall duration " || error)
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","time-owner","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0,"settle first simulated long call")
  errors = errors + check(settlecall(store,duplicate,"fixture","fixture","time-peer","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,recovery_claim,"time fixture",error) = 0,"settle second simulated long call")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "active","sum of parallel durations cannot close wall window")
  errors = errors + check(claimnext(store,job_id,"time-restarted-worker",60,1,claim,error) = 0 & reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0,"restart admits work after accumulated duration exceeds wall allowance")
  errors = errors + check(scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'") = original_deadline,"worker restart retains deadline")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","time-restarted","succeeded",10,10,0,1,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0,"settle restarted worker")
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"pause time fixture")
  limited_policy = changestr('"provider_time_budget_ms":0',time_policy,'"provider_time_budget_ms":1000000')
  errors = errors + check(nextwindow(store,limited_policy,job_id,error) = 0 & claimnext(store,job_id,"cap-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"cap-peer",60,1,recovery_claim,error) = 0,"open explicit provider-time cap")
  errors = errors + check(reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0 & reservecall(store,recovery_claim,100000,10000,0,700000,duplicate,error) = 1,"explicit aggregate cap still counts concurrent reservations")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","cap-owner","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0 & tickbacklogwindow(store,job_id,error) = 1,"explicit provider-time limit closes successfully")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "budget-exhausted" & scalarint(database,"SELECT reserved_calls FROM jobs WHERE job_id='" || job_id || "'") = 0,"explicit cap has clean settlement")
  call closeragstore store,error
  if errors > 0 then return 1
  say "DURABLE_BACKLOG_OK deduplicated split_fanout fenced_decisions resume uncertainty source_preservation"
  return 0
