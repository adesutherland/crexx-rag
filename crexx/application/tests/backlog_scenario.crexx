options levelg

import rxfnsb
import rxsqlite
import ragsqlsupport
import ragstore
import ragmaintain
import rxhash
import rxjson
import ragbacklog
import ragresolutionreferences
import raglifecycle
import ragwork
import ragworktypes
import ragclaims
import ragprofile
import ragcanonical
import generic_profile
import architecture_local_config
import ragcommand
import ragcommandutil
import ragproduct
import ragmcp
import ragconfiguration
import operator_registry

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "DURABLE_BACKLOG_FAIL=" || label
  return 1

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

fixtureprovider: class implements .ragworkprovider
  _response = .string
  *: factory
    arg response = .string
    _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(0,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)
    if _response<>"empty-extraction" then call result.resolution(_response,genericprofile())
    return result

/* Invoke the second worker while the first owns the final call reservation.
 * This forces the admission race without depending on timing or sleeps. */
budgetpeerprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _peer_status = .int
  _peer_disposition = .string
  _peer_error = .string
  *: factory
    arg store = .ragstorehandle
    _store = store; _peer_status = -99
    return
  peer_status: method = .int
    return _peer_status
  peer_disposition: method = .string
    return _peer_disposition
  peer_error: method = .string
    return _peer_error
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    peer = .fixtureprovider(responsejson("unresolved"))
    policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    _peer_status = runworkeronce(_store,claim.job_id(),"budget-peer",60,1,policy,peer,_peer_disposition,_peer_error,genericprofile())
    return peer.process(claim)

/* Close the window while extraction is in flight, then return its last result.
 * The worker must reconcile it before returning, even without another poll. */
closingextractionprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _closed = .int
  *: factory
    arg store = .ragstorehandle
    _store = store; _closed = 0
    return
  closed: method = .int
    return _closed
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    error = ""
    ignored = sqliteexec(_store.database(),"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || claim.job_id() || "'")
    _closed = tickbacklogwindow(_store,claim.job_id(),error)
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(0,"fixture","fixture","close-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

staleprovider: class implements .ragworkprovider
  _database = .binary
  _response = .string
  *: factory
    arg database = .binary, response = .string
    _database = database; _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    ignored = sqliteexec(_database,"UPDATE concepts SET canonical_label='Survivor revised during call' WHERE concept_id='concept-survivor'")
    provider = .fixtureprovider(_response)
    return provider.process(claim)

/* A response validated before the merge still carries the old catalogue ID.
 * Publication must resolve its mention again while it owns the writer. */
mergingextractionprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]; aliases = .string[]
    aliases[1] = "peer"
    mentions[1] = .ragworkmention("candidate-rel013","Peer","concept",9,13,aliases,"concept-peer")
    return .ragworkproviderresult(0,"fixture","fixture","request-rel013",10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

identitycollisionprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]; aliases = .string[]
    aliases[1] = "Platform"
    mentions[1] = .ragworkmention("candidate-identity-collision","Platform","evidence-span",0,8,aliases)
    return .ragworkproviderresult(0,"fixture","fixture","identity-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

failureclassprovider: class implements .ragworkprovider
  _status = .int
  _content = .int
  *: factory
    arg status = .int, content = .int
    _status = status; _content = content
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal
    mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(_status,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,1,empty,"fixture classified failure",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)
    call result.set_content_failure(_content)
    return result

/* UX-03: compare the proposed connection effects with independent ledger reads.
 * This fixture does not call a provider or run a worker window. */
workflowclosurechecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  database = store.database(); errors = 0; error = ""; policy = .jsondocument(policy_json); config = architecturelocalconfig(); profile = genericprofile()
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  jobs = scalarint(database,"SELECT count(*) FROM jobs"); items = scalarint(database,"SELECT count(*) FROM job_items")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('closure-parent','Platform closure','concept','migration-parent'," || current || ")") = 0,"external closure fixture")
  origin = ""
  errors = errors + check(enqueuebacklogtask(database,"closure-origin","concept","closure-parent","","",1,policy,origin,error) = 0,"external closure origin")
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_workflows(workflow_id,origin_task_id,kind,parent_concept_id,successors_json,state,created_generation,created_epoch,updated_epoch) VALUES('closure-workflow'," || _testquote(origin) || ",'split','closure-parent','[]','migrating'," || current || ",unixepoch(),unixepoch())") = 0,"external closure workflow")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('closure-mention','closure-parent','chunk-lifecycle',0,8," || current || "); UPDATE maintenance_tasks SET state='resolved' WHERE task_id=" || _testquote(origin)) = 0,"retained completed split and connection")
  connection=""; connection_plan=""; connection_review=""
  errors = errors + check(enqueuebacklogtask(database,"connection","mention","closure-mention","closure-workflow",origin,1,policy,connection,error) = 0,"external connection task")
  errors = errors + check(planagentaction(store,config,profile,connection,"resolution",responsejson("retract","","[]",'[{"evidence_id":"closure-mention","quote":"Platform"}]'),"external correction","fixture","fixture",connection_plan,error) = 0,"grounded correction before closure " || error)
  errors = errors + check(applyagentaction(store,config,profile,connection_plan,rxhash..sha256hex(connection_plan as .binary),"resolution",connection_review,error) = 0 & reviewagentaction(store,connection_review,"accept",config,profile,error) = 0,"reviewed correction before closure " || error)
  current=current+1
  types = .string[]; ids = .string[]
  errors = errors + check(lifecycleimpact(database,"closure-parent",current,types,ids,error) = 0 & ids.0 = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"positive control empty impact with no retirement task")
  unrelated = scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id<>'closure-workflow'")
  result = workflowcommand(store,"closure-workflow",0,current,"plan")
  errors = errors + check(result.exit_code() = 0,"UX-04 public workflow census preview " || result.message())
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"workflow preview makes no writes")
  if result.exit_code() <> 0 then return errors
  output = ""; human = ""
  errors = errors + check(rendercommandresult(result,"json",output,error) = 0 & rendercommandresult(result,"human",human,error) = 0 & pos("queue-retirement",human)>0,"workflow preview names retirement effect")
  result = workflowcommand(store,"closure-workflow",1,current,"plan")
  errors = errors + check(result.exit_code() = 4,"workflow census apply requires curate access")
  result = workflowcommand(store,"closure-workflow",1,current-1,"curate")
  errors = errors + check(result.exit_code() <> 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"stale workflow census cannot enqueue")
  errors = errors + check(sqliteexec(database,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES('closure-guard-review','fixture'," || _testquote(origin) || ",'pending','{}','fixture')") = 0,"pending review guard fixture")
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  output=""; errors = errors + check(result.exit_code() = 0 & rendercommandresult(result,"json",output,error) = 0 & pos("waiting-review",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"pending workflow review holds retirement")
  errors = errors + check(sqliteexec(database,"UPDATE reviews SET state='dismissed',decision_json='{}' WHERE review_id='closure-guard-review'") = 0,"release pending review fixture")
  legacy_run=scalartext(database,"SELECT run_id FROM maintenance_windows WHERE policy_fingerprint=(SELECT policy_fingerprint FROM maintenance_tasks WHERE task_id=" || _testquote(origin) || ") ORDER BY created_epoch DESC,window_id DESC LIMIT 1")
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_items(item_id,run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,expected_generation,created_at,updated_at) VALUES('closure-legacy-review'," || _testquote(legacy_run) || ",'concept-review','concept','closure-parent',1,'{}','{}','{}','review-required'," || current || ",'fixture','fixture')")=0,"legacy lifecycle review fixture")
  result=workflowcommand(store,"closure-workflow",0,current,"plan"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-review",output)>0,"workflow preview includes legacy lifecycle review gate")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_items SET state='rejected' WHERE item_id='closure-legacy-review'")=0,"release legacy review fixture")
  errors = errors + workflowholdchecks(store,origin,current)
  items=items+1
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  errors = errors + check(result.exit_code() = 0,"apply targeted workflow census")
  task_id = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")
  errors = errors + check(task_id <> "" & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(task_id)) = "pending","one public retirement task is available")
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  errors = errors + check(result.exit_code() = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 1,"workflow reconciliation is idempotent")
  rpc='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rag_workflow_reconcile_preview","arguments":{"id":"closure-workflow"}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","plan")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.result.structuredContent.exit_code')")=0 & pos(task_id,rpc_result)>0,"MCP preview discovers the same retirement task")
  rpc='{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"rag_workflow_reconcile","arguments":{"id":"closure-workflow","expect_generation":' || current || '}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","plan")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.error.code')")=-32602,"MCP plan access cannot apply reconciliation")
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","curate")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.result.structuredContent.exit_code')")=0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=1,"MCP reconciliation shares CLI idempotence")

  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id<>'closure-workflow'") = unrelated & scalarint(database,"SELECT count(*) FROM jobs") = jobs & scalarint(database,"SELECT count(*) FROM job_items") = items,"targeted census creates no unrelated tasks or workers")
  if task_id = "" then return errors+1
  errors=errors+legacyclosurecheck(store,profile,current,legacy_run,1)
  canonical = ""; review_id = ""
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",responsejson("retire","","[]","[]","closure-parent"),"external retirement","fixture","fixture",canonical,error) = 0,"publicly discovered retirement can be proposed " || error)
  errors = errors + check(applyagentaction(store,config,profile,canonical,rxhash..sha256hex(canonical as .binary),"resolution",review_id,error) = 0,"submit reviewed retirement " || error)
  held_job=scalartext(database,"SELECT job_id FROM job_items WHERE item_id='closure-held-item'")
  errors=errors+check(sqliteexec(database,"INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('closure-late-attempt','closure-held-item','historic',2,'fixture','unknown','expired','fixture','fixture'); INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(held_job) || ",'closure-held-item','closure-late-attempt','provider-intent','{}','fixture')")=0,"late workflow hold after retirement proposal")
  errors=errors+legacyclosurecheck(store,profile,current,legacy_run,0)
  retirement_preview=""; retirement_impact=""
  errors=errors+check(previewagentaction(store,review_id,config,profile,retirement_preview,retirement_impact,error)<>0,"retirement preview rechecks late workflow outcome hold")
  held_status=reviewagentaction(store,review_id,"accept",config,profile,error)
  errors=errors+check(held_status<>0 & scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="migration-parent","retirement acceptance rechecks late workflow outcome hold")
  errors=errors+check(sqliteexec(database,"INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(held_job) || ",'closure-held-item','closure-late-attempt','provider-response','{}','fixture')")=0,"settle late fixture without deleting history")
  if held_status=0 then return errors
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"complete external retirement " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'") = "retired" & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'") = "complete","retirement closes parent and workflow")
  result = workflowcommand(store,"closure-workflow",1,current+1,"curate")
  errors = errors + check(result.exit_code() = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow'") = 2,"completed workflow reconciliation is a no-op")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+1 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"external closure preserves source usage and history with one reviewed generation")
  /* Older legacy publication could leave only this workflow marker behind.
   * Recover its existing retirement; do not publish a second retirement. */
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_workflows SET state='migrating',completed_generation=NULL WHERE workflow_id='closure-workflow'")=0,"legacy completed-parent workflow marker fixture")
  result=workflowcommand(store,"closure-workflow",0,current+1,"plan");output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("complete-retired-workflow",output)>0,"public preview recognizes retained legacy retirement")
  result=workflowcommand(store,"closure-workflow",1,current+1,"curate")
  errors=errors+check(result.exit_code()=0 & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'")="complete" & scalarint(database,"SELECT completed_generation FROM maintenance_workflows WHERE workflow_id='closure-workflow'")=current+1,"public reconciliation checkpoints legacy retirement")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current+1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow'")=2 & scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"legacy workflow recovery creates no generation task or provider call")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_workflows SET state='complete',completed_generation=" || (current+1) || " WHERE workflow_id='closure-workflow'")=0,"restore isolated legacy marker fixture")
  return errors

legacyclosurecheck: procedure = .int
  arg store = .ragstorehandle, profile = .ragprofile, current = .int, legacy_run = .string, expect_success = .int
  database=store.database();errors=0;error=""
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"begin isolated legacy retirement check")
  legacy_action='{"schema":"crexx-rag.lifecycle-action/1","operation":"retire","concept_id":"closure-parent","target_concept_id":"","alias":"","concept_type":"","reason":"isolated legacy retirement check","successors":[],"dispositions":[]}'
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_items(item_id,run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,expected_generation,created_at,updated_at) VALUES('closure-direct-retire'," || _testquote(legacy_run) || ",'retire','concept','closure-parent',1,'{}','{}'," || _testquote(legacy_action) || ",'approved'," || current || ",'fixture','fixture')")=0,"legacy retirement item matches reviewed action")
  isolated_generation=0
  errors=errors+check(stagegeneration(store,current,scalartext(database,"SELECT current_config_snapshot_id FROM library_config_state WHERE singleton=1"),"legacy retirement gate fixture",isolated_generation,error)=0,"stage isolated legacy retirement generation")
  status=applylifecycletransaction(store,profile,"closure-direct-retire",legacy_action,current,isolated_generation,error)
  if expect_success=0 then errors=errors+check(status<>0,"legacy retirement publication enforces workflow holds")
  else do
    errors=errors+check(status=0,"legacy retirement positive control " || error)
    errors=errors+check(scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'")="complete" & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="retired","legacy retirement closes the workflow in the same transaction")
  end
  ignored=sqliteexec(database,"ROLLBACK")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="migration-parent","isolated legacy gate preserves generation and parent")
  return errors

workflowholdchecks: procedure = .int
  arg store = .ragstorehandle, origin = .string, generation = .int
  database=store.database(); errors=0; error=""
  window=scalartext(database,"SELECT window_id FROM maintenance_windows WHERE policy_fingerprint=(SELECT policy_fingerprint FROM maintenance_tasks WHERE task_id=" || _testquote(origin) || ") ORDER BY created_epoch DESC,window_id DESC LIMIT 1")
  job=scalartext(database,"SELECT job_id FROM maintenance_windows WHERE window_id=" || _testquote(window))
  errors=errors+check(sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('closure-held-item'," || _testquote(job) || ",'maintenance-resolution','queued',1,'closure-held-item','fixture','{}','fixture','fixture'); INSERT INTO maintenance_task_items(item_id,task_id,window_id,attempt_number) VALUES('closure-held-item'," || _testquote(origin) || "," || _testquote(window) || ",99)")=0,"workflow ownership fixture")
  result=workflowcommand(store,"closure-workflow",1,generation,"curate"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-worker",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=0,"queued workflow ownership holds retirement")
  errors=errors+check(sqliteexec(database,"UPDATE job_items SET state='dead_letter' WHERE item_id='closure-held-item'; INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('closure-held-attempt','closure-held-item','historic',1,'fixture','unknown','expired','fixture','fixture'); INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(job) || ",'closure-held-item','closure-held-attempt','provider-intent','{}','fixture')")=0,"uncertain workflow outcome fixture")
  result=workflowcommand(store,"closure-workflow",1,generation,"curate"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-provider-outcome",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=0,"uncertain provider outcome cannot be hidden by workflow retirement")
  errors=errors+check(sqliteexec(database,"INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(job) || ",'closure-held-item','closure-held-attempt','provider-response','{}','fixture'); UPDATE job_items SET state='skipped' WHERE item_id='closure-held-item'")=0,"settle fixture while retaining its attempt and events")
  return errors

workflowcommand: procedure = .ragcommandresult
  arg store = .ragstorehandle, workflow = .string, apply = .int, generation = .int, capability = .string
  config=architecturelocalconfig(); command_args=.string[]
  command_args[1]="--library=" || store.path(); command_args[2]="--config=" || config.config_id(); command_args[3]="--profile=generic-profile"; command_args[4]="--format=json"; command_args[5]="--access=" || capability
  command_args[6]="maintain"; command_args[7]="reconcile"; command_args[8]=workflow
  if apply=1 then do; command_args[9]="--apply"; command_args[10]="--expect-generation=" || generation; end
  request=.ragcommandrequest; error=""
  if parsecommand(command_args,request,error)<>0 then return commandfailure("maintain.reconcile",2,error)
  return dispatchproduct(request,operatorregistry())

connectioneffectchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  database = store.database(); errors = 0; error = ""; config = architecturelocalconfig(); profile = genericprofile(); policy = .jsondocument(policy_json)
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('effect-parent','Platform','concept','migration-parent'," || current || "),('effect-target','Platform successor','concept','active'," || current || ")") = 0,"effect concepts")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('effect-mention','effect-parent','chunk-lifecycle',0,8," || current || "),('effect-target-mention','effect-target','chunk-lifecycle',0,8," || current || ")") = 0,"effect mentions")
  errors = errors + check(sqliteexec(database,"INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('effect-claim','effect-parent','related-to','effect-target','outbound','{}','fixture'," || current || "),('effect-other','effect-target','related-to','effect-parent','outbound','{}','fixture'," || current || ")") = 0,"effect claims")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) VALUES('effect-support-a','effect-claim','chunk-lifecycle',0,13,'support','assertion','direct','','effect-a','fixture'," || current || "),('effect-support-b','effect-claim','chunk-lifecycle',0,13,'support','assertion','direct','','effect-b','fixture-b'," || current || ")") = 0,"effect supports")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('effect-conflict','effect-claim','effect-other','pending'," || current || ")") = 0,"effect conflict")
  origin = ""
  errors = errors + check(enqueuebacklogtask(database,"effect-origin","concept","effect-parent","","",1,policy,origin,error) = 0,"effect origin " || error)
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_workflows(workflow_id,origin_task_id,kind,parent_concept_id,successors_json,state,created_generation,created_epoch,updated_epoch) VALUES('effect-workflow','" || origin || "','merge','effect-parent','[{" || '"concept_id":"effect-target"' || "}]','migrating'," || current || ",unixepoch(),unixepoch())") = 0,"effect workflow")
  task_id = ""; canonical = ""; review_id = ""
  errors = errors + connectionvariantchecks(store,current)
  errors = errors + check(enqueuebacklogtask(database,"connection","support","effect-support-a","effect-workflow",origin,1,policy,task_id,error) = 0,"effect support task " || error)
  evidence = '[{"evidence_id":"effect-support-a","quote":"Platform"}]'
  response = responsejson("retract","","[]",evidence)
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"positive control grounded support plan " || error)
  if canonical = "" then return errors + 1
  errors = errors + effectcheck(database,canonical,"support","effect-support-a","retract")
  errors = errors + effectcheck(database,canonical,"claim","effect-claim","retain")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(canonical) || ",'$.impact') WHERE json_extract(value,'$.object_type')='conflict'") = 0,"other support keeps conflicts active")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 2,"preview makes no support writes")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",responsejson("move","effect-target","[]",evidence),"effect test","fixture","fixture",canonical,error) <> 0,"self-edge migration rejected during planning")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"recreate support plan")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"submit support plan " || error)
  errors = errors + revieweffectchecks(store,review_id,canonical)
  /* Seed a legacy action as immutable history; never disable its write guards. */
  original_action = scalartext(database,"SELECT json_extract(proposal_json,'$.action_id') FROM reviews WHERE review_id=" || _testquote(review_id))
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_agent_actions(action_id,task_id,action_kind,actor,model,canonical_plan,created_epoch) SELECT 'legacy-effect-action',task_id,action_kind,actor,model,json_set(canonical_plan,'$.impact',json('[]')),created_epoch FROM maintenance_agent_actions WHERE action_id=" || _testquote(original_action) || "; UPDATE reviews SET proposal_json=json_set(proposal_json,'$.action_id','legacy-effect-action') WHERE review_id=" || _testquote(review_id)) = 0,"legacy preview fixture")
  errors = errors + revieweffectchecks(store,review_id,canonical)
  errors = errors + check(scalartext(database,"SELECT json_extract(canonical_plan,'$.impact') FROM maintenance_agent_actions WHERE action_id='legacy-effect-action'") = "[]","preview does not rewrite retained action")
  errors = errors + check(sqliteexec(database,"UPDATE reviews SET proposal_json=json_set(proposal_json,'$.action_id'," || _testquote(original_action) || ") WHERE review_id=" || _testquote(review_id)) = 0,"restore original reviewed action")
  errors = errors + stalepreviewchecks(store,review_id)
  errors = errors + effectboundchecks(store)
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept support retraction " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE support_id='effect-support-a' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 1,"support retraction matches preview and retains supported claim")
  errors = errors + check(enqueuebacklogtask(database,"connection","claim","effect-claim","effect-workflow",origin,1,policy,task_id,error) = 0,"effect claim task " || error)
  evidence = '[{"evidence_id":"effect-support-b","quote":"Platform"}]'
  response = responsejson("retract","","[]",evidence,"effect-claim")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"positive control grounded claim plan " || error)
  errors = errors + effectcheck(database,canonical,"claim","effect-claim","retract")
  errors = errors + effectcheck(database,canonical,"support","effect-support-b","retract")
  errors = errors + effectcheck(database,canonical,"conflict","effect-conflict","resolve")
  errors = errors + check(scalarint(database,"SELECT json_array_length(" || _testquote(canonical) || ",'$.impact')") = 3,"claim preview includes exactly active affected rows")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"submit claim retraction " || error)
  errors = errors + revieweffectchecks(store,review_id,canonical)
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept claim retraction " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='effect-claim' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claim_support WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 0 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE conflict_id='effect-conflict' AND visible_to_generation IS NOT NULL") = 1,"claim support conflict publication matches effect preview")
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0 & reviewagentaction(store,review_id,"accept",config,profile,error) <> 0,"exact replay retains history without repeated publication")
  /* Two accepted effects plus the explicit unrelated-publication control. */
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+3 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"effect checks preserve sources usage history and foreign keys")
  return errors

connectionvariantchecks: procedure = .int
  arg store = .ragstorehandle, current = .int
  database = store.database(); errors = 0; error = ""; impact = ""; result = .jsondocument(responsejson("retract"))
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,4,impact,error) = 0,"effect bound positive control")
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,3,impact,error) <> 0,"effect count enforces configured bound")
  errors = errors + check(sqliteexec(database,"BEGIN IMMEDIATE") = 0,"begin isolated move projection fixture")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('effect-successor','Platform','concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('effect-successor-mention','effect-successor','chunk-lifecycle',0,8," || current || "); INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('effect-resolved-conflict','effect-claim','effect-other','resolved-retain-both'," || current || ")") = 0,"move projection fixture")
  result = .jsondocument(responsejson("move","effect-successor"))
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,10,impact,error) = 0,"supported move has an effect preview " || error)
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"conflict","effect-conflict","carry")
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"conflict","effect-resolved-conflict","resolve")
  preview_publication = 0
  errors = errors + check(stagegeneration(store,current,scalartext(database,"SELECT current_config_snapshot_id FROM library_config_state WHERE singleton=1"),"isolated effect fixture",preview_publication,error) = 0,"stage isolated move generation")
  errors = errors + check(applyconnectiontransaction(database,"effect-parent","claim","effect-claim","move-child","effect-successor",current,preview_publication,error) = 0,"move publication positive control " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id='effect-successor' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 0 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE claim_id IN(SELECT claim_id FROM claims WHERE source_concept_id='effect-successor') AND review_state='pending' AND visible_to_generation IS NULL") = 1,"move carries pending conflicts and closes former rows")
  errors = errors + check(sqliteexec(database,"ROLLBACK") = 0,"rollback isolated move projection fixture")
  result = .jsondocument(responsejson("retain"))
  errors = errors + check(connectioneffects(database,"effect-parent","note","effect-note",result,current,10,impact,error) = 0,"note settlement projection")
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"note","effect-note","resolve")
  return errors

stalepreviewchecks: procedure = .int
  arg store = .ragstorehandle, review_id = .string
  database = store.database(); errors = 0; config = architecturelocalconfig(); access = .string[]; access[1] = "plan"; positionals = .string[]
  preview_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"UPDATE library_meta SET published_generation=published_generation-1 WHERE singleton=1") = 0,"stale review preview fixture")
  command_options = .ragcommandoption[]; command_options[1] = .ragcommandoption("id",review_id,0); command_options[2] = .ragcommandoption("decision","accept",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code() = 3,"stale review cannot advertise acceptable effects")
  command_options[2] = .ragcommandoption("decision","reject",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code() = 0,"stale review can still be rejected")
  errors = errors + check(sqliteexec(database,"UPDATE library_meta SET published_generation=" || preview_generation || " WHERE singleton=1") = 0,"restore review snapshot")
  publication_error = ""; unrelated_generation = 0
  publication_snapshot = scalartext(database,"SELECT config_snapshot_id FROM published_generations WHERE generation=" || preview_generation)
  errors = errors + check(begingeneration(store,preview_generation,publication_snapshot,"unrelated publication control",unrelated_generation,publication_error)=0 & commitgeneration(store,unrelated_generation,publication_error)=0 & publishmanifest(store,publication_error)=0,"unrelated generation fixture " || publication_error)
  command_options[2] = .ragcommandoption("decision","accept",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code()=0,"unrelated publication preserves validated review effects " || result.message())
  return errors

effectboundchecks: procedure = .int
  arg store = .ragstorehandle
  errors = 0; error = ""; impact = "["
  do i = 1 to 1000
    if i > 1 then impact = impact || ","
    impact = impact || '{"object_type":"support","object_id":"effect-' || i || '","effect":"retract","target_concept_id":""}'
  end
  impact = impact || "]"; fields = .ragresultfield[]; fields[1] = .ragresultfield("applied","boolean","false")
  records = .ragresultrecord[]; records[1] = .ragresultrecord("agent-action",fields)
  records = commandeffectrecords(records,impact); result = .ragcommandresult("maintain.resolve-plan","ok",0,"effect bound",records); output = ""
  errors = errors + check(records.0 = 100 & rendercommandresult(result,"json",output,error) = 0,"bounded preview remains renderable " || error)
  errors = errors + check(scalartext(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_json')") = impact & scalarint(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_truncated')") = 1,"full effects survive explicit human display truncation")
  return errors

revieweffectchecks: procedure = .int
  arg store = .ragstorehandle, review_id = .string, expected = .string
  errors = 0; error = ""; config = architecturelocalconfig(); access = .string[]; access[1] = "plan"
  command_options = .ragcommandoption[]; command_options[1] = .ragcommandoption("id",review_id,0); command_options[2] = .ragcommandoption("decision","accept",0)
  positionals = .string[]
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry()); output = ""; human = ""
  errors = errors + check(result.exit_code() = 0,"review effect preview positive control")
  errors = errors + check(rendercommandresult(result,"json",output,error) = 0 & rendercommandresult(result,"human",human,error) = 0,"render review effect preview " || error)
  wanted = scalartext(store.database(),"SELECT json_extract(" || _testquote(expected) || ",'$.impact')")
  actual = scalartext(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_json')")
  errors = errors + check(wanted <> "[]" & actual = wanted,"review shows complete planned effects")
  errors = errors + check(pos("effect-support",human)>0 & pos("retract",human)>0,"human preview shows affected support and action")
  errors = errors + check(scalartext(store.database(),"SELECT state FROM reviews WHERE review_id=" || _testquote(review_id)) = "pending","review preview makes no writes")
  return errors

effectcheck: procedure = .int
  arg database = .binary, canonical = .string, kind = .string, id = .string, effect = .string
  return check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(canonical) || ",'$.impact') WHERE json_extract(value,'$.object_type')=" || _testquote(kind) || " AND json_extract(value,'$.object_id')=" || _testquote(id) || " AND json_extract(value,'$.effect')=" || _testquote(effect)) = 1,"UX-03 preview " || kind || " " || id || " " || effect)

_testquote: procedure = .string
  arg value = .string
  return "'" || changestr("'",value,"''") || "'"

agentchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  errors = 0; error = ""; database = store.database(); config = architecturelocalconfig(); profile = genericprofile(); policy = .jsondocument(policy_json)
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-external','Platform','concept','active'," || current || ")") = 0,"external fixture concept")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-external','concept-external','chunk-lifecycle',0,8," || current || ")") = 0,"external fixture mention")
  task_id = ""
  errors = errors + check(enqueuebacklogtask(database,"external-review","concept","concept-external","","",999999,policy,task_id,error) = 0,"external task " || error)
  canonical = ""; review_id = ""
  errors = errors + check(planagentaction(store,config,profile,task_id,"escalation","","Distinct meanings require connection review","fixture-agent","self-reported-fixture",canonical,error) = 0,"plan escalation " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 0,"planning writes no receipt")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"escalation",review_id,error) = 0 & applyagentaction(store,config,profile,canonical,digest,"escalation",review_id,error) = 0,"exact escalation and replay " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 1 & scalartext(database,"SELECT required_capability FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "advanced-reasoning","one durable escalation independent of priority")
  evidence = '[{"evidence_id":"mention-external","quote":"Platform"}]'
  successors = '[{"canonical_label":"External Alpha","concept_type":"concept"},{"canonical_label":"External Beta","concept_type":"concept"}]'
  response = responsejson("split","",successors,evidence,"concept-external")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",changestr('"quote":"Platform"',response,'"quote":"Invented"'),"review","fixture-agent","fixture",canonical,error) \= 0,"external forged quote rejected")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"review","fixture-agent","fixture",canonical,error) = 0,"grounded external split plan " || error)
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,copies("0",64),"resolution",review_id,error) \= 0,"tampered external digest rejected")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET updated_epoch=updated_epoch+1 WHERE task_id='" || task_id || "'") = 0,"advance task revision")
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) \= 0 & scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 1,"stale external plan rejected without receipt")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"review","fixture-agent","fixture",canonical,error) = 0,"fresh external split plan " || error)
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"external proposal submitted " || error)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 2,"duplicate proposal is exact no-op")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current,"submission does not change corpus")
  job_id = scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  errors = errors + check(scalartext(database,"SELECT last_error FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "external resolution awaiting review","submission replaces manual marker")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET last_error='manual maintenance mode',required_capability='standard' WHERE task_id='" || task_id || "'") = 0,"simulate legacy manual marker during pending review")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"resume ordinary workers with external review pending " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "review" & scalarint(database,"SELECT count(*) FROM maintenance_task_items WHERE task_id='" || task_id || "'") = 0,"pending external review retains exclusive task ownership")
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept grounded external split " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-external'") = "migration-parent" & scalarint(database,"SELECT count(*) FROM maintenance_workflows WHERE origin_task_id='" || task_id || "' AND state='migrating'") = 1,"external split reuses resumable lifecycle")
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) \= 0,"repeat acceptance cannot publish twice")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+1 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources,"one generation with no fabricated provider usage or source rewrite")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"external resolution foreign keys")
  worker_task = ""
  errors = errors + check(enqueuebacklogtask(database,"worker-escalation-test","concept","concept-peer","","",999999,policy,worker_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"dispatch worker assertion test " || error)
  errors = errors + check(runresolution(store,job_id,worker_task,responsejson("escalate"),error) = 0,"worker can assert advanced reasoning " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || worker_task || "' AND state='unresolved' AND required_capability='advanced-reasoning' AND escalation_origin='worker'") = 1,"worker assertion keeps task unresolved and flags resolver")
  do failure_class = 1 to 3
    failure_task = ""; status = -123; if failure_class = 2 then status = -101
    provider = .failureclassprovider(status,failure_class = 1); disposition = ""
    claim_policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    errors = errors + check(enqueuebacklogtask(database,"failure-class-" || failure_class,"concept","concept-peer","","",999999,policy,failure_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"dispatch classified failure " || error)
    errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000010 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || failure_task || "') AND state='queued'") = 0,"select classified failure task")
    do attempt = 1 to 2
      errors = errors + check(runworkeronce(store,job_id,"failure-class-fixture",60,3,claim_policy,provider,disposition,error,profile) = 0,"settle classified failure " || error)
      errors = errors + check(sqliteexec(database,"UPDATE job_items SET retry_at=0 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || failure_task || "') AND state='queued'") = 0,"make fixture retry ready without sleeping")
    end
    if failure_class = 1 then errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || failure_task || "' AND semantic_failures=2 AND required_capability='advanced-reasoning' AND state='unresolved'") = 1,"repeated content failures escalate and stop ordinary work")
    else errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || failure_task || "' AND semantic_failures=0 AND required_capability='standard'") = 1,"transport and storage failure status alone is not an intelligence signal")
  end
  return errors

refreshchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  errors=0; error=""; database=store.database(); policy=.jsondocument(policy_json)
  config=architecturelocalconfig(); profile=genericprofile()
  current=scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls=scalarint(database,"SELECT count(*) FROM provider_runs"); sources=scalarint(database,"SELECT count(*) FROM source_revisions")
  usage=scalarint(database,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")
  attempts=scalarint(database,"SELECT count(*) FROM attempts")
  errors=errors+check(sqliteexec(database,"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<105) INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) SELECT 'refresh-concept-'||i,'Platform','concept','active'," || current || " FROM n")=0,"seed expanded catalogue")
  errors=errors+check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'refresh-mention-'||concept_id,concept_id,'chunk-lifecycle',0,8," || current || " FROM concepts WHERE concept_id LIKE 'refresh-concept-%'")=0,"seed expanded catalogue evidence")
  task_id=""; canonical=""; successor=""; replay=""
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,task_id,error)=0,"bounded task discovery " || error)
  old_packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id='" || task_id || "'")
  errors=errors+check(pos('"limit_exceeded":true',old_packet)>0,"oversized catalogue records explicit sentinel")
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(task_id))="pending","catalogue overflow remains eligible for native bounded acquisition")
  grounds=""; refusal=""
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("no-change"),grounds,refusal,policy_json)<>0 & pos("incomplete",refusal)>0,"unseen catalogue cannot justify whole-subject no-change")
  inventory_sql=backlogindexquery(database,task_id,"catalogue","current")
  count=scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")
  errors=errors+check(count>100,"inventory exposes catalogue beyond worker ceiling")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(old_packet) || ",'$.omitted_catalogue')")=count & pos('"evidence_complete":false',old_packet)>0 & pos('"inventory_tool":"maintain.evidence-index"',old_packet)>0,"packaging hold reports exact omitted candidate count and continuation")
  inventory_sql=backlogindexquery(database,task_id,"passages","current")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")=1 & pos('crexx-rag:',scalartext(database,"SELECT detail FROM (" || inventory_sql || ")"))>0,"inventory exposes citation despite empty packet")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(old_packet) || ",'$.omitted_passages')")=1,"packaging hold reports exact omitted passage count")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET question='Keep this precise follow-up question' WHERE task_id='" || task_id || "'")=0,"preserve custom question fixture")
  rows=scalarint(database,"SELECT count(*) FROM maintenance_tasks")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"Review the complete context","fixture-agent","fixture",canonical,error)=0,"plan complete refresh " || error)
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows,"refresh planning writes nothing")
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,canonical,copies("0",64),successor,error)\=0,"refresh rejects altered digest")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET updated_epoch=updated_epoch+1 WHERE task_id='" || task_id || "'")=0 & applybacklogrefresh(store,config,profile,canonical,digest,successor,error)\=0,"refresh rejects stale task binding")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1024,1000,"small bound","fixture-agent","fixture",canonical,error)\=0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows,"incomplete refresh never persists")
  errors=errors+check(sqliteexec(database,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES('refresh-blocked-review','maintenance-external','" || task_id || "','pending','{}','fixture')")=0,"pending review fixture")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"review","fixture-agent","fixture",canonical,error)\=0 & pos('pending review',error)>0,"pending review blocks refresh")
  errors=errors+check(sqliteexec(database,"UPDATE reviews SET state='rejected' WHERE review_id='refresh-blocked-review'; UPDATE maintenance_tasks SET state='dispatched' WHERE task_id='" || task_id || "'")=0,"worker ownership fixture")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"review","fixture-agent","fixture",canonical,error)\=0,"running task blocks refresh")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='unresolved' WHERE task_id='" || task_id || "'")=0,"release fixture ownership")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"Review the complete context","fixture-agent","fixture",canonical,error)=0,"re-plan complete refresh " || error)
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,canonical,digest,successor,error)=0 & applybacklogrefresh(store,config,profile,canonical,digest,replay,error)=0 & successor=replay,"exact refresh and replay " || error)
  altered=changestr('"complete":true',canonical,'"complete":false'); altered_digest=rxhash..sha256hex(altered as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,altered,altered_digest,replay,error)\=0,"replay rejects altered complete plan even with matching digest")
  altered=changestr('"passages":1',canonical,'"passages":2'); altered_digest=rxhash..sha256hex(altered as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,altered,altered_digest,replay,error)\=0,"replay rejects altered counts")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows+1 & scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id='" || task_id || "'")=old_packet,"one successor and immutable prior evidence")
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'")="superseded" & scalartext(database,"SELECT question||':'||priority||':'||parent_task_id||':'||required_capability FROM maintenance_tasks WHERE task_id='" || successor || "'")="Keep this precise follow-up question:12345:" || task_id || ":advanced-reasoning","preserve question priority lineage and external ownership")
  inventory_sql=backlogindexquery(database,successor,"catalogue","stored")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")=count,"stored inventory retains complete catalogue")
  note_task=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE subject_type='note' ORDER BY created_epoch LIMIT 1")
  inventory_sql=backlogindexquery(database,note_task,"context","stored")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ") WHERE id='$.subject.text'")=1,"stored note diagnostic remains inspectable")
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,replay,error)=0 & replay=successor,"census retains refreshed successor")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current,"refresh does not change corpus generation")
  response=responsejson("retain","","[]",'[{"evidence_id":"refresh-mention-refresh-concept-1","quote":"Platform"}]')
  errors=errors+check(planagentaction(store,config,profile,successor,"resolution",response,"review","fixture-agent","fixture",canonical,error)=0,"resolve refreshed packet using stored envelope " || error)
  digest=rxhash..sha256hex(canonical as .binary); review_id=""
  errors=errors+check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error)=0 & reviewagentaction(store,review_id,"accept",config,profile,error)=0,"review accepts refreshed evidence " || error)
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,replay,error)=0 & replay=successor,"resolved refresh is not replaced by an oversized sentinel")
  /* A byte-limited packet also has a usable inventory and changes identity when
   * evidence beyond the original cutoff changes. No source bytes are edited. */
  errors=errors+check(sqliteexec(database,"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<500) INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'refresh-extra-'||i,'refresh-concept-2','chunk-lifecycle',0,8," || current || " FROM n")=0,"seed oversized passage collection")
  byte_task=""
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-2","","",12345,policy,byte_task,error)=0,"byte limited task")
  byte_packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(byte_task))
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(byte_packet) || ",'$.omitted_passages')")=501 & pos('"evidence_complete":false',byte_packet)>0,"byte-limit hold counts every omitted source passage")
  errors=errors+check(planbacklogrefresh(store,config,profile,byte_task,1048576,1000,"full passages","fixture-agent","fixture",canonical,error)=0 & pos('"passages":501',canonical)>0,"complete byte refresh plan " || error)
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(sqliteexec(database,"UPDATE mentions SET span_end=7 WHERE mention_id='refresh-extra-99'")=0 & applybacklogrefresh(store,config,profile,canonical,digest,replay,error)\=0,"changed evidence invalidates refresh apply")
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-2","","",12345,policy,replay,error)=0 & replay\=byte_task,"sentinel fingerprints evidence beyond cutoff")
  held=replay;held_packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(held))
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='review',escalation_origin='request-capability',escalation_reason='serialized request exceeds selected bound' WHERE task_id=" || _testquote(held))=0,"seed retained request capability hold")
  scoped="";scoped_successor=""
  errors=errors+check(planbacklogrefresh(store,config,profile,held,8192,100,"smaller reviewed envelope","fixture-agent","fixture",scoped,error)=0 & pos('"complete":false',scoped)>0,"technical hold plans an explicitly incomplete scoped successor " || error)
  if scoped<>"" then errors=errors+check(applybacklogrefresh(store,config,profile,scoped,rxhash..sha256hex(scoped as .binary),scoped_successor,error)=0,"apply scoped successor with exact plan " || error)
  errors=errors+check(scoped_successor<>"" & scalartext(database,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(scoped_successor))=held & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(held))="superseded" & scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(held))=held_packet & scalarint(database,"SELECT json_extract(evidence_json,'$.evidence_complete') FROM maintenance_tasks WHERE task_id=" || _testquote(scoped_successor))=0,"scoped refresh retains immutable predecessor and explicit incomplete coverage")
  if scoped_successor<>"" then do
    rows=scalarint(database,"SELECT count(*) FROM maintenance_tasks")
    errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='review',escalation_origin='request-capability' WHERE task_id=" || _testquote(scoped_successor))=0,"seed unchanged repeat hold")
    errors=errors+check(planbacklogrefresh(store,config,profile,scoped_successor,8192,100,"repeat unchanged envelope","fixture-agent","fixture",canonical,error)<>0 & pos("changed reviewed evidence envelope",error)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows,"unchanged scoped envelope cannot spawn another task")
    errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='unresolved',escalation_origin='evidence-refresh' WHERE task_id=" || _testquote(scoped_successor))=0,"restore scoped fixture state")
  end
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current & scalarint(database,"SELECT count(*) FROM provider_runs")=calls & scalarint(database,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")=usage & scalarint(database,"SELECT count(*) FROM attempts")=attempts & scalarint(database,"SELECT count(*) FROM source_revisions")=sources,"accepted retention changes no generation, attempts, usage, source or provider receipts")
  return errors

largeevidencechecks: procedure = .int
  arg store=.ragstorehandle,base=.string
  db=store.database();errors=0;error="";task="";job="";grounds="";refusal=""
  raw=changestr('"maximum_attempts":3',base,'"maximum_attempts":9')
  raw=changestr('"batch_items":100',raw,'"batch_items":1')
  raw=left(raw,length(raw)-1) || ',"search_reads":7,"advanced_attempts":9}'
  policy=.jsondocument(raw);current=scalarint(db,"SELECT published_generation FROM library_meta")
  source_id="source-sha256:" || copies("e",64);revision_id="revision-sha256:" || copies("f",64)
  sql="INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('large-artifact','large-raw','text/plain','utf-8',NULL,'fixture://large','fixture');"
  sql=sql || "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('large-text','large-digest','Platform mentions Azure.','fixture','utf8-v1','fixture');"
  sql=sql || "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES(" || _testquote(source_id) || ",'fixture','large'," || _testquote(revision_id) || ",'active','fixture://large','Late decisive source'," || current || ");"
  sql=sql || "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES(" || _testquote(revision_id) || "," || _testquote(source_id) || ",'large-envelope','large-artifact','large-text','large-meta','fixture'," || current || ");"
  sql=sql || "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('large-content','large-content-digest','Platform mentions Azure.','large-input');"
  sql=sql || "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('large-chunk'," || _testquote(revision_id) || ",1,0,24,'large-content','large-continuity','fixture','direct'," || current || ");"
  sql=sql || "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('zz-target','Azure','concept','active'," || current || ");"
  sql=sql || "INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('zz-late-subject','concept-parent','large-chunk',0,8," || current || "),('zz-late-target','zz-target','large-chunk',18,23," || current || ");"
  sql=sql || "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<105) INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) SELECT 'concept:'||printf('%064x',i),'Platform','concept','active'," || current || " FROM n;"
  sql=sql || "INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'large-mention-'||concept_id,concept_id,'chunk-lifecycle',0,8," || current || " FROM concepts WHERE concept_id LIKE 'concept:%';"
  sql=sql || "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<12) INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'm-subject-'||printf('%03d',i),'concept-parent','chunk-lifecycle',0,8," || current || " FROM n"
  errors=errors+check(sqliteexec(db,sql)=0,"seed late cited evidence and heavy source catalogue")
  errors=errors+check(sqliteexec(db,"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<500) INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'zzzz-byte-mention-'||i,'concept-parent','chunk-lifecycle',0,8," || current || " FROM n")=0,"seed byte-heavy source passage inventory")
  errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept","concept-parent","","",999999,policy,task,error)=0 & task<>"","enqueue native large-evidence question " || error)
  packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(task))
  errors=errors+check(scalartext(db,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(task))="pending" & pos('"evidence_complete":false',packet)>0 & scalarint(db,"SELECT json_extract(evidence_json,'$.omitted_catalogue') FROM maintenance_tasks WHERE task_id=" || _testquote(task))>100 & scalarint(db,"SELECT json_extract(evidence_json,'$.omitted_passages') FROM maintenance_tasks WHERE task_id=" || _testquote(task))>500,"byte-heavy passages and oversized catalogue remain runnable with explicit omitted inventory")
  errors=errors+check(validatebacklogresponse(db,task,responsejson("no-change"),grounds,refusal,raw)<>0 & pos("incomplete",refusal)>0,"unseen candidates cannot authorize final no-change")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"dispatch native bounded acquisition " || error)
  cursor="";citation="";page_count=0
  do until citation<>"" | page_count>=4
    errors=errors+check(runresolution(store,job,task,responsejson("inspect","","[]","[]",cursor,"passages"),error)=0,"inspect bounded passage page " || error)
    page_count=page_count+1
    citation=scalartext(db,"SELECT json_extract(value,'$.context_citation') FROM maintenance_decisions d,json_each(d.grounding_json,'$[0].items') WHERE d.task_id=" || _testquote(task) || " AND d.disposition='inspect:pending' AND json_extract(value,'$.evidence_id')='zz-late-subject' LIMIT 1")
    cursor=scalartext(db,"SELECT json_extract(grounding_json,'$[0].next_cursor') FROM maintenance_decisions WHERE task_id=" || _testquote(task) || " AND disposition='inspect:pending' AND json_extract(response_json,'$.question')='passages' ORDER BY rowid DESC LIMIT 1")
    if cursor="" then leave
  end
  errors=errors+check(page_count>1 & citation<>"","late passage appears beyond the first bounded inventory page")
  cursor="";catalogue_pages=0;target_seen=0
  do until target_seen=1 | catalogue_pages>=4
    errors=errors+check(runresolution(store,job,task,responsejson("inspect","","[]","[]",cursor,"catalogue"),error)=0,"inspect bounded catalogue page " || error)
    catalogue_pages=catalogue_pages+1
    target_seen=scalarint(db,"SELECT count(*) FROM maintenance_decisions d,json_each(d.grounding_json,'$[0].items') WHERE d.task_id=" || _testquote(task) || " AND d.disposition='inspect:pending' AND json_extract(value,'$.concept_id')='zz-target'")
    cursor=scalartext(db,"SELECT json_extract(grounding_json,'$[0].next_cursor') FROM maintenance_decisions WHERE task_id=" || _testquote(task) || " AND disposition='inspect:pending' AND json_extract(response_json,'$.question')='catalogue' ORDER BY rowid DESC LIMIT 1")
    if cursor="" then leave
  end
  errors=errors+check(catalogue_pages>1 & target_seen=1,"decisive target appears beyond first catalogue page")
  inventory_sql=backlogindexquery(db,task,"catalogue","current")
  inventory_count=scalarint(db,"SELECT count(*) FROM (" || inventory_sql || ")")
  emitted=scalarint(db,"SELECT count(*) FROM maintenance_decisions d,json_each(d.grounding_json,'$[0].items') WHERE d.task_id=" || _testquote(task) || " AND d.disposition='inspect:pending' AND json_extract(d.response_json,'$.question')='catalogue'")
  unique_rows=scalarint(db,"SELECT count(DISTINCT json_extract(value,'$.concept_id')) FROM maintenance_decisions d,json_each(d.grounding_json,'$[0].items') WHERE d.task_id=" || _testquote(task) || " AND d.disposition='inspect:pending' AND json_extract(d.response_json,'$.question')='catalogue'")
  errors=errors+check(emitted=inventory_count & unique_rows=inventory_count & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(task) || " AND disposition='inspect:pending' AND json_extract(response_json,'$.question')='catalogue' AND length(CAST(grounding_json AS BLOB))>8192")=0,"catalogue pages cover each current record once within the byte bound")
  errors=errors+check(runresolution(store,job,task,responsejson("inspect","","[]","[]","zz-target","catalogue-target"),error)=0,"bind inspected target to durable packet " || error)
  errors=errors+check(scalarint(db,"SELECT json_array_length(evidence_json,'$.catalogue') FROM maintenance_tasks WHERE task_id=" || _testquote(task))=1,"targeted catalogue preserves only selected candidate and incomplete scope")
  errors=errors+check(runresolution(store,job,task,responsejson("read","","[]","[]",citation),error)=0,"read exact late source citation " || error)
  evidence_id="resolver:" || rxhash..sha256hex(citation as .binary)
  response=withdispositions(responsejson("propose-relationship","zz-target","[]",'[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform mentions Azure."}]',"concept-parent"),"[]")
  response=left(response,length(response)-1) || ',"relationship_type":"mentions"}'
  errors=errors+check(runresolution(store,job,task,response,error)=0,"native worker reaches grounded relationship review " || error)
  errors=errors+check(scalarint(db,"SELECT count(*) FROM reviews WHERE subject_id=" || _testquote(task) || " AND state='pending'")=1 & scalarint(db,"SELECT count(*) FROM claims WHERE source_concept_id='concept-parent' AND target_concept_id='zz-target'")=0,"substantive proposal retains mandatory semantic review without graph write")
  errors=errors+check(scalarint(db,"SELECT count(*) FROM provider_runs WHERE provider_run_id IN(SELECT provider_run_id FROM maintenance_decisions WHERE task_id=" || _testquote(task) || ")")=page_count+catalogue_pages+3,"each acquisition and proposal has one retained provider receipt")
  errors=errors+check(scalarint(db,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id=" || _testquote(job))=0,"large-evidence worker releases all aggregate reservations")
  errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('large-unknown','Unlocated referent','concept','active'," || current || "); INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('large-unknown',1,'Unlocated referent','concept','active'," || current || ",'fixture','fixture')")=0,"seed a genuinely unsupported question")
  unknown="";before_calls=scalarint(db,"SELECT count(*) FROM provider_runs");before_usage=scalarint(db,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")
  errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept","large-unknown","","",999999,policy,unknown,error)=0 & unknown<>"","enqueue source-absent question " || error)
  unknown_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(unknown))
  inventory_sql=backlogindexquery(db,unknown,"passages","current")
  errors=errors+check(scalarint(db,"SELECT count(*) FROM (" || inventory_sql || ")")=0 & scalarint(db,"SELECT json_array_length(" || _testquote(unknown_packet) || ",'$.passages')")=0 & pos('"evidence_complete":false',unknown_packet)=0,"genuine absence is distinguished from an uninspected large packet")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"dispatch source-absent question " || error)
  response=currentresponse(responsejson("insufficient-evidence","","[]","[]","","A new source passage identifying this referent and any relationship"),"")
  errors=errors+check(runresolution(store,job,unknown,response,error)=0,"native worker records genuine evidence limitation " || error)
  errors=errors+check(scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(unknown))="unresolved:evidence-wait" & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(unknown) || " AND disposition='insufficient-evidence:unresolved'")=1 & scalarint(db,"SELECT count(*) FROM claims WHERE source_concept_id='large-unknown' OR target_concept_id='large-unknown'")=0,"evidence wait is explicit and creates no guessed relationship")
  errors=errors+check(scalarint(db,"SELECT count(*) FROM provider_runs")=before_calls+1 & scalarint(db,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")=before_usage+20 & scalarint(db,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id=" || _testquote(job))=0,"genuine evidence limitation retains one call and releases reservations")
  wait_policy=changestr('"search_reads":7',raw,'"search_reads":1')
  do route=1 to 4
    isolate="wait-isolate-" || route;wait_task="";wait_job=job
    route_policy=wait_policy
    if route=2 | route=3 then route_policy=scalartext(db,"SELECT json_set(" || _testquote(wait_policy) || ",'$.advanced_route',json(" || _testquote('{"role":"advanced-resolver","provider_id":"fixture","model":"fixture","charging_basis":"local-compute","input_tokens":100000,"output_tokens":10000,"cost_microunits":0,"time_ms":1000}') || "))")
    errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES(" || _testquote(isolate) || ",'Platform','concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'wait-mention-" || route || "-'||mention_id," || _testquote(isolate) || ",revision_chunk_id,span_start,span_end," || current || " FROM mentions WHERE concept_id='concept-parent' AND visible_to_generation IS NULL")=0,"seed partial isolate source scope")
    errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999, .jsondocument(route_policy),wait_task,error)=0 & wait_task<>"","enqueue partially inspectable isolate " || error)
    if route=2 | route=3 then errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning' WHERE task_id=" || _testquote(wait_task))=0,"select advanced partial-acquisition route")
    errors=errors+check(nextwindow(store,route_policy,wait_job,error)=0,"dispatch partial isolate " || error)
    errors=errors+check(runresolution(store,wait_job,wait_task,responsejson("read","","[]","[]",citation),error)=0,"bind one partial isolate passage " || error)
    errors=errors+check(scalarint(db,"SELECT json_extract(evidence_json,'$.omitted_catalogue')+json_extract(evidence_json,'$.omitted_passages') FROM maintenance_tasks WHERE task_id=" || _testquote(wait_task))>0,"partial isolate retains uninspected debt")
    wait_response=currentresponse(responsejson("acquisition-wait","","[]","[]","","Inspect remaining source passages and catalogue candidates"),"One bound passage was inspected; this assessment covers that passage only")
    errors=errors+check(runresolution(store,wait_job,wait_task,wait_response,error)=0,"retain scoped acquisition wait " || error)
    errors=errors+check(scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(wait_task))="unresolved:evidence-limit" & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(wait_task) || " AND disposition='acquisition-wait:unresolved'")=1,"partial route holds without a whole-subject conclusion")
    if route=1 then do
      external_plan="";external_error=""
      external_status=planagentaction(store,architecturelocalconfig(),genericprofile(),wait_task,"resolution",wait_response,"fixture scoped wait","fixture-agent","",external_plan,external_error)
      errors=errors+check(external_status<>0 & pos("worker acquisition waits",external_error)>0,"external proposal cannot misclassify worker acquisition wait " || external_error)
    end
    prior_runs=scalarint(db,"SELECT count(*) FROM provider_runs")
    errors=errors+check(nextwindow(store,route_policy,wait_job,error)=0 & scalarint(db,"SELECT count(*) FROM job_items i JOIN maintenance_task_items m ON m.item_id=i.item_id WHERE m.task_id=" || _testquote(wait_task) || " AND i.state IN('queued','running')")=0 & scalarint(db,"SELECT count(*) FROM provider_runs")=prior_runs,"rediscovery does not repeat partial-acquisition dispatch " || error)
    if route=1 then errors=errors+scopedholdchecks(store,wait_task,"acquisition-wait")
    if route=2 then do
      advanced_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(wait_task))
      calls=scalarint(db,"SELECT count(*) FROM provider_runs")
      again=""
      errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999,.jsondocument(route_policy),again,error)=0 & again=wait_task & scalarint(db,"SELECT count(*) FROM provider_runs")=calls,"unchanged advanced technical hold stays quiet")
      errors=errors+check(sqliteexec(db,"DELETE FROM mentions WHERE concept_id=" || _testquote(isolate) || " AND revision_chunk_id='chunk-lifecycle'")=0,"material source change removes advanced passage and catalogue bound")
      advanced_child=""
      errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999,.jsondocument(route_policy),advanced_child,error)=0 & advanced_child<>"" & advanced_child<>wait_task,"changed advanced technical question creates one successor " || error)
      errors=errors+check(scalartext(db,"SELECT state||':'||required_capability||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))="pending:advanced-reasoning:" & scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))=wait_task & scalarint(db,"SELECT json_extract(evidence_json,'$.evidence_complete') FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))<>0 & scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(wait_task))=advanced_packet & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(wait_task) || " AND disposition='acquisition-wait:unresolved'")=1,"removed bound clears only successor hold and retains original debt")
      advanced_job=wait_job
      errors=errors+check(nextwindow(store,route_policy,advanced_job,error)=0 & scalarint(db,"SELECT count(*) FROM job_items i JOIN maintenance_task_items m ON m.item_id=i.item_id WHERE m.task_id=" || _testquote(advanced_child) || " AND i.state IN('queued','running')")=1,"changed advanced successor is eligible for dispatch " || error)
      advanced_evidence=scalartext(db,"SELECT json_extract(evidence_json,'$.passages[0].evidence_id') FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))
      retained=responsejson("retain","","[]",'[{"evidence_id":' || jsonquote(advanced_evidence) || ',"quote":"Platform"}]')
      errors=errors+check(advanced_evidence<>"" & runresolution(store,advanced_job,advanced_child,retained,error)=0 & scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))="resolved:","supported advanced successor fulfills wait without reviving origin " || error)
      again=""
      errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999,.jsondocument(route_policy),again,error)=0 & again=advanced_child,"settled advanced successor stays quiet")
      errors=errors+check(sqliteexec(db,"UPDATE concepts SET concept_type='source-artifact' WHERE concept_id=" || _testquote(isolate))=0,"material subject correction follows settled advanced task")
      settled_child=""
      errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999,.jsondocument(route_policy),settled_child,error)=0 & settled_child<>advanced_child & scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(settled_child))=advanced_child & scalartext(db,"SELECT required_capability||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(settled_child))="advanced-reasoning:","settled successor preserves route without obsolete hold " || error)
      errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET not_before_epoch=unixepoch()+3600 WHERE task_id=" || _testquote(settled_child))=0,"defer separate settled-successor fixture from later windows")
      wait_job=advanced_job
    end
    if route=3 | route=4 then do
      extra_chunk="wait-still-blocked-chunk-" || route;extra_mention="wait-still-blocked-extra-" || route
      errors=errors+check(sqliteexec(db,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES(" || _testquote(extra_chunk) || ",'revision-lifecycle'," || (19+route) || ",0,14,'content-lifecycle'," || _testquote(extra_chunk) || ",'fixture-v1','direct'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES(" || _testquote(extra_mention) || "," || _testquote(isolate) || "," || _testquote(extra_chunk) || ",0,8," || current || ")")=0,"material new source passage leaves inherited inventory oversized")
      blocked_child=""
      expected_route="standard";if route=3 then expected_route="advanced-reasoning"
      errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept",isolate,"","",999999,.jsondocument(route_policy),blocked_child,error)=0 & blocked_child<>wait_task & scalartext(db,"SELECT state||':'||required_capability||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(blocked_child))="pending:" || expected_route || ":evidence-limit" & scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(blocked_child))=wait_task,"still oversized changed context retains " || expected_route || " technical hold " || error)
      errors=errors+scopedholdchecks(store,blocked_child,"inherited " || expected_route || " hold",wait_task)
    end
    job=wait_job
  end
  oversize="";oversize_job=job
  errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('!oversized-inventory'," || _testquote(copies("X",9000)) || ",'concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('oversized-inventory-mention','!oversized-inventory','chunk-lifecycle',0,8," || current || ")")=0,"seed one unrepresentable inventory record")
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","concept-parent","","",999999,policy,oversize,error)=0 & oversize<>"","enqueue unrepresentable inventory question " || error)
  errors=errors+check(nextwindow(store,raw,oversize_job,error)=0,"dispatch unrepresentable inventory question " || error)
  errors=errors+check(runresolution(store,oversize_job,oversize,responsejson("inspect","","[]","[]","","catalogue"),error)=0,"retain single-record inventory limit " || error)
  errors=errors+check(scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(oversize))="unresolved:evidence-limit" & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(oversize) || " AND disposition='inspect:unresolved' AND json_extract(grounding_json,'$[0].status')='record-too-large' AND json_array_length(grounding_json,'$[0].items')=0")=1,"single unrepresentable record produces bounded truthful hold")
  errors=errors+scopedholdchecks(store,oversize,"inspect")
  /* A later small catalogue row must not make the original oversized row
   * appear repaired merely because an old cursor now returns a prefix. */
  inspect_isolate="";inspect_job=oversize_job
  errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('inspect-isolate','Platform','concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('inspect-isolate-mention','inspect-isolate','chunk-lifecycle',0,8," || current || ")")=0,"seed separate native record-limit question")
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","inspect-isolate","","",999999,policy,inspect_isolate,error)=0 & nextwindow(store,raw,inspect_job,error)=0 & runresolution(store,inspect_job,inspect_isolate,responsejson("inspect","","[]","[]","","catalogue"),error)=0 & scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_isolate))="unresolved:evidence-limit","second native oversized record holds " || error)
  inspect_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_isolate))
  inspect_runs=scalarint(db,"SELECT count(*) FROM provider_runs")
  errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('!a-before-oversize','Small','concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('inspect-small-before','!a-before-oversize','chunk-lifecycle',0,8," || current || ")")=0,"insert fitting row before held oversized record")
  again=""
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","inspect-isolate","","",999999,policy,again,error)=0 & again=inspect_isolate & scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_isolate))="unresolved:evidence-limit" & scalarint(db,"SELECT count(*) FROM provider_runs")=inspect_runs,"earlier fitting row leaves exact oversized record held " || error)
  errors=errors+check(sqliteexec(db,"UPDATE concepts SET canonical_label='Short inventory record' WHERE concept_id='!oversized-inventory'")=0,"repair exact oversized catalogue record")
  inspect_child=""
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","inspect-isolate","","",999999,policy,inspect_child,error)=0 & inspect_child<>"" & inspect_child<>inspect_isolate & scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_child))=inspect_isolate & scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_child))="pending:" & scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(inspect_isolate))=inspect_packet & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(inspect_isolate) || " AND disposition='inspect:unresolved'")=1 & scalarint(db,"SELECT count(*) FROM provider_runs")=inspect_runs,"only repair of exact held record releases linked successor " || error)
  return errors

/* Exercise the public plan/apply owner against a real worker decision. */
scopedholdchecks: procedure = .int
  arg store=.ragstorehandle,hold=.string,label=.string,ancestor=""
  db=store.database();errors=0;error="";config=architecturelocalconfig();profile=genericprofile()
  held_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(hold))
  held_decisions=scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(hold))
  held_attempts=scalarint(db,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m ON m.item_id=a.item_id WHERE m.task_id=" || _testquote(hold))
  held_runs=scalarint(db,"SELECT count(*) FROM provider_runs");held_usage=scalarint(db,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")
  ancestor_packet="";ancestor_decisions=-1;ancestor_attempts=-1;ancestor_receipts=-1
  if ancestor<>"" then do
    ancestor_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(ancestor))
    ancestor_decisions=scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(ancestor))
    ancestor_attempts=scalarint(db,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m ON m.item_id=a.item_id WHERE m.task_id=" || _testquote(ancestor))
    ancestor_receipts=scalarint(db,"SELECT count(*) FROM provider_runs WHERE provider_run_id IN(SELECT provider_run_id FROM maintenance_decisions WHERE task_id=" || _testquote(ancestor) || ")")
    review_id="fixture-inherited-review-" || rxhash..sha256hex(hold as .binary)
    errors=errors+check(sqliteexec(db,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES(" || _testquote(review_id) || ",'maintenance-external'," || _testquote(hold) || ",'pending','{}','fixture')")=0,"pending inherited hold review fixture")
    gated=""
    errors=errors+check(planbacklogrefresh(store,config,profile,hold,8192,25,"review ownership guard","fixture-agent","fixture",gated,error)<>0 & pos("pending review",error)>0,"pending review retains inherited hold ownership " || error)
    errors=errors+check(sqliteexec(db,"UPDATE reviews SET state='rejected' WHERE review_id=" || _testquote(review_id))=0,"release inherited hold review fixture")
    owner_window=scalartext(db,"SELECT window_id FROM maintenance_task_items WHERE task_id=" || _testquote(ancestor) || " LIMIT 1")
    owner_job=scalartext(db,"SELECT job_id FROM maintenance_windows WHERE window_id=" || _testquote(owner_window))
    owner_item="fixture-inherited-owner-" || rxhash..sha256hex(hold as .binary)
    errors=errors+check(owner_job<>"" & sqliteexec(db,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES(" || _testquote(owner_item) || "," || _testquote(owner_job) || ",'maintenance','queued',999999," || _testquote(owner_item) || ",'fixture','{}','fixture','fixture'); INSERT INTO maintenance_task_items(item_id,task_id,window_id,attempt_number) VALUES(" || _testquote(owner_item) || "," || _testquote(hold) || "," || _testquote(owner_window) || ",1)")=0,"active inherited hold ownership fixture")
    errors=errors+check(planbacklogrefresh(store,config,profile,hold,8192,25,"worker ownership guard","fixture-agent","fixture",gated,error)<>0 & pos("active worker ownership",error)>0,"active worker keeps inherited hold fenced " || error)
    errors=errors+check(sqliteexec(db,"DELETE FROM maintenance_task_items WHERE item_id=" || _testquote(owner_item) || "; DELETE FROM job_items WHERE item_id=" || _testquote(owner_item))=0,"release inherited hold worker ownership fixture")
  end
  scoped="";successor="";unchanged=""
  prior_bytes=config.maintenance().maximum_evidence_bytes()
  errors=errors+check(planbacklogrefresh(store,config,profile,hold,prior_bytes,100,"unchanged technical envelope","fixture-agent","fixture",unchanged,error)<>0 & pos("changed reviewed evidence envelope",error)>0,label || " native hold refuses unchanged envelope under current configuration " || error)
  errors=errors+check(planbacklogrefresh(store,config,profile,hold,8192,25,"inspect the remaining inventory in a smaller scope","fixture-agent","fixture",scoped,error)=0 & pos('"complete":false',scoped)>0,label || " native hold plans incomplete scoped refresh " || error)
  if scoped<>"" then errors=errors+check(applybacklogrefresh(store,config,profile,scoped,rxhash..sha256hex(scoped as .binary),successor,error)=0,label || " apply native hold refresh " || error)
  errors=errors+check(successor<>"" & scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(successor))=hold & scalartext(db,"SELECT state||':'||escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(successor))="unresolved:evidence-refresh" & scalartext(db,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(hold))="superseded" & scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(hold))=held_packet & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(hold))=held_decisions & scalarint(db,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m ON m.item_id=a.item_id WHERE m.task_id=" || _testquote(hold))=held_attempts & scalarint(db,"SELECT count(*) FROM provider_runs")=held_runs & scalarint(db,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")=held_usage,label || " scoped refresh retains lineage, evidence, decisions, attempts and usage")
  if ancestor<>"" then do
    errors=errors+check(scalartext(db,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(hold))=ancestor,"inherited refresh retains original parent link")
    actual_packet=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(ancestor))
    actual_decisions=scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(ancestor))
    actual_attempts=scalarint(db,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m ON m.item_id=a.item_id WHERE m.task_id=" || _testquote(ancestor))
    actual_receipts=scalarint(db,"SELECT count(*) FROM provider_runs WHERE provider_run_id IN(SELECT provider_run_id FROM maintenance_decisions WHERE task_id=" || _testquote(ancestor) || ")")
    errors=errors+check(actual_packet=ancestor_packet,"inherited refresh retains original worker packet")
    errors=errors+check(actual_decisions=ancestor_decisions,"inherited refresh retains original worker decisions")
    errors=errors+check(actual_attempts=ancestor_attempts,"inherited refresh retains original worker attempts")
    errors=errors+check(actual_receipts=ancestor_receipts,"inherited refresh retains original worker receipts")
  end
  rows=scalarint(db,"SELECT count(*) FROM maintenance_tasks")
  errors=errors+check(planbacklogrefresh(store,config,profile,hold,8192,25,"inspect the remaining inventory in a smaller scope","fixture-agent","fixture",unchanged,error)<>0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks")=rows,label || " unchanged repeat cannot reopen superseded source")
  if successor<>"" then errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET not_before_epoch=unixepoch()+3600 WHERE task_id=" || _testquote(successor))=0,"defer refreshed fixture from later windows")
  return errors

/* Saved-run reproduction: a quoted name occurs before and at the selected
 * UTF-8 span. Validation must bind the selected occurrence, not the first. */
selectedquotationchecks: procedure = .int
  arg database=.binary,task_id=.string
  errors=0; error=""; grounds=""
  original=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(task_id))
  generation=scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls=scalarint(database,"SELECT count(*) FROM provider_runs")
  body="Écosse: Dundee left. At Dundee, Mary waited. Dundee."
  do selected=1 to 2
    begin=9; if selected=2 then begin=25
    packet='{"subject":{"type":"concept","id":"concept-parent"},"passages":[{"evidence_id":"scope-evidence","revision_chunk_id":"chunk-lifecycle","text":' || jsonquote(body) || ',"span_start":' || begin || ',"span_end":' || (begin+6) || ',"text_offset":100}]}'
    errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET evidence_json=" || _testquote(packet) || " WHERE task_id=" || _testquote(task_id))=0,"selected quote fixture")
    result=validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"Dundee"}]'),grounds,error)
    errors=errors+check(result=0,"selected repeated quotation " || selected || " " || error)
    if result=0 then errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_start')")=begin+100 & scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_end')")=begin+106,"selected occurrence retains original byte offsets")
  end
  result=validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"At Dundee, Mary waited."}]'),grounds,error)
  errors=errors+check(result=0 & scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_start')")=122,"quotation may start before and extend after selected span " || error)
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"Dundee left."}]'),grounds,error)<>0,"quote elsewhere cannot support selected occurrence")
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"At Glasgow, Mary waited."}]'),grounds,error)<>0,"invented selected quotation remains rejected")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET evidence_json=" || _testquote(original) || " WHERE task_id=" || _testquote(task_id))=0,"restore independent task fixture")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=generation & scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"quotation validation makes no publication or provider call")
  return errors

responsejson: procedure = .string
  arg action = .string, target = "", successors = "[]", evidence = "[]", object_id = "", question = "", qualifiers = "{}", effective_from = "", effective_to = ""
  return '{"action":' || jsonquote(action) || ',"object_id":' || jsonquote(object_id) || ',"target_concept_id":' || jsonquote(target) || ',"canonical_label":"","concept_type":"","successors":' || successors || ',"reason":"fixture evidence-based decision","evidence":' || evidence || ',"effective_from":' || jsonquote(effective_from) || ',"effective_to":' || jsonquote(effective_to) || ',"qualifiers_json":' || jsonquote(qualifiers) || ',"question":' || jsonquote(question) || '}'

convergencemetric: procedure = .int
  arg database=.binary,response=.string,name=.string
  return scalarint(database,"SELECT json_extract(value,'$.fields." || name || "') FROM json_each(" || _testquote(response) || ",'$.result.structuredContent.records') WHERE json_extract(value,'$.kind')='convergence-census'")

graphreportmetric: procedure = .string
  arg database=.binary,response=.string,kind=.string,name=.string
  return scalartext(database,"SELECT CAST(json_extract(value,'$.fields." || name || "') AS TEXT) FROM json_each(" || _testquote(response) || ",'$.result.structuredContent.records') WHERE json_extract(value,'$.kind')=" || _testquote(kind) || " LIMIT 1")

graphworkcount: procedure = .int
  arg database=.binary,response=.string,kind=.string,state=.string,outcome=.string
  return scalarint(database,"SELECT coalesce(sum(json_extract(value,'$.fields.tasks')),0) FROM json_each(" || _testquote(response) || ",'$.result.structuredContent.records') WHERE json_extract(value,'$.kind')='graph-work-type' AND json_extract(value,'$.fields.task_kind')=" || _testquote(kind) || " AND json_extract(value,'$.fields.current_state')=" || _testquote(state) || " AND json_extract(value,'$.fields.historic_outcome')=" || _testquote(outcome))

graphworkcalls: procedure = .int
  arg database=.binary,response=.string,kind=.string,state=.string,outcome=.string
  return scalarint(database,"SELECT coalesce(sum(json_extract(value,'$.fields.provider_calls')),0) FROM json_each(" || _testquote(response) || ",'$.result.structuredContent.records') WHERE json_extract(value,'$.kind')='graph-work-type' AND json_extract(value,'$.fields.task_kind')=" || _testquote(kind) || " AND json_extract(value,'$.fields.current_state')=" || _testquote(state) || " AND json_extract(value,'$.fields.historic_outcome')=" || _testquote(outcome))

actionabilitychecks: procedure = .int
  arg store=.ragstorehandle,raw=.string
  db=store.database();errors=0;error="";task="";grounds="";job="";packet="";fingerprint=""
  raw=changestr("retain investigate",raw,"retain investigate no-change")
  policy=.jsondocument(raw);current=scalarint(db,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors=errors+check(sqliteexec(db,"UPDATE analysis_notes SET note_kind='observation' WHERE note_id='note-parent' AND next_action=''")=0,"keep the unrelated fixture observation outside actionability discovery")
  errors=errors+check(pos('"correct-note"',backlogschema("note",0))>0 & pos('"resolve-gap"',backlogschema("gap",0))>0 & pos('"capability-wait"',backlogschema("note",0))>0,"actionability contract exposes grounded correction and wait actions")
  errors=errors+check(sqliteexec(db,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-outdated','lead','Platform is absent',800000,200000,'Review source','active','{}','fixture',1,'fixture','fixture'),('note-capability','lead','Platform needs a structured qualifier',800000,200000,'Review representation','active','{}','fixture',1,'fixture','fixture'); INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-outdated','note-outdated','concept','concept-parent','chunk-lifecycle',0,8),('link-capability','note-capability','concept','concept-parent','chunk-lifecycle',0,8)")=0,"seed outdated and capability-limited notes")
  errors=errors+check(enqueuebacklogtask(db,"analysis-lead","note","note-outdated","","",800000,policy,task,error)=0 & task<>"","enqueue outdated note " || error)
  errors=errors+check(buildbacklogevidence(db,"note","note-outdated","",65536,packet,fingerprint,error)=0,"note correction receives current source packet " || error)
  evidence_id=scalartext(db,"SELECT json_extract(" || _testquote(packet) || ",'$.passages[0].evidence_id')")
  response=currentresponse(responsejson("correct-note","","[]",'[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform Peer"}]',"note-outdated"),"Platform appears with Peer.")
  before=scalarint(db,"SELECT published_generation FROM library_meta WHERE singleton=1");calls=scalarint(db,"SELECT count(*) FROM provider_runs")
  wrong=currentresponse(responsejson("correct-note","","[]",'[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform Peer"}]',"note-capability"),"Platform appears with Peer.")
  missing=currentresponse(responsejson("correct-note","","[]","[]","note-outdated"),"Platform appears with Peer.")
  misquoted=currentresponse(responsejson("correct-note","","[]",'[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform is absent"}]',"note-outdated"),"Platform appears with Peer.")
  errors=errors+check(validatebacklogresponse(db,task,wrong,grounds,error)<>0 & validatebacklogresponse(db,task,missing,grounds,error)<>0 & validatebacklogresponse(db,task,misquoted,grounds,error)<>0 & scalarint(db,"SELECT published_generation FROM library_meta WHERE singleton=1")=before & scalarint(db,"SELECT count(*) FROM provider_runs")=calls,"note correction rejects wrong subject, missing grounding and misquoted source without publication")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & runresolution(store,job,task,response,error)=0,"worker proposes grounded note correction " || error)
  review=scalartext(db,"SELECT review_id FROM reviews WHERE subject_id=" || _testquote(task) || " AND state='pending'")
