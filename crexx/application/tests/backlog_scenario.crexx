  errors=errors+check(mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","read")=report_after & scalarint(db,"SELECT count(*) FROM provider_runs")=before,"repeated read-only report leaves all decisions and provider usage stable")
  errors=errors+check(convergencemetric(db,report_after,"new_logical_questions")=17 & convergencemetric(db,report_after,"materially_reopened_questions")=7 & convergencemetric(db,report_after,"durable_settlements")=10 & convergencemetric(db,report_after,"closing_actionable_debt")=14,"known synthetic versions give independent event totals before supersession")
  errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET state='superseded' WHERE task_id IN(" || _testquote(cap_task) || "," || _testquote(correction_task) || ") AND state='resolved'")=0,"model retained superseded state after the two real accepted chains")
