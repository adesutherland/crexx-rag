options levelg

import rxfnsb
import rxsqlite
import ragsqlsupport
import ragstore
import ragmaintain
import rxhash
import rxjson
import ragbacklog
import ragresolutionreferences
import raglifecycle
import ragwork
import ragworktypes
import ragclaims
import ragprofile
import ragcanonical
import generic_profile
import architecture_local_config
import ragcommand
import ragcommandutil
import ragproduct
import ragmcp
import operator_registry

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "DURABLE_BACKLOG_FAIL=" || label
  return 1

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

fixtureprovider: class implements .ragworkprovider
  _response = .string
  *: factory
    arg response = .string
    _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(0,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)
    if _response<>"empty-extraction" then call result.resolution(_response,genericprofile())
    return result

/* Invoke the second worker while the first owns the final call reservation.
 * This forces the admission race without depending on timing or sleeps. */
budgetpeerprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _peer_status = .int
  _peer_disposition = .string
  _peer_error = .string
  *: factory
    arg store = .ragstorehandle
    _store = store; _peer_status = -99
    return
  peer_status: method = .int
    return _peer_status
  peer_disposition: method = .string
    return _peer_disposition
  peer_error: method = .string
    return _peer_error
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    peer = .fixtureprovider(responsejson("unresolved"))
    policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    _peer_status = runworkeronce(_store,claim.job_id(),"budget-peer",60,1,policy,peer,_peer_disposition,_peer_error,genericprofile())
    return peer.process(claim)

/* Close the window while extraction is in flight, then return its last result.
 * The worker must reconcile it before returning, even without another poll. */
closingextractionprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _closed = .int
  *: factory
    arg store = .ragstorehandle
    _store = store; _closed = 0
    return
  closed: method = .int
    return _closed
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    error = ""
    ignored = sqliteexec(_store.database(),"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || claim.job_id() || "'")
    _closed = tickbacklogwindow(_store,claim.job_id(),error)
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(0,"fixture","fixture","close-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

staleprovider: class implements .ragworkprovider
  _database = .binary
  _response = .string
  *: factory
    arg database = .binary, response = .string
    _database = database; _response = response
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    ignored = sqliteexec(_database,"UPDATE concepts SET canonical_label='Survivor revised during call' WHERE concept_id='concept-survivor'")
    provider = .fixtureprovider(_response)
    return provider.process(claim)

/* A response validated before the merge still carries the old catalogue ID.
 * Publication must resolve its mention again while it owns the writer. */
mergingextractionprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]; aliases = .string[]
    aliases[1] = "peer"
    mentions[1] = .ragworkmention("candidate-rel013","Peer","concept",9,13,aliases,"concept-peer")
    return .ragworkproviderresult(0,"fixture","fixture","request-rel013",10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

identitycollisionprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]; aliases = .string[]
    aliases[1] = "Platform"
    mentions[1] = .ragworkmention("candidate-identity-collision","Platform","evidence-span",0,8,aliases)
    return .ragworkproviderresult(0,"fixture","fixture","identity-" || claim.attempt_id(),10,10,0,1,0,empty,"",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

failureclassprovider: class implements .ragworkprovider
  _status = .int
  _content = .int
  *: factory
    arg status = .int, content = .int
    _status = status; _content = content
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal
    mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(_status,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,1,empty,"fixture classified failure",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)
    call result.set_content_failure(_content)
    return result

/* UX-03: compare the proposed connection effects with independent ledger reads.
 * This fixture does not call a provider or run a worker window. */
workflowclosurechecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  database = store.database(); errors = 0; error = ""; policy = .jsondocument(policy_json); config = architecturelocalconfig(); profile = genericprofile()
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  jobs = scalarint(database,"SELECT count(*) FROM jobs"); items = scalarint(database,"SELECT count(*) FROM job_items")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('closure-parent','Platform closure','concept','migration-parent'," || current || ")") = 0,"external closure fixture")
  origin = ""
  errors = errors + check(enqueuebacklogtask(database,"closure-origin","concept","closure-parent","","",1,policy,origin,error) = 0,"external closure origin")
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_workflows(workflow_id,origin_task_id,kind,parent_concept_id,successors_json,state,created_generation,created_epoch,updated_epoch) VALUES('closure-workflow'," || _testquote(origin) || ",'split','closure-parent','[]','migrating'," || current || ",unixepoch(),unixepoch())") = 0,"external closure workflow")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('closure-mention','closure-parent','chunk-lifecycle',0,8," || current || "); UPDATE maintenance_tasks SET state='resolved' WHERE task_id=" || _testquote(origin)) = 0,"retained completed split and connection")
  connection=""; connection_plan=""; connection_review=""
  errors = errors + check(enqueuebacklogtask(database,"connection","mention","closure-mention","closure-workflow",origin,1,policy,connection,error) = 0,"external connection task")
  errors = errors + check(planagentaction(store,config,profile,connection,"resolution",responsejson("retract","","[]",'[{"evidence_id":"closure-mention","quote":"Platform"}]'),"external correction","fixture","fixture",connection_plan,error) = 0,"grounded correction before closure " || error)
  errors = errors + check(applyagentaction(store,config,profile,connection_plan,rxhash..sha256hex(connection_plan as .binary),"resolution",connection_review,error) = 0 & reviewagentaction(store,connection_review,"accept",config,profile,error) = 0,"reviewed correction before closure " || error)
  current=current+1
  types = .string[]; ids = .string[]
  errors = errors + check(lifecycleimpact(database,"closure-parent",current,types,ids,error) = 0 & ids.0 = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"positive control empty impact with no retirement task")
  unrelated = scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id<>'closure-workflow'")
  result = workflowcommand(store,"closure-workflow",0,current,"plan")
  errors = errors + check(result.exit_code() = 0,"UX-04 public workflow census preview " || result.message())
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"workflow preview makes no writes")
  if result.exit_code() <> 0 then return errors
  output = ""; human = ""
  errors = errors + check(rendercommandresult(result,"json",output,error) = 0 & rendercommandresult(result,"human",human,error) = 0 & pos("queue-retirement",human)>0,"workflow preview names retirement effect")
  result = workflowcommand(store,"closure-workflow",1,current,"plan")
  errors = errors + check(result.exit_code() = 4,"workflow census apply requires curate access")
  result = workflowcommand(store,"closure-workflow",1,current-1,"curate")
  errors = errors + check(result.exit_code() <> 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"stale workflow census cannot enqueue")
  errors = errors + check(sqliteexec(database,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES('closure-guard-review','fixture'," || _testquote(origin) || ",'pending','{}','fixture')") = 0,"pending review guard fixture")
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  output=""; errors = errors + check(result.exit_code() = 0 & rendercommandresult(result,"json",output,error) = 0 & pos("waiting-review",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 0,"pending workflow review holds retirement")
  errors = errors + check(sqliteexec(database,"UPDATE reviews SET state='dismissed',decision_json='{}' WHERE review_id='closure-guard-review'") = 0,"release pending review fixture")
  legacy_run=scalartext(database,"SELECT run_id FROM maintenance_windows WHERE policy_fingerprint=(SELECT policy_fingerprint FROM maintenance_tasks WHERE task_id=" || _testquote(origin) || ") ORDER BY created_epoch DESC,window_id DESC LIMIT 1")
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_items(item_id,run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,expected_generation,created_at,updated_at) VALUES('closure-legacy-review'," || _testquote(legacy_run) || ",'concept-review','concept','closure-parent',1,'{}','{}','{}','review-required'," || current || ",'fixture','fixture')")=0,"legacy lifecycle review fixture")
  result=workflowcommand(store,"closure-workflow",0,current,"plan"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-review",output)>0,"workflow preview includes legacy lifecycle review gate")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_items SET state='rejected' WHERE item_id='closure-legacy-review'")=0,"release legacy review fixture")
  errors = errors + workflowholdchecks(store,origin,current)
  items=items+1
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  errors = errors + check(result.exit_code() = 0,"apply targeted workflow census")
  task_id = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")
  errors = errors + check(task_id <> "" & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(task_id)) = "pending","one public retirement task is available")
  result = workflowcommand(store,"closure-workflow",1,current,"curate")
  errors = errors + check(result.exit_code() = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'") = 1,"workflow reconciliation is idempotent")
  rpc='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rag_workflow_reconcile_preview","arguments":{"id":"closure-workflow"}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","plan")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.result.structuredContent.exit_code')")=0 & pos(task_id,rpc_result)>0,"MCP preview discovers the same retirement task")
  rpc='{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"rag_workflow_reconcile","arguments":{"id":"closure-workflow","expect_generation":' || current || '}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","plan")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.error.code')")=-32602,"MCP plan access cannot apply reconciliation")
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","curate")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(rpc_result) || ",'$.result.structuredContent.exit_code')")=0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=1,"MCP reconciliation shares CLI idempotence")

  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id<>'closure-workflow'") = unrelated & scalarint(database,"SELECT count(*) FROM jobs") = jobs & scalarint(database,"SELECT count(*) FROM job_items") = items,"targeted census creates no unrelated tasks or workers")
  if task_id = "" then return errors+1
  errors=errors+legacyclosurecheck(store,profile,current,legacy_run,1)
  canonical = ""; review_id = ""
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",responsejson("retire","","[]","[]","closure-parent"),"external retirement","fixture","fixture",canonical,error) = 0,"publicly discovered retirement can be proposed " || error)
  errors = errors + check(applyagentaction(store,config,profile,canonical,rxhash..sha256hex(canonical as .binary),"resolution",review_id,error) = 0,"submit reviewed retirement " || error)
  held_job=scalartext(database,"SELECT job_id FROM job_items WHERE item_id='closure-held-item'")
  errors=errors+check(sqliteexec(database,"INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('closure-late-attempt','closure-held-item','historic',2,'fixture','unknown','expired','fixture','fixture'); INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(held_job) || ",'closure-held-item','closure-late-attempt','provider-intent','{}','fixture')")=0,"late workflow hold after retirement proposal")
  errors=errors+legacyclosurecheck(store,profile,current,legacy_run,0)
  retirement_preview=""; retirement_impact=""
  errors=errors+check(previewagentaction(store,review_id,config,profile,retirement_preview,retirement_impact,error)<>0,"retirement preview rechecks late workflow outcome hold")
  held_status=reviewagentaction(store,review_id,"accept",config,profile,error)
  errors=errors+check(held_status<>0 & scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="migration-parent","retirement acceptance rechecks late workflow outcome hold")
  errors=errors+check(sqliteexec(database,"INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(held_job) || ",'closure-held-item','closure-late-attempt','provider-response','{}','fixture')")=0,"settle late fixture without deleting history")
  if held_status=0 then return errors
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"complete external retirement " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'") = "retired" & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'") = "complete","retirement closes parent and workflow")
  result = workflowcommand(store,"closure-workflow",1,current+1,"curate")
  errors = errors + check(result.exit_code() = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow'") = 2,"completed workflow reconciliation is a no-op")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+1 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"external closure preserves source usage and history with one reviewed generation")
  /* Older legacy publication could leave only this workflow marker behind.
   * Recover its existing retirement; do not publish a second retirement. */
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_workflows SET state='migrating',completed_generation=NULL WHERE workflow_id='closure-workflow'")=0,"legacy completed-parent workflow marker fixture")
  result=workflowcommand(store,"closure-workflow",0,current+1,"plan");output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("complete-retired-workflow",output)>0,"public preview recognizes retained legacy retirement")
  result=workflowcommand(store,"closure-workflow",1,current+1,"curate")
  errors=errors+check(result.exit_code()=0 & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'")="complete" & scalarint(database,"SELECT completed_generation FROM maintenance_workflows WHERE workflow_id='closure-workflow'")=current+1,"public reconciliation checkpoints legacy retirement")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current+1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow'")=2 & scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"legacy workflow recovery creates no generation task or provider call")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_workflows SET state='complete',completed_generation=" || (current+1) || " WHERE workflow_id='closure-workflow'")=0,"restore isolated legacy marker fixture")
  return errors

legacyclosurecheck: procedure = .int
  arg store = .ragstorehandle, profile = .ragprofile, current = .int, legacy_run = .string, expect_success = .int
  database=store.database();errors=0;error=""
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"begin isolated legacy retirement check")
  legacy_action='{"schema":"crexx-rag.lifecycle-action/1","operation":"retire","concept_id":"closure-parent","target_concept_id":"","alias":"","concept_type":"","reason":"isolated legacy retirement check","successors":[],"dispositions":[]}'
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_items(item_id,run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,expected_generation,created_at,updated_at) VALUES('closure-direct-retire'," || _testquote(legacy_run) || ",'retire','concept','closure-parent',1,'{}','{}'," || _testquote(legacy_action) || ",'approved'," || current || ",'fixture','fixture')")=0,"legacy retirement item matches reviewed action")
  isolated_generation=0
  errors=errors+check(stagegeneration(store,current,scalartext(database,"SELECT current_config_snapshot_id FROM library_config_state WHERE singleton=1"),"legacy retirement gate fixture",isolated_generation,error)=0,"stage isolated legacy retirement generation")
  status=applylifecycletransaction(store,profile,"closure-direct-retire",legacy_action,current,isolated_generation,error)
  if expect_success=0 then errors=errors+check(status<>0,"legacy retirement publication enforces workflow holds")
  else do
    errors=errors+check(status=0,"legacy retirement positive control " || error)
    errors=errors+check(scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='closure-workflow'")="complete" & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="retired","legacy retirement closes the workflow in the same transaction")
  end
  ignored=sqliteexec(database,"ROLLBACK")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='closure-parent'")="migration-parent","isolated legacy gate preserves generation and parent")
  return errors

workflowholdchecks: procedure = .int
  arg store = .ragstorehandle, origin = .string, generation = .int
  database=store.database(); errors=0; error=""
  window=scalartext(database,"SELECT window_id FROM maintenance_windows WHERE policy_fingerprint=(SELECT policy_fingerprint FROM maintenance_tasks WHERE task_id=" || _testquote(origin) || ") ORDER BY created_epoch DESC,window_id DESC LIMIT 1")
  job=scalartext(database,"SELECT job_id FROM maintenance_windows WHERE window_id=" || _testquote(window))
  errors=errors+check(sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('closure-held-item'," || _testquote(job) || ",'maintenance-resolution','queued',1,'closure-held-item','fixture','{}','fixture','fixture'); INSERT INTO maintenance_task_items(item_id,task_id,window_id,attempt_number) VALUES('closure-held-item'," || _testquote(origin) || "," || _testquote(window) || ",99)")=0,"workflow ownership fixture")
  result=workflowcommand(store,"closure-workflow",1,generation,"curate"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-worker",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=0,"queued workflow ownership holds retirement")
  errors=errors+check(sqliteexec(database,"UPDATE job_items SET state='dead_letter' WHERE item_id='closure-held-item'; INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) VALUES('closure-held-attempt','closure-held-item','historic',1,'fixture','unknown','expired','fixture','fixture'); INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(job) || ",'closure-held-item','closure-held-attempt','provider-intent','{}','fixture')")=0,"uncertain workflow outcome fixture")
  result=workflowcommand(store,"closure-workflow",1,generation,"curate"); output=""
  errors=errors+check(result.exit_code()=0 & rendercommandresult(result,"json",output,error)=0 & pos("waiting-provider-outcome",output)>0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE workflow_id='closure-workflow' AND kind='retirement'")=0,"uncertain provider outcome cannot be hidden by workflow retirement")
  errors=errors+check(sqliteexec(database,"INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(" || _testquote(job) || ",'closure-held-item','closure-held-attempt','provider-response','{}','fixture'); UPDATE job_items SET state='skipped' WHERE item_id='closure-held-item'")=0,"settle fixture while retaining its attempt and events")
  return errors

workflowcommand: procedure = .ragcommandresult
  arg store = .ragstorehandle, workflow = .string, apply = .int, generation = .int, capability = .string
  config=architecturelocalconfig(); command_args=.string[]
  command_args[1]="--library=" || store.path(); command_args[2]="--config=" || config.config_id(); command_args[3]="--profile=generic-profile"; command_args[4]="--format=json"; command_args[5]="--access=" || capability
  command_args[6]="maintain"; command_args[7]="reconcile"; command_args[8]=workflow
  if apply=1 then do; command_args[9]="--apply"; command_args[10]="--expect-generation=" || generation; end
  request=.ragcommandrequest; error=""
  if parsecommand(command_args,request,error)<>0 then return commandfailure("maintain.reconcile",2,error)
  return dispatchproduct(request,operatorregistry())

connectioneffectchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  database = store.database(); errors = 0; error = ""; config = architecturelocalconfig(); profile = genericprofile(); policy = .jsondocument(policy_json)
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('effect-parent','Platform','concept','migration-parent'," || current || "),('effect-target','Platform successor','concept','active'," || current || ")") = 0,"effect concepts")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('effect-mention','effect-parent','chunk-lifecycle',0,8," || current || "),('effect-target-mention','effect-target','chunk-lifecycle',0,8," || current || ")") = 0,"effect mentions")
  errors = errors + check(sqliteexec(database,"INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('effect-claim','effect-parent','related-to','effect-target','outbound','{}','fixture'," || current || "),('effect-other','effect-target','related-to','effect-parent','outbound','{}','fixture'," || current || ")") = 0,"effect claims")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) VALUES('effect-support-a','effect-claim','chunk-lifecycle',0,13,'support','assertion','direct','','effect-a','fixture'," || current || "),('effect-support-b','effect-claim','chunk-lifecycle',0,13,'support','assertion','direct','','effect-b','fixture-b'," || current || ")") = 0,"effect supports")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('effect-conflict','effect-claim','effect-other','pending'," || current || ")") = 0,"effect conflict")
  origin = ""
  errors = errors + check(enqueuebacklogtask(database,"effect-origin","concept","effect-parent","","",1,policy,origin,error) = 0,"effect origin " || error)
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_workflows(workflow_id,origin_task_id,kind,parent_concept_id,successors_json,state,created_generation,created_epoch,updated_epoch) VALUES('effect-workflow','" || origin || "','merge','effect-parent','[{" || '"concept_id":"effect-target"' || "}]','migrating'," || current || ",unixepoch(),unixepoch())") = 0,"effect workflow")
  task_id = ""; canonical = ""; review_id = ""
  errors = errors + connectionvariantchecks(store,current)
  errors = errors + check(enqueuebacklogtask(database,"connection","support","effect-support-a","effect-workflow",origin,1,policy,task_id,error) = 0,"effect support task " || error)
  evidence = '[{"evidence_id":"effect-support-a","quote":"Platform"}]'
  response = responsejson("retract","","[]",evidence)
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"positive control grounded support plan " || error)
  if canonical = "" then return errors + 1
  errors = errors + effectcheck(database,canonical,"support","effect-support-a","retract")
  errors = errors + effectcheck(database,canonical,"claim","effect-claim","retain")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(canonical) || ",'$.impact') WHERE json_extract(value,'$.object_type')='conflict'") = 0,"other support keeps conflicts active")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 2,"preview makes no support writes")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",responsejson("move","effect-target","[]",evidence),"effect test","fixture","fixture",canonical,error) <> 0,"self-edge migration rejected during planning")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"recreate support plan")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"submit support plan " || error)
  errors = errors + revieweffectchecks(store,review_id,canonical)
  /* Seed a legacy action as immutable history; never disable its write guards. */
  original_action = scalartext(database,"SELECT json_extract(proposal_json,'$.action_id') FROM reviews WHERE review_id=" || _testquote(review_id))
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_agent_actions(action_id,task_id,action_kind,actor,model,canonical_plan,created_epoch) SELECT 'legacy-effect-action',task_id,action_kind,actor,model,json_set(canonical_plan,'$.impact',json('[]')),created_epoch FROM maintenance_agent_actions WHERE action_id=" || _testquote(original_action) || "; UPDATE reviews SET proposal_json=json_set(proposal_json,'$.action_id','legacy-effect-action') WHERE review_id=" || _testquote(review_id)) = 0,"legacy preview fixture")
  errors = errors + revieweffectchecks(store,review_id,canonical)
  errors = errors + check(scalartext(database,"SELECT json_extract(canonical_plan,'$.impact') FROM maintenance_agent_actions WHERE action_id='legacy-effect-action'") = "[]","preview does not rewrite retained action")
  errors = errors + check(sqliteexec(database,"UPDATE reviews SET proposal_json=json_set(proposal_json,'$.action_id'," || _testquote(original_action) || ") WHERE review_id=" || _testquote(review_id)) = 0,"restore original reviewed action")
  errors = errors + stalepreviewchecks(store,review_id)
  errors = errors + effectboundchecks(store)
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept support retraction " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE support_id='effect-support-a' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 1,"support retraction matches preview and retains supported claim")
  errors = errors + check(enqueuebacklogtask(database,"connection","claim","effect-claim","effect-workflow",origin,1,policy,task_id,error) = 0,"effect claim task " || error)
  evidence = '[{"evidence_id":"effect-support-b","quote":"Platform"}]'
  response = responsejson("retract","","[]",evidence,"effect-claim")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"effect test","fixture","fixture",canonical,error) = 0,"positive control grounded claim plan " || error)
  errors = errors + effectcheck(database,canonical,"claim","effect-claim","retract")
  errors = errors + effectcheck(database,canonical,"support","effect-support-b","retract")
  errors = errors + effectcheck(database,canonical,"conflict","effect-conflict","resolve")
  errors = errors + check(scalarint(database,"SELECT json_array_length(" || _testquote(canonical) || ",'$.impact')") = 3,"claim preview includes exactly active affected rows")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"submit claim retraction " || error)
  errors = errors + revieweffectchecks(store,review_id,canonical)
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept claim retraction " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='effect-claim' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claim_support WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 0 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE conflict_id='effect-conflict' AND visible_to_generation IS NOT NULL") = 1,"claim support conflict publication matches effect preview")
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0 & reviewagentaction(store,review_id,"accept",config,profile,error) <> 0,"exact replay retains history without repeated publication")
  /* Two accepted effects plus the explicit unrelated-publication control. */
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+3 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"effect checks preserve sources usage history and foreign keys")
  return errors

connectionvariantchecks: procedure = .int
  arg store = .ragstorehandle, current = .int
  database = store.database(); errors = 0; error = ""; impact = ""; result = .jsondocument(responsejson("retract"))
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,4,impact,error) = 0,"effect bound positive control")
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,3,impact,error) <> 0,"effect count enforces configured bound")
  errors = errors + check(sqliteexec(database,"BEGIN IMMEDIATE") = 0,"begin isolated move projection fixture")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('effect-successor','Platform','concept','active'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('effect-successor-mention','effect-successor','chunk-lifecycle',0,8," || current || "); INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('effect-resolved-conflict','effect-claim','effect-other','resolved-retain-both'," || current || ")") = 0,"move projection fixture")
  result = .jsondocument(responsejson("move","effect-successor"))
  errors = errors + check(connectioneffects(database,"effect-parent","claim","effect-claim",result,current,10,impact,error) = 0,"supported move has an effect preview " || error)
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"conflict","effect-conflict","carry")
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"conflict","effect-resolved-conflict","resolve")
  preview_publication = 0
  errors = errors + check(stagegeneration(store,current,scalartext(database,"SELECT current_config_snapshot_id FROM library_config_state WHERE singleton=1"),"isolated effect fixture",preview_publication,error) = 0,"stage isolated move generation")
  errors = errors + check(applyconnectiontransaction(database,"effect-parent","claim","effect-claim","move-child","effect-successor",current,preview_publication,error) = 0,"move publication positive control " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id='effect-successor' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE claim_id='effect-claim' AND visible_to_generation IS NULL") = 0 & scalarint(database,"SELECT count(*) FROM claim_conflicts WHERE claim_id IN(SELECT claim_id FROM claims WHERE source_concept_id='effect-successor') AND review_state='pending' AND visible_to_generation IS NULL") = 1,"move carries pending conflicts and closes former rows")
  errors = errors + check(sqliteexec(database,"ROLLBACK") = 0,"rollback isolated move projection fixture")
  result = .jsondocument(responsejson("retain"))
  errors = errors + check(connectioneffects(database,"effect-parent","note","effect-note",result,current,10,impact,error) = 0,"note settlement projection")
  errors = errors + effectcheck(database,'{"impact":' || impact || '}',"note","effect-note","resolve")
  return errors

stalepreviewchecks: procedure = .int
  arg store = .ragstorehandle, review_id = .string
  database = store.database(); errors = 0; config = architecturelocalconfig(); access = .string[]; access[1] = "plan"; positionals = .string[]
  preview_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"UPDATE library_meta SET published_generation=published_generation-1 WHERE singleton=1") = 0,"stale review preview fixture")
  command_options = .ragcommandoption[]; command_options[1] = .ragcommandoption("id",review_id,0); command_options[2] = .ragcommandoption("decision","accept",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code() = 3,"stale review cannot advertise acceptable effects")
  command_options[2] = .ragcommandoption("decision","reject",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code() = 0,"stale review can still be rejected")
  errors = errors + check(sqliteexec(database,"UPDATE library_meta SET published_generation=" || preview_generation || " WHERE singleton=1") = 0,"restore review snapshot")
  publication_error = ""; unrelated_generation = 0
  publication_snapshot = scalartext(database,"SELECT config_snapshot_id FROM published_generations WHERE generation=" || preview_generation)
  errors = errors + check(begingeneration(store,preview_generation,publication_snapshot,"unrelated publication control",unrelated_generation,publication_error)=0 & commitgeneration(store,unrelated_generation,publication_error)=0 & publishmanifest(store,publication_error)=0,"unrelated generation fixture " || publication_error)
  command_options[2] = .ragcommandoption("decision","accept",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry())
  errors = errors + check(result.exit_code()=0,"unrelated publication preserves validated review effects " || result.message())
  return errors

effectboundchecks: procedure = .int
  arg store = .ragstorehandle
  errors = 0; error = ""; impact = "["
  do i = 1 to 1000
    if i > 1 then impact = impact || ","
    impact = impact || '{"object_type":"support","object_id":"effect-' || i || '","effect":"retract","target_concept_id":""}'
  end
  impact = impact || "]"; fields = .ragresultfield[]; fields[1] = .ragresultfield("applied","boolean","false")
  records = .ragresultrecord[]; records[1] = .ragresultrecord("agent-action",fields)
  records = commandeffectrecords(records,impact); result = .ragcommandresult("maintain.resolve-plan","ok",0,"effect bound",records); output = ""
  errors = errors + check(records.0 = 100 & rendercommandresult(result,"json",output,error) = 0,"bounded preview remains renderable " || error)
  errors = errors + check(scalartext(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_json')") = impact & scalarint(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_truncated')") = 1,"full effects survive explicit human display truncation")
  return errors

revieweffectchecks: procedure = .int
  arg store = .ragstorehandle, review_id = .string, expected = .string
  errors = 0; error = ""; config = architecturelocalconfig(); access = .string[]; access[1] = "plan"
  command_options = .ragcommandoption[]; command_options[1] = .ragcommandoption("id",review_id,0); command_options[2] = .ragcommandoption("decision","accept",0)
  positionals = .string[]
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"review","decide","review.decide",command_options,positionals)
  result = dispatchproduct(request,operatorregistry()); output = ""; human = ""
  errors = errors + check(result.exit_code() = 0,"review effect preview positive control")
  errors = errors + check(rendercommandresult(result,"json",output,error) = 0 & rendercommandresult(result,"human",human,error) = 0,"render review effect preview " || error)
  wanted = scalartext(store.database(),"SELECT json_extract(" || _testquote(expected) || ",'$.impact')")
  actual = scalartext(store.database(),"SELECT json_extract(" || _testquote(output) || ",'$.records[0].fields.impact_json')")
  errors = errors + check(wanted <> "[]" & actual = wanted,"review shows complete planned effects")
  errors = errors + check(pos("effect-support",human)>0 & pos("retract",human)>0,"human preview shows affected support and action")
  errors = errors + check(scalartext(store.database(),"SELECT state FROM reviews WHERE review_id=" || _testquote(review_id)) = "pending","review preview makes no writes")
  return errors

effectcheck: procedure = .int
  arg database = .binary, canonical = .string, kind = .string, id = .string, effect = .string
  return check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(canonical) || ",'$.impact') WHERE json_extract(value,'$.object_type')=" || _testquote(kind) || " AND json_extract(value,'$.object_id')=" || _testquote(id) || " AND json_extract(value,'$.effect')=" || _testquote(effect)) = 1,"UX-03 preview " || kind || " " || id || " " || effect)

_testquote: procedure = .string
  arg value = .string
  return "'" || changestr("'",value,"''") || "'"

agentchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  errors = 0; error = ""; database = store.database(); config = architecturelocalconfig(); profile = genericprofile(); policy = .jsondocument(policy_json)
  current = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs"); sources = scalarint(database,"SELECT count(*) FROM source_revisions")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-external','Platform','concept','active'," || current || ")") = 0,"external fixture concept")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-external','concept-external','chunk-lifecycle',0,8," || current || ")") = 0,"external fixture mention")
  task_id = ""
  errors = errors + check(enqueuebacklogtask(database,"external-review","concept","concept-external","","",999999,policy,task_id,error) = 0,"external task " || error)
  canonical = ""; review_id = ""
  errors = errors + check(planagentaction(store,config,profile,task_id,"escalation","","Distinct meanings require connection review","fixture-agent","self-reported-fixture",canonical,error) = 0,"plan escalation " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 0,"planning writes no receipt")
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"escalation",review_id,error) = 0 & applyagentaction(store,config,profile,canonical,digest,"escalation",review_id,error) = 0,"exact escalation and replay " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 1 & scalartext(database,"SELECT required_capability FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "advanced-reasoning","one durable escalation independent of priority")
  evidence = '[{"evidence_id":"mention-external","quote":"Platform"}]'
  successors = '[{"canonical_label":"External Alpha","concept_type":"concept"},{"canonical_label":"External Beta","concept_type":"concept"}]'
  response = responsejson("split","",successors,evidence,"concept-external")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",changestr('"quote":"Platform"',response,'"quote":"Invented"'),"review","fixture-agent","fixture",canonical,error) \= 0,"external forged quote rejected")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"review","fixture-agent","fixture",canonical,error) = 0,"grounded external split plan " || error)
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,copies("0",64),"resolution",review_id,error) \= 0,"tampered external digest rejected")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET updated_epoch=updated_epoch+1 WHERE task_id='" || task_id || "'") = 0,"advance task revision")
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) \= 0 & scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 1,"stale external plan rejected without receipt")
  errors = errors + check(planagentaction(store,config,profile,task_id,"resolution",response,"review","fixture-agent","fixture",canonical,error) = 0,"fresh external split plan " || error)
  digest = rxhash..sha256hex(canonical as .binary)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0,"external proposal submitted " || error)
  errors = errors + check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_agent_actions") = 2,"duplicate proposal is exact no-op")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current,"submission does not change corpus")
  job_id = scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  errors = errors + check(scalartext(database,"SELECT last_error FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "external resolution awaiting review","submission replaces manual marker")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET last_error='manual maintenance mode',required_capability='standard' WHERE task_id='" || task_id || "'") = 0,"simulate legacy manual marker during pending review")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"resume ordinary workers with external review pending " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'") = "review" & scalarint(database,"SELECT count(*) FROM maintenance_task_items WHERE task_id='" || task_id || "'") = 0,"pending external review retains exclusive task ownership")
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"accept grounded external split " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-external'") = "migration-parent" & scalarint(database,"SELECT count(*) FROM maintenance_workflows WHERE origin_task_id='" || task_id || "' AND state='migrating'") = 1,"external split reuses resumable lifecycle")
  errors = errors + check(reviewagentaction(store,review_id,"accept",config,profile,error) \= 0,"repeat acceptance cannot publish twice")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = current+1 & scalarint(database,"SELECT count(*) FROM provider_runs") = calls & scalarint(database,"SELECT count(*) FROM source_revisions") = sources,"one generation with no fabricated provider usage or source rewrite")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"external resolution foreign keys")
  worker_task = ""
  errors = errors + check(enqueuebacklogtask(database,"worker-escalation-test","concept","concept-peer","","",999999,policy,worker_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"dispatch worker assertion test " || error)
  errors = errors + check(runresolution(store,job_id,worker_task,responsejson("escalate"),error) = 0,"worker can assert advanced reasoning " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || worker_task || "' AND state='unresolved' AND required_capability='advanced-reasoning' AND escalation_origin='worker'") = 1,"worker assertion keeps task unresolved and flags resolver")
  do failure_class = 1 to 3
    failure_task = ""; status = -123; if failure_class = 2 then status = -101
    provider = .failureclassprovider(status,failure_class = 1); disposition = ""
    claim_policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    errors = errors + check(enqueuebacklogtask(database,"failure-class-" || failure_class,"concept","concept-peer","","",999999,policy,failure_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"dispatch classified failure " || error)
    errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=1000010 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || failure_task || "') AND state='queued'") = 0,"select classified failure task")
    do attempt = 1 to 2
      errors = errors + check(runworkeronce(store,job_id,"failure-class-fixture",60,3,claim_policy,provider,disposition,error,profile) = 0,"settle classified failure " || error)
      errors = errors + check(sqliteexec(database,"UPDATE job_items SET retry_at=0 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || failure_task || "') AND state='queued'") = 0,"make fixture retry ready without sleeping")
    end
    if failure_class = 1 then errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || failure_task || "' AND semantic_failures=2 AND required_capability='advanced-reasoning' AND state='unresolved'") = 1,"repeated content failures escalate and stop ordinary work")
    else errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || failure_task || "' AND semantic_failures=0 AND required_capability='standard'") = 1,"transport and storage failure status alone is not an intelligence signal")
  end
  return errors

refreshchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  errors=0; error=""; database=store.database(); policy=.jsondocument(policy_json)
  config=architecturelocalconfig(); profile=genericprofile()
  current=scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls=scalarint(database,"SELECT count(*) FROM provider_runs"); sources=scalarint(database,"SELECT count(*) FROM source_revisions")
  errors=errors+check(sqliteexec(database,"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<105) INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) SELECT 'refresh-concept-'||i,'Platform','concept','active'," || current || " FROM n")=0,"seed expanded catalogue")
  errors=errors+check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'refresh-mention-'||concept_id,concept_id,'chunk-lifecycle',0,8," || current || " FROM concepts WHERE concept_id LIKE 'refresh-concept-%'")=0,"seed expanded catalogue evidence")
  task_id=""; canonical=""; successor=""; replay=""
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,task_id,error)=0,"bounded task discovery " || error)
  old_packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id='" || task_id || "'")
  errors=errors+check(pos('"limit_exceeded":true',old_packet)>0,"oversized catalogue records explicit sentinel")
  inventory_sql=backlogindexquery(database,task_id,"catalogue","current")
  count=scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")
  errors=errors+check(count>100,"inventory exposes catalogue beyond worker ceiling")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(old_packet) || ",'$.omitted_catalogue')")=count & pos('"evidence_complete":false',old_packet)>0 & pos('"inventory_tool":"maintain.evidence-index"',old_packet)>0,"packaging hold reports exact omitted candidate count and continuation")
  inventory_sql=backlogindexquery(database,task_id,"passages","current")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")=1 & pos('crexx-rag:',scalartext(database,"SELECT detail FROM (" || inventory_sql || ")"))>0,"inventory exposes citation despite empty packet")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(old_packet) || ",'$.omitted_passages')")=1,"packaging hold reports exact omitted passage count")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET question='Keep this precise follow-up question' WHERE task_id='" || task_id || "'")=0,"preserve custom question fixture")
  rows=scalarint(database,"SELECT count(*) FROM maintenance_tasks")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"Review the complete context","fixture-agent","fixture",canonical,error)=0,"plan complete refresh " || error)
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows,"refresh planning writes nothing")
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,canonical,copies("0",64),successor,error)\=0,"refresh rejects altered digest")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET updated_epoch=updated_epoch+1 WHERE task_id='" || task_id || "'")=0 & applybacklogrefresh(store,config,profile,canonical,digest,successor,error)\=0,"refresh rejects stale task binding")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1024,1000,"small bound","fixture-agent","fixture",canonical,error)\=0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows,"incomplete refresh never persists")
  errors=errors+check(sqliteexec(database,"INSERT INTO reviews(review_id,review_type,subject_id,state,proposal_json,created_at) VALUES('refresh-blocked-review','maintenance-external','" || task_id || "','pending','{}','fixture')")=0,"pending review fixture")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"review","fixture-agent","fixture",canonical,error)\=0 & pos('pending review',error)>0,"pending review blocks refresh")
  errors=errors+check(sqliteexec(database,"UPDATE reviews SET state='rejected' WHERE review_id='refresh-blocked-review'; UPDATE maintenance_tasks SET state='dispatched' WHERE task_id='" || task_id || "'")=0,"worker ownership fixture")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"review","fixture-agent","fixture",canonical,error)\=0,"running task blocks refresh")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='unresolved' WHERE task_id='" || task_id || "'")=0,"release fixture ownership")
  errors=errors+check(planbacklogrefresh(store,config,profile,task_id,1048576,1000,"Review the complete context","fixture-agent","fixture",canonical,error)=0,"re-plan complete refresh " || error)
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,canonical,digest,successor,error)=0 & applybacklogrefresh(store,config,profile,canonical,digest,replay,error)=0 & successor=replay,"exact refresh and replay " || error)
  altered=changestr('"complete":true',canonical,'"complete":false'); altered_digest=rxhash..sha256hex(altered as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,altered,altered_digest,replay,error)\=0,"replay rejects altered complete plan even with matching digest")
  altered=changestr('"passages":1',canonical,'"passages":2'); altered_digest=rxhash..sha256hex(altered as .binary)
  errors=errors+check(applybacklogrefresh(store,config,profile,altered,altered_digest,replay,error)\=0,"replay rejects altered counts")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks")=rows+1 & scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id='" || task_id || "'")=old_packet,"one successor and immutable prior evidence")
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'")="superseded" & scalartext(database,"SELECT question||':'||priority||':'||parent_task_id||':'||required_capability FROM maintenance_tasks WHERE task_id='" || successor || "'")="Keep this precise follow-up question:12345:" || task_id || ":advanced-reasoning","preserve question priority lineage and external ownership")
  inventory_sql=backlogindexquery(database,successor,"catalogue","stored")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ")")=count,"stored inventory retains complete catalogue")
  note_task=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE subject_type='note' ORDER BY created_epoch LIMIT 1")
  inventory_sql=backlogindexquery(database,note_task,"context","stored")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM (" || inventory_sql || ") WHERE id='$.subject.text'")=1,"stored note diagnostic remains inspectable")
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,replay,error)=0 & replay=successor,"census retains refreshed successor")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current,"refresh does not change corpus generation")
  response=responsejson("retain","","[]",'[{"evidence_id":"refresh-mention-refresh-concept-1","quote":"Platform"}]')
  errors=errors+check(planagentaction(store,config,profile,successor,"resolution",response,"review","fixture-agent","fixture",canonical,error)=0,"resolve refreshed packet using stored envelope " || error)
  digest=rxhash..sha256hex(canonical as .binary); review_id=""
  errors=errors+check(applyagentaction(store,config,profile,canonical,digest,"resolution",review_id,error)=0 & reviewagentaction(store,review_id,"accept",config,profile,error)=0,"review accepts refreshed evidence " || error)
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-1","","",12345,policy,replay,error)=0 & replay=successor,"resolved refresh is not replaced by an oversized sentinel")
  /* A byte-limited packet also has a usable inventory and changes identity when
   * evidence beyond the original cutoff changes. No source bytes are edited. */
  errors=errors+check(sqliteexec(database,"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<500) INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) SELECT 'refresh-extra-'||i,'refresh-concept-2','chunk-lifecycle',0,8," || current || " FROM n")=0,"seed oversized passage collection")
  byte_task=""
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-2","","",12345,policy,byte_task,error)=0,"byte limited task")
  byte_packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(byte_task))
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(byte_packet) || ",'$.omitted_passages')")=501 & pos('"evidence_complete":false',byte_packet)>0,"byte-limit hold counts every omitted source passage")
  errors=errors+check(planbacklogrefresh(store,config,profile,byte_task,1048576,1000,"full passages","fixture-agent","fixture",canonical,error)=0 & pos('"passages":501',canonical)>0,"complete byte refresh plan " || error)
  digest=rxhash..sha256hex(canonical as .binary)
  errors=errors+check(sqliteexec(database,"UPDATE mentions SET span_end=7 WHERE mention_id='refresh-extra-99'")=0 & applybacklogrefresh(store,config,profile,canonical,digest,replay,error)\=0,"changed evidence invalidates refresh apply")
  errors=errors+check(enqueuebacklogtask(database,"external-refresh","concept","refresh-concept-2","","",12345,policy,replay,error)=0 & replay\=byte_task,"sentinel fingerprints evidence beyond cutoff")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=current+1 & scalarint(database,"SELECT count(*) FROM provider_runs")=calls & scalarint(database,"SELECT count(*) FROM source_revisions")=sources,"only accepted resolution changes generation; source and provider receipts preserved")
  return errors

/* Saved-run reproduction: a quoted name occurs before and at the selected
 * UTF-8 span. Validation must bind the selected occurrence, not the first. */
selectedquotationchecks: procedure = .int
  arg database=.binary,task_id=.string
  errors=0; error=""; grounds=""
  original=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(task_id))
  generation=scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  calls=scalarint(database,"SELECT count(*) FROM provider_runs")
  body="Écosse: Dundee left. At Dundee, Mary waited. Dundee."
  do selected=1 to 2
    begin=9; if selected=2 then begin=25
    packet='{"subject":{"type":"concept","id":"concept-parent"},"passages":[{"evidence_id":"scope-evidence","revision_chunk_id":"chunk-lifecycle","text":' || jsonquote(body) || ',"span_start":' || begin || ',"span_end":' || (begin+6) || ',"text_offset":100}]}'
    errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET evidence_json=" || _testquote(packet) || " WHERE task_id=" || _testquote(task_id))=0,"selected quote fixture")
    result=validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"Dundee"}]'),grounds,error)
    errors=errors+check(result=0,"selected repeated quotation " || selected || " " || error)
    if result=0 then errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_start')")=begin+100 & scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_end')")=begin+106,"selected occurrence retains original byte offsets")
  end
  result=validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"At Dundee, Mary waited."}]'),grounds,error)
  errors=errors+check(result=0 & scalarint(database,"SELECT json_extract(" || _testquote(grounds) || ",'$[0].span_start')")=122,"quotation may start before and extend after selected span " || error)
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"Dundee left."}]'),grounds,error)<>0,"quote elsewhere cannot support selected occurrence")
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("retain","","[]",'[{"evidence_id":"scope-evidence","quote":"At Glasgow, Mary waited."}]'),grounds,error)<>0,"invented selected quotation remains rejected")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET evidence_json=" || _testquote(original) || " WHERE task_id=" || _testquote(task_id))=0,"restore independent task fixture")
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=generation & scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"quotation validation makes no publication or provider call")
  return errors

responsejson: procedure = .string
  arg action = .string, target = "", successors = "[]", evidence = "[]", object_id = "", question = "", qualifiers = "{}", effective_from = "", effective_to = ""
  return '{"action":' || jsonquote(action) || ',"object_id":' || jsonquote(object_id) || ',"target_concept_id":' || jsonquote(target) || ',"canonical_label":"","concept_type":"","successors":' || successors || ',"reason":"fixture evidence-based decision","evidence":' || evidence || ',"effective_from":' || jsonquote(effective_from) || ',"effective_to":' || jsonquote(effective_to) || ',"qualifiers_json":' || jsonquote(qualifiers) || ',"question":' || jsonquote(question) || '}'

withdispositions: procedure = .string
  arg response=.string,dispositions=.string
  return left(response,length(response)-1) || ',"dispositions":' || dispositions || '}'

aliascoalescencechecks: procedure = .int
  arg store=.ragstorehandle,raw=.string
  database=store.database();policy=.jsondocument(raw);errors=0;error="";current=scalarint(database,"SELECT published_generation FROM library_meta")
  errors=errors+check(sqliteexec(database,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-coalesce','revision-lifecycle',999,0,13,'content-lifecycle','coalesce-fixture','fixture-v1','direct'," || current || ")")=0,"seed isolated alias-coalescence chunk")
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_tasks(task_id,kind,subject_type,subject_id,evidence_fingerprint,policy_fingerprint,evidence_json,question,state,priority,created_epoch,updated_epoch) VALUES('legacy-followup-a','alias-follow-up:issue-a','chunk','chunk-coalesce','legacy-a','fixture','{}','old issue a','pending',920000,1,1),('legacy-followup-b','alias-follow-up:issue-b','chunk','chunk-coalesce','legacy-b','fixture','{}','old issue b','pending',920000,1,1)")=0,"seed older per-issue pending follow-ups")
  do i=1 to 3
    candidate="coalesce-candidate-" || i;decision="coalesce-decision-" || i
    begin=0;finish=8;if i=2 then do;begin=9;finish=13;end
    evidence='{"resolved_concept_id":"concept-peer","generation":' || current || '}'
    errors=errors+check(sqliteexec(database,"INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES(" || _testquote(candidate) || ",'chunk-coalesce','platform'," || begin || "," || finish || ",'fixture'," || current || "); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES(" || _testquote(decision) || "," || _testquote(candidate) || ",1,'accepted'," || _testquote(evidence) || ",'fixture','fixture')")=0,"seed settled alias context " || i)
    task=""
    errors=errors+check(enqueuebacklogtask(database,"alias-follow-up:chunk","chunk","chunk-coalesce","","",920000,policy,task,error)=0 & task<>"","coalesced follow-up sees settled alias context " || i || " " || error)
  end
  first_task=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-coalesce' AND json_array_length(evidence_json,'$.subject.alias_context')=1")
  second_task=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-coalesce' AND json_array_length(evidence_json,'$.subject.alias_context')=2")
  third_task=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-coalesce' AND json_array_length(evidence_json,'$.subject.alias_context')=3")
  errors=errors+check(first_task<>second_task & second_task<>third_task & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-coalesce' AND state='pending'")=1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-coalesce' AND state='superseded'")=2,"several settled changes coalesce into one combined pending extraction")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id IN('legacy-followup-a','legacy-followup-b') AND state='superseded'")=2,"older per-issue pending follow-ups are replaced by the combined chunk question")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks t,json_each(t.evidence_json,'$.subject.alias_context') c WHERE t.task_id=" || _testquote(third_task) || " AND json_extract(c.value,'$.candidate_id') LIKE 'coalesce-candidate-%'")=3,"combined follow-up exposes every settled identity delta")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='resolved' WHERE task_id=" || _testquote(third_task))=0,"mark combined extraction complete for later-change control")
  later="";more='{"resolved_concept_id":"concept-parent","generation":' || current || '}'
  errors=errors+check(sqliteexec(database,"INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('coalesce-decision-later','coalesce-candidate-3',2,'accepted'," || _testquote(more) || ",'fixture','fixture')")=0 & enqueuebacklogtask(database,"alias-follow-up:chunk","chunk","chunk-coalesce","","",920000,policy,later,error)=0 & later<>third_task & scalartext(database,"SELECT parent_task_id FROM maintenance_tasks WHERE task_id=" || _testquote(later))=third_task,"later material identity change produces one linked successor " || error)
  return errors

invalidretirementchecks: procedure = .int
  arg store=.ragstorehandle,raw=.string
  database=store.database();errors=0;error="";current=scalarint(database,"SELECT published_generation FROM library_meta")
  policy=.jsondocument(raw);config=architecturelocalconfig();profile=genericprofile()
  errors=errors+check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('invalid-marker','Fixture page marker','concept','active'," || current || "),('valid-same-label','Fixture page marker','concept','active'," || current || "); INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('invalid-marker',1,'Fixture page marker','concept','active'," || current || ",'fixture','fixture'); INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,visible_from_generation) VALUES('invalid-marker-alias','fixture-page-marker','invalid-marker'," || current || "); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('invalid-marker-mention','invalid-marker','chunk-lifecycle',0,8," || current || "); INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('invalid-marker-claim','invalid-marker','related-to','valid-same-label','outbound','{}','fixture'," || current || "); INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) VALUES('invalid-marker-support','invalid-marker-claim','chunk-lifecycle',0,8,'support','assertion','direct','','fixture','fixture'," || current || "); INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('invalid-marker-candidate','chunk-lifecycle','platform',0,8,'fixture'," || current || "); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('invalid-marker-candidate-accepted','invalid-marker-candidate',1,'accepted','{}','fixture','fixture')")=0,"seed invalid node, owned incident claim, source-bound candidate and same-label isolate")
  duplicate_label="";duplicate_id=""
  errors=errors+check(resolveknownconcept(database,"Fixture page marker","concept",duplicate_label,duplicate_id,error)=2 & duplicate_id="","same-label distinct active concepts never resolve by label alone")
  task="";errors=errors+check(enqueuebacklogtask(database,"invalid-review","concept","invalid-marker","","",900000,policy,task,error)=0 & task<>"","queue invalid-node review " || error)
  refresh="";successor=""
  errors=errors+check(planbacklogrefresh(store,config,profile,task,8388608,1000,"inspect complete invalid-node impact","fixture","fixture",refresh,error)=0,"plan complete impact packet after 100-entry catalogue hold " || error)
  if refresh<>"" then errors=errors+check(applybacklogrefresh(store,config,profile,refresh,rxhash..sha256hex(refresh as .binary),successor,error)=0 & successor<>"","refresh held concept task without clearing history " || error)
  if successor<>"" then task=successor
  dispositions='[{"object_type":"alias","object_id":"invalid-marker-alias","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"reviewed page marker alias"},{"object_type":"mention","object_id":"invalid-marker-mention","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"reviewed page marker mention"},{"object_type":"claim","object_id":"invalid-marker-claim","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"reviewed unsupported incident claim"}]'
  response=responsejson("retire","","[]","[]","invalid-marker")
  response=left(response,length(response)-1) || ',"dispositions":' || dispositions || '}'
  grounds="";negative=changestr('"object_id":"invalid-marker-alias"',response,'"object_id":"absent-alias"')
  errors=errors+check(validatebacklogresponse(database,task,negative,grounds,error)<>0 & pos("exactly once",error)>0,"stale or unrelated retirement disposition is blocked before review")
  grounds="";negative=changestr(',{"object_type":"claim","object_id":"invalid-marker-claim","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"reviewed unsupported incident claim"}',response,'')
  errors=errors+check(validatebacklogresponse(database,task,negative,grounds,error)<>0,"retirement cannot omit an incident claim from reviewed impact")
  canonical="";review=""
  errors=errors+check(planagentaction(store,config,profile,task,"resolution",response,"review source-only page marker","fixture","fixture",canonical,error)=0,"plan bounded invalid-node retirement with exact owned impact " || error)
  if canonical<>"" then errors=errors+check(applyagentaction(store,config,profile,canonical,rxhash..sha256hex(canonical as .binary),"resolution",review,error)=0 & review<>"","submit invalid-node retirement for mandatory review " || error)
  if review<>"" then errors=errors+check(reviewagentaction(store,review,"accept",config,profile,error)=0,"accept reviewed invalid-node retirement " || error)
  errors=errors+check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='invalid-marker'")="retired" & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='valid-same-label'")="active" & scalarint(database,"SELECT count(*) FROM aliases WHERE alias_id='invalid-marker-alias' AND visible_to_generation IS NOT NULL")=1 & scalarint(database,"SELECT count(*) FROM mentions WHERE mention_id='invalid-marker-mention' AND visible_to_generation IS NOT NULL")=1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='invalid-marker-claim' AND visible_to_generation IS NOT NULL")=1 & scalarint(database,"SELECT count(*) FROM claim_support WHERE support_id='invalid-marker-support' AND visible_to_generation IS NOT NULL")=1 & scalartext(database,"SELECT state FROM candidate_decisions WHERE candidate_id='invalid-marker-candidate' ORDER BY decision_version DESC LIMIT 1")="rejected" & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'")="Platform Peer","retirement rejects the exact candidate, removes incident claim and preserves source and same-label isolate")
  replay_label="";replay_type="";replay_concept=""
  errors=errors+check(resolveknownmention(database,"invalid-marker-candidate",replay_label,replay_type,replay_concept,error)=0 & replay_concept="","unchanged source candidate cannot recreate the reviewed invalid marker")
  return errors

lifecyclerecordingchecks: procedure = .int
  arg store = .ragstorehandle, policy_json = .string
  database = store.database(); errors = 0; error = ""; job_id = ""; task_id = ""; repeated = ""
  policy = .jsondocument(policy_json); config = architecturelocalconfig(); profile = genericprofile()
  current = scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('recording-parent','Platform recording','concept','active'," || current || ")") = 0,"ESC-OPS-03 seed concept")
  errors = errors + check(sqliteexec(database,"INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('recording-parent',1,'Platform recording','concept','active'," || current || ",'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0,"ESC-OPS-03 seed version")
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('recording-mention','recording-parent','chunk-lifecycle',0,8," || current || ")") = 0,"ESC-OPS-03 seed source connection")
  errors = errors + check(enqueuebacklogtask(database,"recording-type","concept","recording-parent","","",1000000,policy,task_id,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"ESC-OPS-03 dispatch real correction " || error)
  response = changestr('"concept_type":""',responsejson("type-correction","","[]",'[{"evidence_id":"recording-mention","quote":"Platform"}]',"recording-parent"),'"concept_type":"evidence-span"')
  errors = errors + check(runresolution(store,job_id,task_id,response,error) = 0,"ESC-OPS-03 real correction control " || error)
  errors = errors + check(scalartext(database,"SELECT concept_type FROM concepts WHERE concept_id='recording-parent'") = "evidence-span" & scalarint(database,"SELECT count(*) FROM concept_versions WHERE concept_id='recording-parent'") = 2,"ESC-OPS-03 real correction publishes exactly one version")
  errors = errors + check(enqueuebacklogtask(database,"recording-type","concept","recording-parent","","",1000000,policy,repeated,error) = 0 & repeated = task_id,"ESC-OPS-03 own successful correction remains settled")
  /* The repeated-correction defect still needs a genuinely new question.
   * Own publication alone no longer reopens an assessed context. */
  errors = errors + check(sqliteexec(database,"INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('recording-new-evidence','recording-parent','chunk-lifecycle',9,13," || current || ")") = 0,"ESC-OPS-03 changed source context for repeated correction")
  errors = errors + check(enqueuebacklogtask(database,"recording-type","concept","recording-parent","","",1000000,policy,repeated,error) = 0 & repeated <> task_id,"ESC-OPS-03 new question after changed fingerprint " || error)
  current = scalarint(database,"SELECT published_generation FROM library_meta")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs")
  usage = scalarint(database,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs")
  grounds = ""; canonical = ""; review_id = ""
  errors = errors + check(validatebacklogresponse(database,repeated,response,grounds,error) <> 0 & pos("no-change",error)>0,"ESC-OPS-03 reject unchanged type before recording with supported conclusion")
  errors = errors + check(planagentaction(store,config,profile,repeated,"resolution",response,"repeated correction","fixture","fixture",canonical,error) <> 0,"ESC-OPS-03 external proposal uses same rejection")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET state='skipped' WHERE job_id='" || job_id || "' AND state='queued'") = 0,"ESC-OPS-03 finish unrelated census batch before next question")
  status = runresolution(store,job_id,repeated,response,error)
  say "ESC_OPS_03_REPEATED=" || error
  errors = errors + check(status <> 0 & pos("no-change",error)>0 & pos("cannot record",error)=0,"ESC-OPS-03 worker rejects invalid correction before SQL")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta") = current & scalarint(database,"SELECT count(*) FROM concept_versions WHERE concept_id='recording-parent'") = 2 & scalarint(database,"SELECT count(*) FROM maintenance_items WHERE subject_id='recording-parent'") = 1 & scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || repeated || "'") = 0,"ESC-OPS-03 rejection preserves generation lifecycle and decisions")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = calls+1 & scalarint(database,"SELECT coalesce(sum(input_tokens+output_tokens),0) FROM provider_runs") = usage+20 & scalarint(database,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m ON m.item_id=a.item_id WHERE m.task_id='" || repeated || "' AND a.provider_run_id IS NOT NULL") = 1,"ESC-OPS-03 rejected worker retains receipt and usage")
  /* Confirm the precise historical recording constraint without modifying the
   * existing immutable action, then settle through the supported review path. */
  status = sqliteexec(database,"INSERT INTO maintenance_items SELECT 'recording-duplicate',run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,dependency_item_id,expected_generation,applied_generation,created_at,updated_at FROM maintenance_items WHERE item_id='maintenance-action:" || task_id || "'")
  detail = sqliteerrordetail()
  say "ESC_OPS_03_CONSTRAINT=" || detail
  errors = errors + check(status <> 0 & pos("UNIQUE constraint failed: maintenance_items.run_id",detail)>0,"ESC-OPS-03 exact recording constraint reproduced")
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0 & tickbacklogwindow(store,job_id,error) >= 0,"ESC-OPS-03 close window and reconcile rejected worker before external conclusion " || error)
  errors = errors + check(planagentaction(store,config,profile,repeated,"resolution",responsejson("no-change"),"current type is already correct","fixture","fixture",canonical,error) = 0,"ESC-OPS-03 supported final conclusion " || error)
  errors = errors + check(applyagentaction(store,config,profile,canonical,rxhash..sha256hex(canonical as .binary),"resolution",review_id,error) = 0 & reviewagentaction(store,review_id,"accept",config,profile,error) = 0,"ESC-OPS-03 settle rejected task through review " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || repeated || "'") = "resolved" & scalarint(database,"SELECT published_generation FROM library_meta") = current & scalartext(database,"SELECT normalized_utf8 FROM source_revision_texts WHERE text_id='text-lifecycle'") = "Platform Peer" & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"ESC-OPS-03 conclusion preserves source and generation")
  /* Notes select from their evidence catalogue, including the existing stored
   * next_action fallback when the response leaves object_id empty. */
  note_task = ""
  errors = errors + check(sqliteexec(database,"UPDATE analysis_notes SET next_action='{" || '"concept_id":"concept-parent"' || "}' WHERE note_id='note-parent'") = 0 & enqueuebacklogtask(database,"recording-note","note","note-parent","","",1000000,policy,note_task,error) = 0,"ESC-OPS-03 note subject fixture " || error)
  note_response = changestr('"concept_type":""',responsejson("type-correction","","[]",'[{"evidence_id":"link-parent","quote":"Platform"}]'), '"concept_type":"evidence-span"')
  errors = errors + check(validatebacklogresponse(database,note_task,note_response,grounds,error) = 0,"ESC-OPS-03 valid note-selected correction " || error)
  errors = errors + check(validatebacklogresponse(database,note_task,changestr('"concept_type":"evidence-span"',note_response,'"concept_type":"concept"'),grounds,error) <> 0 & pos("no-change",error)>0,"ESC-OPS-03 note-selected unchanged type rejected")
  errors = errors + check(validatebacklogresponse(database,note_task,changestr('"object_id":""',note_response,'"object_id":"absent-concept"'),grounds,error) <> 0 & pos("outside its evidence catalogue",error)>0,"ESC-OPS-03 note cannot select an unrelated concept")
  return errors

runresolution: procedure = .int
  arg store = .ragstorehandle, job_id = .string, task_id = .string, response = .string, expose error = .string
  database = store.database()
  if tickbacklogwindow(store,job_id,error) < 0 then return -1
  /* The fixture explicitly selects the question being exercised. */
  if sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || task_id || "') AND state='queued'") \= 0 then return -1
  provider = .fixtureprovider(response); disposition = ""
  policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
  status = runworkeronce(store,job_id,"backlog-fixture",60,3,policy,provider,disposition,error,genericprofile())
  if status = 0 & disposition \= "resolution-recorded" & disposition \= "resolution-stale" then do
    error = disposition || " " || scalartext(database,"SELECT message FROM job_events WHERE job_id=" || _testquote(job_id) || " AND event_type='dead_letter' ORDER BY event_id DESC LIMIT 1")
    return -1
  end
  return status

nextwindow: procedure = .int
  arg store = .ragstorehandle, policy_json = .string, expose job_id = .string, expose error = .string
  if job_id \= "" & scalarint(store.database(),"SELECT count(*) FROM maintenance_windows WHERE job_id='" || job_id || "' AND state='active'") = 1 then do
    if pausejob(store,job_id,error) \= 0 | tickbacklogwindow(store,job_id,error) < 0 then return -1
  end
  database = store.database(); generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  texts = .string[]; scores = .int[]
  census = .ragmaintenancecensus(generation,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  digest = rxhash..sha256hex((scalarint(database,"SELECT count(*) FROM maintenance_windows") || "fixture-next-window") as .binary)
  run_id = ""; items = 0
  return startbacklogwindow(store,census,"snapshot-lifecycle",digest,policy_json,run_id,job_id,items,error)

connectiontask: procedure = .string
  arg database = .binary, workflow = .string, kind = .string
  return scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='" || kind || "' AND state='dispatched' ORDER BY updated_epoch DESC,task_id LIMIT 1")

timingchecks: procedure = .int
  arg database = .binary
  errors = 0; error = ""; timing = ""
  starts = .string[]
  starts[1] = "2026-09-07T21:00:00Z"; starts[2] = "2026-09-07T23:30:00Z"; starts[3] = "2026-09-08T04:30:00Z"
  do i = 1 to starts.0
    now = scalarint(database,"SELECT unixepoch('" || starts[i] || "')")
    errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0,"resolve overnight " || error)
    errors = errors + check(pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0 & pos('"skipped":0',timing) > 0,"same closing morning before and after midnight")
  end
  now = scalarint(database,"SELECT unixepoch('2026-09-08T05:05:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"late overnight launch skips instead of adding a day")
  now = scalarint(database,"SELECT unixepoch('2026-09-08T05:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"closing boundary is exclusive")
  now = scalarint(database,"SELECT unixepoch('2026-03-28T22:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-03-29T05:00:00Z"',timing) > 0,"spring clock change preserves six local")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-01:30",7200,timing,error,now) < 0,"reject nonexistent spring closing time")
  now = scalarint(database,"SELECT unixepoch('2026-10-24T21:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-10-25T06:00:00Z"',timing) > 0,"autumn clock change preserves six local")
  now = scalarint(database,"SELECT unixepoch('2026-09-08T00:00:00Z')")
  errors = errors + check(resolvemaintenancetime(database,"120","","",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-09-08T02:00:00Z"',timing) > 0,"duration counts elapsed time")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-08T06:00:00+01:00","",7200,timing,error,now) = 0 & pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0,"explicit offset deadline")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-08T06:00:00+01:00","",0,timing,error,now,1) = 0 & pos('"mode":"until"',timing) > 0 & pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0,"explicit until overrides unlimited default")
  errors = errors + check(resolvemaintenancetime(database,"","","18:00-06:00",0,timing,error,now,1) = 0 & pos('"mode":"overnight"',timing) > 0 & pos('"deadline_utc":"2026-09-08T05:00:00Z"',timing) > 0,"explicit overnight overrides unlimited default")
  errors = errors + check(resolvemaintenancetime(database,"15","","",0,timing,error,now,1) = 0 & pos('"deadline_utc":"2026-09-08T00:15:00Z"',timing) > 0,"explicit finite minutes override unlimited default")
  errors = errors + check(resolvemaintenancetime(database,"0","","",7200,timing,error,now,1) = 0 & pos('"deadline_epoch":0',timing) > 0,"explicit zero opts into unlimited time")
  errors = errors + check(resolvemaintenancetime(database,"","","",0,timing,error,now,0) < 0,"legacy zero default remains invalid")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-07T06:00:00Z","",7200,timing,error,now) = 0 & pos('"skipped":1',timing) > 0,"past exact deadline skips")
  errors = errors + check(resolvemaintenancetime(database,"120","","18:00-06:00",7200,timing,error,now) < 0,"reject competing timing controls")
  errors = errors + check(resolvemaintenancetime(database,"0","2026-09-08T06:00:00Z","",0,timing,error,now,1) < 0,"reject competing unlimited and finite selectors")
  errors = errors + check(resolvemaintenancetime(database,"0","","",7200,timing,error,now) < 0 & resolvemaintenancetime(database,"999999999999999999999","","",7200,timing,error,now) < 0,"reject invalid duration safely")
  errors = errors + check(resolvemaintenancetime(database,"","2026-02-30T06:00:00Z","",7200,timing,error,now) < 0,"reject impossible date")
  errors = errors + check(resolvemaintenancetime(database,"","2026-02-30T06:00:00Z","",0,timing,error,now,1) < 0,"reject impossible date under unlimited default")
  errors = errors + check(resolvemaintenancetime(database,"","2026-09-09T06:00:00","",7200,timing,error,now) < 0,"exact deadline requires timezone offset")
  errors = errors + check(resolvemaintenancetime(database,"","","06:00-18:00",7200,timing,error,now) < 0 & resolvemaintenancetime(database,"","","25:00-06:00",7200,timing,error,now) < 0,"reject invalid overnight window")
  return errors

escalationroutechecks: procedure = .int
  arg store = .ragstorehandle, base = .string
  database = store.database(); errors = 0; error = ""
  job_id = scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  if job_id<>"" then errors=errors+check(pausejob(store,job_id,error)=0 & tickbacklogwindow(store,job_id,error)>=0,"drain preceding fixture window")
  /* The preceding scale/recovery cases deliberately leave unfinished work.
   * Hold that unrelated fixture work using the real waiver state, so this
   * handoff has a deterministic single-question call ledger. */
  errors=errors+check(sqliteexec(database,"INSERT INTO maintenance_task_waivers(waiver_id,task_id,reason,state,created_epoch) SELECT 'route-fixture-hold:'||task_id,task_id,'Isolate subsequent route fixture','active',unixepoch() FROM maintenance_tasks t WHERE state IN('pending','unresolved','failed','review') AND NOT EXISTS(SELECT 1 FROM maintenance_task_waivers w WHERE w.task_id=t.task_id AND w.state='active') AND NOT EXISTS(SELECT 1 FROM reviews r WHERE r.subject_id=t.task_id AND r.state='pending')")=0,"waive unrelated unfinished fixture questions")
  raw = changestr('"knowledge_policy":"fixture-v1"',base,'"knowledge_policy":"route-fixture"')
  raw = changestr('"batch_items":100',raw,'"batch_items":1')
  raw = changestr("retain investigate",raw,"retain investigate no-change defer")
  advanced = '{"role":"advanced-resolver","provider_id":"fixture","model":"advanced-fixture","charging_basis":"local-compute","input_tokens":100000,"output_tokens":10000,"cost_microunits":0,"time_ms":1000,"resolution_prompt":"Conclude from evidence or record final no-change."}'
  raw = left(raw,length(raw)-1) || ',"advanced_route":' || advanced || ',"advanced_attempts":4,"search_reads":2,"evidence_expected":1,"source_id":"source-lifecycle"}'
  policy = .jsondocument(raw); ordinary = ""; advanced_task = ""; deferred = ""
  errors = errors + check(enqueuebacklogtask(database,"route-ordinary","chunk","chunk-lifecycle","","",1000000,policy,ordinary,error)=0,"ordinary route fixture")
  errors = errors + check(enqueuebacklogtask(database,"route-advanced","chunk","chunk-lifecycle","","",1,policy,advanced_task,error)=0,"advanced route fixture")
  errors = errors + check(enqueuebacklogtask(database,"route-deferred","chunk","chunk-lifecycle","","",1000000,policy,deferred,error)=0,"deferred route fixture")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning',state='unresolved' WHERE task_id IN('" || advanced_task || "','" || deferred || "')")=0,"legacy escalation fixture")
  due = scalarint(database,"SELECT unixepoch('now','+6 months')")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET not_before_epoch=" || due || " WHERE task_id='" || deferred || "'")=0,"six month earliest date")
  config = architecturelocalconfig(); access = .string[]; access[1] = "control"; positionals = .string[]
  command_options = .ragcommandoption[]
  command_options[1] = .ragcommandoption("id",deferred,0)
  command_options[2] = .ragcommandoption("until",scalartext(database,"SELECT strftime('%Y-%m-%dT%H:%M:%SZ'," || due || ",'unixepoch')"),0)
  command_options[3] = .ragcommandoption("reason","Await the scheduled archive release",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",access,"maintain","defer","maintain.defer",command_options,positionals)
  deferred_result = dispatchproduct(request,operatorregistry())
  errors = errors + check(deferred_result.exit_code()=0,"public dated task deferral " || deferred_result.message())
  first_page=backlogselection(database,policy,0,1,""); next_page=backlogselection(database,policy,1,1,"")
  errors=errors+check(scalarint(database,"SELECT json_array_length(" || _testquote(first_page) || ",'$.eligible')")=1 & scalartext(database,"SELECT json_extract(" || _testquote(first_page) || ",'$.next_cursor')")="1","queue supplies a bounded next page")
  errors=errors+check(scalartext(database,"SELECT json_extract(" || _testquote(first_page) || ",'$.eligible[0].task_id')")=advanced_task & scalartext(database,"SELECT json_extract(" || _testquote(next_page) || ",'$.eligible[0].task_id')")<>advanced_task,"queue pagination does not repeat the first eligible task")
  unbound_policy=scalartext(database,"SELECT json_remove(" || _testquote(raw) || ",'$.advanced_route')")
  unbound_queue=backlogselection(database,.jsondocument(unbound_policy),0,98,"")
  errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(unbound_queue) || ",'$.counts.missing_advanced_binding')")>=2 & scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(unbound_queue) || ",'$.eligible') WHERE json_extract(value,'$.required_capability')='advanced-reasoning'")=0,"missing advanced binding is visible and never falls back")
  calls = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(nextwindow(store,raw,job_id,error)=0,"mixed maintenance window " || error)
  selected = scalartext(database,"SELECT m.task_id FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE i.job_id='" || job_id || "' AND i.state='queued' ORDER BY i.priority DESC,i.item_id LIMIT 1")
  errors = errors + check(selected=advanced_task,"due advanced precedes higher-priority ordinary work")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND json_extract(input_json,'$.model')='advanced-fixture' AND json_extract(input_json,'$.role')='advanced-resolver' AND json_extract(input_json,'$.resolution_prompt')='Conclude from evidence or record final no-change.'")=1,"advanced prompt and model frozen together")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_task_items WHERE task_id='" || deferred || "'")=0 & scalarint(database,"SELECT not_before_epoch FROM maintenance_tasks WHERE task_id='" || deferred || "'")=due,"future escalation stays deferred")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"selection consumes no provider call")
  queue_access = .string[]; queue_access[1] = "read"; queue_options = .ragcommandoption[]
  queue_options[1] = .ragcommandoption("job",job_id,0); queue_options[2] = .ragcommandoption("limit","1",0)
  request = .ragcommandrequest(store.path(),config.config_id(),"generic-profile","","json","off",queue_access,"maintain","queue","maintain.queue",queue_options,positionals)
  queue_result = dispatchproduct(request,operatorregistry()); queue_json = ""; queue_error = ""
  errors = errors + check(queue_result.exit_code()=0 & rendercommandresult(queue_result,"json",queue_json,queue_error)=0 & pos("advanced-fixture",queue_json)>0,"inspectable frozen route and prioritised queue " || queue_result.message())
  rpc='{"jsonrpc":"2.0","id":301,"method":"tools/call","params":{"name":"rag_maintenance_queue","arguments":{"job":' || jsonquote(job_id) || ',"limit":1}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","read")
  errors=errors+check(pos('"isError":false',rpc_result)>0 & pos("advanced-fixture",rpc_result)>0,"MCP shares frozen queue route")
  rpc='{"jsonrpc":"2.0","id":302,"method":"tools/call","params":{"name":"rag_task_defer","arguments":{"id":' || jsonquote(deferred) || ',"until":' || jsonquote(scalartext(database,"SELECT strftime('%Y-%m-%dT%H:%M:%SZ'," || due || ",'unixepoch')")) || ',"reason":"Await the scheduled archive release"}}}'
  rpc_result=mcpdispatch(rpc,store.path(),config.config_id(),"generic-profile","control")
  errors=errors+check(pos('"isError":false',rpc_result)>0 & scalarint(database,"SELECT not_before_epoch FROM maintenance_tasks WHERE task_id='" || deferred || "'")=due,"MCP shares exact UTC deferral without shortening it")
  if selected <> advanced_task then return errors
  current = scalarint(database,"SELECT published_generation FROM library_meta")
  status = runresolution(store,job_id,advanced_task,responsejson("no-change"),error)
  errors = errors + check(status=0,"advanced final no-change is accepted " || error)
  if status <> 0 then return errors
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || advanced_task || "'")="resolved","final no-change closes task")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta")=current,"final no-change invents no graph publication")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs")=calls+1,"final decision retains exactly one charged call")
  mixed_job=job_id
  errors = errors + searchhandoffchecks(store,raw,job_id,ordinary)
  errors=errors+check(scalarint(database,"SELECT count(DISTINCT json_extract(i.input_json,'$.required_capability')) FROM maintenance_decisions d JOIN job_items i ON i.item_id=d.item_id WHERE i.job_id='" || mixed_job || "'")=2,"one maintenance job processes ordinary and advanced reasoning")
  extract_task=""
  errors=errors+check(enqueuebacklogtask(database,"explicit-advanced-extraction","chunk","chunk-lifecycle","","",1000000,policy,extract_task,error)=0,"explicit extraction fixture")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning' WHERE task_id='" || extract_task || "'")=0,"advanced extraction handoff")
  errors=errors+check(nextwindow(store,raw,job_id,error)=0,"advanced extraction window")
  extraction_decision=responsejson("extract")
  grounds=""
  errors=errors+check(validatebacklogresponse(database,extract_task,extraction_decision,grounds,error)=0,"legacy extract without dispositions " || error)
  errors=errors+check(validatebacklogresponse(database,extract_task,withdispositions(extraction_decision,"[]"),grounds,error)=0,"strict extract with empty dispositions " || error)
  nonempty='[{"object_type":"alias","object_id":"synthetic-alias","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"synthetic impact"}]'
  errors=errors+check(validatebacklogresponse(database,extract_task,withdispositions(extraction_decision,nonempty),grounds,error)<>0 & pos("nonempty impact dispositions",error)>0,"extract cannot mutate lifecycle impact")
  status=runresolution(store,job_id,extract_task,responsejson("extract"),error)
  errors=errors+check(status=0,"advanced resolver explicitly selects extraction " || error)
  if status=0 then do
    errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"selected extraction dispatch")
    errors=errors+check(scalarint(database,"SELECT count(*) FROM job_items i JOIN maintenance_task_items m ON m.item_id=i.item_id WHERE m.task_id='" || extract_task || "' AND i.state='queued' AND i.item_type='improve-extraction' AND json_extract(i.input_json,'$.role')='advanced-resolver'")=1,"explicit extraction keeps advanced model and correct operation")
    errors=errors+check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE state='queued' AND item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || extract_task || "')")=0,"select explicit extraction")
    extraction_provider=.fixtureprovider("empty-extraction"); disposition=""
    claim_policy=.ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
    status=runworkeronce(store,job_id,"explicit-extraction",60,3,claim_policy,extraction_provider,disposition,error,genericprofile())
    errors=errors+check(status=0 & tickbacklogwindow(store,job_id,error)>=0,"advanced empty extraction completes " || error)
    errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || extract_task || "'")="resolved","examined with no claims closes the question")
  end
  budget_policy=scalartext(database,"SELECT json_set(" || _testquote(raw) || ",'$.batch_items',1,'$.input_budget',100005,'$.input_tokens',100000,'$.advanced_route.input_tokens',10000)")
  budget_a="";budget_b=""
  errors=errors+check(enqueuebacklogtask(database,"route-budget-a","chunk","chunk-lifecycle","","",1000000,.jsondocument(budget_policy),budget_a,error)=0 & enqueuebacklogtask(database,"route-budget-b","chunk","chunk-lifecycle","","",999999,.jsondocument(budget_policy),budget_b,error)=0,"remaining budget route fixture")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning' WHERE task_id IN('" || budget_a || "','" || budget_b || "')")=0,"remaining budget advanced routes")
  errors=errors+check(nextwindow(store,budget_policy,job_id,error)=0 & runresolution(store,job_id,budget_a,responsejson("no-change"),error)=0,"first smaller advanced reservation fits shared budget " || error)
  errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"checkpoint next affordable route")
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'")="active" & scalarint(database,"SELECT count(*) FROM job_items i JOIN maintenance_task_items m ON m.item_id=i.item_id WHERE m.task_id='" || budget_b || "' AND i.state='queued'")=1,"remaining budget permits advanced work when ordinary reservation no longer fits")
  reset_successor=""; reset_changed=0; reset_skipped=0
  errors=errors+check(resetbacklogtasks(store,architecturelocalconfig(),genericprofile(),ordinary,reset_successor,reset_changed,reset_skipped,error)=0 & reset_successor<>ordinary & reset_changed=1,"explicit one-task reset can reconsider a final assessment " || error)

  return errors

outcomeboundarychecks: procedure = .int
  arg store = .ragstorehandle, base = .string
  database=store.database(); errors=0; error=""
  job_id=scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  raw=left(base,length(base)-1) || ',"source_id":"source-lifecycle","evidence_expected":0,"search_reads":0,"advanced_attempts":3,"advanced_route":{"role":"advanced-resolver","provider_id":"fixture","model":"advanced-fixture","charging_basis":"local-compute","input_tokens":100000,"output_tokens":10000,"cost_microunits":0,"time_ms":1000,"resolution_prompt":"Conclude."}}'
  current=scalarint(database,"SELECT published_generation FROM library_meta")
  advanced_failed=""
  do cell=1 to 4
    task_id=""
    errors=errors+check(enqueuebacklogtask(database,"outcome-boundary-" || cell,"chunk","chunk-lifecycle","","",1000000,.jsondocument(raw),task_id,error)=0,"outcome boundary fixture")
    proposed=responsejson("search","","[]","[]","","Cobalt")
    if cell=1 then proposed=responsejson("defer","","[]","[]","","Await more evidence","{}",scalartext(database,"SELECT strftime('%Y-%m-%dT%H:%M:%SZ','now','+6 months')"))
    if cell=2 then do
      errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning' WHERE task_id='" || task_id || "'")=0,"final route refusal fixture")
      advanced_failed=task_id
      proposed=responsejson("unresolved")
    end
    if cell=4 then do
      raw=changestr('"search_reads":0',raw,'"search_reads":2')
      proposed=responsejson("read","","[]","[]","forged-citation")
    end
    errors=errors+check(nextwindow(store,raw,job_id,error)=0,"boundary window " || error)
    status=runresolution(store,job_id,task_id,proposed,error)
    errors=errors+check(status<>0,"unsupported outcome refused: " || cell)
    errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || task_id || "'")=0 & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'")<>"resolved","refusal is not semantic success: " || cell)
  end
  errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta")=current,"outcome refusals do not publish facts")
  one_call_policy=changestr('"advanced_attempts":3',raw,'"advanced_attempts":1')
  before_reset=backlogselection(database,.jsondocument(one_call_policy),0,98,"")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(before_reset) || ",'$.eligible') WHERE json_extract(value,'$.task_id')=" || _testquote(advanced_failed))=0,"failed advanced call exhausts its own route allowance")
  reset_jobs=0; reset_items=0
  errors=errors+check(recordretryreset(database,"",reset_jobs,reset_items,error,advanced_failed)=0,"existing retry reset records the advanced baseline")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET not_before_epoch=0 WHERE task_id=" || _testquote(advanced_failed))=0,"reach retry delay after counter reset")
  after_reset=backlogselection(database,.jsondocument(one_call_policy),0,98,"")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(after_reset) || ",'$.eligible') WHERE json_extract(value,'$.task_id')=" || _testquote(advanced_failed))=1 & scalarint(database,"SELECT " || taskretrycallcount(_testquote(advanced_failed),1))=1,"reset restores advanced allowance while preserving paid history")
  date_policy=changestr('"source-lifecycle"',raw,'"source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"')
  dated=""; successor=""; due=0
  errors=errors+check(enqueuebacklogtask(database,"dated-successor","chunk","chunk-cobalt","","",1000000,.jsondocument(date_policy),dated,error)=0,"dated successor fixture")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning' WHERE task_id='" || dated || "'")=0,"dated successor route")
  errors=errors+check(deferbacklogtask(store,dated,"","6","Expected archive release",due,error)=0 & due>scalarint(database,"SELECT unixepoch('now','+5 months')"),"six calendar months becomes durable absolute UTC")
  errors=errors+check(sqliteexec(database,"UPDATE chunk_contents SET text='Cobalt archives',content_digest='digest-cobalt-new' WHERE content_id='content-cobalt'")=0,"relevant evidence changes before date")
  errors=errors+check(enqueuebacklogtask(database,"dated-successor","chunk","chunk-cobalt","","",1000000,.jsondocument(date_policy),successor,error)=0 & successor=dated,"relevant evidence cannot silently shorten a hard date")
  errors=errors+check(nextwindow(store,date_policy,job_id,error)=0 & scalarint(database,"SELECT count(*) FROM maintenance_task_items WHERE task_id='" || dated || "'")=0,"changed deferred question does not run early")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET not_before_epoch=unixepoch()-1 WHERE task_id='" || dated || "'")=0,"advance dated successor fixture to due time")
  due=scalarint(database,"SELECT not_before_epoch FROM maintenance_tasks WHERE task_id='" || dated || "'")
  errors=errors+check(nextwindow(store,date_policy,job_id,error)=0,"due evidence refresh window " || error)
  successor=scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id='" || dated || "' AND state='dispatched'")
  errors=errors+check(successor<>"" & successor<>dated & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || successor || "' AND required_capability='advanced-reasoning' AND not_before_epoch=" || due)=1,"evidence successor preserves route and earliest date")

  return errors

oldpolicychecks: procedure = .int
  arg store = .ragstorehandle, base = .string
  database = store.database(); errors = 0; error = ""; task_id = ""
  raw = changestr('"knowledge_policy":"fixture-v1"',base,'"knowledge_policy":"previous-route-default"')
  raw = left(raw,length(raw)-1) || ',"source_id":"source-lifecycle"}'
  errors = errors + check(enqueuebacklogtask(database,"old-policy-ordinary","chunk","chunk-lifecycle","","",1000000,.jsondocument(raw),task_id,error)=0,"old ordinary route fixture")
  raw = changestr('"previous-route-default"',raw,'"current-route-default"')
  job_id = scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  errors = errors + check(nextwindow(store,raw,job_id,error)=0,"maintenance considers prior ordinary policy " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE m.task_id='" || task_id || "' AND i.job_id='" || job_id || "' AND i.state='queued'")=1,"routine route-default changes cannot hide unfinished ordinary work")
  return errors

/* Exercise actual worker calls and scheduler checkpoints with both route
 * budgets. A completed ordinary task remains first in the table, so a lookup
 * that loses correlation cannot silently classify every task as ordinary. */
advancedbudgetchecks: procedure = .int
  arg store=.ragstorehandle,base=.string
  database=store.database();errors=0;error="";job_id=""
  current=scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_artifacts SELECT 'artifact-cobalt','raw-cobalt',mime_type,encoding,NULL,'fixture://cobalt',created_at FROM source_artifacts WHERE artifact_id='artifact-lifecycle'")=0,"outside evidence artifact")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revision_texts SELECT 'text-cobalt','digest-cobalt','Cobalt evidence',extractor_version,normalization_version,created_at FROM source_revision_texts WHERE text_id='text-lifecycle'")=0,"outside normalized text")
  errors = errors + check(sqliteexec(database,"INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc','fixture','cobalt','revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd','active','fixture://cobalt','Cobalt archive'," || current || ")")=0,"outside source")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd','source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc','envelope-cobalt','artifact-cobalt','text-cobalt','metadata-cobalt','fixture-time'," || current || ")")=0,"outside revision")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-cobalt','digest-cobalt','Cobalt evidence','input-cobalt')")=0,"outside content")
  errors = errors + check(sqliteexec(database,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-cobalt','revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd',1,0,15,'content-cobalt','continuity-cobalt','fixture-v1','direct'," || current || ")")=0,"outside chunk")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-cobalt','content-cobalt','Cobalt evidence')")=0,"outside lexical index")
  raw=scalartext(database,"SELECT json_set(" || _testquote(base) || ",'$.batch_items',1,'$.maximum_attempts',1,'$.source_id','source-lifecycle','$.search_reads',8,'$.evidence_expected',0,'$.advanced_attempts',3,'$.advanced_route',json('{""role"":""advanced-resolver"",""provider_id"":""fixture"",""model"":""advanced-fixture"",""charging_basis"":""local-compute"",""input_tokens"":100000,""output_tokens"":10000,""cost_microunits"":0,""time_ms"":1000,""resolution_prompt"":""Conclude.""}'))")
  raw=changestr("retain investigate",raw,"retain investigate no-change")
  control=""
  errors=errors+check(enqueuebacklogtask(database,"budget-direct-control","chunk","chunk-lifecycle","","",1000000,.jsondocument(raw),control,error)=0,"direct budget control task")
  errors=errors+check(nextwindow(store,raw,job_id,error)=0 & runresolution(store,job_id,control,responsejson("no-change"),error)=0,"ordinary direct conclusion control " || error)
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || control || "'")="resolved" & scalarint(database,"SELECT " || taskretrycallcount(_testquote(control),1))=1,"direct control consumes exactly one call")
  citation="crexx-rag:" || scalartext(database,"SELECT library_id FROM library_meta") || ":source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd:utf8-0-15"
  do ceiling=3 to 5 by 2
    policy_text=scalartext(database,"SELECT json_set(" || _testquote(raw) || ",'$.advanced_attempts'," || ceiling || ")")
    policy=.jsondocument(policy_text);task=""
    errors=errors+check(enqueuebacklogtask(database,"budget-advanced-" || ceiling,"chunk","chunk-lifecycle","","",1000000,policy,task,error)=0,"advanced budget fixture")
    before=scalarint(database,"SELECT count(*) FROM provider_runs")
    errors=errors+check(nextwindow(store,policy_text,job_id,error)=0,"advanced budget window")
    status=runresolution(store,job_id,task,responsejson("escalate","","[]","[]","","Inspect the missing source"),error)
    errors=errors+check(status=0,"ordinary escalation preserves the advanced budget " || error)
    if status<>0 then return errors
    do step=1 to ceiling
      /* A task failed by the old cutoff can resume under its existing
       * unspent allowance; do not reset or discard any paid history. */
      if ceiling=3 & step=3 then errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET state='failed',last_error='bounded attempt limit reached' WHERE task_id='" || task || "'")=0,"represent the retained premature-failure state")
      errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"advanced budget checkpoint")
      item=scalartext(database,"SELECT i.item_id FROM job_items i JOIN maintenance_task_items m USING(item_id) WHERE m.task_id='" || task || "' AND i.state='queued'")
      errors=errors+check(item<>"","advanced call remains dispatchable at step " || step || " of " || ceiling)
      if item="" then return errors
      remaining=scalarint(database,"SELECT json_extract(input_json,'$.remaining_calls_including_this') FROM job_items WHERE item_id='" || item || "'")
      errors=errors+check(remaining=ceiling-step+1,"prompt counts every advanced call")
      if ceiling=3 & step=3 then do
        old_input=scalartext(database,"SELECT i.input_json FROM job_items i JOIN maintenance_task_items m USING(item_id) WHERE m.task_id='" || task || "' AND json_extract(i.input_json,'$.remaining_calls_including_this')=3 ORDER BY m.attempt_number LIMIT 1")
        projected=resolutionoperationalinput(database,old_input,error)
        errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(projected) || ",'$.remaining_calls_including_this')")=1,"retained old advanced packet advertises the actual one remaining call")
        errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(old_input) || ",'$.remaining_calls_including_this')")=3,"operational allowance projection leaves frozen packet untouched")
      end
      facts=taskretryfacts(database,task,job_id)
      errors=errors+check(scalarint(database,"SELECT json_extract(" || _testquote(facts) || ",'$.route_calls')")=step-1,"inspection counts advanced calls without the ordinary escalation")
      proposed=responsejson("search","","[]","[]","",word("Cobalt unused evidence",step))
      if step=2 then proposed=responsejson("read","","[]","[]",citation)
      if step=4 then proposed=responsejson("search","","[]","[]","","Cobalt evidence")
      if step=ceiling then proposed=responsejson("no-change")
      status=runresolution(store,job_id,task,proposed,error)
      errors=errors+check(status=0,"advanced evidence/conclusion step " || step || " of " || ceiling || " " || error)
      if status<>0 then return errors
      errors=errors+check(scalarint(database,"SELECT " || taskretrycallcount(_testquote(task),1,0,"advanced-reasoning"))=step,"each advanced step is charged to its configured allowance")
      errors=errors+check(scalarint(database,"SELECT count(*) FROM provider_runs")=before+step+1,"ordinary and all advanced calls remain in total usage")
    end
    errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"complete advanced budget window")
    errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task || "'")="resolved","last advanced call concludes")
    errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || task || "'")=ceiling+1,"all decisions retained")
    errors=errors+check(scalarint(database,"SELECT sum(input_tokens+output_tokens) FROM provider_runs WHERE provider_run_id IN(SELECT a.provider_run_id FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id='" || job_id || "')")=20*(ceiling+1),"every call consumes job token budget")
    errors=errors+check(scalarint(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='" || job_id || "'")=0,"all call reservations released")
    grounds="";refusal=""
    errors=errors+check(validatebacklogresponse(database,task,responsejson("search","","[]","[]","","New query"),grounds,refusal,policy_text)<>0 & pos("last reasoning call",refusal)>0,"no evidence step beyond the configured advanced allowance")
    errors=errors+check(scalarint(database,"SELECT published_generation FROM library_meta")=current & scalarint(database,"SELECT count(*) FROM source_revisions")=2,"evidence gathering preserves source and graph state")
  end
  return errors

searchhandoffchecks: procedure = .int
  arg store = .ragstorehandle, raw = .string, expose job_id = .string, task_id = .string
  database = store.database(); errors = 0; error = ""; policy = .jsondocument(raw)
  current = scalarint(database,"SELECT published_generation FROM library_meta")
  original_calls = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_artifacts SELECT 'artifact-cobalt','raw-cobalt',mime_type,encoding,NULL,'fixture://cobalt',created_at FROM source_artifacts WHERE artifact_id='artifact-lifecycle'")=0,"outside evidence artifact")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revision_texts SELECT 'text-cobalt','digest-cobalt','Cobalt evidence',extractor_version,normalization_version,created_at FROM source_revision_texts WHERE text_id='text-lifecycle'")=0,"outside normalized text")
  errors = errors + check(sqliteexec(database,"INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc','fixture','cobalt','revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd','active','fixture://cobalt','Cobalt archive'," || current || ")")=0,"outside source")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd','source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc','envelope-cobalt','artifact-cobalt','text-cobalt','metadata-cobalt','fixture-time'," || current || ")")=0,"outside revision")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-cobalt','digest-cobalt','Cobalt evidence','input-cobalt')")=0,"outside content")
  errors = errors + check(sqliteexec(database,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-cobalt','revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd',1,0,15,'content-cobalt','continuity-cobalt','fixture-v1','direct'," || current || ")")=0,"outside chunk")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-cobalt','content-cobalt','Cobalt evidence')")=0,"outside lexical index")
  status = runresolution(store,job_id,task_id,responsejson("search","","[]","[]","","Cobalt"),error)
  errors = errors + check(status=0,"bounded corpus search step " || error)
  if status<>0 then return errors
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || task_id || "' AND disposition='search:pending' AND grounding_json LIKE '%source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc%'")=1,"search retains outside lead without binding it")
  repeat_grounds=""; repeat_error=""
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("search","","[]","[]","","Cobalt"),repeat_grounds,repeat_error,raw)<>0 & pos("already",repeat_error)>0,"repeat search is refused before another step")
  citation = "crexx-rag:" || scalartext(database,"SELECT library_id FROM library_meta") || ":source-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:revision-sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd:utf8-0-15"
  evidence_id = "resolver:" || rxhash..sha256hex(citation as .binary)
  proposed = responsejson("no-change","","[]",'[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Cobalt evidence"}]')
  grounds = ""; validation_error = ""
  errors = errors + check(validatebacklogresponse(database,task_id,proposed,grounds,validation_error)<>0,"search lead cannot yet be cited as bound support")
  status = runresolution(store,job_id,task_id,responsejson("read","","[]","[]",citation),error)
  errors = errors + check(status=0,"bounded citation read step " || error)
  if status<>0 then return errors
  errors = errors + check(validatebacklogresponse(database,task_id,proposed,grounds,validation_error)=0,"read binds the exact new source span " || validation_error)
  errors = errors + check(pos('"revision_chunk_id":"chunk-cobalt"',grounds)>0 & pos('"span_end":15',grounds)>0,"binding uses source offsets")
  larger_read_allowance=changestr('"search_reads":2',raw,'"search_reads":16')
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("read","","[]","[]",citation,"A different wording"),repeat_grounds,repeat_error,larger_read_allowance)<>0 & pos("already",repeat_error)>0,"rewording cannot repeat a bound citation read")
  until_text = scalartext(database,"SELECT strftime('%Y-%m-%dT%H:%M:%SZ','now','+6 months')")
  status = runresolution(store,job_id,task_id,responsejson("defer","","[]","[]","","A scheduled archive addition can settle the remaining attribution","{}",until_text),error)
  errors = errors + check(status=0,"ordinary evidence handoff and dated escalation " || error)
  if status<>0 then return errors
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || task_id || "' AND required_capability='advanced-reasoning' AND not_before_epoch>unixepoch()")=1,"handoff retains advanced route and future date")
  errors=errors+check(validatebacklogresponse(database,task_id,responsejson("defer","","[]","[]","","Keep waiting","{}",until_text),repeat_grounds,repeat_error,raw)<>0 & pos("already been deferred",repeat_error)>0,"unchanged evidence cannot roll its deferral forward")
  errors = errors + check(nextwindow(store,raw,job_id,error)=0,"restart deferred maintenance " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items i JOIN maintenance_task_items m ON m.item_id=i.item_id WHERE m.task_id='" || task_id || "' AND i.state IN('queued','running')")=0,"restart cannot run a deferred handoff early")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET not_before_epoch=unixepoch()-1 WHERE task_id='" || task_id || "'")=0,"simulate reaching the due date")
  errors = errors + check(nextwindow(store,raw,job_id,error)=0,"due handoff dispatch " || error)
  status = runresolution(store,job_id,task_id,proposed,error)
  errors = errors + check(status=0,"advanced worker concludes from retained outside evidence " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || task_id || "'")=4 & scalarint(database,"SELECT count(*) FROM provider_runs")=original_calls+4,"three ordinary steps and one advanced decision retain all calls without replay")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || task_id || "'")="resolved" & scalarint(database,"SELECT published_generation FROM library_meta")=current,"final no-change converges without publication")
  final_again=""; changed_policy=changestr('"route-fixture"',raw,'"routine-route-edit"')
  errors=errors+check(enqueuebacklogtask(database,"route-ordinary","chunk","chunk-lifecycle","","",1000000,.jsondocument(changed_policy),final_again,error)=0 & final_again=task_id,"final bound-evidence question survives route-default edits")


  return errors

zerobudgetchecks: procedure = .int
  arg store = .ragstorehandle, base = .string
  database = store.database(); errors = 0; error = ""
  job_id = scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1")
  original_calls = scalarint(database,"SELECT count(*) FROM provider_runs")
  do cell = 1 to 5
    charging = "monetary-api"; cost = 0; budget = 0
    if cell = 2 then do; cost = 100; budget = 100; end
    if cell = 3 | cell = 4 then charging = "local-compute"
    raw = changestr('"charging_basis":"local-compute"',base,'"charging_basis":"subscription-allowance"')
    if cell > 3 then raw = changestr('"charging_basis":"subscription-allowance"',raw,'"charging_basis":"monetary-api"')
    raw = changestr('"codex_turns":0',raw,'"codex_turns":100')
    raw = changestr('"batch_items":100',raw,'"batch_items":1')
    /* Only the mixed-route case needs a one-item batch. Let the no-route
     * closure control finish discovery over the earlier scale fixtures. */
    if cell = 5 then raw = changestr('"batch_items":1',raw,'"batch_items":100')
    raw = changestr('"knowledge_policy":"fixture-v1"',raw,'"knowledge_policy":"zero-budget-' || cell || '"')
    raw = changestr('"cost_budget":0',raw,'"cost_budget":' || budget)
    /* Cell 1 deliberately leaves ordinary work unfinished. The positive
     * embedding controls must not depend on its timestamp/task-id ordering. */
    if cell >= 2 & cell <= 4 then raw = left(raw,length(raw)-1) || ',"embeddings_only":1}'
    raw = left(raw,length(raw)-1) || ',"embedding_profile":"zero-budget-' || cell || '","embedding_envelope":"fixture","embedding_provider":"fixture","embedding_model":"fixture","embedding_charging":"' || charging || '","embedding_input":100000,"embedding_cost":' || cost || ',"embedding_time":1000,"embedding_dimension":2}'
    policy = .jsondocument(raw); task = ""
    if cell=1 then do
      funded_task=""
      errors=errors+check(enqueuebacklogtask(database,"funded-ordinary-control","chunk","chunk-lifecycle","","",1000000,policy,funded_task,error)=0,"explicit unfinished zero-cost ordinary control")
    end
    errors = errors + check(enqueuebacklogtask(database,"embedding-repair:zero-budget-" || cell,"chunk","chunk-lifecycle","","",1000000,policy,task,error) = 0,"zero-budget embedding fixture " || error)
    errors = errors + check(nextwindow(store,raw,job_id,error) = 0,"zero-budget window " || error)
    embedded = scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND item_type='embedding'")
    if cell = 1 | cell = 5 then do
      errors = errors + check(embedded = 0,"zero monetary budget cannot queue paid embedding: " || cell)
      errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id='" || task || "' AND state='pending' AND attempt_count=0") = 1,"unfunded task stays pending without an attempt")
      if cell = 1 then errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND item_type<>'embedding' AND json_extract(input_json,'$.charging_basis')='subscription-allowance'") >= 1,"paid embedding cannot starve eligible zero-cost subscription work across policies")
      if cell = 5 then do
        do pass = 1 to 20
          if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") \= "active" then leave
          if tickbacklogwindow(store,job_id,error) < 0 then return errors + check(0,"zero-budget closure " || error)
        end
        errors = errors + check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "complete","no funded tasks closes without a busy retry")
      end
    end
    else errors = errors + check(embedded = 1,"positive paid and zero-cost local embedding controls: " || cell)
  end
  if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "active" then do
    if pausejob(store,job_id,error) \= 0 | tickbacklogwindow(store,job_id,error) < 0 then errors = errors + check(0,"close cost-route fixture " || error)
  end
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = original_calls,"cost-route planning makes no provider calls")
  return errors

unlimitedwindowchecks: procedure = .int
  arg store=.ragstorehandle, base=.string
  database=store.database(); errors=0; error=""
  raw=changestr('"knowledge_policy":"fixture-v1"',base,'"knowledge_policy":"fixture-unlimited-window"')
  raw=changestr('"window_seconds":1000',raw,'"window_seconds":0')
  raw=changestr('"item_limit":100',raw,'"item_limit":0')
  raw=changestr('"model_calls":100',raw,'"model_calls":0')
  raw=changestr('"input_budget":10000000',raw,'"input_budget":0')
  raw=changestr('"output_budget":1000000',raw,'"output_budget":0')
  raw=left(raw,length(raw)-1) || ',"zero_unlimited":1}'
  task=""; job_id=scalartext(database,"SELECT job_id FROM maintenance_windows WHERE state='active' LIMIT 1"); policy=.jsondocument(raw)
  errors=errors+check(enqueuebacklogtask(database,"unlimited-window-question","chunk","chunk-lifecycle","","",1000000,policy,task,error)=0,"unlimited window task fixture " || error)
  errors=errors+check(nextwindow(store,raw,job_id,error)=0,"unlimited automatic window starts " || error)
  errors=errors+check(scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")=0,"unlimited window has no synthetic deadline")
  errors=errors+check(scalarint(database,"SELECT model_call_budget+input_token_budget+output_token_budget+cost_budget FROM jobs WHERE job_id='" || job_id || "'")=0,"zero aggregate allowances persist")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_task_items WHERE task_id='" || task || "' AND window_id=(SELECT window_id FROM maintenance_windows WHERE job_id='" || job_id || "')")=1,"automatic discovery dispatches work with zero aggregate limits")
  errors=errors+check(pausejob(store,job_id,error)=0 & tickbacklogwindow(store,job_id,error)>=0,"unlimited window pauses " || error)
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"begin unlimited continuation")
  errors=errors+check(continuebacklogwindow(database,job_id,0,0,error)=0,"unlimited window resumes without renewing allowance " || error)
  errors=errors+check(sqliteexec(database,"UPDATE jobs SET state='queued' WHERE job_id='" || job_id || "';COMMIT")=0,"commit unlimited continuation")
  errors=errors+check(scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")=0,"resumed unlimited window retains no deadline")
  errors=errors+check(pausejob(store,job_id,error)=0 & tickbacklogwindow(store,job_id,error)>=0,"unlimited window closes after resume " || error)
  retry_raw=changestr('"knowledge_policy":"fixture-unlimited-window"',raw,'"knowledge_policy":"fixture-unlimited-retry"')
  retry_raw=changestr('"retry_seconds":1',retry_raw,'"retry_seconds":30')
  retry_raw=left(retry_raw,length(retry_raw)-1) || ',"phase":"identity","phase_cohort":["unlimited-retry-concept"]}'
  retry_policy=.jsondocument(retry_raw); retry_job=""; retry_task=""
  errors=errors+check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('unlimited-retry-concept','Retry','concept','active',1)")=0,"unlimited retry subject")
  errors=errors+check(enqueuebacklogtask(database,"identity-review","concept","unlimited-retry-concept","","",1000000,retry_policy,retry_task,error)=0 & nextwindow(store,retry_raw,retry_job,error)=0,"unlimited retry fixture " || error)
  retry_item=scalartext(database,"SELECT m.item_id FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE m.task_id='" || retry_task || "' AND i.job_id='" || retry_job || "'")
  errors=errors+check(retry_item<>"","unlimited retry first dispatch")
  errors=errors+check(sqliteexec(database,"INSERT INTO provider_runs(provider_run_id,config_snapshot_id,provider_id,model,request_hash,outcome,started_at) SELECT 'unlimited-retry-run',config_snapshot_id,'fixture','fixture','fixture','failed','fixture' FROM jobs WHERE job_id='" || retry_job || "'; INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,provider_run_id,validation_state,outcome,started_at,completed_at) SELECT 'unlimited-retry-attempt',item_id,'fixture',1,input_hash,'unlimited-retry-run','failed','failed','fixture','fixture' FROM job_items WHERE item_id='" || retry_item || "'; UPDATE job_items SET state='failed' WHERE item_id='" || retry_item || "'")=0,"retain failed provider attempt for unlimited retry")
  errors=errors+check(tickbacklogwindow(store,retry_job,error)>=0,"reconcile unlimited retry " || error)
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || retry_job || "'")="active" & scalarint(database,"SELECT not_before_epoch>unixepoch() FROM maintenance_tasks WHERE task_id='" || retry_task || "'")=1,"unlimited window waits for ordinary retry backoff")
  errors=errors+check(sqliteexec(database,"UPDATE maintenance_tasks SET not_before_epoch=0 WHERE task_id='" || retry_task || "'")=0 & tickbacklogwindow(store,retry_job,error)>=0,"retry becomes due " || error)
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE m.task_id='" || retry_task || "' AND i.job_id='" || retry_job || "' AND i.state='queued'")=1,"unlimited window dispatches due retry in same job")
  errors=errors+check(pausejob(store,retry_job,error)=0 & tickbacklogwindow(store,retry_job,error)>=0,"close unlimited retry fixture " || error)
  hold_raw=changestr('"knowledge_policy":"fixture-unlimited-retry"',retry_raw,'"knowledge_policy":"fixture-unlimited-operator-hold"')
  hold_raw=changestr('"unlimited-retry-concept"',hold_raw,'"unlimited-hold-concept"')
  hold_policy=.jsondocument(hold_raw); hold_task=""; hold_job=""; hold_until=0
  errors=errors+check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('unlimited-hold-concept','Hold','concept','active',1)")=0,"unlimited held subject")
  errors=errors+check(enqueuebacklogtask(database,"identity-review","concept","unlimited-hold-concept","","",1000000,hold_policy,hold_task,error)=0 & nextwindow(store,hold_raw,hold_job,error)=0,"start unlimited held window " || error)
  hold_item=scalartext(database,"SELECT m.item_id FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE m.task_id='" || hold_task || "' AND i.job_id='" || hold_job || "'")
  errors=errors+check(hold_item<>"","unlimited hold first dispatch")
  errors=errors+check(sqliteexec(database,"INSERT INTO provider_runs(provider_run_id,config_snapshot_id,provider_id,model,request_hash,outcome,started_at) SELECT 'unlimited-hold-run',config_snapshot_id,'fixture','fixture','fixture','failed','fixture' FROM jobs WHERE job_id='" || hold_job || "'; INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,provider_run_id,validation_state,outcome,started_at,completed_at) SELECT 'unlimited-hold-attempt',item_id,'fixture',1,input_hash,'unlimited-hold-run','failed','failed','fixture','fixture' FROM job_items WHERE item_id='" || hold_item || "'; UPDATE job_items SET state='failed' WHERE item_id='" || hold_item || "'")=0,"retain held question provider attempt")
  errors=errors+check(tickbacklogwindow(store,hold_job,error)>=0 & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || hold_job || "'")="active","held question enters ordinary retry before deferral " || error)
  errors=errors+check(deferbacklogtask(store,hold_task,"","1","operator holds this question",hold_until,error)=0,"record explicit future operator deferral " || error)
  do pass=1 to 3
    if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || hold_job || "'")<>"active" then leave
    errors=errors+check(tickbacklogwindow(store,hold_job,error)>=0,"checkpoint unlimited held window " || error)
  end
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || hold_job || "'")="complete","explicit operator deferral does not poll indefinitely")
  no_work=changestr('"knowledge_policy":"fixture-unlimited-window"',raw,'"knowledge_policy":"fixture-unlimited-no-work"')
  no_work=left(no_work,length(no_work)-1) || ',"source_id":"synthetic-source-that-does-not-exist"}'
  job_id=""
  errors=errors+check(nextwindow(store,no_work,job_id,error)=0,"unlimited empty window starts " || error)
  do pass=1 to 3
    if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'")<>"active" then leave
    errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"unlimited empty checkpoint " || error)
  end
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'")="complete","unlimited empty window closes without polling loop")
  return errors

/* Source selection is operational state retained by the existing continuation
 * owner. Continuing grants no fresh item allowance and makes no provider call. */
sourcecontinuationchecks: procedure = .int
  arg store=.ragstorehandle,base=.string
  database=store.database();errors=0;error="";job_id="";task=""
  raw=changestr('"knowledge_policy":"fixture-v1"',base,'"knowledge_policy":"source-continuation"')
  raw=changestr('"batch_items":100',raw,'"batch_items":1')
  raw=left(raw,length(raw)-1) || ',"source_id":"source-lifecycle"}'
  policy=.jsondocument(raw)
  calls=scalarint(database,"SELECT count(*) FROM provider_runs")
  errors=errors+check(enqueuebacklogtask(database,"alias-follow-up:source-continuation","chunk","chunk-lifecycle","","",1000000,policy,task,error)=0 & nextwindow(store,raw,job_id,error)=0,"source continuation fixture " || error)
  original=scalartext(database,"SELECT policy_json FROM maintenance_windows WHERE job_id='" || job_id || "'")
  deadline=scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")
  allowance=scalarint(database,"SELECT item_budget FROM jobs WHERE job_id='" || job_id || "'")
  errors=errors+check(pausejob(store,job_id,error)=0 & tickbacklogwindow(store,job_id,error)>=0,"pause source window")
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"begin source continuation")
  errors=errors+check(continuebacklogwindow(database,job_id,0,0,error)=0,"continue existing source window " || error)
  errors=errors+check(sqliteexec(database,"UPDATE jobs SET state='queued' WHERE job_id='" || job_id || "';COMMIT")=0,"commit source continuation")
  errors=errors+check(tickbacklogwindow(store,job_id,error)>=0,"checkpoint continued source window " || error)
  errors=errors+check(scalartext(database,"SELECT policy_json FROM maintenance_windows WHERE job_id='" || job_id || "'")=original & scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")=deadline & scalarint(database,"SELECT item_budget FROM jobs WHERE job_id='" || job_id || "'")=allowance,"source continuation retains exact scope deadline and allowance")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND json_extract(input_json,'$.revision_chunk_id') NOT IN(SELECT revision_chunk_id FROM revision_chunks WHERE revision_id='revision-lifecycle')")=0 & scalarint(database,"SELECT count(*) FROM provider_runs")=calls,"source continuation never widens or calls a provider")
  errors=errors+check(pausejob(store,job_id,error)=0 & tickbacklogwindow(store,job_id,error)>=0,"close source continuation fixture")
  return errors

main: procedure = .int
  arg args = .string[]
  if args.0 < 1 | args.0 > 2 then return 2
  selected_case = "core"; if args.0=2 then selected_case=args[2]
  if selected_case<>"core" & selected_case<>"escalation" & selected_case<>"budget" & selected_case<>"recording" & selected_case<>"reconsideration" then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  /* Applicability is a request contract as well as an apply-time guard. */
  note_schema = backlogschema("note",0); alias_schema = backlogschema("alias-issue",0)
  errors = errors + check(pos('"reuse"',note_schema) = 0 & pos('"distinct"',note_schema) = 0 & pos('"retain"',note_schema) > 0,"note schema excludes alias-only actions")
  errors = errors + check(pos('"reuse"',alias_schema) > 0 & pos('"distinct"',alias_schema) > 0 & pos('"split"',alias_schema) = 0,"alias schema offers identity resolution")
  kinds = "alias mention support claim note ambiguity"
  do i = 1 to words(kinds)
    schema = backlogschema(word(kinds,i),1)
    errors = errors + check(pos('"move"',schema) > 0 & pos('"retract"',schema) > 0 & pos('"reuse"',schema) = 0,"workflow connection schema " || word(kinds,i))
  end
  conflict_schema = backlogschema("conflict",1); gap_schema = backlogschema("gap",0)
  errors = errors + check(pos('"qualify"',conflict_schema) > 0 & pos('"move"',conflict_schema) = 0,"conflict schema retains supported claim resolution")
  errors = errors + check(pos('"investigate"',gap_schema) > 0 & pos('"split"',gap_schema) = 0 & pos('"reuse"',gap_schema) = 0,"gap schema offers only supported decisions")
  errors = errors + check(initragstore(path, "library-lifecycle-methodology", "snapshot-lifecycle", "lifecycle-methodology", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors > 0 then return 1
  database = store.database()
  errors = errors + timingchecks(database)
  errors = errors + check(sqliteexec(database, "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-lifecycle','raw-lifecycle','text/plain','utf-8',NULL,'fixture://lifecycle',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "artifact")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-lifecycle','text-digest-lifecycle','Platform Peer','fixture-v1','utf8-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "revision text")
  errors = errors + check(sqliteexec(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-lifecycle','fixture','lifecycle','revision-lifecycle','active','fixture://lifecycle','Lifecycle corpus',1)") = 0, "source")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-lifecycle','source-lifecycle','revision-envelope-lifecycle','artifact-lifecycle','text-lifecycle','metadata-lifecycle','fixture-time',1)") = 0, "revision")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-lifecycle','content-digest-lifecycle','Platform Peer','input-lifecycle')") = 0, "content")
  errors = errors + check(sqliteexec(database, "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-lifecycle','revision-lifecycle',1,0,13,'content-lifecycle','continuity-lifecycle','fixture-v1','direct',1)") = 0, "chunk")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-lifecycle','content-lifecycle','Platform Peer')") = 0, "FTS")
  errors = errors + check(sqliteexec(database, "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-parent','Platform','concept','active',1),('concept-peer','Peer','concept','active',1),('concept-survivor','Survivor','concept','active',1)") = 0, "concepts")
  errors = errors + check(sqliteexec(database, "INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('concept-parent',1,'Platform','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-peer',1,'Peer','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-survivor',1,'Survivor','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "concept versions")
  errors = errors + check(sqliteexec(database, "INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,ambiguity_id,decision_id,visible_from_generation) VALUES('alias-parent','platform','concept-parent',NULL,NULL,1)") = 0, "alias")
  errors = errors + check(sqliteexec(database, "INSERT INTO mentions(mention_id,concept_id,ambiguity_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-parent','concept-parent',NULL,'chunk-lifecycle',0,8,1),('mention-peer','concept-peer',NULL,'chunk-lifecycle',9,13,1)") = 0, "mentions")
  errors = errors + check(sqliteexec(database, "INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('claim-parent-peer','concept-parent','related-to','concept-peer','outbound','{}','fixture-v1',1),('claim-peer-survivor','concept-peer','related-to','concept-survivor','outbound','{}','fixture-v1',1)") = 0, "claims")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,decision_id,visible_from_generation) VALUES('support-parent-peer','claim-parent-peer','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1),('support-peer-survivor','claim-peer-survivor','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1)") = 0, "claim supports")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-parent','claim-parent-peer','claim-peer-survivor','pending',1)") = 0, "claim conflict")
  errors = errors + check(sqliteexec(database, "INSERT INTO ambiguity_candidates(ambiguity_id,concept_id,revision_chunk_id,decision_id,visible_from_generation) VALUES('ambiguity-parent','concept-parent','chunk-lifecycle',NULL,1)") = 0, "ambiguity candidate")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-parent','lead','Review Platform',800000,200000,'','active','{}','fixture',1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "analysis note")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-parent','note-parent','concept','concept-parent','chunk-lifecycle',0,8)") = 0, "analysis note link")
  errors = errors + check(publishmanifest(store, error) = 0, "initial manifest " || error)
  if errors > 0 then return 1


  policy_json = '{"mode":"automatic","window_seconds":1000,"automatic_actions":"reuse distinct split merge synonym type-correction retire restore move retract qualify retain investigate","maximum_impact":100,"maximum_attempts":3,"retry_seconds":1,"maximum_evidence_bytes":65536,"batch_items":100,"resolution_prompt":"Fixture resolution","knowledge_policy":"fixture-v1","provider_id":"fixture","model":"fixture","charging_basis":"local-compute","privacy":"public","profile_id":"generic-profile","discovery_context":"{}","input_tokens":100000,"output_tokens":10000,"cost_microunits":0,"time_ms":1000,"inflight":1,"item_limit":100,"model_calls":100,"input_budget":10000000,"output_budget":1000000,"cost_budget":0,"codex_turns":0}'
  if selected_case="reconsideration" then do
    errors=errors+reconsiderationchecks(store,policy_json)
    call closeragstore store,error
    if errors>0 then return 1
    say "DURABLE_BACKLOG_OK reconsideration"
    return 0
  end
  if selected_case="recording" then do
    errors = errors + lifecyclerecordingchecks(store,policy_json)
    call closeragstore store,error
    if errors>0 then return 1
    say "DURABLE_BACKLOG_OK recording"
    return 0
  end
  if selected_case="budget" then do
    errors=errors+advancedbudgetchecks(store,policy_json)
    errors=errors+unlimitedwindowchecks(store,policy_json)
    call closeragstore store,error
    if errors>0 then return 1
    say "DURABLE_BACKLOG_OK budget"
    return 0
  end
  if selected_case="escalation" then do
    errors = errors + escalationroutechecks(store,policy_json)
    errors = errors + oldpolicychecks(store,policy_json)
    errors = errors + outcomeboundarychecks(store,policy_json)
    call closeragstore store,error
    if errors>0 then return 1
    say "DURABLE_BACKLOG_OK escalation"
    return 0
  end
  policy = .jsondocument(policy_json); task_id = ""
  errors = errors + check(enqueuebacklogtask(database,"lifecycle","concept","concept-parent","","",999999,policy,task_id,error) = 0, "queue split decision " || error)
  grounds = ""
  errors = errors + check(validatebacklogresponse(database,task_id,responsejson("reuse"),grounds,error) \= 0 & error = "resolution action is not applicable to its subject","reject identity-only answer on a concept task")
  first_task = task_id
  nonempty='[{"object_type":"alias","object_id":"synthetic-alias","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"synthetic impact"}]'
  controls=.string[]
  controls[1]=responsejson("no-change")
  controls[2]=responsejson("insufficient-evidence","","[]","[]","","A later exact source could settle identity")
  controls[3]=responsejson("search","","[]","[]","","Synthetic query")
  controls[4]=responsejson("read","","[]","[]","crexx-rag:synthetic:read")
  controls[5]=responsejson("unresolved")
  controls[6]=responsejson("escalate","","[]","[]","","Inspect further synthetic evidence")
  controls[7]=responsejson("retain","","[]",'[{"evidence_id":"mention-parent","quote":"Platform"}]')
  do c=1 to controls.0
    errors=errors+check(validatebacklogresponse(database,first_task,controls[c],grounds,error)=0,"legacy absent dispositions control " || c || " " || error)
    errors=errors+check(validatebacklogresponse(database,first_task,withdispositions(controls[c],"[]"),grounds,error)=0,"strict empty dispositions control " || c || " " || error)
    errors=errors+check(validatebacklogresponse(database,first_task,withdispositions(controls[c],nonempty),grounds,error)<>0 & pos("nonempty impact dispositions",error)>0,"non-lifecycle impact rejected " || c)
  end
  errors = errors + selectedquotationchecks(database,first_task)
  errors = errors + check(pos("unresolved disposition",scalartext(database,"SELECT question FROM maintenance_tasks WHERE task_id=" || _testquote(first_task)))=0,"new task question follows current outcome contract")
  errors = errors + check(enqueuebacklogtask(database,"lifecycle","concept","concept-parent","","",999999,policy,task_id,error) = 0 & task_id = first_task & scalarint(database,"SELECT count(*) FROM maintenance_tasks") = 1, "unchanged task is deduplicated")
  texts = .string[]; scores = .int[]
  census = .ragmaintenancecensus(1,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  run_id = ""; job_id = ""; items = 0
  errors = errors + check(startbacklogwindow(store,census,"snapshot-lifecycle",copies("d",64),policy_json,run_id,job_id,items,error) = 0 & items > 0, "start shared maintenance window " || error)
  if errors > 0 then return 1
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  successors = '[{"canonical_label":"Platform Alpha","concept_type":"concept"},{"canonical_label":"Platform Beta","concept_type":"concept"}]'
  split = responsejson("split","",successors,evidence,"concept-parent")
  grounds = ""
  errors = errors + check(validatebacklogresponse(database,first_task,withdispositions(split,"[]"),grounds,error)=0,"empty lifecycle dispositions preserve split follow-up " || error)
  errors = errors + check(validatebacklogresponse(database,first_task,changestr('"quote":"Platform"',split,'"quote":"Invented"'),grounds,error) \= 0, "invented resolution evidence rejected")
  error = ""
  errors = errors + check(runresolution(store,job_id,first_task,split,error) = 0, "apply split through fenced worker " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "migration-parent", "split retains migration parent")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_workflows") = 1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='connection'") = 6, "split atomically fans out the full support, ambiguity and conflict impact census")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE disposition='split:resolved'") = 1, "split decision retained")
  child = scalartext(database,"SELECT child_concept_id FROM concept_lineage WHERE parent_concept_id='concept-parent' ORDER BY child_concept_id LIMIT 1")
  workflow = scalartext(database,"SELECT workflow_id FROM maintenance_workflows")
  /* Pause the window with work remaining, then resume it as a fresh bounded
   * window. The source job and its decisions remain historical records. */
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "pause durable window " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE state='dispatched'") = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE state='pending'") > 0, "unstarted decisions survive pause")
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  census = .ragmaintenancecensus(generation,"",texts,texts,texts,scores,texts,texts,texts,'{}',rxhash..sha256hex('{}' as .binary))
  errors = errors + check(startbacklogwindow(store,census,"snapshot-lifecycle",copies("e",64),policy_json,run_id,job_id,items,error) = 0, "resume backlog in second window " || error)
  mention_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='mention' AND subject_id='mention-parent'")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,mention_task,responsejson("move",child,"[]",evidence),error) = 0, "move individual grounded mention " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || child || "' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM mentions WHERE mention_id='mention-parent' AND visible_to_generation IS NOT NULL") = 1, "mention movement preserves old evidence")
  alias_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND subject_type='alias'")
  errors = errors + check(runresolution(store,job_id,alias_task,responsejson("unresolved"),error) = 0, "uncertain alias is an unresolved decision " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || alias_task || "'") = "superseded", "changed catalogue prevents stale answers before paid calls")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh independent note evidence")
  note_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE kind='analysis-lead' AND subject_id='note-parent' AND state='dispatched'")
  errors = errors + check(runresolution(store,job_id,note_task,responsejson("unresolved"),error) = 0, "uncertainty is a valid decision " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || note_task || "'") = "unresolved", "uncertainty remains explicit")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "checkpoint makes no provider calls")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM source_artifacts") = 1 & scalarint(database,"SELECT count(*) FROM revision_chunks") = 1 & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer", "source records and text preserved")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0, "foreign-key integrity")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = 3, "exact bounded fixture call count with zero-call stale rejection")
  /* Complete every connection category rather than considering split creation
   * itself a completed migration. Refresh windows through the public lifecycle. */
  errors = errors + check(sqliteexec(database,"UPDATE aliases SET normalized_alias='platform revised' WHERE alias_id='alias-parent'") = 0, "fixture changes alias evidence after unresolved interpretation")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "resume remaining connection decisions " || error)
  alias_task = connectiontask(database,workflow,"alias")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  errors = errors + check(alias_task \= "" & runresolution(store,job_id,alias_task,responsejson("move",child,"[]",evidence),error) = 0, "move alias with retained source anchor " || error)
  support_task = connectiontask(database,workflow,"support")
  evidence = '[{"evidence_id":"support-parent-peer","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("move",child,"[]",evidence),error) = 0, "move individually grounded claim support " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id='" || child || "' AND target_concept_id='concept-peer' AND direction='outbound' AND visible_to_generation IS NULL") = 1, "support move preserves relationship direction")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_support WHERE support_id='support-parent-peer' AND visible_to_generation IS NOT NULL") = 1, "support movement preserves original source history")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claim_conflicts f JOIN claims c ON c.claim_id=f.claim_id WHERE c.source_concept_id='" || child || "' AND f.review_state='pending' AND f.visible_to_generation IS NULL") = 1, "claim movement preserves the pending conflict on its new identity")
  note_task = connectiontask(database,workflow,"note")
  evidence = '[{"evidence_id":"mention-parent","quote":"Platform"}]'
  evidence = '[{"evidence_id":"link-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,note_task,responsejson("move",child,"[]",evidence),error) = 0, "move linked analysis note " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_link_history WHERE note_id='note-parent' AND object_id='concept-parent'") = 1 & scalarint(database,"SELECT count(*) FROM analysis_note_links WHERE note_id='note-parent' AND object_id='concept-parent'") = 0, "note link keeps historical parent and current successor")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_link_history WHERE link_id='link-parent' AND revision_chunk_id='chunk-lifecycle' AND span_start=0 AND span_end=8 AND from_generation=1") = 1 & pos('link-parent',inspectbacklog(database,workflow)) > 0, "note movement preserves addressable source span and historical link inspection")
  ambiguity_task = connectiontask(database,workflow,"ambiguity")
  evidence = '[{"evidence_id":"ambiguity-parent","quote":"Platform"}]'
  errors = errors + check(runresolution(store,job_id,ambiguity_task,responsejson("move",child,"[]",evidence),error) = 0, "move explicit ambiguity candidate " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM ambiguity_candidates WHERE concept_id='concept-parent' AND visible_to_generation IS NOT NULL") = 1, "ambiguity history preserved")
  stale_conflict=connectiontask(database,workflow,"conflict"); before_stale=scalarint(database,"SELECT count(*) FROM provider_runs")
  errors=errors+check(stale_conflict<>"" & runresolution(store,job_id,stale_conflict,responsejson("unresolved"),error)=0,"drain obsolete retirement conflict work " || error)
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(stale_conflict))="superseded" & scalarint(database,"SELECT count(*) FROM provider_runs")=before_stale,"obsolete retirement conflict drains without a provider call")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh retirement census " || error)
  retire_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || workflow || "' AND kind='retirement' AND state='dispatched'")
  errors = errors + check(retire_task \= "" & runresolution(store,job_id,retire_task,responsejson("retire","","[]","[]","concept-parent"),error) = 0, "retire only after complete impact census " || error)
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "retired" & scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='" || workflow || "'") = "complete", "split workflow reaches durable completion")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM concept_versions WHERE concept_id='concept-parent'") = 3, "original, migration and retired versions retained")

  /* A response settled immediately before process death is reused under the
   * replacement lease. The fixture's next response is deliberately malformed. */
  recovery_task = ""
  errors = errors + check(enqueuebacklogtask(database,"recovery-test","concept","concept-survivor","","",999999,policy,recovery_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue recovery fixture")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select recovery fixture")
  claim = .ragworkclaim; reservation = .ragcallreservation
  errors = errors + check(claimnext(store,job_id,"crashed-fixture",60,3,claim,error) = 0 & reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0, "claim and reserve before crash " || error)
  settled_run = ""; response = responsejson("unresolved")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","settled-before-crash","succeeded",10,10,0,1,settled_run,error,"","local-compute",1,"",response,ragsha256(canonicalprofile(genericprofile()))) = 0, "atomically retain successful answer and usage " || error)
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET lease_until=0 WHERE item_id='" || claim.item_id() || "'") = 0, "simulate process death after settlement")
  provider = .fixtureprovider("MUST NOT CALL AGAIN"); disposition = ""; claim_policy = .ragclaimpolicy("fixture-v1","concept","related-to",1000000,750000,500000,-1000000,250000)
  errors = errors + check(runworkeronce(store,job_id,"replacement-fixture",60,3,claim_policy,provider,disposition,error,genericprofile()) = 0 & disposition = "resolution-recorded", "recover settled answer without another call " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || recovery_task || "'") = "unresolved", "recovery keeps exact paid call count")
  errors = errors + check(completebacklogdecision(store,job_id,claim.item_id(),claim.attempt_id(),claim.worker_id(),claim.fence(),settled_run,response,genericprofile(),error) = 0, "decision replay is idempotent")

  /* Supervised policy records an actionable proposal, then the ordinary
   * operator review path validates the same evidence before applying it. */
  supervised = changestr('"mode":"automatic"',policy_json,'"mode":"supervised"')
  review_task = ""
  errors = errors + check(enqueuebacklogtask(database,"review-test","concept",child,"","",999999,policy,review_task,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "start supervised resolution window")
  evidence_id = scalartext(database,"SELECT mention_id FROM mentions WHERE concept_id='" || child || "' AND visible_to_generation IS NULL LIMIT 1")
  evidence = '[{"evidence_id":' || jsonquote(evidence_id) || ',"quote":"Platform"}]'
  response = changestr('"canonical_label":""',responsejson("synonym","","[]",evidence,child),'"canonical_label":"Platform Alias"')
  errors = errors + check(runresolution(store,job_id,review_task,response,error) = 0 & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || review_task || "'") = "review", "supervised resolution awaits review " || error)
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || review_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0, "accept grounded resolution review " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM aliases WHERE target_concept_id='" || child || "' AND normalized_alias='platform alias' AND visible_to_generation IS NULL") = 1, "review publishes validated synonym")
  errors = errors + check(inspectbacklog(database,workflow) \= "" & inspectbacklog(database,review_task) \= "", "tasks and workflow are inspectable")
  investigation_task = ""
  errors = errors + check(enqueuebacklogtask(database,"investigation-review","concept",child,"","",999999,policy,investigation_task,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "queue supervised investigation")
  errors = errors + check(runresolution(store,job_id,investigation_task,responsejson("investigate","","[]","[]","","Which source distinguishes the two Platform meanings?"),error) = 0, "record supervised investigation")
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || investigation_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE parent_task_id='" || investigation_task || "' AND kind='follow-up' AND question='Which source distinguishes the two Platform meanings?'") = 1, "reviewed investigation creates its focused durable follow-up " || error)
  defer_supervised = changestr("retain investigate",supervised,"retain investigate defer")
  defer_supervised = scalartext(database,"SELECT json_set(" || _testquote(defer_supervised) || ",'$.evidence_expected',1)")
  defer_policy = .jsondocument(defer_supervised)
  defer_task = ""
  errors = errors + check(enqueuebacklogtask(database,"defer-review-test","concept",child,"","",999999,defer_policy,defer_task,error) = 0 & nextwindow(store,defer_supervised,job_id,error) = 0, "queue supervised defer")
  until_text = scalartext(database,"SELECT strftime('%Y-%m-%dT%H:%M:%SZ','now','+6 months')")
  errors = errors + check(runresolution(store,job_id,defer_task,responsejson("defer","","[]","[]","","Await scheduled source release","{}",until_text),error) = 0, "record supervised defer " || error)
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || defer_task || "' AND state='pending'")
  errors = errors + check(review_id<>"" & reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0 & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || defer_task || "'") = "unresolved" & scalarint(database,"SELECT count(*) FROM maintenance_decisions WHERE task_id='" || defer_task || "' AND disposition='defer:review:accept' AND json_extract(response_json,'$.action')='defer'") = 1, "accepted defer retains unresolved task and exact decision " || error)

  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'") = 0 & tickbacklogwindow(store,job_id,error) = 1, "deadline closes window")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "deadline" & scalarint(database,"SELECT count(*) FROM job_items WHERE job_id='" || job_id || "' AND state='queued'") = 0, "deadline checkpoints unstarted work")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "final SQLite integrity")
  /* Merge uses the same durable fan-out, with one explicitly selected
   * survivor. A resulting self-edge must be retracted, never silently copied. */
  merge_task = ""
  errors = errors + check(enqueuebacklogtask(database,"merge-test","concept","concept-peer","","",999999,policy,merge_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue merge workflow " || error)
  evidence = '[{"evidence_id":"mention-peer","quote":"Peer"}]'
  errors = errors + check(runresolution(store,job_id,merge_task,responsejson("merge",child,"[]",evidence,"concept-peer"),error) = 0, "create grounded merge workflow " || error)
  merge_workflow = scalartext(database,"SELECT workflow_id FROM maintenance_workflows WHERE parent_concept_id='concept-peer'")
  errors = errors + check(merge_workflow \= "" & scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-peer'") = "migration-parent", "merge keeps its parent until migration completes")
  /* The survivor can already own the old spelling while the parent still
   * has connections to migrate. It must be the only extraction identity. */
  generation = scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(sqliteexec(database,"INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,visible_from_generation) VALUES('alias-merging-peer','peer','" || child || "'," || generation || ")") = 0,"seed survivor alias before parent retirement")
  merging_label = ""; merging_identity = ""
  errors = errors + check(resolveknownconcept(database,"Peer","concept",merging_label,merging_identity,error) = 1 & merging_identity = child,"REL-013 resolves active survivor while merge parent remains visible")
  extraction_input = '{"revision_chunk_id":"chunk-lifecycle","charging_basis":"local-compute"}'
  errors = errors + check(sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('job-rel013','" || rxhash..sha256hex('job-rel013' as .binary) || "','{}','snapshot-lifecycle','queued',1,1,128,64,0,'fixture','fixture'); INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-rel013','job-rel013','claim-extraction','queued',1,'idem-rel013','" || rxhash..sha256hex(extraction_input as .binary) || "','" || extraction_input || "','fixture','fixture')") = 0,"REL-013 extraction fixture")
  errors = errors + check(configurejobbudget(store,"job-rel013",10000,128,64,0,5000,1,1,error) = 0,"REL-013 budget " || error)
  extracting_provider = .mergingextractionprovider(); extracting_disposition = ""
  errors = errors + check(runworkeronce(store,"job-rel013","extracting-worker",60,1,claim_policy,extracting_provider,extracting_disposition,error,genericprofile()) = 0 & extracting_disposition = "concepts-and-notes","REL-013 publishes stale response against active survivor " || extracting_disposition || " " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items WHERE item_id='item-rel013' AND state='processed'") = 1 & scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || child || "' AND span_start=9 AND span_end=13") > 0,"REL-013 completes item and grounds survivor mention")
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-peer'") = "migration-parent","REL-013 never revives merge parent")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "dispatch merge connections")
  mention_task = connectiontask(database,merge_workflow,"mention")
  errors = errors + check(runresolution(store,job_id,mention_task,responsejson("move",child,"[]",evidence),error) = 0, "move merge mention " || error)
  support_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN claim_support s ON s.support_id=t.subject_id JOIN claims c ON c.claim_id=s.claim_id WHERE t.workflow_id='" || merge_workflow || "' AND t.state='dispatched' AND c.target_concept_id='concept-peer'")
  support_id = scalartext(database,"SELECT subject_id FROM maintenance_tasks WHERE task_id='" || support_task || "'")
  evidence = '[{"evidence_id":' || jsonquote(support_id) || ',"quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("retract","","[]",evidence),error) = 0, "explicitly retract self-edge support during merge " || error)
  support_task = connectiontask(database,merge_workflow,"support")
  support_id = scalartext(database,"SELECT subject_id FROM maintenance_tasks WHERE task_id='" || support_task || "'")
  evidence = '[{"evidence_id":' || jsonquote(support_id) || ',"quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,support_task,responsejson("move",child,"[]",evidence),error) = 0, "move remaining independent merge support " || error)
  stale_conflict=connectiontask(database,merge_workflow,"conflict"); before_stale=scalarint(database,"SELECT count(*) FROM provider_runs")
  errors=errors+check(stale_conflict<>"" & runresolution(store,job_id,stale_conflict,responsejson("unresolved"),error)=0,"drain obsolete merge retirement conflict work " || error)
  errors=errors+check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(stale_conflict))="superseded" & scalarint(database,"SELECT count(*) FROM provider_runs")=before_stale,"obsolete merge retirement conflict drains without a provider call")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "refresh merge retirement census")
  retire_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE workflow_id='" || merge_workflow || "' AND kind='retirement' AND state='dispatched'")
  errors = errors + check(retire_task \= "" & runresolution(store,job_id,retire_task,responsejson("retire","","[]","[]","concept-peer"),error) = 0, "complete merge retirement " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_workflows WHERE workflow_id='" || merge_workflow || "'") = "complete" & scalarint(database,"SELECT count(*) FROM claims WHERE source_concept_id=target_concept_id AND visible_to_generation IS NULL") = 0, "merge completes without self relationships")

  /* A conflict answer must address every support and preserve the original
   * claim, its quotations and the unaffected competing claim as history. */
  live_claim = scalartext(database,"SELECT claim_id FROM claims WHERE source_concept_id='" || child || "' AND target_concept_id='concept-survivor' AND visible_to_generation IS NULL")
  live_support = scalartext(database,"SELECT support_id FROM claim_support WHERE claim_id='" || live_claim || "' AND visible_to_generation IS NULL LIMIT 1")
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) SELECT 'claim-context-test',source_concept_id,relationship_type,target_concept_id,direction,json_object('scope','other'),policy_version," || generation || " FROM claims WHERE claim_id='" || live_claim || "'") = 0, "seed scoped competing claim")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) SELECT 'support-context-test','claim-context-test',revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity," || generation || " FROM claim_support WHERE support_id='" || live_support || "'") = 0, "seed competing source support")
  errors = errors + check(sqliteexec(database,"INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-context-test','" || live_claim || "','claim-context-test','pending'," || generation || ")") = 0, "seed contextual conflict")
  conflict_task = ""
  errors = errors + check(enqueuebacklogtask(database,"qualification-test","conflict","conflict-context-test","","",999999,policy,conflict_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue source-scoped conflict resolution")
  evidence = '[{"evidence_id":' || jsonquote(live_support) || ',"quote":"Platform Peer"}]'
  errors = errors + check(validatebacklogresponse(database,conflict_task,responsejson("qualify","","[]",evidence,live_claim,"",'{"scope":"documented"}',"1689","1690"),grounds,error) \= 0, "reject conflict answer that omits competing support")
  evidence = left(evidence,length(evidence)-1) || ',{"evidence_id":"support-context-test","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,conflict_task,responsejson("qualify","","[]",evidence,live_claim,"",'{"scope":"documented"}',"1689","1690"),error) = 0, "apply supported temporal and scope qualification " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='" || live_claim || "' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE effective_from='1689' AND effective_to='1690' AND json_extract(qualifiers_json,'$.scope')='documented' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='claim-context-test' AND visible_to_generation IS NULL") = 1, "qualification preserves old claim and unaffected competing claim")

  /* Missing links reuse the authoritative SQLite vector, without embedding
   * calls or changing source/chunk identities. */
  embedding_policy = '{"embedding_profile":"fixture-embedding","embedding_envelope":"fixture-envelope",' || substr(policy_json,2)
  digest = rxhash..sha256hex(("content-digest-lifecycle" || "00"x || "fixture-envelope") as .binary)
  errors = errors + check(sqliteexec(database,"INSERT INTO embedding_profiles(embedding_profile_id,provider_id,model,dimension,input_envelope_fingerprint,created_at) VALUES('fixture-embedding','fixture','fixture',1,'fixture','fixture'); INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,created_at) VALUES('fixture-vector','" || digest || "','fixture-embedding',X'0000803F',1,'fixture')") = 0, "seed authoritative vector without link")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  previous_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(nextwindow(store,embedding_policy,job_id,error) = 0, "discover missing embedding link " || error)
  errors = errors + check(scalarint(database,"SELECT visible_from_generation FROM revision_chunk_embeddings WHERE embedding_id='fixture-vector'") > previous_generation, "cached embedding repair publishes a new membership without changing historic generations")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM revision_chunk_embeddings WHERE embedding_id='fixture-vector' AND revision_chunk_id='chunk-lifecycle' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "SQLite vector link recovery makes zero provider calls")
  errors = errors + check(scalartext(database,"SELECT hex(vector) FROM embeddings WHERE embedding_id='fixture-vector'") = "0000803F" & scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer", "all lifecycle work preserves source text and vector bytes")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "full workflow SQLite integrity")
  /* Explicit identity questions reuse established typed concepts and retain
   * different senses without treating spelling equality as identity. */
  generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  errors = errors + check(sqliteexec(database,"INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,visible_from_generation) VALUES('alias-peer-survivor','peer','" || child || "'," || generation || "); INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('candidate-reuse','chunk-lifecycle','peer',9,13,'fixture-resolution'," || generation || "),('candidate-distinct','chunk-lifecycle','peer',9,13,'fixture-resolution'," || generation || "); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('candidate-reuse-decision','candidate-reuse',1,'accepted','{}','fixture','fixture'),('candidate-distinct-decision','candidate-distinct',1,'accepted','{}','fixture','fixture')") = 0, "seed identity questions")
  aliases = .string[]; aliases[1] = "Peer"
  errors = errors + check(recordaliasissue(database,"candidate-reuse","Peer","concept",aliases,error) = 0, "preserve unresolved reuse question")
  label = ""; selected = ""
  errors = errors + check(resolveknownconcept(database,"PEER","concept",label,selected,error) = 1 & selected = child, "unique typed catalogue reuse is deterministic")
  errors=errors+check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('inactive-peer','Peer','concept','migration-parent'," || generation || ")")=0,"inactive homonym before packet selection")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0, "dispatch identity resolution")
  alias_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN maintenance_alias_issues i ON i.issue_id=t.subject_id WHERE i.candidate_id='candidate-reuse' AND t.state='dispatched'")
  evidence = '[{"evidence_id":"candidate-reuse","quote":"peer"}]'
  packet=scalartext(database,"SELECT evidence_json FROM maintenance_tasks WHERE task_id='" || alias_task || "'")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM maintenance_tasks t,json_each(t.evidence_json,'$.subject.candidates') c WHERE t.task_id='" || alias_task || "' AND json_extract(c.value,'$.concept_id')='inactive-peer'")=0,"migration parents not offered as usable candidates")
  errors=errors+check(pos('"lifecycle_state":"active"',packet)>0,"candidate lifecycle explicit")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(packet) || ",'$.subject.candidate_cluster') WHERE json_extract(value,'$.concept_id')=" || _testquote(child) || " AND json_type(value,'$.aliases')='array' AND json_type(value,'$.source_scopes')='array' AND json_type(value,'$.mention_count')='integer'")=1,"identity candidate cluster includes aliases, provenance scope and defining-passage count")
  errors=errors+check(scalarint(database,"SELECT count(*) FROM json_each(" || _testquote(packet) || ",'$.passages') WHERE json_extract(value,'$.evidence_id') IN(SELECT mention_id FROM mentions WHERE concept_id=" || _testquote(child) || " AND visible_to_generation IS NULL)")>0,"identity candidate defining passages retain addressable source evidence")
  references=.ragresolutionreferences('{"resolution_contract":"crexx-rag.resolution-contract/5","evidence":' || packet || '}')
  mapping=references.mapping()
  chosen_ref=scalartext(database,"SELECT key FROM json_each(" || _testquote(mapping) || ") WHERE key LIKE 'C%' AND value=" || _testquote(child))
  evidence_ref=scalartext(database,"SELECT key FROM json_each(" || _testquote(mapping) || ") WHERE key LIKE 'E%' AND value='candidate-reuse'")
  errors=errors+check(chosen_ref<>"" & evidence_ref<>"","identity packet has concept and evidence references")
  short_evidence='[{"evidence_id":' || jsonquote(evidence_ref) || ',"quote":"peer"}]'
  expanded=references.response(responsejson("reuse",chosen_ref,"[]",short_evidence),error)
  errors=errors+check(error="" & expanded=responsejson("reuse",child,"[]",evidence),"short identity selection expands before canonical validation")
  other_ref=scalartext(database,"SELECT key FROM json_each(" || _testquote(mapping) || ") m WHERE key LIKE 'C%' AND NOT EXISTS(SELECT 1 FROM json_each(" || _testquote(packet) || ",'$.subject.candidates') c WHERE json_extract(c.value,'$.concept_id')=m.value) LIMIT 1")
  errors=errors+check(other_ref<>"","catalogue control includes a concept outside the identity candidates")
  inappropriate=references.response(responsejson("reuse",other_ref,"[]",short_evidence),error)
  grounds=""
  errors=errors+check(error="" & validatebacklogresponse(database,alias_task,inappropriate,grounds,error)<>0 & pos("candidate supplied",error)>0,"known catalogue reference cannot bypass identity eligibility")
  errors=errors+check(sqliteexec(database,"UPDATE concepts SET lifecycle_state='retired' WHERE concept_id='" || child || "'")=0,"retire candidate after dispatch")
  grounds=""
  errors=errors+check(validatebacklogresponse(database,alias_task,expanded,grounds,error)<>0 & pos("maintain refresh-plan",error)>0,"expanded reference cannot bypass mid-call retirement and names supported refresh")
  errors=errors+check(sqliteexec(database,"UPDATE concepts SET lifecycle_state='active' WHERE concept_id='" || child || "'; UPDATE concepts SET lifecycle_state='retired' WHERE concept_id='inactive-peer'")=0,"restore candidate positive control")
  errors = errors + check(runresolution(store,job_id,alias_task,responsejson("reuse",child,"[]",evidence),error) = 0, "apply quoted catalogue reuse " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE candidate_id='candidate-reuse' AND state='resolved'") = 1 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind LIKE 'alias-follow-up:%'") = 1, "identity answer queues a durable extraction follow-up")
  errors = errors + check(recordaliasissue(database,"candidate-distinct","Peer","source-artifact",aliases,error) = 0 & nextwindow(store,supervised,job_id,error) = 0, "dispatch distinct sense")
  alias_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN maintenance_alias_issues i ON i.issue_id=t.subject_id WHERE i.candidate_id='candidate-distinct' AND t.state='dispatched'")
  evidence = '[{"evidence_id":"candidate-distinct","quote":"Peer"}]'
  response = changestr('"canonical_label":""',responsejson("distinct","","[]",evidence),'"canonical_label":"Peer Document"')
  response = changestr('"concept_type":""',response,'"concept_type":"source-artifact"')
  errors = errors + check(runresolution(store,job_id,alias_task,response,error) = 0, "retain distinct typed sense " || error)
  review_id = scalartext(database,"SELECT review_id FROM reviews WHERE subject_id='" || alias_task || "' AND state='pending'")
  errors = errors + check(reviewbacklogdecision(store,review_id,"accept",genericprofile(),error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='alias-follow-up:chunk'") >= 1, "reviewed identity decision retains its extraction follow-up or running owner " || error)

  errors = errors + check(scalarint(database,"SELECT count(DISTINCT target_concept_id) FROM aliases WHERE normalized_alias='peer' AND target_concept_id IS NOT NULL AND visible_to_generation IS NULL") = 2 & scalarint(database,"SELECT count(*) FROM aliases WHERE normalized_alias='peer' AND ambiguity_id IS NOT NULL AND visible_to_generation IS NULL") > 0, "shared spelling retains both identities and explicit ambiguity")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE state='open'") = 0, "automatic and supervised identity workflows settle their questions")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0, "identity resolution foreign keys")
  /* A concurrent evidence edit after admission must retain the paid decision
   * without publishing an empty or stale semantic generation. */
  stale_task = ""
  errors = errors + check(enqueuebacklogtask(database,"stale-after-call","concept","concept-survivor","","",999999,policy,stale_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0, "queue post-call stale decision")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || stale_task || "') AND state='queued'") = 0, "select post-call stale fixture")
  previous_generation = scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  stale_provider = .staleprovider(database,responsejson("retire","","[]","[]","concept-survivor"))
  errors = errors + check(runworkeronce(store,job_id,"stale-fixture",60,3,claim_policy,stale_provider,disposition,error,genericprofile()) = 0, "settle stale result " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || stale_task || "'") = "superseded" & scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1") = previous_generation, "stale result creates no semantic generation")

  /* A settled response remains usable in the next window even when the
   * original task has already consumed its one permitted paid call. */
  recovery_task = ""
  capped_policy = changestr('"maximum_attempts":3',policy_json,'"maximum_attempts":1')
  errors = errors + check(enqueuebacklogtask(database,"closed-window-recovery","concept","concept-survivor","","",999999,policy,recovery_task,error) = 0 & nextwindow(store,capped_policy,job_id,error) = 0, "queue capped recovery fixture")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select capped recovery")
  errors = errors + check(claimnext(store,job_id,"crashed-window-fixture",60,1,claim,error) = 0 & reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0, "claim capped recovery")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","settled-at-window-boundary","succeeded",10,10,0,1,settled_run,error,"","local-compute",1,"",responsejson("unresolved"),ragsha256(canonicalprofile(genericprofile()))) = 0, "settle at window boundary")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'; UPDATE job_items SET lease_until=0 WHERE item_id='" || claim.item_id() || "'") = 0 & tickbacklogwindow(store,job_id,error) >= 0, "close expired window")
  recovery_claim = .ragworkclaim
  errors = errors + check(claimnext(store,"","recovery-only",60,1,recovery_claim,error,0) = 1 & nextwindow(store,capped_policy,job_id,error) = 0, "recover lease before next window " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || recovery_task || "') AND state='queued'") = 0, "select cached cross-window result")
  errors = errors + check(runworkeronce(store,job_id,"new-window-worker",60,1,claim_policy,provider,disposition,error,genericprofile()) = 0 & disposition = "resolution-recorded", "reuse settled output at paid-attempt cap " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || recovery_task || "'") = "unresolved" & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "cross-window recovery makes zero duplicate calls")

  /* An already considered prefix must not close a small-batch census before
   * later notes are seen. Manual collection stays zero-call, then automatic
   * mode can resume its unattempted questions. */
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "pause before cursor fixture")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_tasks SET state='resolved' WHERE state IN('pending','review','dispatched')") = 0, "simulate previously considered task prefix")
  do i = 1 to 5
    id = "zz-cursor-note-" || i
    errors = errors + check(sqliteexec(database,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('" || id || "','lead','Platform Peer',1,1,'','active','{}','fixture',1,'fixture','fixture'); INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('" || id || "-link','" || id || "','chunk','chunk-lifecycle','chunk-lifecycle',0,13)") = 0, "seed cursor note")
  end
  errors = errors + check(sqliteexec(database,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('zz-informational-note','observation','A source annotation',1,1,'','active','{}','fixture',1,'fixture','fixture')") = 0,"seed retrievable informational note")
  errors = errors + check(sqliteexec(database,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('zz-informational-recommendation','recommendation','A source annotation with no action',1,1,'','active','{}','fixture',1,'fixture','fixture')") = 0,"seed recommendation without an actionable next step")
  manual_policy = changestr('"mode":"automatic"',changestr('"batch_items":100',policy_json,'"batch_items":1'),'"mode":"manual"')
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(nextwindow(store,manual_policy,job_id,error) = 0, "start manual small-batch census")
  do tick = 1 to 100
    if scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") \= "active" then leave
    if tickbacklogwindow(store,job_id,error) < 0 then do; errors = errors+check(0,"manual census " || error); leave; end
  end
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_id LIKE 'zz-cursor-note-%' AND state='review'") = 5 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_id IN('zz-informational-note','zz-informational-recommendation')") = 0 & scalarint(database,"SELECT count(*) FROM analysis_notes WHERE note_id IN('zz-informational-note','zz-informational-recommendation') AND state='active'") = 2 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous, "complete cursor coverage and informational notes stay read-only")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_id LIKE 'zz-cursor-note-%' AND state='dispatched'") = 5, "automatic window resumes manually collected work")
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0, "close test window")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0 & scalartext(database,"PRAGMA integrity_check") = "ok", "final backlog integrity")
  /* A diagnostic is not a search question. Preserve the recorded question
   * in the provider packet and use it to select source evidence. */
  gap_warning = "One or more query names remain ambiguous; do not transfer facts between senses."
  gap_question = 'How does "Platform" relate to Peer?'
  errors = errors + check(sqliteexec(database,"INSERT INTO query_gaps(gap_id,question_hash,normalized_question,gap_text,trace_id,observed_generation,occurrence_count,state,first_observed_at,last_observed_at) VALUES('gap-platform','question-platform','" || gap_question || "','" || gap_warning || "','trace-platform',1,1,'open','fixture','fixture'),('gap-missing','question-missing','Where is Vestiarium Scoticum?','" || gap_warning || "','trace-missing',1,1,'open','fixture','fixture'),('gap-stopwords','question-stopwords','what which how','" || gap_warning || "','trace-stopwords',1,1,'open','fixture','fixture')") = 0,"seed different query questions with the same warning")
  packet = ""; fingerprint = ""
  errors = errors + check(buildbacklogevidence(database,"gap","gap-platform","",65536,packet,fingerprint,error) = 0,"build original query evidence " || error)
  errors = errors + check(pos('"question":' || jsonquote(gap_question),packet) > 0 & pos('"text":' || jsonquote(gap_warning),packet) > 0,"gap packet retains question and diagnostic separately")
  errors = errors + check(pos('"revision_chunk_id":"chunk-lifecycle"',packet) > 0 & pos('"text":"Platform Peer"',packet) > 0,"gap selects source passage using question subject")
  errors = errors + check(buildbacklogevidence(database,"gap","gap-missing","",65536,packet,fingerprint,error) = 0 & pos('"passages":[]',packet) > 0,"same warning with absent question terms returns no invented evidence")
  errors = errors + check(buildbacklogevidence(database,"gap","gap-stopwords","",65536,packet,fingerprint,error) = 0 & pos('"passages":[]',packet) > 0,"empty useful question never falls back to warning words")
  errors = errors + check(sqliteexec(database,"INSERT INTO maintenance_tasks(task_id,kind,subject_type,subject_id,evidence_fingerprint,policy_fingerprint,evidence_json,question,state,priority,created_epoch,updated_epoch) VALUES('task:legacy-gap','query-gap','gap','gap-platform','old-warning-only-evidence','fixture-v1','{}','Investigate the issue','unresolved',750000,0,0)") = 0,"seed unresolved warning-only maintenance record")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs"); previous_generation = scalarint(database,"SELECT published_generation FROM library_meta")
  gap_task = ""; replay_task = ""
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,gap_task,error) = 0 & gap_task \= "","refresh existing gap with original question " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='task:legacy-gap'") = "superseded","new evidence supersedes unresolved warning-only interpretation")
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,replay_task,error) = 0 & replay_task = gap_task,"corrected gap task is idempotent")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalarint(database,"SELECT published_generation FROM library_meta") = previous_generation & scalarint(database,"SELECT count(*) FROM query_gaps WHERE state='open'") = 3,"evidence refresh preserves gaps and generation with zero provider calls")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0,"normal maintenance discovers corrected query gaps " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE subject_type='gap' AND state='dispatched'") = 3,"all query gaps enter ordinary durable maintenance")
  evidence = '[{"evidence_id":"chunk-lifecycle","quote":"Platform Peer"}]'
  errors = errors + check(runresolution(store,job_id,gap_task,responsejson("retain","","[]",evidence),error) = 0 & scalartext(database,"SELECT state FROM query_gaps WHERE gap_id='gap-platform'") = "resolved","grounded maintenance can settle an investigated gap " || error)
  resolved_gap_task = gap_task; settled_gap = ""
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,settled_gap,error) = 0 & settled_gap = resolved_gap_task,"settled query gap stays closed on unchanged rediscovery " || error)
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('unrelated-catalogue','Unrelated catalogue entry','concept','active',(SELECT published_generation FROM library_meta)); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('unrelated-catalogue-mention','unrelated-catalogue','chunk-lifecycle',0,1,(SELECT published_generation FROM library_meta))") = 0,"add unrelated catalogue identity on a settled gap passage")
  settled_gap = ""
  errors = errors + check(enqueuebacklogtask(database,"query-gap","gap","gap-platform","","",750000,policy,settled_gap,error) = 0 & settled_gap = resolved_gap_task & scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE parent_task_id='" || resolved_gap_task || "'") = 0,"unrelated catalogue growth does not reopen settled gap " || error)
  errors = errors + check(sqliteexec(database,"DELETE FROM mentions WHERE mention_id='unrelated-catalogue-mention'; DELETE FROM concepts WHERE concept_id='unrelated-catalogue'") = 0,"remove unrelated catalogue fixture")
  gap_task = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE subject_id='gap-missing' AND state='dispatched'")
  previous_generation=scalarint(database,"SELECT published_generation FROM library_meta")
  insufficient=responsejson("insufficient-evidence","","[]","[]","","A new source passage identifying Vestiarium Scoticum in this question's context")
  grounds=""
  errors=errors+check(validatebacklogresponse(database,gap_task,responsejson("insufficient-evidence"),grounds,error)<>0 & pos("reopening trigger",error)>0,"insufficient evidence requires a material reopening trigger")
  errors = errors + check(runresolution(store,job_id,gap_task,insufficient,error) = 0 & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || gap_task || "'") = "review","unapproved insufficient conclusion retains review authority " || error)
  insufficient_review=scalartext(database,"SELECT review_id FROM reviews WHERE subject_id=" || _testquote(gap_task) || " AND state='pending'")
  errors=errors+check(insufficient_review<>"" & reviewbacklogdecision(store,insufficient_review,"accept",genericprofile(),error)=0 & scalartext(database,"SELECT state FROM query_gaps WHERE gap_id='gap-missing'")="open" & scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id=" || _testquote(gap_task))="resolved" & scalarint(database,"SELECT published_generation FROM library_meta")=previous_generation,"reviewed insufficient evidence settles the question without graph publication " || error)
  settled_gap=""
  errors=errors+check(enqueuebacklogtask(database,"query-gap","gap","gap-missing","","",750000,policy,settled_gap,error)=0 & settled_gap=gap_task,"final insufficient evidence remains settled on unchanged context " || error)
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"close query-gap test window")
  errors = errors + check(scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-lifecycle'") = "Platform Peer" & scalartext(database,"SELECT hex(vector) FROM embeddings WHERE embedding_id='fixture-vector'") = "0000803F" & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"query-gap maintenance preserves source and vector state")
  /* Budget completion is a successful boundary, with uncalled tasks retained
   * for the next window and no failed attempt manufactured by the loser. */
  bounded_policy = changestr('"maximum_attempts":3',changestr('"model_calls":100',changestr('"inflight":1',policy_json,'"inflight":2'),'"model_calls":1'),'"maximum_attempts":1')
  budget_first = ""; budget_peer = ""
  errors = errors + check(enqueuebacklogtask(database,"budget-first","concept","concept-survivor","","",1000000,policy,budget_first,error) = 0 & enqueuebacklogtask(database,"budget-peer","concept","concept-survivor","","",1000000,policy,budget_peer,error) = 0 & nextwindow(store,bounded_policy,job_id,error) = 0,"start final-call race fixture " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000002 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || budget_first || "'); UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || budget_peer || "')") = 0,"select budget race claims")
  peer_provider = .budgetpeerprovider(store)
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(runworkeronce(store,job_id,"budget-owner",60,1,claim_policy,peer_provider,disposition,error,genericprofile()) = 0,"finish admitted final call " || error)
  errors = errors + check(peer_provider.peer_status() = 1 & peer_provider.peer_disposition() = "budget-deferred" & peer_provider.peer_error() = "","peer waits cleanly at reserved call limit " || peer_provider.peer_error())
  errors = errors + check(runworkeronce(store,job_id,"budget-owner",60,1,claim_policy,provider,disposition,error,genericprofile()) = 1 & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "budget-exhausted","worker stops normally after final settlement " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_runs") = previous+1 & scalarint(database,"SELECT count(*) FROM attempts a JOIN job_items i USING(item_id) WHERE i.job_id='" || job_id || "' AND a.outcome IN('failed','dead_letter')") = 0,"one paid call and no budget failure")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || budget_peer || "'") = "pending" & scalarint(database,"SELECT count(*) FROM attempts a JOIN maintenance_task_items m USING(item_id) WHERE m.task_id='" || budget_peer || "' AND a.provider_run_id IS NOT NULL") = 0 & scalarint(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='" || job_id || "'") = 0,"uncalled peer keeps its full retry allowance and reservations are drained")
  errors = errors + check(nextwindow(store,bounded_policy,job_id,error) = 0 & runresolution(store,job_id,budget_peer,responsejson("unresolved"),error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous+2,"next plan resumes uncalled work " || error)
  errors = errors + check(tickbacklogwindow(store,job_id,error) >= 0 & scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"final-call fixture integrity")
  /* Closing the window after claims were taken must still let admitted work
   * settle, while the uncalled claim returns to the backlog without error. */
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & claimnext(store,job_id,"deadline-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"deadline-peer",60,1,recovery_claim,error) = 0,"claim deadline race peers")
  errors = errors + check(reservecall(store,claim,100001,10000,0,1000,reservation,error) < 0 & error = "provider call exceeds the per-call cap","invalid reservation remains an error")
  errors = errors + check(reservecall(store,claim,100000,10000,0,1000,reservation,error) = 0,"reserve before window close")
  duplicate = .ragcallreservation
  errors = errors + check(reservecall(store,claim,100000,10000,0,1000,duplicate,error) < 0 & scalartext(database,"SELECT outcome FROM attempts WHERE attempt_id='" || claim.attempt_id() || "'") = "running","duplicate reservation cannot defer an admitted call")
  errors = errors + check(sqliteexec(database,"UPDATE maintenance_windows SET deadline_epoch=unixepoch() WHERE job_id='" || job_id || "'") = 0 & tickbacklogwindow(store,job_id,error) = 1 & reservecall(store,recovery_claim,100000,10000,0,1000,duplicate,error) = 1 & error = "","closed window defers its uncalled claim cleanly")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","deadline-final-call","succeeded",10,10,0,1,settled_run,error) = 0 & skipitem(store,claim,"fixture settled admitted call",error) = 0,"finish call admitted before deadline " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM jobs WHERE job_id='" || job_id || "'") = "completed" & scalarint(database,"SELECT count(*) FROM maintenance_tasks t JOIN maintenance_task_items m USING(task_id) WHERE m.item_id='" || recovery_claim.item_id() || "' AND t.state='pending'") = 1,"deadline completes job and preserves uncalled task")
  closed_epoch = scalarint(database,"SELECT closed_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")
  previous = scalarint(database,"SELECT count(*) FROM provider_runs")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM maintenance_tasks t JOIN maintenance_task_items m USING(task_id) WHERE m.item_id='" || claim.item_id() || "' AND t.state='resolved'") = 1,"closed window reconciles its final settled task " || error)
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalarint(database,"SELECT count(*) FROM provider_runs") = previous & scalarint(database,"SELECT closed_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'") = closed_epoch & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "deadline","closed reconciliation is idempotent and cannot reopen work")
  /* Two overlapping calls may accumulate more provider minutes than wall
   * minutes. Disabling the explicit provider cap must admit both and continue. */
  closing_task = ""
  errors = errors + check(enqueuebacklogtask(database,"alias-follow-up:closed-worker","chunk","chunk-lifecycle","","",1000000,policy,closing_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"queue final extraction fixture " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000002 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || closing_task || "')") = 0,"select closing extraction")
  closing_provider = .closingextractionprovider(store)
  errors = errors + check(runworkeronce(store,job_id,"last-worker",60,1,claim_policy,closing_provider,disposition,error,genericprofile()) = 0 & closing_provider.closed() = 1,"finish extraction after concurrent window closure " || error)
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_tasks WHERE task_id='" || closing_task || "'") = "resolved" & scalarint(database,"SELECT reserved_calls FROM jobs WHERE job_id='" || job_id || "'") = 0,"last worker reconciles before stopping without another poll")

  time_policy = changestr('"time_ms":1000',changestr('"inflight":1',policy_json,'"inflight":2'),'"time_ms":700000')
  resolved_timing = ""
  errors = errors + check(resolvemaintenancetime(database,"","","",1000,resolved_timing,error,scalarint(database,"SELECT unixepoch()")-30) = 0,"resolve duration before simulated preparation")
  time_policy = '{"timing":' || jsonquote(resolved_timing) || ',"provider_time_budget_ms":0,' || substr(time_policy,2)
  errors = errors + check(nextwindow(store,time_policy,job_id,error) = 0,"open independent wall-time window " || error)
  original_deadline = scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'")
  errors = errors + check(original_deadline>=scalarint(database,"SELECT unixepoch()")+998,"duration begins at activation after preparation")
  errors = errors + check(claimnext(store,job_id,"time-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"time-peer",60,1,recovery_claim,error) = 0,"claim parallel time peers")
  errors = errors + check(reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0 & reservecall(store,recovery_claim,100000,10000,0,700000,duplicate,error) = 0,"parallel reservations do not consume wall duration " || error)
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","time-owner","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0,"settle first simulated long call")
  errors = errors + check(settlecall(store,duplicate,"fixture","fixture","time-peer","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,recovery_claim,"time fixture",error) = 0,"settle second simulated long call")
  errors = errors + check(tickbacklogwindow(store,job_id,error) = 0 & scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "active","sum of parallel durations cannot close wall window")
  errors = errors + check(claimnext(store,job_id,"time-restarted-worker",60,1,claim,error) = 0 & reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0,"restart admits work after accumulated duration exceeds wall allowance")
  errors = errors + check(scalarint(database,"SELECT deadline_epoch FROM maintenance_windows WHERE job_id='" || job_id || "'") = original_deadline,"worker restart retains deadline")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","time-restarted","succeeded",10,10,0,1,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0,"settle restarted worker")
  errors = errors + check(pausejob(store,job_id,error) = 0 & tickbacklogwindow(store,job_id,error) >= 0,"pause time fixture")
  limited_policy = changestr('"provider_time_budget_ms":0',time_policy,'"provider_time_budget_ms":1000000')
  errors = errors + check(nextwindow(store,limited_policy,job_id,error) = 0 & claimnext(store,job_id,"cap-owner",60,1,claim,error) = 0 & claimnext(store,job_id,"cap-peer",60,1,recovery_claim,error) = 0,"open explicit provider-time cap")
  errors = errors + check(reservecall(store,claim,100000,10000,0,700000,reservation,error) = 0 & reservecall(store,recovery_claim,100000,10000,0,700000,duplicate,error) = 1,"explicit aggregate cap still counts concurrent reservations")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","cap-owner","succeeded",10,10,0,600000,settled_run,error) = 0 & skipitem(store,claim,"time fixture",error) = 0 & tickbacklogwindow(store,job_id,error) = 1,"explicit provider-time limit closes successfully")
  errors = errors + check(scalartext(database,"SELECT state FROM maintenance_windows WHERE job_id='" || job_id || "'") = "budget-exhausted" & scalarint(database,"SELECT reserved_calls FROM jobs WHERE job_id='" || job_id || "'") = 0,"explicit cap has clean settlement")
  /* A prior correction retained the ID derived from the former type. New
   * extraction must preserve a repair question rather than fail the batch. */
  collision_id = "concept-sha256:" || rxhash..sha256hex(("platform" || "00"x || "evidence-span") as .binary)
  generation = scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(sqliteexec(database,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('" || collision_id || "','Platform','concept','active'," || generation || ")") = 0,"seed retained ID after type correction")
  collision_task = ""
  errors = errors + check(enqueuebacklogtask(database,"alias-follow-up:identity-collision","chunk","chunk-lifecycle","","",1000000,policy,collision_task,error) = 0 & nextwindow(store,policy_json,job_id,error) = 0,"dispatch colliding extraction " || error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT item_id FROM maintenance_task_items WHERE task_id='" || collision_task || "') AND state='queued'") = 0,"select colliding extraction")
  collision_provider = .identitycollisionprovider()
  identity_policy = .ragclaimpolicy("fixture-v1","concept|source-artifact|evidence-span","related-to|mentioned-in|mentions",1000000,750000,500000,-1000000,250000)
  errors = errors + check(runworkeronce(store,job_id,"identity-fixture",60,3,identity_policy,collision_provider,disposition,error,genericprofile()) = 0 & disposition = "concepts-and-notes","collision becomes durable repair instead of batch failure " || disposition || " " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE candidate_id='candidate-identity-collision' AND state='open'") = 1,"retain one identity repair issue")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0,"dispatch identity and deep classification review " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_tasks WHERE kind='identity-review' AND subject_id='" || collision_id || "'") > 0,"conflicting classification receives deep source review")
  alias_task = scalartext(database,"SELECT t.task_id FROM maintenance_tasks t JOIN maintenance_alias_issues i ON i.issue_id=t.subject_id WHERE i.candidate_id='candidate-identity-collision' AND t.state='dispatched'")
  evidence = '[{"evidence_id":"candidate-identity-collision","quote":"Platform"}]'
  response = changestr('"canonical_label":""',responsejson("distinct","","[]",evidence),'"canonical_label":"Platform"')
  response = changestr('"concept_type":""',response,'"concept_type":"evidence-span"')
  /* ESC-VAL-01/02: validate the same alias requirements before publication.
   * Existing distinct application below remains the positive graph control. */
  validation_grounds = ""; validation_error = ""
  validation_generation = scalarint(database,"SELECT published_generation FROM library_meta")
  errors = errors + check(validatebacklogresponse(database,alias_task,response,validation_grounds,validation_error) = 0,"ESC valid distinct control " || validation_error)
  invalid_label = changestr('"canonical_label":"Platform"',response,'"canonical_label":""')
  invalid_type = changestr('"concept_type":"evidence-span"',response,'"concept_type":""')
  errors = errors + check(validatebacklogresponse(database,alias_task,invalid_label,validation_grounds,validation_error) <> 0,"ESC-VAL-01 empty distinct label rejected before review")
  errors = errors + check(validatebacklogresponse(database,alias_task,invalid_type,validation_grounds,validation_error) <> 0,"ESC-VAL-01 empty distinct type rejected before review")
  reuse_response = responsejson("reuse",collision_id,"[]",evidence)
  errors = errors + check(validatebacklogresponse(database,alias_task,reuse_response,validation_grounds,validation_error) = 0,"ESC active supplied reuse control " || validation_error)
  errors = errors + check(sqliteexec(database,"UPDATE concepts SET lifecycle_state='migration-parent' WHERE concept_id='" || collision_id || "'") = 0,"ESC migration-parent fixture at unchanged generation")
  errors = errors + check(validatebacklogresponse(database,alias_task,reuse_response,validation_grounds,validation_error) <> 0,"ESC-VAL-02 supplied migration parent rejected before review")
  errors = errors + check(scalarint(database,"SELECT published_generation FROM library_meta") = validation_generation,"ESC rejection does not publish")
  errors = errors + check(sqliteexec(database,"UPDATE concepts SET lifecycle_state='active' WHERE concept_id='" || collision_id || "'") = 0,"restore active supplied target")
  errors = errors + check(runresolution(store,job_id,alias_task,response,error) = 0,"grounded distinct identity repairs retained-ID conflict " || error)
  label = "Platform"; selected_type = "evidence-span"; selected = ""
  errors = errors + check(resolveknownmention(database,"candidate-identity-collision",label,selected_type,selected,error) = 1 & selected \= collision_id & selected_type = "evidence-span","occurrence remembers its resolved identity")
  errors = errors + check(scalartext(database,"SELECT concept_type FROM concepts WHERE concept_id='" || collision_id || "'") = "concept","repair never overwrites old identity")
  repair_followup = scalartext(database,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id='" || alias_task || "' AND kind LIKE 'alias-follow-up:%'")
  errors = errors + check(nextwindow(store,policy_json,job_id,error) = 0 & sqliteexec(database,"UPDATE job_items SET priority=4000001 WHERE item_id IN(SELECT m.item_id FROM maintenance_task_items m JOIN maintenance_tasks t ON t.task_id=m.task_id WHERE t.kind='alias-follow-up:chunk' AND t.subject_id='chunk-lifecycle' AND t.state='dispatched') AND state='queued'") = 0,"dispatch current combined extraction follow-up")
  errors = errors + check(runworkeronce(store,job_id,"identity-fixture",60,3,identity_policy,collision_provider,disposition,error,genericprofile()) = 0 & disposition = "concepts-and-notes","follow-up reuses resolved identity " || disposition || " " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM maintenance_alias_issues WHERE candidate_id='candidate-identity-collision' AND state='open'") = 0 & scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || selected || "' AND visible_to_generation IS NULL") > 0,"repair converges without reopening the same question")
  errors = errors + check(scalarint(database,"SELECT count(*) FROM pragma_foreign_key_check") = 0,"identity repair preserves foreign keys")
  errors = errors + agentchecks(store,policy_json)
  errors = errors + connectioneffectchecks(store,policy_json)
  errors = errors + workflowclosurechecks(store,policy_json)
  errors = errors + refreshchecks(store,policy_json)
  errors = errors + zerobudgetchecks(store,policy_json)
  errors = errors + sourcecontinuationchecks(store,policy_json)
  errors = errors + invalidretirementchecks(store,policy_json)
  errors = errors + aliascoalescencechecks(store,policy_json)
  call closeragstore store,error
  if errors > 0 then return 1
  say "DURABLE_BACKLOG_OK deduplicated split_fanout fenced_decisions resume uncertainty source_preservation"
  return 0

/* RAG-MNT-006: use public maintenance discovery and real fenced decisions.
 * Fixture writes introduce specific evidence changes; no provider decides them. */
reconsiderationchecks: procedure = .int
  arg store=.ragstorehandle,raw=.string
  db=store.database();errors=0;error="";job="";task="";again=""
  raw=changestr("retain investigate",raw,"retain investigate no-change")
  raw=left(raw,length(raw)-1) || ',"sparse_max_degree":0}'
  policy=.jsondocument(raw)
  packet="";fingerprint=""
  errors=errors+check(buildbacklogevidence(db,"concept","concept-parent","",65536,packet,fingerprint,error)=0,"initial reconsideration packet " || error)
  errors=errors+check(scalarint(db,"SELECT CASE WHEN json_valid(" || _testquote(packet) || ") THEN json_array_length(" || _testquote(packet) || ",'$.connections') ELSE -1 END")=1,"one independently visible incident connection")
  errors=errors+check(enqueuebacklogtask(db,"sparse-node","concept","concept-parent","","",999999,policy,task,error)=0 & task<>"","reconsideration initial non-sparse question " || error)
  errors=errors+check(nextwindow(store,raw,job,error)=0 & runresolution(store,job,task,responsejson("no-change"),error)=0,"reconsideration initial conclusion " || error)
  frozen=scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(task))
  decisions=scalarint(db,"SELECT count(*) FROM maintenance_decisions");calls=scalarint(db,"SELECT count(*) FROM provider_runs")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='sparse-node' AND subject_id='concept-parent'")=1,"unchanged settled non-sparse subject stays settled")
  errors=errors+check(sqliteexec(db,"INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('concept-parent',2,'Platform','concept','active',1,'administrative version','fixture'); UPDATE concepts SET canonical_label='Unrelated' WHERE concept_id='concept-survivor'")=0,"incidental version and unrelated identity changes")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='sparse-node' AND subject_id='concept-parent'")=1 & scalarint(db,"SELECT count(*) FROM provider_runs")=calls,"no model calls for irrelevant context changes")
  errors=errors+check(sqliteexec(db,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-new','revision-lifecycle',2,14,27,'content-lifecycle','new-evidence','fixture-v1','direct',1); INSERT INTO mentions(mention_id,concept_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-new','concept-parent','chunk-new',0,8,1)")=0,"new direct source evidence")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"census after source change " || error)
  child=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id=" || _testquote(task) || " AND kind='sparse-node' AND state IN('pending','dispatched')")
  errors=errors+check(child<>"","new source rediscovers non-sparse completed question with parent link")
  if child="" then return errors
  errors=errors+check(runresolution(store,job,child,responsejson("no-change"),error)=0,"changed source concludes " || error)
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='sparse-node' AND subject_id='concept-parent'")=2,"changed question converges")
  errors=errors+check(sqliteexec(db,"UPDATE claims SET qualifiers_json=json_object('scope','changed meaning') WHERE claim_id='claim-parent-peer'")=0,"same-span claim semantic change")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"census after relationship change")
  next_task=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id=" || _testquote(child) || " AND kind='sparse-node' AND state IN('pending','dispatched')")
  errors=errors+check(next_task<>"","claim meaning change without new span rediscovers question")
  if next_task="" then return errors
  errors=errors+check(runresolution(store,job,next_task,responsejson("no-change"),error)=0,"changed claim concludes " || error)
  errors=errors+check(scalartext(db,"SELECT evidence_json FROM maintenance_tasks WHERE task_id=" || _testquote(task))=frozen & scalarint(db,"SELECT count(*) FROM maintenance_decisions WHERE task_id=" || _testquote(task))=1,"old input and decision history remain intact")
  errors=errors+check(sqliteexec(db,"INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('reconsider-candidate','chunk-lifecycle','peer',9,13,'fixture',1); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('reconsider-candidate-initial','reconsider-candidate',1,'accepted','{}','fixture','fixture')")=0,"alias occurrence fixture")
  aliases=.string[];aliases[1]="Peer"
  errors=errors+check(recordaliasissue(db,"reconsider-candidate","Peer","concept",aliases,error)=0 & nextwindow(store,raw,job,error)=0,"discover alias question")
  issue=scalartext(db,"SELECT issue_id FROM maintenance_alias_issues WHERE candidate_id='reconsider-candidate'")
  alias_task=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE subject_id=" || _testquote(issue) || " AND state='dispatched'")
  errors=errors+check(alias_task<>"" & runresolution(store,job,alias_task,responsejson("reuse","concept-peer","[]",'[{"evidence_id":"reconsider-candidate","quote":"Peer"}]',issue),error)=0,"apply grounded alias reuse " || error)
  errors=errors+check(scalartext(db,"SELECT state FROM maintenance_alias_issues WHERE issue_id=" || _testquote(issue))="resolved","alias closes")
  errors=errors+check(sqliteexec(db,"DELETE FROM job_events WHERE event_type=" || _testquote("maintenance-assessed-context:" || alias_task))=0,"simulate legacy alias without comparison metadata")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(issue))=1,"own alias publication does not reopen itself")
  label="";kind="";known=""
  errors=errors+check(resolveknownmention(db,"reconsider-candidate",label,kind,known,error)=1 & known="concept-peer","unchanged occurrence binding still reusable")
  errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('new-peer','Peer','concept','active',1)")=0,"new eligible competing identity")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"closed alias change discovery")
  alias_child=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id=" || _testquote(alias_task) || " AND subject_type='alias-issue'")
  errors=errors+check(alias_child<>"" & scalartext(db,"SELECT state FROM maintenance_alias_issues WHERE issue_id=" || _testquote(issue))="open","closed alias is reopened once with lineage")
  errors=errors+check(resolveknownmention(db,"reconsider-candidate",label,kind,known,error)=0,"old occurrence binding cannot bypass new ambiguity")
  if alias_child<>"" then errors=errors+check(runresolution(store,job,alias_child,responsejson("no-change"),error)=0 & nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(issue))=2,"final no-change on new alias context converges")
  errors=errors+check(scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='alias-follow-up:chunk' AND subject_id='chunk-lifecycle'")>=1,"alias keeps existing extraction follow-up")
  errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET required_capability='advanced-reasoning',escalation_origin='worker',escalation_reason='retained hard question' WHERE task_id=" || _testquote(alias_child) || "; UPDATE concepts SET concept_type='evidence-span' WHERE concept_id='new-peer'")=0,"changed advanced alias fixture")
  errors=errors+check(nextwindow(store,raw,job,error)=0,"advanced successor discovery")
  advanced_child=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE parent_task_id=" || _testquote(alias_child) || " AND subject_type='alias-issue'")
  errors=errors+check(advanced_child<>"" & scalartext(db,"SELECT required_capability FROM maintenance_tasks WHERE task_id=" || _testquote(advanced_child))="advanced-reasoning","settled successor preserves advanced capability")
  errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET not_before_epoch=unixepoch('now','+6 months') WHERE task_id=" || _testquote(advanced_child) || "; UPDATE concepts SET concept_type='source-artifact' WHERE concept_id='new-peer'")=0,"deferred changed question")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(issue))=3,"changed evidence cannot bypass six-month hold")
  errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET not_before_epoch=0 WHERE task_id=" || _testquote(advanced_child) || "; INSERT INTO maintenance_task_waivers(waiver_id,task_id,reason,state,created_epoch) VALUES('reconsider-waiver'," || _testquote(advanced_child) || ",'operator hold','active',unixepoch())")=0,"waived changed question")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(issue))=3,"waiver remains effective on changed evidence")
  legacy=""
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","concept-parent","","",400000,policy,legacy,error)=0,"legacy settled concept fixture")
  legacy_packet=scalartext(db,"SELECT json_remove(evidence_json,'$.connections','$.connection_supports') FROM maintenance_tasks WHERE task_id=" || _testquote(legacy))
  errors=errors+check(sqliteexec(db,"UPDATE maintenance_tasks SET state='resolved',evidence_json=" || _testquote(legacy_packet) || ",evidence_fingerprint=" || _testquote(ragsha256(legacy_packet)) || " WHERE task_id=" || _testquote(legacy))=0,"legacy packet without new connection projection")
  calls=scalarint(db,"SELECT count(*) FROM provider_runs")
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='identity-review' AND subject_id='concept-parent'")=1 & scalarint(db,"SELECT count(*) FROM provider_runs")=calls,"legacy baseline creates no spurious task or call")
  lifecycle=""
  errors=errors+check(enqueuebacklogtask(db,"lifecycle","concept","concept-parent","","",999999,policy,lifecycle,error)=0 & nextwindow(store,raw,job,error)=0,"applied change convergence fixture")
  synonym=changestr('"canonical_label":""',responsejson("synonym","","[]",'[{"evidence_id":"support-parent-peer","quote":"Platform Peer"}]',"concept-parent"),'"canonical_label":"Platform Peer"')
  errors=errors+check(runresolution(store,job,lifecycle,synonym,error)=0,"apply supported synonym " || error)
  errors=errors+check(nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE kind='lifecycle' AND subject_id='concept-parent'")=1,"applied synonym does not reopen its own question")

  /* Repeat discovery from another caller after the same observed change. */
  again=""
  errors=errors+check(enqueuebacklogtask(db,"alias-resolution","alias-issue",issue,"",alias_child,950000,policy,again,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(issue))=3,"overlapping discovery retains one held successor")
  packet="";fingerprint=""
  errors=errors+check(buildbacklogevidence(db,"concept","concept-parent","",65536,packet,fingerprint,error)=0,"complete direct connection packet")
  ceiling=length(packet)-20
  errors=errors+check(buildbacklogevidence(db,"concept","concept-parent","",ceiling,packet,fingerprint,error)=2,"connection projection enforces complete packet ceiling")

  errors=errors+check(sqliteexec(db,"INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('reconsider-distinct','chunk-lifecycle','peer',9,13,'fixture-resolution',1); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('reconsider-distinct-initial','reconsider-distinct',1,'accepted','{}','fixture','fixture')")=0 & recordaliasissue(db,"reconsider-distinct","Peer","source-artifact",aliases,error)=0 & nextwindow(store,raw,job,error)=0,"legacy distinct fixture")
  distinct_issue=scalartext(db,"SELECT issue_id FROM maintenance_alias_issues WHERE candidate_id='reconsider-distinct'")
  distinct_task=scalartext(db,"SELECT task_id FROM maintenance_tasks WHERE subject_id=" || _testquote(distinct_issue) || " AND state='dispatched'")
  distinct=changestr('"canonical_label":""',responsejson("distinct","","[]",'[{"evidence_id":"reconsider-distinct","quote":"Peer"}]',distinct_issue),'"canonical_label":"Peer"')
  distinct=changestr('"concept_type":""',distinct,'"concept_type":"source-artifact"')
  errors=errors+check(distinct_task<>"" & runresolution(store,job,distinct_task,distinct,error)=0,"apply distinct identity " || error)
  errors=errors+check(sqliteexec(db,"DELETE FROM job_events WHERE event_type=" || _testquote("maintenance-assessed-context:" || distinct_task))=0 & nextwindow(store,raw,job,error)=0 & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE subject_id=" || _testquote(distinct_issue))=1,"legacy distinct accounts for its own created identity")

  /* Small pages must eventually visit later settled subjects, without calls. */
  do i=1 to 6
    subject="zz-page-" || i;page_task=""
    errors=errors+check(sqliteexec(db,"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES(" || _testquote(subject) || "," || _testquote(subject) || ",'concept','active',1)")=0 & enqueuebacklogtask(db,"identity-review","concept",subject,"","",100,policy,page_task,error)=0 & sqliteexec(db,"UPDATE maintenance_tasks SET state='resolved' WHERE task_id=" || _testquote(page_task))=0,"paged settled fixture")
  end
  paged=scalartext(db,"SELECT json_set(" || _testquote(raw) || ",'$.mode','manual','$.batch_items',1,'$.sparse_max_degree',-1)")
  calls=scalarint(db,"SELECT count(*) FROM provider_runs")
  errors=errors+check(nextwindow(store,paged,job,error)=0,"start bounded settled census")
  do i=1 to 30
    errors=errors+check(tickbacklogwindow(store,job,error)>=0,"advance settled census page " || error)
  end
  errors=errors+check(scalarint(db,"SELECT count(DISTINCT json_extract(message,'$.task_id')) FROM job_events WHERE event_type LIKE 'maintenance-assessed-context:%' AND json_extract(message,'$.task_id') IN(SELECT task_id FROM maintenance_tasks WHERE subject_id LIKE 'zz-page-%')")=6 & scalarint(db,"SELECT count(*) FROM provider_runs")=calls,"bounded pages reach all later settled subjects without reasoning calls")

  return errors
