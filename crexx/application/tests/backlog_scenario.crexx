  new_text="Platform Peer appears in a new source."
  new_generation=scalarint(db,"SELECT published_generation FROM library_meta WHERE singleton=1")
  sql="INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-actionability-new','raw-actionability-new','text/plain','utf-8',NULL,'fixture://actionability-new','fixture');"
  sql=sql || "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-actionability-new','digest-actionability-new'," || _testquote(new_text) || ",'fixture','utf8-v1','fixture');"
  sql=sql || "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-actionability-new','fixture','actionability-new','revision-actionability-new','active','fixture://actionability-new','New source'," || new_generation || ");"
  sql=sql || "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-actionability-new','source-actionability-new','envelope-actionability-new','artifact-actionability-new','text-actionability-new','meta-actionability-new','fixture'," || new_generation || ");"
  sql=sql || "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-actionability-new','content-digest-actionability-new'," || _testquote(new_text) || ",'input-actionability-new');"
