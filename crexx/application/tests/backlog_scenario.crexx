  errors=errors+check(sqliteexec(db,"UPDATE chunk_contents SET text='Platform Peer' WHERE content_id='content-lifecycle'; UPDATE source_revision_texts SET normalized_utf8='Platform Peer' WHERE text_id='text-lifecycle'; UPDATE chunks_fts SET body='Platform Peer' WHERE revision_chunk_id='chunk-lifecycle'")=0,"restore the synthetic source after stale-review refusal for the later census")
  quiet=changestr('"knowledge_policy":"fixture-v1"',raw,'"knowledge_policy":"fixture-waiting-unlimited"')
