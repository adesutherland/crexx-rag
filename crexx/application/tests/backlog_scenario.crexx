  errors=errors+check(scalartext(db,"SELECT state FROM maintenance_windows WHERE job_id=" || _testquote(quiet_job))="complete" & scalarint(db,"SELECT count(*) FROM maintenance_tasks WHERE task_id=" || _testquote(quiet_task) || " AND state='unresolved' AND escalation_origin='evidence-wait'")=1 & scalarint(db,"SELECT count(*) FROM provider_runs")=calls & scalarint(db,"SELECT json_extract(" || _testquote(summary.node_get(summary.root())) || ",'$.evidence_waits')")>=1,"unlimited window becomes quiet while reporting its outstanding wait")
