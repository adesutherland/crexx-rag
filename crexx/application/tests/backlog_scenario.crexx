  quiet=changestr('"output_budget":1000000',quiet,'"output_budget":0')
  quiet=left(quiet,length(quiet)-1) || ',"zero_unlimited":1,"phase":"identity","phase_cohort":["concept-parent"],"phase_denominator":1}'
  quiet_task="";quiet_job=job
  errors=errors+check(enqueuebacklogtask(db,"identity-review","concept","concept-parent","","",900000,.jsondocument(quiet),quiet_task,error)=0 & quiet_task<>"" & nextwindow(store,quiet,quiet_job,error)=0,"start an unlimited identity cohort with a real question " || error)
  response=currentresponse(responsejson("insufficient-evidence","","[]","[]","","A new source resolving whether Platform and Peer are identical"),"")
  errors=errors+check(runresolution(store,quiet_job,quiet_task,response,error)=0 & scalartext(db,"SELECT escalation_origin FROM maintenance_tasks WHERE task_id=" || _testquote(quiet_task))="evidence-wait","the unlimited cohort retains a specific unresolved evidence wait " || error)
