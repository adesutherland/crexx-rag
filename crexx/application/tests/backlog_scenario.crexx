  errors = errors + check(scalarint(database,"SELECT count(*) FROM job_items WHERE item_id='item-rel013' AND state='processed'") = 1 & scalarint(database,"SELECT count(*) FROM mentions WHERE concept_id='" || child || "' AND span_start=9 AND span_end=13") > 0,"REL-013 completes item and grounds survivor mention")
  errors = errors + check(scalartext(database,"SELECT lifecycle_state FROM concepts WHERE concept_id='concept-peer'") = "migration-parent","REL-013 never revives merge parent")
