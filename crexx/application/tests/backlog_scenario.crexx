  prior_to=scalartext(database,"SELECT coalesce(effective_to,'') FROM claims WHERE claim_id=" || _testquote(live_claim))
  errors = errors + check(runresolution(store,job_id,conflict_task,responsejson("qualify","","[]",evidence,live_claim,"",'{"scope":"documented"}',"1689","1690"),error) = 0, "apply supported temporal and scope qualification " || error)
  errors = errors + check(scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='" || live_claim || "' AND visible_to_generation IS NOT NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE effective_from='1689' AND effective_to='1690' AND json_extract(qualifiers_json,'$.scope')='documented' AND visible_to_generation IS NULL") = 1 & scalarint(database,"SELECT count(*) FROM claims WHERE claim_id='claim-context-test' AND visible_to_generation IS NULL") = 1, "qualification preserves old claim and unaffected competing claim")
  graph_rpc='{"jsonrpc":"2.0","id":43,"method":"tools/call","params":{"name":"rag_library_report","arguments":{"since_generation":' || before_qualify || ',"narrative":"off"}}}'
  graph_report=mcpdispatch(graph_rpc,store.path(),"architecture-local","generic-profile","read")
