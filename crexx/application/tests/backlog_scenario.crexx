  legacy_notes=.string[];legacy_tasks=.string[]
  legacy_notes[1]="note-legacy-known";legacy_notes[2]="note-legacy-unknown"
  errors=errors+check(sqliteexec(db,"INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-legacy-known','lead','Platform needs legacy evidence',800000,200000,'Review','active','{}','fixture',1,'fixture','fixture'),('note-legacy-unknown','lead','Peer needs legacy evidence',800000,200000,'Review','active','{}','fixture',1,'fixture','fixture'); INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-legacy-known','note-legacy-known','chunk','chunk-lifecycle','chunk-lifecycle',0,13),('link-legacy-unknown','note-legacy-unknown','chunk','chunk-lifecycle','chunk-lifecycle',0,13)")=0,"seed two synthetic legacy review subjects")
