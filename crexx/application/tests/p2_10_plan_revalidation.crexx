options levelg

import rxfnsb
import rxjson
import sqlite_boundary
import ragcommand
import ragfoundation
import ragregistry
import operator_registry
import ragstore
import ragfile
import ragcanonical

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_10_FAIL=" || label
    return 1
  end
  return 0

runcommand: procedure = .ragcommandresult
  arg args = .string[], registry = .ragregistry, expose parse_error = .string
  request = .ragcommandrequest
  if parsecommand(args, request, parse_error) \= 0 then do
    records = .ragresultrecord[]
    return .ragcommandresult("parse", "error", 2, parse_error, records)
  end
  return dispatchfoundation(request, registry)

fieldvalue: procedure = .string
  arg result = .ragcommandresult, record_index = .int, field_name = .string
  records = result.records()
  if record_index < 1 | record_index > records.0 then return ""
  fields = records[record_index].fields()
  do i = 1 to fields.0
    if fields[i].name() = field_name then return fields[i].value()
  end
  return ""

hashfile: procedure = .string
  arg path = .string, expose error = .string
  digest = ""; bytes = 0
  if sha256file(path, 2147483647, digest, bytes, error) \= 0 then return ""
  return digest

changedhash: procedure = .string
  arg digest = .string
  first = "0"
  if left(digest, 1) = "0" then first = "1"
  return first || substr(digest, 2)

applyargs: procedure = .string[]
  arg library = .string, operation = .string, capability = .string, plan_json = .string, digest = .string
  dot = pos(".", operation); noun = left(operation, dot - 1); verb = substr(operation, dot + 1)
  values = .string[]
  values[1] = "--library"; values[2] = library
  values[3] = "--config"; values[4] = "architecture-local"
  values[5] = "--profile"; values[6] = "generic-profile"
  values[7] = "--access"; values[8] = capability
  values[9] = noun; values[10] = verb
  values[11] = "--plan-json"; values[12] = plan_json
  values[13] = "--expect-digest"; values[14] = digest
  return values

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
cell = args[1]; root = args[2]; library = root || "/library.cprag"
registry = operatorregistry(); errors = 0; parse_error = ""; io_error = ""

init_args = .string[]
init_args[1] = "--library"; init_args[2] = library; init_args[3] = "--config"; init_args[4] = "architecture-local"; init_args[5] = "--profile"; init_args[6] = "generic-profile"; init_args[7] = "--access"; init_args[8] = "admin"; init_args[9] = "library"; init_args[10] = "init"
result = runcommand(init_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0, "foundation library init " || result.message())
database_before = hashfile(library || "/library.sqlite", io_error)
manifest_before = hashfile(library || "/manifest.json", io_error)
wal_before = hashfile(library || "/library.sqlite-wal", io_error)
shm_before = hashfile(library || "/library.sqlite-shm", io_error)

denied_plan = .string[]
denied_plan[1] = "--library"; denied_plan[2] = library; denied_plan[3] = "--config"; denied_plan[4] = "architecture-local"; denied_plan[5] = "--profile"; denied_plan[6] = "generic-profile"; denied_plan[7] = "ingest"; denied_plan[8] = "plan"; denied_plan[9] = "--source-set"; denied_plan[10] = "architecture-docs"
result = runcommand(denied_plan, registry, parse_error)
errors = errors + check(result.exit_code() = 4, "planning capability denied before inspection")

ingest_plan_args = .string[]
ingest_plan_args[1] = "--library"; ingest_plan_args[2] = library; ingest_plan_args[3] = "--config"; ingest_plan_args[4] = "architecture-local"; ingest_plan_args[5] = "--profile"; ingest_plan_args[6] = "generic-profile"; ingest_plan_args[7] = "--access"; ingest_plan_args[8] = "plan"; ingest_plan_args[9] = "ingest"; ingest_plan_args[10] = "plan"; ingest_plan_args[11] = "--source-set"; ingest_plan_args[12] = "architecture-docs"
ingest_plan_result = runcommand(ingest_plan_args, registry, parse_error)
ingest_json = fieldvalue(ingest_plan_result, 1, "canonical_plan"); ingest_digest = fieldvalue(ingest_plan_result, 1, "digest")
document = .jsondocument(ingest_json)
errors = errors + check(ingest_plan_result.exit_code() = 0 & length(ingest_digest) = 64 & document.valid() = 1 & document.get("schema") = "crexx-rag.plan/1" & document.get("operation") = "ingest.apply" & document.get("action.source_set") = "architecture-docs" & document.get("required_capability") = "ingest" & fieldvalue(ingest_plan_result, 1, "enqueued") = "false", "canonical ingest plan")

improve_plan_args = .string[]
improve_plan_args[1] = "--library"; improve_plan_args[2] = library; improve_plan_args[3] = "--config"; improve_plan_args[4] = "architecture-local"; improve_plan_args[5] = "--profile"; improve_plan_args[6] = "generic-profile"; improve_plan_args[7] = "--access"; improve_plan_args[8] = "plan"; improve_plan_args[9] = "improve"; improve_plan_args[10] = "plan"
improve_result = runcommand(improve_plan_args, registry, parse_error)
errors = errors + check(improve_result.exit_code() = 0 & .jsondocument(fieldvalue(improve_result, 1, "canonical_plan")).get("operation") = "improve.apply" & fieldvalue(improve_result, 1, "required_capability") = "curate", "canonical improvement plan")

proposal_input = copies("a", 64)
proposal_plan_args = .string[]
proposal_plan_args[1] = "--library"; proposal_plan_args[2] = library; proposal_plan_args[3] = "--config"; proposal_plan_args[4] = "architecture-local"; proposal_plan_args[5] = "--profile"; proposal_plan_args[6] = "generic-profile"; proposal_plan_args[7] = "--access"; proposal_plan_args[8] = "plan"; proposal_plan_args[9] = "proposal"; proposal_plan_args[10] = "plan"; proposal_plan_args[11] = "--input-digest"; proposal_plan_args[12] = proposal_input
proposal_result = runcommand(proposal_plan_args, registry, parse_error)
errors = errors + check(proposal_result.exit_code() = 0 & .jsondocument(fieldvalue(proposal_result, 1, "canonical_plan")).get("action.input_digest") = proposal_input, "canonical proposal plan")

database_after_plans = hashfile(library || "/library.sqlite", io_error)
manifest_after_plans = hashfile(library || "/manifest.json", io_error)
wal_after_plans = hashfile(library || "/library.sqlite-wal", io_error)
shm_after_plans = hashfile(library || "/library.sqlite-shm", io_error)
errors = errors + check(database_before = database_after_plans & manifest_before = manifest_after_plans & wal_before = wal_after_plans & shm_before = shm_after_plans, "three planning surfaces perform zero library writes")

denied_apply_args = applyargs(library, "ingest.apply", "read", ingest_json, ingest_digest)
result = runcommand(denied_apply_args, registry, parse_error)
errors = errors + check(result.exit_code() = 4, "apply capability denied before plan inspection")

valid_apply_args = applyargs(library, "ingest.apply", "ingest", ingest_json, ingest_digest)
result = runcommand(valid_apply_args, registry, parse_error)
errors = errors + check(result.exit_code() = 8 & fieldvalue(result, 1, "state") = "revalidated" & fieldvalue(result, 1, "enqueued") = "false", "valid plan fully revalidated then later-phase enqueue withheld")
errors = errors + check(database_before = hashfile(library || "/library.sqlite", io_error) & manifest_before = hashfile(library || "/manifest.json", io_error), "apply revalidation performs zero library writes")

tampered_json = changestr("architecture-docs", ingest_json, "architecture-docx")
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_json, ingest_digest), registry, parse_error)
errors = errors + check(result.exit_code() = 7, "reviewed digest mismatch denied")

noncanonical_json = " " || ingest_json
result = runcommand(applyargs(library, "ingest.apply", "ingest", noncanonical_json, ragsha256(noncanonical_json)), registry, parse_error)
errors = errors + check(result.exit_code() = 7, "noncanonical but valid JSON denied")

config_hash = document.get("configuration.hash")
tampered_config = changestr(config_hash, ingest_json, changedhash(config_hash))
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_config, ragsha256(tampered_config)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "configuration hash revalidated")

profile_hash = document.get("profile.hash")
tampered_profile = changestr(profile_hash, ingest_json, changedhash(profile_hash))
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_profile, ragsha256(tampered_profile)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "profile hash revalidated")

source_hash = document.get("source_fingerprint_hash")
tampered_source = changestr(source_hash, ingest_json, changedhash(source_hash))
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_source, ragsha256(tampered_source)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "source fingerprint revalidated")

provider_hash = document.get("provider_route_hash")
tampered_provider = changestr(provider_hash, ingest_json, changedhash(provider_hash))
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_provider, ragsha256(tampered_provider)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "provider privacy route revalidated")

reservation_hash = document.get("reservation_hash")
tampered_reservation = changestr(reservation_hash, ingest_json, changedhash(reservation_hash))
result = runcommand(applyargs(library, "ingest.apply", "ingest", tampered_reservation, ragsha256(tampered_reservation)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "reservation binding revalidated")

created_at = document.get("created_at_epoch") as .int
expires_at = document.get("expires_at_epoch") as .int
expired_json = changestr('"created_at_epoch":' || created_at, ingest_json, '"created_at_epoch":' || (created_at - 7200))
expired_json = changestr('"expires_at_epoch":' || expires_at, expired_json, '"expires_at_epoch":' || (created_at - 3600))
result = runcommand(applyargs(library, "ingest.apply", "ingest", expired_json, ragsha256(expired_json)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "expiry revalidated")

boundary_json = changestr('"created_at_epoch":' || created_at, ingest_json, '"created_at_epoch":' || (created_at - 3600))
boundary_json = changestr('"expires_at_epoch":' || expires_at, boundary_json, '"expires_at_epoch":' || created_at)
result = runcommand(applyargs(library, "ingest.apply", "ingest", boundary_json, ragsha256(boundary_json)), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "expiry instant is exclusive")

store = .ragstorehandle; store_error = ""
errors = errors + check(openragstore(library, "readwrite", store, store_error) = 0, "open for reservation mutation " || store_error)
reservation_sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,reserved_calls,reserved_tokens,reserved_cost,created_at,updated_at) SELECT 'reservation-change'," || "'" || copies("b", 64) || "','{}',g.config_snapshot_id,'queued',1,1,1,1,1,1,2,3,'2026-08-23T00:00:00Z','2026-08-23T00:00:00Z' FROM library_meta m JOIN published_generations g ON g.generation=m.published_generation WHERE m.singleton=1"
errors = errors + check(sqliteexec(store.database(), reservation_sql) = 0, "create competing reservation")
errors = errors + check(closeragstore(store, store_error) = 0, "close reservation mutation")
result = runcommand(valid_apply_args, registry, parse_error)
errors = errors + check(result.exit_code() = 6, "live reservation change forces re-plan")

post_reservation_plan = runcommand(ingest_plan_args, registry, parse_error)
post_json = fieldvalue(post_reservation_plan, 1, "canonical_plan"); post_digest = fieldvalue(post_reservation_plan, 1, "digest")
post_document = .jsondocument(post_json); snapshot_id = post_document.get("configuration.snapshot_id")
errors = errors + check(post_reservation_plan.exit_code() = 0 & post_document.get("reservation_hash") \= reservation_hash, "re-plan captures new reservation state")

store = .ragstorehandle; generation = 0
errors = errors + check(openragstore(library, "readwrite", store, store_error) = 0, "open for generation mutation")
errors = errors + check(begingeneration(store, 1, snapshot_id, "P2-10 generation revalidation", generation, store_error) = 0 & generation = 2, "stage new generation " || store_error)
errors = errors + check(commitgeneration(store, generation, store_error) = 0, "commit new generation " || store_error)
errors = errors + check(publishmanifest(store, store_error) = 0, "publish new generation manifest " || store_error)
errors = errors + check(closeragstore(store, store_error) = 0, "close generation mutation")
result = runcommand(applyargs(library, "ingest.apply", "ingest", post_json, post_digest), registry, parse_error)
errors = errors + check(result.exit_code() = 6, "generation change forces re-plan")

unknown_source_args = ingest_plan_args; unknown_source_args[12] = "unknown-source"
result = runcommand(unknown_source_args, registry, parse_error)
errors = errors + check(result.exit_code() = 3, "unregistered source-set denied")

invalid_proposal_args = proposal_plan_args; invalid_proposal_args[12] = "not-a-digest"
result = runcommand(invalid_proposal_args, registry, parse_error)
errors = errors + check(result.exit_code() = 3, "invalid proposal input digest denied")

if errors \= 0 then return 1
say "P2_10_PLAN_OK cell=" || cell || " plans=3 canonical=1 zero_write=1 digest=1 hostile_revalidation=1 generation=1 expiry=1 config_profile=1 source=1 provider_route=1 reservations=1 capability=1 enqueued=0 provider_calls=0"
return 0
