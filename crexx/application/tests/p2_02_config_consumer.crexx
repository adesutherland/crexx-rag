options levelg

import ragmodel
import ragconfig
import ragprofile
import ragregistry
import rxfnsb
import architecture_local_config
import generic_profile
import operator_registry

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_02_FAIL=" || label
    return 1
  end
  return 0

containsissue: procedure = .int
  arg result = .ragvalidationresult, expected_code = .string
  issues = result.issues()
  do i = 1 to issues.0
    if issues[i].code() = expected_code then return 1
  end
  return 0

messagescontain: procedure = .int
  arg result = .ragvalidationresult, marker = .string
  issues = result.issues()
  do i = 1 to issues.0
    if pos(marker, issues[i].message()) > 0 then return 1
  end
  return 0

invalidsecretconfig: procedure = .ragconfig
  arg marker = .string
  base = architecturelocalconfig()
  source_sets = base.source_sets()
  providers = base.providers()
  providers[3] = .ragproviderconfig("hosted-strong", "openai", "https://api.openai.com/v1", "configured-hosted-model", "hosted", "public-only", .ragsecretref("literal", marker), 60000, 2)
  roles = base.roles()
  profile_ids = base.profile_ids()
  schedules = base.schedules()
  return .ragconfig("invalid-secret", "1", source_sets, providers, roles, profile_ids, base.budget(), base.workers(), schedules)

unsupportedworkerconfig: procedure = .ragconfig
  base = architecturelocalconfig()
  source_sets = base.source_sets()
  providers = base.providers()
  roles = base.roles()
  profile_ids = base.profile_ids()
  schedules = base.schedules()
  return .ragconfig("unsupported-workers", "1", source_sets, providers, roles, profile_ids, base.budget(), .ragworkerpolicy(2, 2, 120), schedules)

multiprocessconfig: procedure = .ragconfig
  base = architecturelocalconfig()
  return .ragconfig("multi-process", "1", base.source_sets(), base.providers(), base.roles(), base.profile_ids(), base.budget(), .ragworkerpolicy(4, 1, 120), base.schedules())

unknownprofileconfig: procedure = .ragconfig
  base = architecturelocalconfig()
  source_sets = base.source_sets()
  providers = base.providers()
  roles = base.roles()
  profile_ids = .string[]
  profile_ids[1] = "missing-profile"
  schedules = base.schedules()
  return .ragconfig("unknown-profile", "1", source_sets, providers, roles, profile_ids, base.budget(), base.workers(), schedules)

unknownproviderconfig: procedure = .ragconfig
  base = architecturelocalconfig()
  source_sets = base.source_sets()
  providers = base.providers()
  roles = base.roles()
  roles[2] = .ragrolebinding("extractor", "missing-provider")
  profile_ids = base.profile_ids()
  schedules = base.schedules()
  return .ragconfig("unknown-provider", "1", source_sets, providers, roles, profile_ids, base.budget(), base.workers(), schedules)

invalidinverseprofile: procedure = .ragprofile
  base = genericprofile()
  concept_types = base.concept_types()
  relationship_types = base.relationship_types()
  relationship_types[1] = .ragrelationshiptype("related-to", "missing-inverse", 0)
  aliases = base.aliases()
  ranking_weights = base.ranking_weights()
  prompts = base.prompts()
  validators = base.validators()
  return .ragprofile("invalid-inverse-profile", "1", concept_types, relationship_types, aliases, base.chunk_policy(), ranking_weights, prompts, validators)

main: procedure = .int
  arg args = .string[]
  cell = "unknown"
  secret_marker = "secret-marker"
  if args.0 >= 1 then cell = args[1]
  if args.0 >= 2 then secret_marker = args[2]
  errors = 0

  registry = operatorregistry()
  config_ids = registry.config_ids()
  profile_ids = registry.profile_ids()
  errors = errors + check(registry.valid() = 1 & config_ids.0 = 1 & profile_ids.0 = 2, "operator registry")

  config_lookup = registry.config("architecture-local")
  generic_lookup = registry.profile("generic-profile")
  architecture_lookup = registry.profile("it-architecture-profile")
  errors = errors + check(config_lookup.found() = 1 & generic_lookup.found() = 1 & architecture_lookup.found() = 1, "registered lookup")

  config = config_lookup.config()
  config_validation = validateconfig(config)
  generic = generic_lookup.profile()
  architecture = architecture_lookup.profile()
  errors = errors + check(config_validation.ok() = 1 & validateprofile(generic).ok() = 1 & validateprofile(architecture).ok() = 1, "typed validation")

  generic_types = generic.concept_types()
  architecture_types = architecture.concept_types()
  errors = errors + check(generic.profile_id() \= architecture.profile_id() & generic_types.0 = 3 & architecture_types.0 = 6, "independent profiles")

  providers = config.providers()
  roles = config.roles()
  credential = providers[3].credential()
  errors = errors + check(providers.0 = 3 & roles.0 = 3 & credential.valid() = 1 & credential.ref_string() = "env:OPENAI_API_KEY", "provider roles and env reference")

  config_snapshot = config.snapshot()
  errors = errors + check(config_snapshot.config_id() = "architecture-local" & config_snapshot.secret_reference_count() = 1 & config_snapshot.secret_reference(1) = "env:OPENAI_API_KEY", "non-secret snapshot")
  errors = errors + check(pos(secret_marker, config_snapshot.secret_reference(1)) = 0, "secret value absent from snapshot")
  errors = errors + check(config_snapshot.secret_reference(0) = "" & config_snapshot.secret_reference(2) = "", "snapshot bounds")

  errors = errors + check(registry.config("../architecture-local").status() = "invalid-id", "relative path rejection")
  errors = errors + check(registry.config("/tmp/config").status() = "invalid-id", "absolute path rejection")
  errors = errors + check(registry.profile("it_architecture_profile.crexx").status() = "invalid-id", "module filename rejection")
  errors = errors + check(registry.profile("unknown-profile").status() = "unknown-id", "unknown id rejection")

  secret_validation = validateconfig(invalidsecretconfig(secret_marker))
  errors = errors + check(secret_validation.ok() = 0 & containsissue(secret_validation, "secret_reference") = 1, "literal secret rejection")
  errors = errors + check(messagescontain(secret_validation, secret_marker) = 0, "secret-free diagnostics")

  worker_validation = validateconfig(unsupportedworkerconfig())
  errors = errors + check(worker_validation.ok() = 0 & containsissue(worker_validation, "worker_in_flight") = 1, "unsupported per-process in-flight scope")
  multi_worker_validation = validateconfig(multiprocessconfig())
  errors = errors + check(multi_worker_validation.ok() = 1, "bounded multi-process configuration")
  provider_validation = validateconfig(unknownproviderconfig())
  errors = errors + check(provider_validation.ok() = 0 & containsissue(provider_validation, "unknown_provider") = 1, "unknown provider reference")
  inverse_validation = validateprofile(invalidinverseprofile())
  errors = errors + check(inverse_validation.ok() = 0 & containsissue(inverse_validation, "unknown_inverse") = 1, "unknown inverse reference")

  duplicate_configs = .ragconfig[]
  duplicate_configs[1] = config
  duplicate_configs[2] = config
  registered_profiles = .ragprofile[]
  registered_profiles[1] = generic
  registered_profiles[2] = architecture
  duplicate_registry = .ragregistry(duplicate_configs, registered_profiles)
  errors = errors + check(duplicate_registry.valid() = 0 & containsissue(duplicate_registry.validation(), "duplicate_config") = 1, "duplicate registration")

  single_config = .ragconfig[]
  single_config[1] = config
  duplicate_profiles = .ragprofile[]
  duplicate_profiles[1] = generic
  duplicate_profiles[2] = generic
  duplicate_profile_registry = .ragregistry(single_config, duplicate_profiles)
  errors = errors + check(duplicate_profile_registry.valid() = 0 & containsissue(duplicate_profile_registry.validation(), "duplicate_profile") = 1, "duplicate profile registration")

  missing_configs = .ragconfig[]
  missing_configs[1] = unknownprofileconfig()
  missing_registry = .ragregistry(missing_configs, registered_profiles)
  errors = errors + check(missing_registry.valid() = 0 & containsissue(missing_registry.validation(), "unknown_profile") = 1, "unregistered profile reference")

  if errors \= 0 then do
    say "P2_02_ERRORS=" || errors
    return 1
  end
  say "P2_02_OK cell=" || cell || " levelg=1 configs=1 profiles=2 env_refs=1 arbitrary_paths=0 secret_values=0 provider_calls=0 source_reads=0 library_writes=0"
  return 0
