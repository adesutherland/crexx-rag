options levelg

import rxfnsb
import rxsqlite
import ragstore
import ragrepository
import ragmaintain
import generic_profile

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "LIFECYCLE_METHODOLOGY_FAIL=" || label
  return 1

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

insertitem: procedure = .int
  arg database = .binary, item_id = .string, item_type = .string, concept_id = .string, generation = .int, action_json = .string, expose error = .string
  run_id = "run-" || item_id
  prepared = .binary
  sql = "INSERT INTO maintenance_runs(run_id,expected_generation,config_snapshot_id,mode,state,plan_digest,canonical_plan,created_at) VALUES(?1,?2,'snapshot-lifecycle','reviewed','running',?3,'{}',strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then do; error = "prepare maintenance run"; return -1; end
  binds = sqlitebindtext(prepared, 1, run_id) | sqlitebindint(prepared, 2, generation) | sqlitebindtext(prepared, 3, "digest-" || item_id)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert maintenance run"; return -1; end
  prepared = .binary
  sql = "INSERT INTO maintenance_items(item_id,run_id,item_type,subject_type,subject_id,score,trigger_json,diagnosis_json,action_json,state,expected_generation,created_at,updated_at) VALUES(?1,?2,?3,'concept',?4,900000,'{}','{}',?5,'review-required',?6,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then do; error = "prepare maintenance item"; return -1; end
  binds = sqlitebindtext(prepared, 1, item_id) | sqlitebindtext(prepared, 2, run_id) | sqlitebindtext(prepared, 3, item_type) | sqlitebindtext(prepared, 4, concept_id) | sqlitebindtext(prepared, 5, action_json) | sqlitebindint(prepared, 6, generation)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert maintenance item"; return -1; end
  return 0

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-lifecycle-methodology", "snapshot-lifecycle", "lifecycle-methodology", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors > 0 then return 1
  database = store.database()
  errors = errors + check(sqliteexec(database, "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-lifecycle','raw-lifecycle','text/plain','utf-8',NULL,'fixture://lifecycle',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "artifact")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-lifecycle','text-digest-lifecycle','Platform Peer','fixture-v1','utf8-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "revision text")
  errors = errors + check(sqliteexec(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-lifecycle','fixture','lifecycle','revision-lifecycle','active','fixture://lifecycle','Lifecycle corpus',1)") = 0, "source")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-lifecycle','source-lifecycle','revision-envelope-lifecycle','artifact-lifecycle','text-lifecycle','metadata-lifecycle','fixture-time',1)") = 0, "revision")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-lifecycle','content-digest-lifecycle','Platform Peer','input-lifecycle')") = 0, "content")
  errors = errors + check(sqliteexec(database, "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-lifecycle','revision-lifecycle',1,0,13,'content-lifecycle','continuity-lifecycle','fixture-v1','direct',1)") = 0, "chunk")
  errors = errors + check(sqliteexec(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-lifecycle','content-lifecycle','Platform Peer')") = 0, "FTS")
  errors = errors + check(sqliteexec(database, "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('concept-parent','Platform','concept','active',1),('concept-peer','Peer','concept','active',1),('concept-survivor','Survivor','concept','active',1)") = 0, "concepts")
  errors = errors + check(sqliteexec(database, "INSERT INTO concept_versions(concept_id,version,canonical_label,concept_type,lifecycle_state,generation,reason,created_at) VALUES('concept-parent',1,'Platform','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-peer',1,'Peer','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now')),('concept-survivor',1,'Survivor','concept','active',1,'fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "concept versions")
  errors = errors + check(sqliteexec(database, "INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,ambiguity_id,decision_id,visible_from_generation) VALUES('alias-parent','platform','concept-parent',NULL,NULL,1)") = 0, "alias")
  errors = errors + check(sqliteexec(database, "INSERT INTO mentions(mention_id,concept_id,ambiguity_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES('mention-parent','concept-parent',NULL,'chunk-lifecycle',0,8,1),('mention-peer','concept-peer',NULL,'chunk-lifecycle',9,13,1)") = 0, "mentions")
  errors = errors + check(sqliteexec(database, "INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,policy_version,visible_from_generation) VALUES('claim-parent-peer','concept-parent','related-to','concept-peer','outbound','{}','fixture-v1',1),('claim-peer-survivor','concept-peer','related-to','concept-survivor','outbound','{}','fixture-v1',1)") = 0, "claims")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,decision_id,visible_from_generation) VALUES('support-parent-peer','claim-parent-peer','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1),('support-peer-survivor','claim-peer-survivor','chunk-lifecycle',0,13,'support','assertion','direct','','lineage-fixture','fixture',NULL,1)") = 0, "claim supports")
  errors = errors + check(sqliteexec(database, "INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-parent','claim-parent-peer','claim-peer-survivor','pending',1)") = 0, "claim conflict")
  errors = errors + check(sqliteexec(database, "INSERT INTO ambiguity_candidates(ambiguity_id,concept_id,revision_chunk_id,decision_id,visible_from_generation) VALUES('ambiguity-parent','concept-parent','chunk-lifecycle',NULL,1)") = 0, "ambiguity candidate")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_notes(note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation,created_at,updated_at) VALUES('note-parent','lead','Review Platform',800000,200000,'','active','{}','fixture',1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "analysis note")
  errors = errors + check(sqliteexec(database, "INSERT INTO analysis_note_links(link_id,note_id,object_type,object_id,revision_chunk_id,span_start,span_end) VALUES('link-parent','note-parent','concept','concept-parent',NULL,NULL,NULL)") = 0, "analysis note link")
  errors = errors + check(publishmanifest(store, error) = 0, "initial manifest " || error)
  if errors > 0 then return 1

  split_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"split","concept_id":"concept-parent","target_concept_id":"","alias":"","concept_type":"","successors":[{"canonical_label":"Platform Alpha","concept_type":"concept"},{"canonical_label":"Platform Beta","concept_type":"concept"}],"dispositions":[],"reason":"separate overloaded meanings while retaining the migration parent"}'
  errors = errors + check(insertitem(database, "item-split", "split", "concept-parent", 1, split_action, error) = 0, error)
  published = 0; disposition = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-split", split_action, 1, published, disposition, error) = 0 & published = 2 & disposition = "split-applied", "split " || error)
  errors = errors + check(scalartext(database, "SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "migration-parent", "split retains migration parent")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM concept_lineage WHERE operation='split' AND parent_concept_id='concept-parent'") = 2, "split lineage")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM maintenance_dispositions WHERE maintenance_item_id='item-split' AND action='keep-parent'") = 4, "split exact impact defaults to keep-parent")

  first_child = scalartext(database, "SELECT child_concept_id FROM concept_lineage WHERE operation='split' AND parent_concept_id='concept-parent' ORDER BY child_concept_id LIMIT 1")
  second_child = scalartext(database, "SELECT child_concept_id FROM concept_lineage WHERE operation='split' AND parent_concept_id='concept-parent' ORDER BY child_concept_id DESC LIMIT 1")
  /* Real canonical child IDs exercise the parent's identity rejection. */
  duplicate_split=changestr('"concept_id":"concept-parent"',split_action,'"concept_id":"' || first_child || '"')
  errors=errors+check(sqliteexec(database,"BEGIN IMMEDIATE")=0,"isolate invalid split fixture")
  errors=errors+check(insertitem(database,"item-duplicate-split","split",first_child,2,duplicate_split,error)=0,"seed invalid split")
  errors=errors+check(applylifecycleaction(store,genericprofile(),"item-duplicate-split",duplicate_split,2,published,disposition,error)<>0 & pos("distinct from the migration parent",error)>0,"parent duplicate rejected by lifecycle owner " || error)
  errors=errors+check(sqliteexec(database,"ROLLBACK")=0 & scalarint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")=2,"rejection preserves generation")
  merge_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"merge","concept_id":"' || first_child || '","target_concept_id":"' || second_child || '","alias":"","concept_type":"","successors":[],"dispositions":[],"reason":"merge duplicate split successor into the reviewed survivor"}'
  errors = errors + check(insertitem(database, "item-merge", "merge", first_child, 2, merge_action, error) = 0, error)
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-merge", merge_action, 2, published, disposition, error) = 0 & published = 3 & disposition = "merge-applied", "merge " || error)
  errors = errors + check(scalartext(database, "SELECT lifecycle_state FROM concepts WHERE concept_id='" || first_child || "'") = "migration-parent", "merge retains migration source")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM concept_lineage WHERE operation='merge' AND parent_concept_id='" || first_child || "' AND child_concept_id='" || second_child || "'") = 1, "merge lineage")

  type_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"type-correction","concept_id":"concept-peer","target_concept_id":"","alias":"","concept_type":"source-artifact","successors":[],"dispositions":[],"reason":"correct the reviewed catalogue type"}'
  errors = errors + check(insertitem(database, "item-type", "type-correction", "concept-peer", 3, type_action, error) = 0, error)
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-type", type_action, 3, published, disposition, error) = 0 & published = 4, "type correction " || error)
  errors = errors + check(scalartext(database, "SELECT concept_type FROM concepts WHERE concept_id='concept-peer'") = "source-artifact", "type correction state")

  synonym_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"synonym","concept_id":"concept-peer","target_concept_id":"","alias":"companion","concept_type":"","successors":[],"dispositions":[],"reason":"add the reviewed synonym"}'
  errors = errors + check(insertitem(database, "item-synonym", "synonym", "concept-peer", 4, synonym_action, error) = 0, error)
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-synonym", synonym_action, 4, published, disposition, error) = 0 & published = 5, "synonym " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM aliases WHERE normalized_alias='companion' AND target_concept_id='concept-peer' AND visible_to_generation IS NULL") = 1, "synonym state")

  retire_incomplete = '{"schema":"crexx-rag.lifecycle-action/1","operation":"retire","concept_id":"concept-parent","target_concept_id":"","alias":"","concept_type":"","successors":[],"dispositions":[],"reason":"retire only after every impact is resolved"}'
  errors = errors + check(insertitem(database, "item-retire", "retire", "concept-parent", 5, retire_incomplete, error) = 0, error)
  failed_generation = 0; failed_disposition = ""; error = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-retire", retire_incomplete, 5, failed_generation, failed_disposition, error) \= 0 & pos("retirement gate", error) > 0, "retirement gate rejects unresolved impacts")
  errors = errors + check(scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1") = 5 & scalarint(database, "SELECT count(*) FROM maintenance_dispositions WHERE maintenance_item_id='item-retire'") = 0, "failed retirement is atomic")

  retire_missing = '{"schema":"crexx-rag.lifecycle-action/1","operation":"retire","concept_id":"concept-parent","target_concept_id":"","alias":"","concept_type":"","successors":[],"dispositions":[{"object_type":"alias","object_id":"alias-parent","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"alias reviewed"}],"reason":"an incomplete impact set must be rejected"}'
  errors = errors + check(sqliteexec(database, "UPDATE maintenance_items SET action_json='" || changestr("'", retire_missing, "''") || "' WHERE item_id='item-retire'") = 0, "replace incomplete retirement action")
  error = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-retire", retire_missing, 5, failed_generation, failed_disposition, error) \= 0 & pos("exact impact census", error) > 0 & scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1") = 5, "exact impact census rejection")

  retire_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"retire","concept_id":"concept-parent","target_concept_id":"","alias":"","concept_type":"","successors":[],"dispositions":[{"object_type":"alias","object_id":"alias-parent","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"alias reviewed"},{"object_type":"mention","object_id":"mention-parent","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"mention reviewed"},{"object_type":"claim","object_id":"claim-parent-peer","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"claim reviewed"},{"object_type":"note","object_id":"note-parent","action":"retract","target_concept_id":"","confidence_millionths":1000000,"reason":"note reviewed"}],"reason":"all active impacts were deterministically disposed"}'
  errors = errors + check(sqliteexec(database, "UPDATE maintenance_items SET action_json='" || changestr("'", retire_action, "''") || "' WHERE item_id='item-retire'") = 0, "replace reviewed retirement action")
  error = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-retire", retire_action, 5, failed_generation, failed_disposition, error) \= 0 & pos("ambiguity", error) > 0, "retirement gate rejects an unresolved ambiguity after exact object dispositions")
  errors = errors + check(scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1") = 5 & scalarint(database, "SELECT count(*) FROM claims WHERE claim_id='claim-parent-peer' AND visible_to_generation IS NULL") = 1 & scalarint(database, "SELECT count(*) FROM claim_conflicts WHERE conflict_id='conflict-parent' AND visible_to_generation IS NULL") = 1, "ambiguity-gated retirement rolls back claims, supports, conflicts and dispositions")
  errors = errors + check(sqliteexec(database, "DELETE FROM ambiguity_candidates WHERE ambiguity_id='ambiguity-parent' AND concept_id='concept-parent'") = 0, "resolve ambiguity before retirement")
  error = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-retire", retire_action, 5, published, disposition, error) = 0 & published = 6 & disposition = "retire-applied", "retirement " || error)
  errors = errors + check(scalartext(database, "SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "retired", "retired state")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM maintenance_dispositions WHERE maintenance_item_id='item-retire' AND action='retract'") = 4, "retirement exact dispositions")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM claim_support WHERE claim_id='claim-parent-peer' AND visible_to_generation IS NULL") = 0 & scalarint(database, "SELECT count(*) FROM claim_conflicts WHERE conflict_id='conflict-parent' AND visible_to_generation IS NULL") = 0, "claim support and conflict close atomically with retired claim")

  restore_action = '{"schema":"crexx-rag.lifecycle-action/1","operation":"restore","concept_id":"concept-parent","target_concept_id":"","alias":"","concept_type":"","successors":[],"dispositions":[],"reason":"restore the retained concept as a new lifecycle version"}'
  errors = errors + check(insertitem(database, "item-restore", "restore", "concept-parent", 6, restore_action, error) = 0, error)
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-restore", restore_action, 6, published, disposition, error) = 0 & published = 7 & disposition = "restore-applied", "restore " || error)
  errors = errors + check(scalartext(database, "SELECT lifecycle_state FROM concepts WHERE concept_id='concept-parent'") = "active", "restored state")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM concept_versions WHERE concept_id='concept-parent'") = 4, "versioned split retire restore history")

  malformed = '{"schema":"crexx-rag.lifecycle-action/1","operation":"synonym","concept_id":"concept-peer"}'
  errors = errors + check(insertitem(database, "item-malformed", "synonym", "concept-peer", 7, malformed, error) = 0, error)
  malformed_generation = 0; malformed_disposition = ""; error = ""
  errors = errors + check(applylifecycleaction(store, genericprofile(), "item-malformed", malformed, 7, malformed_generation, malformed_disposition, error) \= 0 & pos("shape", error) > 0 & scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1") = 7, "malformed action rejected without publication")

  verification = .ragverifyresult
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "store verification " || error || " " || verification.summary())
  errors = errors + check(closeragstore(store, error) = 0, "close " || error)
  read_view = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(path, read_view, error) = 0, "read snapshot " || error)
  repository_verification = .ragrepositoryverifyresult
  errors = errors + check(verifyrepositories(read_view, repository_verification, error) = 0 & repository_verification.ok() = 1, "repository verification " || error || " " || repository_verification.summary())
  errors = errors + check(closereadsnapshot(read_view, error) = 0, "close snapshot " || error)
  if errors > 0 then return 1
  say "LIFECYCLE_METHODOLOGY_OK generations=7 synonym=1 split=1 merge=1 type_correction=1 retirement_gate=atomic exact_impact=required ambiguities=resolved conflicts=closed supports=atomic retire=1 restore=1 migration_parent=retained dispositions=complete malformed=rejected repositories=verified"
  return 0
