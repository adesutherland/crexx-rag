options levelg

import rxfnsb
import system
import rxjson
import ragcommand
import ragfoundation
import ragregistry
import operator_registry
import ragfile

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_08_FAIL=" || label
    return 1
  end
  return 0

runcommand: procedure = .ragcommandresult
  arg args = .string[], registry = .ragregistry, expose parse_error = .string
  request = .ragcommandrequest
  if parsecommand(args, request, parse_error) \= 0 then do
    records = .ragresultrecord[]
    return .ragcommandresult("parse", "error", 2, parse_error, records)
  end
  return dispatchfoundation(request, registry)

fieldvalue: procedure = .string
  arg result = .ragcommandresult, record_index = .int, field_name = .string
  records = result.records()
  if record_index < 1 | record_index > records.0 then return ""
  fields = records[record_index].fields()
  do i = 1 to fields.0
    if fields[i].name() = field_name then return fields[i].value()
  end
  return ""

hashfile: procedure = .string
  arg path = .string, expose error = .string
  digest = ""; bytes = 0
  if ragfile..sha256filebounded(path, 2147483647, digest, bytes, error) \= 0 then return ""
  return digest

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
cell = args[1]; root = args[2]
library = root || "/library.cprag"
backup = root || "/backup.cprag"
restored = root || "/restored.cprag"
registry = operatorregistry()
errors = 0; parse_error = ""

/* Denied writes fail before filesystem mutation. */
init_denied_args = .string[]
init_denied_args[1] = "--library"; init_denied_args[2] = library; init_denied_args[3] = "--config"; init_denied_args[4] = "architecture-local"; init_denied_args[5] = "--profile"; init_denied_args[6] = "generic-profile"; init_denied_args[7] = "library"; init_denied_args[8] = "init"
result = runcommand(init_denied_args, registry, parse_error)
errors = errors + check(result.exit_code() = 4 & testdir(library) \= 0, "init access denied before mutation")

init_args = .string[]
init_args[1] = "--library"; init_args[2] = library; init_args[3] = "--config"; init_args[4] = "architecture-local"; init_args[5] = "--profile"; init_args[6] = "generic-profile"; init_args[7] = "--access"; init_args[8] = "admin"; init_args[9] = "library"; init_args[10] = "init"
result = runcommand(init_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & result.operation() = "library.init" & length(fieldvalue(result, 1, "profile_hash")) = 64 & fieldvalue(result, 2, "secret_values") = "0", "initialize through facade " || result.message())

result = runcommand(init_args, registry, parse_error)
errors = errors + check(result.exit_code() = 6, "repeat init conflict")

hash_error = ""
database_before = hashfile(library || "/library.sqlite", hash_error)
manifest_before = hashfile(library || "/manifest.json", hash_error)
errors = errors + check(database_before \= "" & manifest_before \= "", "initial fingerprints " || hash_error)

status_args = .string[]
status_args[1] = "--library"; status_args[2] = library; status_args[3] = "library"; status_args[4] = "status"
result = runcommand(status_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "schema_version") = "5" & fieldvalue(result, 1, "manifest_state") = "aligned", "readonly status code=" || result.exit_code() || " message=" || result.message())

verify_denied_args = .string[]
verify_denied_args[1] = "--library"; verify_denied_args[2] = library; verify_denied_args[3] = "library"; verify_denied_args[4] = "verify"
result = runcommand(verify_denied_args, registry, parse_error)
errors = errors + check(result.exit_code() = 4, "verify diagnose capability code=" || result.exit_code() || " message=" || result.message())
verify_args = .string[]
verify_args[1] = "--library"; verify_args[2] = library; verify_args[3] = "--access"; verify_args[4] = "diagnose"; verify_args[5] = "library"; verify_args[6] = "verify"
result = runcommand(verify_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "issue_count") = "0" & fieldvalue(result, 2, "issue_count") = "0", "storage and repository verify code=" || result.exit_code() || " message=" || result.message())

database_after_read = hashfile(library || "/library.sqlite", hash_error)
manifest_after_read = hashfile(library || "/manifest.json", hash_error)
errors = errors + check(database_before = database_after_read & manifest_before = manifest_after_read, "status and verify zero write")

migrate_args = .string[]
migrate_args[1] = "--library"; migrate_args[2] = library; migrate_args[3] = "--access"; migrate_args[4] = "admin"; migrate_args[5] = "library"; migrate_args[6] = "migrate"
result = runcommand(migrate_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "schema_version") = "5", "migrate current schema code=" || result.exit_code() || " message=" || result.message())
result = runcommand(migrate_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0, "idempotent migrate")

doctor_args = .string[]
doctor_args[1] = "--library"; doctor_args[2] = library; doctor_args[3] = "--config"; doctor_args[4] = "architecture-local"; doctor_args[5] = "doctor"
result = runcommand(doctor_args, registry, parse_error)
records = result.records()
errors = errors + check(result.exit_code() = 0 & records.0 = 9 & fieldvalue(result, 9, "state") = "verified", "doctor capabilities config providers and library")

profile_args = .string[]
profile_args[1] = "--profile"; profile_args[2] = "generic-profile"; profile_args[3] = "profile"; profile_args[4] = "validate"
result = runcommand(profile_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "valid") = "true", "profile validate")
profile_args[2] = "unknown-profile"
result = runcommand(profile_args, registry, parse_error)
errors = errors + check(result.exit_code() = 5, "unknown profile denied")

provider_status_args = .string[]
provider_status_args[1] = "--config"; provider_status_args[2] = "architecture-local"; provider_status_args[3] = "--format"; provider_status_args[4] = "json"; provider_status_args[5] = "provider"; provider_status_args[6] = "status"
result = runcommand(provider_status_args, registry, parse_error)
records = result.records(); output = ""; render_error = ""
render_status = rendercommandresult(result, "json", output, render_error)
document = .jsondocument(output)
errors = errors + check(result.exit_code() = 0 & records.0 = 3 & render_status = 0 & document.valid() = 1 & pos("configured-not-probed", output) > 0 & pos("OPENAI_API_KEY", output) = 0, "provider status is bounded and secret-free")

provider_test_args = .string[]
provider_test_args[1] = "--config"; provider_test_args[2] = "architecture-local"; provider_test_args[3] = "--access"; provider_test_args[4] = "diagnose"; provider_test_args[5] = "provider"; provider_test_args[6] = "test"; provider_test_args[7] = "--provider"; provider_test_args[8] = "local-chat"
result = runcommand(provider_test_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "state") = "configuration-valid" & fieldvalue(result, 1, "outbound_attempted") = "false", "local configuration-only provider test")
provider_test_args[8] = "hosted-strong"
result = runcommand(provider_test_args, registry, parse_error)
errors = errors + check(result.exit_code() = 8 & fieldvalue(result, 1, "state") = "authorization-required" & fieldvalue(result, 1, "credential_resolved") = "false" & fieldvalue(result, 1, "outbound_attempted") = "false", "hosted provider remains approval gated")

database_before_backup = hashfile(library || "/library.sqlite", hash_error)
manifest_before_backup = hashfile(library || "/manifest.json", hash_error)
backup_args = .string[]
backup_args[1] = "--library"; backup_args[2] = library; backup_args[3] = "--access"; backup_args[4] = "admin"; backup_args[5] = "library"; backup_args[6] = "backup"; backup_args[7] = "--output"; backup_args[8] = backup
result = runcommand(backup_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "published") = "true", "backup through facade " || result.message())
errors = errors + check(database_before_backup = hashfile(library || "/library.sqlite", hash_error) & manifest_before_backup = hashfile(library || "/manifest.json", hash_error), "backup source zero write")
result = runcommand(backup_args, registry, parse_error)
errors = errors + check(result.exit_code() = 6 | result.exit_code() = 7, "repeat backup denied")

restore_args = .string[]
restore_args[1] = "--access"; restore_args[2] = "admin"; restore_args[3] = "library"; restore_args[4] = "restore"; restore_args[5] = "--input"; restore_args[6] = backup; restore_args[7] = "--output"; restore_args[8] = restored
result = runcommand(restore_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0 & fieldvalue(result, 1, "published") = "true", "restore through facade " || result.message())
result = runcommand(restore_args, registry, parse_error)
errors = errors + check(result.exit_code() = 6, "repeat restore conflict")

restored_verify_args = .string[]
restored_verify_args[1] = "--library"; restored_verify_args[2] = restored; restored_verify_args[3] = "--access"; restored_verify_args[4] = "diagnose"; restored_verify_args[5] = "library"; restored_verify_args[6] = "verify"
result = runcommand(restored_verify_args, registry, parse_error)
errors = errors + check(result.exit_code() = 0, "restored library verification")

invalid_option_args = .string[]
invalid_option_args[1] = "--library"; invalid_option_args[2] = library; invalid_option_args[3] = "library"; invalid_option_args[4] = "status"; invalid_option_args[5] = "--unknown"; invalid_option_args[6] = "value"
result = runcommand(invalid_option_args, registry, parse_error)
errors = errors + check(result.exit_code() = 2, "operation option denied")

later_args = .string[]
later_args[1] = "--library"; later_args[2] = library; later_args[3] = "query"; later_args[4] = "search"
result = runcommand(later_args, registry, parse_error)
errors = errors + check(result.exit_code() = 8, "later-phase operation unavailable")

if errors \= 0 then return 1
say "P2_08_FOUNDATION_OK cell=" || cell || " commands=10 lifecycle=7 providers=3 provider_calls=0 credential_resolutions=0 read_command_writes=0 restored_verified=1"
return 0
