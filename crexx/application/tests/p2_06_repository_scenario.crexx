options levelg

import rxfnsb
import sqlite_boundary
import ragstore
import ragrepository

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_06_FAIL=" || label
    return 1
  end
  return 0

execsql: procedure = .int
  arg database = .binary, sql = .string, label = .string
  if sqliteexec(database, sql) = 0 then return 0
  say "P2_06_SQL_FAIL=" || label
  return 1

seedgeneration2: procedure = .int
  arg store = .ragstorehandle
  error = ""; generation = 0
  errors = check(begingeneration(store, 1, "config-p206", "P2-06 repository fixture", generation, error) = 0 & generation = 2, "begin generation 2 " || error)
  if errors \= 0 then return errors
  database = store.database()
  errors = errors + execsql(database, "INSERT INTO source_artifacts VALUES('artifact-a','raw-a','application/octet-stream','binary',x'410042FF',NULL,'2026-08-23T10:00:00Z'),('artifact-b','raw-b','text/plain','utf-8',x'42657461',NULL,'2026-08-23T10:00:01Z')", "artifacts generation 2")
  errors = errors + execsql(database, "INSERT INTO source_revision_texts VALUES('text-a','text-digest-a','Alpha text','fixture-extractor','normalizer-v1','2026-08-23T10:00:00Z'),('text-b','text-digest-b','Beta text','fixture-extractor','normalizer-v1','2026-08-23T10:00:01Z')", "texts generation 2")
  errors = errors + execsql(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-a','fixture','stable-a',NULL,'active','fixture://a','Alpha',2),('source-b','fixture','stable-b',NULL,'active','fixture://b','Beta',2)", "sources generation 2")
  errors = errors + execsql(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-a','source-a','envelope-a','artifact-a','text-a','metadata-a','2026-08-23T10:00:00Z',2),('revision-b','source-b','envelope-b','artifact-b','text-b','metadata-b','2026-08-23T10:00:01Z',2)", "revisions generation 2")
  errors = errors + execsql(database, "UPDATE sources SET current_revision_id='revision-'||substr(source_id,8) WHERE source_id IN('source-a','source-b')", "current revisions generation 2")
  errors = errors + execsql(database, "INSERT INTO normalization_maps VALUES('map-a','revision-a',0,10,0,10,1,1),('map-b','revision-b',0,9,0,9,1,1)", "maps generation 2")
  errors = errors + execsql(database, "INSERT INTO chunk_contents VALUES('content-a','content-digest-a','Alpha text','input-a'),('content-b','content-digest-b','Beta text','input-b')", "contents generation 2")
  errors = errors + execsql(database, "INSERT INTO revision_chunks VALUES('chunk-a','revision-a',1,0,10,'content-a','continuity-a','parser-v1','direct',2,NULL),('chunk-b','revision-b',1,0,9,'content-b','continuity-b','parser-v1','direct',2,NULL)", "chunks generation 2")
  errors = errors + execsql(database, "INSERT INTO chunks_fts VALUES('chunk-a','content-a','Alpha text'),('chunk-b','content-b','Beta text')", "FTS generation 2")
  errors = errors + execsql(database, "INSERT INTO concepts VALUES('concept-a','Alpha concept','fixture','active',2,NULL),('concept-b','Beta concept','fixture','active',2,NULL)", "concepts generation 2")
  errors = errors + execsql(database, "INSERT INTO claims VALUES('claim-a','concept-a','relates-to','concept-b','subject-to-object','{}',NULL,NULL,'policy-v1',2,NULL),('claim-b','concept-b','relates-to','concept-a','subject-to-object','{}',NULL,NULL,'policy-v1',2,NULL)", "claims generation 2")
  errors = errors + execsql(database, "INSERT INTO claim_support VALUES('support-a','claim-a','chunk-a',0,5,'supports','assertion','direct','fixture-a','lineage-a','extractor-v1',NULL,2,NULL),('support-b','claim-b','chunk-b',0,4,'supports','assertion','direct','fixture-b','lineage-b','extractor-v1',NULL,2,NULL)", "support generation 2")
  errors = errors + execsql(database, "INSERT INTO embedding_profiles VALUES('embedding-profile','fixture','fixture-model',2,'envelope-v1','2026-08-23T10:00:00Z')", "embedding profile")
  errors = errors + execsql(database, "INSERT INTO embeddings VALUES('embedding-a','input-a','embedding-profile',x'0000803F00000040',2,NULL,'2026-08-23T10:00:00Z'),('embedding-b','input-b','embedding-profile',x'0000404000008040',2,NULL,'2026-08-23T10:00:01Z')", "embeddings generation 2")
  errors = errors + execsql(database, "INSERT INTO revision_chunk_embeddings VALUES('chunk-a','embedding-a',2,NULL),('chunk-b','embedding-b',2,NULL)", "embedding links generation 2")
  errors = errors + execsql(database, "INSERT INTO jobs VALUES('job-a','plan-a','{}','config-p206','running',2,2,20,20,200,1,2,3,'2026-08-23T10:00:00Z','2026-08-23T10:00:00Z'),('job-b','plan-b','{}','config-p206','completed',2,2,20,20,200,0,0,0,'2026-08-23T10:00:01Z','2026-08-23T10:00:01Z')", "jobs generation 2")
  errors = errors + execsql(database, "INSERT INTO job_items VALUES('item-a','job-a','embed','running',1,'worker-a',2000000000,1,0,'idempotency-a','input-a','2026-08-23T10:00:00Z','2026-08-23T10:00:00Z'),('item-b','job-b','embed','processed',1,'worker-b',0,1,0,'idempotency-b','input-b','2026-08-23T10:00:01Z','2026-08-23T10:00:01Z')", "job items generation 2")
  errors = errors + execsql(database, "INSERT INTO attempts VALUES('attempt-a','item-a','worker-a',1,'input-a',NULL,NULL,'valid','running','2026-08-23T10:00:00Z',NULL),('attempt-b','item-b','worker-b',1,'input-b','output-b',NULL,'valid','succeeded','2026-08-23T10:00:01Z','2026-08-23T10:00:02Z')", "attempts generation 2")
  errors = errors + execsql(database, "INSERT INTO reviews VALUES('review-a','ambiguity','concept-a','pending','{}',NULL,'2026-08-23T10:00:00Z',NULL),('review-b','conflict','claim-b','accepted','{}','{}','2026-08-23T10:00:01Z','2026-08-23T10:00:02Z')", "reviews generation 2")
  if errors \= 0 then return errors
  errors = errors + check(commitgeneration(store, 2, error) = 0 & publishmanifest(store, error) = 0, "publish generation 2 " || error)
  return errors

seedgeneration3: procedure = .int
  arg store = .ragstorehandle
  error = ""; generation = 0
  errors = check(begingeneration(store, 2, "config-p206", "P2-06 replacement fixture", generation, error) = 0 & generation = 3, "begin generation 3 " || error)
  if errors \= 0 then return errors
  database = store.database()
  errors = errors + execsql(database, "UPDATE sources SET visible_to_generation=3 WHERE source_id='source-a'; UPDATE source_revisions SET visible_to_generation=3 WHERE revision_id='revision-a'; UPDATE revision_chunks SET visible_to_generation=3 WHERE revision_chunk_id='chunk-a'; UPDATE concepts SET visible_to_generation=3 WHERE concept_id='concept-a'; UPDATE claims SET visible_to_generation=3 WHERE claim_id IN('claim-a','claim-b'); UPDATE claim_support SET visible_to_generation=3 WHERE support_id IN('support-a','support-b'); UPDATE revision_chunk_embeddings SET visible_to_generation=3 WHERE revision_chunk_id='chunk-a'", "close generation 2 visibility")
  errors = errors + execsql(database, "DELETE FROM chunks_fts WHERE revision_chunk_id='chunk-a'", "close generation 2 FTS")
  errors = errors + execsql(database, "INSERT INTO source_artifacts VALUES('artifact-c','raw-c','text/plain','utf-8',x'47616D6D61',NULL,'2026-08-23T11:00:00Z'); INSERT INTO source_revision_texts VALUES('text-c','text-digest-c','Gamma text','fixture-extractor','normalizer-v1','2026-08-23T11:00:00Z'); INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-c','fixture','stable-c',NULL,'active','fixture://c','Gamma',3); INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-c','source-c','envelope-c','artifact-c','text-c','metadata-c','2026-08-23T11:00:00Z',3); UPDATE sources SET current_revision_id='revision-c' WHERE source_id='source-c'", "source generation 3")
  errors = errors + execsql(database, "INSERT INTO normalization_maps VALUES('map-c','revision-c',0,10,0,10,1,1); INSERT INTO chunk_contents VALUES('content-c','content-digest-c','Gamma text','input-c'); INSERT INTO revision_chunks VALUES('chunk-c','revision-c',1,0,10,'content-c','continuity-c','parser-v1','direct',3,NULL); INSERT INTO chunks_fts VALUES('chunk-c','content-c','Gamma text')", "chunk generation 3")
  errors = errors + execsql(database, "INSERT INTO concepts VALUES('concept-c','Gamma concept','fixture','active',3,NULL); INSERT INTO claims VALUES('claim-c','concept-c','relates-to','concept-b','subject-to-object','{}',NULL,NULL,'policy-v1',3,NULL),('claim-d','concept-b','relates-to','concept-c','subject-to-object','{}',NULL,NULL,'policy-v1',3,NULL); INSERT INTO claim_support VALUES('support-c','claim-c','chunk-c',0,5,'supports','assertion','direct','fixture-c','lineage-c','extractor-v1',NULL,3,NULL),('support-d','claim-d','chunk-b',0,4,'supports','assertion','direct','fixture-b','lineage-d','extractor-v1',NULL,3,NULL)", "graph generation 3")
  errors = errors + execsql(database, "INSERT INTO embeddings VALUES('embedding-c','input-c','embedding-profile',x'0000A0400000C040',2,NULL,'2026-08-23T11:00:00Z'); INSERT INTO revision_chunk_embeddings VALUES('chunk-c','embedding-c',3,NULL)", "embedding generation 3")
  errors = errors + execsql(database, "INSERT INTO jobs VALUES('job-c','plan-c','{}','config-p206','running',2,2,20,20,200,1,2,3,'2026-08-23T11:00:00Z','2026-08-23T11:00:00Z'); INSERT INTO job_items VALUES('item-c','job-c','embed','running',1,'worker-c',2000000000,2,0,'idempotency-c','input-c','2026-08-23T11:00:00Z','2026-08-23T11:00:00Z'); INSERT INTO attempts VALUES('attempt-c','item-c','worker-c',2,'input-c',NULL,NULL,'valid','running','2026-08-23T11:00:00Z',NULL); INSERT INTO reviews VALUES('review-c','ambiguity','concept-c','pending','{}',NULL,'2026-08-23T11:00:00Z',NULL)", "operational generation 3")
  if errors \= 0 then return errors
  errors = errors + check(commitgeneration(store, 3, error) = 0 & publishmanifest(store, error) = 0, "publish generation 3 " || error)
  return errors

countrepository: procedure = .int
  arg read_view = .ragreadsnapshot, repository = .string, expose first_identity = .string, expose last_identity = .string, expose pages = .int, expose error = .string
  first_identity = ""; last_identity = ""; pages = 0; total = 0; cursor = ""
  do forever
    page = .ragrepositorypage
    if pagerepository(read_view, repository, cursor, 1, page, error) \= 0 then return -1
    records = page.records()
    if records.0 < 1 then return -2
    pages = pages + 1
    do i = 1 to records.0
      if records[i].repository() \= repository | page.snapshot_generation() \= read_view.generation() then return -3
      total = total + 1
      if first_identity = "" then first_identity = records[i].identity()
      last_identity = records[i].identity()
    end
    next_cursor = page.next_cursor()
    if next_cursor = "" then leave
    if next_cursor = cursor | pages > 100 then return -4
    cursor = next_cursor
  end
  return total

checkrepositories: procedure = .int
  arg read_view = .ragreadsnapshot, expected_operational = .int, expected_generations = .int, label = .string
  names = repositorynames()
  errors = check(names.0 = 16, label || " repository registry")
  do i = 1 to names.0
    expected = 2
    if names[i] = "generations" then expected = expected_generations
    if names[i] = "jobs" | names[i] = "job-items" | names[i] = "attempts" | names[i] = "reviews" then expected = expected_operational
    first = ""; last = ""; pages = 0; error = ""
    actual = countrepository(read_view, names[i], first, last, pages, error)
    errors = errors + check(actual = expected & pages = expected & first \= "" & last \= "", label || " " || names[i] || " count=" || actual || " pages=" || pages || " " || error)
  end
  return errors

projectionchecks: procedure = .int
  arg read_view = .ragreadsnapshot
  errors = 0; error = ""; page = .ragrepositorypage
  errors = errors + check(pagerepository(read_view, "source-artifacts", "", 1, page, error) = 0, "artifact projection " || error)
  records = page.records(); payload = records[1].payload()
  errors = errors + check(records[1].identity() = "artifact-a" & records[1].metric() = 4 & bin2x(payload) = "410042FF", "binary artifact projection")
  errors = errors + check(pagerepository(read_view, "source-revisions", "", 1, page, error) = 0, "revision projection")
  records = page.records()
  errors = errors + check(records[1].parent_identity() = "source-a" & records[1].value() = "Alpha text" & pos("metadata-a", records[1].detail()) > 0, "revision text and provenance projection")
  errors = errors + check(pagerepository(read_view, "normalization-maps", "", 1, page, error) = 0, "map projection")
  records = page.records()
  errors = errors + check(records[1].ordinal() = 1 & records[1].metric() = 1 & pos("raw_start", records[1].detail()) > 0, "normalization map projection")
  errors = errors + check(pagerepository(read_view, "chunk-occurrences", "", 1, page, error) = 0, "chunk projection")
  records = page.records()
  errors = errors + check(records[1].parent_identity() = "revision-a" & records[1].related_identity() = "content-a" & records[1].visible_from_generation() = 2, "chunk occurrence identity")
  errors = errors + check(pagerepository(read_view, "claim-support", "", 1, page, error) = 0, "support projection")
  records = page.records()
  errors = errors + check(records[1].parent_identity() = "claim-a" & records[1].related_identity() = "chunk-a" & pos("lineage-a", records[1].detail()) > 0, "support and lineage projection")
  errors = errors + check(pagerepository(read_view, "embeddings", "", 1, page, error) = 0, "embedding projection")
  records = page.records(); payload = records[1].payload()
  errors = errors + check(records[1].identity() = "embedding-a" & records[1].ordinal() = 2 & records[1].metric() = 8 & bin2x(payload) = "0000803F00000040", "typed embedding payload")
  errors = errors + check(pagerepository(read_view, "jobs", "", 1, page, error) = 0, "job projection")
  records = page.records()
  errors = errors + check(records[1].identity() = "job-a" & records[1].state() = "running" & pos("item_budget", records[1].detail()) > 0, "job budget projection")
  return errors

runscenario: procedure = .int
  arg cell = .string, path = .string
  errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-p2-06-" || cell, "config-p206", "architecture-local", "1", "generic", "profile-hash-p206", "config-hash-p206", '{}', store, error) = 0, "initialize repository fixture " || error)
  errors = errors + seedgeneration2(store)
  if errors \= 0 then return 1
  old_snapshot = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(path, old_snapshot, error) = 0 & old_snapshot.generation() = 2, "pin generation 2 snapshot " || error)
  errors = errors + projectionchecks(old_snapshot)
  old_verification = .ragrepositoryverifyresult
  errors = errors + check(verifyrepositories(old_snapshot, old_verification, error) = 0 & old_verification.ok() = 1, "verify generation 2 repositories " || old_verification.summary() || " " || error)
  errors = errors + seedgeneration3(store)
  errors = errors + check(checkrepositories(old_snapshot, 2, 2, "pinned-old") = 0, "old snapshot paging after live publication")
  first = ""; last = ""; pages = 0
  errors = errors + check(countrepository(old_snapshot, "sources", first, last, pages, error) = 2 & first = "source-a" & last = "source-b", "old source visibility")
  fresh_snapshot = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(path, fresh_snapshot, error) = 0 & fresh_snapshot.generation() = 3, "pin generation 3 snapshot " || error)
  errors = errors + check(checkrepositories(fresh_snapshot, 3, 3, "fresh") = 0, "fresh snapshot paging")
  errors = errors + check(countrepository(fresh_snapshot, "sources", first, last, pages, error) = 2 & first = "source-b" & last = "source-c", "new source visibility")
  fresh_verification = .ragrepositoryverifyresult
  errors = errors + check(verifyrepositories(fresh_snapshot, fresh_verification, error) = 0 & fresh_verification.ok() = 1, "verify generation 3 repositories " || fresh_verification.summary() || " " || error)
  invalid_page = .ragrepositorypage
  errors = errors + check(pagerepository(fresh_snapshot, "unknown", "", 1, invalid_page, error) = -1, "unknown repository denied")
  errors = errors + check(pagerepository(fresh_snapshot, "sources", "", 0, invalid_page, error) = -1 & pagerepository(fresh_snapshot, "sources", copies("x", 513), 1, invalid_page, error) = -1, "pagination bounds denied")
  errors = errors + check(closereadsnapshot(old_snapshot, error) = 0 & pagerepository(old_snapshot, "sources", "", 1, invalid_page, error) = -5, "closed snapshot denied")
  errors = errors + check(closereadsnapshot(fresh_snapshot, error) = 0, "close fresh snapshot")
  if errors \= 0 then return 1

  errors = errors + execsql(store.database(), "UPDATE sources SET current_revision_id='revision-c' WHERE source_id='source-b'; UPDATE jobs SET state='invented' WHERE job_id='job-b'", "inject repository invariant faults")
  bad_snapshot = .ragreadsnapshot; bad_result = .ragrepositoryverifyresult
  errors = errors + check(beginreadsnapshot(path, bad_snapshot, error) = 0 & verifyrepositories(bad_snapshot, bad_result, error) = 0 & bad_result.issue_count() = 2 & pos("sources=1", bad_result.summary()) > 0 & pos("jobs=1", bad_result.summary()) > 0, "detect lifecycle and cross-source orphan faults " || bad_result.summary() || " " || error)
  errors = errors + check(closereadsnapshot(bad_snapshot, error) = 0, "close fault snapshot")
  errors = errors + execsql(store.database(), "UPDATE sources SET current_revision_id='revision-b' WHERE source_id='source-b'; UPDATE jobs SET state='completed' WHERE job_id='job-b'", "repair repository invariant faults")
  final_snapshot = .ragreadsnapshot; final_result = .ragrepositoryverifyresult
  errors = errors + check(beginreadsnapshot(path, final_snapshot, error) = 0 & verifyrepositories(final_snapshot, final_result, error) = 0 & final_result.ok() = 1, "reverify repaired repositories " || final_result.summary() || " " || error)
  errors = errors + check(closereadsnapshot(final_snapshot, error) = 0 & closeragstore(store, error) = 0, "close repository fixture")
  if errors \= 0 then return 1
  say "P2_06_REPOSITORIES_OK cell=" || cell || " repositories=16 page_limit=1 pinned_generation=2 fresh_generation=3 semantic_rows=2 operational_rows=3 binary_payloads=exact invariant_faults=2 provider_calls=0"
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
return runscenario(args[1], args[2])
