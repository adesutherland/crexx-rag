options levelg

import rxfnsb
import rxhash
import rxplatform
import rxfs
import rxsqlite
import ragstore
import ragwork
import ragcommand

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do; say "PROVIDER_DURABILITY_FAIL=" || label; return 1; end
  return 0

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = -1; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-p3r-03", "snapshot-p3r-03", "provider-addendum", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors \= 0 then return 1
  database = store.database(); digest = copies("a", 64)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM sqlite_schema WHERE type='index' AND name IN('attempts_item','attempts_provider_run','job_events_attempt_type','job_events_type','job_items_lease','candidate_mentions_chunk_visibility','mentions_chunk_visibility','aliases_lookup','claims_source_visibility','claims_target_visibility')") = 10, "worker and graph indexes")
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) VALUES('job-p3r-03','" || digest || "','{}','snapshot-p3r-03','queued',1,1,128,64,0,1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert durable job")
  input = '{"schema":"crexx-rag.work-input/1","charging_basis":"subscription-allowance"}'
  input_hash = rxhash..sha256hex(input as .binary)
  sql = "INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-p3r-03','job-p3r-03','claim-extraction','queued',1,'idem-p3r-03','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert durable item")
  errors = errors + check(configurejobbudget(store, "job-p3r-03", 10000, 128, 64, 0, 5000, 1, 3, error) = 0, "configure budget " || error)

  first = .ragworkclaim
  errors = errors + check(claimnext(store, "job-p3r-03", "worker-first", 1, 3, first, error) = 0, "first claim " || error)
  first_reservation = .ragcallreservation
  errors = errors + check(reservecall(store, first, 128, 64, 0, 5000, first_reservation, error) = 0 & first_reservation.codex_turn() = 1, "reserve first subscription turn " || error)
  provider_run = ""
  errors = errors + check(beginexternalrun(store, first, "codex", "default", "request-p3r-03", "subscription-allowance", "thread-p3r-03", 13, provider_run, error) = 0, "persist external thread " || error)
  errors = errors + check(updateexternalrunturn(store, provider_run, "thread-p3r-03", "turn-p3r-03", error) = 0, "persist external turn " || error)
  content = '{"mentions":[],"relationships":[],"notes":[]}'
  errors = errors + check(completeexternalrun(store, provider_run, "thread-p3r-03", "turn-p3r-03", "request-p3r-03", content, 32, 16, error) = 0, "persist completed output " || error)
  call rxplatform..sleep 1200

  second = .ragworkclaim
  errors = errors + check(claimnext(store, "job-p3r-03", "worker-second", 5, 3, second, error) = 0 & second.fence() = first.fence() + 1, "recover expired fence " || error)
  errors = errors + check(scalarint(database, "SELECT reserved_calls+reserved_tokens+reserved_cost+reserved_codex_turns FROM jobs WHERE job_id='job-p3r-03'") = 0, "stale reservation released")
  second_reservation = .ragcallreservation
  errors = errors + check(reservecall(store, second, 128, 64, 0, 5000, second_reservation, error) = 0 & second_reservation.codex_turn() = 0, "recovery does not reserve a second Codex turn " || error)
  recovery = .ragexternalrecovery
  errors = errors + check(recoverexternalrun(store, second.item_id(), "codex", "default", recovery, error) = 0 & recovery.found() = 1 & recovery.state() = "completed" & recovery.thread_id() = "thread-p3r-03" & recovery.turn_id() = "turn-p3r-03" & recovery.content() = content, "recover completed output " || error)
  settled_run = ""
  errors = errors + check(settlecall(store, second_reservation, "codex", "default", recovery.request_id(), "succeeded", recovery.input_tokens(), recovery.output_tokens(), 0, 0, settled_run, error, recovery.provider_run_id(), "subscription-allowance") = 0 & settled_run = provider_run, "settle recovered run " || error)
  errors = errors + check(skipitem(store, second, "recovered no-claim output", error) = 0, "complete recovered item " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM provider_runs WHERE charging_basis='subscription-allowance' AND outcome='succeeded'") = 1, "one subscription provider run")
  errors = errors + check(scalarint(database, "SELECT reserved_calls+reserved_tokens+reserved_cost+reserved_codex_turns FROM jobs WHERE job_id='job-p3r-03'") = 0, "all reservation counters settled")

  admission_first = ""; admission_wait = 0
  errors = errors + check(admitprovidercall(store, first, "gemini", "rate-model", 10, 10, 1000, 1, 250, admission_first, admission_wait, error) = 0, "first global provider admission " || error)
  admission_second = ""; blocked_wait = 0; error = ""
  errors = errors + check(admitprovidercall(store, second, "gemini", "rate-model", 10, 10, 1000, 1, 100, admission_second, blocked_wait, error) = 1 & admission_second = "" & blocked_wait < 50, "concurrent provider admission is blocked before a call")
  error = ""
  errors = errors + check(releaseprovidercall(store, admission_first, 7, "succeeded", error) = 0, "release first global provider admission " || error)
  errors = errors + check(releaseprovidercall(store,admission_first,7,"succeeded",error) = 0,"identical admission release is idempotent " || error)
  errors = errors + check(releaseprovidercall(store,admission_first,9,"succeeded",error) < 0 & pos("conflict",error)>0,"conflicting admission release stays rejected")
  errors = errors + check(releaseprovidercall(store,"missing-admission",8,"succeeded",error) < 0 & pos("existing=missing",error)>0,"missing admission diagnostic")
  admission_second = ""; admission_wait = 0
  errors = errors + check(admitprovidercall(store, second, "gemini", "rate-model", 10, 10, 1000, 1, 250, admission_second, admission_wait, error) = 0, "second global provider admission after release " || error)
  errors = errors + check(releaseprovidercall(store, admission_second, 9, "succeeded", error) = 0, "release second global provider admission " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM provider_admissions WHERE provider_id='gemini' AND model='rate-model' AND outcome='succeeded'") = 2, "global provider admissions are durable")

  preflight_digest = copies("e", 64)
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) VALUES('job-preflight','" || preflight_digest || "','{}','snapshot-p3r-03','queued',1,1,128,64,0,1,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert preflight job")
  sql = "INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-preflight','job-preflight','claim-extraction','queued',1,'idem-preflight','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert preflight item")
  errors = errors + check(configurejobbudget(store, "job-preflight", 10000, 128, 64, 0, 5000, 1, 3, error) = 0, "configure preflight budget " || error)
  preflight_claim = .ragworkclaim
  errors = errors + check(claimnext(store, "job-preflight", "worker-preflight", 5, 3, preflight_claim, error) = 0, "claim preflight item " || error)
  preflight_reservation = .ragcallreservation
  errors = errors + check(reservecall(store, preflight_claim, 128, 64, 0, 5000, preflight_reservation, error) = 0, "reserve preflight call " || error)
  run_count_before = scalarint(database, "SELECT count(*) FROM provider_runs")
  uncalled_run = ""
  errors = errors + check(settlecall(store, preflight_reservation, "gemini", "rate-model", "preflight-denied", "failed", 0, 0, 0, 1, uncalled_run, error, "", "monetary-api", 0) = 0 & uncalled_run = "", "settle uncalled preflight without provider run " || error)
  errors = errors + check(failattempt(store, preflight_claim, 0, 0, 1, "provider admission denied before call", error) = 0, "close uncalled preflight attempt " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM provider_runs") = run_count_before & scalarint(database, "SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='job-preflight'") = 0, "uncalled failures are not counted as provider calls")

  pause_digest = copies("b", 64)
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) VALUES('job-pause','" || pause_digest || "','{}','snapshot-p3r-03','queued',2,2,256,128,0,0,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert pause job")
  sql = "INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-pause-a','job-pause','claim-extraction','queued',2,'idem-pause-a','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now')),('item-pause-b','job-pause','claim-extraction','queued',1,'idem-pause-b','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert pause items")
  paused_claim = .ragworkclaim
  errors = errors + check(claimnext(store, "job-pause", "worker-pause", 5, 3, paused_claim, error) = 0, "claim before pause " || error)
  errors = errors + check(pausejob(store, "job-pause", error) = 0, "pause active job " || error)
  errors = errors + check(skipitem(store, paused_claim, "pause race regression", error) = 0, "complete in-flight paused item " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-pause' AND state='paused'") = 1 & scalarint(database, "SELECT count(*) FROM job_items WHERE job_id='job-pause' AND state='queued'") = 1, "in-flight completion preserves pause")

  retry_digest = copies("c", 64)
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) VALUES('job-retry','" || retry_digest || "','{}','snapshot-p3r-03','completed_with_errors',2,2,256,128,0,0,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert retry job")
  sql = "INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-retry-a','job-retry','claim-extraction','dead_letter',2,'idem-retry-a','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now')),('item-retry-b','job-retry','claim-extraction','dead_letter',1,'idem-retry-b','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert retry items")
  retried = 0
  errors = errors + check(retrydeadletter(store, "job-retry", "item-retry-a", "batch retry regression a", retried, error) = 0 & retried = 1, "first dead-letter retry " || error)
  retried = 0
  errors = errors + check(retrydeadletter(store, "job-retry", "item-retry-b", "batch retry regression b", retried, error) = 0 & retried = 1, "second dead-letter retry " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-retry' AND state='queued'") = 1 & scalarint(database, "SELECT count(*) FROM job_items WHERE job_id='job-retry' AND state='queued'") = 2 & scalarint(database, "SELECT count(*) FROM job_events WHERE job_id='job-retry' AND event_type='operator-retry'") = 2, "dead letters can be queued as one batch")

  replay_digest = copies("d", 64)
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,codex_turn_budget,created_at,updated_at) VALUES('job-replay-source','" || replay_digest || "','{}','snapshot-p3r-03','completed_with_errors',2,2,256,128,0,0,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert replay source job")
  sql = "INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-replay-source-a','job-replay-source','claim-extraction','dead_letter',2,'idem-replay-source-a','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now')),('item-replay-source-b','job-replay-source','claim-extraction','dead_letter',1,'idem-replay-source-b','" || input_hash || "','" || input || "',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert immutable replay source items")
  sql = "INSERT INTO config_snapshots(config_snapshot_id,config_id,config_version,profile_id,profile_hash,config_hash,effective_json,created_at,semantic_hash,operational_hash) SELECT 'snapshot-stale',config_id,config_version,profile_id,profile_hash,'stale-config-hash',effective_json,strftime('%Y-%m-%dT%H:%M:%fZ','now'),semantic_hash,operational_hash FROM config_snapshots WHERE config_snapshot_id='snapshot-p3r-03'"
  errors = errors + check(sqliteexec(database, sql) = 0, "insert semantically compatible stale replay target")
  replay_policy = '{"time_budget_ms":10000,"maximum_call_input_tokens":128,"maximum_call_output_tokens":64,"maximum_call_cost":0,"maximum_call_time_ms":5000,"maximum_inflight_calls":1,"maximum_attempts":3}'
  stale_replay_job = ""; stale_replayed = 0; error = ""
  stale_replay_status = replaydeadletters(store, "job-replay-source", "", "snapshot-stale", "stale target regression", 2, 2, 256, 128, 0, 2, replay_policy, stale_replay_job, stale_replayed, error)
  errors = errors + check(stale_replay_status = -3 & stale_replay_job \= "" & stale_replayed = 0 & pos("no longer current", error) > 0, "replay rejects a stale configuration target inside its transaction")
  replay_job = ""; replayed = 0
  error = ""
  replay_status = replaydeadletters(store, "job-replay-source", "", "snapshot-p3r-03", "immutable replay regression", 2, 2, 256, 128, 0, 2, replay_policy, replay_job, replayed, error)
  errors = errors + check(replay_status = 0, "create immutable dead-letter replay " || error)
  errors = errors + check(replayed = 2 & replay_job \= "", "dead-letter replay returns its new job and item count")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-replay-source' AND state='completed_with_errors'") = 1 & scalarint(database, "SELECT count(*) FROM job_items WHERE job_id='job-replay-source' AND state='dead_letter'") = 2, "replay leaves source job and dead letters immutable")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='" || replay_job || "' AND state='queued'") = 1 & scalarint(database, "SELECT count(*) FROM job_replays WHERE replay_job_id='" || replay_job || "' AND source_job_id='job-replay-source'") = 1 & scalarint(database, "SELECT count(*) FROM job_replay_items WHERE replay_job_id='" || replay_job || "'") = 2, "replay job and item lineage are durable")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM job_items WHERE job_id='" || replay_job || "' AND state='queued' AND json_extract(input_json,'$.config_snapshot_id')='snapshot-p3r-03'") = 2, "replay items bind the reviewed target configuration")
  errors = errors + check(scalarint(database, "SELECT count(*) FROM dead_letter_reconciliation WHERE root_job_id='job-replay-source' AND reconciliation_state='in-progress' AND replay_count=1") = 2, "dead-letter reconciliation reports immutable replay work in progress")

  replay_claim = .ragworkclaim; replay_reservation = .ragcallreservation
  errors = errors + check(claimnext(store, replay_job, "replay-worker", 30, 3, replay_claim, error) = 0, "claim replay work " || error)
  errors = errors + check(reservecall(store, replay_claim, 128, 64, 0, 5000, replay_reservation, error) = 0, "replay worker can reserve against its durable policy " || error)
  replay_run = ""
  errors = errors + check(settlecall(store, replay_reservation, "fixture", "fixture-model", "replay-call", "succeeded", 8, 4, 0, 1, replay_run, error) = 0, "settle replay provider call " || error)
  errors = errors + check(skipitem(store, replay_claim, "no supported claim", error) = 0, "complete replay item " || error)
  errors = errors + check(requestcancel(store, replay_job, "cancel remaining replay work", error) = 0, "cancel queued replay remainder " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='" || replay_job || "' AND state='cancelled'") = 1, "queued cancellation reaches terminal state without a worker")
  errors = errors + check(requestcancel(store, "job-pause", "cancel drained paused job", error) = 0, "cancel drained paused job " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-pause' AND state='cancelled'") = 1, "paused cancellation reaches terminal state")

  cancelling_claim = .ragworkclaim
  errors = errors + check(claimnext(store, "job-retry", "cancel-worker", 5, 3, cancelling_claim, error) = 0, "claim cancellation race fixture " || error)
  errors = errors + check(requestcancel(store, "job-retry", "cancel in-flight work", error) = 0, "request in-flight cancellation " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-retry' AND state='cancel_requested'") = 1, "running work keeps cancellation pending")
  errors = errors + check(sqliteexec(database, "UPDATE job_items SET lease_until=CAST(strftime('%s','now') AS INTEGER)-1 WHERE job_id='job-retry' AND state='cancel_requested'") = 0, "expire cancelled lease deterministically")
  empty_claim = .ragworkclaim
  errors = errors + check(claimnext(store, "job-retry", "recovery-worker", 5, 3, empty_claim, error) = 1, "expired cancellation needs no new claim " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-retry' AND state='cancelled'") = 1 & scalarint(database, "SELECT count(*) FROM job_items WHERE job_id='job-retry' AND state='cancelled'") = 2, "expired cancellation refreshes the terminal job")
  errors = errors + check(requestcancel(store, "job-preflight", "preserve failed terminal summary", error) = 0, "cancel already drained error job " || error)
  errors = errors + check(scalarint(database, "SELECT count(*) FROM jobs WHERE job_id='job-preflight' AND state='completed_with_errors'") = 1, "cancellation preserves dead-letter outcome")

  arguments = .string[]; arguments[1] = "--library"; arguments[2] = path; arguments[3] = "config"; arguments[4] = "apply"; arguments[5] = "--plan-json"; arguments[6] = copies("p", 70000)
  parsed_command = .ragcommandrequest; parse_error = ""
  errors = errors + check(parsecommand(arguments, parsed_command, parse_error) = 0, "large plan input has the same bound as its renderer " || parse_error)
  plan_fields = .ragresultfield[]; plan_fields[1] = .ragresultfield("canonical_plan", "string", copies("p", 70000))
  plan_records = .ragresultrecord[]; plan_records[1] = .ragresultrecord("canonical-plan", plan_fields)
  plan_result = .ragcommandresult("maintain.plan", "ok", 0, "large reviewed plan", plan_records); render_error = ""
  errors = errors + check(validcommandresult(plan_result, render_error) = 0, "large canonical plan remains machine-renderable " || render_error)
  ordinary_fields = .ragresultfield[]; ordinary_fields[1] = .ragresultfield("detail", "string", copies("d", 70000))
  ordinary_records = .ragresultrecord[]; ordinary_records[1] = .ragresultrecord("diagnostic", ordinary_fields)
  ordinary_result = .ragcommandresult("doctor", "ok", 0, "ordinary bound", ordinary_records); render_error = ""
  errors = errors + check(validcommandresult(ordinary_result, render_error) \= 0 & render_error = "string field is too long", "ordinary result string bound remains enforced")
  evidence_fields = .ragresultfield[]; evidence_fields[1] = .ragresultfield("evidence_json", "string", copies("e", 70000)); evidence_fields[2] = .ragresultfield("generated_answer", "string", "bounded human answer")
  evidence_records = .ragresultrecord[]; evidence_records[1] = .ragresultrecord("query-evidence", evidence_fields)
  evidence_result = .ragcommandresult("query.answer", "ok", 0, "large machine evidence", evidence_records); render_error = ""; rendered = ""
  errors = errors + check(rendercommandresult(evidence_result, "human", rendered, render_error) = 0 & pos("bounded human answer", rendered) > 0 & pos(copies("e", 100), rendered) = 0, "large evidence remains machine-valid and is omitted from human rendering " || render_error)

  upgrade = .binary; upgrade_path = path || "/upgrade-bundle"
  errors = errors + check(rxfs..mkdir(upgrade_path) = 0, "create upgrade bundle")
  errors = errors + check(sqliteopenmode(upgrade_path || "/library.sqlite", "create", upgrade) = 0, "open upgrade fixture")
  errors = errors + check(applymigrations(upgrade, "crexxrag-old", 1, error) = 0, "install schema version one " || error)
  sql = "INSERT INTO config_snapshots(config_snapshot_id,config_id,config_version,profile_id,profile_hash,config_hash,effective_json,created_at) VALUES('snapshot-upgrade','upgrade','1','generic-profile','profile-hash','config-hash','{}',strftime('%Y-%m-%dT%H:%M:%fZ','now'));INSERT INTO published_generations(generation,parent_generation,state,config_snapshot_id,summary,created_at,published_at) VALUES(1,NULL,'published','snapshot-upgrade','upgrade fixture',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'));INSERT INTO library_meta(singleton,library_id,bundle_format_version,schema_version,published_generation,next_generation,active_profile_id,active_profile_hash,required_capabilities,created_at,updated_at) VALUES(1,'library-upgrade',1,1,1,2,'generic-profile','profile-hash','sqlite-provider-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(upgrade, sql) = 0, "seed schema version one")
  errors = errors + check(applymigrations(upgrade, "crexxrag", 6, error) = 0, "upgrade schema one to six " || error)
  errors = errors + check(validatemigrations(upgrade, error) = 0, "validate an older supported schema before migration " || error)
  digest = copies("0", 64)
  sql = "INSERT INTO provider_runs(provider_run_id,config_snapshot_id,provider_id,model,request_hash,outcome,input_tokens,output_tokens,duration_ms,started_at,completed_at) VALUES('upgrade-report-run','snapshot-upgrade','gemini-generate','gemini-test','request-hash','succeeded',10,2,3,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'));INSERT INTO report_snapshots(report_id,semantic_generation,profile_hash,report_schema,top_limit,semantic_digest,semantic_json,created_at) VALUES('upgrade-report',1,'profile-hash','crexx-rag.library-report/1',10,'" || digest || "','{}',strftime('%Y-%m-%dT%H:%M:%fZ','now'));INSERT INTO report_narratives(narrative_id,report_id,operational_digest,provider_run_id,provider_id,model,prompt_version,narrative_json,input_tokens,output_tokens,cost_microunits,allowance_before_percent,allowance_after_percent,created_at) VALUES('upgrade-narrative','upgrade-report','" || digest || "','upgrade-report-run','gemini-generate','gemini-test','prompt-v1','{}',10,2,123,-1,-1,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  errors = errors + check(sqliteexec(upgrade, sql) = 0, "seed provider history backfill fixture")
  errors = errors + check(applymigrations(upgrade, "crexxrag", 8, error) = 0, "upgrade schema six to eight " || error)
  sql = "INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('legacy-empty-job','legacy-empty-plan','{}','snapshot-upgrade','paused',1,1,1,1,0,'fixture','fixture'); INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('legacy-empty-item','legacy-empty-job','embedding','dead_letter',1,'legacy-empty-key','legacy-empty-hash','','fixture','fixture')"
  errors = errors + check(sqliteexec(upgrade,sql) = 0,"retain malformed legacy input for migration validation")
  upgrade_store = .ragstorehandle(upgrade, upgrade_path, "readwrite")
  errors = errors + check(publishmanifest(upgrade_store, error) = 0, "publish schema eight manifest " || error)
  errors = errors + check(closeragstore(upgrade_store, error) = 0, "close schema eight bundle " || error)
  errors = errors + check(openragstore(upgrade_path, "readwrite", upgrade_store, error) = 0, "automatic schema eight to eleven migration " || error)
  upgrade = upgrade_store.database(); manifest_state = ""
  errors = errors + check(manifeststate(upgrade_store, manifest_state, error) = 0 & manifest_state = "aligned", "automatic migration aligns manifest " || error)
  errors = errors + check(scalarint(upgrade, "SELECT count(*) FROM schema_migrations WHERE version IN(2,3,4,5,6,7,8,9) AND name IN('worker-hot-path-indexes','provider-run-accounting-index','library-report-cache','historic-observability','configuration-lifecycle-and-provider-resilience','indexed-term-statistics-and-backlog-reconciliation','direct-provider-history','prospective-configuration-transitions')") = 8 & scalarint(upgrade, "SELECT schema_version FROM library_meta WHERE singleton=1") = 13 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='index' AND name IN('job_items_lease','attempts_provider_run','report_narratives_cache','observation_decisions_outcome','observation_snapshots_history','provider_admissions_window','provider_admissions_active','job_replays_source','provider_runs_purpose_history')") = 9 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='table' AND name IN('report_snapshots','report_narratives','observation_decisions','observation_snapshots','library_config_state','config_change_events','provider_admissions','job_replays','job_replay_items','chunks_fts_vocab')") = 10 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='table' AND name='config_change_events_v8'") = 0 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE sql LIKE '%prospective%' AND name='config_change_events'") = 1 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='view' AND name='dead_letter_reconciliation'") = 1 & scalarint(upgrade, "SELECT count(*) FROM provider_runs WHERE provider_run_id='upgrade-report-run' AND cost_microunits=123 AND purpose='report-narrative'") = 1, "schema version one upgrade is complete")
  errors = errors + check(scalarint(upgrade, "SELECT count(*) FROM schema_migrations WHERE version=11 AND name='claim-time-and-source-provenance'") = 1 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='table' AND name IN('source_descriptions','source_relations','support_descriptions')") = 3 & scalarint(upgrade, "SELECT count(*) FROM sqlite_schema WHERE type='index' AND name IN('source_description_active_scope','source_description_history','source_relation_history','support_description_active','support_description_history')") = 5, "schema eleven provenance migration and indexes")
  errors = errors + check(closeragstore(upgrade_store, error) = 0, "close upgrade fixture " || error)
  cooling = .ragworkclaim[]
  do i = 1 to 8
    attempt_id = "cooldown-attempt-" || i
    sql = "INSERT INTO attempts(attempt_id,item_id,worker_id,fence,input_hash,validation_state,outcome,started_at,completed_at) SELECT '" || attempt_id || "',item_id,'cooldown-worker-" || i || "',fence,input_hash,'fixture','cancelled','fixture','fixture' FROM attempts WHERE attempt_id='" || first.attempt_id() || "'"
    errors = errors + check(sqliteexec(database,sql)=0,"create independent cooldown attempt")
    cooling[i] = .ragworkclaim(0,first.job_id(),first.item_id(),first.item_type(),first.input_hash(),"cooldown-worker-" || i,first.fence(),attempt_id,first.lease_until(),first.config_snapshot_id())
  end
  admitted = ""; waited = 0
  errors = errors + check(admitprovidercall(store,cooling[1],"gemini","cooldown",10,100,10000,8,100,admitted,waited,error)=0,"admit initial cooldown call")
  errors = errors + check(releaseprovidercall(store,admitted,0,"failed",error,5000,5000,60000)=0,"persist shared cooldown")
  do i = 2 to 8
    rejected = ""
    errors = errors + check(admitprovidercall(store,cooling[i],"gemini","cooldown",10,100,10000,8,100,rejected,waited,error)=1 & rejected="","all peers respect cooldown")
  end
  errors = errors + check(scalarint(database,"SELECT count(*) FROM provider_admissions WHERE model='cooldown'")=1,"cooldown makes no peer calls")
  errors = errors + check(sqliteexec(database,"UPDATE provider_cooldowns SET not_before_epoch=unixepoch()-1 WHERE model='cooldown'")=0,"advance fixture cooldown clock")
  probe = ""
  errors = errors + check(admitprovidercall(store,cooling[2],"gemini","cooldown",10,100,10000,8,100,probe,waited,error)=0,"single recovery probe admitted")
  rejected = ""
  errors = errors + check(admitprovidercall(store,cooling[3],"gemini","cooldown",10,100,10000,8,100,rejected,waited,error)=1,"second probe stays deferred despite concurrency eight")
  errors = errors + check(releaseprovidercall(store,probe,0,"failed",error,5000,5000,60000)=0,"second failure grows provider cooldown")
  errors = errors + check(scalarint(database,"SELECT failure_count FROM provider_cooldowns WHERE model='cooldown'")=2 & scalarint(database,"SELECT not_before_epoch-unixepoch() FROM provider_cooldowns WHERE model='cooldown'")>=9,"shared exponential failure history")
  errors = errors + check(releaseprovidercall(store,probe,0,"failed",error,5000,5000,60000)=0 & scalarint(database,"SELECT failure_count FROM provider_cooldowns WHERE model='cooldown'")=2,"duplicate settlement cannot grow cooldown")
  errors = errors + check(closeragstore(store,error)=0 & openragstore(path,"readwrite",store,error)=0,"reopen retains cooldown")
  database = store.database(); rejected = ""
  errors = errors + check(admitprovidercall(store,cooling[3],"gemini","cooldown",10,100,10000,8,100,rejected,waited,error)=1,"restart cannot bypass cooldown")
  errors = errors + check(sqliteexec(database,"UPDATE provider_cooldowns SET not_before_epoch=unixepoch()-1 WHERE model='cooldown'")=0,"advance fixture recovery clock")
  errors = errors + check(admitprovidercall(store,cooling[3],"gemini","cooldown",10,100,10000,8,100,probe,waited,error)=0 & releaseprovidercall(store,probe,1,"succeeded",error)=0,"successful recovery clears cooldown")
  errors = errors + check(scalarint(database,"SELECT failure_count+not_before_epoch FROM provider_cooldowns WHERE model='cooldown'")=0,"provider recovered")
  errors = errors + check(closeragstore(store, error) = 0, "close " || error)
  if errors \= 0 then do; say "PROVIDER_DURABILITY_ERRORS=" || errors; return 1; end
  say "PROVIDER_DURABILITY_OK completed_turn_reused=1 codex_turns=1 stale_reservations=0 fence=2 admissions=durable uncalled_provider_runs=0 paused_completion=sticky batch_retry=2 replay=immutable reconciliation=in-progress indexes=11 migration=1to6-validated-to11 provider_history=costed prospective_config=audited large_plan=renderable"
  return 0
