options levelg

import rxfnsb
import ragconfig
import ragconfigfile
import ragfile
import ragglossary
import ragprofilefile
import ragcanonical

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "CONFIG_CONTRACT_FAIL=" || label
    return 1
  end
  return 0

rejected: procedure = .int
  arg text = .string, marker = .string
  candidate = .ragconfig; error = ""
  status = parseconfigtext(text, candidate, error)
  return status \= 0 & pos(marker, error) > 0

main: procedure = .int
  arg args = .string[]
  if args.0 \= 9 then do; say "CONFIG_CONTRACT_FAIL=arguments"; return 1; end
  cell = args[1]; path = args[2]; errors = 0; error = ""

  config = .ragconfig
  errors = errors + check(loadconfigfile(path, config, error) = 0, "bounded file load " || error)
  providers = config.providers(); roles = config.roles(); sources = config.source_sets()
  config_snapshot = config.snapshot(); budget = config.budget(); workers = config.workers()
  retrieval = config.retrieval(); maintenance = config.maintenance(); observation = config.observation(); schedules = config.schedules()
  errors = errors + check(config.config_id() = "google-gemini" & config.version() = "1", "identity")
  errors = errors + check(providers.0 = 2 & providers[1].kind() = "gemini" & providers[2].kind() = "gemini", "Google providers")
  errors = errors + check(providers[1].credential().ref_string() = "env:GEMINI_API_KEY" & config_snapshot.secret_reference_count() = 2, "symbolic secrets")
  errors = errors + check(roles.0 = 4 & sources.0 = 1 & right(sources[1].root(), 12) = "/source-docs", "roles and source")
  errors = errors + check(roles[2].role() = "extractor" & roles[2].maximum_input_tokens() = 8192 & roles[2].maximum_output_tokens() = 4096 & roles[2].system_prompt() \= "", "typed extractor envelope")
  errors = errors + check(roles[3].role() = "embedding" & roles[3].embedding_dimensions() = 768 & roles[3].batch_size() = 100, "typed embedding envelope")
  errors = errors + check(providers[1].context_tokens() = 1048576 & providers[1].maximum_output_tokens() = 65536 & providers[1].input_price_microunits_per_million() = 300000 & providers[2].maximum_batch_size() = 100, "configured provider catalogue")
  errors = errors + check(budget.model_calls() = 50 & budget.input_tokens() = 100000 & workers.processes() = 1 & workers.max_in_flight() = 1 & workers.poll_ms() = 100 & workers.guided_deadline_seconds() = 0, "bounded policy")
  errors = errors + check(retrieval.lexical_candidates() = 48 & retrieval.vector_candidates() = 12 & retrieval.vector_scan_limit() = 100000 & retrieval.graph_hops() = 3 & retrieval.rrf_k() = 60 & retrieval.graph_direction() = "both" & retrieval.maximum_evidence_bytes() = 262144, "retrieval policy")
  errors = errors + check(maintenance.sparse_max_degree() = 1 & maintenance.query_gap_min_occurrences() = 1 & maintenance.batch_items() = 1000 & observation.capture_threshold() = 50 & observation.cooldown_seconds() = 900 & observation.narrative_output_tokens() = 4096, "maintenance and observation policy")
  errors = errors + check(schedules.0 = 1 & schedules[1].operation() = "maintain.plan" & schedules[1].trigger() = "manual", "schedule operation")

  raw = .binary; bytes = 0
  errors = errors + check(ragfile..readbinaryfilebounded(path, 65536, raw, bytes, error) = 0, "fixture reread")
  text = raw as .string
  time_config = .ragconfig; time_baseline = .ragconfig; time_error = ""
  errors = errors + check(parseconfigtext(text,time_baseline,time_error) = 0,"provider-time baseline parses")
  errors = errors + check(maintenance.provider_time_minutes() = 0,"provider-time cap is opt-in")
  errors = errors + check(parseconfigtext(text || "0A"x || "maintenance.provider_time_minutes = 260",time_config,time_error) = 0 & time_config.maintenance().provider_time_minutes() = 260,"explicit provider-time cap parses")
  errors = errors + check(canonicalsemanticconfig(time_config) = canonicalsemanticconfig(time_baseline),"provider-time cap is operational")
  errors = errors + check(rejected(text || "0A"x || "maintenance.provider_time_minutes = 10081","outside its supported range") = 1,"provider-time cap is bounded")
  errors = errors + check(providers[1].reasoning_effort() = "" & pos('"reasoning_effort"', canonicalconfig(config)) = 0, "omitted effort preserves existing canonical identity")
  errors = errors + check(rejected(text || "0A"x || "provider.gemini-generate.reasoning_effort = low", "reasoning_effort") = 1, "non-Codex effort rejected")
  codex_text = changestr("provider.gemini-generate.kind = gemini", text, "provider.gemini-generate.kind = codex")
  codex_text = changestr("provider.gemini-generate.base_url = https://generativelanguage.googleapis.com/v1beta", codex_text, "provider.gemini-generate.base_url = app-server://local")
  codex_text = changestr("provider.gemini-generate.credential = env:GEMINI_API_KEY", codex_text, "provider.gemini-generate.credential = none")
  low_config = .ragconfig; high_config = .ragconfig; effort_error = ""
  errors = errors + check(parseconfigtext(codex_text || "0A"x || "provider.gemini-generate.reasoning_effort = low", low_config, effort_error) = 0, "low effort config " || effort_error)
  errors = errors + check(parseconfigtext(codex_text || "0A"x || "provider.gemini-generate.reasoning_effort = high", high_config, effort_error) = 0, "high effort config " || effort_error)
  low_providers = low_config.providers()
  errors = errors + check(low_providers[1].reasoning_effort() = "low", "typed Codex effort")
  errors = errors + check(canonicalsemanticconfig(low_config) \= canonicalsemanticconfig(high_config) & canonicaloperationalconfig(low_config) = canonicaloperationalconfig(high_config), "effort change is prospective")
  errors = errors + check(rejected(codex_text || "0A"x || "provider.gemini-generate.reasoning_effort = invalid", "reasoning_effort") = 1, "invalid effort rejected")
  errors = errors + check(rejected(codex_text || "0A"x || "provider.gemini-generate.reasoning_effort = low medium", "reasoning_effort") = 1, "multiple effort names rejected")
  errors = errors + check(rejected(text || "0A"x || "config.id = duplicate", "duplicated") = 1, "duplicate rejection")
  errors = errors + check(rejected(text || "0A"x || "module.loader = arbitrary.crexx", "unknown or invalid key") = 1, "module key rejection")
  errors = errors + check(rejected(changestr("env:GEMINI_API_KEY", text, "literal-secret"), "literal secrets are forbidden") = 1, "literal secret rejection")
  errors = errors + check(rejected(changestr("./source-docs", text, "../source-docs"), "traversal") = 1, "path traversal rejection")
  errors = errors + check(rejected(changestr("kind = gemini", text, "kind = unsupported"), "provider kind is not supported") = 1, "provider kind rejection")
  errors = errors + check(rejected(changestr("https://", text, "http://"), "hosted provider URL must use HTTPS") = 1, "hosted route rejection")
  v1_config = .ragconfig; v1_error = ""
  errors = errors + check(parseconfigtext(changestr("crexx-rag.config/3", text, "crexx-rag.config/1"), v1_config, v1_error) = 0, "format one compatibility parse " || v1_error)
  v1_roles = v1_config.roles()
  errors = errors + check(v1_roles[2].maximum_output_tokens() = 4096 & pos("grounding=partial", v1_roles[4].system_prompt()) > 0 & pos("only citation IDs present", v1_roles[4].system_prompt()) > 0, "format one repaired compatibility envelope")
  v2_text = changestr("crexx-rag.config/3", text, "crexx-rag.config/2")
  v2_config = .ragconfig; v2_error = ""
  errors = errors + check(parseconfigtext(v2_text, v2_config, v2_error) = 0, "format two parse " || v2_error)
  v2_providers = v2_config.providers()
  errors = errors + check(v2_providers[1].requests_per_minute() = 60 & v2_providers[1].tokens_per_minute() = 1000000 & v2_providers[1].concurrent_requests() = 2 & v2_providers[1].initial_backoff_ms() = 1000 & v2_providers[1].maximum_backoff_ms() = 60000 & v2_providers[1].jitter_ms() = 250, "format two provider policy")
  invalid_backoff = changestr("provider.gemini-generate.initial_backoff_ms = 1000", v2_text, "provider.gemini-generate.initial_backoff_ms = 60001")
  errors = errors + check(rejected(invalid_backoff, "outside its supported range") = 1, "backoff bound rejection")
  errors = errors + check(rejected(changestr("budget.model_calls = 50", text, "budget.model_calls = 050"), "canonical integer syntax") = 1, "integer syntax rejection")
  errors = errors + check(rejected(changestr("retrieval.claim_limit = 8", text, "retrieval.claim_limit = 9"), "outside its supported range") = 1, "claim result bound rejection")
  errors = errors + check(rejected(changestr("retrieval.maximum_evidence_bytes = 262144", text, "retrieval.maximum_evidence_bytes = 1048577"), "outside its supported range") = 1, "evidence byte ceiling bound rejection")
  errors = errors + check(rejected(changestr("maintenance.batch_items = 1000", text, "maintenance.batch_items = 100001"), "outside its supported range") = 1, "maintenance batch bound rejection")
  errors = errors + check(rejected(changestr("observation.narrative_output_tokens = 4096", text, "observation.narrative_output_tokens = 8193"), "outside its supported range") = 1, "narrative output bound rejection")
  errors = errors + check(rejected(copies("x", 65537), "65536") = 1, "file-size bound")
  errors = errors + check(rejected(copies("# bounded" || "0A"x, 513), "512-line") = 1, "line-count bound")

  loader = .ragglossaryloader(); loaded = loader.load(args[3]); glossary = loaded.glossary()
  glossary_entries = .ragglossaryentry[]; glossary_entries = glossary.entries()
  glossary_excluded = .string[]; glossary_excluded = glossary.excluded()
  errors = errors + check(loaded.status() = 0 & glossary_entries.0 = 2 & glossary_excluded.0 = 1 & length(glossary.digest()) = 64 & pos("crexx-rag.glossary/1", glossary.canonical()) > 0, "bounded glossary load " || loaded.error())
  rejected_glossary = loader.load(args[4])
  errors = errors + check(rejected_glossary.status() \= 0 & pos("duplicated", rejected_glossary.error()) > 0, "duplicate glossary canonical rejection")
  rejected_glossary = loader.load(args[5])
  errors = errors + check(rejected_glossary.status() \= 0 & pos("alias is duplicated", rejected_glossary.error()) > 0, "cross-concept alias rejection")
  rejected_glossary = loader.load(args[6])
  errors = errors + check(rejected_glossary.status() \= 0 & pos("collides", rejected_glossary.error()) > 0, "late exclusion collision rejection")
  rejected_glossary = loader.load(args[7])
  errors = errors + check(rejected_glossary.status() \= 0 & pos("format declaration is missing", rejected_glossary.error()) > 0, "missing glossary format rejection")
  rejected_glossary = loader.load(args[3] || ".missing")
  errors = errors + check(rejected_glossary.status() \= 0 & pos("could not be read", rejected_glossary.error()) > 0, "missing glossary path rejection")

  context = ""; error = ""
  errors = errors + check(creatediscoverycontext(glossary, "all", 16, 16, 16, 8, context, error) = 0 & pos(glossary.canonical(), context) > 0, "durable glossary context " || error)
  aliases = .string[]; aliases[1] = "Billing Service"
  errors = errors + check(validateglossarymention(context, "BillingService", "BillingService", "application-component", aliases, error) = 1, "glossary provider identity " || error)
  clear aliases; error = ""
  errors = errors + check(validateglossarymention(context, "DeprecatedSystem", "DeprecatedSystem", "application-component", aliases, error) \= 1 & pos("excluded", error) > 0, "provider exclusion rejection")
  aliases[1] = "Billing Service"; error = ""
  errors = errors + check(validateglossarymention(context, "BillingService", "WrongCanonical", "application-component", aliases, error) \= 1 & pos("contradicts", error) > 0, "provider glossary identity rejection")
  aliases[2] = "Customer DB"; error = ""
  errors = errors + check(validateglossarymention(context, "BillingService", "BillingService", "application-component", aliases, error) \= 1 & pos("conflicting", error) > 0, "provider cross-concept glossary rejection")

  profile_loader = .ragprofileloader(); loaded_profile = profile_loader.load(args[8], "scottish-history-profile")
  profile = loaded_profile.profile()
  errors = errors + check(loaded_profile.status() = 0 & profile.profile_id() = "scottish-history-profile" & profile.version() = "1" & profile.validation().ok() = 1, "bounded profile load " || loaded_profile.error())
  data_config_text = changestr("profiles = generic-profile,it-architecture-profile", text, "profiles = scottish-history-profile") || "0A"x || "profile.scottish-history-profile.file = " || args[8]
  data_config = .ragconfig; data_error = ""
  data_status = parseconfigtext(data_config_text, data_config, data_error); data_files = .ragprofilefilebinding[]
  if data_status = 0 then data_files = data_config.profile_files()
  errors = errors + check(data_status = 0 & data_files.0 = 1, "profile file config binding " || data_error)
  rejected_profile = profile_loader.load(args[9], "scottish-history-profile")
  errors = errors + check(rejected_profile.status() \= 0 & pos("does not match", rejected_profile.error()) > 0, "profile identity binding rejection")

  if errors > 0 then return 1
  say "CONFIG_CONTRACT_OK cell=" || cell || " formats=1,2,3 identities=split settings=typed-and-bounded providers=2 gemini=2 env_refs=2 literal_secrets=0 executable_modules=0 glossary=validated profile=validated provider_calls=0"
  return 0
