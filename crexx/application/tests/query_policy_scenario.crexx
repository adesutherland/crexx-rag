options levelg

import rxfnsb
import ragconfig
import provider_contract
import ragquerypolicy

check: procedure = .int
  arg condition = .int, label = .string
  if condition = 1 then return 0
  say "FAIL " || label
  return 1

main: procedure = .int
  arg args = .string[]
errors = 0; empty_secret = .ragsecretref()
local = .ragproviderconfig("local", "openai-compatible", "http://127.0.0.1:8080/v1", "local-model", "local", "restricted-ok", empty_secret, 30000, 2)
hosted = .ragproviderconfig("hosted", "gemini", "https://generativelanguage.googleapis.com/v1beta", "hosted-model", "hosted", "public-only", .ragsecretref("env", "GEMINI_API_KEY"), 30000, 2)
google = .ragproviderconfig("google", "gemini", "https://generativelanguage.googleapis.com/v1beta", "gemini-3.5-flash-lite", "hosted", "public-only", .ragsecretref("env", "GEMINI_API_KEY"), 30000, 1)
codex = .ragproviderconfig("codex", "codex", "stdio://codex-app-server", "gpt-5.6-luna", "hosted", "public-only", empty_secret, 30000, 2)
missing = .ragproviderconfig("", "", "", "", "", "", empty_secret, 0, 0)

errors = errors + check(queryrouteallowed(local, "local") = 1 & queryrouteallowed(local, "restricted") = 1 & queryrouteallowed(local, "public") = 1, "local route privacy")
errors = errors + check(queryrouteallowed(hosted, "public") = 1 & queryrouteallowed(hosted, "restricted") = 0 & queryrouteallowed(hosted, "local") = 0, "hosted route privacy")
errors = errors + check(queryrouteallowed(missing, "public") = 0, "missing provider denied")

error = ""; normal = .ragbudget(2, 2, 2, 300, 40, 100, 1, 10)
errors = errors + check(querypreflight(normal, local, 1, codex, 1, error) = 0, "combined local and Codex preflight " || error)
calls_low = .ragbudget(2, 2, 1, 300, 40, 100, 1, 10)
errors = errors + check(querypreflight(calls_low, local, 1, codex, 1, error) \= 0 & pos("per-command ceiling", error) > 0, "model-call ceiling")
turns_low = .ragbudget(2, 2, 2, 300, 40, 100, 0, 10)
errors = errors + check(querypreflight(turns_low, local, 1, codex, 1, error) \= 0 & pos("Codex turn ceiling", error) > 0, "Codex-turn ceiling")
money_low = .ragbudget(2, 2, 2, 300, 40, 0, 1, 10)
errors = errors + check(querypreflight(money_low, local, 0, hosted, 1, error) \= 0 & pos("monetary", error) > 0, "monetary ceiling")
errors = errors + check(querypreflight(money_low, local, 0, codex, 1, error) = 0, "subscription is not represented as zero monetary cost")
priced = .ragbudget(2, 2, 2, 300, 40, 1000000, 1, 10)
errors = errors + check(querypreflight(priced, missing, 0, google, 1, error) = 0, "known monetary worst-case admitted " || error)
priced_low = .ragbudget(2, 2, 2, 300, 40, 100, 1, 10)
errors = errors + check(querypreflight(priced_low, missing, 0, google, 1, error) \= 0 & pos("worst-case", error) > 0, "monetary worst-case ceiling")
errors = errors + check(querypreflight(priced, missing, 0, hosted, 1, error) \= 0 & pos("pricing is unavailable", error) > 0, "unknown monetary pricing denied")
aggregate = .ragbudget(100000, 7000, 7000, 31000000, 3600000, 18000000, 1, 2880)
errors = errors + check(querypreflight(aggregate, google, 1, google, 1, error) = 0 & queryansweroutputlimit(aggregate) = 1024, "aggregate batch budget yields bounded query calls " || error)
errors = errors + check(querypreflight(aggregate, missing, 0, google, 1, error, 4096) = 0, "separate narrative output ceiling is admitted " || error)
errors = errors + check(querypreflight(.ragbudget(2, 2, 2, 300, 2048, 1000000, 1, 10), missing, 0, google, 1, error, 4096) \= 0 & pos("output-token ceiling", error) > 0, "separate narrative output ceiling remains budget bounded")
invalid_retry = .ragproviderconfig("invalid-retry", "openai-compatible", "http://127.0.0.1:8080/v1", "local-model", "local", "restricted-ok", empty_secret, 0, 0)
errors = errors + check(querypreflight(normal, invalid_retry, 1, missing, 0, error) \= 0 & pos("timeout or retry", error) > 0, "timeout and retry policy")
input_low = .ragbudget(2, 2, 2, 0, 40, 100, 1, 10)
errors = errors + check(querypreflight(input_low, local, 1, missing, 0, error) \= 0 & pos("input-token", error) > 0, "input-token preflight")
output_low = .ragbudget(2, 2, 2, 300, 0, 100, 1, 10)
errors = errors + check(querypreflight(output_low, missing, 0, local, 1, error) \= 0 & pos("output-token", error) > 0, "output-token preflight")

embed_exact = .providerusage(100, 0, 1, 1, 1, 0)
answer_exact = .providerusage(200, 40, 1, 99, 1, 0)
errors = errors + check(queryusagewithin(normal, hosted, embed_exact, 1, hosted, answer_exact, 1) = 1, "aggregate usage exact ceilings")
errors = errors + check(queryusagewithin(normal, hosted, .providerusage(101, 0, 1, 1, 1, 0), 1, hosted, answer_exact, 1) = 0, "aggregate input-token overrun")
errors = errors + check(queryusagewithin(normal, hosted, embed_exact, 1, hosted, .providerusage(200, 41, 1, 99, 1, 0), 1) = 0, "aggregate output-token overrun")
errors = errors + check(queryusagewithin(normal, hosted, embed_exact, 1, hosted, .providerusage(200, 40, 1, 100, 1, 0), 1) = 0, "aggregate cost overrun")
errors = errors + check(queryusagewithin(normal, hosted, .providerusage(100, 0, 1, -1, 1, 0), 1, hosted, answer_exact, 1) = 0, "unknown monetary usage rejected")
errors = errors + check(queryusagewithin(normal, local, .providerusage(100, 0, 1, -1, 1, 0), 1, codex, .providerusage(200, 40, 1, -1, 1, 0), 1) = 1, "non-monetary usage is not recorded as zero cost")
errors = errors + check(queryusagewithin(normal, hosted, .providerusage(999, 999, 1, 999, 1, 0), 0, hosted, answer_exact, 1) = 1, "uncalled provider usage excluded")

if errors > 0 then return 1
say "QUERY_POLICY_OK privacy=local+hosted calls=bounded codex_turns=bounded input_tokens=bounded output_tokens=bounded cost=bounded aggregate=postchecked"
return 0
