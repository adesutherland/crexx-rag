options levelg

import rxfnsb
import rxfnsg
import rxhash
import rxvector
import rxjson
import rxsqlite
import rxfs
import ragfile
import ragstore
import ragbackup
import ragembedding
import ragretrieval
import ragcommand
import ragconfig
import ragprofile
import ragregistry
import ragreportservice
import generic_profile

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "ANN_METHODOLOGY_FAIL=" || label
  return 1

filecontract: procedure = .int
  arg path = .string
  sizes = .int[]; sizes[1]=0; sizes[2]=1; sizes[3]=65535; sizes[4]=65536; sizes[5]=65537; sizes[6]=131073
  errors=0; error=""; actual=.binary; expected=.binary; bytes=0
  do s=1 to sizes.0
    call binresize expected,sizes[s]
    do offset=0 to sizes[s]-1; <at..u8>(offset) expected=offset%256; end
    errors=errors+check(ragfile..writebinaryfile(path,expected,error)=0,"binary fixture write " || error)
    digest=""; hashed_bytes=0; ceiling=max(1,sizes[s])
    errors=errors+check(ragfile..readbinaryfilebounded(path,ceiling,actual,bytes,error)=0 & bytes=sizes[s] & actual=expected,"exact binary bytes across read boundaries size=" || sizes[s])
    errors=errors+check(ragfile..sha256filebounded(path,ceiling,digest,hashed_bytes,error)=0 & hashed_bytes=bytes & digest=rxhash..sha256hex(expected),"bounded file digest agrees size=" || sizes[s])
    if sizes[s]>1 then do
      errors=errors+check(ragfile..readbinaryfilebounded(path,sizes[s]-1,actual,bytes,error)\=0 & error\="","one byte below file size is rejected")
      errors=errors+check(ragfile..readbinaryfilebounded(path,ceiling,actual,bytes,error)=0 & actual=expected,"successful reread after ceiling failure")
    end
  end
  errors=errors+check(ragfile..readbinaryfilebounded(path,0,actual,bytes,error)\=0,"zero ceiling rejected")
  errors=errors+check(ragfile..readbinaryfilebounded(path || ".missing",1,actual,bytes,error)\=0 & bytes=0,"missing file rejected")
  proof=.ragvectorsidecar(); expected_hash=rxhash..sha256hex(expected)
  errors=errors+check(proof.load(path,expected_hash,131073,error)=0,"verified request payload")
  detached=proof.bytes(); call binresize detached,0
  errors=errors+check(rxfs..delete(path)=0,"remove file after verification")
  errors=errors+check(proof.load(path,expected_hash,131073,error)=0 & proof.bytes()=expected,"request owns independent verified bytes after file removal")
  errors=errors+check(proof.load(path,expected_hash,131072,error)\=0 & binlength(proof.bytes())=0,"smaller ceiling cannot reuse prior payload")
  errors=errors+check(ragfile..writebinaryfile(path,expected,error)=0 & proof.load(path,expected_hash,131073,error)=0,"restore verified fixture")
  errors=errors+check(proof.load(path,copies("0",64),131073,error)\=0 & binlength(proof.bytes())=0,"changed expected checksum invalidates payload")
  errors=errors+check(proof.load(path,expected_hash,131073,error)=0,"restore valid checksum")
  errors=errors+check(proof.load(path || ".missing",expected_hash,131073,error)\=0,"different store path cannot reuse payload")
  return errors

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

indexdirty: procedure = .string
  arg database = .binary, profile_id = .string
  return scalartext(database,"SELECT CAST(p.vector_revision<>v.input_revision AS TEXT) FROM vector_generations v JOIN embedding_profiles p USING(embedding_profile_id) WHERE v.state='published' AND p.embedding_profile_id='" || profile_id || "' AND " || compatiblevectorpredicate("(SELECT published_generation FROM library_meta WHERE singleton=1)","v.") || " ORDER BY v.semantic_generation DESC LIMIT 1")

reportfield: procedure = .string
  arg result=.ragcommandresult, kind=.string, name=.string
  records=result.records()
  do i=1 to records.0
    if records[i].kind()=kind then do
      fields=records[i].fields()
      do j=1 to fields.0
        if fields[j].name()=name then return fields[j].value()
      end
    end
  end
  return ""

checkreport: procedure = .int
  arg store=.ragstorehandle, state=.string, links=.int, rows=.int, coverage=.int, model=.string, dimensions=2, centroids=4, probes=1
  access=.string[];access[1]="read";report_options=.ragcommandoption[];positionals=.string[]
  request=.ragcommandrequest(store.path(),"ann-methodology","generic-profile","","json","off",access,"library","report","library.report",report_options,positionals)
  configs=.ragconfig[];profiles=.ragprofile[]
  result=libraryreport(request,.ragregistry(configs,profiles))
  errors=check(result.exit_code()=0,"report readable " || result.message())
  if errors>0 then return errors
  errors=errors+check(reportfield(result,"vector-stat","state")=state,"report state " || state || " actual=" || reportfield(result,"vector-stat","state"))
  errors=errors+check(reportfield(result,"vector-stat","active_embeddings")=links as .string,"report selected-profile link count")
  errors=errors+check(reportfield(result,"vector-stat","published_rows")=rows as .string,"report selected publication rows")
  errors=errors+check(reportfield(result,"vector-stat","coverage_millionths")=coverage as .string,"report distinct-parent coverage actual=" || reportfield(result,"vector-stat","coverage_millionths"))
  errors=errors+check(reportfield(result,"vector-stat","model")=model,"report selected publication model")
  errors=errors+check(reportfield(result,"vector-stat","dimension")=dimensions as .string & reportfield(result,"vector-stat","centroids")=centroids as .string & reportfield(result,"vector-stat","probes")=probes as .string,"report settings belong to the same publication")
  generation=reportfield(result,"report-snapshot","generation")
  storage=reportfield(result,"report-snapshot","storage_verification_issues")
  repository=reportfield(result,"report-snapshot","repository_verification_issues")
  digest=reportoperationaldigest(store.database(),generation as .int,storage as .int,repository as .int)
  errors=errors+check(digest=reportfield(result,"report-snapshot","operational_digest"),"report and narrative recheck use identical operational projection")
  errors=errors+check(scalartext(store.database(),"SELECT CAST(count(*) AS TEXT) FROM provider_runs")="0","report performs no inference")
  return errors

insertchunk: procedure = .int
  arg database = .binary, ordinal = .int, text = .string, x = .float, y = .float, expose error = .string
  suffix = right("0" || ordinal, 2); content_id = "content-" || suffix; chunk_id = "chunk-" || suffix
  content_digest = rxhash..sha256hex(text as .binary); input_fingerprint = rxhash..sha256hex(("ann-input" || "00"x || suffix) as .binary)
  prepared = .binary
  sql = "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES(?1,?2,?3,?4)"
  if sqliteprepare(database, sql, prepared) \= 0 then do; error = "prepare chunk content"; return -1; end
  binds = sqlitebindtext(prepared, 1, content_id) | sqlitebindtext(prepared, 2, content_digest) | sqlitebindtext(prepared, 3, text) | sqlitebindtext(prepared, 4, input_fingerprint)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert chunk content"; return -1; end
  start = (ordinal - 1) * 32; finish = start + binlength(text as .binary)
  prepared = .binary
  sql = "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES(?1,'revision-ann',?2,?3,?4,?5,?6,'ann-fixture-v1','direct',1)"
  if sqliteprepare(database, sql, prepared) \= 0 then do; error = "prepare revision chunk"; return -1; end
  binds = sqlitebindtext(prepared, 1, chunk_id) | sqlitebindint(prepared, 2, ordinal) | sqlitebindint(prepared, 3, start) | sqlitebindint(prepared, 4, finish) | sqlitebindtext(prepared, 5, content_id) | sqlitebindtext(prepared, 6, "continuity-" || suffix)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert revision chunk"; return -1; end
  prepared = .binary
  if sqliteprepare(database, "INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES(?1,?2,?3)", prepared) \= 0 then do; error = "prepare FTS row"; return -1; end
  binds = sqlitebindtext(prepared, 1, chunk_id) | sqlitebindtext(prepared, 2, content_id) | sqlitebindtext(prepared, 3, text)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert FTS row"; return -1; end
  vector = .packedfloat(2); call vector.set(0, x); call vector.set(1, y); wire = rxvector..encodef32le(vector)
  input_digest = rxhash..sha256hex((content_digest || "00"x || "ann-envelope") as .binary); embedding_id = "embedding-" || suffix
  prepared = .binary
  sql = "INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,provider_run_id,created_at) VALUES(?1,?2,'ann-profile',?3,2,NULL,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then do; error = "prepare embedding"; return -1; end
  binds = sqlitebindtext(prepared, 1, embedding_id) | sqlitebindtext(prepared, 2, input_digest) | sqlitebindblob(prepared, 3, wire)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert embedding"; return -1; end
  prepared = .binary
  if sqliteprepare(database, "INSERT INTO revision_chunk_embeddings(revision_chunk_id,embedding_id,visible_from_generation) VALUES(?1,?2,1)", prepared) \= 0 then do; error = "prepare embedding attachment"; return -1; end
  binds = sqlitebindtext(prepared, 1, chunk_id) | sqlitebindtext(prepared, 2, embedding_id)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then do; error = "insert embedding attachment"; return -1; end
  return 0

main: procedure = .int
  arg args = .string[]
  if args.0 \= 1 then return 2
  path = args[1]; errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(path, "library-ann-methodology", "snapshot-ann", "ann-methodology", "1", "generic-profile", "profile-hash", "config-hash", '{}', store, error) = 0, "initialize " || error)
  if errors > 0 then return 1
  database = store.database()
  errors=errors+filecontract(path || "/reader-fixture.bin")
  errors=errors+checkreport(store,"empty",0,0,0,"",0,0,0)
  errors = errors + check(sqliteexec(database, "INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-ann','raw-ann','text/plain','utf-8',NULL,'fixture://ann',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "artifact")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-ann','text-digest-ann','ANN corpus','fixture-v1','utf8-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'))") = 0, "revision text")
  errors = errors + check(sqliteexec(database, "INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-ann','fixture','ann','revision-ann','active','fixture://ann','ANN corpus',1)") = 0, "source")
  errors = errors + check(sqliteexec(database, "INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-ann','source-ann','revision-envelope-ann','artifact-ann','text-ann','metadata-ann','fixture-time',1)") = 0, "revision")
  errors = errors + check(registerembeddingprofile(store, "ann-profile", "fixture-provider", "fixture-model", 2, copies("a", 64), error) = 0, "profile " || error)
  errors = errors + check(insertchunk(database, 1, "ann-row-01", 1.0, 0.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 2, "ann-row-02", 1.0, 0.1, error) = 0, error)
  errors = errors + check(insertchunk(database, 3, "ann-row-03", 1.0, -0.1, error) = 0, error)
  errors = errors + check(insertchunk(database, 4, "ann-row-04", 0.1, 1.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 5, "ann-row-05", 0.0, 1.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 6, "ann-row-06", -0.1, 1.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 7, "ann-row-07", -1.0, 0.1, error) = 0, error)
  errors = errors + check(insertchunk(database, 8, "ann-row-08", -1.0, 0.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 9, "ann-row-09", -1.0, -0.1, error) = 0, error)
  errors = errors + check(insertchunk(database, 10, "ann-row-10", 0.1, -1.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 11, "ann-row-11", 0.0, -1.0, error) = 0, error)
  errors = errors + check(insertchunk(database, 12, "ann-row-12", -0.1, -1.0, error) = 0, error)
  errors = errors + check(sqliteexec(database, "INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-13','digest-13','ann-missing-13','fingerprint-13');INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-13','revision-ann',13,384,398,'content-13','continuity-13','ann-fixture-v1','direct',1);INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-13','content-13','ann-missing-13')") = 0, "partial coverage chunk")
  errors = errors + check(publishmanifest(store, error) = 0, "pre-ANN manifest " || error)
  if errors > 0 then return 1

  errors=errors+checkreport(store,"missing",12,0,0,"",0,0,0)
  generation = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store, "ann-profile", 12, 4, 1, 3, 1048576, generation, error) = 0 & generation.state() = "published" & generation.rows() = 12, "partial-coverage IVF-flat publication " || error)
  replay = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store, "ann-profile", 12, 4, 1, 3, 1048576, replay, error) = 0 & replay.state() = "identical-no-op" & replay.checksum() = generation.checksum(), "deterministic ANN replay " || error)
  errors = errors + check(indexdirty(database,"ann-profile") = "0","successful index is clean")
  errors=errors+checkreport(store,"partial",12,12,923076,"fixture-model")

  matrix = .packedfloat(24)
  call matrix.set(0,1.0); call matrix.set(1,0.0); call matrix.set(2,1.0); call matrix.set(3,0.1); call matrix.set(4,1.0); call matrix.set(5,-0.1)
  call matrix.set(6,0.1); call matrix.set(7,1.0); call matrix.set(8,0.0); call matrix.set(9,1.0); call matrix.set(10,-0.1); call matrix.set(11,1.0)
  call matrix.set(12,-1.0); call matrix.set(13,0.1); call matrix.set(14,-1.0); call matrix.set(15,0.0); call matrix.set(16,-1.0); call matrix.set(17,-0.1)
  call matrix.set(18,0.1); call matrix.set(19,-1.0); call matrix.set(20,0.0); call matrix.set(21,-1.0); call matrix.set(22,-0.1); call matrix.set(23,-1.0)
  query_vector = .packedfloat(2); call query_vector.set(0, 1.0); call query_vector.set(1, 0.0); query_wire = rxvector..encodef32le(query_vector)
  owners = .packedint(12); do i = 0 to 11; call owners.set(i, i + 1); end
  exact_ids = .packedint(0); exact_scores = .packedfloat(0); call rxvector..topkcosine(matrix, owners, 2, query_vector, 1, exact_ids, exact_scores)
  expected = "ann-row-" || right("0" || exact_ids.get(0), 2)
  retrieval_policy = .ragretrievaloptions("ann-methodology-v1", "ann-profile", query_wire, 1, 1, 4, 0, 1, 1, 1, 60, "both")
  result = .ragretrievalresult
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, result, error) = 0, "ANN retrieval " || error)
  passages = result.evidence().passages(); recall = 0
  if passages.0 = 1 & passages[1].text() = expected then recall = 1000000
  trace_found = 0; notes = .string[]; notes = result.evidence().trace().notes()
  do i = 1 to notes.0
    if pos("vector-candidates=3;total-rows=12;centroids=4;probes=1", notes[i]) > 0 then trace_found = 1
  end
  errors = errors + check(result.vector_state() = "active-ann-ivf-rxvector" & trace_found = 1, "production path must probe bounded IVF clusters")
  errors = errors + check(recall >= 900000, "ANN recall threshold against exact QA oracle")

  errors=errors+check(sqliteexec(database,"UPDATE embeddings SET vector=x'0000000000000000' WHERE embedding_id='embedding-01'")=0,"zero-norm page fixture")
  invalid_page=.ragretrievalresult
  errors=errors+check(retrieveevidence(store,genericprofile(),"zzzznotlexical",retrieval_policy,invalid_page,error)\=0 & pos("zero-norm",error)>0,"zero-norm IVF page rejects through the normal error path")
  errors=errors+check(sqliteexec(database,"UPDATE embeddings SET vector=x'0000803f00000000' WHERE embedding_id='embedding-01'")=0,"restore valid page vector")
  errors=errors+check(retrieveevidence(store,genericprofile(),"zzzznotlexical",retrieval_policy,invalid_page,error)=0 & invalid_page.vector_state()="active-ann-ivf-rxvector","positive page control after rejected vector")

  single_source_policy = .ragretrievaloptions("ann-methodology-v1", "ann-profile", query_wire, 8, 4, 12, 0, 4, 0, 0, 60, "both")
  single_source_result = .ragretrievalresult
  errors = errors + check(retrieveevidence(store, genericprofile(), "ann", single_source_policy, single_source_result, error) = 0, "single-source retrieval " || error)
  single_source_passages = .ragpassage[]; single_source_passages = single_source_result.evidence().passages()
  source_cap_found = 0; single_source_notes = .string[]; single_source_notes = single_source_result.evidence().trace().notes()
  do i = 1 to single_source_notes.0
    if pos("diversity-source-count=1;per-source-cap=4", single_source_notes[i]) > 0 then source_cap_found = 1
  end
  errors = errors + check(single_source_passages.0 = 4, "one source passage count=" || single_source_passages.0)
  errors = errors + check(source_cap_found = 1, "one source dynamic cap trace")

  raw = .binary; byte_count = 0
  errors = errors + check(ragfile..readbinaryfilebounded(path || "/" || generation.sidecar_name(), 67108864, raw, byte_count, error) = 0, "read ANN sidecar " || error)
  prepared_sidecar=.ragvectorsidecar()
  errors=errors+check(preparevectorsidecar(store,"ann-profile",67108864,prepared_sidecar,error)=0,"prefetch verified IVF file")
  errors = errors + check(ragfile..writebinaryfile(path || "/" || generation.sidecar_name(), "tampered" as .binary, error) = 0, "tamper ANN sidecar " || error)
  fallback = .ragretrievalresult
  errors=errors+check(retrieveevidencewithsidecar(store,genericprofile(),"zzzznotlexical",retrieval_policy,fallback,error,prepared_sidecar)=0 & fallback.vector_state()="active-ann-ivf-rxvector","in-flight IVF query uses verified bytes")
  in_flight=fallback.evidence().passages()
  errors=errors+check(in_flight.0=1 & in_flight[1].text()=expected,"verified IVF query preserves evidence")
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "fallback-invalid-ann-sidecar", "tampered ANN fail-safe fallback " || error)
  errors = errors + check(buildannvectorgeneration(store, "ann-profile", 12, 4, 1, 3, 1048576, replay, error) = 0 & replay.state() = "rebuilt-from-sqlite" & replay.checksum() = generation.checksum(), "recover corrupt sidecar from SQLite " || error)
  errors = errors + check(rxfs..delete(path || "/" || generation.sidecar_name()) = 0, "remove derived sidecar")
  errors = errors + check(ragfile..writebinaryfile(path || "/." || generation.sidecar_name() || ".recovery", "interrupted" as .binary, error) = 0, "interrupted rebuild temporary")
  errors = errors + check(buildannvectorgeneration(store, "ann-profile", 12, 4, 1, 3, 1048576, replay, error) = 0 & replay.state() = "rebuilt-from-sqlite" & replay.checksum() = generation.checksum(), "recover missing sidecar from SQLite " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "recovered ANN retrieval " || error)
  errors = errors + check(scalartext(database, "SELECT CAST(count(*) AS TEXT) FROM provider_runs") = "0", "sidecar recovery must make no provider calls")
  graph_generation = 0
  errors = errors + check(begingeneration(store, generation.semantic_generation(), "snapshot-ann", "graph-only maintenance publication", graph_generation, error) = 0, "begin graph-only generation " || error)
  errors = errors + check(commitgeneration(store, graph_generation, error) = 0 & publishmanifest(store, error) = 0, "publish graph-only generation " || error)
  errors = errors + check(indexdirty(database,"ann-profile") = "0","graph-only transaction leaves vector index clean")
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",12,4,1,3,1048576,replay,error) = 0 & replay.state() = "identical-no-op" & replay.checksum() = generation.checksum() & replay.semantic_generation() = generation.semantic_generation(),"graph-only retry reuses the original build " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "graph-only maintenance retains ANN availability " || error)
  errors = errors + check(scalartext(database, "SELECT CAST(count(*) AS TEXT) FROM vector_generations") = "1", "graph publication reuses the immutable index")
  backup_report = .ragbackupreport
  errors = errors + check(backupragstore(path, path || "-graph-backup", backup_report, error) = 0, "backup carries compatible ancestral index " || error)
  errors = errors + check(rxfs..isfile(path || "-graph-backup/" || generation.sidecar_name()) = 1, "backup retains original index filename")
  changed_generation = 0
  errors = errors + check(begingeneration(store, graph_generation, "snapshot-ann", "embedding membership change", changed_generation, error) = 0, "begin changed vector generation " || error)
  errors = errors + check(sqliteexec(database, "UPDATE revision_chunk_embeddings SET visible_to_generation=" || changed_generation || " WHERE revision_chunk_id='chunk-01' AND visible_to_generation IS NULL") = 0, "remove one vector membership")
  errors = errors + check(commitgeneration(store, changed_generation, error) = 0 & publishmanifest(store, error) = 0, "publish changed membership " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "remaining indexed members stay searchable after one removal " || error)
  retained_passages = fallback.evidence().passages()
  errors = errors + check(retained_passages.0 = 1, "remaining vector yields evidence after removal")
  do i = 1 to retained_passages.0
    errors = errors + check(retained_passages[i].text() \= "ann-row-01", "removed vector never supplies evidence")
  end
  changed_index = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store, "ann-profile", 12, 4, 1, 3, 1048576, changed_index, error) = 0 & changed_index.rows() = 11, "publish index for changed branch " || error)
  errors = errors + check(rollbackgeneration(store, changed_generation, graph_generation, "restore graph-only snapshot", error) = 0, "rollback membership change " || error)
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",12,4,1,3,1048576,replay,error) = 0 & indexdirty(database,"ann-profile") = "0","rebuild after rollback clears marker " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "rollback restores eligible ancestral index " || error)
  source_generation = 0
  errors = errors + check(begingeneration(store, graph_generation, "snapshot-ann", "source membership change", source_generation, error) = 0, "begin changed source generation " || error)
  errors = errors + check(sqliteexec(database, "UPDATE revision_chunks SET visible_to_generation=" || source_generation || " WHERE revision_chunk_id='chunk-13'") = 0, "retire unembedded source chunk")
  errors = errors + check(commitgeneration(store, source_generation, error) = 0 & publishmanifest(store, error) = 0, "publish changed source membership " || error)
  errors = errors + check(indexdirty(database,"ann-profile") = "1","publication past a rolled-back generation invalidates retained intervals")
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",12,4,1,3,1048576,replay,error) = 0 & replay.rows() = 11 & indexdirty(database,"ann-profile") = "0","post-rollback publication rebuilds the newly visible membership " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "unembedded source change retains ancestral indexed coverage " || error)
  errors = errors + check(rollbackgeneration(store,source_generation,graph_generation,"replacement fixture restores original source scope",error) = 0,"restore source scope for replacement " || error)
  addition_generation = 0
  errors = errors + check(begingeneration(store, graph_generation, "snapshot-ann", "pending document in another job", addition_generation, error) = 0, "begin pending addition " || error)
  errors = errors + check(sqliteexec(database, "INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) SELECT 'chunk-pending',revision_id,14,400,414,content_id,'pending','fixture','direct'," || addition_generation || " FROM revision_chunks WHERE revision_chunk_id='chunk-13'") = 0, "add pending chunk without an embedding")
  errors = errors + check(commitgeneration(store, addition_generation, error) = 0 & publishmanifest(store, error) = 0, "publish pending source " || error)
  errors = errors + check(retrieveevidence(store, genericprofile(), "zzzznotlexical", retrieval_policy, fallback, error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector", "unrelated pending work preserves vector search " || error)
  retained_passages = fallback.evidence().passages()
  errors = errors + check(retained_passages.0 = 1, "previously indexed evidence remains available")
  errors = errors + check(rollbackgeneration(store,addition_generation,graph_generation,"remove pending addition fixture",error) = 0,"restore source scope " || error)
  errors = errors + check(sqliteexec(database,"DELETE FROM revision_chunks WHERE revision_chunk_id='chunk-pending'") = 0,"remove rolled-back fixture row")
  errors = errors + check(registerembeddingprofile(store,"replacement-profile","fixture-provider","replacement-model",2,copies("b",64),error) = 0,"replacement profile " || error)
  errors = errors + check(sqliteexec(database,"INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,created_at) SELECT 'replacement-one','replacement-one','replacement-profile',vector,dimension,'fixture' FROM embeddings WHERE embedding_profile_id='ann-profile' LIMIT 1; INSERT INTO revision_chunk_embeddings(revision_chunk_id,embedding_id,visible_from_generation) VALUES('chunk-01','replacement-one'," || graph_generation || ")") = 0,"start incomplete replacement without removing original BLOBs")
  replacement = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,3,1048576,replacement,error) \= 0 & pos("replacement",error)>0,"incomplete replacement cannot be published " || error)
  errors = errors + check(retrieveevidence(store,genericprofile(),"zzzznotlexical",retrieval_policy,fallback,error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector","original index remains usable during incomplete replacement " || error)
  errors = errors + check(sqliteexec(database,"INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,created_at) SELECT 'replacement-'||revision_chunk_id,'replacement-'||revision_chunk_id,'replacement-profile',(SELECT vector FROM embeddings WHERE embedding_id='replacement-one'),2,'fixture' FROM revision_chunks WHERE revision_chunk_id<>'chunk-01'; INSERT INTO revision_chunk_embeddings(revision_chunk_id,embedding_id,visible_from_generation) SELECT revision_chunk_id,'replacement-'||revision_chunk_id," || graph_generation || " FROM revision_chunks WHERE revision_chunk_id<>'chunk-01'") = 0,"finish replacement vectors alongside original data")
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,3,1048576,replacement,error) = 0 & replacement.rows() = 13,"complete replacement is publishable " || error)
  errors=errors+checkreport(store,"ready",13,13,1000000,"replacement-model")
  errors = errors + check(retrieveevidence(store,genericprofile(),"zzzznotlexical",retrieval_policy,fallback,error) = 0 & fallback.vector_state() = "active-ann-ivf-rxvector","complete replacement preserves original query representation " || error)
  errors = errors + check(scalartext(database,"SELECT CAST(count(*) AS TEXT) FROM embeddings WHERE embedding_profile_id='ann-profile'") = "12" & scalartext(database,"SELECT CAST(count(*) AS TEXT) FROM provider_runs") = "0","representation replacement preserves original BLOBs without provider calls")
  /* A converged index can have identical centroids after different iteration
   * counts. Record the settings even when its derived bytes are unchanged. */
  tuned = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,tuned,error) = 0 & scalartext(database,"SELECT CAST(build_iterations AS TEXT) FROM vector_generations WHERE state='published' AND embedding_profile_id='replacement-profile' AND input_revision=(SELECT vector_revision FROM embedding_profiles WHERE embedding_profile_id='replacement-profile')") = "4","changed training iterations require a new build " || error)
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) = 0 & replay.state() = "identical-no-op" & replay.checksum() = tuned.checksum(),"unchanged tuned build is reused " || error)
  errors = errors + check(sqliteexec(database,"UPDATE embeddings SET vector=(SELECT vector FROM embeddings WHERE embedding_id='embedding-08') WHERE embedding_id='replacement-one'") = 0,"change stored vector without changing its identity or row count")
  errors = errors + check(indexdirty(database,"replacement-profile") = "1","embedding transaction marks index dirty")
  errors=errors+checkreport(store,"partial",13,13,1000000,"replacement-model")
  changed_input = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,changed_input,error) = 0 & changed_input.state() = "published" & changed_input.checksum() \= tuned.checksum(),"same-count changed vector cannot reuse an old build " || error)
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) = 0 & replay.state() = "identical-no-op" & replay.checksum() = changed_input.checksum(),"changed vector build subsequently reuses index " || error)
  errors = errors + check(sqliteexec(database,"BEGIN; UPDATE embeddings SET vector=zeroblob(8) WHERE embedding_id='replacement-one'; ROLLBACK") = 0 & indexdirty(database,"replacement-profile") = "0","rolled-back data change also rolls back invalidation")
  errors = errors + check(invalidateannindex(store,"replacement-profile",error) = 0 & indexdirty(database,"replacement-profile") = "1","explicit rebuild invalidates index " || error)
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) = 0 & indexdirty(database,"replacement-profile") = "0" & replay.checksum() = changed_input.checksum(),"forced rebuild clears dirty marker without changing content " || error)
  errors = errors + check(sqliteexec(database,"UPDATE embeddings SET vector=zeroblob(8) WHERE embedding_id='replacement-one'") = 0,"inject invalid training data")
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) \= 0 & indexdirty(database,"replacement-profile") = "1","failed rebuild leaves dirty marker set")
  errors = errors + check(sqliteexec(database,"UPDATE embeddings SET vector=(SELECT vector FROM embeddings WHERE embedding_id='embedding-08') WHERE embedding_id='replacement-one'") = 0,"restore valid training data")
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) = 0 & indexdirty(database,"replacement-profile") = "0","retry after failed rebuild clears marker " || error)
  errors = errors + check(sqliteexec(database,"UPDATE revision_chunk_embeddings SET embedding_id='replacement-chunk-12' WHERE revision_chunk_id='chunk-13' AND embedding_id='replacement-chunk-13'") = 0 & indexdirty(database,"replacement-profile") = "1","reusing an existing embedding marks dirty without a new timestamp")
  errors = errors + check(buildannvectorgeneration(store,"replacement-profile",13,4,1,4,1048576,replay,error) = 0 & replay.rows() = 13 & replay.checksum() \= changed_input.checksum() & indexdirty(database,"replacement-profile") = "0","same-count membership change rebuilds then clears marker " || error)
  verified = .ragverifyresult
  errors = errors + check(verifyragstore(store,0,verified,error) = 0 & pos("embedding-membership-duplicates",verified.summary()) = 0,"single-window memberships verify")
  /* One parent has four distinct windows. The first is a poor match; the
   * strongest two must not consume both places in a two-parent result. */
  do window = 1 to 4
    window_vector = .packedfloat(2)
    wx = 1.0; wy = 1.0
    if window = 1 then do; wx = -1.0; wy = -1.0; end
    if window = 3 then wy = 1.01
    if window = 4 then wy = 2.0
    call window_vector.set(0,wx); call window_vector.set(1,wy)
    window_wire = rxvector..encodef32le(window_vector)
    window_id = "window-" || window
    window_digest = rxhash..sha256hex(window_id as .binary)
    errors = errors + check(sqliteexec(database,"INSERT INTO embeddings(embedding_id,input_digest,embedding_profile_id,vector,dimension,created_at) VALUES('" || window_id || "','" || window_digest || "','ann-profile',X'" || bin2x(window_wire) || "',2,'fixture'); INSERT INTO revision_chunk_embeddings(revision_chunk_id,embedding_id,visible_from_generation) VALUES('chunk-13','" || window_id || "',1)") = 0,"add window " || window)
  end
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",32,1,1,3,1048576,replay,error) = 0 & replay.rows() = 16,"windowed index rows " || error)
  errors=errors+checkreport(store,"ready",16,16,1000000,"fixture-model",2,1,1)
  call query_vector.set(0,1.0); call query_vector.set(1,1.0)
  window_policy = .ragretrievaloptions("ann-methodology-v1","ann-profile",rxvector..encodef32le(query_vector),1,2,32,0,2,0,0,60,"both")
  errors = errors + check(retrieveevidence(store,genericprofile(),"zzzznotlexical",window_policy,fallback,error) = 0,"windowed retrieval " || error)
  window_passages = fallback.evidence().passages()
  errors = errors + check(window_passages.0 = 2,"window candidates yield two distinct parents")
  errors = errors + check(fallback.candidate_count() = 2,"window page retains only the best distinct parent candidates")
  if window_passages.0 > 0 then errors = errors + check(window_passages[1].text() = "ann-missing-13","later window supplies the best parent score")
  if window_passages.0 = 2 then errors = errors + check(window_passages[2].text() \= "ann-missing-13","parent appears only once")
  /* A repeated identical parent/window membership must be ignored before the
   * scan ceiling, while distinct windows remain eligible. Keep full ordering
   * and every score identical to the unmodified index. */
  original_window_sidecar = .binary; window_sidecar_bytes = 0
  errors = errors + check(ragfile..readbinaryfilebounded(path || "/" || replay.sidecar_name(),1048576,original_window_sidecar,window_sidecar_bytes,error) = 0,"read window index for duplicate control " || error)
  window_document = .jsondocument(original_window_sidecar as .string)
  window_clusters = window_document.member(window_document.root(),"clusters")
  window_cluster = window_document.element(window_clusters,1)
  window_members = window_document.member(window_cluster,"members")
  repeated_member = window_document.node_get(window_document.element(window_members,1))
  duplicated_sidecar = changestr(repeated_member,original_window_sidecar as .string,repeated_member || "," || repeated_member) as .binary
  duplicate_checksum = rxhash..sha256hex(duplicated_sidecar)
  errors = errors + check(ragfile..writebinaryfile(path || "/" || replay.sidecar_name(),duplicated_sidecar,error) = 0,"write duplicate membership control " || error)
  errors = errors + check(sqliteexec(database,"UPDATE vector_generations SET sidecar_checksum='" || duplicate_checksum || "' WHERE vector_generation_id='" || replay.vector_generation_id() || "'") = 0 & publishmanifest(store,error) = 0,"publish duplicate control checksum " || error)
  duplicate_policy = .ragretrievaloptions("ann-methodology-v1","ann-profile",rxvector..encodef32le(query_vector),1,2,16,0,2,0,0,60,"both")
  duplicate_result = .ragretrievalresult
  errors = errors + check(retrieveevidence(store,genericprofile(),"zzzznotlexical",duplicate_policy,duplicate_result,error) = 0 & duplicate_result.vector_state() = "active-ann-ivf-rxvector","duplicate does not consume scan allowance " || error)
  duplicate_passages = duplicate_result.evidence().passages()
  errors = errors + check(duplicate_passages.0 = window_passages.0 & duplicate_result.candidate_count() = fallback.candidate_count(),"duplicate membership preserves candidate and passage counts")
  if duplicate_passages.0 = window_passages.0 then do
    do comparison = 1 to window_passages.0
      errors = errors + check(duplicate_passages[comparison].citation().citation() = window_passages[comparison].citation().citation(),"duplicate membership preserves citation order")
      before_scores = window_passages[comparison].scores(); after_scores = duplicate_passages[comparison].scores()
      errors = errors + check(before_scores.0 = after_scores.0,"duplicate membership preserves score count")
      if before_scores.0 = after_scores.0 then do
        do score_index = 1 to before_scores.0
          errors = errors + check(before_scores[score_index].name() = after_scores[score_index].name() & before_scores[score_index].value() = after_scores[score_index].value(),"duplicate membership preserves scores")
        end
      end
    end
  end
  errors = errors + check(ragfile..writebinaryfile(path || "/" || replay.sidecar_name(),original_window_sidecar,error) = 0,"restore window index " || error)
  errors = errors + check(sqliteexec(database,"UPDATE vector_generations SET sidecar_checksum='" || replay.checksum() || "' WHERE vector_generation_id='" || replay.vector_generation_id() || "'") = 0 & publishmanifest(store,error) = 0,"restore window index checksum " || error)
  errors = errors + check(scalartext(database,"SELECT text FROM chunk_contents WHERE content_id='content-13'") = "ann-missing-13" & scalartext(database,"SELECT CAST(count(*) AS TEXT) FROM provider_runs") = "0","window search preserves original source and provider history")
  errors = errors + check(verifyragstore(store,0,verified,error) = 0 & pos("embedding-membership-duplicates",verified.summary()) = 0,"distinct windows are valid memberships")
  errors = errors + check(sqliteexec(database,"BEGIN; INSERT INTO revision_chunk_embeddings(revision_chunk_id,embedding_id,visible_from_generation) VALUES('chunk-13','window-1'," || graph_generation || ")") = 0,"inject duplicate window membership")
  errors = errors + check(verifyragstore(store,0,verified,error) = 0 & pos("embedding-membership-duplicates",verified.summary()) > 0,"duplicate identical window membership is rejected")
  errors = errors + check(sqliteexec(database,"ROLLBACK") = 0,"restore valid memberships")
  /* RAG-VEC-02: revisiting an immutable index is a supported operation. */
  first = .ragvectorgenerationresult; second = .ragvectorgenerationresult; again = .ragvectorgenerationresult
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",100,4,1,3,1048576,first,error) = 0,"switch positive control A " || error)
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",100,8,2,3,1048576,second,error) = 0 & second.checksum() \= first.checksum(),"switch positive control B " || error)
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",100,4,1,3,1048576,again,error) = 0 & again.checksum() = first.checksum(),"reactivate A after B " || error)
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",100,8,2,3,1048576,second,error) = 0,"reactivate B again " || error)
  errors = errors + check(rxfs..delete(path || "/" || first.sidecar_name()) = 0,"remove superseded A file")
  errors = errors + check(buildannvectorgeneration(store,"ann-profile",100,4,1,3,1048576,again,error) = 0 & again.state() = "rebuilt-from-sqlite" & again.checksum() = first.checksum(),"rebuild and reactivate missing A " || error)
  errors = errors + check(scalartext(database,"SELECT CAST(count(*) AS TEXT) FROM vector_generations WHERE state='published' AND embedding_profile_id='ann-profile' AND semantic_generation=" || again.semantic_generation()) = "1","reactivation leaves one published selection")
  revision = scalartext(database,"SELECT CAST(vector_revision AS TEXT) FROM embedding_profiles WHERE embedding_profile_id='ann-profile'") as .int
  errors = errors + check(reactivatesidecar(store,second.vector_generation_id(),again.semantic_generation()+1,"ann-profile",revision,error) \= 0,"reactivation rejects a changed semantic generation")
  errors = errors + check(reactivatesidecar(store,second.vector_generation_id(),again.semantic_generation(),"ann-profile",revision+1,error) \= 0,"reactivation rejects changed vector inputs")
  errors = errors + check(reactivatesidecar(store,"missing-index",again.semantic_generation(),"ann-profile",revision,error) \= 0,"reactivation rejects an unknown immutable identity")
  errors = errors + check(scalartext(database,"SELECT vector_generation_id FROM vector_generations WHERE state='published' AND embedding_profile_id='ann-profile' AND semantic_generation=" || again.semantic_generation()) = again.vector_generation_id(),"failed reactivation leaves the prior publication intact")
  errors = errors + check(closeragstore(store, error) = 0, "close " || error)
  if errors > 0 then return 1
  say "ANN_METHODOLOGY_OK algorithm=ivf-flat-v1 rows=12 centroids=4 probes=1 candidates=3 exact_oracle=qa-only recall_millionths=" || recall || " tamper=fallback"
  return 0
