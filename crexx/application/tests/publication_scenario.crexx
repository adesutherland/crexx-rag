options levelg

import rxfnsb
import rxhash
import rxsqlite
import ragstore
import ragwork
import ragworktypes
import ragclaims
import ragbackup
import rxfs
import generic_profile
import ragingest
import ragprocess

heartbeatcase: procedure = .int
  arg store = .ragstorehandle, other = .ragstorehandle
  errors = 0; error = ""; db = store.database()
  errors = errors + check(activateprocess(store,"worker-heartbeat-qa","worker","","fixture-host",1,"fixture-start","fixture-executable","follow","",error) = 0,"heartbeat fixture registration " || error)
  errors = errors + check(sqlitebusytimeout(db,0) = 0 & sqliteexec(other.database(),"BEGIN IMMEDIATE") = 0,"hold heartbeat writer lock")
  status = heartbeatprocess(store,"worker-heartbeat-qa","idle","","fixture heartbeat",error)
  say "HEARTBEAT_CONTENTION=" || error
  errors = errors + check(status < 0 & pos("sqlite=5,extended=5,operation=step",error)>0 & pos("heartbeat_attempts=3",error)>0,"bounded heartbeat contention retains SQLite diagnostic " || error)
  errors = errors + check(sqliteexec(other.database(),"ROLLBACK") = 0 & sqlitebusytimeout(db,5000) = 0,"release heartbeat writer lock")
  errors = errors + check(heartbeatprocess(store,"worker-heartbeat-qa","running","","recovered heartbeat",error) = 0 & error = "","heartbeat succeeds after writer releases")
  errors = errors + check(sqliteexec(db,"CREATE TRIGGER fail_heartbeat BEFORE UPDATE ON runtime_instances BEGIN SELECT RAISE(ABORT,'injected heartbeat constraint'); END") = 0,"install heartbeat fault")
  status = heartbeatprocess(store,"worker-heartbeat-qa","idle","","rejected heartbeat",error)
  errors = errors + check(status < 0 & pos("sqlite=19,extended=1811,operation=step",error)>0 & pos("injected heartbeat constraint",error)>0 & pos("heartbeat_attempts",error)=0,"heartbeat constraint diagnostic survives cleanup without retry " || error)
  errors = errors + check(sqliteexec(db,"DROP TRIGGER fail_heartbeat") = 0,"remove heartbeat fault")
  errors = errors + check(heartbeatprocess(store,"missing-heartbeat-worker","idle","","missing",error) < 0 & error = "process heartbeat lost its active row","missing heartbeat row stays an error")
  errors = errors + check(sqliteexec(db,"BEGIN") = 0 & scalar(db,"SELECT count(*) FROM runtime_instances") = 1,"pin heartbeat read snapshot")
  errors = errors + check(sqliteexec(other.database(),"UPDATE runtime_instances SET detail='newer committed heartbeat' WHERE instance_id='worker-heartbeat-qa'") = 0,"advance heartbeat snapshot")
  status = heartbeatprocess(store,"worker-heartbeat-qa","idle","","stale snapshot",error)
  errors = errors + check(status < 0 & pos("sqlite=5,extended=517,operation=step",error)>0 & pos("heartbeat_attempts",error)=0,"stale snapshot requires transaction recovery, not retry " || error)
  errors = errors + check(sqliteexec(db,"ROLLBACK") = 0,"caller retains heartbeat transaction ownership")
  return errors

/* Used by the process fixture while a separate SQLite writer owns the lock.
 * Open directly so migration admission cannot wait before the heartbeat. */
heartbeatprobe: procedure = .int
  arg path = .string
  db = .binary; error = ""
  if sqliteopenmode(path || "/library.sqlite","readwrite",db) \= 0 then return 1
  if sqlitebusytimeout(db,5000) \= 0 then return 1
  store = .ragstorehandle(db,path,"readwrite")
  status = heartbeatprocess(store,"worker-heartbeat-qa","idle","","heartbeat resumed",error)
  call sqliteclose db
  if status \= 0 | error \= "" then do; say "HEARTBEAT_FAIL=" || error; return 1; end
  say "HEARTBEAT_RESUMED"
  return 0

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "PUBLICATION_FAIL=" || label
  return 1

scalar: procedure = .int
  arg database = .binary, sql = .string
  statement = .binary; value = -1
  if sqliteprepare(database,sql,statement) \= 0 | sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -1; end
  status = sqlitecolumnint(statement,0,value); call sqlitefinalize statement
  if status \= 0 then return -1
  return value

/* A producer can pass transport/shape validation and still lose a semantic
 * precondition before publication. Its batch must never publish a prefix. */
batchprovider: class implements .ragworkprovider
  _identity = .string
  *: factory
    arg identity = .string
    _identity = identity
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    aliases = .string[]; aliases[1] = "Alpha"
    mentions = .ragworkmention[]
    mentions[1] = .ragworkmention("candidate-alpha","Alpha","concept",0,5,aliases)
    aliases = .string[]; aliases[1] = "Beta"
    mentions[2] = .ragworkmention("candidate-beta","Beta","concept",6,10,aliases)
    proposals = .ragworkproposal[]; notes = .ragworknote[]
    invalid = .ragextractionproposal("crexx-rag.extraction-proposal/1","invalid-late-proposal","claim",mentions[1].concept_id(),"Alpha","concept","related-to",mentions[2].concept_id(),"Beta","concept","invalid-direction","{}","","","chunk-publication",0,10,"support","assertion","direct","","fixture-lineage",1000000,"fixture","fixture","request","fixture","fixture","public","generic-profile",0)
    proposals[1] = .ragworkproposal(invalid,"candidate-alpha","candidate-beta")
    empty = .ragextractionproposal
    return .ragworkproviderresult(0,"fixture","fixture","request-" || claim.attempt_id(),10,10,0,1,0,empty,"",1,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

/* Deterministically place an operator cancellation between provider admission
 * and receipt. The response/usage arrives after the cancellation request. */
cancellingprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  *: factory
    arg store = .ragstorehandle
    _store = store
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    error = ""
    if requestcancel(_store,claim.job_id(),"cancel during fixture provider call",error) \= 0 then say "PUBLICATION_FAIL=provider cancellation setup " || error
    provider = .batchprovider("cancelled-response")
    return provider.process(claim)

singleprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    source_id = "concept-sha256:" || rxhash..sha256hex(("alpha" || "00"x || "concept") as .binary)
    target_id = "concept-sha256:" || rxhash..sha256hex(("beta" || "00"x || "concept") as .binary)
    proposal = .ragextractionproposal("crexx-rag.extraction-proposal/1","single-proposal","claim",source_id,"Alpha","concept","related-to",target_id,"Beta","concept","outbound","{}","","","chunk-publication",0,10,"support","assertion","direct","","fixture-lineage",1000000,"fixture","fixture","single-request","fixture","fixture","public","generic-profile",0)
    mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(0,"fixture","fixture","single-request",10,10,0,1,0,proposal,"",1,"candidate-single-source","missing-single-target",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes)

windowprovider: class implements .ragworkprovider
  _invalid = .int
  *: factory
    arg invalid = 0
    _invalid = invalid
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal; vectors = .ragworkembedding[]
    vectors[1] = .ragworkembedding("chunk-publication","windows-profile",copies("1",64),"fixture","window-model",1,copies("a",64),"0000803F"x as .binary)
    wire = "000080BF"x as .binary
    if _invalid = 1 then wire = ''x as .binary
    vectors[2] = .ragworkembedding("chunk-publication","windows-profile",copies("2",64),"fixture","window-model",1,copies("a",64),wire)
    vectors[3] = vectors[1]
    mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    result = .ragworkproviderresult(0,"fixture","window-model",claim.attempt_id(),16,0,0,1,0,empty,"",0,"","",vectors[1],"","local-compute",mentions,proposals,notes)
    call result.set_embeddings(vectors)
    return result

windowpublication: procedure = .int
  arg store = .ragstorehandle, policy = .ragclaimpolicy
  errors = 0; error = ""; database = store.database(); disposition = ""
  before_runs = scalar(database,"SELECT count(*) FROM provider_runs")
  before_generation = scalar(database,"SELECT published_generation FROM library_meta")
  do phase = 1 to 3
    tag = "windows-" || phase
    errors = errors + check(sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('" || tag || "','" || rxhash..sha256hex(tag as .binary) || "','{}','snapshot-publication','queued',1,3,128,0,0,'fixture','fixture')") = 0,"window job")
    input = '{"revision_chunk_id":"chunk-publication","text":"Alpha Beta","charging_basis":"local-compute"}'
    errors = errors + check(sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('" || tag || "','" || tag || "','embedding','queued',1,'" || tag || "','" || rxhash..sha256hex(input as .binary) || "','" || input || "','fixture','fixture')") = 0,"window item")
    errors = errors + check(configurejobbudget(store,tag,10000,128,0,0,5000,1,3,error) = 0,"window budget " || error)
    if phase = 2 then errors = errors + check(sqliteexec(database,"CREATE TRIGGER window_link_failure BEFORE INSERT ON revision_chunk_embeddings WHEN NEW.revision_chunk_id='chunk-publication' AND (SELECT count(*) FROM revision_chunk_embeddings WHERE revision_chunk_id='chunk-publication')=1 BEGIN SELECT RAISE(ABORT,'second window failed'); END") = 0,"second-link fault")
    producer = .windowprovider(phase = 1)
    status = runworkeronce(store,tag,"window-worker",60,3,policy,producer,disposition,error,genericprofile())
    if phase = 1 then errors = errors + check(status = 0 & disposition = "invalid-embedding","reject incomplete list before publication " || error)
    if phase = 2 then do
      errors = errors + check(status < 0 & disposition = "embedding-promotion-failed","second-link fault rejected " || error)
      errors = errors + check(sqliteexec(database,"DROP TRIGGER window_link_failure") = 0,"remove second-link fault")
    end
    if phase < 3 then errors = errors + check(scalar(database,"SELECT count(*) FROM embeddings WHERE embedding_profile_id='windows-profile'") = 0 & scalar(database,"SELECT count(*) FROM revision_chunk_embeddings WHERE revision_chunk_id='chunk-publication'") = 0 & scalar(database,"SELECT count(*) FROM job_items WHERE item_id='" || tag || "' AND state='processed'") = 0,"no partial window vectors, links or completion")
    else errors = errors + check(status = 0 & disposition = "embedded" & scalar(database,"SELECT count(*) FROM embeddings WHERE embedding_profile_id='windows-profile'") = 2 & scalar(database,"SELECT count(*) FROM revision_chunk_embeddings WHERE revision_chunk_id='chunk-publication'") = 2 & scalar(database,"SELECT count(*) FROM job_items WHERE item_id='" || tag || "' AND state='processed'") = 1,"complete list publishes once, duplicate input shares link " || error)
  end
  errors = errors + check(scalar(database,"SELECT count(*) FROM provider_runs") = before_runs+3 & scalar(database,"SELECT published_generation FROM library_meta") = before_generation,"window attempts retain accounting and source generation")
  errors = errors + check(scalar(database,"SELECT count(*) FROM chunk_contents WHERE content_id='content-publication' AND text='Alpha Beta'") = 1,"window publication preserves parent source")
  return errors

retryprovider: class implements .ragworkprovider
  *: factory
    return
  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty = .ragextractionproposal
    mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(-1,"fixture","fixture","retry-request",0,0,0,1,1,empty,"retry fixture",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",mentions,proposals,notes,2000)

accountingcase: procedure = .int
  arg store = .ragstorehandle, tag = .string, limit = .int
  database = store.database(); error = ""
  if sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('job-" || tag || "','" || rxhash..sha256hex(tag as .binary) || "','{}','snapshot-publication','queued',2," || limit || ",256,128,200,'fixture','fixture')") \= 0 then return 1
  do n = 1 to 2
    if sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-" || tag || n || "','job-" || tag || "','improve-extraction','queued'," || (3-n) || ",'idem-" || tag || n || "','" || rxhash..sha256hex('{}' as .binary) || "','{}','fixture','fixture')") \= 0 then return 1
  end
  return configurejobbudget(store,"job-" || tag,10000,128,64,100,5000,2,3,error)

citationrecoverycase: procedure = .int
  arg store = .ragstorehandle, path = .string
  errors = 0; error = ""; database = store.database()
  errors = errors + check(accountingcase(store,"citation",2) = 0,"citation accounting fixture")
  first = .ragworkclaim; reservation = .ragcallreservation; run_id = ""
  errors = errors + check(claimnext(store,"job-citation","citation-first",60,1,first,error) = 0,"claim initial citation")
  errors = errors + check(reservecall(store,first,128,64,100,5000,reservation,error) = 0,"reserve initial citation")
  errors = errors + check(beginproviderrequest(store,first,"citation-original",error) = 0,"persist initial citation intent")
  errors = errors + check(recordproviderresponse(store,first,'{"status":0,"content":"unsupported original"}',error) = 0,"persist original response")
  errors = errors + check(settlecall(store,reservation,"fixture","fixture","citation-original","failed",20,10,40,12,run_id,error) = 0,"settle initial failed citation")
  errors = errors + check(failattempt(store,first,0,1,1,"citation invalid",error,"citation invalid") = 0,"one correction despite ordinary attempt limit one")
  /* Reopen the store: correction context and limit must not live in a VM. */
  reopened = .ragstorehandle
  errors = errors + check(openragstore(path,"readwrite",reopened,error) = 0,"reopen correction store")
  second = .ragworkclaim; previous = ""; feedback = ""; body = ""; original = ""
  errors = errors + check(claimnext(reopened,"job-citation","citation-correction",60,1,second,error) = 0 & second.item_id() = first.item_id(),"correction has immediate priority")
  errors = errors + check(citationcorrectioncontext(reopened,second,previous,feedback) = 1 & previous = "unsupported original" & feedback = "citation invalid","durable original response and challenge")
  errors = errors + check(recoverproviderresponse(reopened,second,body,original,error) = 0 & body = "","original receipt is not mistaken for corrected output")
  errors = errors + check(reservecall(reopened,second,128,64,100,5000,reservation,error) = 0,"correction owns second reservation")
  errors = errors + check(beginproviderrequest(reopened,second,"citation-corrected",error) = 0,"persist correction intent")
  errors = errors + check(recordproviderresponse(reopened,second,'{"status":0,"content":"still unsupported"}',error) = 0,"persist corrected response")
  errors = errors + check(settlecall(reopened,reservation,"fixture","fixture","citation-corrected","failed",20,10,40,12,run_id,error) = 0,"settle second counted call")
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET lease_until=unixepoch()-1 WHERE item_id='" || second.item_id() || "'") = 0,"interrupt after correction receipt")
  recovered = .ragworkclaim
  errors = errors + check(claimnext(reopened,"job-citation","citation-recovery",60,1,recovered,error) = 0 & recovered.item_id() = first.item_id(),"recover correction after lease expiry")
  errors = errors + check(recoverproviderresponse(reopened,recovered,body,original,error) = 1 & original = second.attempt_id() & pos("still unsupported",body) > 0,"reuse corrected receipt without third call")
  errors = errors + check(failattempt(reopened,recovered,1,0,10,"still invalid",error,"still invalid") = 0,"failed correction is terminal even with transport retries enabled")
  errors = errors + check(scalar(database,"SELECT count(*) FROM job_events WHERE item_id='" || first.item_id() || "' AND event_type='citation-correction-requested'") = 1,"only one durable challenge")
  errors = errors + check(scalar(database,"SELECT count(*) FROM provider_runs WHERE request_hash IN(SELECT request_hash FROM provider_runs WHERE provider_run_id IN(SELECT provider_run_id FROM attempts WHERE item_id='" || first.item_id() || "'))") = 2,"exactly two separately counted calls")
  errors = errors + check(scalar(database,"SELECT count(*) FROM job_items WHERE item_id='" || first.item_id() || "' AND state='dead_letter'") = 1,"no automatic third correction")
  ignored = closeragstore(reopened,error)
  return errors

legacyfoldercase: procedure = .int
  arg path = .string
  store = .ragstorehandle; error = ""; errors = 0
  if initragstore(path,"library-folder","snapshot-folder","folder","1","generic-profile","profile-hash","config-hash","{}",store,error) \= 0 then return 1
  observations = .ragsourceobservation[]; plan = .ragingestplan
  observations[1] = .ragsourceobservation("folder:fixture","source.txt","","file:./source.txt","Source","text/plain","utf-8","plain","Alpha Beta." as .binary,1,"","","{}","fixture")
  status = createingestplan(store,"folder:fixture","snapshot-folder","policy","parser",128,observations,plan,error)
  first = applyingestplan(store,plan,observations)
  errors = errors + check(first.status() = 0,"legacy folder fixture " || first.error())
  observations[1] = .ragsourceobservation("folder:fixture","source.txt","","file:" || rxfs..cwd() || "/source.txt","Source","text/plain","utf-8","plain","Alpha Beta." as .binary,1,"","","{}","fixture")
  status = createingestplan(store,"folder:fixture","snapshot-folder","policy","parser",128,observations,plan,error)
  same = applyingestplan(store,plan,observations)
  errors = errors + check(same.disposition() = "identical-no-op" & same.generation() = first.generation() & same.provider_calls() = 0,"config path resolution preserves legacy folder identity")
  errors = errors + check(scalar(store.database(),"SELECT count(*) FROM source_revisions") = 1,"equivalent URI did not replace source history")
  observations[1] = .ragsourceobservation("folder:fixture","source.txt","","file:" || rxfs..cwd() || "/source.txt","Source","text/plain","utf-8","plain","Alpha Changed." as .binary,1,"","","{}","fixture")
  status = createingestplan(store,"folder:fixture","snapshot-folder","policy","parser",128,observations,plan,error)
  changed = applyingestplan(store,plan,observations)
  errors = errors + check(changed.status() = 0 & changed.disposition() = "published" & changed.generation() > first.generation(),"equivalent URI does not hide changed source bytes")
  ignored = closeragstore(store,error)
  return errors

main: procedure = .int
  arg args = .string[]
  if args.0 = 2 then if args[2] = "heartbeat" then return heartbeatprobe(args[1])
  if args.0 \= 1 then return 2
  errors = 0; error = ""; store = .ragstorehandle
  errors = errors + check(initragstore(args[1],"library-publication","snapshot-publication","publication","1","generic-profile","profile-hash","config-hash","{}",store,error) = 0,"init " || error)
  if errors > 0 then return 1
  other = .ragstorehandle
  errors = errors + check(openragstore(args[1],"readwrite",other,error) = 0,"independent publisher connection " || error)
  errors = errors + heartbeatcase(store,other)
  errors = errors + check(sqliteexec(other.database(),"PRAGMA busy_timeout=0") = 0,"bounded lock contender")
  generation = 0
  errors = errors + check(begingeneration(store,1,"snapshot-publication","held publisher",generation,error) = 0,"hold publication ownership " || error)
  /* No timing heuristic: SQLite's first connection definitely owns the write
   * transaction. A second publisher must not touch its shared projection. */
  status = publishmanifest(other,error)
  errors = errors + check(status \= 0,"manifest publisher ignored another connection's publication ownership")
  errors = errors + check(sqliteexec(store.database(),"INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES('uncommitted-concept','Uncommitted','concept','active'," || generation || ")") = 0,"stage a real writer mutation")
  reader = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(args[1],reader,error) = 0 & reader.generation() = 1,"reader pins prior generation during writer ownership " || error)
  errors = errors + check(scalar(reader.database(),"SELECT count(*) FROM concepts") = 0,"reader cannot see uncommitted writer prefix")
  backup = .ragbackupreport
  errors = errors + check(backupragstore(args[1],args[1] || "-during-writer",backup,error) = 0,"backup while writer owns mutation " || error)
  restored = .ragbackupreport
  errors = errors + check(restoreragstore(args[1] || "-during-writer",args[1] || "-restored",restored,error) = 0,"restore reader snapshot while writer remains active " || error)
  restored_view = .ragreadsnapshot
  errors = errors + check(beginreadsnapshot(args[1] || "-restored",restored_view,error) = 0 & scalar(restored_view.database(),"SELECT count(*) FROM concepts") = 0 & restored_view.generation() = 1,"restored backup contains only committed generation")
  ignored = closereadsnapshot(restored_view,error) | closereadsnapshot(reader,error)
  interrupted_backup = .ragbackupsession
  errors = errors + check(beginragbackup(args[1],args[1] || "-interrupted-backup",interrupted_backup,error) = 0,"start interrupted backup " || error)
  errors = errors + check(abortragbackup(interrupted_backup,error) = 0 & rxfs..isdir(args[1] || "-interrupted-backup") = 0 & rxfs..isdir(args[1] || "-interrupted-backup.new") = 0,"aborted backup leaves no published partial copy")
  errors = errors + check(abortgeneration(store,error) = 0,"release publication ownership " || error)
  errors = errors + check(publishmanifest(other,error) = 0,"publish after owner released " || error)
  errors = errors + check(closeragstore(other,error) = 0,"close contender")

  database = store.database()
  errors = errors + check(sqliteexec(database,"INSERT INTO source_artifacts(artifact_id,raw_digest,mime_type,encoding,bytes,external_reference,created_at) VALUES('artifact-publication','raw','text/plain','utf-8',NULL,'fixture://publication','fixture')") = 0,"artifact")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revision_texts(text_id,text_digest,normalized_utf8,extractor_version,normalization_version,created_at) VALUES('text-publication','text','Alpha Beta','fixture','utf8','fixture')") = 0,"text")
  errors = errors + check(sqliteexec(database,"INSERT INTO sources(source_id,connector_type,stable_key,current_revision_id,lifecycle_state,observed_uri,observed_title,visible_from_generation) VALUES('source-publication','fixture','publication','revision-publication','active','fixture://publication','Publication',1)") = 0,"source")
  errors = errors + check(sqliteexec(database,"INSERT INTO source_revisions(revision_id,source_id,revision_envelope_digest,artifact_id,text_id,metadata_fingerprint,captured_at,visible_from_generation) VALUES('revision-publication','source-publication','envelope','artifact-publication','text-publication','metadata','fixture',1)") = 0,"revision")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunk_contents(content_id,content_digest,text,input_fingerprint) VALUES('content-publication','content','Alpha Beta','input')") = 0,"content")
  errors = errors + check(sqliteexec(database,"INSERT INTO revision_chunks(revision_chunk_id,revision_id,ordinal,normalized_start,normalized_end,content_id,continuity_key,parser_version,evidence_class,visible_from_generation) VALUES('chunk-publication','revision-publication',1,0,10,'content-publication','continuity','fixture','direct',1)") = 0,"chunk")
  errors = errors + check(sqliteexec(database,"INSERT INTO chunks_fts(revision_chunk_id,content_id,body) VALUES('chunk-publication','content-publication','Alpha Beta')") = 0,"FTS")
  errors = errors + check(sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('job-publication','" || copies("a",64) || "','{}','snapshot-publication','queued',1,1,128,64,0,'fixture','fixture')") = 0,"job")
  input = '{"revision_chunk_id":"chunk-publication","charging_basis":"local-compute"}'
  errors = errors + check(sqliteexec(database,"INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-publication','job-publication','improve-extraction','queued',1,'idem','" || rxhash..sha256hex(input as .binary) || "','" || input || "','fixture','fixture')") = 0,"item")
  errors = errors + check(configurejobbudget(store,"job-publication",10000,128,64,0,5000,1,1,error) = 0,"budget " || error)
  provider = .batchprovider("publication"); disposition = ""
  policy = .ragclaimpolicy("fixture","concept","related-to",1000000,750000,500000,-1000000,250000)
  status = runworkeronce(store,"job-publication","fixture-worker",60,1,policy,provider,disposition,error,genericprofile())
  errors = errors + check(status = 0,"settle rejected batch " || error)
  errors = errors + check(scalar(database,"SELECT published_generation FROM library_meta") = 1,"rejected batch published a generation prefix")
  errors = errors + check(scalar(database,"SELECT count(*) FROM concepts") = 0 & scalar(database,"SELECT count(*) FROM mentions") = 0 & scalar(database,"SELECT count(*) FROM candidate_mentions") = 0,"rejected batch left partial concepts or mentions")
  errors = errors + check(scalar(database,"SELECT count(*) FROM provider_runs") = 1 & scalar(database,"SELECT count(*) FROM attempts") = 1,"rejected batch lost or repeated paid accounting")
  errors = errors + check(scalar(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs") = 0,"rejected batch leaked reservations")

  /* Rollback is an operator operation too. If SQLite rejects its final
   * pointer update, the old published manifest and FTS must still be usable. */
  generation = 0
  errors = errors + check(begingeneration(store,1,"snapshot-publication","rollback fault source",generation,error) = 0 & commitgeneration(store,generation,error) = 0 & publishmanifest(store,error) = 0,"prepare rollback fault " || error)
  errors = errors + check(sqliteexec(database,"CREATE TRIGGER rollback_fault BEFORE UPDATE OF published_generation ON library_meta WHEN NEW.published_generation<OLD.published_generation BEGIN SELECT RAISE(ABORT,'injected rollback pointer failure'); END") = 0,"inject rollback failure")
  status = rollbackgeneration(store,generation,1,"fixture rejected rollback",error)
  errors = errors + check(status \= 0 & pos("rollback pointer",error) > 0,"rollback reached the intended SQL failure " || error)
  errors = errors + check(scalar(database,"SELECT published_generation FROM library_meta") = generation & scalar(database,"SELECT count(*) FROM chunks_fts") = 1,"rejected rollback changed SQLite publication or FTS")
  manifest_state = ""
  errors = errors + check(manifeststate(store,manifest_state,error) = 0 & manifest_state = "aligned","rejected rollback changed the published manifest: " || manifest_state)
  errors = errors + check(sqliteexec(database,"DROP TRIGGER rollback_fault") = 0 & recovermanifest(store,error) = 0,"remove rollback failure and recover projection " || error)
  errors = errors + check(rollbackgeneration(store,generation,1,"fixture successful rollback",error) = 0 & manifeststate(store,manifest_state,error) = 0 & manifest_state = "aligned","successful rollback remains aligned " || error)

  errors = errors + check(sqliteexec(database,"INSERT INTO jobs(job_id,plan_digest,canonical_plan,config_snapshot_id,state,item_budget,model_call_budget,input_token_budget,output_token_budget,cost_budget,created_at,updated_at) VALUES('job-cancel','" || copies("b",64) || "','{}','snapshot-publication','queued',1,1,128,64,0,'fixture','fixture'); INSERT INTO job_items(item_id,job_id,item_type,state,priority,idempotency_key,input_hash,input_json,created_at,updated_at) VALUES('item-cancel','job-cancel','improve-extraction','queued',1,'idem-cancel','" || rxhash..sha256hex(input as .binary) || "','" || input || "','fixture','fixture')") = 0,"cancellation job")
  errors = errors + check(configurejobbudget(store,"job-cancel",10000,128,64,0,5000,1,1,error) = 0,"cancellation budget " || error)
  cancelled_provider = .cancellingprovider(store)
  status = runworkeronce(store,"job-cancel","cancel-fixture-worker",60,1,policy,cancelled_provider,disposition,error,genericprofile())
  errors = errors + check(status = 0 & disposition = "cancelled","cancel after admitted response " || disposition || " " || error)
  errors = errors + check(scalar(database,"SELECT count(*) FROM provider_runs") = 2 & scalar(database,"SELECT count(*) FROM attempts WHERE item_id='item-cancel' AND outcome='cancelled' AND provider_run_id IS NOT NULL") = 1,"cancelled paid response lost its accounting")
  errors = errors + check(scalar(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='job-cancel'") = 0 & scalar(database,"SELECT count(*) FROM job_items WHERE item_id='item-cancel' AND state='cancelled'") = 1,"cancelled response did not release reservations and finish")
  errors = errors + check(scalar(database,"SELECT published_generation FROM library_meta") = 1 & scalar(database,"SELECT count(*) FROM concepts") = 0,"cancelled response published graph data")
  errors = errors + check(accountingcase(store,"single",2) = 0,"single proposal fixture")
  errors = errors + check(sqliteexec(database,"INSERT INTO candidate_mentions(candidate_id,revision_chunk_id,normalized_candidate,span_start,span_end,extractor_version,visible_from_generation) VALUES('candidate-single-source','chunk-publication','alpha',0,5,'fixture',1); INSERT INTO candidate_decisions(decision_id,candidate_id,decision_version,state,evidence_json,policy_version,created_at) VALUES('decision-single','candidate-single-source',1,'accepted','{}','fixture','fixture')") = 0,"single proposal accepted source candidate")
  single_provider = .singleprovider()
  status = runworkeronce(store,"job-single","single-worker",60,1,policy,single_provider,disposition,error,genericprofile())
  errors = errors + check(status = 0 & disposition = "retry-after-validation-or-promotion-race","single proposal rejects missing target " || disposition || " " || error)
  errors = errors + check(scalar(database,"SELECT published_generation FROM library_meta") = 1 & scalar(database,"SELECT count(*) FROM concepts") = 0 & scalar(database,"SELECT count(*) FROM mentions") = 0,"single proposal failure rolls back source promotion and generation")
  errors = errors + check(scalar(database,"SELECT count(*) FROM attempts a JOIN job_items i USING(item_id) WHERE i.job_id='job-single' AND a.provider_run_id IS NOT NULL AND a.outcome='dead_letter'") = 1,"single proposal retains paid failure accounting")
  errors = errors + check(accountingcase(store,"last-call",1) = 0,"accounting fixture")
  first = .ragworkclaim; second = .ragworkclaim
  first_reservation = .ragcallreservation; second_reservation = .ragcallreservation
  status = claimnext(store,"job-last-call","first",60,3,first,error)
  status = claimnext(store,"job-last-call","second",60,3,second,error)
  status = reservecall(store,first,128,64,100,5000,first_reservation,error)
  status = reservecall(store,second,128,64,100,5000,second_reservation,error)
  errors = errors + check(first_reservation.status() = 0 & second_reservation.status() \= 0,"last call is reserved against concurrent admission")
  run_id = ""; duplicate_id = ""
  status = settlecall(store,first_reservation,"fixture","fixture","excess","succeeded",129,65,101,5001,run_id,error)
  errors = errors + check(status = 0,"REL-012 accounts above-estimate actual usage " || error)
  errors = errors + check(scalar(database,"SELECT input_tokens+output_tokens+cost_microunits+duration_ms FROM provider_runs WHERE provider_run_id='" || run_id || "'") = 5296,"exact above-estimate usage")
  errors = errors + check(settlecall(store,first_reservation,"fixture","fixture","excess","succeeded",129,65,101,5001,duplicate_id,error) = 0 & duplicate_id = run_id,"identical settlement is idempotent " || error)
  errors = errors + check(settlecall(store,first_reservation,"fixture","fixture","excess","succeeded",129,65,102,5001,duplicate_id,error) \= 0,"conflicting duplicate receipt rejected")
  errors = errors + check(scalar(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='job-last-call'") = 0,"no duplicate reservation release")

  errors = errors + check(accountingcase(store,"late",2) = 0,"late fixture")
  old_claim = .ragworkclaim; new_claim = .ragworkclaim; late_reservation = .ragcallreservation
  status = claimnext(store,"job-late","old",60,3,old_claim,error)
  status = reservecall(store,old_claim,128,64,100,5000,late_reservation,error)
  errors = errors + check(sqliteexec(database,"UPDATE job_items SET lease_until=unixepoch()-1 WHERE item_id='" || old_claim.item_id() || "'") = 0,"expire old lease")
  status = claimnext(store,"job-late","new",60,3,new_claim,error)
  status = settlecall(store,late_reservation,"fixture","fixture","late","succeeded",20,10,40,12,run_id,error)
  errors = errors + check(status = 0,"late receipt is accountable " || error)
  errors = errors + check(scalar(database,"SELECT count(*) FROM attempts WHERE attempt_id='" || old_claim.attempt_id() || "' AND outcome='expired' AND provider_run_id='" || run_id || "'") = 1,"late usage belongs to original expired attempt")
  errors = errors + check(skipitem(store,old_claim,"stale publication",error) \= 0,"late accounting never restores publication fence")
  errors = errors + check(settlecall(store,late_reservation,"fixture","fixture","late","succeeded",20,10,40,12,duplicate_id,error) = 0 & duplicate_id = run_id,"late duplicate idempotence")
  errors = errors + check(scalar(database,"SELECT reserved_calls+reserved_tokens+reserved_cost FROM jobs WHERE job_id='job-late'") = 0,"expired reservation is not released twice")
  errors = errors + check(accountingcase(store,"turns",2) = 0,"turn budget fixture")
  turn_input = '{"charging_basis":"subscription-allowance"}'
  errors = errors + check(sqliteexec(database,"UPDATE jobs SET codex_turn_budget=2 WHERE job_id='job-turns'; UPDATE job_items SET input_json='" || turn_input || "',input_hash='" || rxhash..sha256hex(turn_input as .binary) || "' WHERE job_id='job-turns'") = 0,"two reviewed subscription turns")
  turn_first = .ragworkclaim; turn_second = .ragworkclaim; turn_reservation = .ragcallreservation; next_turn_reservation = .ragcallreservation
  status = claimnext(store,"job-turns","turn-one",60,3,turn_first,error)
  status = claimnext(store,"job-turns","turn-two",60,3,turn_second,error)
  errors = errors + check(reservecall(store,turn_first,128,64,100,5000,turn_reservation,error) = 0,"reserve first subscription turn " || error)
  external_id = ""
  errors = errors + check(beginexternalrun(store,turn_first,"codex","fixture","turn-one","subscription-allowance","fixture-thread",0,external_id,error) = 0,"record first running subscription turn " || error)
  errors = errors + check(reservecall(store,turn_second,128,64,100,5000,next_turn_reservation,error) = 0,"a running turn is not counted again as an unstarted reservation " || error)
  errors = errors + check(settlecall(store,turn_reservation,"codex","fixture","turn-one","succeeded",10,10,0,1,run_id,error,external_id,"subscription-allowance") = 0,"settle first subscription turn " || error)
  errors = errors + check(settlecall(store,next_turn_reservation,"codex","fixture","turn-two","succeeded",10,10,0,1,run_id,error,"","subscription-allowance") = 0,"settle second subscription turn " || error)
  errors = errors + check(scalar(database,"SELECT reserved_calls+reserved_tokens+reserved_cost+reserved_codex_turns FROM jobs WHERE job_id='job-turns'") = 0,"subscription reservations reconcile exactly")
  errors = errors + check(accountingcase(store,"retry",2) = 0,"retry delay fixture")
  retry_provider = .retryprovider()
  status = runworkeronce(store,"job-retry","retry-worker",60,3,policy,retry_provider,disposition,error,genericprofile())
  errors = errors + check(status = 0 & scalar(database,"SELECT count(*) FROM job_items WHERE item_id='item-retry1' AND state='queued' AND retry_at-unixepoch() BETWEEN 1 AND 2") = 1,"2000 ms retry becomes two seconds, not remainder " || error)
  errors = errors + citationrecoverycase(store,args[1])
  errors = errors + windowpublication(store,policy)
  errors = errors + check(closeragstore(store,error) = 0,"close fixture")
  errors = errors + legacyfoldercase(args[1] || "-legacy-folder")
  if errors > 0 then return 1
  say "PUBLICATION_OK ownership batch_atomicity paid_accounting rollback_failure cancellation"
  return 0
