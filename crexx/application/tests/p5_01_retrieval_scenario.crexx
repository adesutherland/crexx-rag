options levelg

import rxfnsb
import rxhash
import rxjson
import sqlite_boundary
import provider_contract
import ragfile
import ragstore
import ragingest
import ragfolder
import ragprofile
import it_architecture_profile
import ragquery
import ragembedding
import ragretrieval
import ragevidencejson

fixtureprovider: class implements .provider
  _dimension = .int
  _fail_on = .int
  _calls = .int

  *: factory
    arg dimension = 8, fail_on = 0
    _dimension = dimension
    _fail_on = fail_on
    _calls = 0
    return

  calls: method = .int
    return _calls
  capabilities: method = .providercapabilities
    return .providercapabilities("fixture", 1, 1, 1, 1, 0, 0, 8192, 2)
  generate: method = .providerresult
    arg request = .providerrequest
    result = .providerresult(); call result.set_generation("fixture", request.model(), request.request_id(), "fixture", "stop", .providerusage(1, 1, 1, 0), 1000)
    return result
  generate_structured: method = .providerresult
    arg request = .providerrequest
    result = .providerresult(); call result.set_generation("fixture", request.model(), request.request_id(), '{}', "stop", .providerusage(1, 1, 1, 0), 1000)
    return result
  embed: method = .providerresult
    arg request = .providerrequest
    _calls = _calls + 1
    if _fail_on > 0 & _calls = _fail_on then return _failure(request)
    inputs = request.inputs(); vectors = .embeddingrecord[]
    vectors[1] = .embeddingrecord("f32le-v1", _dimension, fixturevector(inputs[1], _dimension))
    result = .providerresult(); call result.set_embeddings("fixture", request.model(), request.request_id(), vectors, .providerusage(3, 0, 1, 0), 1200)
    return result
  embed_batch: method = .providerresult
    arg request = .providerrequest
    _calls = _calls + 1
    if _fail_on > 0 & _calls = _fail_on then return _failure(request)
    inputs = request.inputs(); vectors = .embeddingrecord[]
    do i = 1 to inputs.0
      vectors[i] = .embeddingrecord("f32le-v1", _dimension, fixturevector(inputs[i], _dimension))
    end
    result = .providerresult(); call result.set_embeddings("fixture", request.model(), request.request_id(), vectors, .providerusage(inputs.0 * 3, 0, inputs.0, 0), 1400)
    return result
  cancel: method = .providerresult
    arg request_id = .string
    result = .providerresult(); call result.set_failure("fixture", "", request_id, .providererror("unsupported", -120, 0, 0, 0, "cancellation unsupported"))
    return result

  _failure: method = .providerresult
    arg request = .providerrequest
    result = .providerresult(); call result.set_failure("fixture", request.model(), request.request_id(), .providererror("fixture_failure", -777, 0, 1, _calls, "deterministic partial failure"), .providerusage(0, 0, 0, 0), 500)
    return result

fixturevector: procedure = .binary
  arg text = .string, dimension = .int
  lower_text = lower(text); values = .float[]
  do i = 1 to dimension; values[i] = 0.0; end
  if dimension >= 1 & _any(lower_text, " identity | login | atlas | adx | destination | directory ") then values[1] = 1.0
  if dimension >= 2 & _any(lower_text, " store | database | datastore | persisted | records | cedar ") then values[2] = 1.0
  if dimension >= 3 & _any(lower_text, " parcel | juniper | warehouse | approved path | dispatch ") then values[3] = 1.0
  if dimension >= 4 & _any(lower_text, " mirror | replica | failover | lag | current ") then values[4] = 1.0
  if dimension >= 5 & _any(lower_text, " northwatch | blue watch | freiceadan | regiment ") then values[5] = 1.0
  if dimension >= 6 & _any(lower_text, " brannoch | children of the rain | landless | fugitives ") then values[6] = 1.0
  if dimension >= 7 & _any(lower_text, " rannoch | removals | glen mora | factor iven ") then values[7] = 1.0
  if dimension >= 8 & _any(lower_text, " lawful | unlawful | shelter | voss | quill | stance ") then values[8] = 1.0
  nonzero = 0.0
  do i = 1 to dimension; nonzero = nonzero + abs(values[i]); end
  if nonzero = 0.0 then values[1] = 0.1
  payload = .binary; call binresize payload, dimension * 4
  do i = 1 to dimension; <at..f32>((i - 1) * 4) payload = values[i]; end
  return payload

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do; say "P5_RETRIEVAL_FAIL=" || label; return 1; end
  return 0

elapsedus: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

sortints: procedure
  arg expose values = .int[]
  do i = 2 to values.0
    key_value = values[i]; j = i - 1
    do while j >= 1 & values[j] > key_value
      values[j + 1] = values[j]; j = j - 1
    end
    values[j + 1] = key_value
  end
  return

scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = -1; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

chunklike: procedure = .string
  arg database = .binary, stable_key = .string, pattern = .string
  prepared = .binary
  sql = "SELECT rc.revision_chunk_id FROM revision_chunks rc JOIN source_revisions r ON r.revision_id=rc.revision_id JOIN sources s ON s.source_id=r.source_id JOIN chunk_contents c ON c.content_id=rc.content_id WHERE s.stable_key=?1 AND lower(c.text) LIKE ?2 AND rc.visible_to_generation IS NULL ORDER BY rc.ordinal LIMIT 1"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, stable_key) \= 0 | sqlitebindtext(prepared, 2, "%" || lower(pattern) || "%") \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  value = ""; status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

seedconcept: procedure = .int
  arg database = .binary, concept_id = .string, label = .string, concept_type = .string, generation = .int
  prepared = .binary
  sql = "INSERT INTO concepts(concept_id,canonical_label,concept_type,lifecycle_state,visible_from_generation) VALUES(?1,?2,?3,'active',?4)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  bind_status = sqlitebindtext(prepared, 1, concept_id) | sqlitebindtext(prepared, 2, label) | sqlitebindtext(prepared, 3, concept_type) | sqlitebindint(prepared, 4, generation)
  step_status = sqlitestep(prepared); call sqlitefinalize prepared
  return (bind_status \= 0 | step_status \= 101) * -1

seedalias: procedure = .int
  arg database = .binary, alias_id = .string, surface = .string, concept_id = .string, ambiguity_id = .string, generation = .int
  prepared = .binary
  sql = "INSERT INTO aliases(alias_id,normalized_alias,target_concept_id,ambiguity_id,visible_from_generation) VALUES(?1,?2,?3,?4,?5)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  bind_status = sqlitebindtext(prepared, 1, alias_id) | sqlitebindtext(prepared, 2, lower(surface))
  if concept_id = "" then bind_status = bind_status | sqlitebindnull(prepared, 3)
  else bind_status = bind_status | sqlitebindtext(prepared, 3, concept_id)
  if ambiguity_id = "" then bind_status = bind_status | sqlitebindnull(prepared, 4)
  else bind_status = bind_status | sqlitebindtext(prepared, 4, ambiguity_id)
  bind_status = bind_status | sqlitebindint(prepared, 5, generation)
  step_status = sqlitestep(prepared); call sqlitefinalize prepared
  return (bind_status \= 0 | step_status \= 101) * -1

seedmention: procedure = .int
  arg database = .binary, mention_id = .string, concept_id = .string, chunk_id = .string, generation = .int
  if chunk_id = "" then return -1
  prepared = .binary
  sql = "INSERT INTO mentions(mention_id,concept_id,ambiguity_id,revision_chunk_id,span_start,span_end,visible_from_generation) VALUES(?1,?2,NULL,?3,0,1,?4)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  bind_status = sqlitebindtext(prepared, 1, mention_id) | sqlitebindtext(prepared, 2, concept_id) | sqlitebindtext(prepared, 3, chunk_id) | sqlitebindint(prepared, 4, generation)
  step_status = sqlitestep(prepared); call sqlitefinalize prepared
  return (bind_status \= 0 | step_status \= 101) * -1

seedclaim: procedure = .int
  arg database = .binary, claim_id = .string, source_id = .string, relationship = .string, target_id = .string, chunk_id = .string, polarity = .string, stance = .string, attribution = .string, effective_from = .string, generation = .int
  if chunk_id = "" then return -1
  prepared = .binary
  sql = "INSERT INTO claims(claim_id,source_concept_id,relationship_type,target_concept_id,direction,qualifiers_json,effective_from,effective_to,policy_version,visible_from_generation) VALUES(?1,?2,?3,?4,'outbound','{}',?5,NULL,'p5-fixture-v1',?6)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  bind_status = sqlitebindtext(prepared, 1, claim_id) | sqlitebindtext(prepared, 2, source_id) | sqlitebindtext(prepared, 3, relationship) | sqlitebindtext(prepared, 4, target_id)
  if effective_from = "" then bind_status = bind_status | sqlitebindnull(prepared, 5)
  else bind_status = bind_status | sqlitebindtext(prepared, 5, effective_from)
  bind_status = bind_status | sqlitebindint(prepared, 6, generation)
  step_status = sqlitestep(prepared); call sqlitefinalize prepared
  if bind_status \= 0 | step_status \= 101 then return -1
  prepared = .binary
  sql = "INSERT INTO claim_support(support_id,claim_id,revision_chunk_id,span_start,span_end,polarity,stance,directness,attribution,lineage_group,extractor_identity,visible_from_generation) VALUES(?1,?2,?3,0,1,?4,?5,'direct',?6,?7,'p5-fixture',?8)"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  bind_status = sqlitebindtext(prepared, 1, "support-" || claim_id) | sqlitebindtext(prepared, 2, claim_id) | sqlitebindtext(prepared, 3, chunk_id) | sqlitebindtext(prepared, 4, polarity) | sqlitebindtext(prepared, 5, stance) | sqlitebindtext(prepared, 6, attribution) | sqlitebindtext(prepared, 7, "lineage-" || claim_id) | sqlitebindint(prepared, 8, generation)
  step_status = sqlitestep(prepared); call sqlitefinalize prepared
  return (bind_status \= 0 | step_status \= 101) * -1

seedgraph: procedure = .int
  arg database = .binary, generation = .int
  errors = 0
  concepts = .string[]; labels = .string[]; types = .string[]
  concepts[1] = "parcel-api"; labels[1] = "Parcel API"; types[1] = "application-component"
  concepts[2] = "juniper-queue"; labels[2] = "Juniper Queue"; types[2] = "technology-service"
  concepts[3] = "warehouse-worker"; labels[3] = "Warehouse Worker"; types[3] = "application-component"
  concepts[4] = "atlas-directory"; labels[4] = "Atlas Directory"; types[4] = "data-store"
  concepts[5] = "mirror-agent"; labels[5] = "Mirror Agent"; types[5] = "application-component"
  concepts[6] = "orion-team"; labels[6] = "Orion Team"; types[6] = "actor"
  concepts[7] = "orion-service"; labels[7] = "Orion Service"; types[7] = "application-component"
  concepts[8] = "northwatch"; labels[8] = "Northwatch Regiment"; types[8] = "actor"
  concepts[9] = "house-rannoch"; labels[9] = "House of Rannoch"; types[9] = "actor"
  concepts[10] = "rannoch-estate"; labels[10] = "Rannoch Estate"; types[10] = "actor"
  concepts[11] = "factor-iven"; labels[11] = "Factor Iven"; types[11] = "actor"
  concepts[12] = "voss"; labels[12] = "Elian Voss"; types[12] = "actor"
  concepts[13] = "quill"; labels[13] = "Mara Quill"; types[13] = "actor"
  concepts[14] = "house-brannoch"; labels[14] = "House of Brannoch"; types[14] = "actor"
  concepts[15] = "glen-removals"; labels[15] = "Glen Mora removals"; types[15] = "business-service"
  do i = 1 to concepts.0; errors = errors | seedconcept(database, concepts[i], labels[i], types[i], generation); end
  errors = errors | seedalias(database, "alias-adx", "ADX", "atlas-directory", "", generation)
  errors = errors | seedalias(database, "alias-atlas", "Atlas", "atlas-directory", "", generation)
  errors = errors | seedalias(database, "alias-blue-watch", "Blue Watch", "northwatch", "", generation)
  errors = errors | seedalias(database, "alias-gaelic-watch", "An Freiceadan Gorm", "northwatch", "", generation)
  errors = errors | seedalias(database, "alias-orion", "Orion", "", "ambiguity-orion", generation)
  errors = errors | seedalias(database, "alias-rannoch", "Rannoch", "", "ambiguity-rannoch", generation)

  held_components = chunklike(database, "it-held-out.md", "parcel api writes")
  held_path = chunklike(database, "it-held-out.md", "approved call path")
  held_orion = chunklike(database, "it-held-out.md", "orion is ambiguous")
  scot_northwatch = chunklike(database, "scotland-shaped-chronicle.md", "three independent northwatch")
  scot_rannoch = chunklike(database, "scotland-shaped-chronicle.md", "house of rannoch held")
  scot_stance = chunklike(database, "scotland-shaped-chronicle.md", "voss states")
  ledger_removals = chunklike(database, "scotland-shaped-ledger.md", "factor iven directed")
  ledger_brannoch = chunklike(database, "scotland-shaped-ledger.md", "house of brannoch crossed")
  ledger_adjacent = chunklike(database, "scotland-shaped-ledger.md", "collection adjacency")
  if held_components = "" | held_path = "" | held_orion = "" | scot_northwatch = "" | scot_rannoch = "" | scot_stance = "" | ledger_removals = "" | ledger_brannoch = "" | ledger_adjacent = "" then return -1

  errors = errors | seedmention(database, "mention-parcel", "parcel-api", held_components, generation)
  errors = errors | seedmention(database, "mention-juniper", "juniper-queue", held_components, generation)
  errors = errors | seedmention(database, "mention-warehouse", "warehouse-worker", held_components, generation)
  errors = errors | seedmention(database, "mention-atlas", "atlas-directory", held_components, generation)
  errors = errors | seedmention(database, "mention-mirror", "mirror-agent", held_components, generation)
  errors = errors | seedmention(database, "mention-orion-team", "orion-team", held_orion, generation)
  errors = errors | seedmention(database, "mention-orion-service", "orion-service", held_orion, generation)
  errors = errors | seedmention(database, "mention-northwatch", "northwatch", scot_northwatch, generation)
  errors = errors | seedmention(database, "mention-house-rannoch", "house-rannoch", scot_rannoch, generation)
  errors = errors | seedmention(database, "mention-rannoch-estate", "rannoch-estate", ledger_removals, generation)
  errors = errors | seedmention(database, "mention-iven", "factor-iven", ledger_removals, generation)
  errors = errors | seedmention(database, "mention-voss", "voss", scot_stance, generation)
  errors = errors | seedmention(database, "mention-quill", "quill", scot_stance, generation)
  errors = errors | seedmention(database, "mention-brannoch", "house-brannoch", ledger_brannoch, generation)
  errors = errors | seedmention(database, "mention-brannoch-adjacent", "house-brannoch", ledger_adjacent, generation)
  errors = errors | seedmention(database, "mention-rannoch-adjacent", "house-rannoch", ledger_adjacent, generation)

  errors = errors | seedclaim(database, "claim-parcel-juniper", "parcel-api", "depends-on", "juniper-queue", held_path, "supports", "assertion", "approved design", "", generation)
  errors = errors | seedclaim(database, "claim-juniper-warehouse", "juniper-queue", "supports", "warehouse-worker", held_path, "supports", "assertion", "approved design", "", generation)
  errors = errors | seedclaim(database, "claim-warehouse-atlas", "warehouse-worker", "accesses", "atlas-directory", held_components, "supports", "assertion", "approved design", "", generation)
  errors = errors | seedclaim(database, "claim-mirror-atlas", "mirror-agent", "accesses", "atlas-directory", held_components, "supports", "assertion", "approved design", "", generation)
  errors = errors | seedclaim(database, "claim-iven-removals", "factor-iven", "directed", "glen-removals", ledger_removals, "supports", "assertion", "ledger", "1841", generation)
  errors = errors | seedclaim(database, "claim-voss-lawful", "voss", "judges-lawful", "glen-removals", scot_stance, "supports", "report", "Elian Voss", "1841", generation)
  errors = errors | seedclaim(database, "claim-quill-hardship", "quill", "reports-hardship", "glen-removals", scot_stance, "contradicts", "quotation", "Mara Quill", "1841", generation)
  errors = errors | seedclaim(database, "claim-brannoch-northwatch", "house-brannoch", "supports", "northwatch", ledger_brannoch, "supports", "assertion", "ledger", "1718", generation)
  errors = errors | sqliteexec(database, "INSERT INTO claim_conflicts(conflict_id,claim_id,competing_claim_id,review_state,visible_from_generation) VALUES('conflict-removals','claim-voss-lawful','claim-quill-hardship','unresolved'," || generation || ")")
  errors = errors | sqliteexec(database, "INSERT INTO ambiguity_candidates(ambiguity_id,concept_id,revision_chunk_id,visible_from_generation) VALUES('ambiguity-orion','orion-team','" || held_orion || "'," || generation || "),('ambiguity-orion','orion-service','" || held_orion || "'," || generation || "),('ambiguity-rannoch','house-rannoch','" || scot_rannoch || "'," || generation || "),('ambiguity-rannoch','rannoch-estate','" || ledger_removals || "'," || generation || ")")
  return errors

hasvariant: procedure = .int
  arg plan = .ragqueryplan, kind = .string, contains = .string
  variants = plan.variants()
  do i = 1 to variants.0
    if variants[i].kind() = kind & pos(contains, variants[i].query()) > 0 then return 1
  end
  return 0

hasintent: procedure = .int
  arg plan = .ragqueryplan, expected = .string
  intents = plan.intents()
  do i = 1 to intents.0; if intents[i] = expected then return 1; end
  return 0

hasclaim: procedure = .int
  arg evidence = .ragevidence, relationship = .string
  claims = evidence.claims()
  do i = 1 to claims.0; if claims[i].relationship_type() = relationship then return 1; end
  return 0

hasgap: procedure = .int
  arg evidence = .ragevidence, contains = .string
  gap_values = .string[]
  gap_values = evidence.gaps()
  do i = 1 to gap_values.0; if pos(lower(contains), lower(gap_values[i])) > 0 then return 1; end
  return 0

passagecount: procedure = .int
  arg evidence = .ragevidence
  passage_values = .ragpassage[]
  passage_values = evidence.passages()
  return passage_values.0

claimcount: procedure = .int
  arg evidence = .ragevidence
  claim_values = .ragacceptedclaim[]
  claim_values = evidence.claims()
  return claim_values.0

ambiguitycount: procedure = .int
  arg evidence = .ragevidence
  ambiguity_values = .string[]
  ambiguity_values = evidence.ambiguities()
  return ambiguity_values.0

leadcount: procedure = .int
  arg evidence = .ragevidence
  lead_values = .raggraphlead[]
  lead_values = evidence.leads()
  return lead_values.0

diagnoseevidence: procedure
  arg label = .string, evidence = .ragevidence
  diagnostic_passages = .ragpassage[]; diagnostic_passages = evidence.passages()
  diagnostic_claims = .ragacceptedclaim[]; diagnostic_claims = evidence.claims()
  diagnostic_ambiguities = .string[]; diagnostic_ambiguities = evidence.ambiguities()
  diagnostic_leads = .raggraphlead[]; diagnostic_leads = evidence.leads()
  diagnostic_gaps = .string[]; diagnostic_gaps = evidence.gaps()
  say "P5_RETRIEVAL_DIAG=" || label || " passages=" || diagnostic_passages.0 || " claims=" || diagnostic_claims.0 || " ambiguities=" || diagnostic_ambiguities.0 || " leads=" || diagnostic_leads.0 || " gaps=" || diagnostic_gaps.0
  do i = 1 to diagnostic_passages.0; say "P5_RETRIEVAL_DIAG_PASSAGE=" || diagnostic_passages[i].citation().citation() || " " || diagnostic_passages[i].text(); end
  do i = 1 to diagnostic_claims.0
    diagnostic_conflicts = .string[]; diagnostic_conflicts = diagnostic_claims[i].conflicts()
    say "P5_RETRIEVAL_DIAG_CLAIM=" || diagnostic_claims[i].claim_id() || " relationship=" || diagnostic_claims[i].relationship_type() || " conflicts=" || diagnostic_conflicts.0
  end
  do i = 1 to diagnostic_gaps.0; say "P5_RETRIEVAL_DIAG_GAP=" || diagnostic_gaps[i]; end
  return

hasplanpart: procedure = .int
  arg evidence = .ragevidence, value = .string
  plan_values = .string[]; plan_values = evidence.query_plan()
  do i = 1 to plan_values.0; if pos(lower(value), lower(plan_values[i])) > 0 then return 1; end
  return 0

claimconflictcount: procedure = .int
  arg claim = .ragacceptedclaim
  conflict_values = .string[]
  conflict_values = claim.conflicts()
  return conflict_values.0

hasconflict: procedure = .int
  arg evidence = .ragevidence
  claim_values = .ragacceptedclaim[]; claim_values = evidence.claims()
  do i = 1 to claim_values.0; if claimconflictcount(claim_values[i]) > 0 then return 1; end
  return 0

haslocatorlead: procedure = .int
  arg evidence = .ragevidence
  passage_values = .ragpassage[]; passage_values = evidence.passages()
  do i = 1 to passage_values.0
    if pos("index entry: northwatch regiment", lower(passage_values[i].text())) > 0 & passage_values[i].directness() = "lead" then return 1
  end
  return 0

passagecontains: procedure = .int
  arg evidence = .ragevidence, marker = .string
  passage_values = .ragpassage[]; passage_values = evidence.passages()
  do i = 1 to passage_values.0; if pos(marker, lower(passage_values[i].text())) > 0 then return 1; end
  return 0

passagekey: procedure = .int
  arg evidence = .ragevidence, key = .string
  select
    when key = "it-source-stance" then return passagecontains(evidence, "source stance: approved design")
    when key = "it-components" then return passagecontains(evidence, "parcel api writes dispatch")
    when key = "it-approved-path" then return passagecontains(evidence, "approved call path is")
    when key = "it-risk" then return passagecontains(evidence, "mirror agent can lag")
    when key = "it-orion" then return passagecontains(evidence, "orion is ambiguous")
    when key = "scot-source-layer" then return passagecontains(evidence, "source stance: the compiler favours")
    when key = "scot-northwatch-origin" then return passagecontains(evidence, "three independent northwatch")
    when key = "scot-rannoch" then return passagecontains(evidence, "house of rannoch held farms")
    when key = "scot-removals-stances" then return passagecontains(evidence, "voss states that factor iven")
    when key = "scot-children" then return passagecontains(evidence, 'phrase "children of the rain" does not occur')
    when key = "scot-removals-entry" then return passagecontains(evidence, "factor iven directed removals")
    when key = "scot-brannoch" then return passagecontains(evidence, "house of brannoch crossed")
    when key = "scot-northwatch-index" then return passagecontains(evidence, "index entry: northwatch regiment")
    when key = "scot-adjacency" then return passagecontains(evidence, "collection adjacency is not evidence")
    otherwise return 0
  end
  return 0

requiredkeys: procedure = .string
  arg case_index = .int
  select
    when case_index = 1 then return "it-approved-path,it-components,it-risk"
    when case_index = 2 then return "it-components"
    when case_index = 3 then return "it-orion"
    when case_index = 4 then return "it-source-stance,it-risk"
    when case_index = 5 then return "scot-removals-entry,scot-removals-stances"
    when case_index = 6 then return "scot-children"
    when case_index = 7 then return "scot-northwatch-origin,scot-northwatch-index"
    when case_index = 8 then return "scot-brannoch,scot-rannoch,scot-adjacency"
    when case_index = 9 then return "scot-source-layer,scot-removals-stances"
    otherwise nop
  end
  return ""

passagerecall: procedure = .int
  arg evidence = .ragevidence, keys = .string, expose required = .int
  required = 0; recalled = 0; remaining = keys
  do while remaining \= ""
    separator = pos(",", remaining)
    key = ""
    if separator = 0 then do; key = remaining; remaining = ""; end
    else do; key = substr(remaining, 1, separator - 1); remaining = substr(remaining, separator + 1); end
    required = required + 1
    recalled = recalled + passagekey(evidence, key)
  end
  return recalled

citationsresolve: procedure = .int
  arg store = .ragstorehandle, evidence = .ragevidence
  passage_values = .ragpassage[]; passage_values = evidence.passages()
  do i = 1 to passage_values.0
    resolved = .ragpassage; resolve_error = ""
    if resolvecitation(store, passage_values[i].citation(), resolved, resolve_error) \= 0 | resolved.text() \= passage_values[i].text() then return 0
  end
  claim_values = .ragacceptedclaim[]; claim_values = evidence.claims()
  do i = 1 to claim_values.0
    support_values = .ragsupportcitation[]; support_values = claim_values[i].supports()
    if support_values.0 = 0 then return 0
    do j = 1 to support_values.0
      resolved = .ragpassage; resolve_error = ""
      if resolvecitation(store, support_values[j].citation(), resolved, resolve_error) \= 0 | resolved.text() = "" then return 0
    end
  end
  return passage_values.0 > 0

scorecase: procedure = .int
  arg store = .ragstorehandle, evidence = .ragevidence, case_index = .int, expose required = .int, expose recalled = .int, expose critical_failures = .int
  recalled = passagerecall(evidence, requiredkeys(case_index), required)
  score = 0; critical_failures = 0
  if recalled = required then score = score + 2
  else if recalled > 0 then score = score + 1
  keyword_ok = hasplanpart(evidence, "focused-term:")
  if case_index = 2 then keyword_ok = hasplanpart(evidence, "alias-or-spelling:atlas directory")
  if case_index = 6 then keyword_ok = hasplanpart(evidence, "exact-phrase:")
  if keyword_ok = 1 then score = score + 2
  if recalled = required then score = score + 4
  else if recalled > 0 then score = score + 2
  graph_ok = 1
  if case_index = 1 then graph_ok = claimcount(evidence) >= 3 & hasclaim(evidence, "depends-on") = 1 & hasclaim(evidence, "accesses") = 1
  if case_index = 2 then graph_ok = hasclaim(evidence, "accesses") = 1 & hasclaim(evidence, "alias") = 0
  if case_index = 7 then graph_ok = haslocatorlead(evidence)
  if case_index = 8 then graph_ok = leadcount(evidence) > 0 & hasclaim(evidence, "allied") = 0
  if graph_ok = 1 then score = score + 2
  else critical_failures = critical_failures + 1
  citation_ok = citationsresolve(store, evidence)
  if citation_ok = 1 then score = score + 2
  else critical_failures = critical_failures + 1
  classification_ok = 1
  if case_index = 3 | case_index = 5 | case_index = 8 then classification_ok = ambiguitycount(evidence) > 0
  if case_index = 9 then classification_ok = hasconflict(evidence)
  if classification_ok = 1 then score = score + 2
  else critical_failures = critical_failures + 1
  gap_ok = 1
  if case_index = 1 | case_index = 4 then gap_ok = hasgap(evidence, "every replica is current")
  if case_index = 3 then gap_ok = hasgap(evidence, "datastore")
  if case_index = 5 then gap_ok = hasgap(evidence, "every member")
  if case_index = 6 then gap_ok = hasgap(evidence, "exact phrase")
  if case_index = 8 then gap_ok = hasgap(evidence, "does not establish")
  if case_index = 9 then gap_ok = hasgap(evidence, "neutral legal verdict")
  if gap_ok = 1 then score = score + 2
  else critical_failures = critical_failures + 1
  encoded = ""; encode_error = ""
  passage_values = .ragpassage[]; passage_values = evidence.passages()
  claim_values = .ragacceptedclaim[]; claim_values = evidence.claims()
  lead_values = .raggraphlead[]; lead_values = evidence.leads()
  if encodeevidence(evidence, 65536, encoded, encode_error) \= 0 | passage_values.0 > 12 | claim_values.0 > 8 | lead_values.0 > 8 then critical_failures = critical_failures + 1
  return score

querywire: procedure = .binary
  arg backend = .provider, text = .string
  inputs = .string[]; inputs[1] = text; messages = .providermessage[]
  request = .providerrequest("embed", "embedding", "fixture-embedding", messages, inputs, "", 1000, 1, "local", "query-idempotency", "query-request", 0, 8, 0)
  output = backend.embed(request); vectors = output.embeddings()
  if output.status() \= 0 | vectors.0 \= 1 then return ''x as .binary
  return vectors[1].payload()

setup: procedure = .int
  arg cell = .string, path = .string, fixture_root = .string, expose store = .ragstorehandle, expose error = .string
  if initragstore(path, "library-p5-" || cell, "config-p5", "architecture-local", "1", "it-architecture-profile", "profile-hash-p5", "config-hash-p5", '{}', store, error) \= 0 then return -1
  observations = .ragsourceobservation[]
  if collectfolderobservations(fixture_root, "phase0", 1, 1048576, "2026-08-23T12:00:00Z", observations, error) \= 6 then return -1
  plan = .ragingestplan
  if createingestplan(store, "folder:phase0", "config-p5", "p5-ingest-v1", "p5-parser-v1", 512, observations, plan, error) \= 0 then return -1
  ingest = applyingestplan(store, plan, observations)
  if ingest.ok() \= 1 | ingest.generation() \= 2 then do; error = ingest.error(); return -1; end
  if seedgraph(store.database(), 2) \= 0 then do; error = "cannot seed frozen supported graph"; return -1; end
  return 0

runscenario: procedure = .int
  arg cell = .string, path = .string, fixture_root = .string, packet_directory = ""
  error = ""; store = .ragstorehandle; errors = 0
  errors = errors + check(setup(cell, path, fixture_root, store, error) = 0, "setup " || error)
  if errors \= 0 then return 1
  profile = itarchitectureprofile()
  plan = .ragqueryplan
  errors = errors + check(planquery(store, profile, 'Why were they called "Children of the Rain"?', "p5-retrieval-v1", plan, error) = 0 & hasvariant(plan, "exact-phrase", "children of the rain") = 1 & length(plan.fingerprint()) = 64, "exact phrase plan " || error)
  errors = errors + check(planquery(store, profile, "Which component reads ADX?", "p5-retrieval-v1", plan, error) = 0 & hasvariant(plan, "alias-or-spelling", "atlas directory") = 1, "database alias plan " || error)
  terms = plan.terms(); term_fingerprint = ""
  do i = 1 to terms.0; if terms[i].term() = "adx" then term_fingerprint = terms[i].statistics_fingerprint(); end
  errors = errors + check(length(term_fingerprint) = 64, "versioned corpus term statistics")
  errors = errors + check(planquery(store, profile, "Where is the Atals Directory?", "p5-retrieval-v1", plan, error) = 0 & hasvariant(plan, "alias-or-spelling", "atlas") = 1, "spelling expansion")
  errors = errors + check(planquery(store, profile, "How did deployment change between 1712 and 1720 and what relationship followed?", "p5-retrieval-v1", plan, error) = 0 & hasintent(plan, "time") = 1 & hasintent(plan, "comparison") = 1 & hasintent(plan, "relationship") = 1, "time comparison relationship intents")
  errors = errors + check(planquery(store, profile, 'unterminated "phrase', "p5-retrieval-v1", plan, error) = -1, "malformed phrase rejection")

  envelope = rxhash..sha256hex("fixture-envelope-v1" as .binary)
  errors = errors + check(registerembeddingprofile(store, "p5-embedding", "fixture", "fixture-embedding", 8, envelope, error) = 0, "register immutable embedding profile " || error)
  denied = .fixtureprovider(8, 0); embedding = .ragembeddingresult
  errors = errors + check(embedmissing(store, "p5-embedding", denied, "hosted", "restricted", 100, 2, 1000, embedding, error) = -2 & denied.calls() = 0, "privacy denial before provider call")
  flaky = .fixtureprovider(8, 2)
  errors = errors + check(embedmissing(store, "p5-embedding", flaky, "local", "local", 100, 2, 1000, embedding, error) = -4 & embedding.state() = "partial" & embedding.embedded() > 0 & flaky.calls() = 2, "partial batch failure retained for resume")
  good = .fixtureprovider(8, 0)
  errors = errors + check(embedmissing(store, "p5-embedding", good, "local", "local", 100, 2, 1000, embedding, error) = 0 & embedding.state() = "complete" & embedding.provider_calls() > 0, "incremental embedding resume " || error)
  replay_calls = good.calls()
  errors = errors + check(embedmissing(store, "p5-embedding", good, "local", "local", 100, 2, 1000, embedding, error) = 0 & embedding.missing() = 0 & embedding.provider_calls() = 0 & good.calls() = replay_calls, "embedding replay zero provider calls")
  vector_generation = .ragvectorgenerationresult
  errors = errors + check(buildexactvectorgeneration(store, "p5-embedding", 100000, vector_generation, error) = 0 & vector_generation.state() = "published" & right(vector_generation.sidecar_name(), 6) = ".rxvec", "atomic exact vector generation " || error)
  first_checksum = vector_generation.checksum()
  errors = errors + check(buildexactvectorgeneration(store, "p5-embedding", 100000, vector_generation, error) = 0 & vector_generation.state() = "identical-no-op" & vector_generation.checksum() = first_checksum, "vector generation replay")
  verification = .ragverifyresult
  errors = errors + check(verifyragstore(store, 1, verification, error) = 0 & verification.ok() = 1, "vector sidecar and manifest verification " || verification.summary())

  active_options = .ragretrievaloptions("p5-retrieval-v1", "p5-embedding", querywire(good, "Where are login identities persisted?"), 24, 12, 100000, 3, 12, 8, 8, 60)
  retrieval = .ragretrievalresult
  retrieval_status = retrieveevidence(store, profile, "Where are login identities persisted?", active_options, retrieval, error)
  current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & retrieval.vector_state() = "active-exact-rxvector" & passagecount(current_evidence) > 0, "active lexical/vector retrieval " || error)
  encoded_evidence = ""
  errors = errors + check(encodeevidence(current_evidence, 65536, encoded_evidence, error) = 0 & jsonvalid(encoded_evidence) = 1 & length(encoded_evidence) <= 65536, "bounded typed evidence JSON " || error)
  answer_context = ""
  errors = errors + check(encodeanswercontext(current_evidence, 65536, answer_context, error) = 0 & jsonvalid(answer_context) = 1 & pos('"schema":"crexx-rag.answer-context/1"', answer_context) > 0, "bounded answer context JSON " || error)
  overflow_evidence = ""
  errors = errors + check(encodeevidence(current_evidence, length(encoded_evidence) - 1, overflow_evidence, error) = -2 & overflow_evidence = "", "evidence JSON ceiling rejection")
  trace_id = current_evidence.trace().trace_id()
  repeated = .ragretrievalresult
  repeated_status = retrieveevidence(store, profile, "Where are login identities persisted?", active_options, repeated, error)
  repeated_evidence = repeated.evidence()
  errors = errors + check(repeated_status = 0 & repeated_evidence.trace().trace_id() = trace_id, "deterministic repeated retrieval trace")
  passages = current_evidence.passages(); resolved = .ragpassage
  errors = errors + check(resolvecitation(store, passages[1].citation(), resolved, error) = 0 & resolved.text() \= "", "stable historical revision/span citation " || error)
  bad_dimension = .ragretrievaloptions("p5-retrieval-v1", "p5-embedding", "0000803F"x as .binary, 24, 12, 100000, 2, 12, 8, 8, 60)
  retrieval_status = retrieveevidence(store, profile, "Atlas Directory", bad_dimension, retrieval, error)
  current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & retrieval.vector_state() = "fallback-query-dimension" & passagecount(current_evidence) > 0, "dimension mismatch lexical fallback")

  path_options = .ragretrievaloptions("p5-retrieval-v1", "", ''x as .binary, 24, 12, 100000, 3, 12, 8, 8, 60)
  retrieval_status = retrieveevidence(store, profile, "Trace the approved dependency path from Parcel API to destination records.", path_options, retrieval, error); current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & claimcount(current_evidence) >= 3 & hasclaim(current_evidence, "depends-on") = 1 & hasclaim(current_evidence, "accesses") = 1, "directed typed graph to supported passages")
  retrieval_status = retrieveevidence(store, profile, "What datastore does Orion use?", path_options, retrieval, error); current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & ambiguitycount(current_evidence) > 0 & hasgap(current_evidence, "ambiguous") = 1, "named-sense ambiguity and gap")
  retrieval_status = retrieveevidence(store, profile, "Why were they called Children of the Rain?", path_options, retrieval, error); current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & hasgap(current_evidence, "explicitly says") = 1, "exact phrase absence remains a gap")
  retrieval_status = retrieveevidence(store, profile, "Were the Houses of Brannoch and Rannoch allied?", path_options, retrieval, error); current_evidence = retrieval.evidence()
  adjacency_ok = retrieval_status = 0 & hasclaim(current_evidence, "allied") = 0 & leadcount(current_evidence) > 0 & hasgap(current_evidence, "does not establish") = 1
  if adjacency_ok = 0 then call diagnoseevidence "adjacency", current_evidence
  errors = errors + check(adjacency_ok = 1, "adjacency remains lead not alliance")
  retrieval_status = retrieveevidence(store, profile, "Can the Glen Mora removals be described simply as lawful or unlawful?", path_options, retrieval, error); current_evidence = retrieval.evidence()
  errors = errors + check(retrieval_status = 0 & hasclaim(current_evidence, "judges-lawful") = 1 & hasclaim(current_evidence, "reports-hardship") = 1, "attributed conflicting source stance")

  semantic_generation = vector_generation.semantic_generation(); vector_id = vector_generation.vector_generation_id()
  errors = errors + check(sqliteexec(store.database(), "UPDATE vector_generations SET semantic_generation=1 WHERE vector_generation_id='" || vector_id || "'") = 0, "inject stale vector generation")
  errors = errors + check(retrieveevidence(store, profile, "Atlas Directory", active_options, retrieval, error) = 0 & left(retrieval.vector_state(), 8) = "fallback", "stale generation fallback")
  errors = errors + check(sqliteexec(store.database(), "UPDATE vector_generations SET semantic_generation=" || semantic_generation || " WHERE vector_generation_id='" || vector_id || "'") = 0 & publishmanifest(store, error) = 0, "restore active vector generation")

  queries = .string[]
  queries[1] = "Trace the approved dependency path from Parcel API to destination records and identify the replica risk."
  queries[2] = "What is ADX, and which component reads it?"
  queries[3] = "What datastore does Orion use?"
  queries[4] = "Does the design claim every destination replica is current during regional failover?"
  queries[5] = "What role did Rannoch play in the Glen Mora removals, and how do the sources judge it?"
  queries[6] = "Why were the Brannochs called the Children of the Rain?"
  queries[7] = "Trace the origin of the Northwatch Regiment and explain An Freiceadan Gorm."
  queries[8] = "Were the Houses of Brannoch and Rannoch allied, and which northern claims are direct rather than graph-adjacent?"
  queries[9] = "Can the Glen Mora removals be described simply as lawful or unlawful from this source set?"
  judged_passes = 0; total_passages = 0; total_score = 0; passing_cases = 0; required_passages = 0; recalled_passages = 0; total_critical_failures = 0; query_latencies = .int[]
  do i = 1 to queries.0
    query_started = time("us")
    retrieval_status = retrieveevidence(store, profile, queries[i], path_options, retrieval, error)
    query_latencies[i] = elapsedus(query_started)
    current_evidence = retrieval.evidence()
    passage_total = passagecount(current_evidence)
    if retrieval_status = 0 & passage_total > 0 then do
      judged_passes = judged_passes + 1; total_passages = total_passages + passage_total
      case_required = 0; case_recalled = 0; case_critical = 0
      case_score = scorecase(store, current_evidence, i, case_required, case_recalled, case_critical)
      second_required = 0; second_recalled = 0; second_critical = 0
      second_score = scorecase(store, current_evidence, i, second_required, second_recalled, second_critical)
      if second_score \= case_score | second_required \= case_required | second_recalled \= case_recalled | second_critical \= case_critical then case_critical = case_critical + 1
      if packet_directory \= "" then do
        packet_json = ""; context_json = ""; packet_error = ""
        if encodeevidence(current_evidence, 65536, packet_json, packet_error) \= 0 | encodeanswercontext(current_evidence, 65536, context_json, packet_error) \= 0 | ragfile..writebinaryfile(packet_directory || "/case-" || i || ".json", packet_json as .binary, packet_error) \= 0 | ragfile..writebinaryfile(packet_directory || "/case-" || i || ".context.json", context_json as .binary, packet_error) \= 0 then do
          say "P5_RETRIEVAL_PACKET_FAIL=case-" || i || " " || packet_error
          case_critical = case_critical + 1
        end
      end
      total_score = total_score + case_score; required_passages = required_passages + case_required; recalled_passages = recalled_passages + case_recalled; total_critical_failures = total_critical_failures + case_critical
      if case_score >= 13 & case_critical = 0 then passing_cases = passing_cases + 1
      if case_score < 13 | case_critical \= 0 then do
        say "P5_RETRIEVAL_SCORE_FAIL=case-" || i || " score=" || case_score || "/16 recall=" || case_recalled || "/" || case_required || " critical=" || case_critical || " keys=" || requiredkeys(i)
        call diagnoseevidence "score-case-" || i, current_evidence
      end
    end
    else call diagnoseevidence "held-out-" || i || ":" || error, current_evidence
  end
  errors = errors + check(judged_passes = 9, "all nine frozen held-out questions produce bounded evidence")
  errors = errors + check(passing_cases >= 8 & total_score * 100 >= 85 * 144 & recalled_passages * 100 >= 90 * required_passages & total_critical_failures = 0, "Gate-5 fixed judgement thresholds")
  call sortints query_latencies
  query_total_us = 0; do i = 1 to query_latencies.0; query_total_us = query_total_us + query_latencies[i]; end
  query_p50_us = query_latencies[5]; query_p95_us = query_latencies[9]
  errors = errors + check(query_p95_us < 2000000, "local hybrid query latency ceiling")
  errors = errors + check(closeragstore(store, error) = 0, "close retrieval library")
  if errors \= 0 then return 1
  say "P5_RETRIEVAL_OK cell=" || cell || " query_plan=deterministic phrase=1 prefix=1 alias=1 spelling=1 time=1 comparison=1 relationship=1 term_statistics=versioned lexical=fts5 vector=rxvector-exact graph=directed evidence=crexx-rag.evidence/1 citations=stable-historical provider_denial_calls=0 embedding_resume=1 vector_generation=atomic fallback=lexical judged=" || passing_cases || "/9 score=" || total_score || "/144 required_recall=" || recalled_passages || "/" || required_passages || " critical_failures=" || total_critical_failures || " scorer_resets=2 passages=" || total_passages || " query_p50_us=" || query_p50_us || " query_p95_us=" || query_p95_us || " query_total_us=" || query_total_us
  return 0

_any: procedure = .int
  arg haystack = .string, terms = .string
  start = 2
  do forever
    marker = pos(" | ", terms, start)
    if marker = 0 then term = strip(substr(terms, start))
    else term = strip(substr(terms, start, marker - start))
    if term \= "" & pos(term, haystack) > 0 then return 1
    if marker = 0 then leave
    start = marker + 3
  end
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 3 then return 2
packet_directory = ""
if args.0 >= 4 then packet_directory = args[4]
return runscenario(args[1], args[2], args[3], packet_directory)
