options levelg

import sqlite_boundary
import ragfile
import ragstore
import ragingest

scalarint: procedure = .int
  arg database = .binary, sql = .string
  statement = .binary
  if sqliteprepare(database, sql, statement) \= 0 | sqlitestep(statement) \= 100 then do; call sqlitefinalize statement; return -1; end
  value = -1; status = sqlitecolumnint(statement, 0, value); call sqlitefinalize statement
  if status \= 0 then return -1
  return value

readobservation: procedure = .int
  arg path = .string, stable_key = .string, title = .string, expose observation = .ragsourceobservation, expose error = .string
  raw = .binary; bytes = 0
  if ragfile..readbinaryfilebounded(path, 1048576, raw, bytes, error) \= 0 then return -1
  observation = .ragsourceobservation("folder:scotland-delta", stable_key, "", "fixture://phase0/" || stable_key, title, "text/markdown", "utf-8", "markdown", raw, 1, "", "", '{"corpus":"scotland-shaped-v1"}', "2026-08-23T12:00:00Z")
  return 0

main: procedure = .int
arg args = .string[]
if args.0 < 4 then return 2
error = ""; store = .ragstorehandle
if initragstore(args[2], "p3-scotland-delta-" || args[1], "config-p3-delta", "phase3", "1", "generic-profile", "profile-p3-delta", "config-p3-delta", '{}', store, error) \= 0 then return 1
observations = .ragsourceobservation[]
first = .ragsourceobservation; second = .ragsourceobservation
if readobservation(args[3], "scotland-shaped-chronicle.md", "Chronicle", first, error) \= 0 | readobservation(args[4], "scotland-shaped-ledger.md", "Ledger", second, error) \= 0 then return 1
observations[1] = first; observations[2] = second
plan = .ragingestplan
if createingestplan(store, "folder:scotland-delta", "config-p3-delta", "phase3-policy-v1", "phase3-parser-v1", 512, observations, plan, error) \= 0 then return 1
result = applyingestplan(store, plan, observations)
if result.ok() \= 1 then do; say "ERROR=" || result.error(); return 1; end
sources = scalarint(store.database(), "SELECT count(*) FROM sources WHERE visible_to_generation IS NULL")
chunks = scalarint(store.database(), "SELECT count(*) FROM revision_chunks WHERE visible_to_generation IS NULL")
candidates = scalarint(store.database(), "SELECT count(*) FROM candidate_mentions WHERE visible_to_generation IS NULL")
accepted = scalarint(store.database(), "SELECT count(*) FROM candidate_decisions WHERE state='accepted'")
say '{"implementation":"crexx","corpus":"scotland-shaped-v1","sources":' || sources || ',"chunks":' || chunks || ',"candidates":' || candidates || ',"accepted_candidates":' || accepted || ',"provider_calls":' || result.provider_calls() || '}'
call closeragstore store, error
return 0
