options levelg

import ragmodel
import ragevidence
import ragjob
import raglibrary

fixturejob: class implements .ragjob
  _job_id = .string

  *: factory
    arg job_id = .string
    _job_id = job_id
    return

  status: method = .ragjobstatus
    return .ragjobstatus(_job_id, "queued", 1, 1, 0, 0, 0, 0, 0, 0, "", "fixture", "none", 0.0, "2026-08-04T00:00:00Z", "", "2026-08-04T00:00:00Z", "", "", "pending")

  events: method = .ragjobeventpage
    arg cursor = .string, limit = .int
    events = .ragjobevent[]
    events[1] = .ragjobevent("event-1", "planned", "2026-08-04T00:00:00Z", "", "fixture event")
    return .ragjobeventpage(events, "")

  pause: method = .ragoperationresult
    return .ragoperationresult("job.pause", "accepted", .ragerror())
  resume: method = .ragoperationresult
    return .ragoperationresult("job.resume", "accepted", .ragerror())
  cancel: method = .ragoperationresult
    return .ragoperationresult("job.cancel", "accepted", .ragerror())

fixturelibrary: class implements .raglibrary
  _path = .string
  _access = .string
  _config_id = .string

  *: factory
    arg path = .string, access = .string, config_id = .string
    _path = path
    _access = access
    _config_id = config_id
    return

  status: method = .raglibrarystatus
    capabilities = .string[]
    capabilities[1] = "typed-evidence"
    return .raglibrarystatus("fixture-library", _path, _access, _config_id, "contract-fixture", 0, 7, _access = "read", capabilities, "fixture", .ragerror())

  planIngest: method = .ragplan
    arg sources = .string[], request_options = .ragrequestoptions
    return .ragplan("crexx-rag.plan/1", "ingest", "fixture", "digest-ingest", "2026-08-04T01:00:00Z")

  apply: method = .ragjob
    arg plan = .ragplan, expected_digest = .string
    return .fixturejob("job-1")

  search: method = .ragsearchresult
    arg query = .string, request_options = .ragrequestoptions
    passages = _passages()
    return .ragsearchresult(passages, "", _trace())

  evidence: method = .ragevidence
    arg question = .string, request_options = .ragrequestoptions
    return _evidence(question, "")

  answer: method = .ragevidence
    arg question = .string, request_options = .ragrequestoptions
    return _evidence(question, "Fixture answer")

  trace: method = .ragtrace
    arg query = .string, request_options = .ragrequestoptions
    return _trace()

  path: method = .ragpathresult
    arg source = .string, target = .string, request_options = .ragrequestoptions
    nodes = .string[]
    nodes[1] = source
    nodes[2] = target
    return .ragpathresult(nodes, "accepted claim path", _trace())

  timeline: method = .ragtimelineresult
    arg request_options = .ragrequestoptions
    entries = .ragtimelineentry[]
    entries[1] = .ragtimelineentry("fixture://source@r1#b0-8", "2026-01-01", "", "Fixture event")
    return .ragtimelineresult(entries, "", _trace())

  planImprove: method = .ragplan
    arg request_options = .ragrequestoptions
    return .ragplan("crexx-rag.plan/1", "improve", "fixture", "digest-improve", "2026-08-04T01:00:00Z")

  planProposals: method = .ragplan
    arg input = .string, request_options = .ragrequestoptions
    return .ragplan("crexx-rag.plan/1", "proposals", input, "digest-proposals", "2026-08-04T01:00:00Z")

  review: method = .ragreviewpage
    arg filter = .string, request_options = .ragrequestoptions
    items = .ragreviewitem[]
    items[1] = .ragreviewitem("review-1", "open", filter)
    return .ragreviewpage(items, "")

  close: method = .ragoperationresult
    return .ragoperationresult("library.close", "closed", .ragerror())

fixturelibraryfactory: class implements .raglibraryfactory
  *: factory
    return

  open: method = .raglibrary
    arg path = .string, access = .string, config_id = .string
    return .fixturelibrary(path, access, config_id)

_trace: procedure = .ragtrace
  plan = .string[]
  notes = .string[]
  plan[1] = "lexical"
  notes[1] = "contract fixture"
  return .ragtrace("trace-1", plan, notes)

_passages: procedure = .ragpassage[]
  passages = .ragpassage[]
  citation = .ragcitation("fixture://source@r1#b0-8", "fixture://source", "r1", 0, 8)
  channels = .string[]
  channels[1] = "lexical"
  scores = .ragscore[]
  scores[1] = .ragscore("rrf", 0.75)
  passages[1] = .ragpassage(citation, "Fixture", "Gateway uses Store.", "document", 1.0, "2026-08-04T00:00:00Z", "2026-01-01", "", "source-passage", "direct", channels, scores)
  return passages

_evidence: procedure = .ragevidence
  arg question = .string, generated_answer = .string
  passages = _passages()
  support = .ragsupportcitation(passages[1].citation(), "positive", "asserted", "source", "independent")
  supports = .ragsupportcitation[]
  supports[1] = support
  confidence_breakdown = .ragscore[]
  confidence_breakdown[1] = .ragscore("support", 0.9)
  conflicts = .string[]
  claims = .ragacceptedclaim[]
  claims[1] = .ragacceptedclaim("claim-1", "Gateway", "depends_on", "Store", "subject-to-object", 0.9, "2026-01-01", "", "2026-08-04T00:00:00Z", supports, confidence_breakdown, conflicts)
  ambiguities = .string[]
  ambiguities[1] = "Gateway may refer to two deployments"
  lead_path = .string[]
  lead_path[1] = "Gateway"
  lead_path[2] = "Store"
  supporting_mentions = .string[]
  supporting_mentions[1] = "fixture://source@r1#b0-8"
  leads = .raggraphlead[]
  leads[1] = .raggraphlead(lead_path, "vector proximity", supporting_mentions, "discovery lead only")
  gaps = .string[]
  gaps[1] = "deployment owner is not evidenced"
  query_plan = .string[]
  query_plan[1] = "lexical:Gateway"
  return .ragevidence("crexx-rag.evidence/1", "fixture-library", 7, question, query_plan, passages, claims, ambiguities, leads, gaps, _trace(), "Use accepted claims only with their cited support.", generated_answer)

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "P2_01_FAIL=" || label
    return 1
  end
  return 0

main: procedure = .int
  arg args = .string[]
  cell = "unknown"
  if args.0 >= 1 then cell = args[1]
  errors = 0
  library_factory = .fixturelibraryfactory()
  library = library_factory.open("scratch-library", "read", "fixture-config")
  status = library.status()
  required_capabilities = status.required_capabilities()
  errors = errors + check(status.library_id() = "fixture-library" & status.read_only() = 1 & status.active_generation() = 7 & required_capabilities.0 = 1, "library status")

  request_options = .ragrequestoptions("fixture-profile", "", 10, 1)
  sources = .string[]
  sources[1] = "fixture://source"
  ingest_plan = library.planIngest(sources, request_options)
  improve_plan = library.planImprove(request_options)
  proposal_plan = library.planProposals("fixture proposal", request_options)
  errors = errors + check(ingest_plan.operation() = "ingest" & improve_plan.operation() = "improve" & proposal_plan.operation() = "proposals", "plan vocabulary")

  job = library.apply(ingest_plan, ingest_plan.digest())
  job_status = job.status()
  job_events = job.events("", 10)
  events = job_events.events()
  errors = errors + check(job_status.state() = "queued" & job_status.planned_total() = 1 & job_status.updated_at() \= "" & events.0 = 1, "job status and events")
  errors = errors + check(job.pause().ok() = 1 & job.resume().ok() = 1 & job.cancel().ok() = 1, "job control")

  search = library.search("Gateway", request_options)
  search_passages = search.passages()
  packet = library.evidence("What does Gateway use?", request_options)
  answer = library.answer("What does Gateway use?", request_options)
  packet_passages = packet.passages()
  claims = packet.claims()
  supports = claims[1].supports()
  confidence_breakdown = claims[1].confidence_breakdown()
  leads = packet.leads()
  gaps = packet.gaps()
  errors = errors + check(search_passages.0 = 1 & packet_passages.0 = 1, "passage contract")
  errors = errors + check(claims.0 = 1 & claims[1].direction() = "subject-to-object" & supports.0 = 1 & confidence_breakdown.0 = 1, "claim support contract")
  errors = errors + check(leads.0 = 1 & leads[1].limitation() = "discovery lead only" & gaps.0 = 1, "lead and gap contract")
  query_plan = packet.query_plan()
  errors = errors + check(packet.trace().trace_id() = "trace-1" & query_plan.0 = 1 & packet.answer_guidance() \= "" & answer.generated_answer() = "Fixture answer", "evidence trace and answer")

  path = library.path("Gateway", "Store", request_options)
  path_nodes = path.nodes()
  timeline = library.timeline(request_options)
  entries = timeline.entries()
  reviews = library.review("ambiguous", request_options)
  review_items = reviews.items()
  errors = errors + check(path_nodes.0 = 2 & entries.0 = 1 & review_items.0 = 1, "path timeline review")
  errors = errors + check(library.trace("Gateway", request_options).trace_id() = "trace-1" & library.close().ok() = 1, "trace and close")

  if errors \= 0 then do
    say "P2_01_ERRORS=" || errors
    return 1
  end
  say "P2_01_OK cell=" || cell || " levelg=1 modules=4 library_contract=1 job_contract=1 evidence_contract=1 typed_pages=1 directional_support=1"
  return 0
