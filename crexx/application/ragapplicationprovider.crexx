options levelg

namespace ragapplicationprovider expose ragapplicationprovider

import rxfnsb
import rxfs
import rxjson
import rxhash
import rxsqlite
import ragconfig
import ragprofile
import ragglossary
import ragcanonical
import ragenrich
import ragassessment
import ragprovenance
import raggrounding
import ragquotationcontract
import ragextractioncontract
import ragresolutioncontract
import ragresolutionreferences
import ragconfiguration
import ragstore
import ragclaims
import ragwork
import ragworktypes
import ragbacklog
import ragtrace
import provider_contract
import industrial_provider
import codex_provider

/* Product binding for the generic provider contract.  It owns RAG-shaped
 * request execution and validation; domain contracts own prompts and schemas.
 * industrial_provider remains reusable and
 * free of product vocabulary. */
ragapplicationprovider: class implements .ragworkprovider
  _store = .ragstorehandle
  _config = .ragconfig
  _profile = .ragprofile
  _tracer = .ragtracer
  _codex_backend = .codexprovider
  _codex_ready = .int
  _codex_directory = .string
  _health_error = .string

  *: factory
    arg store = .ragstorehandle, config = .ragconfig, profile = .ragprofile, tracer = .ragtracer
    _store = store; _config = config; _profile = profile; _tracer = tracer
    _codex_ready = 0; _codex_directory = ""
    return

  close: method = .void
    if _codex_ready = 1 then do
      call _codex_backend.close()
      if _codex_backend.health_error() \= "" then _health_error = _codex_backend.health_error()
      if _codex_directory \= "" then call rxfs..rmdir _codex_directory
    end
    _codex_ready = 0
    return

  health_error: method = .string
    return _health_error

  reconcile: method = .int
    arg job_id = .string, item_id = .string, apply = .int, expected_digest = .string, expose plan_json = .string, expose error = .string
    error = ""; plan_json = ""
    identity_json = readexternalidentity(_store,job_id,item_id)
    if identity_json = "" then do; error = "no durable Codex run for this job and item"; return -1; end
    identity = .jsondocument(identity_json); node = identity.root()
    attempt = _jsonstring(identity,node,"attempt")
    previous = readexternalobservation(_store,attempt)
    if previous \= "" then do
      plan_json = previous; previous_plan = .jsondocument(previous)
      if apply = 1 & expected_digest \= _jsonstring(previous_plan,previous_plan.root(),"digest") then do; error = "reconciliation digest does not match the applied observation"; return -1; end
      return 0
    end
    provider_config = _providerconfig(_config,_jsonstring(identity,node,"provider_id"))
    if provider_config.kind() \= "codex" | provider_config.model() \= _jsonstring(identity,node,"model") | provider_config.charging_basis() \= _jsonstring(identity,node,"charging_basis") then do; error = "reconciliation requires the original Codex provider route"; return -1; end
    /* Observation settles an existing turn, not a new request. Later source or
     * budget edits do not change its identity or its retained attempt policy. */
    thread_id = _jsonstring(identity,node,"thread_id"); turn_id = _jsonstring(identity,node,"turn_id"); request_id = _jsonstring(identity,node,"request_id")
    content = ""; state = "unavailable"; usage_complete = 0; detail = ""
    if _jsonstring(identity,node,"outcome") = "completed-unsettled" then do
      content = _jsonstring(identity,node,"content"); state = "completed"; usage_complete = _receiptint(identity,node,"usage_complete")
    end
    else if _ensurecodex(error) \= 0 then return -1
    else if _codex_backend.inspect_turn(thread_id,turn_id,provider_config.timeout_ms(),state,content,detail) \= 0 then state = "unavailable"
    if state = "completed" & content = "" then state = "completed-without-output"
    if (state = "interrupted" | state = "failed") & content \= "" then state = "terminal-with-output"
    input_tokens = _receiptint(identity,node,"input"); output_tokens = _receiptint(identity,node,"output")
    output = .providerresult()
    usage = .providerusage(input_tokens,output_tokens,1,-1,1,0)
    if state = "completed" then call output.set_generation("codex",provider_config.model(),request_id,content,"reconciled",usage,0)
    else call output.set_failure("codex",provider_config.model(),request_id,.providererror("reconciliation",-105,0,1,1,"observed Codex turn state: " || state),usage,0)
    receipt = _receiptjson(output,provider_config,request_id,_jsonstring(identity,node,"provider_run_id"))
    /* Completion may already have persisted the exact receipt before a crash.
     * Its original finish/usage fields are immutable and part of the digest. */
    if state = "completed" & _jsonstring(identity,node,"outcome") = "completed-unsettled" & _jsonstring(identity,node,"receipt") \= "" then receipt = _jsonstring(identity,node,"receipt")
    digest = rxhash..sha256hex((identity_json || "00"x || state || "00"x || usage_complete || "00"x || receipt) as .binary)
    plan_json = '{"schema":"crexx-rag.external-observation/1","job_id":' || jsonquote(job_id) || ',"item_id":' || jsonquote(item_id) || ',"attempt_id":' || jsonquote(attempt) || ',"provider_run_id":' || jsonquote(_jsonstring(identity,node,"provider_run_id")) || ',"thread_id":' || jsonquote(thread_id) || ',"turn_id":' || jsonquote(turn_id) || ',"state":' || jsonquote(state) || ',"content_sha256":' || jsonquote(rxhash..sha256hex(content as .binary)) || ',"known_input_tokens":' || input_tokens || ',"known_output_tokens":' || output_tokens || ',"usage_complete":' || usage_complete || ',"usage_basis":' || jsonquote("retained usage; incomplete values are lower bounds") || ',"provider_calls":0,"detail":' || jsonquote(detail) || ',"digest":' || jsonquote(digest) || '}'
    if apply = 0 then return 0
    if expected_digest \= digest then do; error = "reconciliation observation changed or digest is missing; inspect and apply the new digest"; return -1; end
    return applyexternalobservation(_store,identity_json,plan_json,receipt,_receiptint(identity,node,"maximum_attempts"),error)

  process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    result = _process(claim)
    if _codex_ready = 1 then call _codex_backend.end_operation()
    selected_provider = _providerconfig(_config,result.provider_id())
    if selected_provider.provider_id() = result.provider_id() then call result.set_attempt_limit(selected_provider.max_attempts())
    if result.worker_failure() \= "" then _health_error = result.worker_failure()
    if _codex_ready = 1 then if _codex_backend.health_error() \= "" then _health_error = _codex_backend.health_error()
    return result

  _process: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    empty_proposal = .ragextractionproposal
    if worksnapshotmatches(_store, claim.config_snapshot_id(), _config, _profile) \= 1 then return _failedwork("configuration", "snapshot-mismatch", claim, empty_proposal, "worker configuration does not match the durable job snapshot", 0)
    input_json = _iteminput(_store.database(), claim.item_id())
    if input_json = "" | rxhash..sha256hex(input_json as .binary) \= claim.input_hash() then return _failedwork("configuration", "input-mismatch", claim, empty_proposal, "durable work input is missing or does not match its digest", 0)
    document = .jsondocument(input_json)
    if document.valid() \= 1 | document.node_type(document.root()) \= "object" then return _failedwork("configuration", "input-invalid", claim, empty_proposal, "durable work input is not valid JSON", 0)
    root = document.root(); schema = _jsonstring(document, root, "schema"); operation = _jsonstring(document, root, "operation"); role = _jsonstring(document, root, "role"); provider_id = _jsonstring(document, root, "provider_id"); model = _jsonstring(document, root, "model"); privacy = _jsonstring(document, root, "privacy"); charging_basis = _jsonstring(document, root, "charging_basis"); snapshot_id = _jsonstring(document, root, "config_snapshot_id")
    if schema \= "crexx-rag.work-input/1" | operation \= claim.item_type() | role = "" | provider_id = "" | model = "" | privacy = "" | snapshot_id \= claim.config_snapshot_id() then return _failedwork("configuration", "input-shape", claim, empty_proposal, "durable work input fields do not match the claimed item", 0)
    if _roleprovider(_config, role) \= provider_id then return _failedwork(provider_id, model, claim, empty_proposal, "durable provider route does not match current role binding", 0)
    provider_config = _providerconfig(_config, provider_id)
    if provider_config.provider_id() \= provider_id | provider_config.model() \= model | provider_config.charging_basis() \= charging_basis then return _failedwork(provider_id, model, claim, empty_proposal, "provider configuration does not match durable work", 0)
    kind = provider_config.kind()
    if kind \= "gemini" & kind \= "openai" & kind \= "openai-compatible" & kind \= "anthropic" & kind \= "codex" then return _failedwork(provider_id, model, claim, empty_proposal, "provider kind is unsupported", 0)
    receipt_body = ""; original_attempt = ""; receipt_error = ""
    receipt_state = recoverproviderresponse(_store,claim,receipt_body,original_attempt,receipt_error)
    if receipt_state < 0 | receipt_state = 2 then return _failedwork(provider_id,model,claim,empty_proposal,"provider request requires receipt reconciliation: " || receipt_error,0)
    if receipt_state = 1 then do
      cached_backend = .provider
      if operation = "embedding" then return _embedding(document,root,claim,provider_config,cached_backend,receipt_body)
      return _extraction(document,root,input_json,claim,provider_config,cached_backend,receipt_body)
    end
    if operation = "embedding" then do
      cached_embedding = _cachedembedding(document,root,claim,provider_config)
      if cached_embedding.provider_id() = provider_id then return cached_embedding
    end
    secret = ""; credential = provider_config.credential()
    if credential.empty() = 0 then secret = getenv(credential.name())
    if (provider_config.route_class() = "hosted" & kind \= "codex" & secret = "") | pos("0A"x, secret) > 0 | pos("0D"x, secret) > 0 then return _failedwork(provider_id, model, claim, empty_proposal, "provider credential reference is unavailable or invalid", 0)
    backend = .provider
    if kind = "codex" then do
      codex_error = ""
      if _ensurecodex(codex_error) \= 0 then return _failedwork(provider_id, model, claim, empty_proposal, codex_error, 0)
      backend = _codex_backend
    end
    else do
      host = ""; base_path = ""; port = 0; tls = 0
      if _parseurl(provider_config.base_url(), host, port, tls, base_path) \= 0 then return _failedwork(provider_id, model, claim, empty_proposal, "provider base URL is invalid", 0)
      protocol = kind
      backend = .industrialprovider(protocol, host, port, tls, base_path, secret, provider_config.route_class(), provider_config.input_price_microunits_per_million(), provider_config.output_price_microunits_per_million(), provider_config.maximum_batch_size())
    end
    if operation = "embedding" & kind = "codex" then return _failedwork(provider_id, model, claim, empty_proposal, "Codex does not provide embedding generation", 0)
    if operation \= "embedding" & operation \= "claim-extraction" & operation \= "improve-extraction" & operation \= "maintenance-resolution" then return _failedwork(provider_id, model, claim, empty_proposal, "durable work operation is unsupported", 0)
    reserved_tokens = _reservationtokens(document, root)
    if reserved_tokens < 0 then return _failedwork(provider_id, model, claim, empty_proposal, "durable provider token reservation is invalid", 0)
    admission_id = ""; admission_wait = 0; admission_error = ""
    admission_status = admitprovidercall(_store, claim, provider_id, model, reserved_tokens, provider_config.requests_per_minute(), provider_config.tokens_per_minute(), provider_config.concurrent_requests(), provider_config.timeout_ms(), admission_id, admission_wait, admission_error)
    if admission_status \= 0 then do
      uncalled_wait = admission_status = 1 | sqlitebusyerror(admission_error) = 1
      deferred = _failedwork(provider_id, model, claim, empty_proposal, admission_error, uncalled_wait, "", provider_config.charging_basis(), max(1000,admission_wait))
      if uncalled_wait = 1 then call deferred.set_admission_deferred()
      return deferred
    end
    call _tracer.emit("provider", "start", claim.item_id(), provider_id || " " || model)
    processing_started=time("us") as .int
    if operation = "embedding" then result = _embedding(document, root, claim, provider_config, backend)
    else if operation = "claim-extraction" | operation = "improve-extraction" | operation = "maintenance-resolution" then result = _extraction(document, root, input_json, claim, provider_config, backend)
    processing_finished=time("us") as .int
    processing_elapsed=processing_finished-processing_started
    if processing_elapsed<0 then processing_elapsed=processing_elapsed+86400000000
    /* Include preflight, submission and exact-turn observation on every called
     * outcome. Retained/reused measured time must never be replaced by zero. */
    processing_ms=(processing_elapsed/1000) as .int
    if result.provider_called()=1 then call result.add_wait_ms(max(0,processing_ms-result.duration_ms()))
    call result.set_attempt_limit(provider_config.max_attempts())
    call result.add_wait_ms(admission_wait)
    release_outcome = "failed"; if result.ok() = 1 then release_outcome = "succeeded"
    release_error = ""
    cooldown_delay = 0
    if result.retryable() = 1 & (result.provider_called() = 1 | (result.worker_failure() \= "" & result.outcome_uncertain() = 0)) then cooldown_delay = result.retry_delay_ms()
    if releaseprovidercall(_store, admission_id, result.input_tokens() + result.output_tokens(), release_outcome, release_error, cooldown_delay, provider_config.initial_backoff_ms(), provider_config.maximum_backoff_ms()) \= 0 then result = _admissionfailure(result, release_error)
    if result.ok() = 1 then call _tracer.emit("provider", "complete", claim.item_id(), provider_id || " " || model)
    else call _tracer.emit("provider", "failed", claim.item_id(), provider_id || " " || model)
    return result

  _extraction: method = .ragworkproviderresult
    arg document = .jsondocument, root = .int, input_json = .string, claim = .ragworkclaim, provider_config = .ragproviderconfig, backend = .provider, receipt_body = ""
    empty_proposal = .ragextractionproposal
    messages = .providermessage[]; inputs = .string[]
    role_name = _jsonstring(document,root,"role"); if role_name = "" then role_name = "extractor"
    role_policy = rolebinding(_config,role_name)
    if role_policy.provider_id() \= provider_config.provider_id() | role_policy.system_prompt() = "" then return _failedwork(provider_config.provider_id(), provider_config.model(), claim, empty_proposal, "configured extraction role policy is unavailable", 0)
    discovery=_config.discovery()
    messages=extractionmessages(_profile,discovery,input_json,role_policy.system_prompt())
    schema=extractionresponseschema(_profile)
    contract = _jsonstring(document,root,"provenance_contract"); enriched = contract = "crexx-rag.support-assessment/1"
    if contract \= "" & enriched = 0 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"unsupported durable provenance contract",0)
    source_metadata = _jsonstring(document,root,"source_metadata"); current_generation = 0
    if enriched then do
      context_query = .binary
      if sqliteprepare(_store.database(),"SELECT published_generation FROM library_meta WHERE singleton=1",context_query)=0 then do; if sqlitestep(context_query)=100 then ignored=sqlitecolumnint(context_query,0,current_generation); call sqlitefinalize context_query; end
      if source_metadata \= provenancecontext(_store.database(),_jsonstring(document,root,"revision_chunk_id"),current_generation) then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"source metadata changed; re-plan before making a provider call",0)
      messages=extractionmessages(_profile,discovery,input_json,role_policy.system_prompt(),1)
      schema = enrichextractionschema(_store.database(),schema)
      if schema = "" then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"cannot construct enriched response schema",0)
    end
    resolution_work = claim.item_type() = "maintenance-resolution"
    if resolution_work then do
      evidence_node = document.member(root,"evidence")
      subject_node = document.member(evidence_node,"subject")
      subject_type = _jsonstring(document,subject_node,"type")
      workflow = document.node_count(document.member(evidence_node,"successors")) > 0
      if document.member(root,"workflow_id")>0 then workflow=_jsonstring(document,root,"workflow_id")<>""
      objective = _jsonstring(document,root,"resolution_prompt"); if objective = "" then objective = _config.maintenance().resolution_prompt()
      messages=resolutionmessages(_profile,input_json,objective,subject_type)
      schema=resolutionresponseschema(subject_type,workflow)
      frozen_prompt=_jsonstring(document,root,"prompt_sha256"); frozen_schema=_jsonstring(document,root,"schema_sha256")
      if frozen_prompt<>"" & frozen_prompt<>rxhash..sha256hex(messages[1].content() as .binary) then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"resolution prompt identity changed; reset/re-plan the task",0)
      if frozen_schema<>"" & frozen_schema<>rxhash..sha256hex(schema as .binary) then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"resolution schema identity changed; reset/re-plan the task",0)
    end
    request_id = "extract-" || substr(rxhash..sha256hex(claim.attempt_id() as .binary), 1, 32)
    reservation = document.member(root, "reservation"); maximum_output = -1
    if document.node_type(reservation) \= "object" | document.node_int(document.member(reservation, "output_tokens"), maximum_output) \= 0 | maximum_output < 1 then return _failedwork(provider_config.provider_id(), provider_config.model(), claim, empty_proposal, "durable extraction output reservation is invalid", 0)
    if maximum_output > role_policy.maximum_output_tokens() then return _failedwork(provider_config.provider_id(), provider_config.model(), claim, empty_proposal, "durable extraction output reservation exceeds the configured role envelope", 0)
    previous_response = ""; correction_feedback = ""
    correction = citationcorrectioncontext(_store,claim,previous_response,correction_feedback)
    if correction < 0 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"citation correction context is unavailable",0)
    if correction = 1 then do
      messages[3] = .providermessage("assistant",previous_response)
      correction_instruction=correctionmessage(correction_feedback)
      if resolution_work then correction_instruction=resolutioncorrectionmessage(input_json,correction_feedback)
      messages[4]=.providermessage("user",correction_instruction)
      maximum_input = 0
      ignored = document.node_int(document.member(reservation,"input_tokens"),maximum_input)
      request_bytes = binlength(schema as .binary)
      do m = 1 to messages.0
        request_bytes = request_bytes + binlength(messages[m].content() as .binary)
      end
      /* Retain the existing conservative input-envelope estimate and caps. */
      if request_bytes > maximum_input * 3 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"citation correction exceeds the reviewed input envelope",0)
    end
    if resolution_work then do
      maximum_input=0; ignored=document.node_int(document.member(reservation,"input_tokens"),maximum_input)
      request_bytes=binlength(schema as .binary)
      do m=1 to messages.0
        request_bytes=request_bytes+binlength(messages[m].content() as .binary)
      end
      if maximum_input<1 | request_bytes>maximum_input*3 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"resolution request exceeds its input envelope; refresh a smaller evidence bundle or adjust policy and reset",0)
    end
    request = .providerrequest("generate_structured", role_name, provider_config.model(), messages, inputs, schema, provider_config.timeout_ms(), 1, _jsonstring(document, root, "privacy"), claim.item_id(), request_id, maximum_output, 0, 0, role_policy.temperature_millionths(), provider_config.initial_backoff_ms(), provider_config.maximum_backoff_ms(), provider_config.jitter_ms(), provider_config.reasoning_effort())
    durable_run_id = ""; provider_charging_basis = provider_config.charging_basis(); provider_output = .providerresult(); terminal_observed = 0; observation = ""; recovered_usage_complete = -1
    if receipt_body \= "" then do
      provider_output = _receiptoutput(receipt_body); receipt_document = .jsondocument(receipt_body)
      request_id = _jsonstring(receipt_document,receipt_document.root(),"expected_request_id")
      durable_run_id = _jsonstring(receipt_document,receipt_document.root(),"provider_run_id")
    end
    else if provider_config.kind() = "codex" then do
      provider_charging_basis = "local-compute"
      now_epoch = _databaseepoch(_store.database())
      call _codex_backend.begin_operation(min(provider_config.timeout_ms(),max(1,(claim.lease_until()-now_epoch-5)*1000)))
      recovery = .ragexternalrecovery; codex_error = ""; active_request = request
      if recoverexternalrun(_store, claim.item_id(), provider_config.provider_id(), provider_config.model(), recovery, codex_error) \= 0 then provider_output = _codexfailure(request, codex_error, 0, "durability")
      else if recovery.found() = 1 then do
        durable_run_id = recovery.provider_run_id(); provider_charging_basis = provider_config.charging_basis(); request_id = recovery.request_id()
        active_request = .providerrequest(request.operation(), request.role(), request.model(), request.messages(), request.inputs(), request.schema(), request.timeout_ms(), request.max_attempts(), request.privacy_class(), request.idempotency_key(), request_id, request.max_output_tokens(), request.embedding_dimensions(), request.stream_requested(), request.temperature_millionths(), request.initial_backoff_ms(), request.maximum_backoff_ms(), request.jitter_ms(), request.reasoning_effort())
        if recovery.state() = "completed" then do
          provider_output = .providerresult()
          call provider_output.set_generation("codex", provider_config.model(), request_id, recovery.content(), "recovered", .providerusage(recovery.input_tokens(), recovery.output_tokens(), 1, -1, 1, 0), 0)
          call _tracer.emit("codex", "recovered", claim.item_id(), "reusing persisted completed output")
          call _finishcodexthread(recovery.thread_id(), provider_config.timeout_ms())
        end
        else if recovery.turn_id() = "" then do
          provider_output = _codexfailure(active_request, "persisted Codex thread has no confirmed turn identity; inspect before retry", 0, "reconciliation")
        end
        else do
          provider_output = _codex_backend.recover_structured(active_request, recovery.thread_id(), recovery.turn_id(), recovery.input_tokens(), recovery.output_tokens())
          if provider_output.status() = 0 then do
            if completeexternalrun(_store, durable_run_id, recovery.thread_id(), recovery.turn_id(), request_id, provider_output.content(), recovery.input_tokens(), recovery.output_tokens(), codex_error) \= 0 then provider_output = _codexfailure(active_request, "Codex recovered output durability failed: " || codex_error, 0, "durability")
            else call _finishcodexthread(recovery.thread_id(), provider_config.timeout_ms())
          end
        end
      end
      else do
        account_type = ""; plan_type = ""; allowance_used = -1
        call _tracer.emit("codex", "preflight", claim.item_id(), "checking managed account allowance")
        if _codex_backend.account_status(provider_config.timeout_ms(), account_type, plan_type, allowance_used, codex_error) \= 0 then provider_output = _codexfailure(request, "Codex allowance preflight failed: " || codex_error, 1, "transport")
        else if 100 - allowance_used < _config.budget().minimum_codex_allowance_percent() then provider_output = _codexfailure(request, "Codex remaining allowance is below the reviewed minimum", 0, "budget")
        else do
          call _tracer.emit("codex", "durable", claim.item_id(), "preparing persisted thread and turn identities")
          thread_id = ""; turn_id = ""
          if _codex_backend.start_thread(request, thread_id, codex_error) \= 0 then provider_output = _codexfailure(request, "Codex thread start failed: " || codex_error, 1, "transport")
          else if beginexternalrun(_store, claim, provider_config.provider_id(), provider_config.model(), request_id, provider_config.charging_basis(), thread_id, allowance_used, durable_run_id, codex_error,_requestjson(request,provider_config,claim,input_json)) \= 0 then do
            call _codex_backend.delete_thread(thread_id, provider_config.timeout_ms())
            provider_output = _codexfailure(request, "Codex thread durability failed: " || codex_error, 0, "durability")
          end
          else do
            provider_charging_basis = provider_config.charging_basis()
            call _codex_backend.observe(.ragcodexusageobserver(_store,durable_run_id))
            if _codex_backend.start_structured_turn(request, thread_id, turn_id, codex_error) \= 0 then do
              provider_output = _codexfailure(request, "Codex turn start failed: " || codex_error, 1, "transport")
            end
            else if updateexternalrunturn(_store, durable_run_id, thread_id, turn_id, codex_error) \= 0 then do
              provider_output = _codexfailure(request, "Codex turn durability failed: " || codex_error, 0, "durability")
            end
            else do
              call _tracer.emit("codex", "running", claim.item_id(), "contained structured extraction started")
              provider_output = _codex_backend.wait_structured(request, thread_id, turn_id)
              /* Observe the exact submitted turn once through a fresh bounded
               * transport. Unknown history holds this item; it cannot drain peers. */
              if provider_output.status() \= 0 & _codex_backend.health_error() \= "" then do
                original_failure=provider_output.error();original_elapsed=provider_output.latency_us()
                observed_state = ""; observed_content = ""; observed_error = ""
                observation_timeout = min(5000,provider_config.timeout_ms(),max(1,(claim.lease_until()-_databaseepoch(_store.database())-5)*1000))
                observed_status = _codex_backend.inspect_turn_fresh(thread_id,turn_id,observation_timeout,observed_state,observed_content,observed_error)
                if observed_status = 0 then do
                  usage = provider_output.usage()
                  if observed_state = "completed" & observed_content \= "" then do
                    validation = validatestructuredresponse(observed_content,request.schema())
                    provider_output = .providerresult()
                    if validation.code() = 0 then call provider_output.set_generation("codex",request.model(),request_id,observed_content,"recovered",usage,original_elapsed)
                    else call provider_output.set_failure("codex",request.model(),request_id,validation,usage,original_elapsed)
                    terminal_observed = 1
                  end
                  else if (observed_state = "interrupted" | observed_state = "failed") & observed_content = "" then do
                    provider_output = .providerresult()
                    call provider_output.set_failure("codex",request.model(),request_id,.providererror(original_failure.category(),original_failure.code(),original_failure.http_status(),1,1,original_failure.message() || "; confirmed Codex turn " || observed_state),usage,original_elapsed)
                    terminal_observed = 1
                  end
                  if terminal_observed = 1 then do
                    recovered_usage_complete = 0
                    observation = '{"attempt_id":' || jsonquote(claim.attempt_id()) || ',"state":' || jsonquote(observed_state) || ',"thread_id":' || jsonquote(thread_id) || ',"turn_id":' || jsonquote(turn_id) || ',"usage_complete":0}'
                    call _tracer.emit("codex","observed",claim.item_id(),observed_state)
                    if provider_output.status() \= 0 then do
                      receipt_body = _receiptjson(provider_output,provider_config,request_id,durable_run_id)
                      if recordproviderresponse(_store,claim,receipt_body,codex_error,observation) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,codex_error,durable_run_id)
                    end
                  end
                end
              end
              if provider_output.status() = 0 then do
                usage = provider_output.usage()
                if completeexternalrun(_store, durable_run_id, thread_id, turn_id, request_id, provider_output.content(), usage.input_tokens(), usage.output_tokens(), codex_error,recovered_usage_complete) \= 0 then provider_output = _codexfailure(request, "Codex output durability failed: " || codex_error, 0, "durability")
                else do
                  receipt_body = _receiptjson(provider_output,provider_config,request_id,durable_run_id)
                  if recordproviderresponse(_store,claim,receipt_body,codex_error,observation) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,codex_error,durable_run_id)
                  call _tracer.emit("codex", "persisted", claim.item_id(), "validated output and usage committed")
                  /* Actual usage is durable. The next required preflight reads
                   * current allowance; do not add a second account refresh here. */
                  call _finishcodexthread(thread_id,provider_config.timeout_ms())
                end
              end
            end
          end
        end
      end
    end
    else do
      receipt_error = ""
      if beginproviderrequest(_store,claim,request_id,receipt_error,_requestjson(request,provider_config,claim,input_json)) \= 0 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,receipt_error,0)
      provider_output = backend.generate_structured(request)
      receipt_body = _receiptjson(provider_output,provider_config,request_id)
      if recordproviderresponse(_store,claim,receipt_body,receipt_error) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,receipt_error)
      receipt_document = .jsondocument(receipt_body); omitted = _jsonstring(receipt_document,receipt_document.root(),"omitted")
      if omitted \= "" then return _failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider receipt content omitted: " || omitted)
      provider_output = _receiptoutput(receipt_body)
    end
    /* Codex owns a durable thread/turn intent before dispatch. Keep its
     * completed envelope after settlement too, for failed-publication replay. */
    if provider_config.kind() = "codex" & provider_output.status() = 0 & receipt_body = "" then do
      receipt_error = ""
      if beginproviderrequest(_store,claim,request_id,receipt_error) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,receipt_error,durable_run_id)
      receipt_body = _receiptjson(provider_output,provider_config,request_id,durable_run_id)
      if recordproviderresponse(_store,claim,receipt_body,receipt_error) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,receipt_error,durable_run_id)
      receipt_document = .jsondocument(receipt_body); omitted = _jsonstring(receipt_document,receipt_document.root(),"omitted")
      if omitted \= "" then return _failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider receipt content omitted: " || omitted,durable_run_id)
      provider_output = _receiptoutput(receipt_body)
    end
    if provider_output.status() \= 0 then do
      failed_result = _providerfailure(provider_config,request_id,claim,empty_proposal,provider_output,durable_run_id,provider_charging_basis)
      if provider_config.kind() = "codex" then do
        if durable_run_id = "" then do
          failed_result = _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,provider_output.error().message(),provider_output.error().retryable(),"",provider_charging_basis,provider_config.initial_backoff_ms())
          if provider_output.error().retryable() = 1 then call failed_result.set_admission_deferred()
        end
        if durable_run_id \= "" & terminal_observed = 0 then call failed_result.set_worker_failure("Codex response is unavailable; recover the retained turn or explicitly retry",1)
        if _codex_backend.health_error() \= "" then call failed_result.set_worker_failure(_codex_backend.health_error(),durable_run_id \= "" & terminal_observed = 0)
      end
      call failed_result.set_diagnostic(_receiptjson(provider_output,provider_config,request_id,durable_run_id))
      return failed_result
    end
    /* Generation adapters retain the server response identity; it need not
     * equal our client request identity. The durable intent binds that client
     * identity to this item and input, and the receipt retains both values. */
    if provider_output.provider() \= _backendidentity(provider_config.kind()) | provider_output.model() \= provider_config.model() | provider_output.request_id() = "" then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider returned incomplete provider/model identity", durable_run_id)
    if resolution_work then do
      grounding_json = ""; resolution_error = ""
      references=.ragresolutionreferences(input_json)
      canonical_response=references.response(provider_output.content(),resolution_error)
      if resolution_error<>"" then do
        resolution_error=_redactfeedback(provider_config,resolution_error)
        failed_result=_failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,resolution_error,durable_run_id,1)
        if left(resolution_error,23)="resolution reference is" then call failed_result.set_citation_failure(resolution_error)
        return failed_result
      end
      if validatebacklogresponse(_store.database(), _jsonstring(document,root,"task_id"), canonical_response, grounding_json, resolution_error,input_json) \= 0 then do
        failed_result=_failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,resolution_error,durable_run_id,1)
        if failed_result.citation_failure()<>"" then call failed_result.set_citation_failure(_redactfeedback(provider_config,resolution_error || "0A"x || resolutionquotationfeedback(references.input(),provider_output.content())))
        return failed_result
      end
      usage = provider_output.usage(); cost = usage.cost_microunits(); if cost < 0 | provider_charging_basis \= "monetary-api" then cost = 0
      mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
      result = .ragworkproviderresult(0, provider_config.provider_id(), provider_config.model(), request_id, usage.input_tokens(), usage.output_tokens(), cost, (provider_output.latency_us() / 1000) as .int, 0, empty_proposal, "", 0, "", "", .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), durable_run_id, provider_charging_basis, mentions, proposals, notes)
      call result.resolution(canonical_response, _profile)
      return result
    end
    response = .jsondocument(provider_output.content())
    if response.valid() \= 1 | response.node_type(response.root()) \= "object" then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider claim proposal is not an object", durable_run_id, 1)
    response_root = response.root()
    mentions_node = response.member(response_root, "mentions"); relationships_node = response.member(response_root, "relationships"); notes_node = response.member(response_root, "notes")
    if response.node_count(response_root) \= 3 | response.node_type(mentions_node) \= "array" | response.node_type(relationships_node) \= "array" | response.node_type(notes_node) \= "array" | response.node_count(mentions_node) > discovery.max_mentions() | response.node_count(relationships_node) > discovery.max_relationships() | response.node_count(notes_node) > discovery.max_notes() then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider discovery arrays violate the reviewed bounds", durable_run_id, 1)
    revision_chunk_id = _jsonstring(document, root, "revision_chunk_id"); body = _jsonstring(document, root, "text"); prompt_version = _jsonstring(document, root, "prompt_version"); profile_id = _jsonstring(document, root, "profile_id"); source_scope = _jsonstring(document, root, "source_scope"); discovery_context = _jsonstring(document, root, "discovery_context")
    body_binary = body as .binary; body_bytes = binlength(body_binary); work_mentions = .ragworkmention[]
    grounding = .raggrounding(body); mention_labels = .string[]; mention_count = response.node_count(mentions_node)
    do i = 1 to response.node_count(mentions_node)
      node = response.element(mentions_node, i); label = ""; canonical_label = ""; concept_type = ""; span_start = -1; span_end = -1; quotation = ""
      aliases_node = response.member(node, "aliases")
      if response.node_type(node) \= "object" | response.node_count(node) \= 5 | response.node_string(response.member(node, "label"), label) \= 0 | response.node_string(response.member(node, "canonical_label"), canonical_label) \= 0 | response.node_string(response.member(node, "concept_type"), concept_type) \= 0 | response.node_string(response.member(node, "evidence_quote"), quotation) \= 0 | response.node_type(aliases_node) \= "array" | response.node_count(aliases_node) > 16 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider mention shape is invalid", durable_run_id, 1)
      if label = "" | canonical_label = "" | length(label) > 512 | length(canonical_label) > 512 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider mention label is invalid", durable_run_id, 1)
      if _permittedtype(_profile, concept_type) \= 1 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider mention concept type is not in the selected profile", durable_run_id, 1)
      quote_start = -1; quote_end = -1
      if grounding.find(quotation, quote_start, quote_end) \= 1 then return _citationoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider mention evidence quotation is not in the chunk",durable_run_id,"mentions[" || (i-1) || "].evidence_quote",quotation,"",body)
      if grounding.find(label, span_start, span_end, quote_start, quote_end) \= 1 then return _citationoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider mention label is not in its evidence quotation",durable_run_id,"mentions[" || (i-1) || "].evidence_quote",quotation,"Required literal label: " || jsonquote(label),body)
      mention_labels[i] = label
      aliases = .string[]; aliases[1] = canonical_label
      do a = 1 to response.node_count(aliases_node)
        alias = ""
        if response.node_string(response.element(aliases_node, a), alias) \= 0 | alias = "" | length(alias) > 512 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider alias is invalid", durable_run_id, 1)
        if _containslower(aliases, alias) = 0 then aliases[aliases.0 + 1] = alias
      end
      glossary_error = ""
      if validateglossarymention(discovery_context, label, canonical_label, concept_type, aliases, glossary_error) \= 1 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, glossary_error, durable_run_id, 1)
      resolved_label = canonical_label; resolved_id = ""; resolution_error = ""
      candidate_id = _mentioncandidate(revision_chunk_id, span_start, span_end, canonical_label, concept_type)
      known = resolveknownmention(_store.database(),candidate_id,resolved_label,concept_type,resolved_id,resolution_error)
      if known = 0 then known = resolveknownconcept(_store.database(),canonical_label,concept_type,resolved_label,resolved_id,resolution_error)
      if known < 0 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, resolution_error, durable_run_id)
      if resolved_id \= "" then do
        canonical_label = resolved_label
        if validateglossarymention(discovery_context, label, canonical_label, concept_type, aliases, glossary_error) \= 1 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, glossary_error, durable_run_id, 1)
      end
      work_mentions[i] = .ragworkmention(candidate_id, canonical_label, concept_type, span_start, span_end, aliases, resolved_id)
    end
    relationship_fields = 5
    if enriched then relationship_fields = 6
    work_proposals = .ragworkproposal[]
    do i = 1 to response.node_count(relationships_node)
      node = response.element(relationships_node, i); source_index = -1; target_index = -1; relationship = ""; span_start = -1; span_end = -1; confidence = -1; quotation = ""
      if response.node_type(node) \= "object" | response.node_count(node) \= relationship_fields | response.node_int(response.member(node, "source_mention"), source_index) \= 0 | response.node_string(response.member(node, "relationship_type"), relationship) \= 0 | response.node_int(response.member(node, "target_mention"), target_index) \= 0 | response.node_string(response.member(node, "evidence_quote"), quotation) \= 0 | response.node_int(response.member(node, "confidence_millionths"), confidence) \= 0 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider relationship shape is invalid", durable_run_id, 1)
      if source_index < 0 | target_index < 0 | source_index = target_index | source_index >= mention_count | target_index >= mention_count then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider relationship endpoints are invalid", durable_run_id, 1)
      if _permittedrelationship(_profile, relationship) \= 1 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider relationship type is not in the selected profile", durable_run_id, 1)
      if confidence < 0 | confidence > 1000000 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider relationship confidence is invalid", durable_run_id)
      if grounding.find(quotation, span_start, span_end) \= 1 then return _citationoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider relationship evidence quotation is not in the chunk",durable_run_id,"relationships[" || (i-1) || "].evidence_quote",quotation,"",body)
      source_start = -1; source_end = -1; target_start = -1; target_end = -1
      if grounding.find(mention_labels[source_index + 1], source_start, source_end, span_start, span_end) \= 1 | grounding.find(mention_labels[target_index + 1], target_start, target_end, span_start, span_end) \= 1 then return _citationoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider relationship quotation does not contain both endpoints",durable_run_id,"relationships[" || (i-1) || "].evidence_quote",quotation,"Required literal labels: " || jsonquote(mention_labels[source_index + 1]) || " and " || jsonquote(mention_labels[target_index + 1]),body)
      /* Anchor endpoints within this relationship's supporting quotation,
       * independent of an earlier occurrence selected for the mention. */
      original_source = work_mentions[source_index + 1]; original_target = work_mentions[target_index + 1]
      source_candidate = _mentioncandidate(revision_chunk_id, source_start, source_end, original_source.label(), original_source.concept_type())
      target_candidate = _mentioncandidate(revision_chunk_id, target_start, target_end, original_target.label(), original_target.concept_type())
      source_mention = .ragworkmention(source_candidate, original_source.label(), original_source.concept_type(), source_start, source_end, original_source.aliases(), original_source.concept_id())
      target_mention = .ragworkmention(target_candidate, original_target.label(), original_target.concept_type(), target_start, target_end, original_target.aliases(), original_target.concept_id())
      call _appendmention work_mentions, source_mention
      call _appendmention work_mentions, target_mention
      source_concept = source_mention.concept_id()
      target_concept = target_mention.concept_id()
      proposal_id = "proposal-sha256:" || rxhash..sha256hex((claim.input_hash() || "00"x || source_mention.candidate_id() || "00"x || relationship || "00"x || target_mention.candidate_id() || "00"x || span_start || "00"x || span_end || "00"x || request_id) as .binary)
      proposal = .ragextractionproposal("crexx-rag.extraction-proposal/1", proposal_id, "claim", source_concept, source_mention.label(), source_mention.concept_type(), relationship, target_concept, target_mention.label(), target_mention.concept_type(), "outbound", '{}', "", "", revision_chunk_id, span_start, span_end, "support", "assertion", "direct", "", "lineage:" || revision_chunk_id, confidence, provider_config.provider_id(), provider_config.model(), request_id, prompt_version, "crexx-rag-" || provider_config.kind() || "-adapter/3-quotes", source_scope, profile_id, 0)
      if enriched then do
        support_context = provenancecontext(_store.database(),revision_chunk_id,current_generation,span_start,span_end)
        assessment = .ragsupportassessment(response.node_get(response.member(node,"assessment")),body,support_context,quotation)
        if assessment.ok() = 0 then return _failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,assessment.error(),durable_run_id)
        proposal = .ragextractionproposal("crexx-rag.extraction-proposal/2",proposal_id,"claim",source_concept,source_mention.label(),source_mention.concept_type(),relationship,target_concept,target_mention.label(),target_mention.concept_type(),"outbound",assessment.qualifiers(),assessment.effective_from(),assessment.effective_to(),revision_chunk_id,span_start,span_end,assessment.polarity(),assessment.stance(),assessment.directness(),assessment.voice(),"lineage:" || revision_chunk_id,confidence,provider_config.provider_id(),provider_config.model(),request_id,prompt_version,"crexx-rag-" || provider_config.kind() || "-adapter/4-provenance:" || assessment.stance() || ":" || assessment.directness(),source_scope,profile_id,0,assessment.canonical())
      end
      work_proposals[work_proposals.0 + 1] = .ragworkproposal(proposal, source_mention.candidate_id(), target_mention.candidate_id())
    end
    work_notes = .ragworknote[]
    do i = 1 to response.node_count(notes_node)
      node = response.element(notes_node, i); kind = ""; note_text = ""; next_action = ""; importance = -1; uncertainty = -1; span_start = -1; span_end = -1; quotation = ""
      if response.node_type(node) \= "object" | response.node_count(node) \= 6 | response.node_string(response.member(node, "kind"), kind) \= 0 | response.node_string(response.member(node, "text"), note_text) \= 0 | response.node_int(response.member(node, "importance_millionths"), importance) \= 0 | response.node_int(response.member(node, "uncertainty_millionths"), uncertainty) \= 0 | response.node_string(response.member(node, "next_action"), next_action) \= 0 | response.node_string(response.member(node, "evidence_quote"), quotation) \= 0 | wordpos(kind, "observation insight hypothesis question gap conflict lead follow-up recommendation synonym split merge type-correction retire restore") = 0 | note_text = "" | length(note_text) > 4096 | length(next_action) > 16384 | importance < 0 | importance > 1000000 | uncertainty < 0 | uncertainty > 1000000 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider analysis note is invalid or ungrounded", durable_run_id)
      if grounding.find(quotation, span_start, span_end) \= 1 then return _citationoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider analysis note quotation is not in the chunk",durable_run_id,"notes[" || (i-1) || "].evidence_quote",quotation,"",body)
      if wordpos(kind, "synonym split merge type-correction retire restore") > 0 & _validlifecycleaction(next_action, kind) \= 1 then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider lifecycle note does not contain an exact executable maintenance action", durable_run_id)
      work_notes[work_notes.0 + 1] = .ragworknote(kind, note_text, importance, uncertainty, next_action, span_start, span_end)
    end
    return _successbatch(provider_config.provider_id(), provider_config.model(), request_id, provider_output, work_mentions, work_proposals, work_notes, durable_run_id, provider_config.charging_basis())

  _finishcodexthread: method = .void
    arg thread_id = .string, timeout_ms = .int
    /* A required transport failure retains its existing recovery classification.
     * Optional history cleanup cannot poison a successfully completed item. */
    if _codex_backend.health_error() \= "" then return
    if _codex_backend.delete_thread(thread_id,timeout_ms) = 0 then return
    call _tracer.emit("codex","cleanup",thread_id,"history cleanup unavailable; completed output retained")
    call _codex_backend.close()
    if _codex_directory \= "" then call rxfs..rmdir _codex_directory
    _codex_ready = 0; _codex_directory = ""
    return

  _ensurecodex: method = .int
    arg expose error = .string
    error = ""
    if _codex_ready = 1 then return 0
    executable = getenv("CREXXRAG_CODEX")
    if executable = "" & rxfs..isfile("/Applications/ChatGPT.app/Contents/Resources/codex") = 1 then executable = "/Applications/ChatGPT.app/Contents/Resources/codex"
    if executable = "" then do; error = "Codex executable is unavailable; set CREXXRAG_CODEX or install the Codex app"; return -1; end
    suffix = _randomhex(_store.database())
    if suffix = "" then do; error = "cannot allocate an isolated Codex working directory"; return -1; end
    temporary_root = getenv("TMPDIR"); if temporary_root = "" then temporary_root = "/tmp/"
    if right(temporary_root, 1) \= "/" then temporary_root = temporary_root || "/"
    _codex_directory = temporary_root || "crexxrag-codex-" || suffix
    if rxfs..mkdir(_codex_directory) \= 0 then do; error = "cannot create the isolated Codex working directory"; return -1; end
    observer = .codexnoopobserver()
    _codex_backend = .codexprovider(executable, _codex_directory, observer)
    _codex_ready = 1
    return 0

  _cachedembedding: method = .ragworkproviderresult
    arg document = .jsondocument, root = .int, claim = .ragworkclaim, config = .ragproviderconfig
    empty_proposal = .ragextractionproposal
    empty_mentions = .ragworkmention[]; empty_proposals = .ragworkproposal[]; empty_notes = .ragworknote[]
    empty_result = .ragworkproviderresult(1,"","","",0,0,0,0,0,empty_proposal,"cache miss",0,"","",.ragworkembedding("","","","","",0,"",''x as .binary),"","local-compute",empty_mentions,empty_proposals,empty_notes,0,0)
    dimension = rolebinding(_config,"embedding").embedding_dimensions()
    input_dimension = 0; ignored = document.node_int(document.member(root,"embedding_dimension"),input_dimension)
    if _jsonstring(document,root,"text") = "" | _jsonstring(document,root,"revision_chunk_id") = "" | length(_jsonstring(document,root,"content_digest")) \= 64 | input_dimension \= dimension | rolebinding(_config,"embedding").provider_id() \= config.provider_id() then return _failedwork(config.provider_id(),config.model(),claim,empty_proposal,"durable embedding input is invalid",0)
    envelope = "crexx-rag.embedding-input/1|" || config.provider_id() || "|" || config.kind() || "|" || config.model() || "|" || dimension
    profile_id = "embedding-" || dimension || "-" || substr(rxhash..sha256hex(envelope as .binary),1,12)
    digest = rxhash..sha256hex((_jsonstring(document,root,"content_digest") || "00"x || envelope) as .binary)
    prepared = .binary
    if sqliteprepare(_store.database(),"SELECT vector FROM embeddings WHERE embedding_profile_id=?1 AND input_digest=?2 AND dimension=?3",prepared) \= 0 then return _failedwork(config.provider_id(),config.model(),claim,empty_proposal,"cannot read embedding cache",0)
    binds = sqlitebindtext(prepared,1,profile_id) | sqlitebindtext(prepared,2,digest) | sqlitebindint(prepared,3,dimension)
    payload = ''x as .binary; step = sqlitestep(prepared)
    if binds \= 0 | (step \= 100 & step \= 101) then do; call sqlitefinalize prepared; return _failedwork(config.provider_id(),config.model(),claim,empty_proposal,"cannot read embedding cache",0); end
    if step = 101 then do; call sqlitefinalize prepared; return empty_result; end
    status = sqlitecolumnblob(prepared,0,payload); call sqlitefinalize prepared
    if status \= 0 | binlength(payload) \= dimension*4 then return _failedwork(config.provider_id(),config.model(),claim,empty_proposal,"stored embedding cache payload is invalid",0)
    embedding = .ragworkembedding(_jsonstring(document,root,"revision_chunk_id"),profile_id,digest,config.provider_id(),config.model(),dimension,rxhash..sha256hex(envelope as .binary),payload)
    proposal = .ragextractionproposal; mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
    return .ragworkproviderresult(0,config.provider_id(),config.model(),"cached-" || claim.attempt_id(),0,0,0,0,0,proposal,"",0,"","",embedding,"",config.charging_basis(),mentions,proposals,notes,0,0)

  _embedding: method = .ragworkproviderresult
    arg document = .jsondocument, root = .int, claim = .ragworkclaim, provider_config = .ragproviderconfig, backend = .provider, receipt_body = ""
    empty_proposal = .ragextractionproposal; messages = .providermessage[]; inputs = .string[]
    body = _jsonstring(document, root, "text"); revision_chunk_id = _jsonstring(document, root, "revision_chunk_id"); content_digest = _jsonstring(document, root, "content_digest")
    dimension = 0; ignored = document.node_int(document.member(root, "embedding_dimension"), dimension)
    role_policy = rolebinding(_config, "embedding")
    if body = "" | revision_chunk_id = "" | length(content_digest) \= 64 | role_policy.provider_id() \= provider_config.provider_id() | dimension \= role_policy.embedding_dimensions() then return _failedwork(provider_config.provider_id(), provider_config.model(), claim, empty_proposal, "durable embedding input is invalid", 0)
    inputs[1] = body; request_id = "embed-" || substr(rxhash..sha256hex(claim.attempt_id() as .binary), 1, 32)
    /* Read the exact immutable input; the count spans ingestion and repair. */
    prior_calls = embeddingcallcount(_store.database(),_iteminput(_store.database(),claim.item_id()))
    if receipt_body = "" & prior_calls >= provider_config.max_attempts() then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"embedding provider attempt allowance exhausted",0)
    if prior_calls < 0 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,"cannot inspect embedding provider attempt history",0)
    retry_base = provider_config.initial_backoff_ms()
    do retry = 1 to min(prior_calls,30); retry_base = min(provider_config.maximum_backoff_ms(),retry_base*2); end
    request = .providerrequest("embed", "embedding", provider_config.model(), messages, inputs, "", provider_config.timeout_ms(), 1, _jsonstring(document, root, "privacy"), claim.item_id(), request_id, 0, dimension, 0, -1, retry_base, provider_config.maximum_backoff_ms(), provider_config.jitter_ms())
    provider_output = .providerresult()
    if receipt_body \= "" then do
      provider_output = _receiptoutput(receipt_body); receipt_document = .jsondocument(receipt_body)
      request_id = _jsonstring(receipt_document,receipt_document.root(),"expected_request_id")
    end
    else do
      receipt_error = ""
      if beginproviderrequest(_store,claim,request_id,receipt_error,_requestjson(request,provider_config,claim)) \= 0 then return _failedwork(provider_config.provider_id(),provider_config.model(),claim,empty_proposal,receipt_error,0)
      provider_output = backend.embed(request)
      receipt_body = _receiptjson(provider_output,provider_config,request_id)
      if recordproviderresponse(_store,claim,receipt_body,receipt_error) \= 0 then return _receiptfailure(provider_config,request_id,claim,empty_proposal,provider_output,receipt_error)
      receipt_document = .jsondocument(receipt_body); omitted = _jsonstring(receipt_document,receipt_document.root(),"omitted")
      if omitted \= "" then return _failedoutput(provider_config,request_id,claim,empty_proposal,provider_output,"provider receipt content omitted: " || omitted)
      provider_output = _receiptoutput(receipt_body)
    end
    if provider_output.status() \= 0 then return _providerfailure(provider_config, request_id, claim, empty_proposal, provider_output)
    vectors = provider_output.embeddings()
    if provider_output.provider() \= _backendidentity(provider_config.kind()) | provider_output.model() \= provider_config.model() | provider_output.request_id() \= request_id | vectors.0 \= 1 | vectors[1].valid() \= 1 | vectors[1].count() \= dimension then return _failedoutput(provider_config, request_id, claim, empty_proposal, provider_output, "provider embedding failed application validation")
    envelope = "crexx-rag.embedding-input/1|" || provider_config.provider_id() || "|" || provider_config.kind() || "|" || provider_config.model() || "|" || dimension
    input_digest = rxhash..sha256hex((content_digest || "00"x || envelope) as .binary)
    profile_id = "embedding-" || dimension || "-" || substr(rxhash..sha256hex(envelope as .binary), 1, 12)
    embedding = .ragworkembedding(revision_chunk_id, profile_id, input_digest, provider_config.provider_id(), provider_config.model(), dimension, rxhash..sha256hex(envelope as .binary), vectors[1].payload())
    return _success(provider_config.provider_id(), provider_config.model(), request_id, provider_output, empty_proposal, 0, "", "", embedding, "", provider_config.charging_basis())

_receiptjson: procedure = .string
  arg output = .providerresult, config = .ragproviderconfig, expected_request_id = .string, provider_run_id = ""
  usage = output.usage(); failure = output.error(); vectors = output.embeddings()
  secret = ""; credential = config.credential()
  if credential.empty() = 0 then secret = getenv(credential.name())
  content = output.content(); safe_content = content; omitted = ""
  if content \= "" then do
    if binlength(content as .binary) > 1048576 then do; safe_content = ""; omitted = "oversized"; end
    else do
      document = .jsondocument(content)
      if document.valid() \= 1 then do; safe_content = ""; omitted = "malformed-json"; end
      else do
        safe_content = _redactedjson(document,document.root(),secret,0)
        if safe_content \= _redactedjson(document,document.root(),"",0) then do; safe_content = ""; omitted = "credential-redacted"; end
      end
    end
  end
  returned=content
  if returned="" then returned=output.diagnostic_content()
  returned_state="retained";returned_digest=rxhash..sha256hex(returned as .binary);returned_bytes=binlength(returned as .binary)
  returned=_safediagnostic(returned,secret,returned_state)
  failure_message = failure.message()
  if secret \= "" then failure_message = changestr(secret,failure_message,"[REDACTED]")
  encoded_vectors = "["
  do i = 1 to vectors.0
    if i > 1 then encoded_vectors = encoded_vectors || ","
    encoded_vectors = encoded_vectors || '{"codec":' || jsonquote(vectors[i].codec()) || ',"count":' || vectors[i].count() || ',"hex":' || jsonquote(bin2x(vectors[i].payload())) || '}'
  end
  return '{"schema":"crexx-rag.provider-receipt/1","expected_request_id":' || jsonquote(expected_request_id) || ',"provider_run_id":' || jsonquote(provider_run_id) || ',"status":' || output.status() || ',"provider":' || jsonquote(output.provider()) || ',"model":' || jsonquote(output.model()) || ',"request_id":' || jsonquote(output.request_id()) || ',"content":' || jsonquote(safe_content) || ',"content_sha256":' || jsonquote(rxhash..sha256hex(content as .binary)) || ',"content_bytes":' || binlength(content as .binary) || ',"omitted":' || jsonquote(omitted) || ',"returned_text":' || jsonquote(returned) || ',"returned_availability":' || jsonquote(returned_state) || ',"returned_sha256":' || jsonquote(returned_digest) || ',"returned_bytes":' || returned_bytes || ',"finish":' || jsonquote(output.finish_reason()) || ',"input":' || usage.input_tokens() || ',"output":' || usage.output_tokens() || ',"input_count":' || usage.input_count() || ',"cost":' || usage.cost_microunits() || ',"attempts":' || usage.attempts() || ',"retry_delay":' || usage.retry_delay_ms() || ',"latency_us":' || output.latency_us() || ',"error_category":' || jsonquote(failure.category()) || ',"error_code":' || failure.code() || ',"http_status":' || failure.http_status() || ',"retryable":' || failure.retryable() || ',"error_attempt":' || failure.attempt() || ',"error_message":' || jsonquote(failure_message) || ',"vectors":' || encoded_vectors || ']}'

_receiptint: procedure = .int
  arg document = .jsondocument, node = .int, key = .string
  value = 0; ignored = document.node_int(document.member(node,key),value)
  return value

_receiptoutput: procedure = .providerresult
  arg body = .string
  document = .jsondocument(body); root = document.root(); output = .providerresult()
  provider_id = _jsonstring(document,root,"provider"); model = _jsonstring(document,root,"model"); request_id = _jsonstring(document,root,"request_id")
  usage = .providerusage(_receiptint(document,root,"input"),_receiptint(document,root,"output"),_receiptint(document,root,"input_count"),_receiptint(document,root,"cost"),_receiptint(document,root,"attempts"),_receiptint(document,root,"retry_delay"))
  latency = _receiptint(document,root,"latency_us"); omitted = _jsonstring(document,root,"omitted")
  if _receiptint(document,root,"status") \= 0 | omitted \= "" then do
    failure = .providererror(_jsonstring(document,root,"error_category"),_receiptint(document,root,"error_code"),_receiptint(document,root,"http_status"),_receiptint(document,root,"retryable"),_receiptint(document,root,"error_attempt"),_jsonstring(document,root,"error_message"))
    if omitted \= "" then failure = .providererror("validation",0,0,0,1,"provider receipt content omitted: " || omitted)
    call output.set_failure(provider_id,model,request_id,failure,usage,latency)
    call output.set_diagnostic_content(_jsonstring(document,root,"returned_text"))
    return output
  end
  nodes = document.member(root,"vectors"); vectors = .embeddingrecord[]
  do i = 1 to document.node_count(nodes)
    node = document.element(nodes,i)
    vectors[i] = .embeddingrecord(_jsonstring(document,node,"codec"),_receiptint(document,node,"count"),x2bin(_jsonstring(document,node,"hex")))
  end
  if vectors.0 > 0 then call output.set_embeddings(provider_id,model,request_id,vectors,usage,latency)
  else call output.set_generation(provider_id,model,request_id,_jsonstring(document,root,"content"),_jsonstring(document,root,"finish"),usage,latency)
  return output

_success: procedure = .ragworkproviderresult
  arg provider_id = .string, model = .string, request_id = .string, provider_output = .providerresult, proposal = .ragextractionproposal, has_proposal = .int, source_candidate = .string, target_candidate = .string, embedding = .ragworkembedding, provider_run_id = "", charging_basis = "monetary-api"
  usage = provider_output.usage(); cost = usage.cost_microunits(); if cost < 0 | charging_basis \= "monetary-api" then cost = 0
  mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
  return .ragworkproviderresult(0, provider_id, model, request_id, usage.input_tokens(), usage.output_tokens(), cost, (provider_output.latency_us() / 1000) as .int, 0, proposal, "", has_proposal, source_candidate, target_candidate, embedding, provider_run_id, charging_basis, mentions, proposals, notes, usage.retry_delay_ms())

_successbatch: procedure = .ragworkproviderresult
  arg provider_id = .string, model = .string, request_id = .string, provider_output = .providerresult, mentions = .ragworkmention[], proposals = .ragworkproposal[], notes = .ragworknote[], provider_run_id = "", charging_basis = "monetary-api"
  usage = provider_output.usage(); cost = usage.cost_microunits(); if cost < 0 | charging_basis \= "monetary-api" then cost = 0
  empty = .ragextractionproposal
  return .ragworkproviderresult(0, provider_id, model, request_id, usage.input_tokens(), usage.output_tokens(), cost, (provider_output.latency_us() / 1000) as .int, 0, empty, "", proposals.0 > 0, "", "", .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), provider_run_id, charging_basis, mentions, proposals, notes, usage.retry_delay_ms())

_codexfailure: procedure = .providerresult
  arg request = .providerrequest, message = .string, retryable = .int, category = .string
  output = .providerresult()
  call output.set_failure("codex", request.model(), request.request_id(), .providererror(category, -105, 0, retryable, 1, message))
  return output

_providerfailure: procedure = .ragworkproviderresult
  arg config = .ragproviderconfig, request_id = .string, claim = .ragworkclaim, proposal = .ragextractionproposal, output = .providerresult, provider_run_id = "", charging_basis = ""
  failure = output.error(); usage = output.usage(); cost = usage.cost_microunits(); if cost < 0 then cost = 0
  message = failure.message(); if message = "" then message = "provider request failed"
  if charging_basis = "" then charging_basis = config.charging_basis()
  if charging_basis \= "monetary-api" then cost = 0
  mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
  result=.ragworkproviderresult(output.status(), config.provider_id(), config.model(), request_id, usage.input_tokens(), usage.output_tokens(), cost, (output.latency_us() / 1000) as .int, failure.retryable(), proposal, message, 0, "", "", .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), provider_run_id, charging_basis, mentions, proposals, notes, usage.retry_delay_ms())
  call result.set_diagnostic(_receiptjson(output,config,request_id,provider_run_id))
  return result

_citationoutput: procedure = .ragworkproviderresult
  arg config = .ragproviderconfig, request_id = .string, claim = .ragworkclaim, proposal = .ragextractionproposal, output = .providerresult, message = .string, provider_run_id = .string, field = .string, quotation = .string, detail = .string, source_text = ""
  result = _failedoutput(config,request_id,claim,proposal,output,message,provider_run_id)
  credential = config.credential(); secret = ""
  if credential.empty() = 0 then secret = getenv(credential.name())
  if secret \= "" then do
    quotation = changestr(secret,quotation,"[REDACTED]")
    detail = changestr(secret,detail,"[REDACTED]")
    escaped = jsonquote(secret); escaped = substr(escaped,2,length(escaped)-2)
    detail = changestr(escaped,detail,"[REDACTED]")
  end
  feedback = message || "; field=" || field || "; rejected quotation=" || jsonquote(left(quotation,min(length(quotation),512)))
  if detail \= "" then feedback = feedback || "; " || detail
  if source_text \= "" then feedback = quotationfeedback(source_text,output.content())
  if secret \= "" then do
    feedback = changestr(secret,feedback,"[REDACTED]")
    feedback = changestr(escaped,feedback,"[REDACTED]")
  end
  call result.set_content_failure(1)
  call result.set_citation_failure(feedback)
  return result

/* Report every unsupported citation in the bounded response, rather than
 * spending the single correction on the first failing field only. */
_redactfeedback: procedure = .string
  arg config=.ragproviderconfig,value=.string
  credential=config.credential();secret=""
  if credential.empty()=0 then secret=getenv(credential.name())
  if secret<>"" then do
    value=changestr(secret,value,"[REDACTED]")
    encoded=jsonquote(secret);encoded=substr(encoded,2,length(encoded)-2)
    value=changestr(encoded,value,"[REDACTED]")
  end
  return value

_receiptfailure: procedure = .ragworkproviderresult
  arg config = .ragproviderconfig, request_id = .string, claim = .ragworkclaim, proposal = .ragextractionproposal, output = .providerresult, message = .string, provider_run_id = ""
  result = _failedoutput(config,request_id,claim,proposal,output,message,provider_run_id)
  /* The envelope did not commit. Never settle it as rejected content: doing
   * so can overwrite independently durable external output. Keep the original
   * intent and any observed usage; recovery must establish a durable response. */
  call result.set_worker_failure("provider receipt persistence failed: " || message,1)
  return result

_failedoutput: procedure = .ragworkproviderresult
  arg config = .ragproviderconfig, request_id = .string, claim = .ragworkclaim, proposal = .ragextractionproposal, output = .providerresult, message = .string, provider_run_id = "", content_failure = 0
  usage = output.usage(); cost = usage.cost_microunits(); if cost < 0 | config.charging_basis() \= "monetary-api" then cost = 0
  mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
  result = .ragworkproviderresult(-123, config.provider_id(), config.model(), request_id, usage.input_tokens(), usage.output_tokens(), cost, (output.latency_us() / 1000) as .int, 0, proposal, message, 0, "", "", .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), provider_run_id, config.charging_basis(), mentions, proposals, notes, usage.retry_delay_ms())
  call result.set_diagnostic(_failurediagnostic(config, claim, output.content(), message))
  call result.set_content_failure(content_failure)
  /* Only these source-grounding failures are eligible. Shape, identity,
   * lifecycle, transport and publication failures keep their existing rules. */
  if message = "provider mention evidence quotation is not in the chunk" | message = "provider mention label is not in its evidence quotation" | message = "provider relationship evidence quotation is not in the chunk" | message = "provider relationship quotation does not contain both endpoints" | message = "provider analysis note quotation is not in the chunk" | message = "resolution quotation does not ground the selected connection" | message = "resolution cites evidence outside its durable packet" then call result.set_citation_failure(message)
  if assessmentcitationfailure(message)=1 then call result.set_citation_failure(message)
  return result

_failedwork: procedure = .ragworkproviderresult
  arg provider_id = .string, model = .string, claim = .ragworkclaim, proposal = .ragextractionproposal, message = .string, retryable = .int, provider_run_id = "", charging_basis = "monetary-api", retry_delay_ms = 0
  if provider_id = "" then provider_id = "unresolved-provider"
  if model = "" then model = "unresolved-model"
  mentions = .ragworkmention[]; proposals = .ragworkproposal[]; notes = .ragworknote[]
  return .ragworkproviderresult(-101, provider_id, model, "failed-" || substr(rxhash..sha256hex(claim.attempt_id() as .binary), 1, 24), 0, 0, 0, 0, retryable, proposal, message, 0, "", "", .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), provider_run_id, charging_basis, mentions, proposals, notes, retry_delay_ms, 0)

_admissionfailure: procedure = .ragworkproviderresult
  arg result = .ragworkproviderresult, message = .string
  /* Keep the provider response, validation, usage and uncertainty intact.
   * The worker stops after settlement/publication instead of paying to retry it. */
  call result.set_worker_failure("provider admission release failed: " || message,result.outcome_uncertain())
  return result

_iteminput: procedure = .string
  arg database = .binary, item_id = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, "SELECT input_json FROM job_items WHERE item_id=?1", prepared) \= 0 | sqlitebindtext(prepared, 1, item_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

_reservationtokens: procedure = .int
  arg document = .jsondocument, root = .int
  reservation = document.member(root, "reservation")
  input_tokens = -1; output_tokens = -1
  if document.node_type(reservation) \= "object" | document.node_int(document.member(reservation, "input_tokens"), input_tokens) \= 0 | document.node_int(document.member(reservation, "output_tokens"), output_tokens) \= 0 | input_tokens < 0 | output_tokens < 0 then return -1
  return input_tokens + output_tokens

_roleprovider: procedure = .string
  arg config = .ragconfig, role = .string
  roles = config.roles()
  do i = 1 to roles.0
    if roles[i].role() = role then return roles[i].provider_id()
  end
  return ""

_providerconfig: procedure = .ragproviderconfig
  arg config = .ragconfig, provider_id = .string
  providers = config.providers()
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return providers[i]
  end
  return .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)

_backendidentity: procedure = .string
  arg kind = .string
  if kind = "openai-compatible" then return "openai"
  return kind

_randomhex: procedure = .string
  arg database = .binary
  prepared = .binary; value = ""
  if sqliteprepare(database, "SELECT lower(hex(randomblob(16)))", prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

_jsonstring: procedure = .string
  arg document = .jsondocument, root = .int, name = .string
  value = ""
  if document.node_string(document.member(root, name), value) \= 0 then return ""
  return value

_containslower: procedure = .int
  arg values = .string[], expected = .string
  expected = lower(expected)
  do i = 1 to values.0
    if lower(values[i]) = expected then return 1
  end
  return 0

_validlifecycleaction: procedure = .int
  arg content = .string, expected_operation = .string
  document = .jsondocument(content)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" | document.node_count(document.root()) \= 9 then return 0
  root = document.root(); schema = ""; operation = ""; concept_id = ""; target = ""; alias = ""; concept_type = ""; reason = ""
  successors = document.member(root, "successors"); dispositions = document.member(root, "dispositions")
  status = document.node_string(document.member(root, "schema"), schema) | document.node_string(document.member(root, "operation"), operation) | document.node_string(document.member(root, "concept_id"), concept_id) | document.node_string(document.member(root, "target_concept_id"), target) | document.node_string(document.member(root, "alias"), alias) | document.node_string(document.member(root, "concept_type"), concept_type) | document.node_string(document.member(root, "reason"), reason)
  if status \= 0 | schema \= "crexx-rag.lifecycle-action/1" | operation \= expected_operation | concept_id = "" | reason = "" | document.node_type(successors) \= "array" | document.node_type(dispositions) \= "array" | document.node_count(dispositions) \= 0 then return 0
  if operation = "synonym" then return alias \= "" & target = "" & concept_type = "" & document.node_count(successors) = 0
  if operation = "split" then do
    if alias \= "" | target \= "" | concept_type \= "" | document.node_count(successors) < 2 | document.node_count(successors) > 8 then return 0
    do i = 1 to document.node_count(successors)
      node = document.element(successors, i); label = ""; child_type = ""
      if document.node_type(node) \= "object" | document.node_count(node) \= 2 | document.node_string(document.member(node, "canonical_label"), label) \= 0 | document.node_string(document.member(node, "concept_type"), child_type) \= 0 | label = "" | child_type = "" then return 0
    end
    return 1
  end
  if operation = "merge" then return target \= "" & target \= concept_id & alias = "" & concept_type = "" & document.node_count(successors) = 0
  if operation = "type-correction" then return concept_type \= "" & alias = "" & target = "" & document.node_count(successors) = 0
  return alias = "" & target = "" & concept_type = "" & document.node_count(successors) = 0

_candidateexists: procedure = .int
  arg document = .jsondocument, root = .int, candidate_id = .string
  candidates = document.member(root, "candidates")
  if document.node_type(candidates) \= "array" then return 0
  do i = 1 to document.node_count(candidates)
    candidate = document.element(candidates, i); value = ""
    if document.node_string(document.member(candidate, "candidate_id"), value) = 0 & value = candidate_id then return 1
  end
  return 0

_permittedtype: procedure = .int
  arg profile = .ragprofile, expected = .string
  values = profile.concept_types()
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_permittedrelationship: procedure = .int
  arg profile = .ragprofile, expected = .string
  values = profile.relationship_types()
  do i = 1 to values.0
    if values[i].relationship_id() = expected then return 1
  end
  return 0

_parseurl: procedure = .int
  arg url = .string, expose host = .string, expose port = .int, expose tls = .int, expose base_path = .string
  host = ""; base_path = ""; port = 0; tls = 0; rest = ""
  if left(url, 8) = "https://" then do; tls = 1; port = 443; rest = substr(url, 9); end
  else if left(url, 7) = "http://" then do; tls = 0; port = 80; rest = substr(url, 8); end
  else return -1
  slash = pos("/", rest)
  if slash = 0 then authority = rest
  else do; authority = left(rest, slash - 1); base_path = substr(rest, slash); end
  colon = lastpos(":", authority)
  if colon > 0 then do
    port_text = substr(authority, colon + 1); host = left(authority, colon - 1)
    if datatype(port_text, "W") \= 1 then return -1
    port = port_text as .int
  end
  else host = authority
  if host = "" | port < 1 | port > 65535 | pos("00"x, base_path) > 0 then return -1
  return 0

/* Retain bounded rejected output beside its immutable attempt input. Decode
 * JSON strings before redaction so escaped credential values cannot leak. */
_failurediagnostic: procedure = .string
  arg config = .ragproviderconfig, claim = .ragworkclaim, content = .string, message = .string
  if content = "" then return ""
  bytes = binlength(content as .binary); digest = rxhash..sha256hex(content as .binary)
  captured = ""; omitted = "oversized"
  if bytes <= 65536 then do
    document = .jsondocument(content)
    if document.valid() = 1 then do
      secret = ""; credential = config.credential()
      if credential.empty() = 0 then secret = getenv(credential.name())
      captured = _redactedjson(document, document.root(), secret, 0); omitted = ""
    end
    else omitted = "malformed-json"
  end
  return '{"schema":"crexx-rag.rejected-output/1","input_hash":' || jsonquote(claim.input_hash()) || ',"error":' || jsonquote(message) || ',"output_sha256":' || jsonquote(digest) || ',"output_bytes":' || bytes || ',"omitted":' || jsonquote(omitted) || ',"content":' || jsonquote(captured) || '}'

_redactedjson: procedure = .string
  arg document = .jsondocument, node = .int, secret = .string, depth = .int
  if depth > 16 then return "null"
  kind = document.node_type(node)
  if kind = "string" then do
    value = document.node_get(node)
    if secret \= "" then value = changestr(secret, value, "[REDACTED]")
    return jsonquote(value)
  end
  if kind \= "array" & kind \= "object" then return document.node_get(node)
  children = .int[]; ignored = document.children(node, children); output = "["
  if kind = "object" then output = "{"
  do i = 1 to children.0
    if i > 1 then output = output || ","
    if kind = "object" then do
      name = document.node_name(children[i]); if secret \= "" then name = changestr(secret, name, "[REDACTED]")
      output = output || jsonquote(name) || ":"
    end
    output = output || _redactedjson(document, children[i], secret, depth + 1)
  end
  if kind = "object" then return output || "}"
  return output || "]"

_appendmention: procedure = .void
  arg expose mentions = .ragworkmention[], mention = .ragworkmention
  do i = 1 to mentions.0
    if mentions[i].candidate_id() = mention.candidate_id() then return
  end
  mentions[mentions.0 + 1] = mention
  return

_mentioncandidate: procedure = .string
  arg chunk = .string, begin = .int, finish = .int, label = .string, concept_type = .string
  return "candidate-sha256:" || rxhash..sha256hex((chunk || "00"x || begin || "00"x || finish || "00"x || lower(label) || "00"x || concept_type || "00"x || "provider-discovery-v2") as .binary)

_databaseepoch: procedure = .int
  arg database = .binary
  prepared = .binary; value = 0
  if sqliteprepare(database,"SELECT unixepoch()",prepared) \= 0 then return 0
  if sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return 0; end
  status = sqlitecolumnint(prepared,0,value); call sqlitefinalize prepared
  if status \= 0 then return 0
  return value

ragcodexusageobserver: class implements .codexrunobserver
  _store = .ragstorehandle
  _provider_run_id = .string
  *: factory
    arg store = .ragstorehandle, provider_run_id = .string
    _store = store; _provider_run_id = provider_run_id
    return
  thread_started: method = .int
    arg request_id = .string, thread_id = .string
    return 0
  turn_started: method = .int
    arg request_id = .string, thread_id = .string, turn_id = .string
    return 0
  usage_updated: method = .int
    arg request_id = .string, thread_id = .string, turn_id = .string, input_tokens = .int, output_tokens = .int
    error = ""
    return updateexternalrunusage(_store,_provider_run_id,thread_id,turn_id,input_tokens,output_tokens,error)
  turn_completed: method = .int
    arg request_id = .string, thread_id = .string, turn_id = .string, content = .string, input_tokens = .int, output_tokens = .int
    return 0
  allowance_updated: method = .int
    arg request_id = .string, used_percent = .int
    return 0

/* Application request envelope, before provider-specific transport encoding. */
_requestjson: procedure = .string
  arg request=.providerrequest,config=.ragproviderconfig,claim=.ragworkclaim,input_json=""
  messages=request.messages();inputs=request.inputs();encoded="[";prompt=""
  do i=1 to messages.0
    if i>1 then encoded=encoded || ","
    encoded=encoded || '{"role":' || jsonquote(messages[i].role()) || ',"content":' || jsonquote(messages[i].content()) || '}'
    if i=1 then prompt=messages[i].content()
  end
  encoded=encoded || ']';values="["
  do i=1 to inputs.0
    if i>1 then values=values || ","
    values=values || jsonquote(inputs[i])
  end
  values=values || ']'
  body='{"messages":' || encoded || ',"inputs":' || values || ',"response_schema":' || jsonquote(request.schema()) || '}'
  credential=config.credential();secret="";availability="retained"
  if credential.empty()=0 then secret=getenv(credential.name())
  digest=rxhash..sha256hex(body as .binary);bytes=binlength(body as .binary)
  captured=_safediagnostic(body,secret,availability)
  if captured="" then captured="null"
  reference_fields="";references=.ragresolutionreferences(input_json)
  if references.enabled()=1 then do
    map_availability="";retained_map=_safediagnostic(references.mapping(),secret,map_availability)
    if retained_map="" then retained_map="null"
    reference_fields=',"resolution_references":' || retained_map
  end
  return '{"schema":"crexx-rag.provider-request/1","operation":' || jsonquote(request.operation()) || ',"provider":' || jsonquote(config.provider_id()) || ',"model":' || jsonquote(request.model()) || ',"role":' || jsonquote(request.role()) || ',"reasoning_effort":' || jsonquote(request.reasoning_effort()) || ',"request_id":' || jsonquote(request.request_id()) || ',"input_hash":' || jsonquote(claim.input_hash()) || ',"prompt_sha256":' || jsonquote(rxhash..sha256hex(prompt as .binary)) || ',"schema_sha256":' || jsonquote(rxhash..sha256hex(request.schema() as .binary)) || ',"body_sha256":' || jsonquote(digest) || ',"body_bytes":' || bytes || ',"availability":' || jsonquote(availability) || ',"body":' || captured || reference_fields || '}'

/* Keep byte-exact text when safe. Decoded JSON redaction detects alternative
 * escaping of credentials. Malformed escaped text cannot be safely decoded. */
_safediagnostic: procedure = .string
  arg content=.string,secret=.string,expose availability=.string
  availability="retained"
  if content="" then do;availability="unavailable";return "";end
  if binlength(content as .binary)>1048576 then do;availability="oversized";return "";end
  if secret="" then return content
  document=.jsondocument(content)
  if document.valid()=1 then do
    if _diagnosticdepth(document,document.root(),0)>16 then do;availability="unavailable-depth";return "";end
    safe=_redactedjson(document,document.root(),secret,0)
    if safe<>_redactedjson(document,document.root(),"",0) then do;availability="redacted";return safe;end
    return content
  end
  if pos("5C"x,content)>0 then do;availability="unavailable-unsafe-escaping";return "";end
  safe=changestr(secret,content,"[REDACTED]")
  if safe<>content then availability="redacted"
  return safe

_diagnosticdepth: procedure = .int
  arg document=.jsondocument,node=.int,depth=.int
  if depth>16 then return depth
  children=.int[];ignored=document.children(node,children);maximum=depth
  do i=1 to children.0
    maximum=max(maximum,_diagnosticdepth(document,children[i],depth+1))
    if maximum>16 then return maximum
  end
  return maximum
