options levelg

namespace ragschema expose ragschemaversion migrationname migrationchecksum migrationstatements

ragschemaversion: procedure = .int
  return 13

migrationname: procedure = .string
  arg version = .int
  if version = 1 then return "initial-library"
  if version = 2 then return "worker-hot-path-indexes"
  if version = 3 then return "provider-run-accounting-index"
  if version = 4 then return "library-report-cache"
  if version = 5 then return "historic-observability"
  if version = 6 then return "configuration-lifecycle-and-provider-resilience"
  if version = 7 then return "indexed-term-statistics-and-backlog-reconciliation"
  if version = 8 then return "direct-provider-history"
  if version = 10 then return "durable-maintenance-backlog"
  if version = 11 then return "claim-time-and-source-provenance"
  if version = 12 then return "agent-maintenance-handoff"
  if version = 13 then return "embedding-retry-admission"
  if version = 9 then return "prospective-configuration-transitions"
  return ""

migrationchecksum: procedure = .string
  arg version = .int
  if version = 13 then return "9d5236180dd1c7b39c1853658f0ed0b167521f4e1a56c52942af4f1bebf470f9"
  if version = 12 then return "abe73ac0a801d3a824f08b7689bdc756b0c50a209ef3ff0eb88c1cfd17a2ce2d"
  if version = 11 then return "641b75b26a3946f1a55c40eb6b7913c8264501aaec4d7a4166e1720ed09acd74"
  /* SHA-256 of the ordered migration statements, each followed by LF. */
  if version = 10 then return "7bf90419a4f3e691691f4e18e86f2faa87ca59c06c1e863b6dcc4aa83e388a9c"
  if version = 1 then return "ce67d40ab29bd35585af51b2011a6350f2b8305e7969d066a2ef1d9a7a703ca0"
  if version = 2 then return "de4592a26543a0c6d8d3a1ef9c6fd4922f17123548e2930366cb8638be9503c4"
  if version = 3 then return "28cc9a080e1a5adcd1c16114cd21a0d0edee0432740d6a26c2b39925013e0370"
  if version = 4 then return "f0669147b3b07b1b1a8754937821de63b94e0e40cce69daa9d2ab7a4b0877699"
  if version = 5 then return "9177f2f3130c175008a6514f072bfa413cca0f327fe4619930d9c77d44f11bd3"
  if version = 6 then return "529919045d2777013a0cdf4dcdec8d31fa103d069122677b55f4fd6c38aa7583"
  if version = 7 then return "9bdc5094e03f56e47f46cdc99a0a0886747f73ca11dbeb4ddaf3ecf5451d7443"
  if version = 8 then return "add7adb59016bab71709aa6575d507ff4271d3157333216208708142473753c1"
  if version = 9 then return "dcfd1a148310f1c2cddd1f0c5b0a9396a07ce496e3dd5eb5a91b2084a6793ce4"
  return ""

migrationstatements: procedure = .int
  arg version = .int, expose statements = .string[]
  statements = .string[]
  if version = 13 then do
    statements[statements.0 + 1] = "CREATE TABLE provider_cooldowns(provider_id TEXT NOT NULL,model TEXT NOT NULL,not_before_epoch INTEGER NOT NULL DEFAULT 0,failure_count INTEGER NOT NULL DEFAULT 0 CHECK(failure_count>=0),updated_epoch INTEGER NOT NULL,PRIMARY KEY(provider_id,model)) STRICT"
    statements[statements.0 + 1] = "CREATE INDEX job_items_embedding_subject ON job_items(json_extract(input_json,'$.revision_chunk_id'),json_extract(input_json,'$.provider_id'),json_extract(input_json,'$.model'),json_extract(input_json,'$.embedding_dimension')) WHERE item_type='embedding' AND json_valid(input_json)"
    return statements.0
  end
  if version = 12 then do
    statements[statements.0 + 1] = "ALTER TABLE maintenance_tasks ADD COLUMN required_capability TEXT NOT NULL DEFAULT 'standard' CHECK(required_capability IN('standard','advanced-reasoning'))"
    statements[statements.0 + 1] = "ALTER TABLE maintenance_tasks ADD COLUMN escalation_origin TEXT NOT NULL DEFAULT ''"
    statements[statements.0 + 1] = "ALTER TABLE maintenance_tasks ADD COLUMN escalation_reason TEXT NOT NULL DEFAULT ''"
    statements[statements.0 + 1] = "ALTER TABLE maintenance_tasks ADD COLUMN semantic_failures INTEGER NOT NULL DEFAULT 0 CHECK(semantic_failures>=0)"
    statements[statements.0 + 1] = "CREATE TABLE maintenance_agent_actions(action_id TEXT PRIMARY KEY,task_id TEXT NOT NULL REFERENCES maintenance_tasks(task_id),action_kind TEXT NOT NULL CHECK(action_kind IN('escalation','resolution')),actor TEXT NOT NULL,model TEXT NOT NULL,canonical_plan TEXT NOT NULL CHECK(json_valid(canonical_plan)),created_epoch INTEGER NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE INDEX maintenance_agent_actions_task ON maintenance_agent_actions(task_id,action_id)"
    statements[statements.0 + 1] = "CREATE TRIGGER maintenance_agent_actions_immutable_update BEFORE UPDATE ON maintenance_agent_actions BEGIN SELECT RAISE(ABORT,'agent action is immutable'); END"
    statements[statements.0 + 1] = "CREATE TRIGGER maintenance_agent_actions_immutable_delete BEFORE DELETE ON maintenance_agent_actions BEGIN SELECT RAISE(ABORT,'agent action is immutable'); END"
    return statements.0
  end
  if version = 1 then do
    statements[statements.0 + 1] = "CREATE TABLE schema_migrations(version INTEGER PRIMARY KEY,name TEXT NOT NULL UNIQUE,checksum TEXT NOT NULL CHECK(length(checksum)=64),applied_at TEXT NOT NULL,tool_version TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE config_snapshots(config_snapshot_id TEXT PRIMARY KEY,config_id TEXT NOT NULL,config_version TEXT NOT NULL,profile_id TEXT NOT NULL,profile_hash TEXT NOT NULL,config_hash TEXT NOT NULL,effective_json TEXT NOT NULL,created_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE published_generations(generation INTEGER PRIMARY KEY,parent_generation INTEGER REFERENCES published_generations(generation),state TEXT NOT NULL CHECK(state IN('staging','published')),config_snapshot_id TEXT NOT NULL REFERENCES config_snapshots(config_snapshot_id),summary TEXT NOT NULL,created_at TEXT NOT NULL,published_at TEXT,UNIQUE(generation,state),CHECK(parent_generation IS NULL OR parent_generation<generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE library_meta(singleton INTEGER PRIMARY KEY CHECK(singleton=1),library_id TEXT NOT NULL UNIQUE,bundle_format_version INTEGER NOT NULL CHECK(bundle_format_version=1),schema_version INTEGER NOT NULL,published_generation INTEGER NOT NULL REFERENCES published_generations(generation),next_generation INTEGER NOT NULL CHECK(next_generation>published_generation),active_profile_id TEXT NOT NULL,active_profile_hash TEXT NOT NULL,required_capabilities TEXT NOT NULL,created_at TEXT NOT NULL,updated_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE publication_events(event_id INTEGER PRIMARY KEY,generation INTEGER NOT NULL REFERENCES published_generations(generation),previous_generation INTEGER REFERENCES published_generations(generation),event_type TEXT NOT NULL CHECK(event_type IN('publish','rollback')),reason TEXT NOT NULL,occurred_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE INDEX publication_events_generation ON publication_events(generation,event_id)"
    statements[statements.0 + 1] = "CREATE TRIGGER published_generations_immutable_update BEFORE UPDATE ON published_generations WHEN OLD.state='published' BEGIN SELECT RAISE(ABORT,'published generation is immutable'); END"
    statements[statements.0 + 1] = "CREATE TRIGGER published_generations_immutable_delete BEFORE DELETE ON published_generations WHEN OLD.state='published' BEGIN SELECT RAISE(ABORT,'published generation is immutable'); END"
    statements[statements.0 + 1] = "CREATE TABLE provider_runs(provider_run_id TEXT PRIMARY KEY,config_snapshot_id TEXT NOT NULL REFERENCES config_snapshots(config_snapshot_id),provider_id TEXT NOT NULL,model TEXT NOT NULL,request_hash TEXT NOT NULL,outcome TEXT NOT NULL,input_tokens INTEGER NOT NULL DEFAULT 0,output_tokens INTEGER NOT NULL DEFAULT 0,duration_ms INTEGER NOT NULL DEFAULT 0,started_at TEXT NOT NULL,completed_at TEXT,charging_basis TEXT NOT NULL DEFAULT 'monetary-api',external_thread_id TEXT NOT NULL DEFAULT '',external_turn_id TEXT NOT NULL DEFAULT '',allowance_used_before_percent INTEGER NOT NULL DEFAULT -1,allowance_used_after_percent INTEGER NOT NULL DEFAULT -1,recovery_json TEXT NOT NULL DEFAULT '') STRICT"
    statements[statements.0 + 1] = "CREATE TABLE sources(source_id TEXT PRIMARY KEY,connector_type TEXT NOT NULL,stable_key TEXT NOT NULL,current_revision_id TEXT,lifecycle_state TEXT NOT NULL,observed_uri TEXT NOT NULL,observed_title TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),UNIQUE(connector_type,stable_key),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE source_artifacts(artifact_id TEXT PRIMARY KEY,raw_digest TEXT NOT NULL UNIQUE,mime_type TEXT NOT NULL,encoding TEXT NOT NULL,bytes BLOB,external_reference TEXT,created_at TEXT NOT NULL,CHECK((bytes IS NULL)!=(external_reference IS NULL))) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE source_revision_texts(text_id TEXT PRIMARY KEY,text_digest TEXT NOT NULL,normalized_utf8 TEXT NOT NULL,extractor_version TEXT NOT NULL,normalization_version TEXT NOT NULL,created_at TEXT NOT NULL,UNIQUE(text_digest,extractor_version,normalization_version)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE source_revisions(revision_id TEXT PRIMARY KEY,source_id TEXT NOT NULL REFERENCES sources(source_id),revision_envelope_digest TEXT NOT NULL,artifact_id TEXT NOT NULL REFERENCES source_artifacts(artifact_id),text_id TEXT NOT NULL REFERENCES source_revision_texts(text_id),metadata_fingerprint TEXT NOT NULL,captured_at TEXT NOT NULL,event_start_at TEXT,event_end_at TEXT,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),UNIQUE(source_id,revision_envelope_digest),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE normalization_maps(map_id TEXT PRIMARY KEY,revision_id TEXT NOT NULL REFERENCES source_revisions(revision_id),raw_start INTEGER NOT NULL,raw_end INTEGER NOT NULL,normalized_start INTEGER NOT NULL,normalized_end INTEGER NOT NULL,line INTEGER NOT NULL,unicode_column INTEGER NOT NULL,CHECK(raw_end>=raw_start),CHECK(normalized_end>=normalized_start)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE chunk_contents(content_id TEXT PRIMARY KEY,content_digest TEXT NOT NULL,text TEXT NOT NULL,input_fingerprint TEXT NOT NULL,UNIQUE(content_digest,input_fingerprint)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE revision_chunks(revision_chunk_id TEXT PRIMARY KEY,revision_id TEXT NOT NULL REFERENCES source_revisions(revision_id),ordinal INTEGER NOT NULL,normalized_start INTEGER NOT NULL,normalized_end INTEGER NOT NULL,content_id TEXT NOT NULL REFERENCES chunk_contents(content_id),continuity_key TEXT NOT NULL,parser_version TEXT NOT NULL,evidence_class TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),UNIQUE(revision_id,ordinal),CHECK(normalized_end>normalized_start),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE VIRTUAL TABLE chunks_fts USING fts5(revision_chunk_id UNINDEXED,content_id UNINDEXED,body)"
    statements[statements.0 + 1] = "CREATE TABLE candidate_mentions(candidate_id TEXT PRIMARY KEY,revision_chunk_id TEXT NOT NULL REFERENCES revision_chunks(revision_chunk_id),normalized_candidate TEXT NOT NULL,span_start INTEGER NOT NULL,span_end INTEGER NOT NULL,extractor_version TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK(span_end>span_start),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE candidate_decisions(decision_id TEXT PRIMARY KEY,candidate_id TEXT NOT NULL REFERENCES candidate_mentions(candidate_id),decision_version INTEGER NOT NULL,state TEXT NOT NULL,evidence_json TEXT NOT NULL,provider_run_id TEXT REFERENCES provider_runs(provider_run_id),policy_version TEXT NOT NULL,created_at TEXT NOT NULL,UNIQUE(candidate_id,decision_version)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE concepts(concept_id TEXT PRIMARY KEY,canonical_label TEXT NOT NULL,concept_type TEXT NOT NULL,lifecycle_state TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE aliases(alias_id TEXT PRIMARY KEY,normalized_alias TEXT NOT NULL,target_concept_id TEXT REFERENCES concepts(concept_id),ambiguity_id TEXT,decision_id TEXT REFERENCES candidate_decisions(decision_id),visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK((target_concept_id IS NULL)!=(ambiguity_id IS NULL)),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE mentions(mention_id TEXT PRIMARY KEY,concept_id TEXT REFERENCES concepts(concept_id),ambiguity_id TEXT,revision_chunk_id TEXT NOT NULL REFERENCES revision_chunks(revision_chunk_id),span_start INTEGER NOT NULL,span_end INTEGER NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK((concept_id IS NULL)!=(ambiguity_id IS NULL)),CHECK(span_end>span_start),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE claims(claim_id TEXT PRIMARY KEY,source_concept_id TEXT NOT NULL REFERENCES concepts(concept_id),relationship_type TEXT NOT NULL,target_concept_id TEXT NOT NULL REFERENCES concepts(concept_id),direction TEXT NOT NULL,qualifiers_json TEXT NOT NULL,effective_from TEXT,effective_to TEXT,policy_version TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK(source_concept_id<>target_concept_id),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE claim_support(support_id TEXT PRIMARY KEY,claim_id TEXT NOT NULL REFERENCES claims(claim_id),revision_chunk_id TEXT NOT NULL REFERENCES revision_chunks(revision_chunk_id),span_start INTEGER NOT NULL,span_end INTEGER NOT NULL,polarity TEXT NOT NULL,stance TEXT NOT NULL,directness TEXT NOT NULL,attribution TEXT NOT NULL,lineage_group TEXT NOT NULL,extractor_identity TEXT NOT NULL,decision_id TEXT REFERENCES candidate_decisions(decision_id),visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),UNIQUE(claim_id,revision_chunk_id,span_start,span_end,polarity,extractor_identity),CHECK(span_end>span_start),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE claim_conflicts(conflict_id TEXT PRIMARY KEY,claim_id TEXT NOT NULL REFERENCES claims(claim_id),competing_claim_id TEXT NOT NULL REFERENCES claims(claim_id),review_state TEXT NOT NULL,visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),CHECK(claim_id<>competing_claim_id),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE ambiguity_candidates(ambiguity_id TEXT NOT NULL,concept_id TEXT NOT NULL REFERENCES concepts(concept_id),revision_chunk_id TEXT NOT NULL REFERENCES revision_chunks(revision_chunk_id),decision_id TEXT REFERENCES candidate_decisions(decision_id),visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),PRIMARY KEY(ambiguity_id,concept_id,revision_chunk_id),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) WITHOUT ROWID, STRICT"
    statements[statements.0 + 1] = "CREATE TABLE embedding_profiles(embedding_profile_id TEXT PRIMARY KEY,provider_id TEXT NOT NULL,model TEXT NOT NULL,dimension INTEGER NOT NULL CHECK(dimension>0),input_envelope_fingerprint TEXT NOT NULL,created_at TEXT NOT NULL,UNIQUE(provider_id,model,dimension,input_envelope_fingerprint)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE embeddings(embedding_id TEXT PRIMARY KEY,input_digest TEXT NOT NULL,embedding_profile_id TEXT NOT NULL REFERENCES embedding_profiles(embedding_profile_id),vector BLOB NOT NULL,dimension INTEGER NOT NULL CHECK(dimension>0),provider_run_id TEXT REFERENCES provider_runs(provider_run_id),created_at TEXT NOT NULL,UNIQUE(input_digest,embedding_profile_id)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE revision_chunk_embeddings(revision_chunk_id TEXT NOT NULL REFERENCES revision_chunks(revision_chunk_id),embedding_id TEXT NOT NULL REFERENCES embeddings(embedding_id),visible_from_generation INTEGER NOT NULL REFERENCES published_generations(generation),visible_to_generation INTEGER REFERENCES published_generations(generation),PRIMARY KEY(revision_chunk_id,embedding_id,visible_from_generation),CHECK(visible_to_generation IS NULL OR visible_to_generation>visible_from_generation)) WITHOUT ROWID, STRICT"
    statements[statements.0 + 1] = "CREATE TABLE vector_generations(vector_generation_id TEXT PRIMARY KEY,semantic_generation INTEGER NOT NULL REFERENCES published_generations(generation),embedding_profile_id TEXT NOT NULL REFERENCES embedding_profiles(embedding_profile_id),state TEXT NOT NULL,algorithm TEXT NOT NULL CHECK(algorithm='ivf-flat-v1'),sidecar_name TEXT NOT NULL,sidecar_checksum TEXT NOT NULL,dimension INTEGER NOT NULL CHECK(dimension>0),row_count INTEGER NOT NULL CHECK(row_count>=0),centroid_count INTEGER NOT NULL CHECK(centroid_count>0),probe_count INTEGER NOT NULL CHECK(probe_count>0 AND probe_count<=centroid_count),created_at TEXT NOT NULL,published_at TEXT) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE jobs(job_id TEXT PRIMARY KEY,plan_digest TEXT NOT NULL UNIQUE,canonical_plan TEXT NOT NULL,config_snapshot_id TEXT NOT NULL REFERENCES config_snapshots(config_snapshot_id),state TEXT NOT NULL,item_budget INTEGER NOT NULL,model_call_budget INTEGER NOT NULL,input_token_budget INTEGER NOT NULL,output_token_budget INTEGER NOT NULL,cost_budget INTEGER NOT NULL,reserved_calls INTEGER NOT NULL DEFAULT 0,reserved_tokens INTEGER NOT NULL DEFAULT 0,reserved_cost INTEGER NOT NULL DEFAULT 0,codex_turn_budget INTEGER NOT NULL DEFAULT 0,reserved_codex_turns INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,updated_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE job_items(item_id TEXT PRIMARY KEY,job_id TEXT NOT NULL REFERENCES jobs(job_id),item_type TEXT NOT NULL,state TEXT NOT NULL,priority INTEGER NOT NULL,worker_id TEXT,lease_until INTEGER,fence INTEGER NOT NULL DEFAULT 0,retry_at INTEGER NOT NULL DEFAULT 0,idempotency_key TEXT NOT NULL UNIQUE,input_hash TEXT NOT NULL,input_json TEXT NOT NULL DEFAULT '',created_at TEXT NOT NULL,updated_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE attempts(attempt_id TEXT PRIMARY KEY,item_id TEXT NOT NULL REFERENCES job_items(item_id),worker_id TEXT NOT NULL,fence INTEGER NOT NULL,input_hash TEXT NOT NULL,output_hash TEXT,provider_run_id TEXT REFERENCES provider_runs(provider_run_id),validation_state TEXT NOT NULL,outcome TEXT NOT NULL,started_at TEXT NOT NULL,completed_at TEXT) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE job_events(event_id INTEGER PRIMARY KEY,job_id TEXT NOT NULL REFERENCES jobs(job_id),item_id TEXT REFERENCES job_items(item_id),attempt_id TEXT REFERENCES attempts(attempt_id),event_type TEXT NOT NULL,message TEXT NOT NULL,occurred_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE reviews(review_id TEXT PRIMARY KEY,review_type TEXT NOT NULL,subject_id TEXT NOT NULL,state TEXT NOT NULL,proposal_json TEXT NOT NULL,decision_json TEXT,created_at TEXT NOT NULL,decided_at TEXT) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE analysis_notes(note_id TEXT PRIMARY KEY,note_kind TEXT NOT NULL CHECK(note_kind IN('observation','insight','hypothesis','question','gap','conflict','lead','follow-up','recommendation','synonym','split','merge','type-correction','retire','restore')),text TEXT NOT NULL CHECK(length(text)>0),importance INTEGER NOT NULL CHECK(importance BETWEEN 0 AND 1000000),uncertainty INTEGER NOT NULL CHECK(uncertainty BETWEEN 0 AND 1000000),next_action TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN('proposed','active','resolved','rejected','superseded')),grounding_json TEXT NOT NULL,provider_run_id TEXT REFERENCES provider_runs(provider_run_id),review_id TEXT REFERENCES reviews(review_id),author TEXT NOT NULL,created_generation INTEGER NOT NULL REFERENCES published_generations(generation),created_at TEXT NOT NULL,updated_at TEXT NOT NULL) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE analysis_note_links(link_id TEXT PRIMARY KEY,note_id TEXT NOT NULL REFERENCES analysis_notes(note_id),object_type TEXT NOT NULL CHECK(object_type IN('concept','claim','chunk','source','query')),object_id TEXT NOT NULL,revision_chunk_id TEXT REFERENCES revision_chunks(revision_chunk_id),span_start INTEGER,span_end INTEGER,UNIQUE(note_id,object_type,object_id,revision_chunk_id,span_start,span_end),CHECK((revision_chunk_id IS NULL AND span_start IS NULL AND span_end IS NULL) OR (revision_chunk_id IS NOT NULL AND span_start IS NOT NULL AND span_end IS NOT NULL AND span_end>span_start))) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE maintenance_runs(run_id TEXT PRIMARY KEY,expected_generation INTEGER NOT NULL REFERENCES published_generations(generation),config_snapshot_id TEXT NOT NULL REFERENCES config_snapshots(config_snapshot_id),mode TEXT NOT NULL CHECK(mode IN('automatic','reviewed','manual')),state TEXT NOT NULL CHECK(state IN('planned','running','complete','incomplete','failed')),plan_digest TEXT NOT NULL,canonical_plan TEXT NOT NULL,created_at TEXT NOT NULL,completed_at TEXT,UNIQUE(plan_digest)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE maintenance_items(item_id TEXT PRIMARY KEY,run_id TEXT NOT NULL REFERENCES maintenance_runs(run_id),item_type TEXT NOT NULL CHECK(item_type IN('concept-review','claim-conflict','sparse-node','stale-embedding','query-gap','analysis-lead','synonym','split','merge','type-correction','retire','restore','vector-publication')),subject_type TEXT NOT NULL,subject_id TEXT NOT NULL,score INTEGER NOT NULL CHECK(score BETWEEN 0 AND 1000000),trigger_json TEXT NOT NULL,diagnosis_json TEXT NOT NULL,action_json TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN('pending','leased','diagnosed','review-required','approved','applied','rejected','failed','blocked')),dependency_item_id TEXT REFERENCES maintenance_items(item_id),expected_generation INTEGER NOT NULL REFERENCES published_generations(generation),applied_generation INTEGER REFERENCES published_generations(generation),created_at TEXT NOT NULL,updated_at TEXT NOT NULL,UNIQUE(run_id,item_type,subject_type,subject_id)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE concept_versions(concept_id TEXT NOT NULL REFERENCES concepts(concept_id),version INTEGER NOT NULL CHECK(version>0),canonical_label TEXT NOT NULL,concept_type TEXT NOT NULL,lifecycle_state TEXT NOT NULL CHECK(lifecycle_state IN('active','migration-parent','retired')),generation INTEGER NOT NULL REFERENCES published_generations(generation),reason TEXT NOT NULL,review_id TEXT REFERENCES reviews(review_id),created_at TEXT NOT NULL,PRIMARY KEY(concept_id,version)) WITHOUT ROWID, STRICT"
    statements[statements.0 + 1] = "CREATE TABLE concept_lineage(lineage_id TEXT PRIMARY KEY,operation TEXT NOT NULL CHECK(operation IN('synonym','split','merge','type-correction','retire','restore')),parent_concept_id TEXT NOT NULL REFERENCES concepts(concept_id),child_concept_id TEXT NOT NULL REFERENCES concepts(concept_id),generation INTEGER NOT NULL REFERENCES published_generations(generation),review_id TEXT REFERENCES reviews(review_id),reason TEXT NOT NULL,created_at TEXT NOT NULL,UNIQUE(operation,parent_concept_id,child_concept_id,generation)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE maintenance_dispositions(disposition_id TEXT PRIMARY KEY,maintenance_item_id TEXT NOT NULL REFERENCES maintenance_items(item_id),object_type TEXT NOT NULL CHECK(object_type IN('claim','mention','alias','note')),object_id TEXT NOT NULL,action TEXT NOT NULL CHECK(action IN('keep-parent','move-child','copy-child','retract','review','unchanged')),target_concept_id TEXT REFERENCES concepts(concept_id),confidence INTEGER NOT NULL CHECK(confidence BETWEEN 0 AND 1000000),reason TEXT NOT NULL,applied_generation INTEGER REFERENCES published_generations(generation),UNIQUE(maintenance_item_id,object_type,object_id)) STRICT"
    statements[statements.0 + 1] = "CREATE TABLE query_gaps(gap_id TEXT PRIMARY KEY,question_hash TEXT NOT NULL,normalized_question TEXT NOT NULL,gap_text TEXT NOT NULL,trace_id TEXT NOT NULL,observed_generation INTEGER NOT NULL REFERENCES published_generations(generation),occurrence_count INTEGER NOT NULL CHECK(occurrence_count>0),state TEXT NOT NULL CHECK(state IN('open','resolved','dismissed')),first_observed_at TEXT NOT NULL,last_observed_at TEXT NOT NULL,UNIQUE(question_hash,gap_text,observed_generation)) STRICT"
    statements[statements.0 + 1] = "CREATE INDEX sources_visibility ON sources(visible_from_generation,visible_to_generation)"
    statements[statements.0 + 1] = "CREATE INDEX source_revisions_visibility ON source_revisions(source_id,visible_from_generation,visible_to_generation)"
    statements[statements.0 + 1] = "CREATE INDEX revision_chunks_visibility ON revision_chunks(revision_id,visible_from_generation,visible_to_generation)"
    statements[statements.0 + 1] = "CREATE INDEX claims_visibility ON claims(visible_from_generation,visible_to_generation)"
    statements[statements.0 + 1] = "CREATE INDEX claim_support_visibility ON claim_support(claim_id,visible_from_generation,visible_to_generation)"
    statements[statements.0 + 1] = "CREATE INDEX job_items_claim ON job_items(job_id,state,priority,retry_at,item_id)"
    statements[statements.0 + 1] = "CREATE INDEX job_events_page ON job_events(job_id,event_id)"
    statements[statements.0 + 1] = "CREATE INDEX analysis_notes_state ON analysis_notes(state,note_kind,importance,note_id)"
    statements[statements.0 + 1] = "CREATE INDEX analysis_note_links_object ON analysis_note_links(object_type,object_id,note_id)"
    statements[statements.0 + 1] = "CREATE INDEX maintenance_items_work ON maintenance_items(run_id,state,score,item_id)"
    statements[statements.0 + 1] = "CREATE INDEX concept_versions_generation ON concept_versions(generation,lifecycle_state,concept_id)"
    statements[statements.0 + 1] = "CREATE INDEX query_gaps_work ON query_gaps(state,occurrence_count,last_observed_at,gap_id)"
