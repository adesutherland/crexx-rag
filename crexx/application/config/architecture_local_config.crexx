options levelg

namespace architecture_local_config expose architecturelocalconfig

import ragconfig

architecturelocalconfig: procedure = .ragconfig
  include_patterns = .string[]
  include_patterns[1] = "**/*.md"
  include_patterns[2] = "**/*.txt"
  include_patterns[3] = "**/*.rexx"
  include_patterns[4] = "**/*.crexx"
  source_sets = .ragsourceset[]
  source_sets[1] = .ragsourceset("architecture-docs", "folder", "./source-docs", include_patterns, "relative-path", "internal", 1)

  providers = .ragproviderconfig[]
  providers[1] = .ragproviderconfig("local-chat", "openai-compatible", "http://127.0.0.1:8080/v1", "local-chat-model", "local", "restricted-ok", .ragsecretref(), 30000, 2)
  providers[2] = .ragproviderconfig("local-embed", "openai-compatible", "http://127.0.0.1:8081/v1", "nomic-embed-text-v1-5", "local", "restricted-ok", .ragsecretref(), 30000, 2)
  providers[3] = .ragproviderconfig("hosted-strong", "openai", "https://api.openai.com/v1", "configured-hosted-model", "hosted", "public-only", .ragsecretref("env", "OPENAI_API_KEY"), 60000, 2)

  roles = .ragrolebinding[]
  roles[1] = .ragrolebinding("advisory", "local-chat", 65536, 4096, 100000, 0, 1, 0, "Summarize only the supplied deterministic corpus report. Explain major subjects, relationships, health, maintenance backlog and important limitations. Do not invent facts. Every substantive statement must cite one of the supplied report citations.")
  roles[2] = .ragrolebinding("extractor", "local-chat", 8192, 4096, 100000, 0, 1, 0, "Discover zero or more concepts, directional typed relationships, and important grounded analysis notes in the supplied evidence. Return only grounded output with exact UTF-8 source spans.")
  roles[3] = .ragrolebinding("embedding", "local-embed", 8192, 0, 1000, 768, 100, 0, "")
  roles[4] = .ragrolebinding("answerer", "local-chat", 65536, 1024, 100000, 0, 1, 0, "Answer only from the supplied evidence. Return supported, partial, or insufficient grounding and exact supplied citations. Do not invent facts or citations.")

  profile_ids = .string[]
  profile_ids[1] = "generic-profile"
  profile_ids[2] = "it-architecture-profile"

  budget = .ragbudget(120, 1000, 200, 200000, 100000, 5000000)
  workers = .ragworkerpolicy(2, 1, 120)
  schedules = .ragschedule[]
  schedules[1] = .ragschedule("manual-maintenance", "manual", 1, "maintain.plan")
  profile_files = .ragprofilefilebinding[]
  return .ragconfig("architecture-local", "1", source_sets, providers, roles, profile_ids, budget, workers, schedules, .ragdiscoverypolicy(), .ragvectorpolicy(), .ragretrievalpolicy(), .ragmaintenancepolicy(), .ragobservationpolicy(), profile_files)
