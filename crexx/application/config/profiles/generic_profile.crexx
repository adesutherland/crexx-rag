options levelg

namespace generic_profile expose genericprofile

import ragprofile

genericprofile: procedure = .ragprofile
  concept_types = .string[]
  concept_types[1] = "concept"
  concept_types[2] = "source-artifact"
  concept_types[3] = "evidence-span"

  relationship_types = .ragrelationshiptype[]
  relationship_types[1] = .ragrelationshiptype("related-to", "related-to", 0)
  relationship_types[2] = .ragrelationshiptype("mentioned-in", "mentions", 1)
  relationship_types[3] = .ragrelationshiptype("mentions", "mentioned-in", 1)

  aliases = .ragalias[]
  formats = .string[]
  formats[1] = "plain"
  formats[2] = "markdown"
  formats[3] = "rexx"
  chunk_policy = .ragchunkpolicy(1200, 160, formats)

  ranking_weights = .ragrankingweight[]
  ranking_weights[1] = .ragrankingweight("lexical", 1.0)
  ranking_weights[2] = .ragrankingweight("semantic", 1.0)
  ranking_weights[3] = .ragrankingweight("graph", 0.8)

  prompts = .ragprompttemplate[]
  prompts[1] = .ragprompttemplate("advisory", "1", "generic-advisory")
  prompts[2] = .ragprompttemplate("extractor", "1", "generic-extractor")
  prompts[3] = .ragprompttemplate("answerer", "1", "generic-answerer")

  validators = .string[]
  validators[1] = "direction-required"
  validators[2] = "support-required"
  return .ragprofile("generic-profile", "1", concept_types, relationship_types, aliases, chunk_policy, ranking_weights, prompts, validators)
