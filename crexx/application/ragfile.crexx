/*
 * Minimized Level-B foundation exception for opaque binary sidecars.
 * Level G has no binary file-read API that also exposes a caller-controlled
 * byte ceiling and byte count. This module performs only byte-preserving file
 * I/O and delegates incremental SHA-256 to the installed generic rxhash
 * facility; all storage policy remains in Level G.
 */
options levelb

namespace ragfile expose sha256filebounded writebinaryfile

import rxfnsb
import rxhash

writebinaryfile: procedure = .int
  arg path = .string, data = .binary, expose error = .string
  error = ""
  if path = "" then do
    error = "binary file path is required"
    return -1
  end
  mode = "wb"; file_id = 0
  assembler fopen file_id,path,mode
  if file_id = 0 then do
    error = "could not open binary file for writing"
    return -2
  end
  assembler fwriteb file_id,data
  flush_status = 0; write_error = 0; close_status = 0
  assembler fflush flush_status,file_id
  assembler ferror write_error,file_id
  assembler fclose close_status,file_id
  if flush_status \= 0 | write_error \= 0 | close_status \= 0 then do
    error = "could not write or close binary file"
    return -3
  end
  return 0

sha256filebounded: procedure = .int
  arg path = .string, maximum_bytes = .int, expose digest = .string, expose byte_count = .int, expose error = .string
  digest = ""; byte_count = 0; error = ""
  if path = "" | maximum_bytes < 1 then do
    error = "binary file path and positive size ceiling are required"
    return -1
  end
  mode = "rb"; file_id = 0
  assembler fopen file_id,path,mode
  if file_id = 0 then do
    error = "could not open binary file"
    return -2
  end
  state = rxhash..sha256init()
  chunk_size = 65536
  do forever
    chunk = .binary
    assembler freadb chunk,file_id,chunk_size
    count = binlength(chunk)
    if count = 0 then leave
    if byte_count + count > maximum_bytes then do
      close_status = 0
      assembler fclose close_status,file_id
      error = "binary file exceeds the configured verification ceiling"
      return -3
    end
    state = rxhash..sha256update(state, chunk)
    byte_count = byte_count + count
  end
  read_error = 0; close_status = 0
  assembler ferror read_error,file_id
  assembler fclose close_status,file_id
  if read_error \= 0 | close_status \= 0 then do
    error = "could not read or close binary file"
    return -3
  end
  digest = rxhash..sha256finalhex(state)
  return 0
