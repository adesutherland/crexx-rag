/* Profile definitions may remain compiled defaults or be supplied as bounded
 * operator data.  A binding names the expected profile identity and its data
 * file; it never selects executable code. */
ragprofilefilebinding: class
  _profile_id = .string
  _path = .string

  *: factory
    arg profile_id = "", path = ""
    _profile_id = profile_id
    _path = path
    return

  profile_id: method = .string
    return _profile_id
  path: method = .string
    return _path

