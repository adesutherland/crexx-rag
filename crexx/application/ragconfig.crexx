ragconfig: class
  _config_id = .string
  _version = .string
  _source_sets = .ragsourceset[]
  _providers = .ragproviderconfig[]
  _roles = .ragrolebinding[]
  _profile_ids = .string[]
  _profile_files = .ragprofilefilebinding[]
  _budget = .ragbudget
  _workers = .ragworkerpolicy
  _schedules = .ragschedule[]
  _discovery = .ragdiscoverypolicy
  _vector = .ragvectorpolicy
  _retrieval = .ragretrievalpolicy
  _maintenance = .ragmaintenancepolicy
  _observation = .ragobservationpolicy
  _plan_ttl_seconds = .int

  *: factory
    arg config_id = .string, version = .string, source_sets = .ragsourceset[], providers = .ragproviderconfig[], roles = .ragrolebinding[], profile_ids = .string[], budget = .ragbudget, workers = .ragworkerpolicy, schedules = .ragschedule[], discovery = .ragdiscoverypolicy, vector = .ragvectorpolicy, retrieval = .ragretrievalpolicy(), maintenance = .ragmaintenancepolicy(), observation = .ragobservationpolicy(), profile_files = .ragprofilefilebinding[], plan_ttl_seconds = 3600
    _config_id = config_id
    _version = version
    _source_sets = source_sets
    _providers = providers
    _roles = roles
    _profile_ids = profile_ids
    _profile_files = profile_files
    _budget = budget
    _workers = workers
    _schedules = schedules
    _discovery = discovery
    _vector = vector
    _retrieval = retrieval
    _maintenance = maintenance
    _observation = observation
    _plan_ttl_seconds = plan_ttl_seconds
    return

  config_id: method = .string
    return _config_id
  version: method = .string
    return _version
  source_sets: method = .ragsourceset[]
    return _source_sets
  providers: method = .ragproviderconfig[]
    return _providers
  roles: method = .ragrolebinding[]
    return _roles
  profile_ids: method = .string[]
    return _profile_ids
  profile_files: method = .ragprofilefilebinding[]
    return _profile_files
  budget: method = .ragbudget
    return _budget
  workers: method = .ragworkerpolicy
    return _workers
  schedules: method = .ragschedule[]
    return _schedules
  discovery: method = .ragdiscoverypolicy
    return _discovery
  vector: method = .ragvectorpolicy
    return _vector
  retrieval: method = .ragretrievalpolicy
    return _retrieval
  maintenance: method = .ragmaintenancepolicy
    return _maintenance
  observation: method = .ragobservationpolicy
    return _observation
  plan_ttl_seconds: method = .int
    return _plan_ttl_seconds
  valid_identity: method = .int
    return validregistryid(_config_id) = 1 & _version \= ""
  snapshot: method = .ragconfigsnapshot
    source_set_ids = .string[]
    do i = 1 to _source_sets.0
      source_set_ids[i] = _source_sets[i].source_set_id()
    end
    provider_ids = .string[]
    secret_references = .string[]
    do i = 1 to _providers.0
      provider_ids[i] = _providers[i].provider_id()
      credential = _providers[i].credential()
      if credential.empty() = 0 then secret_references[secret_references.0 + 1] = credential.ref_string()
    end
    role_routes = .string[]
    do i = 1 to _roles.0
      role_routes[i] = _roles[i].role() || ":" || _roles[i].provider_id()
    end
    return .ragconfigsnapshot(_config_id, _version, source_set_ids, provider_ids, role_routes, _profile_ids, secret_references, _budget, _workers)

ragconfigsnapshot: class
  _config_id = .string
  _version = .string
  _source_set_ids = .string[]
  _provider_ids = .string[]
  _role_routes = .string[]
  _profile_ids = .string[]
  _secret_references = .string[]
  _budget = .ragbudget
  _workers = .ragworkerpolicy

  *: factory
    arg config_id = .string, version = .string, source_set_ids = .string[], provider_ids = .string[], role_routes = .string[], profile_ids = .string[], secret_references = .string[], budget = .ragbudget, workers = .ragworkerpolicy
    _config_id = config_id
    _version = version
    _source_set_ids = source_set_ids
    _provider_ids = provider_ids
    _role_routes = role_routes
    _profile_ids = profile_ids
    _secret_references = secret_references
    _budget = budget
    _workers = workers
    return

  config_id: method = .string
    return _config_id
  version: method = .string
    return _version
  source_set_ids: method = .string[]
    return _source_set_ids
  provider_ids: method = .string[]
    return _provider_ids
  role_routes: method = .string[]
    return _role_routes
  profile_ids: method = .string[]
    return _profile_ids
  secret_references: method = .string[]
    return _secret_references
  secret_reference_count: method = .int
    return _secret_references.0
  secret_reference: method = .string
    arg index = .int
    if index < 1 | index > _secret_references.0 then return ""
    return _secret_references[index]
  budget: method = .ragbudget
    return _budget
  workers: method = .ragworkerpolicy
    return _workers

validateconfig: procedure = .ragvalidationresult
  arg config = .ragconfig
  issues = .ragvalidationissue[]
  if validregistryid(config.config_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", "config.id", "configuration id must be a registered identifier")
  if config.version() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_version", "config.version", "configuration version is required")

  source_sets = config.source_sets()
  if source_sets.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_source_set", "source_sets", "at least one source set is required")
  seen = .string[]
  do i = 1 to source_sets.0
    source_set = source_sets[i]
    path = "source_sets[" || i || "]"
    if validregistryid(source_set.source_set_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "source-set id is invalid")
    if _contains(seen, source_set.source_set_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "source-set id is duplicated")
    seen[seen.0 + 1] = source_set.source_set_id()
    patterns = source_set.include_patterns()
    if source_set.connector() \= "folder" then issues[issues.0 + 1] = .ragvalidationissue("config", "unsupported_connector", path || ".connector", "only the folder connector is currently supported")
    if source_set.root() = "" | patterns.0 = 0 | source_set.stable_key() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "incomplete_source_set", path, "source root, patterns, and stable-key policy are required")
    if source_set.maximum_file_bytes() < 1 | source_set.maximum_file_bytes() > 2147483647 | source_set.maximum_depth() < 0 | source_set.maximum_depth() > 256 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_source_guard", path, "source file byte ceiling or depth is outside its supported range")
    privacy = source_set.privacy()
    if privacy \= "local" & privacy \= "internal" & privacy \= "restricted" & privacy \= "public" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_privacy", path || ".privacy", "source privacy class is invalid")
    if source_set.retain_raw_artifact() \= 0 & source_set.retain_raw_artifact() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_boolean", path || ".retain_raw_artifact", "retain-raw-artifact must be boolean")
  end

  if config.plan_ttl_seconds() < 1 | config.plan_ttl_seconds() > 604800 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_plan_ttl", "plan.ttl_seconds", "plan TTL must be 1 through 604800 seconds")
  providers = config.providers()
  if providers.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_provider", "providers", "at least one provider is required")
  seen = .string[]
  do i = 1 to providers.0
    provider = providers[i]
    path = "providers[" || i || "]"
    if validregistryid(provider.provider_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "provider id is invalid")
    if _contains(seen, provider.provider_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "provider id is duplicated")
    seen[seen.0 + 1] = provider.provider_id()
    kind = provider.kind()
    if kind \= "openai-compatible" & kind \= "openai" & kind \= "anthropic" & kind \= "gemini" & kind \= "codex" & kind \= "llama" then issues[issues.0 + 1] = .ragvalidationissue("config", "unsupported_provider", path || ".kind", "provider kind is not supported")
    route_class = provider.route_class()
    if route_class \= "local" & route_class \= "hosted" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_route", path || ".route_class", "provider route must be local or hosted")
    if provider.base_url() = "" | provider.model() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "incomplete_provider", path, "provider base URL and model are required")
    if kind = "codex" then do
      if provider.base_url() \= "app-server://local" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_url", path || ".base_url", "Codex must use app-server://local")
      if route_class \= "hosted" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_route", path || ".route_class", "Codex is a hosted privacy route")
    end
    else if kind = "llama" then do
      if provider.base_url() \= "llama://local" | route_class \= "local" | provider.model() \= "bge-small-en-v1.5" | provider.model_path() = "" | provider.credential().empty() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config","invalid_native_embedding",path,"llama requires llama://local, local route, bge-small-en-v1.5, model_path and no credential")
      if provider.context_tokens() \= 512 | provider.embedding_dimensions_minimum() \= 384 | provider.embedding_dimensions_maximum() \= 384 | provider.maximum_output_tokens() \= 0 then issues[issues.0 + 1] = .ragvalidationissue("config","invalid_native_capability",path,"native BGE requires 512 tokens per window, 384 dimensions and no generated output")
    end
    else do
      if left(provider.base_url(), 7) \= "http://" & left(provider.base_url(), 8) \= "https://" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_url", path || ".base_url", "provider URL must use HTTP or HTTPS")
      if route_class = "hosted" & left(provider.base_url(), 8) \= "https://" then issues[issues.0 + 1] = .ragvalidationissue("config", "insecure_hosted_url", path || ".base_url", "hosted provider URL must use HTTPS")
    end
    if provider.reasoning_effort() \= "" then do
      if kind \= "codex" | words(provider.reasoning_effort()) \= 1 | wordpos(provider.reasoning_effort(), "none minimal low medium high xhigh max") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_reasoning_effort", path || ".reasoning_effort", "reasoning_effort requires Codex and a supported effort name")
    end
    if kind \= "llama" & provider.model_path() \= "" then issues[issues.0 + 1] = .ragvalidationissue("config","unexpected_model_path",path,"model_path requires the llama provider")
    privacy_policy = provider.privacy_policy()
    if privacy_policy \= "local-only" & privacy_policy \= "restricted-ok" & privacy_policy \= "public-only" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_privacy_policy", path || ".privacy_policy", "provider privacy policy is invalid")
    credential = provider.credential()
    if credential.valid() = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "secret_reference", path || ".credential", "credential must be an env reference")
    if kind = "codex" & credential.empty() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "unexpected_credential", path || ".credential", "Codex App Server owns authentication and must not receive a credential reference")
    if route_class = "hosted" & kind \= "codex" & credential.empty() = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_credential", path || ".credential", "hosted provider credential reference is required")
    if provider.timeout_ms() <= 0 | provider.max_attempts() < 1 | provider.max_attempts() > 10 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_limits", path, "provider timeout and attempt limits are invalid")
    if provider.requests_per_minute() < 1 | provider.requests_per_minute() > 60000 | provider.tokens_per_minute() < 1 | provider.tokens_per_minute() > 2000000000 | provider.concurrent_requests() < 1 | provider.concurrent_requests() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_rate", path, "provider request, token, or concurrency limits are invalid")
    if provider.initial_backoff_ms() < 1 | provider.initial_backoff_ms() > 60000 | provider.maximum_backoff_ms() < provider.initial_backoff_ms() | provider.maximum_backoff_ms() > 600000 | provider.jitter_ms() < 0 | provider.jitter_ms() > 60000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_backoff", path, "provider retry backoff or jitter limits are invalid")
    if provider.context_tokens() < 1 | provider.maximum_output_tokens() < 0 | provider.maximum_batch_size() < 1 | provider.maximum_batch_size() > 4096 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_capability", path, "provider context, output, or batch capability is invalid")
    if provider.embedding_dimensions_minimum() < 0 | provider.embedding_dimensions_maximum() < provider.embedding_dimensions_minimum() | provider.embedding_dimensions_maximum() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_embedding_capability", path, "provider embedding dimension capability is invalid")
    if provider.input_price_microunits_per_million() < -1 | provider.output_price_microunits_per_million() < -1 | provider.catalog_observed_date() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_catalog", path, "provider catalogue price or observation identity is invalid")
  end

  roles = config.roles()
  seen = .string[]
  do i = 1 to roles.0
    role = roles[i]
    path = "roles[" || i || "]"
    role_id = role.role()
    if role_id \= "advisory" & role_id \= "extractor" & role_id \= "embedding" & role_id \= "answerer" & role_id \= "resolver" & role_id \= "advanced-resolver" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_role", path || ".role", "provider role is invalid")
    if _contains(seen, role_id) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_role", path || ".role", "provider role is duplicated")
    seen[seen.0 + 1] = role_id
    if _provider_exists(providers, role.provider_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "unknown_provider", path || ".provider_id", "role references an unknown provider id")
    if role.maximum_input_tokens() < 1 | role.maximum_output_tokens() < 0 | role.maximum_call_cost_microunits() < 0 | role.batch_size() < 1 | role.temperature_millionths() < 0 | role.temperature_millionths() > 2000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_role_envelope", path, "role input, output, cost, batch, or temperature envelope is invalid")
    if role_id = "embedding" then do
      if role.maximum_output_tokens() \= 0 | role.embedding_dimensions() < 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_embedding_role", path, "embedding role requires dimensions and zero output tokens")
    end
    else if role.maximum_output_tokens() < 1 | role.embedding_dimensions() \= 0 | role.system_prompt() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_generation_role", path, "generation role requires output tokens, no embedding dimension, and a system prompt")
    do p = 1 to providers.0
      if providers[p].provider_id() \= role.provider_id() then iterate
      if providers[p].kind() = "llama" & (role_id \= "embedding" | role.embedding_dimensions() \= 384) then issues[issues.0 + 1] = .ragvalidationissue("config","native_embedding_role",path,"native BGE supports only the embedding role with 384 dimensions")
      /* Native embedding input allowance covers the complete chunk, including
       * overlap; the provider's 512-token context applies to each window. */
      if providers[p].kind() \= "llama" & role.maximum_input_tokens() > providers[p].context_tokens() then issues[issues.0 + 1] = .ragvalidationissue("config", "role_context_exceeded", path || ".maximum_input_tokens", "role input envelope exceeds the configured provider catalogue capability")
      if role.maximum_output_tokens() > providers[p].maximum_output_tokens() then issues[issues.0 + 1] = .ragvalidationissue("config", "role_output_exceeded", path || ".maximum_output_tokens", "role output envelope exceeds the configured provider catalogue capability")
      if role_id = "embedding" & (role.embedding_dimensions() < providers[p].embedding_dimensions_minimum() | role.embedding_dimensions() > providers[p].embedding_dimensions_maximum() | role.batch_size() > providers[p].maximum_batch_size()) then issues[issues.0 + 1] = .ragvalidationissue("config", "role_embedding_exceeded", path, "embedding role dimensions or batch size exceed the configured provider catalogue capability")
    end
  end
  if _contains(seen, "advisory") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.advisory", "required provider role is missing")
  if _contains(seen, "extractor") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.extractor", "required provider role is missing")
  if _contains(seen, "embedding") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.embedding", "required provider role is missing")

  profile_ids = config.profile_ids()
  if profile_ids.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_profile", "profiles", "at least one registered profile id is required")
  seen = .string[]
  do i = 1 to profile_ids.0
    if validregistryid(profile_ids[i]) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", "profiles[" || i || "]", "profile id is invalid")
    if _contains(seen, profile_ids[i]) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", "profiles[" || i || "]", "profile id is duplicated")
    seen[seen.0 + 1] = profile_ids[i]
  end
  profile_files = config.profile_files()
  clear seen
  do i = 1 to profile_files.0
    binding = profile_files[i]
    if validregistryid(binding.profile_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", "profile_files[" || i || "].id", "profile-file id is invalid")
    if _contains(seen, binding.profile_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", "profile_files[" || i || "].id", "profile-file id is duplicated")
    if _contains(profile_ids, binding.profile_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "unused_profile_file", "profile_files[" || i || "].id", "profile-file id must also appear in profiles")
    if binding.path() = "" | length(binding.path()) > 4096 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_profile_file", "profile_files[" || i || "].path", "profile-file path is invalid")
    seen[seen.0 + 1] = binding.profile_id()
  end

  budget = config.budget()
  if budget.minutes() < 0 | budget.item_limit() < 0 | budget.model_calls() < 0 | budget.input_tokens() < 0 | budget.output_tokens() < 0 | budget.cost_microunits() < 0 | budget.codex_turns() < 0 | budget.minimum_codex_allowance_percent() < 0 | budget.minimum_codex_allowance_percent() > 100 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_budget", "budget", "budget ceilings and Codex allowance threshold are invalid")
  workers = config.workers()
  if workers.processes() < 1 | workers.processes() > 32 then issues[issues.0 + 1] = .ragvalidationissue("config", "worker_processes", "workers.processes", "worker processes must be from 1 through 32")
  if workers.max_in_flight() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "worker_in_flight", "workers.max_in_flight", "each worker process currently owns one in-flight item")
  if workerinrange("lease_seconds",workers.lease_seconds()) \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_lease", "workers.lease_seconds", "worker lease must be from 1 through 86400 seconds")
  if workerinrange("restart_window_seconds",workers.restart_window_seconds()) \= 1 | workerinrange("max_restarts",workers.max_restarts()) \= 1 | workerinrange("restart_backoff_ms",workers.restart_backoff_ms()) \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_worker_recovery", "workers", "worker restart ceiling or backoff is invalid")
  if workerinrange("poll_ms",workers.poll_ms()) \= 1 | workerinrange("guided_deadline_seconds",workers.guided_deadline_seconds()) \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_worker_runtime", "workers", "worker poll and guided deadline policy is invalid")

  discovery = config.discovery()
  if wordpos(discovery.mode(), "all ranked maintenance off") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_mode", "discovery.mode", "discovery mode must be all, ranked, maintenance, or off")
  if discovery.ranked_limit() < 1 | discovery.ranked_limit() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.ranked_limit", "ranked discovery limit is outside its supported range")
  if discovery.max_mentions() < 1 | discovery.max_mentions() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_mentions", "maximum discovered mentions must be from 1 through 64")
  if discovery.max_relationships() < 1 | discovery.max_relationships() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_relationships", "maximum discovered relationships must be from 1 through 64")
  if discovery.max_notes() < 1 | discovery.max_notes() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_notes", "maximum discovered notes must be from 1 through 64")

  vector = config.vector()
  if (vector.algorithm() \= "ivf-flat-v1" & vector.algorithm() \= "exact-native-v1") then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_algorithm", "vector.algorithm", "vector.algorithm must be ivf-flat-v1 or exact-native-v1")
  if vector.centroids() < 1 | vector.centroids() > 4096 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.centroids", "vector centroid count is outside its supported range")
  if vector.probes() < 1 | vector.probes() > vector.centroids() then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.probes", "vector probes must be positive and no greater than centroids")
  if vector.iterations() < 1 | vector.iterations() > 16 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.iterations", "vector training iterations must be from 1 through 16")
  if vector.recall_minimum_millionths() < 1 | vector.recall_minimum_millionths() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_recall", "vector.recall_minimum_millionths", "vector recall threshold must be from 1 through 1000000")
  if vector.maximum_rows() < 1 | vector.maximum_rows() > 1000000 | vector.maximum_sidecar_bytes() < 1048576 | vector.maximum_sidecar_bytes() > 2000000000 | vector.embedding_maximum_items() < 1 | vector.embedding_maximum_items() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_scale", "vector", "vector row, sidecar, or embedding work ceiling is invalid")

  retrieval = config.retrieval()
  if retrieval.lexical_candidates() < 1 | retrieval.lexical_candidates() > 1000 | retrieval.vector_candidates() < 1 | retrieval.vector_candidates() > 1000 | retrieval.vector_scan_limit() < retrieval.vector_candidates() | retrieval.vector_scan_limit() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_retrieval_limit", "retrieval", "retrieval candidate and vector scan limits are invalid")
  if retrieval.graph_hops() < 0 | retrieval.graph_hops() > 4 | retrieval.passage_limit() < 1 | retrieval.passage_limit() > querypassagemaximum() | retrieval.claim_limit() < 0 | retrieval.claim_limit() > 8 | retrieval.lead_limit() < 0 | retrieval.lead_limit() > 8 | retrieval.rrf_k() < 1 | retrieval.rrf_k() > 10000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_retrieval_policy", "retrieval", "retrieval graph, passage, claim, lead, or RRF limits are invalid")
  if retrieval.graph_boost_millionths() < 0 | retrieval.graph_boost_millionths() > 1000000 | retrieval.graph_decay_millionths() < 1 | retrieval.graph_decay_millionths() > 1000000 | retrieval.directness_bonus_millionths() < 0 | retrieval.directness_bonus_millionths() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_retrieval_ranking", "retrieval", "retrieval graph ranking values are invalid")
  if wordpos(retrieval.graph_direction(), "outbound inbound both") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_graph_direction", "retrieval.graph_direction", "graph direction must be outbound, inbound, or both")
  if retrieval.maximum_evidence_bytes() < 65536 | retrieval.maximum_evidence_bytes() > 1048576 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_retrieval_evidence_limit", "retrieval.maximum_evidence_bytes", "retrieval evidence byte ceiling must be from 65536 through 1048576")

  maintenance = config.maintenance()
  if maintenance.provider_time_minutes() < 0 | maintenance.provider_time_minutes() > 10080 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_time", "maintenance", "maintenance provider time must be 0..10080 minutes")
  if wordpos(maintenance.mode(), "automatic supervised reviewed manual") = 0 | maintenance.window_seconds() < 1 | maintenance.window_seconds() > 86400 | maintenance.maximum_impact() < 1 | maintenance.maximum_impact() > 100000 | maintenance.maximum_attempts() < 1 | maintenance.maximum_attempts() > 10 | maintenance.retry_seconds() < 1 | maintenance.retry_seconds() > 604800 | maintenance.maximum_evidence_bytes() < 1024 | maintenance.maximum_evidence_bytes() > 1048576 | maintenance.resolution_prompt() = "" | length(maintenance.resolution_prompt()) > 16384 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_resolution_policy", "maintenance", "maintenance resolution limits or mode are invalid")
  if maintenance.advanced_attempts()<1 | maintenance.advanced_attempts()>32 | maintenance.search_reads()<0 | maintenance.search_reads()>16 | maintenance.evidence_expected()<0 | maintenance.evidence_expected()>1 | maintenance.advanced_first()<0 | maintenance.advanced_first()>1 | length(maintenance.identity_prompt())>16384 | length(maintenance.connection_prompt())>16384 then issues[issues.0+1]=.ragvalidationissue("config","invalid_resolution_policy","maintenance","resolution route, read or evidence-arrival policy is invalid")
  do a = 1 to words(maintenance.automatic_actions())
    if wordpos(word(maintenance.automatic_actions(), a), "reuse distinct split merge synonym type-correction retire restore move retract qualify retain investigate no-change defer") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_automatic_action", "maintenance.automatic_actions", "unknown automatic resolution action")
  end
  if maintenance.sparse_max_degree() < 0 | maintenance.sparse_max_degree() > 1000 | maintenance.query_gap_min_occurrences() < 1 | maintenance.query_gap_min_occurrences() > 1000000 | maintenance.batch_items() < 1 | maintenance.batch_items() > 100000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_maintenance_policy", "maintenance", "maintenance batch or census thresholds are invalid")

  observation = config.observation()
  if observation.capture_threshold() < 1 | observation.capture_threshold() > 1000000 | observation.cooldown_seconds() < 0 | observation.cooldown_seconds() > 604800 | observation.maximum_staleness_seconds() < 1 | observation.maximum_staleness_seconds() > 31536000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_observation_timing", "observation", "observation capture, cooldown, or staleness values are invalid")
  if observation.work_minimum_change() < 1 | observation.work_relative_millionths() < 1 | observation.work_relative_millionths() > 1000000 | observation.dead_letter_minimum_change() < 1 | observation.review_minimum_change() < 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_observation_churn", "observation", "observation churn thresholds must be positive and bounded")
  if observation.narrative_output_tokens() < 256 | observation.narrative_output_tokens() > 8192 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_narrative_output_limit", "observation.narrative_output_tokens", "narrative output tokens must be from 256 through 8192")

  schedules = config.schedules()
  seen = .string[]
  do i = 1 to schedules.0
    schedule = schedules[i]
    path = "schedules[" || i || "]"
    if validregistryid(schedule.schedule_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "schedule id is invalid")
    if _contains(seen, schedule.schedule_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "schedule id is duplicated")
    seen[seen.0 + 1] = schedule.schedule_id()
    if schedule.trigger() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_trigger", path || ".trigger", "schedule trigger is required")
    if schedule.enabled() = 1 & wordpos(schedule.operation(), "maintain.plan library.snapshot library.backup library.report") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_schedule_operation", path || ".operation", "enabled schedule operation must be maintain.plan, library.snapshot, library.backup, or library.report")
    if schedule.enabled() \= 0 & schedule.enabled() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_boolean", path || ".enabled", "schedule enabled must be boolean")
  end
  return .ragvalidationresult(issues)

snapshotconfig: procedure = .ragconfigsnapshot
  arg config = .ragconfig
  return config.snapshot()

invalidconfig: procedure = .ragconfig
  source_sets = .ragsourceset[]
  providers = .ragproviderconfig[]
  roles = .ragrolebinding[]
  profile_ids = .string[]
  schedules = .ragschedule[]
  profile_files = .ragprofilefilebinding[]
  return .ragconfig("", "", source_sets, providers, roles, profile_ids, .ragbudget(0, 0, 0, 0, 0, 0), .ragworkerpolicy(0, 0, 0), schedules, .ragdiscoverypolicy(), .ragvectorpolicy(), .ragretrievalpolicy(), .ragmaintenancepolicy(), .ragobservationpolicy(), profile_files)

_contains: procedure = .int
  arg values = .string[], expected = .string
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_provider_exists: procedure = .int
  arg providers = .ragproviderconfig[], provider_id = .string
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return 1
  end
  return 0

/* Shared effective configuration/citation helpers consumed by domain services. */
roleproviderconfig: procedure = .ragproviderconfig
  arg config = .ragconfig, role = .string
  provider_id = ""; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].role() = role then provider_id = roles[i].provider_id()
  end
  providers = config.providers()
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return providers[i]
  end
  return .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)
rolebinding: procedure = .ragrolebinding
  arg config = .ragconfig, role = .string
  roles = config.roles()
  do i = 1 to roles.0
    if roles[i].role() = role then return roles[i]
  end
  return .ragrolebinding()
