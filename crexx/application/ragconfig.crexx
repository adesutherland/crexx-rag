options levelg

namespace ragconfig expose ragsecretref ragsourceset ragproviderconfig ragrolebinding ragprofilefilebinding ragbudget ragworkerpolicy ragschedule ragdiscoverypolicy ragvectorpolicy ragretrievalpolicy ragmaintenancepolicy ragobservationpolicy ragconfig ragconfigsnapshot validateconfig snapshotconfig invalidconfig roleproviderconfig rolebinding querypassagemaximum

import ragmodel
import rxfnsb
import ragworkerdefaults

/* Shared passage ceiling for typed/file configuration, retrieval and surfaces.
   The ordinary default remains twelve; this is an optional request ceiling. */
querypassagemaximum: procedure = .int
  return 200

ragsecretref: class
  _scheme = .string
  _name = .string

  *: factory
    arg scheme = "", name = ""
    _scheme = scheme
    _name = name
    return

  scheme: method = .string
    return _scheme
  name: method = .string
    return _name
  empty: method = .int
    return _scheme = "" & _name = ""
  valid: method = .int
    if empty() = 1 then return 1
    return _scheme = "env" & validenvname(_name) = 1
  ref_string: method = .string
    if empty() = 1 then return ""
    return _scheme || ":" || _name

