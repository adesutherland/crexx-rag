options levelg

namespace ragconfig expose ragsecretref ragsourceset ragproviderconfig ragrolebinding ragbudget ragworkerpolicy ragschedule ragdiscoverypolicy ragvectorpolicy ragconfig ragconfigsnapshot validateconfig snapshotconfig invalidconfig

import ragmodel
import rxfnsb

ragsecretref: class
  _scheme = .string
  _name = .string

  *: factory
    arg scheme = "", name = ""
    _scheme = scheme
    _name = name
    return

  scheme: method = .string
    return _scheme
  name: method = .string
    return _name
  empty: method = .int
    return _scheme = "" & _name = ""
  valid: method = .int
    if empty() = 1 then return 1
    return _scheme = "env" & validenvname(_name) = 1
  ref_string: method = .string
    if empty() = 1 then return ""
    return _scheme || ":" || _name

ragsourceset: class
  _source_set_id = .string
  _connector = .string
  _root = .string
  _include_patterns = .string[]
  _stable_key = .string
  _privacy = .string
  _retain_raw_artifact = .int

  *: factory
    arg source_set_id = .string, connector = .string, root = .string, include_patterns = .string[], stable_key = .string, privacy = .string, retain_raw_artifact = .int
    _source_set_id = source_set_id
    _connector = connector
    _root = root
    _include_patterns = include_patterns
    _stable_key = stable_key
    _privacy = privacy
    _retain_raw_artifact = retain_raw_artifact
    return

  source_set_id: method = .string
    return _source_set_id
  connector: method = .string
    return _connector
  root: method = .string
    return _root
  include_patterns: method = .string[]
    return _include_patterns
  stable_key: method = .string
    return _stable_key
  privacy: method = .string
    return _privacy
  retain_raw_artifact: method = .int
    return _retain_raw_artifact

ragproviderconfig: class
  _provider_id = .string
  _kind = .string
  _base_url = .string
  _model = .string
  _route_class = .string
  _privacy_policy = .string
  _credential = .ragsecretref
  _timeout_ms = .int
  _max_attempts = .int

  *: factory
    arg provider_id = .string, kind = .string, base_url = .string, model = .string, route_class = .string, privacy_policy = .string, credential = .ragsecretref, timeout_ms = .int, max_attempts = .int
    _provider_id = provider_id
    _kind = kind
    _base_url = base_url
    _model = model
    _route_class = route_class
    _privacy_policy = privacy_policy
    _credential = credential
    _timeout_ms = timeout_ms
    _max_attempts = max_attempts
    return

  provider_id: method = .string
    return _provider_id
  kind: method = .string
    return _kind
  base_url: method = .string
    return _base_url
  model: method = .string
    return _model
  route_class: method = .string
    return _route_class
  privacy_policy: method = .string
    return _privacy_policy
  credential: method = .ragsecretref
    return _credential
  timeout_ms: method = .int
    return _timeout_ms
  max_attempts: method = .int
    return _max_attempts
  charging_basis: method = .string
    if _kind = "codex" then return "subscription-allowance"
    if _route_class = "local" then return "local-compute"
    return "monetary-api"

ragrolebinding: class
  _role = .string
  _provider_id = .string

  *: factory
    arg role = .string, provider_id = .string
    _role = role
    _provider_id = provider_id
    return

  role: method = .string
    return _role
  provider_id: method = .string
    return _provider_id

