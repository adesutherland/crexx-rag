/* Discovery is an explicit product policy.  "off" is supported only as an
 * operator-selected deterministic fallback; the normal modes all schedule
 * cognitive review. */
ragdiscoverypolicy: class
  _mode = .string
  _glossary_path = .string
  _ranked_limit = .int
  _max_mentions = .int
  _max_relationships = .int
  _max_notes = .int

  *: factory
    arg mode = "all", glossary_path = "", ranked_limit = 64, max_mentions = 16, max_relationships = 16, max_notes = 16
    _mode = mode
    _glossary_path = glossary_path
    _ranked_limit = ranked_limit
    _max_mentions = max_mentions
    _max_relationships = max_relationships
    _max_notes = max_notes
    return

  mode: method = .string
    return _mode
  glossary_path: method = .string
    return _glossary_path
  ranked_limit: method = .int
    return _ranked_limit
  max_mentions: method = .int
    return _max_mentions
  max_relationships: method = .int
    return _max_relationships
  max_notes: method = .int
    return _max_notes

/* IVF-flat is the durable vector-index publication algorithm.  The exact
 * bounded scan is deliberately absent from this production policy and exists
 * only in qualification code as a recall oracle. */
ragvectorpolicy: class
  _algorithm = .string
  _centroids = .int
  _probes = .int
  _iterations = .int
  _recall_minimum_millionths = .int

  *: factory
    arg algorithm = "ivf-flat-v1", centroids = 16, probes = 4, iterations = 2, recall_minimum_millionths = 900000
    _algorithm = algorithm
    _centroids = centroids
    _probes = probes
    _iterations = iterations
    _recall_minimum_millionths = recall_minimum_millionths
    return

  algorithm: method = .string
    return _algorithm
  centroids: method = .int
    return _centroids
  probes: method = .int
    return _probes
  iterations: method = .int
    return _iterations
  recall_minimum_millionths: method = .int
    return _recall_minimum_millionths

ragconfig: class
  _config_id = .string
  _version = .string
  _source_sets = .ragsourceset[]
  _providers = .ragproviderconfig[]
  _roles = .ragrolebinding[]
  _profile_ids = .string[]
  _budget = .ragbudget
  _workers = .ragworkerpolicy
  _schedules = .ragschedule[]
  _discovery = .ragdiscoverypolicy
  _vector = .ragvectorpolicy

  *: factory
    arg config_id = .string, version = .string, source_sets = .ragsourceset[], providers = .ragproviderconfig[], roles = .ragrolebinding[], profile_ids = .string[], budget = .ragbudget, workers = .ragworkerpolicy, schedules = .ragschedule[], discovery = .ragdiscoverypolicy, vector = .ragvectorpolicy
    _config_id = config_id
    _version = version
    _source_sets = source_sets
    _providers = providers
    _roles = roles
    _profile_ids = profile_ids
    _budget = budget
    _workers = workers
    _schedules = schedules
    _discovery = discovery
    _vector = vector
    return

  config_id: method = .string
    return _config_id
  version: method = .string
    return _version
  source_sets: method = .ragsourceset[]
    return _source_sets
  providers: method = .ragproviderconfig[]
    return _providers
  roles: method = .ragrolebinding[]
    return _roles
  profile_ids: method = .string[]
    return _profile_ids
  budget: method = .ragbudget
    return _budget
  workers: method = .ragworkerpolicy
    return _workers
  schedules: method = .ragschedule[]
    return _schedules
  discovery: method = .ragdiscoverypolicy
    return _discovery
  vector: method = .ragvectorpolicy
    return _vector
  valid_identity: method = .int
    return validregistryid(_config_id) = 1 & _version \= ""
  snapshot: method = .ragconfigsnapshot
    source_set_ids = .string[]
    do i = 1 to _source_sets.0
      source_set_ids[i] = _source_sets[i].source_set_id()
    end
    provider_ids = .string[]
    secret_references = .string[]
    do i = 1 to _providers.0
      provider_ids[i] = _providers[i].provider_id()
      credential = _providers[i].credential()
      if credential.empty() = 0 then secret_references[secret_references.0 + 1] = credential.ref_string()
    end
    role_routes = .string[]
    do i = 1 to _roles.0
      role_routes[i] = _roles[i].role() || ":" || _roles[i].provider_id()
    end
    return .ragconfigsnapshot(_config_id, _version, source_set_ids, provider_ids, role_routes, _profile_ids, secret_references, _budget, _workers)

ragconfigsnapshot: class
  _config_id = .string
  _version = .string
  _source_set_ids = .string[]
  _provider_ids = .string[]
  _role_routes = .string[]
  _profile_ids = .string[]
  _secret_references = .string[]
  _budget = .ragbudget
  _workers = .ragworkerpolicy

  *: factory
    arg config_id = .string, version = .string, source_set_ids = .string[], provider_ids = .string[], role_routes = .string[], profile_ids = .string[], secret_references = .string[], budget = .ragbudget, workers = .ragworkerpolicy
    _config_id = config_id
    _version = version
    _source_set_ids = source_set_ids
    _provider_ids = provider_ids
    _role_routes = role_routes
    _profile_ids = profile_ids
    _secret_references = secret_references
    _budget = budget
    _workers = workers
    return

  config_id: method = .string
    return _config_id
  version: method = .string
    return _version
  source_set_ids: method = .string[]
    return _source_set_ids
  provider_ids: method = .string[]
    return _provider_ids
  role_routes: method = .string[]
    return _role_routes
  profile_ids: method = .string[]
    return _profile_ids
  secret_references: method = .string[]
    return _secret_references
  secret_reference_count: method = .int
    return _secret_references.0
  secret_reference: method = .string
    arg index = .int
    if index < 1 | index > _secret_references.0 then return ""
    return _secret_references[index]
  budget: method = .ragbudget
    return _budget
  workers: method = .ragworkerpolicy
    return _workers

validateconfig: procedure = .ragvalidationresult
  arg config = .ragconfig
  issues = .ragvalidationissue[]
  if validregistryid(config.config_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", "config.id", "configuration id must be a registered identifier")
  if config.version() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_version", "config.version", "configuration version is required")

  source_sets = config.source_sets()
  if source_sets.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_source_set", "source_sets", "at least one source set is required")
  seen = .string[]
  do i = 1 to source_sets.0
    source_set = source_sets[i]
    path = "source_sets[" || i || "]"
    if validregistryid(source_set.source_set_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "source-set id is invalid")
    if _contains(seen, source_set.source_set_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "source-set id is duplicated")
    seen[seen.0 + 1] = source_set.source_set_id()
    patterns = source_set.include_patterns()
    if source_set.connector() \= "folder" then issues[issues.0 + 1] = .ragvalidationissue("config", "unsupported_connector", path || ".connector", "only the folder connector is currently supported")
    if source_set.root() = "" | patterns.0 = 0 | source_set.stable_key() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "incomplete_source_set", path, "source root, patterns, and stable-key policy are required")
    privacy = source_set.privacy()
    if privacy \= "local" & privacy \= "internal" & privacy \= "restricted" & privacy \= "public" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_privacy", path || ".privacy", "source privacy class is invalid")
    if source_set.retain_raw_artifact() \= 0 & source_set.retain_raw_artifact() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_boolean", path || ".retain_raw_artifact", "retain-raw-artifact must be boolean")
  end

  providers = config.providers()
  if providers.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_provider", "providers", "at least one provider is required")
  seen = .string[]
  do i = 1 to providers.0
    provider = providers[i]
    path = "providers[" || i || "]"
    if validregistryid(provider.provider_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "provider id is invalid")
    if _contains(seen, provider.provider_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "provider id is duplicated")
    seen[seen.0 + 1] = provider.provider_id()
    kind = provider.kind()
    if kind \= "openai-compatible" & kind \= "openai" & kind \= "anthropic" & kind \= "gemini" & kind \= "codex" then issues[issues.0 + 1] = .ragvalidationissue("config", "unsupported_provider", path || ".kind", "provider kind is not supported")
    route_class = provider.route_class()
    if route_class \= "local" & route_class \= "hosted" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_route", path || ".route_class", "provider route must be local or hosted")
    if provider.base_url() = "" | provider.model() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "incomplete_provider", path, "provider base URL and model are required")
    if kind = "codex" then do
      if provider.base_url() \= "app-server://local" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_url", path || ".base_url", "Codex must use app-server://local")
      if route_class \= "hosted" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_route", path || ".route_class", "Codex is a hosted privacy route")
    end
    else do
      if left(provider.base_url(), 7) \= "http://" & left(provider.base_url(), 8) \= "https://" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_url", path || ".base_url", "provider URL must use HTTP or HTTPS")
      if route_class = "hosted" & left(provider.base_url(), 8) \= "https://" then issues[issues.0 + 1] = .ragvalidationissue("config", "insecure_hosted_url", path || ".base_url", "hosted provider URL must use HTTPS")
    end
    privacy_policy = provider.privacy_policy()
    if privacy_policy \= "local-only" & privacy_policy \= "restricted-ok" & privacy_policy \= "public-only" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_privacy_policy", path || ".privacy_policy", "provider privacy policy is invalid")
    credential = provider.credential()
    if credential.valid() = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "secret_reference", path || ".credential", "credential must be an env reference")
    if kind = "codex" & credential.empty() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "unexpected_credential", path || ".credential", "Codex App Server owns authentication and must not receive a credential reference")
    if route_class = "hosted" & kind \= "codex" & credential.empty() = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_credential", path || ".credential", "hosted provider credential reference is required")
    if provider.timeout_ms() <= 0 | provider.max_attempts() < 1 | provider.max_attempts() > 10 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_provider_limits", path, "provider timeout and attempt limits are invalid")
  end

  roles = config.roles()
  seen = .string[]
  do i = 1 to roles.0
    role = roles[i]
    path = "roles[" || i || "]"
    role_id = role.role()
    if role_id \= "advisory" & role_id \= "extractor" & role_id \= "embedding" & role_id \= "answerer" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_role", path || ".role", "provider role is invalid")
    if _contains(seen, role_id) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_role", path || ".role", "provider role is duplicated")
    seen[seen.0 + 1] = role_id
    if _provider_exists(providers, role.provider_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "unknown_provider", path || ".provider_id", "role references an unknown provider id")
  end
  if _contains(seen, "advisory") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.advisory", "required provider role is missing")
  if _contains(seen, "extractor") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.extractor", "required provider role is missing")
  if _contains(seen, "embedding") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_role", "roles.embedding", "required provider role is missing")

  profile_ids = config.profile_ids()
  if profile_ids.0 = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_profile", "profiles", "at least one registered profile id is required")
  seen = .string[]
  do i = 1 to profile_ids.0
    if validregistryid(profile_ids[i]) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", "profiles[" || i || "]", "profile id is invalid")
    if _contains(seen, profile_ids[i]) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", "profiles[" || i || "]", "profile id is duplicated")
    seen[seen.0 + 1] = profile_ids[i]
  end

  budget = config.budget()
  if budget.minutes() < 0 | budget.item_limit() < 0 | budget.model_calls() < 0 | budget.input_tokens() < 0 | budget.output_tokens() < 0 | budget.cost_microunits() < 0 | budget.codex_turns() < 0 | budget.minimum_codex_allowance_percent() < 0 | budget.minimum_codex_allowance_percent() > 100 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_budget", "budget", "budget ceilings and Codex allowance threshold are invalid")
  workers = config.workers()
  if workers.processes() < 1 | workers.processes() > 32 then issues[issues.0 + 1] = .ragvalidationissue("config", "worker_processes", "workers.processes", "worker processes must be from 1 through 32")
  if workers.max_in_flight() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "worker_in_flight", "workers.max_in_flight", "each worker process currently owns one in-flight item")
  if workers.lease_seconds() <= 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_lease", "workers.lease_seconds", "worker lease must be positive")

  discovery = config.discovery()
  if wordpos(discovery.mode(), "all ranked maintenance off") = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_mode", "discovery.mode", "discovery mode must be all, ranked, maintenance, or off")
  if discovery.ranked_limit() < 1 | discovery.ranked_limit() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.ranked_limit", "ranked discovery limit is outside its supported range")
  if discovery.max_mentions() < 1 | discovery.max_mentions() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_mentions", "maximum discovered mentions must be from 1 through 64")
  if discovery.max_relationships() < 1 | discovery.max_relationships() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_relationships", "maximum discovered relationships must be from 1 through 64")
  if discovery.max_notes() < 1 | discovery.max_notes() > 64 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_discovery_limit", "discovery.max_notes", "maximum discovered notes must be from 1 through 64")

  vector = config.vector()
  if vector.algorithm() \= "ivf-flat-v1" then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_algorithm", "vector.algorithm", "production vector search must use ivf-flat-v1")
  if vector.centroids() < 1 | vector.centroids() > 4096 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.centroids", "vector centroid count is outside its supported range")
  if vector.probes() < 1 | vector.probes() > vector.centroids() then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.probes", "vector probes must be positive and no greater than centroids")
  if vector.iterations() < 1 | vector.iterations() > 16 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_limit", "vector.iterations", "vector training iterations must be from 1 through 16")
  if vector.recall_minimum_millionths() < 1 | vector.recall_minimum_millionths() > 1000000 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_vector_recall", "vector.recall_minimum_millionths", "vector recall threshold must be from 1 through 1000000")

  schedules = config.schedules()
  seen = .string[]
  do i = 1 to schedules.0
    schedule = schedules[i]
    path = "schedules[" || i || "]"
    if validregistryid(schedule.schedule_id()) = 0 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_id", path || ".id", "schedule id is invalid")
    if _contains(seen, schedule.schedule_id()) = 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "duplicate_id", path || ".id", "schedule id is duplicated")
    seen[seen.0 + 1] = schedule.schedule_id()
    if schedule.trigger() = "" then issues[issues.0 + 1] = .ragvalidationissue("config", "missing_trigger", path || ".trigger", "schedule trigger is required")
    if schedule.enabled() \= 0 & schedule.enabled() \= 1 then issues[issues.0 + 1] = .ragvalidationissue("config", "invalid_boolean", path || ".enabled", "schedule enabled must be boolean")
  end
  return .ragvalidationresult(issues)

snapshotconfig: procedure = .ragconfigsnapshot
  arg config = .ragconfig
  return config.snapshot()

invalidconfig: procedure = .ragconfig
  source_sets = .ragsourceset[]
  providers = .ragproviderconfig[]
  roles = .ragrolebinding[]
  profile_ids = .string[]
  schedules = .ragschedule[]
  return .ragconfig("", "", source_sets, providers, roles, profile_ids, .ragbudget(0, 0, 0, 0, 0, 0), .ragworkerpolicy(0, 0, 0), schedules, .ragdiscoverypolicy(), .ragvectorpolicy())

_contains: procedure = .int
  arg values = .string[], expected = .string
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_provider_exists: procedure = .int
  arg providers = .ragproviderconfig[], provider_id = .string
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return 1
  end
  return 0
