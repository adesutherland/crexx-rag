options levelg

namespace ragtrace expose ragtracer validtracemode writeoperatorline

import rxfnsb

/* Human progress is an explicitly selected stderr side channel.  Product
 * result JSON/NDJSON remains byte-stable on stdout and no prompt, document
 * body, provider response, or credential is accepted by this API. */
ragtracer: class
  _mode = .string
  _format = .string

  *: factory
    arg mode = "off", format = "human"
    _mode = mode
    _format = format
    return

  enabled: method = .int
    return _mode \= "off"

  mode: method = .string
    return _mode

  emit: method = .void
    arg stage = .string, state = .string, subject = "", detail = ""
    if enabled() = 0 then return
    safe_stage = _safe(stage, 48)
    safe_state = _safe(state, 48)
    safe_subject = _safe(subject, 128)
    safe_detail = _safe(detail, 256)
    line = "crexxrag " || safe_stage || " " || safe_state
    if safe_subject \= "" then line = line || " [" || safe_subject || "]"
    if safe_detail \= "" then line = line || " " || safe_detail
    if _mode = "ansi" & _format = "human" then do
      colour = "36"
      if safe_state = "ok" | safe_state = "complete" | safe_state = "processed" then colour = "32"
      if safe_state = "failed" | safe_state = "denied" then colour = "31"
      if safe_state = "waiting" | safe_state = "idle" then colour = "33"
      line = "1B"x || "[" || colour || "m" || line || "1B"x || "[0m"
    end
    call writeoperatorline line
    return

/* Losing an operator output sink is not a product or provider failure. Catch
 * NOTREADY only around this write, never around the caller's work. Each VM
 * stops using its failed sink; provider/file I/O keeps its normal failures. */
writeoperatorline: procedure = .void expose _stdout_closed _stderr_closed
  arg line = .string, stream = "stderr"
  _stdout_closed = .int; _stderr_closed = .int
  if stream = "stdout" then do; if _stdout_closed = 1 then return; end
  else do; if _stderr_closed = 1 then return; end
  failed = 0
  do
    failed = lineout(stream,line)
  on signal notready
    failed = 1
  end
  if failed \= 0 then do
    if stream = "stdout" then _stdout_closed = 1
    else _stderr_closed = 1
    /* Remove any buffered bytes before process-exit stdio flushing. Closing
     * the failed sink can raise the same condition once more. */
    do
      call lineout stream
    on signal notready
      nop
    end
  end
  return

validtracemode: procedure = .int
  arg mode = .string, format = .string
  if mode \= "off" & mode \= "plain" & mode \= "ansi" then return 0
  if mode = "ansi" & format \= "human" then return 0
  return 1

_safe: procedure = .string
  arg value = .string, maximum = .int
  value = changestr("1B"x, value, "?")
  value = changestr("0D"x, value, " ")
  value = changestr("0A"x, value, " ")
  value = changestr("09"x, value, " ")
  if length(value) > maximum then value = left(value, maximum)
  return value
