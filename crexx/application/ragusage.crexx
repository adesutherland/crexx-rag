options levelg

namespace ragusage expose jobusagevalues jobusagejson closeexpiredreservations retainuncertainusage updateexternalrunusage updateexternalrunallowance releaseprovidercall settlecall settlecallintransaction recoverprovideraccounting unknownusageguard actualusage reservationusage reservationdelta

import rxfnsb
import rxjson
import rxhash
import rxsqlite
import ragsqlsupport
import ragstore
import ragenvironment
import ragworktypes
import raglifecycle
import ragcanonical
import ragprofile

/* Usage is authorized by the original reservation, even after lease expiry.
 * Public settlement owns its transaction; settlecallintransaction composes
 * with reconciliation under its caller's writer transaction. No graph writes. */
updateexternalrunusage: procedure = .int
  arg store = .ragstorehandle, provider_run_id = .string, thread_id = .string, turn_id = .string, input_tokens = .int, output_tokens = .int, expose error = .string
  if beginwritetransaction(store.database(),"persist external provider state",error) \= 0 then return -3
  status = _updateexternalrunusage(store,provider_run_id,thread_id,turn_id,input_tokens,output_tokens,error)
  if status \= 0 then do; ignored = sqliteexec(store.database(),"ROLLBACK"); return status; end
  if sqliteexec(store.database(),"COMMIT") \= 0 then return _rollback(store.database(),"cannot commit external provider state",error)
  return 0

_updateexternalrunusage: procedure = .int
  arg store = .ragstorehandle, provider_run_id = .string, thread_id = .string, turn_id = .string, input_tokens = .int, output_tokens = .int, expose error = .string
  error = ""; prepared = .binary
  sql = "UPDATE provider_runs SET input_tokens=max(input_tokens,?4),output_tokens=max(output_tokens,?5),recovery_json=json_set(recovery_json,'$.usage_observed',1) WHERE provider_run_id=?1 AND external_thread_id=?2 AND external_turn_id=?3 AND outcome='running'"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then do; error = "cannot prepare external usage update"; return -1; end
  binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindtext(prepared, 2, thread_id) | sqlitebindtext(prepared, 3, turn_id) | sqlitebindint(prepared, 4, input_tokens) | sqlitebindint(prepared, 5, output_tokens)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 | _scalarint(store.database(), "SELECT changes()") \= 1 then do; error = "cannot persist external token usage"; return -1; end
  return 0

updateexternalrunallowance: procedure = .int
  arg store = .ragstorehandle, provider_run_id = .string, used_percent = .int, expose error = .string
  if beginwritetransaction(store.database(),"persist external provider state",error) \= 0 then return -3
  status = _updateexternalrunallowance(store,provider_run_id,used_percent,error)
  if status \= 0 then do; ignored = sqliteexec(store.database(),"ROLLBACK"); return status; end
  if sqliteexec(store.database(),"COMMIT") \= 0 then return _rollback(store.database(),"cannot commit external provider state",error)
  return 0

_updateexternalrunallowance: procedure = .int
  arg store = .ragstorehandle, provider_run_id = .string, used_percent = .int, expose error = .string
  error = ""; prepared = .binary
  sql = "UPDATE provider_runs SET allowance_used_after_percent=?2 WHERE provider_run_id=?1 AND charging_basis='subscription-allowance' AND outcome='completed-unsettled'"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then do; error = "cannot prepare external allowance update"; return -1; end
  binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindint(prepared, 2, used_percent)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 | _scalarint(store.database(), "SELECT changes()") \= 1 then do; error = "cannot persist external allowance update"; return -1; end
  return 0

releaseprovidercall: procedure = .int
  arg store = .ragstorehandle, admission_id = .string, actual_tokens = .int, outcome = .string, expose error = .string, retry_delay_ms = 0, initial_backoff_ms = 1000, maximum_backoff_ms = 60000
  error = ""; database = store.database()
  if beginwritetransaction(database,"begin provider admission release",error) \= 0 then return -3
  previous = _boundscalartext(database,"SELECT outcome FROM provider_admissions WHERE admission_id=?1",admission_id)
  status = _releaseprovidercall(store,admission_id,actual_tokens,outcome,error)
  if status \= 0 then do; ignored = sqliteexec(database,"ROLLBACK"); return status; end
  if previous = "active" | previous = "expired" then do
    if updatecooldown(database,admission_id,outcome,retry_delay_ms,initial_backoff_ms,maximum_backoff_ms,error) \= 0 then return _rollback(database,error,error)
  end
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"cannot commit provider admission release",error)
  return 0

_releaseprovidercall: procedure = .int
  arg store = .ragstorehandle, admission_id = .string, actual_tokens = .int, outcome = .string, expose error = .string
  error = ""
  if store.writable() \= 1 | admission_id = "" | actual_tokens < 0 | (outcome \= "succeeded" & outcome \= "failed") then do; error = "provider admission release inputs are invalid"; return -1; end
  database = store.database(); prepared = .binary
  sql = "UPDATE provider_admissions SET actual_tokens=?2,outcome=?3,released_epoch=CAST(strftime('%s','now') AS INTEGER) WHERE admission_id=?1 AND outcome IN('active','expired')"
  if sqliteprepare(database, sql, prepared) \= 0 then return _admissionerror("prepare",admission_id,error)
  binds = sqlitebindtext(prepared, 1, admission_id) | sqlitebindint(prepared, 2, actual_tokens) | sqlitebindtext(prepared, 3, outcome)
  if binds \= 0 then do; failed = _admissionerror("bind",admission_id,error); call sqlitefinalize prepared; return failed; end
  step = sqlitestep(prepared)
  if step \= 101 then do; failed = _admissionerror("step",admission_id,error); call sqlitefinalize prepared; return failed; end
  call sqlitefinalize prepared
  changed = _scalarint(database,"SELECT changes()")
  if changed = 1 then return 0
  if changed < 0 then return _admissionerror("changes",admission_id,error)
  /* Exact duplicate settlement is harmless; conflicting settlement is not. */
  if _boundcount(database,"SELECT count(*) FROM provider_admissions WHERE admission_id=?1 AND outcome=" || _q(outcome) || " AND actual_tokens=" || actual_tokens,admission_id) = 1 then return 0
  existing = _boundscalartext(database,"SELECT outcome FROM provider_admissions WHERE admission_id=?1",admission_id)
  if existing = "" then existing = "missing"
  error = "provider admission release conflict [admission=" || admission_id || ",existing=" || existing || ",requested=" || outcome || "]"
  return -3

_admissionerror: procedure = .int
  arg stage = .string, admission_id = .string, expose error = .string
  boundary = 0; primary = 0; extended = 0; operation = ""; message = ""
  call sqliteerrorextended boundary,primary,extended,operation,message
  error = "provider admission release " || stage || " failed [admission=" || admission_id || ",boundary=" || boundary || ",sqlite=" || primary || ",extended=" || extended || ",operation=" || operation || "]: " || message
  return -3

settlecall: procedure = .int
  arg store = .ragstorehandle, reservation = .ragcallreservation, provider_id = .string, model = .string, request_id = .string, outcome = .string, actual_input_tokens = .int, actual_output_tokens = .int, actual_cost = .int, actual_time_ms = .int, expose provider_run_id = .string, expose error = .string, existing_provider_run_id = "", charging_basis = "monetary-api", record_provider_run = 1, diagnostic_json = "", resolution_json = "", resolution_profile_hash = ""
  database = store.database()
  if beginwritetransaction(database,"begin provider settlement",error) \= 0 then return -3
  status = settlecallintransaction(store,reservation,provider_id,model,request_id,outcome,actual_input_tokens,actual_output_tokens,actual_cost,actual_time_ms,provider_run_id,error,existing_provider_run_id,charging_basis,record_provider_run,diagnostic_json,resolution_json,resolution_profile_hash)
  if status \= 0 then do; ignored = sqliteexec(database,"ROLLBACK"); return status; end
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"cannot commit provider settlement",error)
  return 0

settlecallintransaction: procedure = .int
  arg store = .ragstorehandle, reservation = .ragcallreservation, provider_id = .string, model = .string, request_id = .string, outcome = .string, actual_input_tokens = .int, actual_output_tokens = .int, actual_cost = .int, actual_time_ms = .int, expose provider_run_id = .string, expose error = .string, existing_provider_run_id = "", charging_basis = "monetary-api", record_provider_run = 1, diagnostic_json = "", resolution_json = "", resolution_profile_hash = ""
  error = ""; provider_run_id = ""
  if store.writable() \= 1 | reservation.status() \= 0 | provider_id = "" | model = "" | request_id = "" | (outcome \= "succeeded" & outcome \= "failed" & outcome \= "cancelled") | actual_input_tokens < 0 | actual_output_tokens < 0 | actual_cost < 0 | actual_time_ms < 0 | (record_provider_run \= 0 & record_provider_run \= 1) then do; error = "provider settlement inputs are invalid"; return -1; end
  if diagnostic_json \= "" & (outcome \= "failed" | binlength(diagnostic_json as .binary) > 262144 | .jsondocument(diagnostic_json).valid() \= 1) then do; error = "provider failure diagnostic is invalid"; return -1; end
  if record_provider_run = 0 & (actual_input_tokens \= 0 | actual_output_tokens \= 0 | actual_cost \= 0 | existing_provider_run_id \= "") then do; error = "uncalled provider settlement cannot contain provider usage"; return -1; end
  database = store.database()
  claim = .ragworkclaim(0, reservation.job_id(), reservation.item_id(), "", "", reservation.worker_id(), reservation.fence(), reservation.attempt_id(), 0, "")
  /* The durable original attempt authorizes accounting even after lease expiry.
   * Publication still requires _activefence. Actual charges are observations,
   * never discarded because an estimate or a deadline was exceeded. */
  identity_sql = "SELECT count(*) FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE a.attempt_id=?1 AND a.item_id=" || _q(reservation.item_id()) || " AND i.job_id=" || _q(reservation.job_id()) || " AND a.worker_id=" || _q(reservation.worker_id()) || " AND a.fence=" || reservation.fence()
  if _boundcount(database,identity_sql,reservation.attempt_id()) \= 1 then return _rollback(database,"provider settlement original identity is invalid",error)
  if reservation.reservation_id() \= reservation.attempt_id() || "#call-1" then return _rollback(database,"provider reservation does not belong to the original attempt",error)
  if _boundeventcount(database,reservation.job_id(),"reservation-open:" || reservation.reservation_id()) \= 1 then return _rollback(database,"provider reservation is missing",error)
  opened = .jsondocument(_boundevent(database,reservation.job_id(),"reservation-open:" || reservation.reservation_id()))
  ri = -1; ro = -1; rc = -1; rt = -1; ct = -1
  if opened.node_int(opened.member(opened.root(),"input"),ri) \= 0 | opened.node_int(opened.member(opened.root(),"output"),ro) \= 0 | opened.node_int(opened.member(opened.root(),"cost"),rc) \= 0 | opened.node_int(opened.member(opened.root(),"time"),rt) \= 0 | opened.node_int(opened.member(opened.root(),"codex_turn"),ct) \= 0 then return _rollback(database,"reservation receipt is malformed",error)
  if ri \= reservation.reserved_input_tokens() | ro \= reservation.reserved_output_tokens() | rc \= reservation.reserved_cost() | rt \= reservation.reserved_time_ms() | ct \= reservation.codex_turn() then return _rollback(database,"reservation receipt does not match settlement",error)
  receipt = jsonquote(provider_id) || "," || jsonquote(model) || "," || jsonquote(request_id) || "," || jsonquote(outcome) || "," || actual_input_tokens || "," || actual_output_tokens || "," || actual_cost || "," || actual_time_ms || "," || jsonquote(existing_provider_run_id) || "," || jsonquote(charging_basis) || "," || record_provider_run || "," || jsonquote(diagnostic_json) || "," || jsonquote(resolution_json) || "," || jsonquote(resolution_profile_hash)
  receipt = "[" || receipt || "]"
  prior_receipt = _boundevent(database,reservation.job_id(),"settlement-receipt:" || reservation.reservation_id())
  if prior_receipt \= "" then do
    if prior_receipt \= receipt then return _rollback(database,"conflicting duplicate provider settlement",error)
    provider_run_id = _boundscalartext(database,"SELECT coalesce(provider_run_id,'') FROM attempts WHERE attempt_id=?1",reservation.attempt_id())
    return 0
  end
  already_closed = _boundeventcount(database,reservation.job_id(),"reservation-close:" || reservation.reservation_id())
  if already_closed > 0 then do
    closed = .jsondocument(_boundevent(database,reservation.job_id(),"reservation-close:" || reservation.reservation_id())); close_reason = ""
    ignored = closed.node_string(closed.member(closed.root(),"reason"),close_reason)
    if close_reason \= "lease-expired" then return _rollback(database,"provider reservation was already settled without this receipt",error)
  end
  if record_provider_run = 1 then do
    provider_run_id = existing_provider_run_id
    if provider_run_id = "" then provider_run_id = "provider-run-sha256:" || rxhash..sha256hex((reservation.reservation_id() || "00"x || provider_id || "00"x || model || "00"x || request_id) as .binary)
    config_snapshot = _boundscalartext(database, "SELECT config_snapshot_id FROM jobs WHERE job_id=?1", reservation.job_id())
    prepared = .binary; binds = 0
    if existing_provider_run_id = "" then do
    sql = "INSERT INTO provider_runs(provider_run_id,config_snapshot_id,provider_id,model,request_hash,outcome,input_tokens,output_tokens,duration_ms,started_at,completed_at,charging_basis,cost_microunits,purpose) VALUES(?1,?2,?3,?4,?5,?6,?7,?8,?9,strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now'),?10,?11,'work-item')"
    if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database, "cannot prepare provider run", error)
    request_hash = rxhash..sha256hex((provider_id || "00"x || model || "00"x || request_id || "00"x || reservation.attempt_id()) as .binary)
    binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindtext(prepared, 2, config_snapshot) | sqlitebindtext(prepared, 3, provider_id) | sqlitebindtext(prepared, 4, model) | sqlitebindtext(prepared, 5, request_hash) | sqlitebindtext(prepared, 6, outcome) | sqlitebindint(prepared, 7, actual_input_tokens) | sqlitebindint(prepared, 8, actual_output_tokens) | sqlitebindint(prepared, 9, actual_time_ms) | sqlitebindtext(prepared, 10, charging_basis) | sqlitebindint(prepared, 11, actual_cost)
    end
    else do
      sql = "UPDATE provider_runs SET outcome=?4,input_tokens=?5,output_tokens=?6,duration_ms=?7,cost_microunits=?8,recovery_json='',completed_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE provider_run_id=?1 AND provider_id=?2 AND model=?3 AND outcome IN('starting','running','completed-unsettled')"
      if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database, "cannot prepare durable provider run settlement", error)
      binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindtext(prepared, 2, provider_id) | sqlitebindtext(prepared, 3, model) | sqlitebindtext(prepared, 4, outcome) | sqlitebindint(prepared, 5, actual_input_tokens) | sqlitebindint(prepared, 6, actual_output_tokens) | sqlitebindint(prepared, 7, actual_time_ms) | sqlitebindint(prepared, 8, actual_cost)
    end
    step = sqlitestep(prepared); call sqlitefinalize prepared
    if binds \= 0 | step \= 101 | (existing_provider_run_id \= "" & _scalarint(database, "SELECT changes()") \= 1) then return _rollback(database, "cannot persist provider run settlement", error)
    if diagnostic_json \= "" then do
      prepared = .binary
      if sqliteprepare(database, "UPDATE provider_runs SET recovery_json=?2 WHERE provider_run_id=?1 AND outcome='failed'", prepared) \= 0 then return _rollback(database, "cannot prepare provider failure diagnostic", error)
      binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindtext(prepared, 2, diagnostic_json)
      step = sqlitestep(prepared); call sqlitefinalize prepared
      if binds \= 0 | step \= 101 then return _rollback(database, "cannot persist provider failure diagnostic", error)
    end
    prepared = .binary
    sql = "UPDATE attempts SET provider_run_id=?1 WHERE attempt_id=?2 AND item_id=?3 AND worker_id=?4 AND fence=?5 AND (provider_run_id IS NULL OR provider_run_id=?1)"
    if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database, "cannot prepare attempt provider link", error)
    binds = sqlitebindtext(prepared, 1, provider_run_id) | sqlitebindtext(prepared, 2, reservation.attempt_id()) | sqlitebindtext(prepared, 3, reservation.item_id()) | sqlitebindtext(prepared, 4, reservation.worker_id()) | sqlitebindint(prepared, 5, reservation.fence())
    step = sqlitestep(prepared); call sqlitefinalize prepared
    if binds \= 0 | step \= 101 | _scalarint(database, "SELECT changes()") \= 1 then return _rollback(database, "cannot link provider run to current attempt", error)
  end
  if resolution_json \= "" then do
    if outcome \= "succeeded" | record_provider_run \= 1 | length(resolution_profile_hash) \= 64 then return _rollback(database,"invalid durable resolution output",error)
    sql = "INSERT INTO maintenance_provider_outputs(item_id,task_id,provider_run_id,response_json,profile_hash,created_epoch) SELECT m.item_id,m.task_id," || _q(provider_run_id) || "," || _q(resolution_json) || "," || _q(resolution_profile_hash) || ",unixepoch() FROM maintenance_task_items m WHERE m.item_id=" || _q(reservation.item_id())
    if sqliteexec(database,sql) \= 0 | _scalarint(database,"SELECT changes()") \= 1 then return _rollback(database,"cannot persist settled resolution output",error)
  end
  if already_closed = 0 then do
  message = "{" || jsonquote("reservation_id") || ":" || jsonquote(reservation.reservation_id()) || "," || jsonquote("input") || ":" || (-reservation.reserved_input_tokens()) || "," || jsonquote("output") || ":" || (-reservation.reserved_output_tokens()) || "," || jsonquote("cost") || ":" || (-reservation.reserved_cost()) || "," || jsonquote("time") || ":" || (-reservation.reserved_time_ms()) || "," || jsonquote("actual_cost") || ":" || actual_cost || "," || jsonquote("codex_turn") || ":" || (-reservation.codex_turn()) || "}"
  if _event(database, reservation.job_id(), reservation.item_id(), reservation.attempt_id(), "reservation-close:" || reservation.reservation_id(), message) \= 0 then return _rollback(database, "cannot close provider reservation", error)
  sql = "UPDATE jobs SET reserved_calls=reserved_calls-1,reserved_tokens=reserved_tokens-" || (reservation.reserved_input_tokens() + reservation.reserved_output_tokens()) || ",reserved_cost=reserved_cost-" || reservation.reserved_cost() || ",reserved_codex_turns=reserved_codex_turns-" || reservation.codex_turn() || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE job_id=" || _q(reservation.job_id()) || " AND reserved_calls>0 AND reserved_tokens>=" || (reservation.reserved_input_tokens() + reservation.reserved_output_tokens()) || " AND reserved_cost>=" || reservation.reserved_cost() || " AND reserved_codex_turns>=" || reservation.codex_turn()
  if sqliteexec(database, sql) \= 0 | _scalarint(database, "SELECT changes()") \= 1 then return _rollback(database, "cannot settle provider reservation counters", error)
  end
  if _event(database,reservation.job_id(),reservation.item_id(),reservation.attempt_id(),"settlement-receipt:" || reservation.reservation_id(),receipt) \= 0 then return _rollback(database,"cannot retain immutable settlement receipt",error)
  if already_closed > 0 | actual_input_tokens > reservation.maximum_input_tokens() | actual_output_tokens > reservation.maximum_output_tokens() | actual_cost > reservation.maximum_cost() | actual_time_ms > reservation.maximum_time_ms() then do
    if _event(database,reservation.job_id(),reservation.item_id(),reservation.attempt_id(),"settlement-exception",receipt) \= 0 then return _rollback(database,"cannot record settlement exception",error)
  end
  return 0

recoverprovideraccounting: procedure = .int
  arg store = .ragstorehandle, claim = .ragworkclaim, original_attempt = .string, result = .ragworkproviderresult, expose provider_run_id = .string, expose error = .string
  database = store.database(); error = ""
  provider_run_id = _boundscalartext(database,"SELECT coalesce(provider_run_id,'') FROM attempts WHERE attempt_id=?1",original_attempt)
  unsettled_run = 0
  if provider_run_id \= "" then unsettled_run = _boundcount(database,"SELECT count(*) FROM provider_runs WHERE provider_run_id=?1 AND outcome IN('starting','running','completed-unsettled')",provider_run_id)
  if provider_run_id = "" | unsettled_run > 0 then do
    original_wait = _boundscalarint(database,"SELECT coalesce(max(wait_ms),0) FROM provider_admissions WHERE attempt_id=?1",original_attempt)
    if original_wait > 0 then call result.add_wait_ms(original_wait)
    identity = .jsondocument(_boundscalartext(database,"SELECT json_object('worker',worker_id,'fence',fence) FROM attempts WHERE attempt_id=?1",original_attempt))
    worker = ""; fence = 0
    ignored = identity.node_string(identity.member(identity.root(),"worker"),worker)
    ignored = identity.node_int(identity.member(identity.root(),"fence"),fence)
    opened = .jsondocument(_boundevent(database,claim.job_id(),"reservation-open:" || original_attempt || "#call-1"))
    ri = -1; ro = -1; rc = -1; rt = -1; ct = 0
    ignored = opened.node_int(opened.member(opened.root(),"input"),ri)
    ignored = opened.node_int(opened.member(opened.root(),"output"),ro)
    ignored = opened.node_int(opened.member(opened.root(),"cost"),rc)
    ignored = opened.node_int(opened.member(opened.root(),"time"),rt)
    ignored = opened.node_int(opened.member(opened.root(),"codex_turn"),ct)
    reservation = .ragcallreservation(0,original_attempt || "#call-1",claim.job_id(),claim.item_id(),original_attempt,worker,fence,ri,ro,rc,rt,ct)
    outcome = "failed"; if result.ok() = 1 then outcome = "succeeded"
    profile_hash = ""; if result.resolution_json() \= "" then profile_hash = ragsha256(canonicalprofile(result.resolution_profile()))
    accounting_run = provider_run_id
    if accounting_run = "" then accounting_run = result.provider_run_id()
    if settlecall(store,reservation,result.provider_id(),result.model(),result.request_id(),outcome,result.input_tokens(),result.output_tokens(),result.cost(),result.duration_ms(),provider_run_id,error,accounting_run,result.charging_basis(),result.provider_called(),result.diagnostic_json(),result.resolution_json(),profile_hash) \= 0 then return -3
  end
  if beginwritetransaction(database,"begin recovered receipt link",error) \= 0 then return -3
  if _activefence(database,claim) \= 1 then return _rollback(database,"receipt recovery publication fence is stale",error)
  admission_outcome = "failed"; if result.ok() = 1 then admission_outcome = "succeeded"
  if sqliteexec(database,"UPDATE provider_admissions SET actual_tokens=" || (result.input_tokens()+result.output_tokens()) || ",outcome=" || _q(admission_outcome) || ",released_epoch=unixepoch() WHERE attempt_id=" || _q(original_attempt) || " AND outcome IN('active','expired')") \= 0 then return _rollback(database,"cannot release recovered provider admission",error)
  if sqliteexec(database,"UPDATE attempts SET provider_run_id=" || _q(provider_run_id) || " WHERE attempt_id=" || _q(claim.attempt_id()) || " AND provider_run_id IS NULL") \= 0 then return _rollback(database,"cannot link recovered receipt",error)
  if _event(database,claim.job_id(),claim.item_id(),claim.attempt_id(),"provider-receipt-reused",original_attempt) \= 0 then return _rollback(database,"cannot record receipt reuse",error)
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"cannot commit receipt recovery",error)
  return 0

unknownusageguard: procedure = .int
  arg database = .binary, job_id = .string, expose values = .int[]
  clear values
  /* Closed unknown reservations retain their ceilings. Read all dimensions
   * together; the explicit prefix selects the existing event-type index range.
   * EXISTS counts each attempt once even after repeat inspection. */
  sql = "SELECT coalesce(sum(max(0,json_extract(o.message,'$.input')-max(0,coalesce(p.input_tokens,0)))),0),coalesce(sum(max(0,json_extract(o.message,'$.output')-max(0,coalesce(p.output_tokens,0)))),0),coalesce(sum(max(0,json_extract(o.message,'$.time')-max(0,coalesce(p.duration_ms,0)))),0),coalesce(sum(max(0,json_extract(o.message,'$.cost')-max(0,coalesce(p.cost_microunits,0)))),0),coalesce(sum(CASE WHEN p.provider_run_id IS NULL THEN 1 ELSE 0 END),0) FROM job_events o JOIN attempts a ON a.attempt_id=o.attempt_id LEFT JOIN provider_runs p ON p.provider_run_id=a.provider_run_id WHERE o.job_id=?1 AND o.event_type GLOB 'reservation-open:*' AND o.event_type='reservation-open:'||a.attempt_id||'#call-1' AND EXISTS(SELECT 1 FROM job_events c WHERE c.attempt_id=a.attempt_id AND c.event_type='reservation-close:'||a.attempt_id||'#call-1') AND (EXISTS(SELECT 1 FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type IN('provider-reconciled','provider-observed') AND json_extract(e.message,'$.usage_complete')=0) OR (EXISTS(SELECT 1 FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type='provider-intent') AND NOT EXISTS(SELECT 1 FROM job_events r WHERE r.attempt_id=a.attempt_id AND r.event_type='provider-response')))"
  prepared = .binary
  if sqliteprepare(database,sql,prepared) \= 0 | sqlitebindtext(prepared,1,job_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = 0
  do i = 0 to 4
    value = 0; status = status | sqlitecolumnint(prepared,i,value); values[i+1] = value
  end
  call sqlitefinalize prepared
  if status \= 0 then return -1
  return values.0

/* Bounded job totals and a caller-selected observation interval. Provider runs
 * are counted once even when retries reuse the same receipt. These are recorded
 * amounts, not a claim that missing provider usage has become known. */
jobusagejson: procedure = .string
  arg database = .binary, job_id = .string, observed_epoch = .int, seconds = .int
  if job_id="" | seconds<1 | seconds>86400 then return ""
  cutoff=observed_epoch-seconds
  runs="SELECT p.* FROM provider_runs p WHERE p.provider_run_id IN(SELECT a.provider_run_id FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=?1 AND a.provider_run_id IS NOT NULL)"
  recent="coalesce(unixepoch(completed_at),0)>=" || cutoff || " AND coalesce(unixepoch(completed_at),0)<=" || observed_epoch
  sql="WITH runs AS (" || runs || ") SELECT json_object('recorded_provider_runs',count(*),'recorded_input_tokens',coalesce(sum(max(0,input_tokens)),0),'recorded_provider_time_ms',coalesce(sum(max(0,duration_ms)),0),'recorded_output_tokens',coalesce(sum(max(0,output_tokens)),0),'recorded_cost_microunits',coalesce(sum(max(0,cost_microunits)),0),'unpriced_runs',coalesce(sum(cost_microunits<0),0),'successful_provider_runs',coalesce(sum(outcome='succeeded'),0),'failed_provider_runs',coalesce(sum(outcome='failed'),0),'other_provider_runs',coalesce(sum(outcome NOT IN('succeeded','failed')),0),'interval_provider_runs',coalesce(sum(" || recent || "),0),'interval_successful_runs',coalesce(sum((" || recent || ") AND outcome='succeeded'),0),'timestamp_unknown_runs',coalesce(sum(unixepoch(completed_at) IS NULL),0)) FROM runs"
  result=_boundscalartext(database,sql,job_id)
  if result="" then return ""
  uncertainty=_boundcount(database,"SELECT count(*) FROM job_items i WHERE i.job_id=?1 AND " || uncertainitem("i.item_id"),job_id)
  active=_boundcount(database,"SELECT count(*) FROM job_items i WHERE i.job_id=?1 AND i.state IN('running','cancel_requested') AND " || uncertainitem("i.item_id"),job_id)
  incomplete=_boundcount(database,"SELECT count(*) FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=?1 AND EXISTS(SELECT 1 FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type IN('provider-observed','provider-reconciled') AND CASE WHEN json_valid(e.message) THEN coalesce(json_extract(e.message,'$.usage_complete'),0)=0 ELSE 1 END AND NOT EXISTS(SELECT 1 FROM job_events n WHERE n.attempt_id=e.attempt_id AND n.event_type IN('provider-observed','provider-reconciled') AND n.event_id>e.event_id))",job_id)
  if uncertainty<0 | active<0 | incomplete<0 then return ""
  return substr(result,1,length(result)-1) || ',"uncertain_items":' || uncertainty || ',"active_unsettled_items":' || active || ',"held_uncertain_items":' || (uncertainty-active) || ',"incomplete_usage_observations":' || incomplete || '}'

/* Calls/input/output/cost/time from this job's distinct durable runs. */
jobusagevalues: procedure = .int
  arg database=.binary, job_id=.string, expose values=.int[]
  sql="SELECT count(*),coalesce(sum(p.input_tokens),0),coalesce(sum(p.output_tokens),0),coalesce(sum(max(0,p.cost_microunits)),0),coalesce(sum(p.duration_ms),0) FROM provider_runs p WHERE p.provider_run_id IN(SELECT a.provider_run_id FROM job_items i JOIN attempts a ON a.item_id=i.item_id WHERE i.job_id=" || _q(job_id) || " AND a.provider_run_id IS NOT NULL)"
  return sqlreadints(database,sql,values,5)

actualusage: procedure = .int
  arg database = .binary, job_id = .string, kind = .string
  if kind = "input" then expression = "coalesce(sum(p.input_tokens),0)"
  else if kind = "output" then expression = "coalesce(sum(p.output_tokens),0)"
  else if kind = "time" then expression = "coalesce(sum(p.duration_ms),0)"
  /* -1 is the stored unpriced sentinel, including a running subscription
   * turn; it is not a failed SQL read or negative monetary usage. */
  else expression = "coalesce(sum(max(0,p.cost_microunits)),0)"
  prepared = .binary
  /* Start from this job's indexed items; IN counts a recovered run once even
   * when several attempts reference it, without scanning unrelated history. */
  sql = "SELECT " || expression || " FROM provider_runs p WHERE p.provider_run_id IN(SELECT a.provider_run_id FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=?1 AND a.provider_run_id IS NOT NULL)"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, job_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = 0; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

reservationusage: procedure = .int
  arg database = .binary, job_id = .string, expose values = .int[]
  clear values
  prepared = .binary
  sql = "SELECT coalesce(sum(CAST(json_extract(message,'$.input') AS INTEGER)),0),coalesce(sum(CAST(json_extract(message,'$.output') AS INTEGER)),0),coalesce(sum(CAST(json_extract(message,'$.cost') AS INTEGER)),0),coalesce(sum(CAST(json_extract(message,'$.time') AS INTEGER)),0) FROM job_events WHERE job_id=?1 AND (event_type GLOB 'reservation-open:*' OR event_type GLOB 'reservation-close:*')"
  if sqliteprepare(database,sql,prepared) \= 0 | sqlitebindtext(prepared,1,job_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  status = 0
  do i = 0 to 3
    value = 0; status = status | sqlitecolumnint(prepared,i,value); values[i+1] = value
  end
  call sqlitefinalize prepared
  if status \= 0 then return -1
  return values.0

reservationdelta: procedure = .int
  arg database = .binary, job_id = .string, field = .string
  prepared = .binary
  sql = "SELECT coalesce(sum(CAST(json_extract(message,'$." || field || "') AS INTEGER)),0) FROM job_events WHERE job_id=?1 AND (event_type LIKE 'reservation-open:%' OR event_type LIKE 'reservation-close:%')"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, job_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = 0; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

_activefence: procedure = .int
  arg database = .binary, claim = .ragworkclaim, allow_cancelled_settlement = 0
  return activeworkfence(database,claim.job_id(),claim.item_id(),claim.attempt_id(),claim.worker_id(),claim.fence(),allow_cancelled_settlement)

_event: procedure = .int
  arg database = .binary, job_id = .string, item_id = .string, attempt_id = .string, event_type = .string, message = .string
  prepared = .binary
  sql = "INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) VALUES(?1,NULLIF(?2,''),NULLIF(?3,''),?4,?5,strftime('%Y-%m-%dT%H:%M:%fZ','now'))"
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  binds = sqlitebindtext(prepared, 1, job_id) | sqlitebindtext(prepared, 2, item_id) | sqlitebindtext(prepared, 3, attempt_id) | sqlitebindtext(prepared, 4, event_type) | sqlitebindtext(prepared, 5, message)
  step = sqlitestep(prepared); call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then return -1
  return 0

_scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = -1; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

_boundcount: procedure = .int
  arg database = .binary, sql = .string, value = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, value) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  count = -1; status = sqlitecolumnint(prepared, 0, count); call sqlitefinalize prepared
  if status \= 0 then return -1
  return count

_boundscalartext: procedure = .string
  arg database = .binary, sql = .string, value = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, value) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  output = ""; status = sqlitecolumntext(prepared, 0, output); call sqlitefinalize prepared
  if status \= 0 then return ""
  return output

_boundscalarint: procedure = .int
  arg database = .binary, sql = .string, value = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, value) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  output = -1; status = sqlitecolumnint(prepared, 0, output); call sqlitefinalize prepared
  if status \= 0 then return -1
  return output

_q: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "''") || "'"
_boundevent: procedure = .string
  arg database = .binary, job_id = .string, event_type = .string
  prepared = .binary
  sql = "SELECT message FROM job_events WHERE job_id=?1 AND event_type=?2 ORDER BY event_id DESC LIMIT 1"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, job_id) \= 0 | sqlitebindtext(prepared, 2, event_type) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  value = ""; status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

_boundeventcount: procedure = .int
  arg database = .binary, job_id = .string, event_type = .string
  prepared = .binary
  if sqliteprepare(database, "SELECT count(*) FROM job_events WHERE job_id=?1 AND event_type=?2", prepared) \= 0 | sqlitebindtext(prepared, 1, job_id) \= 0 | sqlitebindtext(prepared, 2, event_type) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = 0; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

_rollback: procedure = .int
  arg database = .binary, message = .string, expose error = .string
  call sqliteexec database, "ROLLBACK"; error = message
  return -3


/* Caller owns the lease-recovery writer transaction. */
closeexpiredreservations: procedure = .int
  arg database = .binary, expose error = .string
  /* Close reservations whose owning fenced lease has expired.  Rebuilding
   * counters from immutable event pairs repairs a process that died after
   * appending the close event but before returning to its controller. */
  sql = "INSERT INTO job_events(job_id,item_id,attempt_id,event_type,message,occurred_at) SELECT e.job_id,e.item_id,e.attempt_id,'reservation-close:'||substr(e.event_type,length('reservation-open:')+1),json_object('reservation_id',json_extract(e.message,'$.reservation_id'),'input',-CAST(json_extract(e.message,'$.input') AS INTEGER),'output',-CAST(json_extract(e.message,'$.output') AS INTEGER),'cost',-CAST(json_extract(e.message,'$.cost') AS INTEGER),'time',-CAST(json_extract(e.message,'$.time') AS INTEGER),'actual_cost',0,'codex_turn',-coalesce(CAST(json_extract(e.message,'$.codex_turn') AS INTEGER),0),'reason','lease-expired'),strftime('%Y-%m-%dT%H:%M:%fZ','now') FROM job_items i CROSS JOIN attempts a ON a.item_id=i.item_id AND a.fence=i.fence CROSS JOIN job_events e ON e.attempt_id=a.attempt_id WHERE i.state IN('running','cancel_requested') AND i.lease_until<=unixepoch() AND a.outcome='running' AND e.event_type LIKE 'reservation-open:%' AND NOT EXISTS(SELECT 1 FROM job_events c WHERE c.job_id=e.job_id AND c.event_type='reservation-close:'||substr(e.event_type,length('reservation-open:')+1))"
  if sqliteexec(database, sql) \= 0 then return _rollback(database, "cannot close stale provider reservations", error)
  sql = "UPDATE jobs SET (reserved_calls,reserved_tokens,reserved_cost,reserved_codex_turns)=(SELECT coalesce(sum(CASE WHEN e.event_type LIKE 'reservation-open:%' THEN 1 ELSE -1 END),0),coalesce(sum(CAST(json_extract(e.message,'$.input') AS INTEGER)+CAST(json_extract(e.message,'$.output') AS INTEGER)),0),coalesce(sum(CAST(json_extract(e.message,'$.cost') AS INTEGER)),0),coalesce(sum(coalesce(CAST(json_extract(e.message,'$.codex_turn') AS INTEGER),0)),0) FROM job_events e WHERE e.job_id=jobs.job_id AND (e.event_type LIKE 'reservation-open:%' OR e.event_type LIKE 'reservation-close:%')) WHERE job_id IN(SELECT job_id FROM job_items WHERE state IN('running','cancel_requested') AND lease_until<=unixepoch())"
  if sqliteexec(database, sql) \= 0 then return _rollback(database, "cannot reconcile provider reservation counters", error)
  return 0

/* Caller owns the uncertainty-hold writer transaction. A returned envelope
 * may be unavailable, but known usage still belongs to the original attempt.
 * Preserve external recovery_json verbatim so reconciliation can reuse it. */
retainuncertainusage: procedure = .int
  arg store = .ragstorehandle, claim = .ragworkclaim, result = .ragworkproviderresult, expose error = .string
  database = store.database(); error = ""
  if result.provider_called() = 0 then return 0
  identity = "SELECT count(*) FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE a.attempt_id=?1 AND i.job_id=" || _q(claim.job_id()) || " AND a.item_id=" || _q(claim.item_id()) || " AND a.worker_id=" || _q(claim.worker_id()) || " AND a.fence=" || claim.fence()
  if _boundcount(database,identity,claim.attempt_id()) \= 1 | _boundcount(database,"SELECT count(*) FROM job_events WHERE attempt_id=?1 AND event_type='provider-intent'",claim.attempt_id()) \= 1 | _boundeventcount(database,claim.job_id(),"reservation-open:" || claim.attempt_id() || "#call-1") \= 1 then do; error = "uncertain usage has no original reservation and intent"; return -3; end
  provider_run = _boundscalartext(database,"SELECT coalesce(provider_run_id,'') FROM attempts WHERE attempt_id=?1",claim.attempt_id())
  if result.provider_run_id() \= "" & result.provider_run_id() \= provider_run then do; error = "uncertain usage conflicts with its original provider run"; return -3; end
  if provider_run = "" then do
    provider_run = "provider-run-sha256:" || rxhash..sha256hex((claim.attempt_id() || "#call-1" || "00"x || result.provider_id() || "00"x || result.model() || "00"x || result.request_id()) as .binary)
    request_hash = rxhash..sha256hex((result.provider_id() || "00"x || result.model() || "00"x || result.request_id() || "00"x || claim.attempt_id()) as .binary)
    recovery = '{"schema":"crexx.provider-recovery/1","receipt_missing":1,"request_id":' || jsonquote(result.request_id()) || ',"content":""}'
    sql = "INSERT INTO provider_runs(provider_run_id,config_snapshot_id,provider_id,model,request_hash,outcome,input_tokens,output_tokens,duration_ms,started_at,charging_basis,cost_microunits,purpose,recovery_json) VALUES(" || _q(provider_run) || "," || _q(claim.config_snapshot_id()) || "," || _q(result.provider_id()) || "," || _q(result.model()) || "," || _q(request_hash) || ",'completed-unsettled'," || result.input_tokens() || "," || result.output_tokens() || "," || result.duration_ms() || ",strftime('%Y-%m-%dT%H:%M:%fZ','now')," || _q(result.charging_basis()) || "," || result.cost() || ",'work-item'," || _q(recovery) || ")"
    if sqliteexec(database,sql) \= 0 then do; error = "cannot retain unreceipted provider usage"; return -3; end
    if sqliteexec(database,"UPDATE attempts SET provider_run_id=" || _q(provider_run) || " WHERE attempt_id=" || _q(claim.attempt_id()) || " AND provider_run_id IS NULL") \= 0 | _scalarint(database,"SELECT changes()") \= 1 then do; error = "cannot link unreceipted usage to original attempt"; return -3; end
  end
  else do
    sql = "UPDATE provider_runs SET input_tokens=max(input_tokens," || result.input_tokens() || "),output_tokens=max(output_tokens," || result.output_tokens() || "),duration_ms=max(duration_ms," || result.duration_ms() || "),cost_microunits=CASE WHEN charging_basis='monetary-api' THEN max(cost_microunits," || result.cost() || ") ELSE cost_microunits END WHERE provider_run_id=" || _q(provider_run) || " AND config_snapshot_id=" || _q(claim.config_snapshot_id()) || " AND provider_id=" || _q(result.provider_id()) || " AND model=" || _q(result.model()) || " AND outcome IN('starting','running','completed-unsettled')"
    if sqliteexec(database,sql) \= 0 | _scalarint(database,"SELECT changes()") \= 1 then do; error = "cannot retain uncertain provider usage"; return -3; end
  end
  return 0
