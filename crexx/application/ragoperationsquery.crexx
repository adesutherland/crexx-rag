options levelg

namespace ragoperationsquery expose jobprogresscommand readtaskpage operatordiagnostics jobstatuscommand jobplancommand jobeventscommand taskinventorycommand jobinspectcommand joblistcommand

import ragallowance
import ragbacklog
import ragjob
import ragwork
import ragusage
import raglifecycle
import ragrepository
import ragsupervision
import rxjson
import rxhash
import ragcommand
import ragcommandutil
import ragsqlsupport
import ragresultpages
import ragstore
import rxfnsb
import rxsqlite

/* Read-only, bounded operator inspection of durable tasks, workflows, job items and attempts. No provider execution or repair side effects. */
readtaskpage: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request,"read") \= 1 then return commandfailure(operation,4,"task inspection requires read access")
  if commandoptions(request,"id cursor limit state capability workflow subject concept source",error) \= 0 then return commandfailure(operation,2,error)
  id = commandid(request,error)
  if error\="" then return commandfailure(operation,2,error)
  cursor = commandoption(request,"cursor",error); count_text = commandoption(request,"limit",error)
  state = commandoption(request,"state",error); capability = commandoption(request,"capability",error); workflow = commandoption(request,"workflow",error)
  subject=commandoption(request,"subject",error);concept=commandoption(request,"concept",error);source=commandoption(request,"source",error)
  if pos("00"x,id || cursor || state || capability || workflow || subject || concept || source)>0 then return commandfailure(operation,2,"inspection filters must not contain NUL")
  if length(subject)>512 | length(concept)>512 | length(source)>512 then return commandfailure(operation,2,"subject, concept and source filters must be at most 512 characters")
  if operation\="maintain.tasks" & (subject\="" | concept\="" | source\="") then return commandfailure(operation,2,"subject/concept/source filters apply to task lists only")
  if error \= "" then return commandfailure(operation,2,error)
  if count_text = "" then count_text = "20"
  if commandunsigned(count_text) \= 1 then return commandfailure(operation,2,"limit must be an integer")
  limit = count_text as .int
  if limit < 1 | limit > 50 | length(cursor)>512 then return commandfailure(operation,2,"task page limit must be 1 through 50 and cursor at most 512 bytes")
  if state \= "" & wordpos(state,"pending dispatched resolved unresolved review superseded failed") = 0 then return commandfailure(operation,2,"unknown task state")
  if capability \= "" & wordpos(capability,"standard advanced-reasoning") = 0 then return commandfailure(operation,2,"unknown resolver capability")
  store = .ragstorehandle
  if openragstore(request.library(),"readonly",store,error) \= 0 then return commandopenfailure(operation,error)
  database = store.database(); sql = ""; source_summary = ""; source_chunks = ""
  if source \= "" then do
    if sqliteexec(database,"BEGIN") \= 0 then do; ignored="";call closeragstore store,ignored;return commandfailure(operation,7,"cannot open source backlog read snapshot");end
    if sqlreadint(database,"SELECT count(*) FROM sources WHERE source_id=" || sqlquote(source) || " AND visible_to_generation IS NULL") \= 1 then do;ignored="";call closeragstore store,ignored;return commandfailure(operation,5,"source was not found");end
    source_chunks = currentsourcechunks(source)
    source_summary = _sourcebacklogsummary(database,source,source_chunks)
    if source_summary="" then do;ignored="";call closeragstore store,ignored;return commandfailure(operation,7,"cannot read source backlog summary");end
  end
  if operation = "maintain.tasks" then do
    filter = ""
    if id \= "" then filter = filter || " AND task_id=" || sqlquote(id)
    if state \= "" then filter = filter || " AND state=" || sqlquote(state)
    if capability \= "" then filter = filter || " AND required_capability=" || sqlquote(capability)
    if workflow \= "" then filter = filter || " AND workflow_id=" || sqlquote(workflow)
    if subject\="" then filter=filter || " AND subject_id=" || sqlquote(subject)
    if source\="" then filter=filter || " AND subject_type IN('chunk','provenance-chunk') AND subject_id IN(" || source_chunks || ")"
    if concept\="" then filter=filter || " AND ((subject_type='concept' AND subject_id IN(SELECT concept_id FROM concepts WHERE canonical_label=" || sqlquote(concept) || ")) OR workflow_id IN(SELECT w.workflow_id FROM maintenance_workflows w WHERE " || _workflowconceptpredicate(concept) || "))"
    sql = "SELECT task_id,json_object('task_id',task_id,'kind',kind,'subject_type',subject_type,'subject_id',subject_id,'workflow_id',workflow_id,'state',state,'priority',priority,'question',question,'attempts',attempt_count,'required_capability',required_capability,'escalation_origin',escalation_origin,'escalation_reason',escalation_reason,'semantic_failures',semantic_failures,'reason',last_error) FROM maintenance_tasks WHERE task_id>" || sqlquote(cursor) || filter || " ORDER BY task_id LIMIT " || (limit+1)
  end
  else do
    if cursor = "" then cursor = "0"
    if commandunsigned(cursor) \= 1 | id = "" then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,2,"task evidence requires a task id and numeric cursor"); end
    if sqlreadint(database,"SELECT count(*) FROM maintenance_tasks WHERE task_id=" || sqlquote(id)) \= 1 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,5,"task was not found"); end
    sql = "SELECT CAST(p.key+1 AS TEXT),json_set(p.value,'$.citation','crexx-rag:'||l.library_id||':'||v.source_id||':'||v.revision_id||':utf8-'||r.normalized_start||'-'||r.normalized_end,'$.source_title',s.observed_title) FROM maintenance_tasks t,json_each(t.evidence_json,'$.passages') p JOIN revision_chunks r ON r.revision_chunk_id=json_extract(p.value,'$.revision_chunk_id') JOIN source_revisions v ON v.revision_id=r.revision_id JOIN sources s ON s.source_id=v.source_id CROSS JOIN library_meta l WHERE t.task_id=" || sqlquote(id) || " AND p.key+1>" || (cursor as .int) || " ORDER BY p.key LIMIT " || (limit+1)
  end
  records = .ragresultrecord[]; prepared = .binary; returned = 0; next_cursor = ""; previous = ""
  if source_summary \= "" then do
    fields = .ragresultfield[];fields[1]=.ragresultfield("source_id","string",source);fields[2]=.ragresultfield("detail","string",source_summary)
    records[1]=.ragresultrecord("source-backlog",fields)
  end
  if sqliteprepare(database,sql,prepared) \= 0 then do; detail = sqliteerrordetail(); ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,"cannot prepare task page: " || detail); end
  do forever
    step = sqlitestep(prepared); if step = 101 then leave
    row_id = ""; detail = ""
    if step \= 100 | sqlitecolumntext(prepared,0,row_id) \= 0 | sqlitecolumntext(prepared,1,detail) \= 0 then do; error = "cannot read task page"; leave; end
    if returned = limit then do; next_cursor = previous; leave; end
    if length(detail)>65535 & operation="maintain.evidence" then do
      detail=sqlreadtext(database,"SELECT json_set(json_remove(" || sqlquote(detail) || ",'$.text'),'$.text_omitted',json('true'),'$.text_read_tool','rag_citation_show','$.inventory_tool','rag_task_evidence_inventory')")
    end
    if operation="maintain.tasks" then detail=sqlreadtext(database,"SELECT json_set(" || sqlquote(detail) || ",'$.waiver',json(" || sqlquote(taskwaiverjson(database,row_id)) || "))")
    if detail="" | length(detail)>65535 then do; error = "task page entry exceeds response bound; inspect the paged evidence inventory"; leave; end
    fields = .ragresultfield[]; fields[1] = .ragresultfield("id","string",row_id); fields[2] = .ragresultfield("detail","string",detail)
    records[records.0+1] = .ragresultrecord("maintenance-task-page-item",fields); returned = returned+1; previous = row_id
  end
  call sqlitefinalize prepared
  ignored = ""; closed = closeragstore(store,ignored)
  if error \= "" | closed \= 0 then return commandfailure(operation,7,error || ignored)
  fields = .ragresultfield[]; fields[1] = .ragresultfield("returned","integer",returned); fields[2] = .ragresultfield("next_cursor","string",next_cursor)
  records[records.0+1] = .ragresultrecord("page",fields)
  return .ragcommandresult(operation,"ok",0,"bounded task inspection without writes or provider calls",records)

/* One source-wide census summary accompanies the bounded task page. Accepted
 * coverage uses the same durable extraction receipt as first-pass selection. */
_sourcebacklogsummary: procedure = .string
  arg database = .binary, source = .string, chunks = .string
  missing = firstreviewmissing("c.revision_chunk_id")
  accepted = "NOT " || missing
  empty = "EXISTS(SELECT 1 FROM maintenance_tasks t JOIN maintenance_task_items m ON m.task_id=t.task_id JOIN job_items i ON i.item_id=m.item_id JOIN attempts a ON a.item_id=i.item_id JOIN job_events e ON e.item_id=i.item_id AND e.attempt_id=a.attempt_id AND e.event_type='processed' WHERE t.kind='concept-review' AND t.subject_type='chunk' AND t.subject_id=c.revision_chunk_id AND i.item_type='improve-extraction' AND i.state='processed' AND a.outcome='succeeded' AND a.validation_state='validated-discovery-batch' AND json_valid(e.message) AND json_extract(e.message,'$.mentions')=0 AND json_extract(e.message,'$.relationships')=0 AND json_extract(e.message,'$.notes')=0)"
  excepted = "EXISTS(SELECT 1 FROM maintenance_tasks t WHERE t.kind='concept-review' AND t.subject_type='chunk' AND t.subject_id=c.revision_chunk_id AND " || taskwaived("t.task_id") || ")"
  sql = "WITH chunks AS MATERIALIZED (" || chunks || "), tasks AS MATERIALIZED (SELECT t.subject_id,t.state,t.priority FROM chunks c JOIN maintenance_tasks t ON t.subject_id=c.revision_chunk_id WHERE t.subject_type='chunk' AND t.kind='concept-review'), counts AS (SELECT count(DISTINCT subject_id) represented,min(priority) minimum_priority,max(priority) maximum_priority FROM tasks), total AS (SELECT count(*) active_chunks FROM chunks), coverage AS (SELECT coalesce(sum(" || accepted || "),0) accepted,coalesce(sum((" || accepted || ") AND " || empty || "),0) accepted_empty,coalesce(sum(" || missing || "),0) incomplete,coalesce(sum((" || missing || ") AND " || excepted || "),0) excepted FROM chunks c) SELECT json_object('source_id'," || sqlquote(source) || ",'generation',(SELECT published_generation FROM library_meta),'active_chunks',active_chunks,'accepted_first_pass_chunks',coverage.accepted,'accepted_empty_first_pass_chunks',coverage.accepted_empty,'incomplete_first_pass_chunks',coverage.incomplete,'explicitly_excepted_first_pass_chunks',coverage.excepted,'chunks_with_extraction_task',represented,'chunks_without_extraction_task',active_chunks-represented,'extraction_tasks_by_state',json((SELECT json_group_object(state,total) FROM (SELECT state,count(*) total FROM tasks GROUP BY state))),'minimum_priority',minimum_priority,'maximum_priority',maximum_priority,'denominator','Current source chunks. Accepted first-pass coverage requires a succeeded validated extraction receipt; incomplete includes held and excepted chunks. Task-state counts are versions, not accepted coverage.') FROM counts CROSS JOIN total CROSS JOIN coverage"
  return sqlreadtext(database,sql)

/* The WHERE clause owns filtering before the keyset cursor and row limit.
 * These queries expose durable identities and summaries, never raw inputs or
 * provider response bodies. All reads share one SQLite snapshot. */
operatordiagnostics: procedure = .ragcommandresult
  arg request=.ragcommandrequest
  operation=request.operation();error=""
  if commandhasaccess(request,"read")\=1 then return commandfailure(operation,4,"operator inspection requires read access")
  allowed="id cursor limit state"
  if operation="job.items" then allowed=allowed || " uncertainty all task type model prompt outcome error since until"
  if operation="job.attempts" then allowed="id item task cursor limit"
  if operation="maintain.workflows" then allowed="id subject concept state cursor limit"
  if commandworkeroptions(request,allowed,"all",error)\=0 then return commandfailure(operation,2,error)
  id=commandid(request,error)
  if error\="" then return commandfailure(operation,2,error)
  cursor=commandoption(request,"cursor",error);count_text=commandoption(request,"limit",error)
  state=commandoption(request,"state",error);item=commandoption(request,"item",error)
  subject=commandoption(request,"subject",error);concept=commandoption(request,"concept",error)
  uncertainty=commandoption(request,"uncertainty",error)
  if pos("00"x,id || cursor || state || item || subject || concept || uncertainty)>0 then return commandfailure(operation,2,"inspection filters must not contain NUL")
  if count_text="" then count_text="20"
  if commandunsigned(count_text)\=1 then return commandfailure(operation,2,"limit must be an integer")
  limit=count_text as .int
  if limit<1 | limit>100 | length(cursor)>512 | length(id)>512 | length(item)>512 | length(subject)>512 | length(concept)>512 then return commandfailure(operation,2,"inspection limit must be 1 through 100 and identities/labels/cursors at most 512 characters")
  if operation="job.items" & state\="" then if wordpos(state,"queued running processed skipped dead_letter cancelled cancel_requested")=0 then return commandfailure(operation,2,"unknown job item state")
  if uncertainty\="" then if wordpos(uncertainty,"all active held")=0 then return commandfailure(operation,2,"uncertainty must be all, active or held")
  if operation="maintain.workflows" & state\="" then if wordpos(state,"migrating waiting complete")=0 then return commandfailure(operation,2,"unknown workflow state")
  all_jobs=commandoption(request,"all",error)
  if all_jobs="true" & (operation<>"job.items" | id<>"") then return commandfailure(operation,2,"choose one job id or --all")
  if left(operation,4)="job." & id="" & all_jobs<>"true" then return commandfailure(operation,2,"job inspection requires one job id or explicit --all")
  example_filter="";attempt_filter=""
  if operation="job.items" then example_filter=_examplefilter(request,error,attempt_filter)
  task_filter=commandoption(request,"task",error)
  if length(task_filter)>512 | pos("00"x,task_filter)>0 then return commandfailure(operation,2,"invalid task filter")
  if error<>"" then return commandfailure(operation,2,error)
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)\=0 then return commandopenfailure(operation,error)
  database=view.database()
  if _validtimes(database,request,error)<>0 then do;ignored="";call closereadsnapshot view,ignored;return commandfailure(operation,2,error);end
  if left(operation,4)="job." & id<>"" then do
    found=_jobexists(database,id,error)
    if found\=1 then do
      ignored="";call closereadsnapshot view,ignored
      if found=0 then return commandfailure(operation,5,"job was not found")
      return commandfailure(operation,7,error)
    end
  end
  filter="";sql="";kind=""
  if operation="job.items" then do
    kind="job-item"
    scope="i.job_id=?1";if all_jobs="true" then scope="?1=''"
    filter=example_filter
    if uncertainty\="" then filter=filter || " AND " || uncertainitem("i.item_id")
    if uncertainty="active" then filter=filter || " AND i.state IN('running','cancel_requested')"
    if uncertainty="held" then filter=filter || " AND i.state NOT IN('running','cancel_requested')"
    sql="SELECT i.item_id,json_object('item_id',i.item_id,'job_id',i.job_id,'item_type',i.item_type,'state',i.state,'worker_id',i.worker_id,'fence',i.fence,'lease_until',i.lease_until,'retry_at',i.retry_at,'input_hash',i.input_hash,'created_at',i.created_at,'updated_at',i.updated_at,'attempts',(SELECT count(*) FROM attempts a WHERE a.item_id=i.item_id),'task_id',coalesce((SELECT task_id FROM maintenance_task_items t WHERE t.item_id=i.item_id),(SELECT json_extract(e.message,'$.task_id') FROM job_events e WHERE e.item_id=i.item_id AND e.event_type='extraction-review-required' LIMIT 1)),'attempt_id',(SELECT a.attempt_id FROM attempts a WHERE a.item_id=i.item_id" || attempt_filter || " ORDER BY a.fence DESC,a.attempt_id DESC LIMIT 1),'inspect_operation','job.inspect','model',json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.model'),'role',json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.role')) FROM job_items i WHERE " || scope || " AND i.item_id>?2 AND (?3='' OR i.state=?3)" || filter || " ORDER BY i.item_id LIMIT ?4"
  end
  if operation="job.attempts" then do
    kind="job-attempt"
    if task_filter<>"" then filter=" AND " || _taskitempredicate(sqlquote(task_filter))
    sql="SELECT a.attempt_id,json_object('attempt_id',a.attempt_id,'item_id',a.item_id,'job_id',i.job_id,'worker_id',a.worker_id,'fence',a.fence,'input_hash',a.input_hash,'output_hash',a.output_hash,'provider_run_id',a.provider_run_id,'validation_state',a.validation_state,'outcome',a.outcome,'started_at',a.started_at,'completed_at',a.completed_at) FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=?1 AND a.attempt_id>?2 AND (?3='' OR a.item_id=?3)" || filter || " ORDER BY a.attempt_id LIMIT ?4"
    state=item
  end
  if operation="maintain.workflows" then do
    kind="maintenance-workflow"
    if subject\="" then filter=filter || " AND (w.parent_concept_id=" || sqlquote(subject) || " OR EXISTS(SELECT 1 FROM json_each(w.successors_json) s WHERE json_extract(s.value,'$.concept_id')=" || sqlquote(subject) || "))"
    if concept\="" then filter=filter || " AND " || _workflowconceptpredicate(concept)
    sql="SELECT w.workflow_id,json_object('workflow_id',w.workflow_id,'kind',w.kind,'parent_concept_id',w.parent_concept_id,'parent_label',c.canonical_label,'origin_task_id',w.origin_task_id,'successors',json(w.successors_json),'state',w.state,'created_generation',w.created_generation,'completed_generation',w.completed_generation,'task_count',(SELECT count(*) FROM maintenance_tasks t WHERE t.workflow_id=w.workflow_id)) FROM maintenance_workflows w JOIN concepts c ON c.concept_id=w.parent_concept_id WHERE (?1='' OR w.workflow_id=?1) AND w.workflow_id>?2 AND (?3='' OR w.state=?3)" || filter || " ORDER BY w.workflow_id LIMIT ?4"
  end
  prepared=.binary;records=.ragresultrecord[];previous="";next_cursor=""
  status=sqliteprepare(database,sql,prepared);prepared_ok=status=0
  if status=0 then status=sqlitebindtext(prepared,1,id) | sqlitebindtext(prepared,2,cursor) | sqlitebindtext(prepared,3,state) | sqlitebindint(prepared,4,limit+1)
  if status\=0 then error="cannot prepare operator page: " || sqliteerrordetail()
  do while error=""
    step=sqlitestep(prepared)
    if step=101 then leave
    row_id="";detail=""
    if step\=100 | sqlitecolumntext(prepared,0,row_id)\=0 | sqlitecolumntext(prepared,1,detail)\=0 then do;error="cannot read operator page";leave;end
    if records.0=limit then do;next_cursor=previous;leave;end
    if operation="job.items" then do
      recovery=_itemrecovery(database,row_id)
      if recovery="" then do;error="cannot inspect item recovery";leave;end
      detail=sqlreadtext(database,"SELECT json_set(" || sqlquote(detail) || ",'$.recovery',json(" || sqlquote(recovery) || "))")
    end
    if row_id="" | length(row_id)>512 | length(detail)>65535 then do;error="operator page record exceeds its bound";leave;end
    fields=.ragresultfield[];fields[1]=.ragresultfield("id","string",row_id);fields[2]=.ragresultfield("detail","string",detail)
    fields[3]=.ragresultfield("generation","integer",view.generation())
    records[records.0+1]=.ragresultrecord(kind,fields);previous=row_id
  end
  if prepared_ok then call sqlitefinalize prepared
  close_error="";closed=closereadsnapshot(view,close_error)
  if error\="" | closed\=0 then return commandfailure(operation,7,error || close_error)
  if operation="maintain.workflows" & id\="" & records.0=0 then return commandfailure(operation,5,"workflow was not found")
  call appendresultpage records,next_cursor,limit
  return .ragcommandresult(operation,"ok",0,"bounded operator inspection without writes or provider calls",records)

_jobexists: procedure = .int
  arg database=.binary,id=.string,expose error=.string
  error="";prepared=.binary;found=0
  if sqliteprepare(database,"SELECT count(*) FROM jobs WHERE job_id=?1",prepared)\=0 then do;error="cannot prepare job lookup";return -1;end
  status=sqlitebindtext(prepared,1,id)
  if status=0 then do
    if sqlitestep(prepared)\=100 then status=-1
    else status=sqlitecolumnint(prepared,0,found)
  end
  call sqlitefinalize prepared
  if status\=0 then do;error="cannot read job lookup";return -1;end
  return found

/* Exact canonical labels may identify several concepts. Preserve every match;
 * the caller uses returned stable IDs to select one subject/workflow. */
_workflowconceptpredicate: procedure = .string
  arg concept=.string
  ids="SELECT concept_id FROM concepts WHERE canonical_label=" || sqlquote(concept)
  return "(w.parent_concept_id IN(" || ids || ") OR EXISTS(SELECT 1 FROM json_each(w.successors_json) s WHERE json_extract(s.value,'$.concept_id') IN(" || ids || ")))"

jobstatuscommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "job status requires read access")
  if commandworkeroptions(request, "id seconds diagnostics", "diagnostics", error) \= 0 then return commandfailure(operation, 2, error)
  job_id = commandid(request, error)
  if error \= "" | job_id = "" then return commandfailure(operation, 2, "job status requires one job id")
  seconds_text=commandoption(request,"seconds",error)
  if seconds_text="" then seconds_text="300"
  if commandunsigned(seconds_text)<>1 | length(seconds_text)>5 then return commandfailure(operation,2,"status interval requires --seconds from 1 through 86400")
  seconds=seconds_text as .int
  if seconds<1 | seconds>86400 then return commandfailure(operation,2,"status interval requires --seconds from 1 through 86400")
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)<>0 then return commandopenfailure(operation,error)
  store=.ragstorehandle(view.database(),request.library(),"readonly")
  observed=sqlreadint(view.database(),"SELECT unixepoch()")
  status = .ragjobstatus; read_status = readjobstatus(store, job_id, status, error)
  supervision = readsupervision(store,job_id,error)
  if error <> "" then read_status = -1
  usage=jobusagejson(view.database(),job_id,observed,seconds)
  interval=jobintervaljson(view.database(),job_id,observed,seconds)
  if usage="" | interval="" then do;error="cannot read job usage or observation interval";read_status=-1;end
  allowance=joballowancejson(view.database(),job_id)
  diagnostics=""
  if commandoption(request,"diagnostics",error)="true" then diagnostics=_jobdiagnostics(view.database(),job_id)
  ignored = ""; close_status = closereadsnapshot(view, ignored)
  if read_status = -2 then return commandfailure(operation, 5, "job was not found")
  if read_status \= 0 | close_status \= 0 then return commandfailure(operation, 7, error)
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("job_id", "string", status.job_id())
  fields[2] = .ragresultfield("state", "string", status.state())
  fields[3] = .ragresultfield("planned_total", "integer", status.planned_total())
  fields[4] = .ragresultfield("queued", "integer", status.queued())
  fields[5] = .ragresultfield("running", "integer", status.running())
  fields[6] = .ragresultfield("processed", "integer", status.processed())
  fields[7] = .ragresultfield("skipped", "integer", status.skipped())
  fields[8] = .ragresultfield("dead_letter", "integer", status.dead_letter())
  fields[9] = .ragresultfield("cancelled", "integer", status.cancelled())
  fields[10] = .ragresultfield("failed_attempts", "integer", status.failed_attempts())
  fields[11] = .ragresultfield("last_error", "string", status.last_error())
  fields[12] = .ragresultfield("waiting_reason", "string", status.waiting_reason())
  fields[13] = .ragresultfield("retry_pending", "integer", status.retry_pending())
  fields[14] = .ragresultfield("retry_reason", "string", status.retry_reason())
  recovery = .jsondocument(supervision)
  names = "configured_workers live_workers registered_workers unverified_workers requested_workers window_seconds max_restarts recent_replacements remaining_replacements next_eligible_epoch heartbeat_age_seconds"
  do i = 1 to words(names)
    name = word(names,i); value = 0
    ignored = recovery.node_int(recovery.member(recovery.root(),name),value)
    fields[fields.0+1] = .ragresultfield("worker_" || name,"integer",value)
  end
  reason = ""; ignored = recovery.node_string(recovery.member(recovery.root(),"waiting_reason"),reason)
  fields[fields.0+1] = .ragresultfield("worker_waiting_reason","string",reason)
  names="controller_id controller_state"
  do i=1 to words(names)
    name=word(names,i);text="";ignored=recovery.node_string(recovery.member(recovery.root(),name),text)
    fields[fields.0+1]=.ragresultfield("worker_" || name,"string",text)
  end
  fields[fields.0+1]=.ragresultfield("item_limit","integer",status.item_limit())
  fields[fields.0+1]=.ragresultfield("allowance","string",allowance)
  usage_document=.jsondocument(usage);interval_document=.jsondocument(interval)
  names="recorded_provider_runs recorded_provider_time_ms recorded_input_tokens recorded_output_tokens recorded_cost_microunits unpriced_runs successful_provider_runs failed_provider_runs other_provider_runs interval_provider_runs interval_successful_runs timestamp_unknown_runs uncertain_items active_unsettled_items held_uncertain_items incomplete_usage_observations"
  do i=1 to words(names)
    name=word(names,i);value=0;ignored=usage_document.node_int(usage_document.member(usage_document.root(),name),value)
    fields[fields.0+1]=.ragresultfield(name,"integer",value)
  end
  names="interval_seconds interval_processed interval_skipped correction_requested_items correction_processed_items interval_correction_processed"
  processed=0
  do i=1 to words(names)
    name=word(names,i);value=0;ignored=interval_document.node_int(interval_document.member(interval_document.root(),name),value)
    if name="interval_processed" then processed=value
    fields[fields.0+1]=.ragresultfield(name,"integer",value)
  end
  observed_at="";ignored=interval_document.node_string(interval_document.member(interval_document.root(),"observed_at"),observed_at)
  fields[fields.0+1]=.ragresultfield("observed_at","string",observed_at)
  fields[fields.0+1]=.ragresultfield("processed_per_minute","string",(processed as .float)*60.0/(seconds as .float))
  fields[fields.0+1]=.ragresultfield("usage_basis","string","recorded provider runs; unknown outcomes and unpriced usage remain explicit")
  if diagnostics<>"" then fields[fields.0+1]=.ragresultfield("diagnostics","string",diagnostics)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-status", fields)
  return .ragcommandresult(operation, "ok", 0, "bounded durable job status", records)
jobplancommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation=request.operation(); error=""
  if commandhasaccess(request,"read")\=1 then return commandfailure(operation,4,"job plan requires read access")
  if commandoptions(request,"id cursor limit",error)\=0 then return commandfailure(operation,2,error)
  id=commandid(request,error); cursor=commandoption(request,"cursor",error); limit=commandoption(request,"limit",error)
  if error\="" | id="" then return commandfailure(operation,2,"job plan requires one job id")
  offset=0; count=0
  if parseplanpage(cursor,limit,offset,count,error)\=0 then return commandfailure(operation,2,error)
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)\=0 then return commandopenfailure(operation,error)
  page=.ragjobplanpage
  status=readjobplanpage(view,id,offset,count,page,error)
  close_error=""; closed=closereadsnapshot(view,close_error)
  if closed\=0 then return commandfailure(operation,7,close_error)
  if status=1 then return commandfailure(operation,5,error)
  if status=-1 then return commandfailure(operation,2,error)
  if status\=0 then return commandfailure(operation,7,error)
  return .ragcommandresult(operation,"ok",0,"bounded retained job plan read without mutation",planresultrecords(page))
jobeventscommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request,"read") \= 1 then return commandfailure(operation,4,"job events requires read access")
  if commandoptions(request,"id cursor limit",error) \= 0 then return commandfailure(operation,2,error)
  job_id = commandid(request,error); cursor = commandoption(request,"cursor",error); limit_text = commandoption(request,"limit",error)
  if error \= "" | job_id = "" then return commandfailure(operation,2,"job events requires one job id")
  if cursor = "" then cursor = "0"
  if limit_text = "" then limit_text = "20"
  if commandunsigned(cursor) \= 1 | commandunsigned(limit_text) \= 1 then return commandfailure(operation,2,"event cursor and limit must be non-negative integers")
  limit = limit_text as .int
  if limit < 1 | limit > 100 then return commandfailure(operation,2,"event limit must be 1 through 100")
  view = .ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error) \= 0 then return commandopenfailure(operation,error)
  database = view.database(); prepared = .binary
  if sqlreadint(database,"SELECT count(*) FROM jobs WHERE job_id=" || sqlquote(job_id)) \= 1 then do; ignored = ""; call closereadsnapshot view,ignored; return commandfailure(operation,5,"job was not found"); end
  sql = "SELECT event_id,coalesce(item_id,''),coalesce(attempt_id,''),event_type,message,occurred_at FROM job_events WHERE job_id=?1 AND event_id>?2 ORDER BY event_id LIMIT ?3"
  if sqliteprepare(database,sql,prepared) \= 0 then do; ignored = ""; call closereadsnapshot view,ignored; return commandfailure(operation,7,"cannot prepare durable event page"); end
  binds = sqlitebindtext(prepared,1,job_id) | sqlitebindint(prepared,2,cursor as .int) | sqlitebindint(prepared,3,limit+1)
  records = .ragresultrecord[]; next_cursor = ""; last_event = 0
  do while binds = 0
    step = sqlitestep(prepared)
    if step = 101 then leave
    if step \= 100 then do; error = "cannot read durable event page"; leave; end
    if records.0 = limit then do; next_cursor = last_event as .string; leave; end
    event_id = 0; item_id = ""; attempt_id = ""; event_type = ""; message = ""; occurred = ""
    columns = sqlitecolumnint(prepared,0,event_id) | sqlitecolumntext(prepared,1,item_id) | sqlitecolumntext(prepared,2,attempt_id) | sqlitecolumntext(prepared,3,event_type) | sqlitecolumntext(prepared,4,message) | sqlitecolumntext(prepared,5,occurred)
    if columns \= 0 then do; error = "cannot decode durable event"; leave; end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("event_id","integer",event_id)
    fields[2] = .ragresultfield("job_id","string",job_id)
    fields[3] = .ragresultfield("item_id","string",item_id)
    fields[4] = .ragresultfield("attempt_id","string",attempt_id)
    fields[5] = .ragresultfield("event_type","string",event_type)
    fields[6] = .ragresultfield("message","string",message)
    fields[7] = .ragresultfield("occurred_at","string",occurred)
    if length(message)>8192 then do
      fields[6]=.ragresultfield("message","string",left(message,1024) || " [preview; full retained message omitted from event list]")
      fields[8]=.ragresultfield("message_truncated","boolean","true")
      fields[9]=.ragresultfield("message_characters","integer",length(message))
      fields[10]=.ragresultfield("message_bytes","integer",binlength(message as .binary))
      fields[11]=.ragresultfield("message_sha256","string",rxhash..sha256hex(message as .binary))
      section="";if event_type="provider-request" then section="request"
      if event_type="provider-response" | event_type="provider-diagnostic" then section="response"
      inspection="";if item_id<>"" & attempt_id<>"" & section<>"" then inspection="job.inspect"
      fields[12]=.ragresultfield("inspect_operation","string",inspection)
      fields[13]=.ragresultfield("inspect_section","string",section)
    end
    records[records.0+1] = .ragresultrecord("job-event",fields); last_event = event_id
  end
  call sqlitefinalize prepared
  close_error = ""; closed = closereadsnapshot(view,close_error)
  if binds \= 0 | error \= "" | closed \= 0 then return commandfailure(operation,7,"durable event page failed: " || error || close_error)
  call appendresultpage records,next_cursor,limit
  return .ragcommandresult(operation,"ok",0,"durable job events in database order",records)
taskinventorycommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation=request.operation(); error=""
  if commandhasaccess(request,"read")\=1 then return commandfailure(operation,4,"evidence inventory requires read access")
  if commandoptions(request,"id cursor limit kind scope expect-generation",error)\=0 then return commandfailure(operation,2,error)
  id=commandid(request,error); cursor=commandoption(request,"cursor",error); count_text=commandoption(request,"limit",error)
  kind=commandoption(request,"kind",error); scope=commandoption(request,"scope",error); expected=commandoption(request,"expect-generation",error)
  if kind="" then kind="passages"
  if scope="" then scope="current"
  if count_text="" then count_text="20"
  if expected="" then expected="0"
  if error\="" | id="" | commandunsigned(count_text)\=1 | length(count_text)>2 | commandunsigned(expected)\=1 | length(expected)>15 | length(cursor)>1024 | wordpos(kind,"passages catalogue context")=0 | wordpos(scope,"current stored")=0 then return commandfailure(operation,2,"inventory requires task id, kind passages/catalogue/context, scope current/stored and bounded numeric paging")
  limit=count_text as .int
  if limit<1 | limit>50 then return commandfailure(operation,2,"inventory page limit must be 1..50")
  store=.ragstorehandle
  if openragstore(request.library(),"readonly",store,error)\=0 then return commandopenfailure(operation,error)
  database=store.database(); ignored=""
  if sqliteexec(database,"BEGIN")\=0 then do; call closeragstore store,ignored; return commandfailure(operation,7,"cannot begin inventory read snapshot"); end
  generation=sqlreadint(database,"SELECT published_generation FROM library_meta WHERE singleton=1")
  if expected\="0" & expected as .int\=generation then do; call sqliteexec database,"ROLLBACK"; call closeragstore store,ignored; return commandfailure(operation,6,"inventory generation changed; restart pagination"); end
  task_type=sqlreadtext(database,"SELECT subject_type FROM maintenance_tasks WHERE task_id=" || sqlquote(id))
  if task_type="" | task_type="provenance-chunk" then do; call sqliteexec database,"ROLLBACK"; call closeragstore store,ignored; return commandfailure(operation,5,"task is missing or uses the separate provenance-enrichment support inventory"); end
  selection=backlogindexquery(database,id,kind,scope)
  if selection="" then do; call sqliteexec database,"ROLLBACK"; call closeragstore store,ignored; return commandfailure(operation,5,"current evidence context is unavailable; inspect stored scope"); end
  sql="SELECT id,detail FROM (" || selection || ") WHERE id>" || sqlquote(cursor) || " ORDER BY id LIMIT " || (limit+1)
  records=.ragresultrecord[]; prepared=.binary; returned=0; next_cursor=""; previous=""
  if sqliteprepare(database,sql,prepared)\=0 then error="cannot prepare evidence inventory"
  else do forever
    step=sqlitestep(prepared); if step=101 then leave
    row_id=""; detail=""
    if step\=100 | sqlitecolumntext(prepared,0,row_id)\=0 | sqlitecolumntext(prepared,1,detail)\=0 then do; error="cannot read evidence inventory"; leave; end
    if returned=limit then do; next_cursor=previous; leave; end
    if length(detail)>65535 then do; error="inventory entry exceeds the single-record bound"; leave; end
    fields=.ragresultfield[]; fields[1]=.ragresultfield("id","string",row_id); fields[2]=.ragresultfield("detail","string",detail)
    records[records.0+1]=.ragresultrecord("task-evidence-inventory",fields); returned=returned+1; previous=row_id
  end
  call sqlitefinalize prepared
  call sqliteexec database,"ROLLBACK"
  closed=closeragstore(store,ignored)
  if error\="" | closed\=0 then return commandfailure(operation,7,error || ignored)
  fields=.ragresultfield[]; fields[1]=.ragresultfield("returned","integer",returned); fields[2]=.ragresultfield("next_cursor","string",next_cursor)
  fields[3]=.ragresultfield("generation","integer",generation); fields[4]=.ragresultfield("scope","string",scope); fields[5]=.ragresultfield("kind","string",kind)
  records[records.0+1]=.ragresultrecord("page",fields)
  return .ragcommandresult(operation,"ok",0,"paged evidence inventory; current scope is exploration, stored scope is the task packet",records)

/* Source attribution is the immutable input chunk. Catalogue-wide maintenance
 * questions have no single source and are labelled explicitly. Each item belongs
 * to exactly one group; deferred is a partition of queued, not another attempt. */
jobprogresscommand: procedure = .ragcommandresult
  arg request=.ragcommandrequest
  operation=request.operation();error=""
  if commandhasaccess(request,"read")<>1 then return commandfailure(operation,4,"job progress requires read access")
  if commandoptions(request,"id source operation cursor limit",error)<>0 then return commandfailure(operation,2,error)
  id=commandid(request,error);source=commandoption(request,"source",error);kind=commandoption(request,"operation",error);cursor=commandoption(request,"cursor",error);limit_text=commandoption(request,"limit",error)
  if error<>"" | id="" then return commandfailure(operation,2,"job progress requires one job id")
  if limit_text="" then limit_text="50"
  if commandunsigned(limit_text)<>1 | length(limit_text)>3 then return commandfailure(operation,2,"progress limit must be 1 through 100")
  limit=limit_text as .int
  if limit<1 | limit>100 | length(source)>512 | length(kind)>128 | length(cursor)>1024 | pos("00"x,id || source || kind || cursor)>0 then return commandfailure(operation,2,"invalid bounded progress filters")
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)<>0 then return commandopenfailure(operation,error)
  database=view.database()
  if _jobexists(database,id,error)<>1 then do;ignored="";call closereadsnapshot view,ignored;return commandfailure(operation,5,"job was not found");end
  sql="WITH items AS (SELECT i.*,coalesce(s.source_id,'') AS source_id,coalesce(s.observed_title,'Library or unresolved source') AS source_title FROM job_items i LEFT JOIN revision_chunks c ON c.revision_chunk_id=json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.revision_chunk_id') LEFT JOIN source_revisions v ON v.revision_id=c.revision_id LEFT JOIN sources s ON s.source_id=v.source_id WHERE i.job_id=" || sqlquote(id) || "), groups AS (SELECT item_type||':'||source_id AS page_key,item_type,source_id,source_title,count(*) AS total,sum(state='processed') AS processed,sum(state='skipped') AS skipped,sum(state='queued' AND coalesce(retry_at,0)<=unixepoch()) AS queued,sum(state='queued' AND retry_at>unixepoch()) AS deferred,sum(state IN('running','cancel_requested')) AS running,sum(state='dead_letter') AS dead_letter,sum(state='cancelled') AS cancelled FROM items WHERE (" || sqlquote(source) || "='' OR source_id=" || sqlquote(source) || ") AND (" || sqlquote(kind) || "='' OR item_type=" || sqlquote(kind) || ") GROUP BY item_type,source_id,source_title) SELECT page_key,json_object('operation',item_type,'source_id',source_id,'source_title',source_title,'total',total,'processed',processed,'skipped',skipped,'queued',queued,'deferred',deferred,'running',running,'dead_letter',dead_letter,'cancelled',cancelled,'denominator','materialized job items; queued excludes deferred; provider attempts and corpus coverage are separate') FROM groups WHERE page_key>" || sqlquote(cursor) || " ORDER BY page_key LIMIT " || (limit+1)
  prepared=.binary;records=.ragresultrecord[];previous="";next_cursor=""
  if sqliteprepare(database,sql,prepared)<>0 then error="cannot prepare job progress: " || sqliteerrordetail()
  do while error=""
    step=sqlitestep(prepared);if step=101 then leave
    row_id="";detail=""
    if step<>100 | sqlitecolumntext(prepared,0,row_id)<>0 | sqlitecolumntext(prepared,1,detail)<>0 then do;error="cannot read job progress";leave;end
    if records.0=limit then do;next_cursor=previous;leave;end
    fields=.ragresultfield[];fields[1]=.ragresultfield("id","string",row_id);fields[2]=.ragresultfield("detail","string",detail);fields[3]=.ragresultfield("generation","integer",view.generation())
    records[records.0+1]=.ragresultrecord("job-progress",fields);previous=row_id
  end
  call sqlitefinalize prepared
  ignored="";closed=closereadsnapshot(view,ignored)
  if error<>"" | closed<>0 then return commandfailure(operation,7,error || ignored)
  call appendresultpage records,next_cursor,limit
  return .ragcommandresult(operation,"ok",0,"actual job items by operation and source; one consistent snapshot",records)

_itemrecovery: procedure = .string
  arg database=.binary,item_id=.string
  selector=" WHERE i.item_id=" || sqlquote(item_id)
  task=sqlreadtext(database,"SELECT task_id FROM maintenance_task_items WHERE item_id=" || sqlquote(item_id))
  facts="{}";request=retryrequestjson(database,task,item_id)
  if request="" then request="null"
  if task<>"" then facts=taskretryfacts(database,task,"")
  return sqlreadtext(database,"SELECT json_object('source_id',s.source_id,'source_title',s.observed_title,'revision_chunk_id',c.revision_chunk_id,'task_policy',json(" || sqlquote(facts) || "),'retry_request',json(" || sqlquote(request) || "),'uncertain_outcome',CASE WHEN " || uncertainitem("i.item_id") || " THEN 1 ELSE 0 END,'last_attempt_reason',(SELECT validation_state FROM attempts a WHERE a.item_id=i.item_id ORDER BY a.fence DESC LIMIT 1),'original_attempt_limit',(SELECT json_extract(message,'$.maximum_attempts') FROM job_events WHERE job_id=i.job_id AND event_type='budget-policy' ORDER BY event_id DESC LIMIT 1),'next_action',CASE WHEN i.state IN('running','cancel_requested') THEN 'worker status; wait for active work or drain before changing ownership' WHEN i.state IN('processed','skipped') OR json_extract(" || sqlquote(facts) || ",'$.disposition')='already-complete' THEN 'complete; no retry call needed' WHEN i.state='queued' AND i.retry_at>unixepoch() THEN 'wait until retry_at; inspect provider status' WHEN i.state='queued' THEN 'job continue JOB; retain the current allowance' WHEN " || sqlquote(task) || "<>'' THEN 'maintain inspect TASK; maintain retry TASK --reason REASON retains an explicit request' ELSE 'job retry JOB --item ITEM --reason REASON; job continue JOB; inspect any retained hold' END) FROM job_items i LEFT JOIN revision_chunks c ON c.revision_chunk_id=json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.revision_chunk_id') LEFT JOIN source_revisions v ON v.revision_id=c.revision_id LEFT JOIN sources s ON s.source_id=v.source_id" || selector)

/* Filter metadata before pagination; large request/response bodies stay lazy. */
_examplefilter: procedure = .string
  arg request=.ragcommandrequest,expose error=.string,expose attempt_filter=.string
  error="";filter="";attempt_filter=""
  names="task type model prompt outcome error since until"
  do k=1 to words(names)
    name=word(names,k);value=commandoption(request,name,error)
    if value="" then iterate
    if length(value)>512 | pos("00"x,value)>0 then do;error="example filters must be at most 512 characters without NUL";return "";end
    literal=sqlquote(value)
    input="CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END"
    if name="task" then filter=filter || " AND " || _taskitempredicate(literal)
    if name="type" then filter=filter || " AND i.item_type=" || literal
    if name="model" then filter=filter || " AND json_extract(" || input || ",'$.model')=" || literal
    if name="prompt" then filter=filter || " AND (json_extract(" || input || ",'$.prompt_sha256')=" || literal || " OR EXISTS(SELECT 1 FROM job_events e WHERE e.item_id=i.item_id AND e.event_type='provider-request' AND json_extract(e.message,'$.prompt_sha256')=" || literal || "))"
    if name="since" | name="until" then do
      if length(value)<10 | length(value)>32 then do;error="time filters require ISO-8601 timestamps";return "";end
      comparison=">=";if name="until" then comparison="<"
      attempt_filter=attempt_filter || " AND julianday(a.started_at)" || comparison || "julianday(" || literal || ")"
    end
    if name="outcome" then do
      if wordpos(value,"succeeded failed dead_letter running cancelled expired skipped no-change applied correction-success correction-failed")=0 then do;error="unknown example outcome";return "";end
      if value="no-change" | value="applied" then do
        condition="d.disposition IN('no-change:resolved','no-change:review:accept')"
        if value="applied" then condition="d.applied_generation IS NOT NULL AND json_extract(d.response_json,'$.action') NOT IN('retain','investigate','no-change','defer')"
        filter=filter || " AND EXISTS(SELECT 1 FROM maintenance_decisions d WHERE d.item_id=i.item_id AND " || condition || ")"
      end
      else if left(value,11)="correction-" then do
        state="a.outcome IN('succeeded','processed')";if value="correction-failed" then state="a.outcome IN('failed','dead_letter')"
        attempt_filter=attempt_filter || " AND " || state || " AND EXISTS(SELECT 1 FROM job_events e JOIN attempts original ON original.attempt_id=e.attempt_id WHERE e.item_id=i.item_id AND e.event_type='citation-correction-requested' AND original.fence<a.fence)"
      end
      else if value="failed" then attempt_filter=attempt_filter || " AND a.outcome IN('failed','dead_letter')"
      else attempt_filter=attempt_filter || " AND a.outcome=" || literal
    end
    if name="error" then do
      if wordpos(value,"authentication timeout grounding schema contention transport storage unknown")=0 then do;error="unknown error category";return "";end
      attempt_filter=attempt_filter || " AND a.outcome IN('failed','dead_letter','expired','cancelled') AND " || _errorcategory("a.validation_state") || "=" || literal
    end
  end
  if attempt_filter<>"" then filter=filter || " AND EXISTS(SELECT 1 FROM attempts a WHERE a.item_id=i.item_id" || attempt_filter || ")"
  return filter

_errorcategory: procedure = .string
  arg expression=.string
  reason="lower(coalesce(" || expression || ",''))"
  return "CASE WHEN " || reason || " LIKE '%authentication%' OR " || reason || " LIKE '%unauthorized%' OR " || reason || " LIKE '%credential%' THEN 'authentication' WHEN " || reason || " LIKE '%database is locked%' OR " || reason || " LIKE '%sqlite=5,%' THEN 'contention' WHEN " || reason || " LIKE '%timeout%' OR " || reason || " LIKE '%response deadline%' OR " || reason || " LIKE '%byte operation deadline exceeded%' OR " || reason || " LIKE '%timed out%' THEN 'timeout' WHEN " || reason || " LIKE '%quotation%' OR " || reason || " LIKE '%ground%' THEN 'grounding' WHEN " || reason || " LIKE '%schema%' OR " || reason || " LIKE '%malformed%' OR " || reason || " LIKE '%not valid json%' THEN 'schema' WHEN " || reason || " LIKE '%transport%' OR " || reason || " LIKE '%connection%' OR " || reason || " LIKE '%closed stdout%' OR " || reason || " LIKE '%stdout failed%' THEN 'transport' WHEN " || reason || " LIKE '%storage%' OR " || reason || " LIKE '%sqlite%' THEN 'storage' ELSE 'unknown' END"

/* Exact retained sections, never reconstructed from today's prompt/config. */
jobinspectcommand: procedure = .ragcommandresult
  arg request=.ragcommandrequest
  operation=request.operation();error=""
  if commandhasaccess(request,"read")<>1 then return commandfailure(operation,4,"work inspection requires read access")
  if commandoptions(request,"id attempt section cursor limit",error)<>0 then return commandfailure(operation,2,error)
  id=commandid(request,error);attempt=commandoption(request,"attempt",error);section=commandoption(request,"section",error)
  cursor=commandoption(request,"cursor",error);limit_text=commandoption(request,"limit",error)
  if id="" | error<>"" | length(id)>512 | length(attempt)>512 | pos("00"x,id || attempt)>0 then return commandfailure(operation,2,"inspection requires a valid item id")
  if section="" then section="summary"
  if wordpos(section,"summary request response validation timing decision input")=0 then return commandfailure(operation,2,"unknown inspection section")
  if cursor="" then cursor="0"
  if limit_text="" then limit_text="8192"
  if commandunsigned(cursor)<>1 | length(cursor)>9 | commandunsigned(limit_text)<>1 | length(limit_text)>4 then return commandfailure(operation,2,"invalid detail page")
  offset=cursor as .int;limit=limit_text as .int
  if limit<1 | limit>8192 then return commandfailure(operation,2,"detail page limit must be 1 through 8192")
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)<>0 then return commandopenfailure(operation,error)
  db=view.database();item_sql="SELECT item_id FROM job_items WHERE item_id=" || sqlquote(id)
  exists=sqlreadtext(db,item_sql)
  if exists="" then do;call closereadsnapshot view,error;return commandfailure(operation,5,"work item was not found");end
  if attempt<>"" then do
    exists=sqlreadtext(db,"SELECT attempt_id FROM attempts WHERE item_id=" || sqlquote(id) || " AND attempt_id=" || sqlquote(attempt))
    if exists="" then do;call closereadsnapshot view,error;return commandfailure(operation,5,"attempt does not belong to item");end
  end
  else attempt=sqlreadtext(db,"SELECT attempt_id FROM attempts WHERE item_id=" || sqlquote(id) || " ORDER BY fence DESC,attempt_id DESC LIMIT 1")
  selected="item_id=" || sqlquote(id) || " AND attempt_id=" || sqlquote(attempt)
  body="";availability="retained"
  if section="input" then body=sqlreadtext(db,"SELECT input_json FROM job_items WHERE item_id=" || sqlquote(id))
  if section="request" then body=sqlreadtext(db,"SELECT message FROM job_events WHERE " || selected || " AND event_type='provider-request' ORDER BY event_id LIMIT 1")
  if section="response" then body=sqlreadtext(db,"SELECT message FROM job_events WHERE " || selected || " AND event_type IN('provider-diagnostic','provider-response') ORDER BY CASE event_type WHEN 'provider-diagnostic' THEN 0 ELSE 1 END,event_id LIMIT 1")
  if section="response" & body="" then body=sqlreadtext(db,"SELECT p.recovery_json FROM attempts a JOIN provider_runs p ON p.provider_run_id=a.provider_run_id WHERE a.attempt_id=" || sqlquote(attempt) || " AND p.recovery_json<>''")
  if section="validation" then body=sqlreadtext(db,"SELECT json_object('outcome',outcome,'message',validation_state,'category'," || _errorcategory("validation_state") || ",'category_basis','message classification','correction',json((SELECT coalesce(json_group_array(json_object('type',event_type,'message',message)),'[]') FROM job_events e WHERE e.attempt_id=a.attempt_id AND event_type='citation-correction-requested'))) FROM attempts a WHERE attempt_id=" || sqlquote(attempt))
  if section="decision" then body=sqlreadtext(db,"SELECT json_object('decision_id',decision_id,'response',json(response_json),'grounding',json(grounding_json),'disposition',disposition,'applied_generation',applied_generation) FROM maintenance_decisions WHERE item_id=" || sqlquote(id) || " ORDER BY created_epoch DESC LIMIT 1")
  if section="timing" then body=sqlreadtext(db,"SELECT json_object('started_at',a.started_at,'completed_at',a.completed_at,'provider_duration_ms',p.duration_ms,'provider_elapsed_ms',max(0,p.duration_ms-coalesce((SELECT wait_ms FROM provider_admissions WHERE attempt_id=a.attempt_id LIMIT 1),0)),'usage_complete',coalesce((SELECT json_extract(CASE WHEN json_valid(e.message) THEN e.message ELSE '{}' END,'$.usage_complete') FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type IN('provider-observed','provider-reconciled') ORDER BY e.event_id DESC LIMIT 1),json_extract(nullif(p.recovery_json,''),'$.usage_complete')),'input_tokens',p.input_tokens,'output_tokens',p.output_tokens,'cost_microunits',p.cost_microunits,'provider_run_id',a.provider_run_id,'provider',p.provider_id,'model',p.model,'thread_id',p.external_thread_id,'turn_id',p.external_turn_id,'admission_wait_ms',(SELECT wait_ms FROM provider_admissions WHERE attempt_id=a.attempt_id LIMIT 1),'transactions',json((SELECT coalesce(json_group_array(json_object('occurred_at',e.occurred_at,'measurement',json(e.message))),'[]') FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type='transaction-timing'))) FROM attempts a LEFT JOIN provider_runs p ON p.provider_run_id=a.provider_run_id WHERE a.attempt_id=" || sqlquote(attempt))
  if section="summary" then body=sqlreadtext(db,"SELECT json_object('item_id',i.item_id,'job_id',i.job_id,'state',i.state,'task_id',coalesce(m.task_id,(SELECT json_extract(e.message,'$.task_id') FROM job_events e WHERE e.item_id=i.item_id AND e.event_type='extraction-review-required' LIMIT 1)),'parent_task_id',t.parent_task_id,'attempt_id'," || sqlquote(attempt) || ",'reused_from_attempt',(SELECT message FROM job_events WHERE attempt_id=" || sqlquote(attempt) || " AND event_type='provider-receipt-reused' LIMIT 1),'attempts_operation','job.attempts','inspect_operation','job.inspect','model',json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.model'),'role',json_extract(CASE WHEN json_valid(i.input_json) THEN i.input_json ELSE '{}' END,'$.role'),'input_hash',i.input_hash) FROM job_items i LEFT JOIN maintenance_task_items m ON m.item_id=i.item_id LEFT JOIN maintenance_tasks t ON t.task_id=m.task_id WHERE i.item_id=" || sqlquote(id))
  if body="" then availability="unavailable"
  total=length(body);next=""
  if offset>total then do;call closereadsnapshot view,error;return commandfailure(operation,2,"detail cursor exceeds section length");end
  if offset+limit<total then next=offset+limit
  fields=.ragresultfield[]
  fields[1]=.ragresultfield("item_id","string",id);fields[2]=.ragresultfield("attempt_id","string",attempt);fields[3]=.ragresultfield("section","string",section)
  fields[4]=.ragresultfield("availability","string",availability);fields[5]=.ragresultfield("text","string",substr(body,offset+1,min(limit,total-offset)));fields[6]=.ragresultfield("total_characters","integer",total)
  fields[7]=.ragresultfield("sha256","string",rxhash..sha256hex(body as .binary));fields[8]=.ragresultfield("next_cursor","string",next);fields[9]=.ragresultfield("complete","boolean",commandboolean(next=""));fields[10]=.ragresultfield("provider_calls","integer",0)
  records=.ragresultrecord[];records[1]=.ragresultrecord("work-inspection",fields)
  call closereadsnapshot view,error
  if error<>"" then return commandfailure(operation,7,error)
  return .ragcommandresult(operation,"ok",0,"retained work section; unavailable history is not reconstructed",records)

_validtimes: procedure = .int
  arg database=.binary,request=.ragcommandrequest,expose error=.string
  do k=1 to 2
    name=word("since until",k);value=commandoption(request,name,error)
    if value="" then iterate
    if length(value)<10 | length(value)>32 | substr(value,5,1)<>"-" | substr(value,8,1)<>"-" then do;error="time filters require ISO-8601 timestamps";return -1;end
    if sqlreadint(database,"SELECT julianday(" || sqlquote(value) || ") IS NOT NULL")<>1 then do;error="invalid time filter";return -1;end
  end
  return 0

joblistcommand: procedure = .ragcommandresult
  arg request=.ragcommandrequest
  error="";operation=request.operation()
  if commandhasaccess(request,"read")<>1 then return commandfailure(operation,4,"job list requires read access")
  if commandoptions(request,"cursor limit task type model prompt outcome error since until",error)<>0 then return commandfailure(operation,2,error)
  positionals=request.positionals()
  if positionals.0>0 then return commandfailure(operation,2,"job list accepts filters, not positional IDs")
  cursor=commandoption(request,"cursor",error);limit_text=commandoption(request,"limit",error)
  if limit_text="" then limit_text="20"
  if commandunsigned(limit_text)<>1 | length(limit_text)>3 | length(cursor)>512 | pos("00"x,cursor)>0 then return commandfailure(operation,2,"invalid job page")
  limit=limit_text as .int
  if limit<1 | limit>100 then return commandfailure(operation,2,"job page limit must be 1 through 100")
  attempt_filter="";filter=_examplefilter(request,error,attempt_filter)
  if error<>"" then return commandfailure(operation,2,error)
  if filter<>"" then filter=" AND EXISTS(SELECT 1 FROM job_items i WHERE i.job_id=jobs.job_id" || filter || ")"
  view=.ragreadsnapshot
  if beginreadsnapshot(request.library(),view,error)<>0 then return commandopenfailure(operation,error)
  if _validtimes(view.database(),request,error)<>0 then do;ignored="";call closereadsnapshot view,ignored;return commandfailure(operation,2,error);end
  page=.ragrepositorypage
  status=pagerepository(view,"jobs",cursor,limit,page,error,"",filter)
  ignored="";closed=closereadsnapshot(view,ignored)
  if status<>0 | closed<>0 then return commandfailure(operation,7,error || ignored)
  metadata=.string[];records=repositoryresultrecords(page,metadata,"",limit)
  return .ragcommandresult(operation,"ok",0,"jobs filtered by retained examples before pagination",records)

_jobdiagnostics: procedure = .string
  arg database=.binary,job_id=.string
  job=sqlquote(job_id)
  category=_errorcategory("a.validation_state")
  errors=sqlreadtext(database,"SELECT coalesce(json_group_array(json(row)),'[]') FROM (SELECT json_object('category'," || category || ",'attempts',count(*),'example_item_id',min(a.item_id),'items_operation','job.items','inspect_operation','job.inspect') row FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=" || job || " AND (a.outcome IN('failed','dead_letter') OR (a.outcome='cancelled' AND " || category || "<>'unknown')) GROUP BY " || category || " ORDER BY count(*) DESC)")
  return sqlreadtext(database,"SELECT json_object('task_count',(SELECT count(DISTINCT m.task_id) FROM maintenance_task_items m JOIN job_items i ON i.item_id=m.item_id WHERE i.job_id=" || job || "),'attempts',count(*),'failed_attempts',coalesce(sum(a.outcome IN('failed','dead_letter')),0),'successful_attempts',coalesce(sum(a.outcome='succeeded'),0),'attempts_without_request',coalesce(sum(NOT EXISTS(SELECT 1 FROM job_events e WHERE e.attempt_id=a.attempt_id AND e.event_type='provider-request')),0),'errors',json(" || sqlquote(errors) || "),'category_basis','message classification; inspect original error','controllers_recorded',(SELECT count(*) FROM runtime_instances WHERE kind='controller' AND job_filter=" || job || "),'worker_failures',(SELECT count(*) FROM runtime_instances WHERE kind='worker' AND job_filter=" || job || " AND state='failed'),'workers_operation','worker.list','events_operation','job.events','timing_basis','provider duration includes admission wait; transaction timings only where recorded') FROM attempts a JOIN job_items i ON i.item_id=a.item_id WHERE i.job_id=" || job)

/* An advanced review can originate in ingestion, before any maintenance-window
 * item exists. The event is the existing authoritative lineage in that case. */
_taskitempredicate: procedure = .string
  arg task_literal=.string
  return "(EXISTS(SELECT 1 FROM maintenance_task_items m WHERE m.item_id=i.item_id AND m.task_id=" || task_literal || ") OR EXISTS(SELECT 1 FROM job_events e WHERE e.item_id=i.item_id AND e.event_type='extraction-review-required' AND json_extract(e.message,'$.task_id')=" || task_literal || "))"
