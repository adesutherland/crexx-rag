/* This dispatcher is the single transport-neutral product surface.
 * CLI, ADDRESS RAG and MCP translate into one .ragcommandrequest and preserve
 * the same .ragcommandresult. No adapter owns product SQL or policy. */
dispatchproduct: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation()
  if operation = "source.list" | operation = "source.show" then return _repository(request, operation, "sources")
  if operation = "job.list" then return _repository(request, operation, "jobs")
  if operation = "job.events" then return _repository(request, operation, "job-items")
  if operation = "review.list" | operation = "review.show" then return _repository(request, operation, "reviews")
  if operation = "query.search" | operation = "query.evidence" | operation = "query.answer" | operation = "query.trace" | operation = "query.path" | operation = "query.timeline" then return _query(request, registry)
  if operation = "job.status" then return _jobstatus(request)
  if operation = "job.pause" | operation = "job.resume" | operation = "job.cancel" then return _jobcontrol(request)
  if operation = "job.retry" then return _jobretry(request)
  if operation = "worker.start" then return _workerstart(request, registry)
  if operation = "worker.run" then return _workerrun(request, registry)
  if operation = "worker.list" | operation = "worker.status" then return _workerread(request)
  if operation = "worker.drain" then return _workerdrain(request)
  if operation = "worker.prune" then return _workerprune(request)
  if operation = "provider.list" then return _providerlist(request, registry)
  if operation = "provider.status" then return _providerstatus(request, registry)
  if operation = "provider.test" then return _providertest(request, registry)
  if operation = "profile.list" then return _profilelist(request, registry)
  if operation = "profile.show" then return _profileshow(request, registry)
  if operation = "proposal.plan" then return _proposalplan(request, registry)
  if operation = "proposal.apply" then return _proposalapply(request, registry)
  if operation = "review.decide" then return _reviewdecision(request, 0, registry)
  if operation = "ingest.plan" then return _ingestplan(request, registry)
  if operation = "ingest.apply" then return _ingestapply(request, registry)
  if operation = "maintain.plan" then return _maintainplan(request, registry)
  if operation = "maintain.apply" then return _maintainapply(request, registry)
  if operation = "maintain.status" | operation = "maintain.inspect" then return _maintainread(request)
  return dispatchfoundation(request, registry)

_providerlist: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.list"; error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "provider list requires read access")
  if _options(request, "", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "provider list accepts no positional arguments")
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return _failure(operation, 5, "configuration is not registered")
  providers = lookup.config().providers(); records = .ragresultrecord[]
  do i = 1 to providers.0
    provider = providers[i]; fields = .ragresultfield[]
    fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
    fields[2] = .ragresultfield("kind", "string", provider.kind())
    fields[3] = .ragresultfield("model", "string", provider.model())
    fields[4] = .ragresultfield("route_class", "string", provider.route_class())
    fields[5] = .ragresultfield("privacy_policy", "string", provider.privacy_policy())
    fields[6] = .ragresultfield("charging_basis", "string", provider.charging_basis())
    fields[7] = .ragresultfield("credential_reference", "string", provider.credential().ref_string())
    fields[8] = .ragresultfield("timeout_ms", "integer", provider.timeout_ms())
    fields[9] = .ragresultfield("maximum_attempts", "integer", provider.max_attempts())
    records[records.0 + 1] = .ragresultrecord("provider", fields)
  end
  return .ragcommandresult(operation, "ok", 0, "configured providers listed without resolving credentials or making outbound requests", records)

_profilelist: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "profile.list"; error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "profile list requires read access")
  if _options(request, "", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "profile list accepts no positional arguments")
  ids = registry.profile_ids(); records = .ragresultrecord[]
  do i = 1 to ids.0
    lookup = registry.profile(ids[i])
    if lookup.found() \= 1 then return _failure(operation, 3, "registered profile could not be loaded")
    profile = lookup.profile(); fields = .ragresultfield[]
    fields[1] = .ragresultfield("profile_id", "string", profile.profile_id())
    fields[2] = .ragresultfield("version", "string", profile.version())
    concept_types = .string[]; relationship_types = .ragrelationshiptype[]; validation = .ragvalidationresult
    concept_types = profile.concept_types(); relationship_types = profile.relationship_types(); validation = profile.validation()
    fields[3] = .ragresultfield("concept_type_count", "integer", concept_types.0)
    fields[4] = .ragresultfield("relationship_type_count", "integer", relationship_types.0)
    fields[5] = .ragresultfield("valid", "boolean", _boolean(validation.ok()))
    records[records.0 + 1] = .ragresultrecord("profile", fields)
  end
  return .ragcommandresult(operation, "ok", 0, "registered profiles listed", records)

_profileshow: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "profile.show"; error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "profile show requires read access")
  if _options(request, "", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 > 1 then return _failure(operation, 2, "profile show accepts one profile id")
  profile_id = request.profile_id()
  if positionals.0 = 1 then do
    if profile_id \= "" & profile_id \= positionals[1] then return _failure(operation, 2, "profile id conflicts with global --profile")
    profile_id = positionals[1]
  end
  if profile_id = "" then return _failure(operation, 2, "profile show requires a profile id")
  lookup = registry.profile(profile_id)
  if lookup.found() \= 1 then return _failure(operation, 5, "profile is not registered")
  profile = lookup.profile(); records = .ragresultrecord[]; fields = .ragresultfield[]; validation = .ragvalidationresult
  fields[1] = .ragresultfield("profile_id", "string", profile.profile_id())
  fields[2] = .ragresultfield("version", "string", profile.version())
  validation = profile.validation()
  fields[3] = .ragresultfield("valid", "boolean", _boolean(validation.ok()))
  fields[4] = .ragresultfield("maximum_chunk_characters", "integer", profile.chunk_policy().max_characters())
  fields[5] = .ragresultfield("overlap_characters", "integer", profile.chunk_policy().overlap_characters())
  records[records.0 + 1] = .ragresultrecord("profile", fields)
  values = .string[]; values = profile.concept_types()
  do i = 1 to values.0
    concept_fields = .ragresultfield[]; concept_fields[1] = .ragresultfield("concept_type", "string", values[i])
    records[records.0 + 1] = .ragresultrecord("profile-concept-type", concept_fields)
  end
  relationships = .ragrelationshiptype[]; relationships = profile.relationship_types()
  do i = 1 to relationships.0
    relationship_fields = .ragresultfield[]
    relationship_fields[1] = .ragresultfield("relationship_type", "string", relationships[i].relationship_id())
    relationship_fields[2] = .ragresultfield("inverse", "string", relationships[i].inverse_id())
    relationship_fields[3] = .ragresultfield("directional", "boolean", _boolean(relationships[i].directional()))
    records[records.0 + 1] = .ragresultrecord("profile-relationship-type", relationship_fields)
  end
  aliases = .ragalias[]; aliases = profile.aliases()
  do i = 1 to aliases.0
    alias_fields = .ragresultfield[]
    alias_fields[1] = .ragresultfield("surface", "string", aliases[i].surface())
    alias_fields[2] = .ragresultfield("canonical", "string", aliases[i].canonical())
    records[records.0 + 1] = .ragresultrecord("profile-alias", alias_fields)
  end
  return .ragcommandresult(operation, "ok", 0, "registered profile vocabulary and policy shown", records)

_proposalplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "proposal.plan"; error = ""
  if _hasaccess(request, "plan") \= 1 then return _failure(operation, 4, "proposal planning requires plan access")
  if _options(request, "input", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "proposal plan accepts no positional arguments")
  input = _option(request, "input", error)
  if error \= "" | input = "" then return _failure(operation, 2, "proposal plan requires one --input NDJSON file")
  lookup = registry.profile(request.profile_id())
  if lookup.found() \= 1 then return _failure(operation, 5, "profile is not registered")
  proposals = .ragextractionproposal[]
  if loadexternalproposals(input, proposals, error) \= 0 then return _failure(operation, 2, error)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  policy = profileclaimpolicy(lookup.profile()); plan = .ragexternalproposalplan
  status = createexternalproposalplan(store, snapshot_id, policy, proposals, plan, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 7, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("canonical_plan", "string", plan.canonical())
  fields[2] = .ragresultfield("digest", "string", plan.digest())
  fields[3] = .ragresultfield("proposal_count", "integer", proposals.0)
  fields[4] = .ragresultfield("expected_generation", "integer", plan.expected_generation())
  fields[5] = .ragresultfield("library_writes", "integer", 0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("proposal-plan", fields)
  return .ragcommandresult(operation, "ok", 0, "external proposals validated and planned without library writes", records)

_proposalapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "proposal.apply"; error = ""
  if _hasaccess(request, "curate") \= 1 then return _failure(operation, 4, "proposal apply requires curate access")
  if _options(request, "plan-json expect-digest", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "proposal apply accepts no positional arguments")
  plan_json = _option(request, "plan-json", error); digest = _option(request, "expect-digest", error)
  if error \= "" | plan_json = "" | digest = "" then return _failure(operation, 2, "proposal apply requires --plan-json and --expect-digest")
  if rxhash..sha256hex(plan_json as .binary) \= digest then return _failure(operation, 6, "reviewed proposal plan digest does not match")
  proposals = .ragextractionproposal[]
  if decodeexternalplan(plan_json, proposals, error) \= 0 then return _failure(operation, 2, error)
  lookup = registry.profile(request.profile_id())
  if lookup.found() \= 1 then return _failure(operation, 5, "profile is not registered")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  policy = profileclaimpolicy(lookup.profile()); plan = .ragexternalproposalplan
  plan_status = createexternalproposalplan(store, snapshot_id, policy, proposals, plan, error)
  if plan_status = 0 & (plan.canonical() \= plan_json | plan.digest() \= digest) then do; plan_status = -2; error = "external proposals or library generation changed after review"; end
  reviews_created = 0; apply_status = -1
  if plan_status = 0 then apply_status = applyexternalproposalplan(store, plan, policy, proposals, reviews_created, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | apply_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 6, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("digest", "string", digest)
  fields[2] = .ragresultfield("proposal_count", "integer", proposals.0)
  fields[3] = .ragresultfield("reviews_created", "integer", reviews_created)
  fields[4] = .ragresultfield("provider_calls", "integer", 0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("proposal-apply", fields)
  return .ragcommandresult(operation, "ok", 0, "reviewed external proposals applied through the mandatory review gate", records)

_providerstatus: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.status"; error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "provider status requires read access")
  if _options(request, "provider", error) \= 0 then return _failure(operation, 2, error)
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return _failure(operation, 5, "configuration is not registered")
  has_extended_route = 0; configured_providers = lookup.config().providers()
  do i = 1 to configured_providers.0
    if configured_providers[i].kind() = "codex" | (configured_providers[i].kind() = "openai-compatible" & configured_providers[i].route_class() = "local") then has_extended_route = 1
  end
  if has_extended_route = 0 then return dispatchfoundation(request, registry)
  requested = _option(request, "provider", error); providers = lookup.config().providers(); records = .ragresultrecord[]; unavailable = 0
  do i = 1 to providers.0
    provider = providers[i]
    if requested \= "" & requested \= provider.provider_id() then iterate
    state = "configured-not-probed"; account_type = ""; plan_type = ""; allowance = -1; detail = "configuration is valid"
    if provider.kind() = "codex" then do
      diagnostic = .ragproviderdiagnostic; diagnostic_error = ""
      if codexdiagnostic(provider.timeout_ms(), diagnostic, diagnostic_error) = 0 then do
        state = "ready"; account_type = diagnostic.account_type(); plan_type = diagnostic.plan_type(); allowance = diagnostic.allowance_available(); detail = diagnostic.detail()
      end
      else do; state = "unavailable"; detail = diagnostic_error; unavailable = 1; end
    end
    else if provider.kind() = "openai-compatible" & provider.route_class() = "local" then do
      if llamacppinstalled() = 1 then do; state = "llama.cpp-installed-server-not-probed"; detail = "llama-server is installed; setup and ingestion perform the endpoint smoke tests"; end
      else do; state = "local-runtime-unavailable"; detail = "llama-server is not installed at the configured local runtime path"; unavailable = 1; end
    end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
    fields[2] = .ragresultfield("kind", "string", provider.kind())
    fields[3] = .ragresultfield("model", "string", provider.model())
    fields[4] = .ragresultfield("route_class", "string", provider.route_class())
    fields[5] = .ragresultfield("privacy_policy", "string", provider.privacy_policy())
    fields[6] = .ragresultfield("charging_basis", "string", provider.charging_basis())
    fields[7] = .ragresultfield("state", "string", state)
    fields[8] = .ragresultfield("account_type", "string", account_type)
    fields[9] = .ragresultfield("plan_type", "string", plan_type)
    fields[10] = .ragresultfield("allowance_available_percent", "integer", allowance)
    fields[11] = .ragresultfield("detail", "string", detail)
    records[records.0 + 1] = .ragresultrecord("provider-status", fields)
  end
  if records.0 = 0 then return _failure(operation, 5, "provider is not registered in the selected configuration")
  if unavailable = 1 then return .ragcommandresult(operation, "error", 8, "one or more selected providers are unavailable", records)
  return .ragcommandresult(operation, "ok", 0, "provider status inspected without a model request or credential disclosure", records)

_providertest: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.test"; error = ""
  if _options(request, "provider", error) \= 0 then return _failure(operation, 2, error)
  if _hasaccess(request, "diagnose") \= 1 then return _failure(operation, 4, "provider test requires diagnose access")
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return _failure(operation, 5, "configuration is not registered")
  requested = _option(request, "provider", error)
  if error \= "" | requested = "" then return _failure(operation, 2, "provider test requires one --provider value")
  config = lookup.config(); providers = config.providers(); provider_index = 0
  do i = 1 to providers.0
    if providers[i].provider_id() = requested then provider_index = i
  end
  if provider_index = 0 then return _failure(operation, 5, "provider is not registered in the selected configuration")
  provider = providers[provider_index]
  if queryrouteallowed(provider, "public") \= 1 then return _failure(operation, 4, "provider route does not permit the public synthetic smoke input")

  embedding_planned = 0; answer_planned = 0; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].provider_id() \= requested then iterate
    if roles[i].role() = "embedding" then embedding_planned = 1
    else answer_planned = 1
  end
  if embedding_planned + answer_planned = 0 then return _failure(operation, 5, "provider is not assigned to an application role")
  if provider.kind() = "codex" & embedding_planned = 1 then return _failure(operation, 3, "Codex cannot be assigned to embedding generation")
  missing = .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)
  embedding_provider = missing; answer_provider = missing
  if embedding_planned = 1 then embedding_provider = provider
  if answer_planned = 1 then answer_provider = provider
  budget = config.budget()
  if querypreflight(budget, embedding_provider, embedding_planned, answer_provider, answer_planned, error) \= 0 then return _failure(operation, 6, error)

  tracer = .ragtracer(request.progress(), request.format()); records = .ragresultrecord[]
  embedding_result = .providerresult(); answer_result = .providerresult()
  embedding_called = 0; answer_called = 0; allowance_before = -1; allowance_after = -1
  identity_seed = requested || "00"x || provider.kind() || "00"x || provider.model() || "00"x || time("us")
  identity = "provider-smoke-" || substr(rxhash..sha256hex(identity_seed as .binary), 1, 32)
  if embedding_planned = 1 then do
    call tracer.emit("provider-test", "start", requested, "embedding generation with public synthetic input")
    if generatequeryembedding(provider, "What does BillingService depend on?", "public", 768, identity || "-embed", embedding_result, error) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "embedding output rejected")
      return _failure(operation, 8, error)
    end
    embedding_called = 1
    records[records.0 + 1] = _providersmokerecord(provider, "embedding-generation", embedding_result, 768, -1, -1)
    call tracer.emit("provider-test", "complete", requested, "embedding dimension=768 validated")
  end
  if answer_planned = 1 then do
    citation = "crexx-rag:provider-smoke:public-synthetic:revision-1:utf8-0-37"
    context = "{" || jsonquote("schema") || ":" || jsonquote("crexx-rag.answer-context/1") || "," || jsonquote("question") || ":" || jsonquote("What status does the provider smoke passage report?") || "," || jsonquote("evidence") || ":{" || jsonquote("passages") || ":[{" || jsonquote("citation") || ":{" || jsonquote("id") || ":" || jsonquote(citation) || "}," || jsonquote("text") || ":" || jsonquote("The provider smoke test is ready.") || "}]," || jsonquote("claims") || ":[]," || jsonquote("gaps") || ":[]}}"
    maximum_output = budget.output_tokens(); if maximum_output > 128 then maximum_output = 128
    call tracer.emit("provider-test", "start", requested, "structured generation with public synthetic input")
    if generatequeryanswer(provider, context, "public", maximum_output, budget.minimum_codex_allowance_percent(), identity || "-answer", answer_result, allowance_before, allowance_after, error) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "structured generation failed")
      return _failure(operation, 8, error)
    end
    if _validsmokeanswer(answer_result.content(), citation, error) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "structured output rejected")
      return _failure(operation, 1, error)
    end
    answer_called = 1
    records[records.0 + 1] = _providersmokerecord(provider, "structured-generation", answer_result, 0, allowance_before, allowance_after)
    call tracer.emit("provider-test", "complete", requested, "answer schema and citation validated")
  end
  embedding_usage = embedding_result.usage(); answer_usage = answer_result.usage()
  if queryusagewithin(budget, embedding_provider, embedding_usage, embedding_called, answer_provider, answer_usage, answer_called) \= 1 then return _failure(operation, 6, "provider smoke usage exceeded the configured token or cost ceiling, or monetary usage was unavailable")
  return .ragcommandresult(operation, "ok", 0, "provider smoke test completed with validated public-synthetic output", records)

_validsmokeanswer: procedure = .int
  arg content = .string, expected_citation = .string, expose error = .string
  error = ""; answer = ""; citation = ""; document = .jsondocument(content)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" then do; error = "provider smoke answer is not a JSON object"; return -1; end
  root = document.root()
  if document.node_count(root) \= 2 then do; error = "provider smoke answer contains fields outside the exact schema"; return -1; end
  if document.node_string(document.member(root, "answer"), answer) \= 0 | answer = "" | length(answer) > 8192 then do; error = "provider smoke answer text is invalid"; return -1; end
  citations = document.member(root, "citations")
  if document.node_type(citations) \= "array" | document.node_count(citations) \= 1 then do; error = "provider smoke answer must contain exactly one citation"; return -1; end
  if document.node_string(document.element(citations, 1), citation) \= 0 | citation \= expected_citation then do; error = "provider smoke answer citation is not the supplied public synthetic citation"; return -1; end
  return 0

_providersmokerecord: procedure = .ragresultrecord
  arg provider = .ragproviderconfig, operation = .string, result = .providerresult, dimension = .int, allowance_before = .int, allowance_after = .int
  usage = result.usage(); fields = .ragresultfield[]
  fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
  fields[2] = .ragresultfield("kind", "string", provider.kind())
  fields[3] = .ragresultfield("model", "string", provider.model())
  fields[4] = .ragresultfield("operation", "string", operation)
  fields[5] = .ragresultfield("route_class", "string", provider.route_class())
  fields[6] = .ragresultfield("privacy", "string", "public-synthetic")
  fields[7] = .ragresultfield("charging_basis", "string", provider.charging_basis())
  fields[8] = .ragresultfield("state", "string", "validated")
  fields[9] = .ragresultfield("input_tokens", "integer", usage.input_tokens())
  fields[10] = .ragresultfield("output_tokens", "integer", usage.output_tokens())
  fields[11] = .ragresultfield("attempts", "integer", usage.attempts())
  fields[12] = .ragresultfield("latency_us", "integer", result.latency_us())
  if dimension > 0 then fields[fields.0 + 1] = .ragresultfield("dimension", "integer", dimension)
  if provider.charging_basis() = "monetary-api" & usage.cost_microunits() >= 0 then fields[fields.0 + 1] = .ragresultfield("estimated_cost_microunits", "integer", usage.cost_microunits())
  if allowance_before >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_before_percent", "integer", allowance_before)
  if allowance_after >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_after_percent", "integer", allowance_after)
  return .ragresultrecord("provider-smoke", fields)

_repository: procedure = .ragcommandresult
  arg request = .ragcommandrequest, operation = .string, repository = .string
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "operation requires read access")
  allowed = "cursor limit"; error = ""
  if operation = "source.show" | operation = "review.show" | operation = "job.events" then allowed = allowed || " id"
  if _options(request, allowed, error) \= 0 then return _failure(operation, 2, error)
  cursor = _option(request, "cursor", error); limit_text = _option(request, "limit", error)
  if error \= "" then return _failure(operation, 2, error)
  limit = 20
  if limit_text \= "" then do
    if _unsigned(limit_text) \= 1 then return _failure(operation, 2, "--limit must be a positive integer")
    limit = limit_text as .int
  end
  if limit < 1 | limit > 100 then return _failure(operation, 2, "--limit must be from 1 through 100")
  id = _option(request, "id", error)
  option_id = id
  if error \= "" then return _failure(operation, 2, error)
  positionals = request.positionals()
  if id = "" & positionals.0 = 1 then id = positionals[1]
  if positionals.0 > 1 | (positionals.0 = 1 & option_id \= "") then return _failure(operation, 2, "operation accepts at most one id")
  read_snapshot = .ragreadsnapshot
  if beginreadsnapshot(request.library(), read_snapshot, error) \= 0 then return _openfailure(operation, error)
  page = .ragrepositorypage
  page_status = pagerepository(read_snapshot, repository, cursor, limit, page, error)
  close_error = ""; close_status = closereadsnapshot(read_snapshot, close_error)
  if page_status \= 0 | close_status \= 0 then do
    if error = "" then error = close_error
    return _failure(operation, 7, error)
  end
  source_records = page.records(); records = .ragresultrecord[]
  do i = 1 to source_records.0
    source = source_records[i]
    if id \= "" & source.identity() \= id & source.parent_identity() \= id then iterate
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("identity", "string", source.identity())
    fields[2] = .ragresultfield("parent_identity", "string", source.parent_identity())
    fields[3] = .ragresultfield("related_identity", "string", source.related_identity())
    fields[4] = .ragresultfield("name", "string", source.name())
    fields[5] = .ragresultfield("category", "string", source.category())
    fields[6] = .ragresultfield("state", "string", source.state())
    fields[7] = .ragresultfield("value", "string", source.value())
    fields[8] = .ragresultfield("detail", "string", source.detail())
    fields[9] = .ragresultfield("generation", "integer", page.snapshot_generation())
    records[records.0 + 1] = .ragresultrecord(repository, fields)
  end
  if id \= "" & records.0 = 0 then return _failure(operation, 5, "requested record was not found")
  if page.next_cursor() \= "" then do
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("next_cursor", "string", page.next_cursor())
    fields[2] = .ragresultfield("limit", "integer", limit)
    records[records.0 + 1] = .ragresultrecord("page", fields)
  end
  return .ragcommandresult(operation, "ok", 0, "bounded repository page read without mutation", records)

_query: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "query requires read access")
  if _options(request, "limit hops mode direction", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 1 | positionals[1] = "" then return _failure(operation, 2, "query requires exactly one question")
  if request.profile_id() = "" then return _failure(operation, 2, "query requires --profile")
  profile_lookup = registry.profile(request.profile_id())
  if profile_lookup.found() \= 1 then return _failure(operation, 5, "profile is not registered")
  config_lookup = registry.config(request.config_id())
  if config_lookup.found() \= 1 then return _failure(operation, 5, "configuration is not registered")
  config = config_lookup.config(); profile = profile_lookup.profile(); budget = config.budget()
  limit = 12; hops = 3
  limit_text = _option(request, "limit", error); hops_text = _option(request, "hops", error); mode = _option(request, "mode", error); graph_direction = _option(request, "direction", error)
  if error \= "" then return _failure(operation, 2, error)
  if limit_text \= "" then do
    if _unsigned(limit_text) \= 1 then return _failure(operation, 2, "query limit must be an integer")
    limit = limit_text as .int
  end
  if hops_text \= "" then do
    if _unsigned(hops_text) \= 1 then return _failure(operation, 2, "query hops must be an integer")
    hops = hops_text as .int
  end
  if limit < 1 | limit > 12 | hops < 0 | hops > 4 then return _failure(operation, 2, "query limit must be 1 through 12 and hops 0 through 4")
  if mode = "" then mode = "auto"
  if mode \= "auto" & mode \= "lexical" & mode \= "hybrid" then return _failure(operation, 2, "query mode must be auto, lexical, or hybrid")
  if graph_direction = "" then graph_direction = "both"
  if wordpos(graph_direction, "outbound inbound both") = 0 then return _failure(operation, 2, "query direction must be outbound, inbound, or both")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  if _querysnapshotmatches(store, config, profile) \= 1 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 6, "query configuration and profile do not match the published generation"); end
  plan = .ragqueryplan
  if planquery(store, profile, positionals[1], "surface-retrieval-v1", plan, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 1, error); end
  privacy = _queryprivacy(config); embedding_provider = _roleproviderconfig(config, "embedding"); answer_provider = _roleproviderconfig(config, "answerer")
  active_profile = ""; dimension = 0; query_vector = ''x as .binary
  if _activequeryembedding(store.database(), embedding_provider, active_profile, dimension, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, error); end
  embedding_state = "not-requested"; embedding_planned = 0
  if mode \= "lexical" then do
    if active_profile = "" then embedding_state = "no-compatible-index"
    else if queryrouteallowed(embedding_provider, privacy) \= 1 then embedding_state = "privacy-fallback"
    else do; embedding_planned = 1; embedding_state = "planned"; end
  end
  if mode = "hybrid" & embedding_planned \= 1 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 8, "hybrid query requires a compatible active index and permitted embedding route"); end
  answer_planned = operation = "query.answer"
  if answer_planned = 1 & answer_provider.provider_id() = "" then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 8, "query answer requires a configured answerer role"); end
  if answer_planned = 1 & queryrouteallowed(answer_provider, privacy) \= 1 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 4, "library privacy denies the configured answerer route"); end
  if querypreflight(budget, embedding_provider, embedding_planned, answer_provider, answer_planned, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 6, error); end

  tracer = .ragtracer(request.progress(), request.format()); embedding_output = .providerresult(); embedding_attempted = 0; embedding_called = 0
  if embedding_planned = 1 then do
    embedding_identity = "query-embed-" || substr(rxhash..sha256hex((plan.fingerprint() || "00"x || active_profile) as .binary), 1, 32)
    call tracer.emit("query-embedding", "start", active_profile, embedding_provider.provider_id() || " " || embedding_provider.model())
    embedding_attempted = 1
    embedding_status = generatequeryembedding(embedding_provider, positionals[1], privacy, dimension, embedding_identity, embedding_output, error)
    if embedding_status \= 0 then do
      call tracer.emit("query-embedding", "failed", active_profile, "using lexical fallback")
      if mode = "hybrid" then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 8, error); end
      embedding_state = "provider-fallback"; error = ""
    end
    else do
      vectors = embedding_output.embeddings(); query_vector = vectors[1].payload(); embedding_called = 1; embedding_state = "generated"
      call tracer.emit("query-embedding", "complete", active_profile, "dimension=" || dimension)
    end
  end
  retrieval_profile = ""; if embedding_called = 1 then retrieval_profile = active_profile
  retrieval_options = .ragretrievaloptions("surface-retrieval-v1", retrieval_profile, query_vector, 48, 12, 100000, hops, limit, 8, 8, 60, graph_direction)
  retrieval = .ragretrievalresult
  if retrieveevidence(store, profile, positionals[1], retrieval_options, retrieval, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 1, error); end
  evidence = retrieval.evidence(); answer_context = ""
  query_gaps_recorded = 0
  if recordquerygaps(store, evidence, query_gaps_recorded, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, error); end
  if answer_planned = 1 then do
    if encodeanswercontext(evidence, 65536, answer_context, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 1, error); end
  end
  evidence_json = ""
  close_error = ""
  if closeragstore(store, close_error) \= 0 then return _failure(operation, 7, close_error)
  answer_output = .providerresult(); allowance_before = -1; allowance_after = -1; generated_answer = ""; answer_citation = ""; answer_called = 0
  if answer_planned = 1 then do
    answer_identity = "query-answer-" || substr(rxhash..sha256hex((answer_context || "00"x || answer_provider.provider_id() || "00"x || answer_provider.model()) as .binary), 1, 32)
    call tracer.emit("answer", "start", plan.fingerprint(), answer_provider.provider_id() || " " || answer_provider.model())
    if generatequeryanswer(answer_provider, answer_context, privacy, budget.output_tokens(), budget.minimum_codex_allowance_percent(), answer_identity, answer_output, allowance_before, allowance_after, error) \= 0 then do; call tracer.emit("answer", "failed", plan.fingerprint(), "provider answer rejected"); return _failure(operation, 8, error); end
    if _answeroutput(answer_output.content(), evidence, generated_answer, answer_citation, error) \= 0 then do; call tracer.emit("answer", "failed", plan.fingerprint(), "citation validation failed"); return _failure(operation, 1, error); end
    answer_called = 1; evidence = evidence.with_generated_answer(generated_answer)
    call tracer.emit("answer", "complete", plan.fingerprint(), "citations validated")
  end
  embedding_usage = embedding_output.usage(); answer_usage = answer_output.usage()
  if queryusagewithin(budget, embedding_provider, embedding_usage, embedding_attempted, answer_provider, answer_usage, answer_called) \= 1 then return _failure(operation, 6, "query provider usage exceeded the configured token or cost ceiling, or monetary usage was unavailable")
  if encodeevidence(evidence, 65536, evidence_json, error) \= 0 then return _failure(operation, 1, error)
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("evidence_schema", "string", "crexx-rag.evidence/1")
  fields[2] = .ragresultfield("query_plan_fingerprint", "string", plan.fingerprint())
  fields[3] = .ragresultfield("vector_state", "string", retrieval.vector_state())
  fields[4] = .ragresultfield("candidate_count", "integer", retrieval.candidate_count())
  fields[5] = .ragresultfield("evidence_json", "string", evidence_json)
  if generated_answer = "" then fields[6] = .ragresultfield("generated_answer", "null", "")
  else fields[6] = .ragresultfield("generated_answer", "string", generated_answer)
  summary = ""; citation = ""; accepted_claims = evidence.claims()
  if accepted_claims.0 > 0 then do
    summary = accepted_claims[1].subject() || " --" || accepted_claims[1].relationship_type() || "--> " || accepted_claims[1].object()
    supports = accepted_claims[1].supports()
    if supports.0 > 0 then citation = supports[1].citation().citation()
  end
  if answer_citation \= "" then citation = answer_citation
  fields[7] = .ragresultfield("summary", "string", summary)
  fields[8] = .ragresultfield("citation", "string", citation)
  effective_mode = "lexical"; if retrieval.vector_state() = "active-ann-ivf-rxvector" then effective_mode = "hybrid"
  fields[9] = .ragresultfield("retrieval_mode", "string", effective_mode)
  fields[10] = .ragresultfield("query_embedding_state", "string", embedding_state)
  fields[11] = .ragresultfield("provider_calls", "integer", embedding_attempted + answer_called)
  fields[12] = .ragresultfield("graph_direction", "string", graph_direction)
  fields[13] = .ragresultfield("query_gaps_recorded", "integer", query_gaps_recorded)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("query-evidence", fields)
  if embedding_attempted = 1 then records[records.0 + 1] = _queryproviderrecord("embedding", embedding_provider, embedding_output, -1, -1)
  if answer_called = 1 then records[records.0 + 1] = _queryproviderrecord("answerer", answer_provider, answer_output, allowance_before, allowance_after)
  message = "typed evidence retrieved"
  if answer_called = 1 then message = "evidence-backed answer generated with validated citations"
  else if embedding_called = 1 then message = "typed evidence retrieved with compatible hybrid search"
  return .ragcommandresult(operation, "ok", 0, message, records)

_activequeryembedding: procedure = .int
  arg database = .binary, provider = .ragproviderconfig, expose profile_id = .string, expose dimension = .int, expose error = .string
  profile_id = ""; dimension = 0; error = ""
  if provider.provider_id() = "" | provider.kind() = "codex" then return 0
  prepared = .binary
  sql = "SELECT p.embedding_profile_id,p.dimension,p.input_envelope_fingerprint FROM vector_generations v JOIN embedding_profiles p ON p.embedding_profile_id=v.embedding_profile_id WHERE v.state='published' AND v.semantic_generation=(SELECT published_generation FROM library_meta WHERE singleton=1) AND p.provider_id=?1 AND p.model=?2 ORDER BY p.embedding_profile_id"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, provider.provider_id()) \= 0 | sqlitebindtext(prepared, 2, provider.model()) \= 0 then do; call sqlitefinalize prepared; error = "cannot inspect the active query embedding profile"; return -1; end
  rows = 0; fingerprint = ""
  do forever
    step = sqlitestep(prepared)
    if step = 101 then leave
    if step \= 100 then do; call sqlitefinalize prepared; error = "cannot read the active query embedding profile"; return -1; end
    rows = rows + 1
    if rows > 1 then do; call sqlitefinalize prepared; error = "multiple compatible active query embedding profiles are ambiguous"; return -1; end
    columns = sqlitecolumntext(prepared, 0, profile_id) | sqlitecolumnint(prepared, 1, dimension) | sqlitecolumntext(prepared, 2, fingerprint)
    if columns \= 0 then do; call sqlitefinalize prepared; error = "cannot decode the active query embedding profile"; return -1; end
  end
  call sqlitefinalize prepared
  if rows = 0 then do; profile_id = ""; dimension = 0; return 0; end
  envelope = "crexx-rag.embedding-input/1|" || provider.provider_id() || "|" || provider.kind() || "|" || provider.model() || "|" || dimension
  if dimension < 1 | fingerprint \= rxhash..sha256hex(envelope as .binary) then do; error = "active query embedding profile does not match the configured provider envelope"; return -1; end
  return 0

_querysnapshotmatches: procedure = .int
  arg store = .ragstorehandle, config = .ragconfig, profile = .ragprofile
  prepared = .binary
  sql = "SELECT s.config_hash,s.profile_hash FROM config_snapshots s JOIN published_generations g ON g.config_snapshot_id=s.config_snapshot_id WHERE g.generation=(SELECT published_generation FROM library_meta WHERE singleton=1)"
  if sqliteprepare(store.database(), sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return 0; end
  config_hash = ""; profile_hash = ""; columns = sqlitecolumntext(prepared, 0, config_hash) | sqlitecolumntext(prepared, 1, profile_hash); call sqlitefinalize prepared
  if columns \= 0 then return 0
  profile_json = canonicalprofile(profile)
  effective_json = "{" || jsonquote("schema") || ":" || jsonquote("crexx-rag.effective-config/1") || "," || jsonquote("config") || ":" || canonicalconfig(config) || "," || jsonquote("profile") || ":" || profile_json || "}"
  return config_hash = ragsha256(effective_json) & profile_hash = ragsha256(profile_json)

_queryprivacy: procedure = .string
  arg config = .ragconfig
  privacy = "public"; sources = config.source_sets()
  do i = 1 to sources.0
    if sources[i].privacy() = "local" then return "local"
    if sources[i].privacy() = "restricted" | sources[i].privacy() = "internal" then privacy = "restricted"
  end
  return privacy

_answeroutput: procedure = .int
  arg content = .string, evidence = .ragevidence, expose answer = .string, expose first_citation = .string, expose error = .string
  answer = ""; first_citation = ""; error = ""; document = .jsondocument(content)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" then do; error = "query answer is not a JSON object"; return -1; end
  root = document.root()
  if document.node_count(root) \= 2 then do; error = "query answer contains fields outside the exact schema"; return -1; end
  if document.node_string(document.member(root, "answer"), answer) \= 0 | answer = "" | length(answer) > 8192 then do; error = "query answer text is invalid"; return -1; end
  citations = document.member(root, "citations")
  if document.node_type(citations) \= "array" | document.node_count(citations) > 12 then do; error = "query answer citations are invalid"; return -1; end
  seen = .string[]
  do i = 1 to document.node_count(citations)
    citation = ""
    if document.node_string(document.element(citations, i), citation) \= 0 | citation = "" | _evidencecitation(evidence, citation) \= 1 | _containsstring(seen, citation) = 1 then do; error = "query answer contains an unknown or duplicate citation"; return -1; end
    seen[seen.0 + 1] = citation
    if first_citation = "" then first_citation = citation
  end
  passages = evidence.passages(); claims = evidence.claims()
  if (passages.0 > 0 | claims.0 > 0) & seen.0 = 0 then do; error = "query answer omitted citations for available evidence"; return -1; end
  return 0

_evidencecitation: procedure = .int
  arg evidence = .ragevidence, expected = .string
  passages = evidence.passages()
  do i = 1 to passages.0
    if passages[i].citation().citation() = expected then return 1
  end
  claims = evidence.claims()
  do i = 1 to claims.0
    supports = claims[i].supports()
    do j = 1 to supports.0
      if supports[j].citation().citation() = expected then return 1
    end
  end
  return 0

_containsstring: procedure = .int
  arg values = .string[], expected = .string
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_queryproviderrecord: procedure = .ragresultrecord
  arg role = .string, provider = .ragproviderconfig, result = .providerresult, allowance_before = .int, allowance_after = .int
  usage = result.usage(); fields = .ragresultfield[]
  fields[1] = .ragresultfield("role", "string", role)
  fields[2] = .ragresultfield("provider_id", "string", provider.provider_id())
  fields[3] = .ragresultfield("kind", "string", provider.kind())
  fields[4] = .ragresultfield("model", "string", provider.model())
  fields[5] = .ragresultfield("charging_basis", "string", provider.charging_basis())
  fields[6] = .ragresultfield("input_tokens", "integer", usage.input_tokens())
  fields[7] = .ragresultfield("output_tokens", "integer", usage.output_tokens())
  outcome = "failed"; if result.status() = 0 then outcome = "succeeded"
  fields[8] = .ragresultfield("outcome", "string", outcome)
  if provider.charging_basis() = "monetary-api" & usage.cost_microunits() >= 0 then fields[fields.0 + 1] = .ragresultfield("estimated_cost_microunits", "integer", usage.cost_microunits())
  if allowance_before >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_before_percent", "integer", allowance_before)
  if allowance_after >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_after_percent", "integer", allowance_after)
  return .ragresultrecord("query-provider", fields)

_jobstatus: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "job status requires read access")
  if _options(request, "id", error) \= 0 then return _failure(operation, 2, error)
  job_id = _id(request, error)
  if error \= "" | job_id = "" then return _failure(operation, 2, "job status requires one job id")
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return _openfailure(operation, error)
  status = .ragjobstatus; read_status = readjobstatus(store, job_id, status, error)
  ignored = ""; close_status = closeragstore(store, ignored)
  if read_status = -2 then return _failure(operation, 5, "job was not found")
  if read_status \= 0 | close_status \= 0 then return _failure(operation, 7, error)
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("job_id", "string", status.job_id())
  fields[2] = .ragresultfield("state", "string", status.state())
  fields[3] = .ragresultfield("planned_total", "integer", status.planned_total())
  fields[4] = .ragresultfield("queued", "integer", status.queued())
  fields[5] = .ragresultfield("running", "integer", status.running())
  fields[6] = .ragresultfield("processed", "integer", status.processed())
  fields[7] = .ragresultfield("skipped", "integer", status.skipped())
  fields[8] = .ragresultfield("dead_letter", "integer", status.dead_letter())
  fields[9] = .ragresultfield("cancelled", "integer", status.cancelled())
  fields[10] = .ragresultfield("failed_attempts", "integer", status.failed_attempts())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-status", fields)
  return .ragcommandresult(operation, "ok", 0, "bounded durable job status", records)

_jobcontrol: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "job control requires control access")
  if _options(request, "id reason", error) \= 0 then return _failure(operation, 2, error)
  job_id = _id(request, error)
  if error \= "" | job_id = "" then return _failure(operation, 2, "job control requires one job id")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  status = 0
  if operation = "job.pause" then status = pausejob(store, job_id, error)
  if operation = "job.resume" then status = resumejob(store, job_id, error)
  if operation = "job.cancel" then do
    reason = _option(request, "reason", error); if reason = "" then reason = "operator-request"
    status = requestcancel(store, job_id, reason, error)
  end
  running = 0
  if operation = "worker.drain" then status = drainjob(store, job_id, running, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("job_id", "string", job_id)
  fields[2] = .ragresultfield("operation", "string", operation)
  if operation = "worker.drain" then fields[3] = .ragresultfield("running", "integer", running)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-control", fields)
  return .ragcommandresult(operation, "ok", 0, "job control applied through the durable fenced store", records)

_jobretry: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "job retry requires control access")
  if _options(request, "id item reason", error) \= 0 then return _failure(operation, 2, error)
  job_id = _id(request, error); item_id = _option(request, "item", error); reason = _option(request, "reason", error)
  if reason = "" then reason = "operator-corrected"
  if error \= "" | job_id = "" | item_id = "" then return _failure(operation, 2, "job retry requires one job id and --item")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  retried = 0; status = retrydeadletter(store, job_id, item_id, reason, retried, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("job_id", "string", job_id)
  fields[2] = .ragresultfield("item_id", "string", item_id)
  fields[3] = .ragresultfield("items_retried", "integer", retried)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-retry", fields)
  return .ragcommandresult(operation, "ok", 0, "one dead-letter item was explicitly requeued", records)

_workerstart: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "worker start requires control access")
  if _workeroptions(request, "count poll-ms max-polls job", "", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "worker start accepts no positional arguments")
  if request.config_id() = "" | request.profile_id() = "" then return _failure(operation, 2, "worker start requires --config and --profile")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return _failure(operation, 5, "configuration or profile is not registered")
  configured_count = config_lookup.config().workers().processes(); count = configured_count
  count_text = _option(request, "count", error); poll_text = _option(request, "poll-ms", error); maximum_text = _option(request, "max-polls", error); job_filter = _option(request, "job", error)
  if count_text \= "" then do
    if _unsigned(count_text) \= 1 then return _failure(operation, 2, "--count must be an integer")
    count = count_text as .int
  end
  poll_milliseconds = 1000
  if poll_text \= "" then do
    if _unsigned(poll_text) \= 1 then return _failure(operation, 2, "--poll-ms must be an integer")
    poll_milliseconds = poll_text as .int
  end
  maximum_polls = 0
  if maximum_text \= "" then do
    if _unsigned(maximum_text) \= 1 then return _failure(operation, 2, "--max-polls must be an integer")
    maximum_polls = maximum_text as .int
  end
  if count < 1 | count > configured_count | poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 then return _failure(operation, 2, "worker start count must be within the configured process ceiling; poll-ms must be 10..60000 and max-polls 0..1000000")
  started = .ragprocessstartresult
  tracer = .ragtracer(request.progress(), request.format()); call tracer.emit("controller", "start", "", "workers=" || count)
  status = startworkerprocesses(request.library(), count, poll_milliseconds, maximum_polls, job_filter, request.config_id(), request.profile_id(), request.config_file(), request.progress(), request.format(), started, error)
  if status \= 0 then return _failure(operation, 8, error)
  vector_generations = 0; vector_state = "not-requested"
  if job_filter \= "" then do
    if _publishjobvectors(request.library(), job_filter, config_lookup.config(), vector_generations, vector_state, error) \= 0 then return _failure(operation, 8, error)
    if vector_state \= "not-applicable" then call tracer.emit("vector", vector_state, job_filter, "generations=" || vector_generations)
  end
  call tracer.emit("controller", "complete", started.controller_id(), "workers=" || started.completed())
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("controller_id", "string", started.controller_id())
  fields[2] = .ragresultfield("workers_requested", "integer", started.requested())
  fields[3] = .ragresultfield("workers_completed", "integer", started.completed())
  fields[4] = .ragresultfield("workers_failed", "integer", started.failed())
  if vector_state \= "not-applicable" then do
    fields[5] = .ragresultfield("vector_generations", "integer", vector_generations)
    fields[6] = .ragresultfield("vector_state", "string", vector_state)
  end
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-controller", fields)
  return .ragcommandresult(operation, "ok", 0, "controller supervised the requested OS-process workers to completion", records)

_workerrun: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "worker run requires control access")
  if _workeroptions(request, "id parent host-id once follow poll-ms max-polls job", "once follow", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return _failure(operation, 2, "worker run accepts no positional arguments")
  if request.config_id() = "" | request.profile_id() = "" then return _failure(operation, 2, "worker run requires --config and --profile")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return _failure(operation, 5, "configuration or profile is not registered")
  once = _option(request, "once", error); follow = _option(request, "follow", error)
  if (once = "") = (follow = "") then return _failure(operation, 2, "worker run requires exactly one of --once or --follow")
  mode = "once"; if follow \= "" then mode = "follow"
  instance_id = _option(request, "id", error); parent_id = _option(request, "parent", error); host_id = _option(request, "host-id", error); job_filter = _option(request, "job", error)
  poll_text = _option(request, "poll-ms", error); maximum_text = _option(request, "max-polls", error)
  poll_milliseconds = 1000; maximum_polls = 0
  if poll_text \= "" then do
    if _unsigned(poll_text) \= 1 then return _failure(operation, 2, "--poll-ms must be an integer")
    poll_milliseconds = poll_text as .int
  end
  if maximum_text \= "" then do
    if _unsigned(maximum_text) \= 1 then return _failure(operation, 2, "--max-polls must be an integer")
    maximum_polls = maximum_text as .int
  end
  if poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 then return _failure(operation, 2, "worker run requires poll-ms 10..60000 and max-polls 0..1000000")
  final_id = ""; processed = 0
  if runapplicationworker(request.library(), instance_id, parent_id, host_id, mode, job_filter, poll_milliseconds, maximum_polls, config_lookup.config(), profile_lookup.profile(), request.progress(), request.format(), final_id, processed, error) \= 0 then return _failure(operation, 1, error)
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("worker_id", "string", final_id)
  fields[2] = .ragresultfield("mode", "string", mode)
  fields[3] = .ragresultfield("job_filter", "string", job_filter)
  fields[4] = .ragresultfield("processor", "string", "application-ingestion-v1")
  fields[5] = .ragresultfield("items_processed", "integer", processed)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-run", fields)
  return .ragcommandresult(operation, "ok", 0, "worker process lifecycle completed through the configured ingestion processor", records)

_workerread: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "worker inspection requires read access")
  if _workeroptions(request, "id kind state local host-id stale-seconds limit", "local", error) \= 0 then return _failure(operation, 2, error)
  id = _id(request, error)
  if error \= "" then return _failure(operation, 2, error)
  if operation = "worker.status" & id = "" then return _failure(operation, 2, "worker status requires one process id")
  kind_filter = _option(request, "kind", error); if kind_filter = "" then kind_filter = "all"
  if kind_filter \= "all" & kind_filter \= "controller" & kind_filter \= "worker" then return _failure(operation, 2, "--kind must be all, controller, or worker")
  requested_state_filter = _option(request, "state", error)
  state_filter = requested_state_filter
  if requested_state_filter = "stale" then state_filter = ""
  host_filter = _option(request, "host-id", error)
  local = _option(request, "local", error)
  if local \= "" then do
    if host_filter \= "" then return _failure(operation, 2, "--local and --host-id are mutually exclusive")
    host_filter = currenthostid()
  end
  stale_seconds = 15; limit = 100
  stale_text = _option(request, "stale-seconds", error); limit_text = _option(request, "limit", error)
  if stale_text \= "" then do
    if _unsigned(stale_text) \= 1 then return _failure(operation, 2, "--stale-seconds must be an integer")
    stale_seconds = stale_text as .int
  end
  if limit_text \= "" then do
    if _unsigned(limit_text) \= 1 then return _failure(operation, 2, "--limit must be an integer")
    limit = limit_text as .int
  end
  if stale_seconds < 1 | stale_seconds > 86400 | limit < 1 | limit > 100 then return _failure(operation, 2, "worker list requires stale-seconds 1..86400 and limit 1..100")
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return _openfailure(operation, error)
  processes = .ragprocessrecord[]; read_status = listprocesses(store, kind_filter, state_filter, host_filter, stale_seconds, limit, processes, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if read_status < 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 7, error); end
  records = .ragresultrecord[]; local_host = currenthostid()
  do i = 1 to processes.0
    process = processes[i]
    if id \= "" & process.instance_id() \= id then iterate
    if requested_state_filter = "stale" & process.classification() \= "stale" then iterate
    pid_check = "remote"
    if process.host_id() = local_host then do
      pid_check = "not-running"
      if process.state() \= "stopped" & process.state() \= "failed" then do
        pid_check = "missing"
        if processalive(process.pid()) = 1 then pid_check = "alive"
      end
    end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("instance_id", "string", process.instance_id())
    fields[2] = .ragresultfield("kind", "string", process.kind())
    fields[3] = .ragresultfield("parent_instance_id", "string", process.parent_instance_id())
    fields[4] = .ragresultfield("host_id", "string", process.host_id())
    fields[5] = .ragresultfield("pid", "integer", process.pid())
    fields[6] = .ragresultfield("process_start_token", "string", process.process_start_token())
    fields[7] = .ragresultfield("mode", "string", process.mode())
    fields[8] = .ragresultfield("job_filter", "string", process.job_filter())
    fields[9] = .ragresultfield("state", "string", process.state())
    fields[10] = .ragresultfield("classification", "string", process.classification())
    fields[11] = .ragresultfield("requested_state", "string", process.requested_state())
    fields[12] = .ragresultfield("current_item_id", "string", process.current_item_id())
    fields[13] = .ragresultfield("heartbeat_age_seconds", "integer", process.heartbeat_age())
    fields[14] = .ragresultfield("pid_check", "string", pid_check)
    fields[15] = .ragresultfield("detail", "string", process.detail())
    records[records.0 + 1] = .ragresultrecord("runtime-process", fields)
  end
  if id \= "" & records.0 = 0 then return _failure(operation, 5, "runtime process was not found")
  return .ragcommandresult(operation, "ok", 0, "bounded runtime registry read; heartbeat classification is authoritative and PID state is diagnostic", records)

_workerdrain: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "worker drain requires control access")
  if _workeroptions(request, "id", "", error) \= 0 then return _failure(operation, 2, error)
  instance_id = _id(request, error)
  if error \= "" | instance_id = "" then return _failure(operation, 2, "worker drain requires one worker id")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  status = requestprocess(store, instance_id, "drain", error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status = -2 then return _failure(operation, 5, error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  fields = .ragresultfield[]; fields[1] = .ragresultfield("worker_id", "string", instance_id); fields[2] = .ragresultfield("requested_state", "string", "drain")
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-control", fields)
  return .ragcommandresult(operation, "ok", 0, "durable drain request recorded", records)

_workerprune: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "control") \= 1 then return _failure(operation, 4, "worker prune requires control access")
  positionals = request.positionals()
  if _workeroptions(request, "stale-seconds", "", error) \= 0 | positionals.0 \= 0 then return _failure(operation, 2, "worker prune accepts only --stale-seconds")
  stale_seconds = 300; stale_text = _option(request, "stale-seconds", error)
  if stale_text \= "" then do
    if _unsigned(stale_text) \= 1 then return _failure(operation, 2, "--stale-seconds must be an integer")
    stale_seconds = stale_text as .int
  end
  if stale_seconds < 1 | stale_seconds > 86400 then return _failure(operation, 2, "worker prune requires stale-seconds 1..86400")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  deleted = 0; status = pruneprocesses(store, stale_seconds, deleted, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  fields = .ragresultfield[]; fields[1] = .ragresultfield("rows_deleted", "integer", deleted); fields[2] = .ragresultfield("stale_seconds", "integer", stale_seconds)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-prune", fields)
  return .ragcommandresult(operation, "ok", 0, "terminal and explicitly stale runtime rows removed", records)

_ingestplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "plan") \= 1 then return _failure(operation, 4, "ingest planning requires plan access")
  if _options(request, "source-set", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals(); source_set_id = _option(request, "source-set", error)
  if positionals.0 \= 0 | source_set_id = "" | request.config_id() = "" | request.profile_id() = "" then return _failure(operation, 2, "ingest planning requires one --source-set plus registered --config and --profile ids")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return _failure(operation, 5, "configuration or profile is not registered")
  source_sets = config_lookup.config().source_sets(); source_index = 0
  do i = 1 to source_sets.0
    if source_sets[i].source_set_id() = source_set_id then source_index = i
  end
  if source_index = 0 then return _failure(operation, 5, "source set is not registered")
  observations = .ragsourceobservation[]
  if collectfolderobservations(source_sets[source_index].root(), source_set_id, source_sets[source_index].retain_raw_artifact(), 2147483647, "surface-plan", observations, error) < 0 then return _failure(operation, 1, error)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  domain_plan = .ragingestplan; chunks = profile_lookup.profile().chunk_policy().max_characters()
  plan_status = createingestplanconfigured(store, "folder:" || source_set_id, snapshot_id, "surface-ingest-v1", "surface-parser-v1", chunks, observations, config_lookup.config(), domain_plan, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  action = '{"source_set":' || jsonquote(source_set_id) || ',"ingest_plan":' || jsonquote(domain_plan.canonical()) || ',"ingest_digest":' || jsonquote(domain_plan.digest()) || '}'
  foundation_plan = .ragplan
  foundation_status = createfoundationplan(request.library(), request.config_id(), request.profile_id(), "ingest.apply", action, "ingest", registry, foundation_plan, error)
  if foundation_status = -2 then return _failure(operation, 6, error)
  if foundation_status \= 0 then return _failure(operation, 7, error)
  plan_fields = .ragresultfield[]
  plan_fields[1] = .ragresultfield("schema_version", "string", foundation_plan.schema_version()); plan_fields[2] = .ragresultfield("operation", "string", foundation_plan.operation()); plan_fields[3] = .ragresultfield("canonical_plan", "string", foundation_plan.payload()); plan_fields[4] = .ragresultfield("digest", "string", foundation_plan.digest()); plan_fields[5] = .ragresultfield("expires_at_epoch", "integer", foundation_plan.expires_at()); plan_fields[6] = .ragresultfield("required_capability", "string", "ingest"); plan_fields[7] = .ragresultfield("state", "string", "created"); plan_fields[8] = .ragresultfield("enqueued", "boolean", "false")
  preview_fields = .ragresultfield[]; preview_fields[1] = .ragresultfield("source_set", "string", source_set_id); preview_fields[2] = .ragresultfield("observations", "integer", observations.0); preview_fields[3] = .ragresultfield("ingest_digest", "string", domain_plan.digest())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("canonical-plan", plan_fields); records[2] = .ragresultrecord("ingest-preview", preview_fields)
  return .ragcommandresult(operation, "ok", 0, "source observations, discovery policy and glossary frozen into a canonical ingest plan without library writes", records)

_ingestapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "ingest") \= 1 then return _failure(operation, 4, "ingest apply requires ingest access")
  if _options(request, "plan-json expect-digest", error) \= 0 then return _failure(operation, 2, error)
  plan_json = _option(request, "plan-json", error); digest = _option(request, "expect-digest", error)
  if error \= "" | plan_json = "" | digest = "" then return _failure(operation, 2, "apply requires plan JSON and reviewed digest")
  reviewed = .ragplan
  validation = validatefoundationplan(request.library(), request.config_id(), request.profile_id(), operation, plan_json, digest, registry, reviewed, error)
  if validation = -2 then return _failure(operation, 6, error)
  if validation \= 0 then return _failure(operation, 3, error)
  source_set_id = _actionstring(plan_json, "source_set", error)
  reviewed_ingest_plan = _actionstring(plan_json, "ingest_plan", error); reviewed_ingest_digest = _actionstring(plan_json, "ingest_digest", error)
  if error \= "" | reviewed_ingest_plan = "" | length(reviewed_ingest_digest) \= 64 | rxhash..sha256hex(reviewed_ingest_plan as .binary) \= reviewed_ingest_digest then return _failure(operation, 3, "reviewed ingest domain plan is missing or invalid")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return _failure(operation, 5, "configuration or profile is not registered")
  source_sets = config_lookup.config().source_sets(); source_index = 0
  do i = 1 to source_sets.0
    if source_sets[i].source_set_id() = source_set_id then source_index = i
  end
  if source_index = 0 then return _failure(operation, 5, "source set is not registered")
  tracer = .ragtracer(request.progress(), request.format()); call tracer.emit("ingest", "start", source_set_id, "discovering sources")
  observations = .ragsourceobservation[]
  if collectfolderobservations(source_sets[source_index].root(), source_set_id, source_sets[source_index].retain_raw_artifact(), 2147483647, "surface-apply", observations, error) < 0 then return _failure(operation, 1, error)
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  domain_plan = .ragingestplan
  chunks = profile_lookup.profile().chunk_policy().max_characters()
  if createingestplanconfigured(store, "folder:" || source_set_id, snapshot_id, "surface-ingest-v1", "surface-parser-v1", chunks, observations, config_lookup.config(), domain_plan, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 1, error); end
  if domain_plan.canonical() \= reviewed_ingest_plan | domain_plan.digest() \= reviewed_ingest_digest then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 3, "source observations, discovery policy or glossary content no longer match the reviewed ingest plan"); end
  call tracer.emit("ingest", "waiting", source_set_id, "queueing durable work")
  result = applyingestplanconfigured(store, domain_plan, observations, config_lookup.config(), profile_lookup.profile())
  close_error = ""; close_status = closeragstore(store, close_error)
  if result.ok() \= 1 | close_status \= 0 then do; if error = "" then error = result.error(); if error = "" then error = close_error; return _failure(operation, 1, error); end
  call tracer.emit("ingest", "complete", source_set_id, "items=" || result.items_queued())
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("disposition", "string", result.disposition())
  fields[2] = .ragresultfield("generation", "integer", result.generation())
  fields[3] = .ragresultfield("sources_observed", "integer", result.sources_observed())
  fields[4] = .ragresultfield("sources_added", "integer", result.sources_added())
  fields[5] = .ragresultfield("sources_changed", "integer", result.sources_changed())
  fields[6] = .ragresultfield("sources_unchanged", "integer", result.sources_unchanged())
  fields[7] = .ragresultfield("items_queued", "integer", result.items_queued())
  fields[8] = .ragresultfield("provider_calls", "integer", result.provider_calls())
  if result.items_queued() = 0 then fields[9] = .ragresultfield("job_id", "null", "")
  else fields[9] = .ragresultfield("job_id", "string", "job-sha256:" || domain_plan.digest())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("ingest-apply", fields)
  if result.items_queued() = 0 then return .ragcommandresult(operation, "ok", 0, "source set is already current; no work or provider calls were queued", records)
  return .ragcommandresult(operation, "ok", 0, "reviewed ingest plan applied and durable work queued", records)

_publishjobvectors: procedure = .int
  arg library = .string, job_id = .string, config = .ragconfig, expose generation_count = .int, expose state = .string, expose error = .string
  generation_count = 0; state = "not-applicable"; error = ""
  store = .ragstorehandle
  if openragstore(library, "readwrite", store, error) \= 0 then return -1
  if _jobcomplete(store.database(), job_id, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -1; end
  if _publishconfiguredvector(store, config, generation_count, state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -1; end
  close_error = ""
  if closeragstore(store, close_error) \= 0 then do; error = close_error; return -1; end
  return 0

_jobcomplete: procedure = .int
  arg database = .binary, job_id = .string, expose error = .string
  error = ""; prepared = .binary
  if sqliteprepare(database, "SELECT state FROM jobs WHERE job_id=?1", prepared) \= 0 | sqlitebindtext(prepared, 1, job_id) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare completed job lookup for vector publication"; return -1; end
  step = sqlitestep(prepared)
  if step \= 100 then do; call sqlitefinalize prepared; error = "worker job does not exist for vector publication"; return -1; end
  job_state = ""; column_status = sqlitecolumntext(prepared, 0, job_state); call sqlitefinalize prepared
  if column_status \= 0 then do; error = "cannot decode completed job state for vector publication"; return -1; end
  if job_state \= "completed" then do; error = "worker group ended before vector publication because job state is " || job_state; return -1; end
  return 0

_publishconfiguredvector: procedure = .int
  arg store = .ragstorehandle, config = .ragconfig, expose generation_count = .int, expose state = .string, expose error = .string
  generation_count = 0; state = "not-applicable"; error = ""
  provider = _roleproviderconfig(config, "embedding")
  if provider.provider_id() = "" | provider.kind() = "codex" then do; error = "configuration has no embedding-capable provider"; return -1; end
  profile_id = _embeddingprofileid(provider); current = _scalarint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1")
  active_chunks = _scalarint(store.database(), "SELECT count(*) FROM revision_chunks WHERE visible_from_generation<=" || current || " AND (visible_to_generation IS NULL OR visible_to_generation>" || current || ")")
  if active_chunks = 0 then return 0
  covered = _scalarint(store.database(), "SELECT count(DISTINCT rce.revision_chunk_id) FROM revision_chunk_embeddings rce JOIN embeddings e ON e.embedding_id=rce.embedding_id JOIN revision_chunks rc ON rc.revision_chunk_id=rce.revision_chunk_id WHERE e.embedding_profile_id=" || _sqlquote(profile_id) || " AND rce.visible_from_generation<=" || current || " AND (rce.visible_to_generation IS NULL OR rce.visible_to_generation>" || current || ") AND rc.visible_from_generation<=" || current || " AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>" || current || ")")
  if covered \= active_chunks then do; error = "compatible embedding coverage is incomplete: " || covered || "/" || active_chunks || " active chunks"; return -2; end
  vector_policy = config.vector(); generation = .ragvectorgenerationresult
  if buildannvectorgeneration(store, profile_id, 1000000, vector_policy.centroids(), vector_policy.probes(), vector_policy.iterations(), generation, error) \= 0 then return -3
  generation_count = 1
  if generation.state() = "published" then state = "published"
  else state = "identical-no-op"
  return 0

_maintainapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "curate") \= 1 then return _failure(operation, 4, "maintain apply requires curate access")
  if _options(request, "plan-json expect-digest", error) \= 0 then return _failure(operation, 2, error)
  plan_json = _option(request, "plan-json", error); digest = _option(request, "expect-digest", error)
  reviewed = .ragplan
  validation = validatefoundationplan(request.library(), request.config_id(), request.profile_id(), operation, plan_json, digest, registry, reviewed, error)
  if validation = -2 then return _failure(operation, 6, error)
  if validation \= 0 then return _failure(operation, 3, error)
  config_lookup = registry.config(request.config_id())
  if config_lookup.found() \= 1 then return _failure(operation, 5, "configuration is not registered")
  config = config_lookup.config(); budget = config.budget(); workers = config.workers()
  provider = _roleproviderconfig(config, "extractor")
  if provider.provider_id() = "" then return _failure(operation, 3, "configuration has no extractor provider")
  route_id = provider.provider_id(); secret_reference = provider.credential().ref_string(); privacy = _queryprivacy(config)
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  plan = .ragimproveplan
  census = .ragmaintenancecensus
  plan_status = _preparemaintenance(store, config, snapshot_id, plan, census, error)
  reviewed_maintenance_digest = _actionstring(plan_json, "maintenance_digest", error)
  if plan_status = 0 & (reviewed_maintenance_digest = "" | reviewed_maintenance_digest \= census.digest()) then do; error = "reviewed maintenance digest does not match the current canonical census"; plan_status = -2; end
  apply_result = .ragimproveapplyresult(-1, "not-applied", "", 0, 0, 0, "maintenance plan was not applied")
  if plan_status = 0 then plan_status = applyconfiguredimproveplan(store, plan, request.profile_id(), provider.model(), provider.charging_basis(), budget.codex_turns(), apply_result, error)
  maintenance_result = .ragmaintenanceapplyresult
  if plan_status = 0 then plan_status = persistmaintenance(store, census, plan, apply_result, "reviewed", maintenance_result, error)
  embedding_provider = _roleproviderconfig(config, "embedding"); repair_items = 0
  job_id = ""; if plan_status = 0 then job_id = apply_result.job_id()
  if plan_status = 0 & job_id = "" then plan_status = ensuremaintenancejob(store, maintenance_result.run_id(), snapshot_id, budget.model_calls(), budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), job_id, error)
  if plan_status = 0 & job_id \= "" then plan_status = recordmaintenanceembeddingitems(store, maintenance_result.run_id(), job_id, request.profile_id(), embedding_provider.provider_id(), embedding_provider.model(), embedding_provider.charging_basis(), privacy, budget.model_calls(), budget.input_tokens(), budget.cost_microunits(), embedding_provider.timeout_ms(), repair_items, error)
  vector_generations = 0; vector_state = "not-applicable"
  if plan_status = 0 & job_id = "" then plan_status = _publishconfiguredvector(store, config, vector_generations, vector_state, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  fields = .ragresultfield[]
  if job_id = "" then fields[1] = .ragresultfield("job_id", "null", "")
  else fields[1] = .ragresultfield("job_id", "string", job_id)
  fields[2] = .ragresultfield("disposition", "string", maintenance_result.disposition())
  fields[3] = .ragresultfield("items", "integer", maintenance_result.items())
  fields[4] = .ragresultfield("provider_calls", "integer", apply_result.provider_calls())
  fields[5] = .ragresultfield("secret_reference", "string", secret_reference)
  fields[6] = .ragresultfield("run_id", "string", maintenance_result.run_id())
  fields[7] = .ragresultfield("reviews_created", "integer", maintenance_result.reviews())
  fields[8] = .ragresultfield("embedding_repairs", "integer", repair_items)
  fields[9] = .ragresultfield("work_items", "integer", apply_result.items() + repair_items)
  fields[10] = .ragresultfield("vector_state", "string", vector_state)
  fields[11] = .ragresultfield("vector_generations", "integer", vector_generations)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("maintain-apply", fields)
  return .ragcommandresult(operation, "ok", 0, "reviewed maintenance census persisted and durable work queued", records)

_maintainplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "plan") \= 1 then return _failure(operation, 4, "maintenance planning requires plan access")
  if _options(request, "", error) \= 0 then return _failure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 | request.config_id() = "" | request.profile_id() = "" then return _failure(operation, 2, "maintenance planning requires registered --config and --profile ids and no positional arguments")
  config_lookup = registry.config(request.config_id())
  profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return _failure(operation, 5, "configuration or profile is not registered")
  config = config_lookup.config(); budget = config.budget(); workers = config.workers()
  provider = _roleproviderconfig(config, "extractor")
  if provider.provider_id() = "" then return _failure(operation, 3, "configuration has no extractor provider")
  privacy = _queryprivacy(config)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return _openfailure(operation, error)
  snapshot_id = _scalartext(store.database(), "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
  plan = .ragimproveplan
  census = .ragmaintenancecensus
  plan_status = _preparemaintenance(store, config, snapshot_id, plan, census, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return _failure(operation, 1, error); end
  foundation_plan = .ragplan
  action = '{"maintenance_digest":' || jsonquote(census.digest()) || '}'
  foundation_status = createfoundationplan(request.library(), request.config_id(), request.profile_id(), "maintain.apply", action, "curate", registry, foundation_plan, error)
  if foundation_status = -2 then return _failure(operation, 6, error)
  if foundation_status \= 0 then return _failure(operation, 7, error)
  records = .ragresultrecord[]; plan_fields = .ragresultfield[]
  plan_fields[1] = .ragresultfield("schema_version", "string", foundation_plan.schema_version()); plan_fields[2] = .ragresultfield("operation", "string", foundation_plan.operation()); plan_fields[3] = .ragresultfield("canonical_plan", "string", foundation_plan.payload()); plan_fields[4] = .ragresultfield("digest", "string", foundation_plan.digest()); plan_fields[5] = .ragresultfield("expires_at_epoch", "integer", foundation_plan.expires_at()); plan_fields[6] = .ragresultfield("required_capability", "string", "curate"); plan_fields[7] = .ragresultfield("state", "string", "created"); plan_fields[8] = .ragresultfield("enqueued", "boolean", "false")
  records[1] = .ragresultrecord("canonical-plan", plan_fields); fields = .ragresultfield[]
  fields[1] = .ragresultfield("items_planned", "integer", census.item_count())
  plan_triggers = plan.triggers(); fields[2] = .ragresultfield("trigger_count", "integer", plan_triggers.0)
  fields[3] = .ragresultfield("provider_id", "string", provider.provider_id())
  fields[4] = .ragresultfield("provider_kind", "string", provider.kind())
  fields[5] = .ragresultfield("model", "string", provider.model())
  fields[6] = .ragresultfield("route_class", "string", provider.route_class())
  fields[7] = .ragresultfield("privacy", "string", privacy)
  fields[8] = .ragresultfield("charging_basis", "string", provider.charging_basis())
  fields[9] = .ragresultfield("maximum_calls", "integer", budget.model_calls())
  fields[10] = .ragresultfield("maximum_input_tokens", "integer", budget.input_tokens())
  fields[11] = .ragresultfield("maximum_output_tokens", "integer", budget.output_tokens())
  fields[12] = .ragresultfield("maximum_cost_microunits", "integer", budget.cost_microunits())
  fields[13] = .ragresultfield("maximum_codex_turns", "integer", budget.codex_turns())
  fields[14] = .ragresultfield("worker_processes", "integer", workers.processes())
  fields[15] = .ragresultfield("maintenance_digest", "string", census.digest())
  fields[16] = .ragresultfield("cognitive_items", "integer", plan.item_count())
  fields[17] = .ragresultfield("maintenance_plan", "string", census.canonical())
  fields[18] = .ragresultfield("embedding_profile_id", "string", census.embedding_profile_id())
  fields[19] = .ragresultfield("work_provider_calls", "integer", _maintenancecallcount(census))
  records[records.0 + 1] = .ragresultrecord("maintenance-preview", fields)
  return .ragcommandresult(operation, "ok", 0, "bounded maintenance census and worklist created without library writes", records)

_preparemaintenance: procedure = .int
  arg store = .ragstorehandle, config = .ragconfig, snapshot_id = .string, expose plan = .ragimproveplan, expose census = .ragmaintenancecensus, expose error = .string
  error = ""; budget = config.budget(); workers = config.workers()
  extractor = _roleproviderconfig(config, "extractor"); embedder = _roleproviderconfig(config, "embedding")
  if snapshot_id = "" | budget.item_limit() < 1 | budget.item_limit() > 100000 | budget.model_calls() < 1 | budget.minutes() < 1 | extractor.provider_id() = "" | embedder.provider_id() = "" | embedder.kind() = "codex" then do; error = "maintenance requires positive item, provider-call and time budgets plus extractor and embedding providers"; return -1; end
  embedding_profile_id = _embeddingprofileid(embedder)
  missing = _missingembeddingcount(store.database(), embedding_profile_id)
  if missing < 0 then do; error = "cannot calculate configured embedding coverage"; return -3; end
  repair_reservation = missing; if repair_reservation > budget.item_limit() then repair_reservation = budget.item_limit(); if repair_reservation > budget.model_calls() then repair_reservation = budget.model_calls()
  cognitive_limit = budget.model_calls() - repair_reservation
  remaining_items = budget.item_limit() - repair_reservation; if cognitive_limit > remaining_items then cognitive_limit = remaining_items
  privacy = _queryprivacy(config)
  discovery = config.discovery(); glossary_loader = .ragglossaryloader(); glossary = glossary_loader.empty()
  if discovery.glossary_path() \= "" then do
    glossary_result = glossary_loader.load(discovery.glossary_path()); glossary = glossary_result.glossary(); error = glossary_result.error()
    if glossary_result.status() \= 0 then return -1
  end
  discovery_context = ""
  if creatediscoverycontext(glossary, "maintenance", discovery.ranked_limit(), discovery.max_mentions(), discovery.max_relationships(), discovery.max_notes(), discovery_context, error) \= 0 then return -1
  triggers = .string[]; triggers[1] = "bridge"; triggers[2] = "conflict"; triggers[3] = "maintenance-priority"; triggers[4] = "operator-review"; triggers[5] = "unprocessed-extraction"; triggers[6] = "unresolved"; triggers[7] = "weak-support"
  if createimproveplan(store, snapshot_id, "surface-claim-v1", "surface-prompt-v1", triggers, cognitive_limit, cognitive_limit, budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), budget.minutes() * 60000, budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), budget.minutes() * 60000, workers.max_in_flight(), extractor.max_attempts(), privacy, extractor.provider_id(), extractor.credential().ref_string(), discovery_context, plan, error) \= 0 then return -3
  maximum_passes = plan.item_count() + 2
  do pass = 1 to maximum_passes
    if buildmaintenancecensus(store, plan, embedding_profile_id, budget.item_limit(), census, error) \= 0 then return -3
    selected = _censuscognitivechunks(census)
    plan_chunks = plan.chunk_ids()
    if _samechunkset(plan_chunks, selected) = 1 then leave
    filtered = .ragimproveplan
    if filterimproveplan(plan, selected, filtered, error) \= 0 then return -3
    plan = filtered
  end
  selected = _censuscognitivechunks(census); plan_chunks = plan.chunk_ids()
  if _samechunkset(plan_chunks, selected) \= 1 then do; error = "maintenance worklist did not converge to its exact cognitive subset"; return -3; end
  calls = _maintenancecallcount(census)
  if calls > budget.model_calls() then do; error = "maintenance worklist exceeds the configured provider-call budget"; return -2; end
  if plan.item_count() > 0 & queryrouteallowed(extractor, privacy) \= 1 then do; error = "library privacy denies the configured maintenance extractor route"; return -2; end
  if calls > plan.item_count() & queryrouteallowed(embedder, privacy) \= 1 then do; error = "library privacy denies the configured maintenance embedding route"; return -2; end
  return 0

_censuscognitivechunks: procedure = .string[]
  arg census = .ragmaintenancecensus
  output = .string[]; types = census.item_types(); subjects = census.subject_ids()
  do i = 1 to types.0
    if types[i] = "concept-review" then output[output.0 + 1] = subjects[i]
  end
  return output

_maintenancecallcount: procedure = .int
  arg census = .ragmaintenancecensus
  count = 0; types = census.item_types()
  do i = 1 to types.0
    if types[i] = "concept-review" | types[i] = "stale-embedding" then count = count + 1
  end
  return count

_samechunkset: procedure = .int
  arg left_values = .string[], right_values = .string[]
  if left_values.0 \= right_values.0 then return 0
  do i = 1 to left_values.0
    if _containsstring(right_values, left_values[i]) \= 1 then return 0
  end
  return 1

_embeddingprofileid: procedure = .string
  arg provider = .ragproviderconfig
  envelope = "crexx-rag.embedding-input/1|" || provider.provider_id() || "|" || provider.kind() || "|" || provider.model() || "|768"
  return "embedding-768-" || substr(rxhash..sha256hex(envelope as .binary), 1, 12)

_missingembeddingcount: procedure = .int
  arg database = .binary, embedding_profile_id = .string
  generation = _scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1")
  if generation < 1 then return -1
  return _scalarint(database, "SELECT count(*) FROM revision_chunks rc WHERE rc.visible_from_generation<=" || generation || " AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>" || generation || ") AND NOT EXISTS(SELECT 1 FROM revision_chunk_embeddings rce JOIN embeddings e ON e.embedding_id=rce.embedding_id WHERE rce.revision_chunk_id=rc.revision_chunk_id AND e.embedding_profile_id=" || _sqlquote(embedding_profile_id) || " AND rce.visible_from_generation<=" || generation || " AND (rce.visible_to_generation IS NULL OR rce.visible_to_generation>" || generation || "))")

_maintainread: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if _hasaccess(request, "read") \= 1 then return _failure(operation, 4, "maintenance inspection requires read access")
  if _options(request, "id", error) \= 0 then return _failure(operation, 2, error)
  id = _id(request, error)
  if error \= "" then return _failure(operation, 2, error)
  if operation = "maintain.inspect" & id = "" then return _failure(operation, 2, "maintain inspect requires a run, item, or note id")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
  database = store.database(); records = .ragresultrecord[]
  if operation = "maintain.status" then do
    run_id = id
    if run_id = "" then run_id = _scalartext(database, "SELECT run_id FROM maintenance_runs ORDER BY created_at DESC,run_id DESC LIMIT 1")
    if run_id = "" then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 5, "no maintenance run exists"); end
    state = ""; pending = 0; review_count = 0
    if refreshmaintenance(store, run_id, state, pending, review_count, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, error); end
    prepared = .binary
    sql = "SELECT mode,state,expected_generation,plan_digest,created_at,COALESCE(completed_at,'') FROM maintenance_runs WHERE run_id=?1"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, run_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 5, "maintenance run was not found"); end
    mode = ""; stored_state = ""; generation = 0; digest = ""; created = ""; completed = ""
    columns = sqlitecolumntext(prepared, 0, mode) | sqlitecolumntext(prepared, 1, stored_state) | sqlitecolumnint(prepared, 2, generation) | sqlitecolumntext(prepared, 3, digest) | sqlitecolumntext(prepared, 4, created) | sqlitecolumntext(prepared, 5, completed); call sqlitefinalize prepared
    if columns \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot decode maintenance run"); end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("run_id", "string", run_id); fields[2] = .ragresultfield("state", "string", stored_state); fields[3] = .ragresultfield("mode", "string", mode); fields[4] = .ragresultfield("generation", "integer", generation); fields[5] = .ragresultfield("plan_digest", "string", digest); fields[6] = .ragresultfield("pending_items", "integer", pending); fields[7] = .ragresultfield("review_items", "integer", review_count); fields[8] = .ragresultfield("created_at", "string", created); fields[9] = .ragresultfield("completed_at", "string", completed)
    records[1] = .ragresultrecord("maintenance-run", fields)
    prepared = .binary
    sql = "SELECT item_id,item_type,subject_type,subject_id,score,state,trigger_json,diagnosis_json,action_json FROM maintenance_items WHERE run_id=?1 ORDER BY score DESC,item_id LIMIT 99"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, run_id) \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot prepare maintenance item status"); end
    do forever
      step = sqlitestep(prepared); if step = 101 then leave
      if step \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot read maintenance item status"); end
      item_id = ""; item_type = ""; subject_type = ""; subject = ""; item_state = ""; trigger = ""; diagnosis = ""; action = ""; score = 0
      columns = sqlitecolumntext(prepared, 0, item_id) | sqlitecolumntext(prepared, 1, item_type) | sqlitecolumntext(prepared, 2, subject_type) | sqlitecolumntext(prepared, 3, subject) | sqlitecolumnint(prepared, 4, score) | sqlitecolumntext(prepared, 5, item_state) | sqlitecolumntext(prepared, 6, trigger) | sqlitecolumntext(prepared, 7, diagnosis) | sqlitecolumntext(prepared, 8, action)
      if columns \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot decode maintenance item status"); end
      fields = .ragresultfield[]; fields[1] = .ragresultfield("item_id", "string", item_id); fields[2] = .ragresultfield("item_type", "string", item_type); fields[3] = .ragresultfield("subject_type", "string", subject_type); fields[4] = .ragresultfield("subject_id", "string", subject); fields[5] = .ragresultfield("score", "integer", score); fields[6] = .ragresultfield("state", "string", item_state); fields[7] = .ragresultfield("triggers", "string", trigger); fields[8] = .ragresultfield("diagnosis", "string", diagnosis); fields[9] = .ragresultfield("action", "string", action)
      records[records.0 + 1] = .ragresultrecord("maintenance-item", fields)
    end
    call sqlitefinalize prepared
  end
  else do
    prepared = .binary
    sql = "SELECT item_id,run_id,item_type,subject_type,subject_id,score,state,trigger_json,diagnosis_json,action_json FROM maintenance_items WHERE item_id=?1 OR run_id=?1 ORDER BY score DESC,item_id LIMIT 100"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, id) \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot prepare maintenance inspection"); end
    do forever
      step = sqlitestep(prepared); if step = 101 then leave
      if step \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot read maintenance inspection"); end
      item_id = ""; run_id = ""; item_type = ""; subject_type = ""; subject = ""; item_state = ""; trigger = ""; diagnosis = ""; action = ""; score = 0
      columns = sqlitecolumntext(prepared, 0, item_id) | sqlitecolumntext(prepared, 1, run_id) | sqlitecolumntext(prepared, 2, item_type) | sqlitecolumntext(prepared, 3, subject_type) | sqlitecolumntext(prepared, 4, subject) | sqlitecolumnint(prepared, 5, score) | sqlitecolumntext(prepared, 6, item_state) | sqlitecolumntext(prepared, 7, trigger) | sqlitecolumntext(prepared, 8, diagnosis) | sqlitecolumntext(prepared, 9, action)
      if columns \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot decode maintenance inspection"); end
      fields = .ragresultfield[]; fields[1] = .ragresultfield("item_id", "string", item_id); fields[2] = .ragresultfield("run_id", "string", run_id); fields[3] = .ragresultfield("item_type", "string", item_type); fields[4] = .ragresultfield("subject_type", "string", subject_type); fields[5] = .ragresultfield("subject_id", "string", subject); fields[6] = .ragresultfield("score", "integer", score); fields[7] = .ragresultfield("state", "string", item_state); fields[8] = .ragresultfield("triggers", "string", trigger); fields[9] = .ragresultfield("diagnosis", "string", diagnosis); fields[10] = .ragresultfield("action", "string", action)
      records[records.0 + 1] = .ragresultrecord("maintenance-item", fields)
    end
    call sqlitefinalize prepared
    if records.0 = 0 then do
      prepared = .binary
      sql = "SELECT note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation FROM analysis_notes WHERE note_id=?1"
      if sqliteprepare(database, sql, prepared) = 0 & sqlitebindtext(prepared, 1, id) = 0 & sqlitestep(prepared) = 100 then do
        note_id = ""; kind = ""; note_text = ""; next_action = ""; note_state = ""; grounding = ""; author = ""; importance = 0; uncertainty = 0; generation = 0
        columns = sqlitecolumntext(prepared, 0, note_id) | sqlitecolumntext(prepared, 1, kind) | sqlitecolumntext(prepared, 2, note_text) | sqlitecolumnint(prepared, 3, importance) | sqlitecolumnint(prepared, 4, uncertainty) | sqlitecolumntext(prepared, 5, next_action) | sqlitecolumntext(prepared, 6, note_state) | sqlitecolumntext(prepared, 7, grounding) | sqlitecolumntext(prepared, 8, author) | sqlitecolumnint(prepared, 9, generation)
        if columns = 0 then do
          fields = .ragresultfield[]; fields[1] = .ragresultfield("note_id", "string", note_id); fields[2] = .ragresultfield("kind", "string", kind); fields[3] = .ragresultfield("text", "string", note_text); fields[4] = .ragresultfield("importance", "integer", importance); fields[5] = .ragresultfield("uncertainty", "integer", uncertainty); fields[6] = .ragresultfield("next_action", "string", next_action); fields[7] = .ragresultfield("state", "string", note_state); fields[8] = .ragresultfield("grounding", "string", grounding); fields[9] = .ragresultfield("author", "string", author); fields[10] = .ragresultfield("generation", "integer", generation)
          records[1] = .ragresultrecord("analysis-note", fields)
        end
      end
      call sqlitefinalize prepared
    end
  end
  close_error = ""; if closeragstore(store, close_error) \= 0 then return _failure(operation, 7, close_error)
  if records.0 = 0 then return _failure(operation, 5, "maintenance object was not found")
  return .ragcommandresult(operation, "ok", 0, "maintenance state and durable worklist inspected", records)

_roleproviderconfig: procedure = .ragproviderconfig
  arg config = .ragconfig, role = .string
  provider_id = ""; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].role() = role then provider_id = roles[i].provider_id()
  end
  providers = config.providers()
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return providers[i]
  end
  return .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)

_reviewdecision: procedure = .ragcommandresult
  arg request = .ragcommandrequest, apply = .int, registry = .ragregistry
  operation = request.operation(); error = ""
  if _hasaccess(request, "plan") \= 1 then return _failure(operation, 4, "review decision preview requires plan access")
  if _workeroptions(request, "id decision apply", "apply", error) \= 0 then return _failure(operation, 2, error)
  id = _id(request, error); decision = _option(request, "decision", error); apply_value = _option(request, "apply", error)
  if id = "" | (decision \= "accept" & decision \= "reject" & decision \= "dismiss") then return _failure(operation, 2, "review decide requires an id and accept, reject, or dismiss")
  if apply_value = "true" then apply = 1
  if apply = 1 & _hasaccess(request, "curate") \= 1 then return _failure(operation, 4, "review decision apply requires curate access")
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("review_id", "string", id)
  fields[2] = .ragresultfield("decision", "string", decision)
  fields[3] = .ragresultfield("would_write", "boolean", _boolean(apply))
  fields[4] = .ragresultfield("applied", "boolean", "false")
  records = .ragresultrecord[]; records[1] = .ragresultrecord("review-decision-preview", fields)
  if apply = 1 then do
    store = .ragstorehandle
    if openragstore(request.library(), "readwrite", store, error) \= 0 then return _openfailure(operation, error)
    database = store.database(); review_type = ""; proposal_json = ""; current_state = ""
    prepared = .binary
    if sqliteprepare(database, "SELECT review_type,proposal_json,state FROM reviews WHERE review_id=?1", prepared) \= 0 | sqlitebindtext(prepared, 1, id) \= 0 | sqlitestep(prepared) \= 100 then do
      call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored
      return _failure(operation, 5, "review was not found")
    end
    columns = sqlitecolumntext(prepared, 0, review_type) | sqlitecolumntext(prepared, 1, proposal_json) | sqlitecolumntext(prepared, 2, current_state)
    call sqlitefinalize prepared
    if columns \= 0 | current_state \= "pending" then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 5, "pending review was not found or was already decided"); end
    promotion_disposition = "not-applicable"; promoted_claim = ""; promoted_support = ""; maintenance_item_id = ""; maintenance_item_type = ""; maintenance_action = ""; maintenance_expected = 0; maintenance_applied = 0; vector_generations = 0; vector_state = "not-applicable"
    if decision = "accept" & review_type = "external-proposal" then do
      profile_lookup = registry.profile(request.profile_id()); config_lookup = registry.config(request.config_id())
      if profile_lookup.found() \= 1 | config_lookup.found() \= 1 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 5, "configuration or profile is not registered"); end
      external = .ragextractionproposal
      if decodeproposaljson(proposal_json, 1, external, error) \= 0 | external.profile_id() \= request.profile_id() then do
        if error = "" then error = "external proposal profile does not match the selected profile"
        ignored = ""; call closeragstore store, ignored; return _failure(operation, 3, error)
      end
      proposal = internalizeproposal(external); policy = profileclaimpolicy(profile_lookup.profile())
      generation = _scalarint(database, "SELECT published_generation FROM library_meta WHERE singleton=1")
      snapshot_id = _scalartext(database, "SELECT config_snapshot_id FROM published_generations WHERE generation=(SELECT published_generation FROM library_meta WHERE singleton=1)")
      promotion = .ragproposalresult
      if applyproposal(store, proposal, policy, generation, snapshot_id, promotion, error) \= 0 | (promotion.disposition() \= "accepted" & promotion.disposition() \= "identical-no-op") then do
        if error = "" then error = "accepted external proposal did not pass deterministic promotion"
        ignored = ""; call closeragstore store, ignored; return _failure(operation, 3, error)
      end
      promotion_disposition = promotion.disposition(); promoted_claim = promotion.claim_id(); promoted_support = promotion.support_id()
      if _publishconfiguredvector(store, config_lookup.config(), vector_generations, vector_state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 8, "proposal generation is durable but ANN finalisation failed and can be safely retried: " || error); end
    end
    if left(review_type, 12) = "maintenance-" then do
      if _maintenancereview(database, proposal_json, review_type, maintenance_item_id, maintenance_item_type, maintenance_action, maintenance_expected, maintenance_applied, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 3, error); end
      if maintenance_applied > 0 & decision \= "accept" then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 6, "an already published lifecycle action can only complete its pending acceptance and ANN finalisation"); end
      if decision = "accept" & wordpos(maintenance_item_type, "synonym split merge type-correction retire restore") > 0 then do
        profile_lookup = registry.profile(request.profile_id()); config_lookup = registry.config(request.config_id())
        if profile_lookup.found() \= 1 | config_lookup.found() \= 1 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 5, "configuration or profile is not registered"); end
        lifecycle_disposition = ""; lifecycle_generation = maintenance_applied
        if maintenance_applied = 0 then do
          lifecycle_status = applylifecycleaction(store, profile_lookup.profile(), maintenance_item_id, maintenance_action, maintenance_expected, lifecycle_generation, lifecycle_disposition, error)
          if lifecycle_status \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 3, error); end
        end
        else lifecycle_disposition = maintenance_item_type || "-recovered"
        if _publishconfiguredvector(store, config_lookup.config(), vector_generations, vector_state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 8, "lifecycle generation is durable but ANN finalisation failed and can be safely retried: " || error); end
        promotion_disposition = lifecycle_disposition
      end
    end
    state = decision || "ed"
    if decision = "accept" then state = "accepted"
    if sqliteexec(database, "BEGIN IMMEDIATE") \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot begin review decision"); end
    if maintenance_item_id \= "" then do
      item_state = "rejected"; if decision = "accept" then item_state = "applied"
      if maintenance_item_type = "claim-conflict" then do
        conflict_state = decision; if decision = "accept" then conflict_state = "confirmed"
        if sqliteexec(database, "UPDATE claim_conflicts SET review_state=" || _sqlquote(conflict_state) || " WHERE conflict_id=(SELECT subject_id FROM maintenance_items WHERE item_id=" || _sqlquote(maintenance_item_id) || ")") \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot apply conflict review outcome"); end
      end
      applied_sql = "NULL"; if decision = "accept" then applied_sql = "COALESCE(applied_generation,(SELECT published_generation FROM library_meta WHERE singleton=1))"
      if sqliteexec(database, "UPDATE maintenance_items SET state=" || _sqlquote(item_state) || ",applied_generation=" || applied_sql || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE item_id=" || _sqlquote(maintenance_item_id)) \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot persist maintenance review outcome"); end
      note_state = "resolved"; if decision = "reject" then note_state = "rejected"
      if sqliteexec(database, "UPDATE analysis_notes SET state=" || _sqlquote(note_state) || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE review_id=" || _sqlquote(id)) \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot persist analysis-note review outcome"); end
    end
    prepared = .binary
    sql = "UPDATE reviews SET state=?2,decision_json=?3,decided_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE review_id=?1 AND state='pending'"
    decision_json = '{"schema":"crexx-rag.review-decision/1","decision":' || jsonquote(decision) || '}'
    bind_status = -1; step_status = -1
    if sqliteprepare(database, sql, prepared) = 0 then do
      bind_status = sqlitebindtext(prepared, 1, id) | sqlitebindtext(prepared, 2, state) | sqlitebindtext(prepared, 3, decision_json)
      step_status = sqlitestep(prepared)
    end
    call sqlitefinalize prepared
    changed = _scalarint(database, "SELECT changes()")
    if bind_status \= 0 | step_status \= 101 | changed \= 1 then do
      call sqliteexec database, "ROLLBACK"
      ignored = ""; call closeragstore store, ignored
      return _failure(operation, 5, "pending review was not found or was already decided")
    end
    if sqliteexec(database, "COMMIT") \= 0 then do; ignored = ""; call closeragstore store, ignored; return _failure(operation, 7, "cannot commit review decision"); end
    close_error = ""
    if closeragstore(store, close_error) \= 0 then return _failure(operation, 7, close_error)
    fields[4] = .ragresultfield("applied", "boolean", "true")
    fields[5] = .ragresultfield("state", "string", state)
    fields[6] = .ragresultfield("promotion_disposition", "string", promotion_disposition)
    if promoted_claim \= "" then fields[7] = .ragresultfield("claim_id", "string", promoted_claim)
    if promoted_support \= "" then fields[8] = .ragresultfield("support_id", "string", promoted_support)
    if maintenance_item_id \= "" then fields[fields.0 + 1] = .ragresultfield("maintenance_item_id", "string", maintenance_item_id)
    if vector_state \= "not-applicable" then do
      fields[fields.0 + 1] = .ragresultfield("vector_state", "string", vector_state)
      fields[fields.0 + 1] = .ragresultfield("vector_generations", "integer", vector_generations)
    end
    records[1] = .ragresultrecord("review-decision", fields)
    return .ragcommandresult(operation, "ok", 0, "authorized review decision persisted through deterministic proposal validation", records)
  end
  return .ragcommandresult(operation, "ok", 0, "review decision preview produced without mutation", records)

_maintenancereview: procedure = .int
  arg database = .binary, proposal_json = .string, review_type = .string, expose item_id = .string, expose item_type = .string, expose action_json = .string, expose expected_generation = .int, expose applied_generation = .int, expose error = .string
  item_id = ""; item_type = ""; action_json = ""; expected_generation = 0; applied_generation = 0; error = ""
  document = .jsondocument(proposal_json)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" | document.node_count(document.root()) \= 4 then do; error = "maintenance review envelope is invalid"; return -1; end
  schema = ""
  if document.node_string(document.member(document.root(), "schema"), schema) \= 0 | document.node_string(document.member(document.root(), "maintenance_item_id"), item_id) \= 0 | document.node_int(document.member(document.root(), "expected_generation"), expected_generation) \= 0 | document.node_type(document.member(document.root(), "action")) \= "object" | schema \= "crexx-rag.maintenance-review/1" | item_id = "" | expected_generation < 1 then do; error = "maintenance review binding is invalid"; return -1; end
  prepared = .binary
  sql = "SELECT item_type,action_json,state,expected_generation,COALESCE(applied_generation,0) FROM maintenance_items WHERE item_id=?1"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, item_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; error = "maintenance review item was not found"; return -1; end
  item_state = ""; stored_expected = 0
  columns = sqlitecolumntext(prepared, 0, item_type) | sqlitecolumntext(prepared, 1, action_json) | sqlitecolumntext(prepared, 2, item_state) | sqlitecolumnint(prepared, 3, stored_expected) | sqlitecolumnint(prepared, 4, applied_generation); call sqlitefinalize prepared
  canonical = '{"schema":"crexx-rag.maintenance-review/1","maintenance_item_id":' || jsonquote(item_id) || ',"expected_generation":' || expected_generation || ',"action":' || action_json || '}'
  if columns \= 0 | review_type \= "maintenance-" || item_type | stored_expected \= expected_generation | proposal_json \= canonical | (item_state \= "review-required" & item_state \= "approved" & item_state \= "applied") | (item_state = "applied" & applied_generation < 1) then do; error = "maintenance review no longer matches its exact work item"; return -1; end
  return 0

_hasaccess: procedure = .int
  arg request = .ragcommandrequest, required = .string
  access = request.access()
  do i = 1 to access.0
    granted = access[i]
    if granted = required then return 1
    if required = "read" then return 1
    if required = "plan" & (granted = "ingest" | granted = "curate") then return 1
    if required = "control" & (granted = "curate" | granted = "admin") then return 1
    if required = "diagnose" & granted = "admin" then return 1
  end
  return 0

_options: procedure = .int
  arg request = .ragcommandrequest, allowed = .string, expose error = .string
  error = ""; request_options = request.command_options()
  do i = 1 to request_options.0
    if wordpos(request_options[i].name(), allowed) = 0 then do; error = "unknown option --" || request_options[i].name(); return -1; end
    if request_options[i].flag() = 1 | request_options[i].value() = "" then do; error = "option --" || request_options[i].name() || " requires a value"; return -1; end
    do j = 1 to i - 1
      if request_options[j].name() = request_options[i].name() then do; error = "option --" || request_options[i].name() || " may be supplied once"; return -1; end
    end
  end
  return 0

_workeroptions: procedure = .int
  arg request = .ragcommandrequest, allowed = .string, allowed_flags = .string, expose error = .string
  error = ""; request_options = request.command_options()
  do i = 1 to request_options.0
    name = request_options[i].name()
    if wordpos(name, allowed) = 0 then do; error = "unknown option --" || name; return -1; end
    if request_options[i].flag() = 1 & wordpos(name, allowed_flags) = 0 then do; error = "option --" || name || " requires a value"; return -1; end
    if request_options[i].value() = "" then do; error = "option --" || name || " requires a value"; return -1; end
    if request_options[i].flag() = 1 & request_options[i].value() \= "true" then do; error = "flag --" || name || " is invalid"; return -1; end
    do j = 1 to i - 1
      if request_options[j].name() = name then do; error = "option --" || name || " may be supplied once"; return -1; end
    end
  end
  return 0

_option: procedure = .string
  arg request = .ragcommandrequest, name = .string, expose error = .string
  error = ""; value = ""; request_options = request.command_options()
  do i = 1 to request_options.0
    if request_options[i].name() = name then do
      if value \= "" then do; error = "option --" || name || " may be supplied once"; return ""; end
      value = request_options[i].value()
    end
  end
  return value

_id: procedure = .string
  arg request = .ragcommandrequest, expose error = .string
  id = _option(request, "id", error); positionals = request.positionals()
  if positionals.0 > 1 then do; error = "operation accepts one id"; return ""; end
  if positionals.0 = 1 then do
    if id \= "" & id \= positionals[1] then do; error = "id was supplied twice"; return ""; end
    id = positionals[1]
  end
  return id

_actionstring: procedure = .string
  arg plan_json = .string, name = .string, expose error = .string
  document = .jsondocument(plan_json); output = ""
  if document.valid() \= 1 then do; error = "reviewed plan JSON is invalid"; return ""; end
  action = document.member(document.root(), "action")
  if document.node_string(document.member(action, name), output) \= 0 then do; error = "reviewed plan action is invalid"; return ""; end
  return output

_scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary; output = ""
  if sqliteprepare(database, sql, prepared) \= 0 then return ""
  if sqlitestep(prepared) = 100 then call sqlitecolumntext prepared, 0, output
  call sqlitefinalize prepared
  return output

_scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary; output = -1
  if sqliteprepare(database, sql, prepared) \= 0 then return -1
  if sqlitestep(prepared) = 100 then call sqlitecolumnint prepared, 0, output
  call sqlitefinalize prepared
  return output

_unsigned: procedure = .int
  arg value = .string
  if value = "" then return 0
  do i = 1 to length(value)
    if pos(substr(value, i, 1), "0123456789") = 0 then return 0
  end
  return 1

_boolean: procedure = .string
  arg value = .int
  if value \= 0 then return "true"
  return "false"

_sqlquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "''") || "'"

_failure: procedure = .ragcommandresult
  arg operation = .string, code = .int, message = .string
  records = .ragresultrecord[]
  return .ragcommandresult(operation, "error", code, message, records)

_openfailure: procedure = .ragcommandresult
  arg operation = .string, message = .string
  if pos("does not exist", message) > 0 then return _failure(operation, 5, message)
  return _failure(operation, 7, message)
