/* This dispatcher is the single transport-neutral product surface.
 * CLI, ADDRESS RAG and MCP translate into one .ragcommandrequest and preserve
 * the same .ragcommandresult. No adapter owns product SQL or policy. */
dispatchproduct: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation()
  if operation = "mcp.stop" then return commandfailure(operation,2,"call rag_mcp_stop through the MCP connection to stop that session")
  if policyfileoperation(operation) = 1 then return policyfilecommand(request)
  if left(operation, 7) = "config." then return _configcommand(request, registry)
  if operation = "library.report" then return libraryreport(request, registry)
  if operation = "library.snapshot" then return librarysnapshot(request, registry)
  if operation = "library.trend" then return librarytrend(request, registry)
  if operation = "vector.rebuild" then return _vectorrebuild(request, registry)
  if operation = "source.list" | operation = "source.show" then return _repository(request, operation, "sources")
  if operation = "citation.show" then return citationshow(request)
  if operation = "job.list" then return _repository(request, operation, "jobs")
  if operation="job.items" | operation="job.attempts" | operation="maintain.workflows" then return operatordiagnostics(request)
  if operation = "job.plan" then return jobplancommand(request)
  if operation = "job.events" then return jobeventscommand(request)
  if operation = "review.list" | operation = "review.show" then return _repository(request, operation, "reviews")
  if operation = "query.inspect" | operation = "query.search" | operation = "query.evidence" | operation = "query.answer" | operation = "query.trace" | operation = "query.path" | operation = "query.timeline" then return querycommand(request, registry)
  if operation = "job.progress" then return jobprogresscommand(request)
  if operation = "job.status" then return jobstatuscommand(request)
  if operation = "job.pause" | operation = "job.resume" | operation = "job.cancel" then return _jobcontrol(request)
  if operation = "job.retry" then return _jobretry(request)
  if operation = "job.deadline" | operation = "job.reset-retries" then return _joblimits(request)
  if operation = "maintain.waive" then return _taskwaive(request)
  if operation = "maintain.retry" then return _taskretry(request)
  if operation = "maintain.defer" then return _taskdefer(request)
  if operation = "maintain.queue" then return _taskqueue(request,registry)
  if operation = "maintain.reset" then return _taskreset(request,registry)
  if operation = "maintain.reconcile" then return _workflowreconcile(request)
  if operation = "job.replay" then return _jobreplay(request, registry)
  if operation = "job.reconcile" then return _jobreconcile(request, registry)
  if operation = "job.run" | operation="job.continue" then return _workerstart(request, registry)
  if operation = "worker.start" then return _workerstart(request, registry)
  if operation = "worker.run" then return _workerrun(request, registry)
  if operation = "worker.list" | operation = "worker.status" then return _workerread(request)
  if operation = "worker.drain" then return _workerdrain(request)
  if operation = "worker.prune" then return _workerprune(request)
  if operation = "provider.list" then return _providerlist(request, registry)
  if operation = "provider.status" then return _providerstatus(request, registry)
  if operation = "provider.test" then return _providertest(request, registry)
  if operation = "profile.list" then return _profilelist(request, registry)
  if operation = "profile.show" then return _profileshow(request, registry)
  if operation = "schedule.list" | operation = "schedule.show" then return _schedulecommand(request, registry)
  if operation = "proposal.plan" then return _proposalplan(request, registry)
  if operation = "proposal.apply" then return _proposalapply(request, registry)
  if operation = "review.decide" then return _reviewdecision(request, 0, registry)
  if operation = "ingest.plan" then return _ingestplan(request, registry)
  if operation = "ingest.apply" then return _ingestapply(request, registry)
  if operation = "maintain.plan" then return _maintainplan(request, registry)
  if operation = "maintain.apply" then return _maintainapply(request, registry)
  if operation = "maintain.tasks" | operation = "maintain.evidence" then return readtaskpage(request)
  if operation = "maintain.evidence-index" then return taskinventorycommand(request)
  if operation = "maintain.refresh-plan" | operation = "maintain.refresh-apply" then return _taskrefresh(request,registry)
  if operation = "maintain.escalate-plan" | operation = "maintain.escalate-apply" | operation = "maintain.resolve-plan" | operation = "maintain.resolve-apply" then return _agentaction(request,registry)
  if operation = "maintain.status" | operation = "maintain.inspect" then return _maintainread(request)
  return dispatchfoundation(request, registry)

_vectorrebuild: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "vector rebuild requires control access")
  positionals = request.positionals()
  if commandoptions(request, "reconcile", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "vector rebuild accepts only --reconcile")
  reconcile = commandoption(request,"reconcile",error)
  if reconcile \= "" & reconcile \= "true" then return commandfailure(operation,2,"--reconcile is an enabling flag")
  lookup = registry.config(request.config_id()); profile = registry.profile(request.profile_id())
  if lookup.found() \= 1 | profile.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  config = lookup.config(); provider = roleproviderconfig(config, "embedding"); role = rolebinding(config, "embedding"); policy = config.vector()
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  if querysnapshotmatches(store, config, profile.profile()) \= 1 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 6, "vector rebuild configuration must match the current library snapshot"); end
  envelope = "crexx-rag.embedding-input/1|" || provider.provider_id() || "|" || provider.kind() || "|" || provider.model() || "|" || role.embedding_dimensions()
  fingerprint = rxhash..sha256hex(envelope as .binary)
  embedding_profile_id = sqlreadtext(store.database(), "SELECT embedding_profile_id FROM embedding_profiles WHERE input_envelope_fingerprint=" || sqlquote(fingerprint) || " AND dimension=" || role.embedding_dimensions())
  if embedding_profile_id = "" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 6, "no compatible stored embeddings; vector rebuild never calls a provider"); end
  if embeddingwriters(store.database()) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 6, "vector rebuild requires drained workers and paused or settled jobs"); end
  duplicates = 0; reconciled = 0
  if reconcile = "true" then do
    snapshot_id = currentconfigsnapshotid(store.database(),error)
    if reconcileembeddings(store,embedding_profile_id,snapshot_id,duplicates,reconciled,error) \= 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,error); end
  end
  rebuilt = .ragvectorgenerationresult
  if invalidateannindex(store,embedding_profile_id,error) \= 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,error); end
  status = buildannvectorgeneration(store, embedding_profile_id, policy.maximum_rows(), policy.centroids(), policy.probes(), policy.iterations(), policy.maximum_sidecar_bytes(), rebuilt, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 7, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("state", "string", rebuilt.state())
  fields[2] = .ragresultfield("generation", "integer", rebuilt.semantic_generation())
  fields[3] = .ragresultfield("rows", "integer", rebuilt.rows())
  fields[4] = .ragresultfield("dimension", "integer", rebuilt.dimension())
  fields[5] = .ragresultfield("sidecar", "string", rebuilt.sidecar_name())
  fields[6] = .ragresultfield("provider_calls", "integer", 0)
  fields[7] = .ragresultfield("duplicate_links_closed","integer",duplicates)
  fields[8] = .ragresultfield("covered_items_reconciled","integer",reconciled)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("vector-rebuild", fields)
  return .ragcommandresult(operation, "ok", 0, "vector index verified or rebuilt from authoritative SQLite embeddings", records)

_configcommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration and profile must be selected and registered")
  config = lookup.config(); profile = profile_lookup.profile(); positionals = request.positionals()
  if operation="config.prompt" then do
    if commandhasaccess(request,"read")\=1 then return commandfailure(operation,4,"prompt inspection requires read access")
    if commandoptions(request,"role",error)\=0 | positionals.0\=0 then return commandfailure(operation,2,"config prompt accepts --role only")
    role=commandoption(request,"role",error)
    records=promptrecords(config,profile,role,error)
    if error\="" then return commandfailure(operation,2,error)
    return .ragcommandresult(operation,"ok",0,"effective prompt contract read without library access or provider calls",records)
  end
  if operation = "config.check" | operation = "config.explain" then do
    if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "configuration inspection requires read access")
    if commandoptions(request, "", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "configuration check and explain accept no command arguments")
    identity = .ragconfigidentity
    if identifyconfig(config, profile, identity, error) \= 0 then return commandfailure(operation, 3, error)
    records = .ragresultrecord[]; fields = .ragresultfield[]
    fields[1] = .ragresultfield("config_id", "string", config.config_id()); fields[2] = .ragresultfield("config_version", "string", config.version()); fields[3] = .ragresultfield("profile_id", "string", profile.profile_id()); fields[4] = .ragresultfield("config_hash", "string", identity.config_hash()); fields[5] = .ragresultfield("semantic_hash", "string", identity.semantic_hash()); fields[6] = .ragresultfield("operational_hash", "string", identity.operational_hash()); fields[7] = .ragresultfield("snapshot_id", "string", identity.snapshot_id()); fields[8] = .ragresultfield("secret_values", "integer", 0)
    records[1] = .ragresultrecord("effective-configuration", fields)
    if operation = "config.explain" then do
      providers = config.providers()
      do i = 1 to providers.0
        provider = providers[i]; fields = .ragresultfield[]
        fields[1] = .ragresultfield("provider_id", "string", provider.provider_id()); fields[2] = .ragresultfield("model", "string", provider.model()); fields[3] = .ragresultfield("timeout_ms", "integer", provider.timeout_ms()); fields[4] = .ragresultfield("max_attempts", "integer", provider.max_attempts()); fields[5] = .ragresultfield("requests_per_minute", "integer", provider.requests_per_minute()); fields[6] = .ragresultfield("tokens_per_minute", "integer", provider.tokens_per_minute()); fields[7] = .ragresultfield("concurrent_requests", "integer", provider.concurrent_requests()); fields[8] = .ragresultfield("initial_backoff_ms", "integer", provider.initial_backoff_ms()); fields[9] = .ragresultfield("maximum_backoff_ms", "integer", provider.maximum_backoff_ms()); fields[10] = .ragresultfield("jitter_ms", "integer", provider.jitter_ms()); fields[11] = .ragresultfield("credential_reference", "string", provider.credential().ref_string()); fields[12] = .ragresultfield("context_tokens", "integer", provider.context_tokens()); fields[13] = .ragresultfield("maximum_output_tokens", "integer", provider.maximum_output_tokens()); fields[14] = .ragresultfield("embedding_dimensions_minimum", "integer", provider.embedding_dimensions_minimum()); fields[15] = .ragresultfield("embedding_dimensions_maximum", "integer", provider.embedding_dimensions_maximum()); fields[16] = .ragresultfield("maximum_batch_size", "integer", provider.maximum_batch_size()); fields[17] = .ragresultfield("input_price_microunits_per_million", "integer", provider.input_price_microunits_per_million()); fields[18] = .ragresultfield("output_price_microunits_per_million", "integer", provider.output_price_microunits_per_million()); fields[19] = .ragresultfield("catalog_observed_date", "string", provider.catalog_observed_date())
        if provider.reasoning_effort() \= "" then fields[20] = .ragresultfield("reasoning_effort", "string", provider.reasoning_effort())
        records[records.0 + 1] = .ragresultrecord("provider-policy", fields)
      end
      workers = config.workers(); budget = config.budget(); fields = .ragresultfield[]
      fields[1] = .ragresultfield("worker_processes", "integer", workers.processes()); fields[2] = .ragresultfield("worker_max_in_flight", "integer", workers.max_in_flight()); fields[3] = .ragresultfield("lease_seconds", "integer", workers.lease_seconds()); fields[4] = .ragresultfield("budget_minutes", "integer", budget.minutes()); fields[5] = .ragresultfield("budget_items", "integer", budget.item_limit()); fields[6] = .ragresultfield("budget_calls", "integer", budget.model_calls()); fields[7] = .ragresultfield("budget_input_tokens", "integer", budget.input_tokens()); fields[8] = .ragresultfield("budget_output_tokens", "integer", budget.output_tokens()); fields[9] = .ragresultfield("budget_cost_microunits", "integer", budget.cost_microunits()); fields[10] = .ragresultfield("worker_poll_ms", "integer", workers.poll_ms()); fields[11] = .ragresultfield("guided_deadline_seconds", "integer", workers.guided_deadline_seconds())
      records[records.0 + 1] = .ragresultrecord("operational-policy", fields)
      retrieval = config.retrieval(); fields = .ragresultfield[]
      fields[1] = .ragresultfield("lexical_candidates", "integer", retrieval.lexical_candidates()); fields[2] = .ragresultfield("vector_candidates", "integer", retrieval.vector_candidates()); fields[3] = .ragresultfield("vector_scan_limit", "integer", retrieval.vector_scan_limit()); fields[4] = .ragresultfield("graph_hops", "integer", retrieval.graph_hops()); fields[5] = .ragresultfield("passage_limit", "integer", retrieval.passage_limit()); fields[6] = .ragresultfield("claim_limit", "integer", retrieval.claim_limit()); fields[7] = .ragresultfield("lead_limit", "integer", retrieval.lead_limit()); fields[8] = .ragresultfield("rrf_k", "integer", retrieval.rrf_k()); fields[9] = .ragresultfield("graph_boost_millionths", "integer", retrieval.graph_boost_millionths()); fields[10] = .ragresultfield("graph_decay_millionths", "integer", retrieval.graph_decay_millionths()); fields[11] = .ragresultfield("directness_bonus_millionths", "integer", retrieval.directness_bonus_millionths()); fields[12] = .ragresultfield("graph_direction", "string", retrieval.graph_direction()); fields[13] = .ragresultfield("maximum_evidence_bytes", "integer", retrieval.maximum_evidence_bytes())
      records[records.0 + 1] = .ragresultrecord("retrieval-policy", fields)
      maintenance = config.maintenance(); observation = config.observation(); clear fields; fields = .ragresultfield[]
      fields[1] = .ragresultfield("sparse_max_degree", "integer", maintenance.sparse_max_degree()); fields[2] = .ragresultfield("query_gap_min_occurrences", "integer", maintenance.query_gap_min_occurrences()); fields[3] = .ragresultfield("batch_items", "integer", maintenance.batch_items()); fields[4] = .ragresultfield("snapshot_capture_threshold", "integer", observation.capture_threshold()); fields[5] = .ragresultfield("snapshot_cooldown_seconds", "integer", observation.cooldown_seconds()); fields[6] = .ragresultfield("snapshot_maximum_staleness_seconds", "integer", observation.maximum_staleness_seconds()); fields[7] = .ragresultfield("snapshot_work_minimum_change", "integer", observation.work_minimum_change()); fields[8] = .ragresultfield("snapshot_work_relative_millionths", "integer", observation.work_relative_millionths()); fields[9] = .ragresultfield("snapshot_dead_letter_minimum_change", "integer", observation.dead_letter_minimum_change()); fields[10] = .ragresultfield("snapshot_review_minimum_change", "integer", observation.review_minimum_change()); fields[11] = .ragresultfield("narrative_output_tokens", "integer", observation.narrative_output_tokens())
      fields[12] = .ragresultfield("mode","string",maintenance.mode()); fields[13] = .ragresultfield("window_seconds","integer",maintenance.window_seconds()); fields[14] = .ragresultfield("automatic_actions","string",maintenance.automatic_actions()); fields[15] = .ragresultfield("maximum_impact","integer",maintenance.maximum_impact()); fields[16] = .ragresultfield("maximum_attempts","integer",maintenance.maximum_attempts()); fields[17] = .ragresultfield("retry_seconds","integer",maintenance.retry_seconds()); fields[18] = .ragresultfield("maximum_evidence_bytes","integer",maintenance.maximum_evidence_bytes()); fields[19] = .ragresultfield("resolution_prompt_sha256","string",rxhash..sha256hex(maintenance.resolution_prompt() as .binary)); fields[20] = .ragresultfield("provider_time_minutes","integer",maintenance.provider_time_minutes())
      records[records.0 + 1] = .ragresultrecord("maintenance-observation-policy", fields)
      roles = config.roles()
      do i = 1 to roles.0
        role = roles[i]; clear fields; fields = .ragresultfield[]
        fields[1] = .ragresultfield("role", "string", role.role()); fields[2] = .ragresultfield("provider_id", "string", role.provider_id()); fields[3] = .ragresultfield("maximum_input_tokens", "integer", role.maximum_input_tokens()); fields[4] = .ragresultfield("maximum_output_tokens", "integer", role.maximum_output_tokens()); fields[5] = .ragresultfield("maximum_call_cost_microunits", "integer", role.maximum_call_cost_microunits()); fields[6] = .ragresultfield("embedding_dimensions", "integer", role.embedding_dimensions()); fields[7] = .ragresultfield("batch_size", "integer", role.batch_size()); fields[8] = .ragresultfield("temperature_millionths", "integer", role.temperature_millionths()); fields[9] = .ragresultfield("system_prompt_sha256", "string", rxhash..sha256hex(role.system_prompt() as .binary))
        records[records.0 + 1] = .ragresultrecord("role-policy", fields)
      end
      vector = config.vector(); clear fields; fields = .ragresultfield[]
      fields[1] = .ragresultfield("maximum_rows", "integer", vector.maximum_rows()); fields[2] = .ragresultfield("maximum_sidecar_bytes", "integer", vector.maximum_sidecar_bytes()); fields[3] = .ragresultfield("embedding_maximum_items", "integer", vector.embedding_maximum_items())
      records[records.0 + 1] = .ragresultrecord("vector-scale-policy", fields)
      clear fields; fields = .ragresultfield[]
      fields[1] = .ragresultfield("ttl_seconds", "integer", config.plan_ttl_seconds()); fields[2] = .ragresultfield("maximum_plan_bytes", "integer", 16777216)
      records[records.0 + 1] = .ragresultrecord("plan-policy", fields)
      sources = config.source_sets()
      do i = 1 to sources.0
        source = sources[i]; clear fields; fields = .ragresultfield[]
        fields[1] = .ragresultfield("source_set_id", "string", source.source_set_id()); fields[2] = .ragresultfield("root", "string", source.root()); fields[3] = .ragresultfield("maximum_file_bytes", "integer", source.maximum_file_bytes()); fields[4] = .ragresultfield("maximum_depth", "integer", source.maximum_depth())
        records[records.0 + 1] = .ragresultrecord("source-policy", fields)
      end
      discovery = config.discovery(); clear fields; fields = .ragresultfield[]
      fields[1] = .ragresultfield("mode", "string", discovery.mode()); fields[2] = .ragresultfield("glossary_file", "string", discovery.glossary_path()); fields[3] = .ragresultfield("ranked_limit", "integer", discovery.ranked_limit()); fields[4] = .ragresultfield("max_mentions", "integer", discovery.max_mentions()); fields[5] = .ragresultfield("max_relationships", "integer", discovery.max_relationships()); fields[6] = .ragresultfield("max_notes", "integer", discovery.max_notes())
      records[records.0 + 1] = .ragresultrecord("discovery-policy", fields)
      clear fields; fields = .ragresultfield[]
      fields[1] = .ragresultfield("algorithm", "string", vector.algorithm()); fields[2] = .ragresultfield("centroids", "integer", vector.centroids()); fields[3] = .ragresultfield("probes", "integer", vector.probes()); fields[4] = .ragresultfield("iterations", "integer", vector.iterations()); fields[5] = .ragresultfield("recall_minimum_millionths", "integer", vector.recall_minimum_millionths())
      records[records.0 + 1] = .ragresultrecord("vector-build-policy", fields)
      selected = config.profile_ids(); profile_files = config.profile_files()
      do i = 1 to selected.0
        origin = "compiled-compatibility"; path = ""
        do j = 1 to profile_files.0
          if profile_files[j].profile_id() = selected[i] then do; origin = "data-file"; path = profile_files[j].path(); end
        end
        clear fields; fields = .ragresultfield[]
        fields[1] = .ragresultfield("profile_id", "string", selected[i]); fields[2] = .ragresultfield("origin", "string", origin); fields[3] = .ragresultfield("file", "string", path)
        records[records.0 + 1] = .ragresultrecord("profile-policy-source", fields)
      end
    end
    message = "configuration is valid and its split identities were computed without resolving credentials"
    if operation = "config.explain" then message = "effective configuration and bounded provider policy explained without resolving credentials"
    return .ragcommandresult(operation, "ok", 0, message, records)
  end
  if request.library() = "" then return commandfailure(operation, 2, "configuration comparison and apply require a library")
  if operation = "config.diff" then do
    if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "configuration diff requires read access")
    if commandoptions(request, "", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "configuration diff accepts no command arguments")
    store = .ragstorehandle
    if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
    difference = .ragconfigdiff; status = inspectconfigchange(store, config, profile, difference, error); close_error = ""; close_status = closeragstore(store, close_error)
    if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 7, error); end
    records = .ragresultrecord[]; records[1] = _configdiffrecord(difference)
    return .ragcommandresult(operation, "ok", 0, "effective configuration compared with the library without writes or provider calls", records)
  end
  if operation = "config.plan" then do
    if commandhasaccess(request, "plan") \= 1 then return commandfailure(operation, 4, "configuration planning requires plan access")
    if commandoptions(request, "reason", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "configuration planning accepts only --reason")
    reason = commandoption(request, "reason", error)
    store = .ragstorehandle
    if reason = "" then return commandfailure(operation, 2, "configuration planning requires --reason")
    if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
    plan = .ragplan; difference = .ragconfigdiff; status = createreconfigureplan(store, config, profile, reason, plan, difference, error); close_error = ""; close_status = closeragstore(store, close_error)
    if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 7, error); end
    fields = .ragresultfield[]; fields[1] = .ragresultfield("schema_version", "string", plan.schema_version()); fields[2] = .ragresultfield("canonical_plan", "string", plan.payload()); fields[3] = .ragresultfield("digest", "string", plan.digest()); fields[4] = .ragresultfield("expires_at_epoch", "integer", plan.expires_at()); fields[5] = .ragresultfield("provider_calls", "integer", 0)
    records = .ragresultrecord[]; records[1] = .ragresultrecord("canonical-plan", fields); records[2] = _configdiffrecord(difference)
    return .ragcommandresult(operation, "ok", 0, "configuration transition classified and frozen into a zero-write canonical plan", records)
  end
  if operation = "config.apply" then do
    if commandhasaccess(request, "admin") \= 1 then return commandfailure(operation, 4, "configuration apply requires admin access")
    if commandoptions(request, "plan-json expect-digest", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "configuration apply accepts only --plan-json and --expect-digest")
    plan_json = commandoption(request, "plan-json", error); digest = commandoption(request, "expect-digest", error)
    if plan_json = "" | digest = "" then return commandfailure(operation, 2, "configuration apply requires the reviewed plan JSON and digest")
    store = .ragstorehandle
    if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
    difference = .ragconfigdiff; status = applyreconfigureplan(store, config, profile, plan_json, digest, difference, error); close_error = ""; close_status = closeragstore(store, close_error)
    if status = -3 then return commandfailure(operation, 6, error)
    if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 6, error); end
    records = .ragresultrecord[]; records[1] = _configdiffrecord(difference)
    return .ragcommandresult(operation, "ok", 0, "reviewed configuration snapshot applied with immutable audit history", records)
  end
  return commandfailure(operation, 8, "configuration operation is not implemented")

_configdiffrecord: procedure = .ragresultrecord
  arg difference = .ragconfigdiff
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("classification", "string", difference.classification()); fields[2] = .ragresultfield("source_snapshot_id", "string", difference.source_snapshot_id()); fields[3] = .ragresultfield("target_snapshot_id", "string", difference.target_snapshot_id()); fields[4] = .ragresultfield("source_config_hash", "string", difference.source_config_hash()); fields[5] = .ragresultfield("target_config_hash", "string", difference.target_config_hash()); fields[6] = .ragresultfield("source_semantic_hash", "string", difference.source_semantic_hash()); fields[7] = .ragresultfield("target_semantic_hash", "string", difference.target_semantic_hash()); fields[8] = .ragresultfield("source_operational_hash", "string", difference.source_operational_hash()); fields[9] = .ragresultfield("target_operational_hash", "string", difference.target_operational_hash()); fields[10] = .ragresultfield("active_jobs", "integer", difference.active_jobs()); fields[11] = .ragresultfield("provider_calls", "integer", 0)
  return .ragresultrecord("configuration-diff", fields)

_providerlist: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.list"; error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "provider list requires read access")
  if commandoptions(request, "", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return commandfailure(operation, 2, "provider list accepts no positional arguments")
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "configuration is not registered")
  providers = lookup.config().providers(); records = .ragresultrecord[]
  do i = 1 to providers.0
    provider = providers[i]; fields = .ragresultfield[]
    fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
    fields[2] = .ragresultfield("kind", "string", provider.kind())
    fields[3] = .ragresultfield("model", "string", provider.model())
    fields[4] = .ragresultfield("route_class", "string", provider.route_class())
    fields[5] = .ragresultfield("privacy_policy", "string", provider.privacy_policy())
    fields[6] = .ragresultfield("charging_basis", "string", provider.charging_basis())
    fields[7] = .ragresultfield("credential_reference", "string", provider.credential().ref_string())
    fields[8] = .ragresultfield("timeout_ms", "integer", provider.timeout_ms())
    fields[9] = .ragresultfield("maximum_attempts", "integer", provider.max_attempts())
    fields[10] = .ragresultfield("requests_per_minute", "integer", provider.requests_per_minute())
    fields[11] = .ragresultfield("tokens_per_minute", "integer", provider.tokens_per_minute())
    fields[12] = .ragresultfield("concurrent_requests", "integer", provider.concurrent_requests())
    fields[13] = .ragresultfield("initial_backoff_ms", "integer", provider.initial_backoff_ms())
    fields[14] = .ragresultfield("maximum_backoff_ms", "integer", provider.maximum_backoff_ms())
    fields[15] = .ragresultfield("jitter_ms", "integer", provider.jitter_ms())
    records[records.0 + 1] = .ragresultrecord("provider", fields)
  end
  return .ragcommandresult(operation, "ok", 0, "configured providers listed without resolving credentials or making outbound requests", records)

_profilelist: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "profile.list"; error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "profile list requires read access")
  if commandoptions(request, "", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return commandfailure(operation, 2, "profile list accepts no positional arguments")
  ids = registry.profile_ids(); records = .ragresultrecord[]
  do i = 1 to ids.0
    lookup = registry.profile(ids[i])
    if lookup.found() \= 1 then return commandfailure(operation, 3, "registered profile could not be loaded")
    profile = lookup.profile(); fields = .ragresultfield[]
    fields[1] = .ragresultfield("profile_id", "string", profile.profile_id())
    fields[2] = .ragresultfield("version", "string", profile.version())
    concept_types = .string[]; relationship_types = .ragrelationshiptype[]; validation = .ragvalidationresult
    concept_types = profile.concept_types(); relationship_types = profile.relationship_types(); validation = profile.validation()
    fields[3] = .ragresultfield("concept_type_count", "integer", concept_types.0)
    fields[4] = .ragresultfield("relationship_type_count", "integer", relationship_types.0)
    fields[5] = .ragresultfield("valid", "boolean", commandboolean(validation.ok()))
    records[records.0 + 1] = .ragresultrecord("profile", fields)
  end
  return .ragcommandresult(operation, "ok", 0, "registered profiles listed", records)

_profileshow: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "profile.show"; error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "profile show requires read access")
  if commandoptions(request, "", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 > 1 then return commandfailure(operation, 2, "profile show accepts one profile id")
  profile_id = request.profile_id()
  if positionals.0 = 1 then do
    if profile_id \= "" & profile_id \= positionals[1] then return commandfailure(operation, 2, "profile id conflicts with global --profile")
    profile_id = positionals[1]
  end
  if profile_id = "" then return commandfailure(operation, 2, "profile show requires a profile id")
  lookup = registry.profile(profile_id)
  if lookup.found() \= 1 then return commandfailure(operation, 5, "profile is not registered")
  profile = lookup.profile(); records = .ragresultrecord[]; fields = .ragresultfield[]; validation = .ragvalidationresult; chunk_policy = .ragchunkpolicy
  fields[1] = .ragresultfield("profile_id", "string", profile.profile_id())
  fields[2] = .ragresultfield("version", "string", profile.version())
  validation = profile.validation()
  chunk_policy = profile.chunk_policy()
  fields[3] = .ragresultfield("valid", "boolean", commandboolean(validation.ok()))
  fields[4] = .ragresultfield("maximum_chunk_characters", "integer", chunk_policy.max_characters())
  fields[5] = .ragresultfield("overlap_characters", "integer", chunk_policy.overlap_characters())
  records[records.0 + 1] = .ragresultrecord("profile", fields)
  values = .string[]; values = profile.concept_types()
  do i = 1 to values.0
    concept_fields = .ragresultfield[]; concept_fields[1] = .ragresultfield("concept_type", "string", values[i])
    records[records.0 + 1] = .ragresultrecord("profile-concept-type", concept_fields)
  end
  relationships = .ragrelationshiptype[]; relationships = profile.relationship_types()
  do i = 1 to relationships.0
    relationship_fields = .ragresultfield[]
    relationship_fields[1] = .ragresultfield("relationship_type", "string", relationships[i].relationship_id())
    relationship_fields[2] = .ragresultfield("inverse", "string", relationships[i].inverse_id())
    relationship_fields[3] = .ragresultfield("directional", "boolean", commandboolean(relationships[i].directional()))
    records[records.0 + 1] = .ragresultrecord("profile-relationship-type", relationship_fields)
  end
  aliases = .ragalias[]; aliases = profile.aliases()
  do i = 1 to aliases.0
    alias_fields = .ragresultfield[]
    alias_fields[1] = .ragresultfield("surface", "string", aliases[i].surface())
    alias_fields[2] = .ragresultfield("canonical", "string", aliases[i].canonical())
    records[records.0 + 1] = .ragresultrecord("profile-alias", alias_fields)
  end
  return .ragcommandresult(operation, "ok", 0, "registered profile vocabulary and policy shown", records)

_schedulecommand: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "schedule inspection requires read access")
  if commandoptions(request, "", error) \= 0 then return commandfailure(operation, 2, error)
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "schedule inspection requires a registered configuration")
  positionals = request.positionals(); requested = ""
  if operation = "schedule.list" then do
    if positionals.0 \= 0 then return commandfailure(operation, 2, "schedule list accepts no positional arguments")
  end
  else do
    if positionals.0 \= 1 then return commandfailure(operation, 2, "schedule show requires one schedule id")
    requested = positionals[1]
  end
  schedules = lookup.config().schedules(); records = .ragresultrecord[]
  do i = 1 to schedules.0
    schedule = schedules[i]
    if requested \= "" & schedule.schedule_id() \= requested then iterate
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("schedule_id", "string", schedule.schedule_id()); fields[2] = .ragresultfield("operation", "string", schedule.operation()); fields[3] = .ragresultfield("trigger", "string", schedule.trigger()); fields[4] = .ragresultfield("enabled", "boolean", commandboolean(schedule.enabled())); fields[5] = .ragresultfield("recurrence_owner", "string", "external"); fields[6] = .ragresultfield("provider_calls", "integer", 0)
    records[records.0 + 1] = .ragresultrecord("schedule", fields)
  end
  if requested \= "" & records.0 = 0 then return commandfailure(operation, 5, "schedule is not configured")
  return .ragcommandresult(operation, "ok", 0, "configured schedules exposed for an external recurrence runner without executing them", records)

_proposalplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "proposal.plan"; error = ""
  if commandhasaccess(request, "plan") \= 1 then return commandfailure(operation, 4, "proposal planning requires plan access")
  if commandoptions(request, "input proposals-ndjson", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return commandfailure(operation, 2, "proposal plan accepts no positional arguments")
  input = commandoption(request, "input", error); inline = commandoption(request,"proposals-ndjson",error)
  input_options = request.command_options()
  if error \= "" | input_options.0 \= 1 | (input = "") = (inline = "") then return commandfailure(operation, 2, "proposal plan requires exactly one --input NDJSON file or --proposals-ndjson inline content")
  if binlength(inline as .binary)>65535 then return commandfailure(operation,2,"inline proposals exceed 65535 UTF-8 bytes; use smaller batches or a server-side file")
  lookup = registry.profile(request.profile_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "profile is not registered")
  proposals = .ragextractionproposal[]
  decoded = 0
  if input \= "" then decoded = loadexternalproposals(input,proposals,error)
  else decoded = decodeexternalproposals(inline,proposals,error)
  if decoded \= 0 then return commandfailure(operation,2,error)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  policy = effectiveclaimpolicy(lookup.profile()); plan = .ragexternalproposalplan
  status = createexternalproposalplan(store, snapshot_id, policy, proposals, plan, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 7, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("canonical_plan", "string", plan.canonical())
  fields[2] = .ragresultfield("digest", "string", plan.digest())
  fields[3] = .ragresultfield("proposal_count", "integer", proposals.0)
  fields[4] = .ragresultfield("expected_generation", "integer", plan.expected_generation())
  fields[5] = .ragresultfield("library_writes", "integer", 0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("proposal-plan", fields)
  return .ragcommandresult(operation, "ok", 0, "external proposals validated and planned without library writes", records)

_proposalapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "proposal.apply"; error = ""
  if commandhasaccess(request, "curate") \= 1 then return commandfailure(operation, 4, "proposal apply requires curate access")
  if commandoptions(request, "plan-json expect-digest", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return commandfailure(operation, 2, "proposal apply accepts no positional arguments")
  plan_json = commandoption(request, "plan-json", error); digest = commandoption(request, "expect-digest", error)
  if error \= "" | plan_json = "" | digest = "" then return commandfailure(operation, 2, "proposal apply requires --plan-json and --expect-digest")
  if rxhash..sha256hex(plan_json as .binary) \= digest then return commandfailure(operation, 6, "reviewed proposal plan digest does not match")
  proposals = .ragextractionproposal[]
  if decodeexternalplan(plan_json, proposals, error) \= 0 then return commandfailure(operation, 2, error)
  lookup = registry.profile(request.profile_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "profile is not registered")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  policy = effectiveclaimpolicy(lookup.profile()); plan = .ragexternalproposalplan
  plan_status = createexternalproposalplan(store, snapshot_id, policy, proposals, plan, error)
  if plan_status = 0 & (plan.canonical() \= plan_json | plan.digest() \= digest) then do; plan_status = -2; error = "external proposals or library generation changed after review"; end
  reviews_created = 0; apply_status = -1; review_ids = .string[]
  if plan_status = 0 then apply_status = applyexternalproposalplan(store, plan, policy, proposals, reviews_created, error, review_ids)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | apply_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 6, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("digest", "string", digest)
  fields[2] = .ragresultfield("proposal_count", "integer", proposals.0)
  fields[3] = .ragresultfield("reviews_created", "integer", reviews_created)
  fields[4] = .ragresultfield("provider_calls", "integer", 0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("proposal-apply", fields)
  do i = 1 to review_ids.0
    review_fields = .ragresultfield[]
    review_fields[1] = .ragresultfield("proposal_id", "string", proposals[i].proposal_id())
    review_fields[2] = .ragresultfield("review_id", "string", review_ids[i])
    records[records.0 + 1] = .ragresultrecord("proposal-review", review_fields)
  end
  return .ragcommandresult(operation, "ok", 0, "reviewed external proposals applied through the mandatory review gate", records)

_providerstatus: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.status"; error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "provider status requires read access")
  if commandoptions(request, "provider", error) \= 0 then return commandfailure(operation, 2, error)
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "configuration is not registered")
  has_extended_route = 0; configured_providers = lookup.config().providers()
  do i = 1 to configured_providers.0
    if configured_providers[i].kind() = "codex" | (configured_providers[i].kind() = "openai-compatible" & configured_providers[i].route_class() = "local") then has_extended_route = 1
  end
  if has_extended_route = 0 then return dispatchfoundation(request, registry)
  requested = commandoption(request, "provider", error); providers = lookup.config().providers(); records = .ragresultrecord[]; unavailable = 0
  do i = 1 to providers.0
    provider = providers[i]
    if requested \= "" & requested \= provider.provider_id() then iterate
    state = "configured-not-probed"; account_type = ""; plan_type = ""; allowance = -1; detail = "configuration is valid"
    if provider.kind() = "codex" then do
      diagnostic = .ragproviderdiagnostic; diagnostic_error = ""
      if codexdiagnostic(provider.timeout_ms(), diagnostic, diagnostic_error) = 0 then do
        state = "ready"; account_type = diagnostic.account_type(); plan_type = diagnostic.plan_type(); allowance = diagnostic.allowance_available(); detail = diagnostic.detail()
      end
      else do; state = "unavailable"; detail = diagnostic_error; unavailable = 1; end
    end
    else if provider.kind() = "openai-compatible" & provider.route_class() = "local" then do
      if llamacppinstalled() = 1 then do; state = "llama.cpp-installed-server-not-probed"; detail = "llama-server is installed; setup and ingestion perform the endpoint smoke tests"; end
      else do; state = "local-runtime-unavailable"; detail = "llama-server is not installed at the configured local runtime path"; unavailable = 1; end
    end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
    fields[2] = .ragresultfield("kind", "string", provider.kind())
    fields[3] = .ragresultfield("model", "string", provider.model())
    fields[4] = .ragresultfield("route_class", "string", provider.route_class())
    fields[5] = .ragresultfield("privacy_policy", "string", provider.privacy_policy())
    fields[6] = .ragresultfield("charging_basis", "string", provider.charging_basis())
    fields[7] = .ragresultfield("state", "string", state)
    fields[8] = .ragresultfield("account_type", "string", account_type)
    fields[9] = .ragresultfield("plan_type", "string", plan_type)
    fields[10] = .ragresultfield("allowance_available_percent", "integer", allowance)
    fields[11] = .ragresultfield("detail", "string", detail)
    records[records.0 + 1] = .ragresultrecord("provider-status", fields)
  end
  if records.0 = 0 then return commandfailure(operation, 5, "provider is not registered in the selected configuration")
  if unavailable = 1 then return .ragcommandresult(operation, "error", 8, "one or more selected providers are unavailable", records)
  return .ragcommandresult(operation, "ok", 0, "provider status inspected without a model request or credential disclosure", records)

_providertest: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = "provider.test"; error = ""
  if commandoptions(request, "provider", error) \= 0 then return commandfailure(operation, 2, error)
  if commandhasaccess(request, "diagnose") \= 1 then return commandfailure(operation, 4, "provider test requires diagnose access")
  lookup = registry.config(request.config_id())
  if lookup.found() \= 1 then return commandfailure(operation, 5, "configuration is not registered")
  requested = commandoption(request, "provider", error)
  if error \= "" | requested = "" then return commandfailure(operation, 2, "provider test requires one --provider value")
  config = lookup.config(); providers = config.providers(); provider_index = 0
  do i = 1 to providers.0
    if providers[i].provider_id() = requested then provider_index = i
  end
  if provider_index = 0 then return commandfailure(operation, 5, "provider is not registered in the selected configuration")
  provider = providers[provider_index]
  if queryrouteallowed(provider, "public") \= 1 then return commandfailure(operation, 4, "provider route does not permit the public synthetic smoke input")

  embedding_planned = 0; answer_planned = 0; roles = config.roles(); embedding_role = .ragrolebinding(); answer_role = .ragrolebinding()
  do i = 1 to roles.0
    if roles[i].provider_id() \= requested then iterate
    if roles[i].role() = "embedding" then do; embedding_planned = 1; embedding_role = roles[i]; end
    else do; answer_planned = 1; answer_role = roles[i]; end
  end
  if embedding_planned + answer_planned = 0 then return commandfailure(operation, 5, "provider is not assigned to an application role")
  if provider.kind() = "codex" & embedding_planned = 1 then return commandfailure(operation, 3, "Codex cannot be assigned to embedding generation")
  missing = .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)
  embedding_provider = missing; answer_provider = missing
  if embedding_planned = 1 then embedding_provider = provider
  if answer_planned = 1 then answer_provider = provider
  budget = config.budget()
  requested_output = 0
  if answer_planned = 1 then do
    requested_output = queryansweroutputlimit(budget, answer_role.maximum_output_tokens())
    if requested_output > 128 then requested_output = 128
  end
  if querypreflight(budget, embedding_provider, embedding_planned, answer_provider, answer_planned, error, requested_output, embedding_role.maximum_input_tokens(), answer_role.maximum_input_tokens()) \= 0 then return commandfailure(operation, 6, error)

  tracer = .ragtracer(request.progress(), request.format()); records = .ragresultrecord[]
  embedding_result = .providerresult(); answer_result = .providerresult()
  embedding_called = 0; answer_called = 0; allowance_before = -1; allowance_after = -1
  identity_seed = requested || "00"x || provider.kind() || "00"x || provider.model() || "00"x || time("us")
  identity = "provider-smoke-" || substr(rxhash..sha256hex(identity_seed as .binary), 1, 32)
  if embedding_planned = 1 then do
    call tracer.emit("provider-test", "start", requested, "embedding generation with public synthetic input")
    smoke_dimension = embedding_role.embedding_dimensions()
    if generatequeryembedding(provider, "What does BillingService depend on?", "public", smoke_dimension, identity || "-embed", embedding_result, error) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "embedding output rejected")
      return commandfailure(operation, 8, error)
    end
    embedding_called = 1
    records[records.0 + 1] = _providersmokerecord(provider, "embedding-generation", embedding_result, smoke_dimension, -1, -1)
    call tracer.emit("provider-test", "complete", requested, "embedding dimension=" || smoke_dimension || " validated")
  end
  if answer_planned = 1 then do
    citation = "crexx-rag:provider-smoke:public-synthetic:revision-1:utf8-0-37"
    context = "{" || jsonquote("schema") || ":" || jsonquote("crexx-rag.answer-context/2") || "," || jsonquote("question") || ":" || jsonquote("What status does the provider smoke passage report?") || "," || jsonquote("evidence") || ":{" || jsonquote("passages") || ":[{" || jsonquote("citation") || ":{" || jsonquote("id") || ":" || jsonquote(citation) || "}," || jsonquote("text") || ":" || jsonquote("The provider smoke test is ready.") || "}]," || jsonquote("claims") || ":[]," || jsonquote("gaps") || ":[]}}"
    maximum_output = requested_output
    call tracer.emit("provider-test", "start", requested, "structured generation with public synthetic input")
    if generatequeryanswer(provider, context, "public", maximum_output, budget.minimum_codex_allowance_percent(), identity || "-answer", answer_result, allowance_before, allowance_after, error, answer_role.system_prompt(), answer_role.temperature_millionths()) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "structured generation failed")
      return commandfailure(operation, 8, error)
    end
    if _validsmokeanswer(answer_result.content(), citation, error) \= 0 then do
      call tracer.emit("provider-test", "failed", requested, "structured output rejected")
      return commandfailure(operation, 1, error)
    end
    answer_called = 1
    records[records.0 + 1] = _providersmokerecord(provider, "structured-generation", answer_result, 0, allowance_before, allowance_after)
    call tracer.emit("provider-test", "complete", requested, "answer schema and citation validated")
  end
  embedding_usage = embedding_result.usage(); answer_usage = answer_result.usage()
  if queryusagewithin(budget, embedding_provider, embedding_usage, embedding_called, answer_provider, answer_usage, answer_called) \= 1 then return commandfailure(operation, 6, "provider smoke usage exceeded the configured token or cost ceiling, or monetary usage was unavailable")
  return .ragcommandresult(operation, "ok", 0, "provider smoke test completed with validated public-synthetic output", records)

_validsmokeanswer: procedure = .int
  arg content = .string, expected_citation = .string, expose error = .string
  error = ""; answer = ""; citation = ""; document = .jsondocument(content)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" then do; error = "provider smoke answer is not a JSON object"; return -1; end
  root = document.root()
  if document.node_count(root) \= 3 then do; error = "provider smoke answer contains fields outside the exact schema"; return -1; end
  grounding = ""
  if document.node_string(document.member(root, "grounding"), grounding) \= 0 | grounding \= "supported" then do; error = "provider smoke answer grounding is invalid"; return -1; end
  if document.node_string(document.member(root, "answer"), answer) \= 0 | answer = "" | length(answer) > 8192 then do; error = "provider smoke answer text is invalid"; return -1; end
  citations = document.member(root, "citations")
  if document.node_type(citations) \= "array" | document.node_count(citations) \= 1 then do; error = "provider smoke answer must contain exactly one citation"; return -1; end
  if document.node_string(document.element(citations, 1), citation) \= 0 | citation \= expected_citation then do; error = "provider smoke answer citation is not the supplied public synthetic citation"; return -1; end
  return 0

_providersmokerecord: procedure = .ragresultrecord
  arg provider = .ragproviderconfig, operation = .string, result = .providerresult, dimension = .int, allowance_before = .int, allowance_after = .int
  usage = result.usage(); fields = .ragresultfield[]
  fields[1] = .ragresultfield("provider_id", "string", provider.provider_id())
  fields[2] = .ragresultfield("kind", "string", provider.kind())
  fields[3] = .ragresultfield("model", "string", provider.model())
  fields[4] = .ragresultfield("operation", "string", operation)
  fields[5] = .ragresultfield("route_class", "string", provider.route_class())
  fields[6] = .ragresultfield("privacy", "string", "public-synthetic")
  fields[7] = .ragresultfield("charging_basis", "string", provider.charging_basis())
  fields[8] = .ragresultfield("state", "string", "validated")
  fields[9] = .ragresultfield("input_tokens", "integer", usage.input_tokens())
  fields[10] = .ragresultfield("output_tokens", "integer", usage.output_tokens())
  fields[11] = .ragresultfield("attempts", "integer", usage.attempts())
  fields[12] = .ragresultfield("latency_us", "integer", result.latency_us())
  if dimension > 0 then fields[fields.0 + 1] = .ragresultfield("dimension", "integer", dimension)
  if provider.charging_basis() = "monetary-api" & usage.cost_microunits() >= 0 then fields[fields.0 + 1] = .ragresultfield("estimated_cost_microunits", "integer", usage.cost_microunits())
  if allowance_before >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_before_percent", "integer", allowance_before)
  if allowance_after >= 0 then fields[fields.0 + 1] = .ragresultfield("allowance_after_percent", "integer", allowance_after)
  return .ragresultrecord("provider-smoke", fields)

_repository: procedure = .ragcommandresult
  arg request = .ragcommandrequest, operation = .string, repository = .string
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "operation requires read access")
  allowed = "cursor limit"; error = ""
  if operation = "source.show" | operation = "review.show" | operation = "job.events" then allowed = allowed || " id"
  if commandoptions(request, allowed, error) \= 0 then return commandfailure(operation, 2, error)
  cursor = commandoption(request, "cursor", error); limit_text = commandoption(request, "limit", error)
  if error \= "" then return commandfailure(operation, 2, error)
  limit = 20
  if limit_text \= "" then do
    if commandunsigned(limit_text) \= 1 then return commandfailure(operation, 2, "--limit must be a positive integer")
    limit = limit_text as .int
  end
  if limit < 1 | limit > 100 then return commandfailure(operation, 2, "--limit must be from 1 through 100")
  id = commandoption(request, "id", error)
  option_id = id
  if error \= "" then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if id = "" & positionals.0 = 1 then id = positionals[1]
  if positionals.0 > 1 | (positionals.0 = 1 & option_id \= "") then return commandfailure(operation, 2, "operation accepts at most one id")
  read_snapshot = .ragreadsnapshot
  if beginreadsnapshot(request.library(), read_snapshot, error) \= 0 then return commandopenfailure(operation, error)
  page = .ragrepositorypage
  lookup_id = ""; result_filter = id
  if operation = "source.show" | operation = "review.show" then do; lookup_id = id; result_filter = ""; end
  page_status = pagerepository(read_snapshot, repository, cursor, limit, page, error, lookup_id)
  metadata_rows = .string[]
  if page_status = 0 & repository = "sources" then do
    source_rows = page.records()
    do i = 1 to source_rows.0
      metadata_rows[i] = sourcemetadata(read_snapshot.database(),source_rows[i].related_identity(),0,2147483647,read_snapshot.generation())
    end
  end
  close_error = ""; close_status = closereadsnapshot(read_snapshot, close_error)
  if page_status \= 0 | close_status \= 0 then do
    if error = "" then error = close_error
    return commandfailure(operation, 7, error)
  end
  records = repositoryresultrecords(page,metadata_rows,result_filter,limit)
  if id \= "" & records.0 = 0 then return commandfailure(operation, 5, "requested record was not found")
  return .ragcommandresult(operation, "ok", 0, "bounded repository page read without mutation", records)

_jobcontrol: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "job control requires control access")
  if commandoptions(request, "id reason", error) \= 0 then return commandfailure(operation, 2, error)
  job_id = commandid(request, error)
  if error \= "" | job_id = "" then return commandfailure(operation, 2, "job control requires one job id")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  status = 0
  if operation = "job.pause" then status = pausejob(store, job_id, error)
  if operation = "job.resume" then status = resumejob(store, job_id, error)
  if operation = "job.cancel" then do
    reason = commandoption(request, "reason", error); if reason = "" then reason = "operator-request"
    status = requestcancel(store, job_id, reason, error)
  end
  running = 0
  if operation = "worker.drain" then status = drainjob(store, job_id, running, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("job_id", "string", job_id)
  fields[2] = .ragresultfield("operation", "string", operation)
  if operation = "worker.drain" then fields[3] = .ragresultfield("running", "integer", running)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-control", fields)
  return .ragcommandresult(operation, "ok", 0, "job control applied through the durable fenced store", records)

_joblimits: procedure = .ragcommandresult
  arg request=.ragcommandrequest
  operation=request.operation();error=""
  if commandhasaccess(request,"control")<>1 then return commandfailure(operation,4,"job controls require control access")
  allowed="id until";if operation="job.reset-retries" then allowed="id all"
  if commandworkeroptions(request,allowed,"all",error)<>0 then return commandfailure(operation,2,error)
  all_jobs=commandoption(request,"all",error);job_id=""
  if all_jobs="true" then do
    positionals=request.positionals()
    if positionals.0>0 | commandoption(request,"id",error)<>"" then return commandfailure(operation,2,"choose one job id or --all")
  end
  else do
    job_id=commandid(request,error)
    if job_id="" | error<>"" then return commandfailure(operation,2,"supply one job id or use job reset-retries --all")
  end
  store=.ragstorehandle
  if openragstore(request.library(),"readwrite",store,error)<>0 then return commandopenfailure(operation,error)
  jobs=0;items=0;deadline=0;changed=0
  if operation="job.deadline" then status=setbacklogdeadline(store,job_id,commandoption(request,"until",error),deadline,changed,error)
  else status=resetjobretries(store,job_id,jobs,items,error)
  close_error="";close_status=closeragstore(store,close_error)
  if status<>0 | close_status<>0 then do
    code=6;if status=-2 then code=2;if status=-4 then code=5
    if error="" then error=close_error
    return commandfailure(operation,code,error)
  end
  fields=.ragresultfield[];fields[1]=.ragresultfield("job_id","string",job_id);fields[2]=.ragresultfield("provider_calls","integer",0)
  message="retry counts reset; attempt history and usage retained; use retry/continue for outstanding work"
  if operation="job.deadline" then do
    fields[3]=.ragresultfield("deadline_epoch","integer",deadline);fields[4]=.ragresultfield("changed","integer",changed)
    message="deadline updated; other limits and job state unchanged; continue a stopped job normally"
  end
  else do
    fields[3]=.ragresultfield("jobs_reset","integer",jobs);fields[4]=.ragresultfield("items_reset","integer",items)
  end
  records=.ragresultrecord[];records[1]=.ragresultrecord("job-control",fields)
  return .ragcommandresult(operation,"ok",0,message,records)

_jobretry: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "job retry requires control access")
  if commandoptions(request, "id item reason", error) \= 0 then return commandfailure(operation, 2, error)
  job_id = commandid(request, error); item_id = commandoption(request, "item", error); reason = commandoption(request, "reason", error)
  if reason = "" then reason = "operator-corrected"
  if error \= "" | job_id = "" | item_id = "" then return commandfailure(operation, 2, "job retry requires one job id and --item")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  retried = 0; status = retrydeadletter(store, job_id, item_id, reason, retried, error)
  detail = retryrequestjson(store.database(),"",item_id)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  fields = _retryfields(detail,retried)
  fields[fields.0+1] = .ragresultfield("job_id", "string", job_id)
  fields[fields.0+1] = .ragresultfield("item_id", "string", item_id)
  fields[fields.0+1] = .ragresultfield("items_retried", "integer", retried)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-retry", fields)
  return .ragcommandresult(operation, "ok", 0, "durable retry request accepted; inspect disposition for execution eligibility", records)

_workflowreconcile: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation=request.operation(); error=""
  if commandhasaccess(request,"plan")<>1 then return commandfailure(operation,4,"workflow census requires plan access")
  if commandworkeroptions(request,"id apply expect-generation","apply",error)<>0 then return commandfailure(operation,2,error)
  id=commandid(request,error); apply_text=commandoption(request,"apply",error); expected_text=commandoption(request,"expect-generation",error)
  if error<>"" | id="" | (apply_text<>"" & apply_text<>"true" & apply_text<>"false") then return commandfailure(operation,2,"maintain reconcile requires one workflow id and an optional --apply flag")
  apply=apply_text="true"; expected=0
  if apply=1 & commandhasaccess(request,"curate")<>1 then return commandfailure(operation,4,"workflow census apply requires curate access")
  if apply=1 then do
    if commandunsigned(expected_text)<>1 | length(expected_text)>9 then return commandfailure(operation,2,"workflow census apply requires --expect-generation from its preview")
    expected=expected_text as .int
  end
  else if expected_text<>"" then return commandfailure(operation,2,"--expect-generation belongs to workflow census apply")
  access="readonly"; if apply=1 then access="readwrite"
  store=.ragstorehandle
  if openragstore(request.library(),access,store,error)<>0 then return commandopenfailure(operation,error)
  detail=""; status=reconcileworkflow(store,id,apply,expected,detail,error)
  close_error=""; closed=closeragstore(store,close_error)
  if status<>0 then return commandfailure(operation,3,error)
  if closed<>0 then return commandfailure(operation,7,close_error)
  document=.jsondocument(detail); fields=.ragresultfield[]
  names="workflow_id parent_concept_id workflow_state action retirement_task_id"
  do i=1 to words(names)
    name=word(names,i); value=""; ignored=document.node_string(document.member(document.root(),name),value)
    fields[fields.0+1]=.ragresultfield(name,"string",value)
  end
  names="generation remaining_impact owned_items pending_reviews uncertain_outcomes provider_calls"
  do i=1 to words(names)
    name=word(names,i); value=0; ignored=document.node_int(document.member(document.root(),name),value)
    fields[fields.0+1]=.ragresultfield(name,"integer",value)
  end
  fields[fields.0+1]=.ragresultfield("applied","boolean",commandboolean(apply))
  records=.ragresultrecord[]; records[1]=.ragresultrecord("workflow-census",fields)
  return .ragcommandresult(operation,"ok",0,"targeted workflow census; retirement remains a reviewed resolution",records)

_taskwaive: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation=request.operation();error=""
  if commandhasaccess(request,"control")<>1 then return commandfailure(operation,4,"task waiver requires control access")
  if commandoptions(request,"id reason",error)<>0 then return commandfailure(operation,2,error)
  id=commandid(request,error); reason=commandoption(request,"reason",error)
  if error<>"" | id="" | strip(reason)="" then return commandfailure(operation,2,"maintain waive requires one task id and an explicit --reason")
  store=.ragstorehandle
  if openragstore(request.library(),"readwrite",store,error)<>0 then return commandopenfailure(operation,error)
  waiver="";status=waivebacklogtask(store,id,reason,waiver,error)
  close_error="";closed=closeragstore(store,close_error)
  if status<>0 then return commandfailure(operation,3,error)
  if closed<>0 then return commandfailure(operation,7,close_error)
  fields=.ragresultfield[];fields[1]=.ragresultfield("task_id","string",id);fields[2]=.ragresultfield("waiver_id","string",waiver)
  fields[3]=.ragresultfield("operator_disposition","string","waived");fields[4]=.ragresultfield("provider_calls","integer",0)
  records=.ragresultrecord[];records[1]=.ragresultrecord("task-waiver",fields)
  return .ragcommandresult(operation,"ok",0,"task waived with retained history; missing coverage remains missing; maintain retry reopens under existing limits",records)

_taskreset: procedure = .ragcommandresult
  arg request=.ragcommandrequest,registry=.ragregistry
  operation=request.operation();error=""
  if commandhasaccess(request,"control")<>1 then return commandfailure(operation,4,"task reset requires control access")
  if commandworkeroptions(request,"id all","all",error)<>0 then return commandfailure(operation,2,error)
  id="";all_tasks=commandoption(request,"all",error)
  if all_tasks="true" then do
    positionals=request.positionals()
    if positionals.0>0 | commandoption(request,"id",error)<>"" then return commandfailure(operation,2,"choose one task id or --all")
  end
  else do
    id=commandid(request,error)
    if id="" | error<>"" then return commandfailure(operation,2,"supply one task id or use maintain reset --all")
  end
  config_lookup=registry.config(request.config_id());profile_lookup=registry.profile(request.profile_id())
  if config_lookup.found()<>1 | profile_lookup.found()<>1 then return commandfailure(operation,5,"configuration or profile is unavailable")
  store=.ragstorehandle
  if openragstore(request.library(),"readwrite",store,error)<>0 then return commandopenfailure(operation,error)
  successor="";changed=0;skipped=0
  status=resetbacklogtasks(store,config_lookup.config(),profile_lookup.profile(),id,successor,changed,skipped,error)
  close_error="";closed=closeragstore(store,close_error)
  if status<>0 then return commandfailure(operation,3,error)
  if closed<>0 then return commandfailure(operation,7,close_error)
  fields=.ragresultfield[]
  fields[1]=.ragresultfield("source_task_id","string",id);fields[2]=.ragresultfield("task_id","string",successor)
  fields[3]=.ragresultfield("tasks_reset","integer",changed);fields[4]=.ragresultfield("running_tasks_skipped","integer",skipped)
  fields[5]=.ragresultfield("provider_calls","integer",0)
  records=.ragresultrecord[];records[1]=.ragresultrecord("task-reset",fields)
  message="tasks reset with current evidence and policy; retries cleared; resolve the returned task or run maintenance"
  if skipped>0 then message=message || "; running tasks skipped: drain their jobs, then repeat maintain reset --all"
  return .ragcommandresult(operation,"ok",0,message,records)

_taskqueue: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request,"read")<>1 then return commandfailure(operation,4,"maintenance queue inspection requires read access")
  if commandoptions(request,"job source cursor limit",error)<>0 then return commandfailure(operation,2,error)
  positionals = request.positionals(); if positionals.0<>0 then return commandfailure(operation,2,"queue inspection accepts options only")
  job_id = commandoption(request,"job",error); source_id = commandoption(request,"source",error)
  cursor = commandoption(request,"cursor",error); limit_text = commandoption(request,"limit",error)
  if cursor="" then cursor="0"
  if limit_text="" then limit_text="20"
  if commandunsigned(cursor)<>1 | length(cursor)>9 | commandunsigned(limit_text)<>1 | length(limit_text)>2 then return commandfailure(operation,2,"queue cursor and limit must be bounded integers")
  offset = cursor as .int; limit = limit_text as .int
  if limit<1 | limit>98 | length(source_id)>512 | (job_id<>"" & source_id<>"") then return commandfailure(operation,2,"limit must be 1..98; choose a frozen job or a current source scope")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found()<>1 | profile_lookup.found()<>1 then return commandfailure(operation,5,"configuration or profile is unavailable")
  store = .ragstorehandle
  if openragstore(request.library(),"readonly",store,error)<>0 then return commandopenfailure(operation,error)
  policy_json = backlogpolicy(config_lookup.config(),profile_lookup.profile(),"","",0,source_id)
  if job_id<>"" then policy_json = sqlreadtext(store.database(),"SELECT policy_json FROM maintenance_windows WHERE job_id=" || sqlquote(job_id))
  detail = ""; if policy_json<>"" then detail = backlogselection(store.database(),.jsondocument(policy_json),offset,limit,job_id)
  close_error = ""; closed = closeragstore(store,close_error)
  if detail="" then return commandfailure(operation,5,"maintenance policy or job selection is unavailable")
  if closed<>0 then return commandfailure(operation,7,close_error)
  fields = .ragresultfield[]; fields[1]=.ragresultfield("detail","string",detail); fields[2]=.ragresultfield("provider_calls","integer",0)
  records = .ragresultrecord[]; records[1]=.ragresultrecord("maintenance-selection",fields)
  return .ragcommandresult(operation,"ok",0,"prioritised maintenance selection and exclusions; eligibility is rechecked when dispatched",records)

_taskdefer: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request,"control") <> 1 then return commandfailure(operation,4,"task deferral requires control access")
  if commandoptions(request,"id until months reason",error) <> 0 then return commandfailure(operation,2,error)
  id = commandid(request,error); until_text = commandoption(request,"until",error); months = commandoption(request,"months",error); reason = commandoption(request,"reason",error)
  if error<>"" | id="" then return commandfailure(operation,2,"maintain defer requires one task id")
  store = .ragstorehandle
  if openragstore(request.library(),"readwrite",store,error)<>0 then return commandopenfailure(operation,error)
  until_epoch = 0; status = deferbacklogtask(store,id,until_text,months,reason,until_epoch,error)
  close_error = ""; closed = closeragstore(store,close_error)
  if status<>0 then return commandfailure(operation,3,error)
  if closed<>0 then return commandfailure(operation,7,close_error)
  fields = .ragresultfield[]; fields[1]=.ragresultfield("task_id","string",id); fields[2]=.ragresultfield("not_before_epoch","integer",until_epoch); fields[3]=.ragresultfield("reason","string",reason); fields[4]=.ragresultfield("provider_calls","integer",0)
  records = .ragresultrecord[]; records[1]=.ragresultrecord("task-deferral",fields)
  return .ragcommandresult(operation,"ok",0,"task deferred until the recorded date; a later maintenance run reconsiders it",records)

_taskretry: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request,"control") \= 1 then return commandfailure(operation,4,"task retry requires control access")
  if commandoptions(request,"id reason",error) \= 0 then return commandfailure(operation,2,error)
  task_id = commandid(request,error); reason = commandoption(request,"reason",error)
  if reason = "" then reason = "operator-corrected"
  if error \= "" | task_id = "" then return commandfailure(operation,2,"maintain retry requires one task id")
  store = .ragstorehandle
  if openragstore(request.library(),"readwrite",store,error) \= 0 then return commandopenfailure(operation,error)
  accepted = 0; status = requestbacklogretry(store,task_id,reason,accepted,error)
  detail = retryrequestjson(store.database(),task_id,"")
  close_error = ""; close_status = closeragstore(store,close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation,1,error); end
  fields = _retryfields(detail,accepted)
  fields[fields.0+1] = .ragresultfield("task_id","string",task_id)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("task-retry",fields)
  return .ragcommandresult(operation,"ok",0,"durable retry request accepted; execution retains its policy and window controls",records)

_retryfields: procedure = .ragresultfield[]
  arg detail = .string, accepted = .int
  fields = .ragresultfield[]; document = .jsondocument(detail)
  names = "retry_request_id retry_state retry_disposition"
  do i = 1 to words(names)
    name = word(names,i); value = ""
    ignored = document.node_string(document.member(document.root(),name),value)
    fields[fields.0+1] = .ragresultfield(name,"string",value)
  end
  fields[fields.0+1] = .ragresultfield("retry_accepted","integer",accepted)
  return fields

_jobreplay: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "job replay requires control access")
  if commandoptions(request, "id item reason", error) \= 0 then return commandfailure(operation, 2, error)
  source_job_id = commandid(request, error); source_item_id = commandoption(request, "item", error); reason = commandoption(request, "reason", error)
  if reason = "" then reason = "operator-reviewed-replay"
  if error \= "" | source_job_id = "" then return commandfailure(operation, 2, "job replay requires one source job id and accepts optional --item and --reason")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  config = config_lookup.config(); budget = config.budget()
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  if querysnapshotmatches(store, config, profile_lookup.profile()) \= 1 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 6, "replay configuration and profile do not match the current library configuration snapshot"); end
  target_snapshot_id = currentconfigsnapshotid(store.database(), error)
  replay_job_id = ""; replayed = 0
  status = replaydeadletters(store, source_job_id, source_item_id, target_snapshot_id, reason, budget.item_limit(), budget.model_calls(), budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), budget.codex_turns(), _replaybudget(config), replay_job_id, replayed, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 6, error); end
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("source_job_id", "string", source_job_id)
  if source_item_id = "" then fields[2] = .ragresultfield("source_item_id", "null", "")
  else fields[2] = .ragresultfield("source_item_id", "string", source_item_id)
  fields[3] = .ragresultfield("replay_job_id", "string", replay_job_id)
  fields[4] = .ragresultfield("target_config_snapshot_id", "string", target_snapshot_id)
  fields[5] = .ragresultfield("items_replayed", "integer", replayed)
  fields[6] = .ragresultfield("source_items_changed", "integer", 0)
  fields[7] = .ragresultfield("provider_calls", "integer", 0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-replay", fields)
  return .ragcommandresult(operation, "ok", 0, "dead letters copied into a new budgeted job with immutable source lineage", records)

_jobreconcile: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandworkeroptions(request,"id item apply expect-digest","apply",error) \= 0 then return commandfailure(operation,2,error)
  job_id = commandid(request,error); item_id = commandoption(request,"item",error); apply_text = commandoption(request,"apply",error); digest = commandoption(request,"expect-digest",error)
  apply = apply_text = "true"
  if error \= "" | job_id = "" | item_id = "" then return commandfailure(operation,2,"job reconcile requires a job id and --item; inspect first, then --apply --expect-digest")
  capability = "diagnose"; mode = "readonly"
  if apply then do; capability = "control"; mode = "readwrite"; end
  if commandhasaccess(request,capability) \= 1 then return commandfailure(operation,4,"job reconciliation requires " || capability || " access")
  if apply & length(digest) \= 64 then return commandfailure(operation,2,"apply requires the inspected --expect-digest")
  if apply = 0 & digest \= "" then return commandfailure(operation,2,"--expect-digest requires --apply")
  lookup = registry.config(request.config_id()); profile = registry.profile(request.profile_id())
  if lookup.found() \= 1 | profile.found() \= 1 then return commandfailure(operation,5,"configuration or profile is not registered")
  store = .ragstorehandle
  if openragstore(request.library(),mode,store,error) \= 0 then return commandopenfailure(operation,error)
  tracer = .ragtracer(request.progress(),request.format()); provider = .ragapplicationprovider(store,lookup.config(),profile.profile(),tracer)
  plan = ""; status = provider.reconcile(job_id,item_id,apply,digest,plan,error)
  call provider.close()
  ignored = ""; call closeragstore store,ignored
  if status \= 0 then return commandfailure(operation,6,error)
  observed = .jsondocument(plan)
  observed_digest = ""; observed_state = ""
  ignored = observed.node_string(observed.member(observed.root(),"digest"),observed_digest)
  ignored = observed.node_string(observed.member(observed.root(),"state"),observed_state)
  fields = .ragresultfield[]; fields[1] = .ragresultfield("observation_json","string",plan); fields[2] = .ragresultfield("apply_requested","integer",apply)
  fields[3] = .ragresultfield("digest","string",observed_digest)
  fields[4] = .ragresultfield("state","string",observed_state)
  fields[5] = .ragresultfield("provider_calls","integer",0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("job-reconciliation",fields)
  return .ragcommandresult(operation,"ok",0,"exact Codex outcome inspected; no generation call or corpus publication",records)

_workerstart: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "worker start requires control access")
  is_job=operation="job.run" | operation="job.continue"
  allowed = "count poll-ms max-polls max-items job"
  if is_job then allowed = "count poll-ms max-polls max-items id"
  if operation="job.continue" then allowed=allowed || " renew minutes prepare"
  if commandworkeroptions(request, allowed, "prepare", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if is_job=0 & positionals.0 \= 0 then return commandfailure(operation, 2, "worker start accepts no positional arguments")
  if request.config_id() = "" | request.profile_id() = "" then return commandfailure(operation, 2, "worker start requires --config and --profile")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  configured_count = config_lookup.config().workers().processes(); count = configured_count
  count_text = commandoption(request, "count", error); poll_text = commandoption(request, "poll-ms", error); maximum_text = commandoption(request, "max-polls", error); items_text = commandoption(request, "max-items", error); job_filter = commandoption(request, "job", error)
  if is_job then do
    job_filter = commandid(request,error)
    if error \= "" | job_filter = "" then return commandfailure(operation,2,"job run requires one job id")
  end
  if count_text \= "" then do
    if commandunsigned(count_text) \= 1 then return commandfailure(operation, 2, "--count must be an integer")
    count = count_text as .int
  end
  poll_milliseconds = config_lookup.config().workers().poll_ms()
  if poll_text \= "" then do
    if commandunsigned(poll_text) \= 1 then return commandfailure(operation, 2, "--poll-ms must be an integer")
    poll_milliseconds = poll_text as .int
  end
  maximum_polls = 0; maximum_items = 0
  if maximum_text \= "" then do
    if commandunsigned(maximum_text) \= 1 then return commandfailure(operation, 2, "--max-polls must be an integer")
    maximum_polls = maximum_text as .int
  end
  if items_text \= "" then do
    if commandunsigned(items_text) \= 1 then return commandfailure(operation, 2, "--max-items must be an integer")
    maximum_items = items_text as .int
  end
  if count < 1 | count > configured_count | poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 | maximum_items < 0 | maximum_items > 1000000 then return commandfailure(operation, 2, "worker start count must be within the configured process ceiling; poll-ms must be 10..60000 and max-polls/max-items 0..1000000")
  period=commandoption(request,"renew",error);minutes_text=commandoption(request,"minutes",error);prepare=commandoption(request,"prepare",error)
  minutes=0
  if period<>"" then if length(period)>128 | pos("00"x,period)>0 then return commandfailure(operation,2,"renewal period must be 1 through 128 characters without NUL")
  if minutes_text<>"" then do
    if commandunsigned(minutes_text)<>1 | length(minutes_text)>5 | period="" then return commandfailure(operation,2,"--minutes requires --renew PERIOD and an integer from 1 through 10080")
    minutes=minutes_text as .int
    if minutes<1 | minutes>10080 then return commandfailure(operation,2,"maintenance continuation minutes must be 1 through 10080")
  end
  preflight_store = .ragstorehandle
  preflight_mode = "readonly"; if is_job then preflight_mode = "readwrite"
  if openragstore(request.library(),preflight_mode,preflight_store,error) \= 0 then return commandopenfailure(operation,error)
  preflight = checkworkerconfiguration(preflight_store,job_filter,config_lookup.config(),profile_lookup.profile(),error)
  if preflight = 0 & is_job then do
    /* Preparation has no launch: retain its refusal of active ownership
     * without draining the running group or changing its authorization. */
    if prepare \= "true" then preflight = cleanupjobprocesses(preflight_store,job_filter,config_lookup.config().workers().lease_seconds(),error)
    if preflight = 0 then do
      if sqlreadint(preflight_store.database(),"SELECT count(*) FROM runtime_instances WHERE (job_filter='' OR job_filter=" || sqlquote(job_filter) || ") AND state NOT IN('stopped','failed')") \= 0 then do; preflight = -1; error = "job already has process ownership; use worker status and worker drain"; end
      else do
        if operation="job.continue" then preflight=preparecontinuation(preflight_store,job_filter,period,minutes,config_lookup.config(),profile_lookup.profile(),error)
        else do
          state = sqlreadtext(preflight_store.database(),"SELECT state FROM jobs WHERE job_id=" || sqlquote(job_filter))
          if state = "paused" then preflight = resumejob(preflight_store,job_filter,error)
          else if wordpos(state,"queued running completed completed_with_errors") = 0 then do; preflight = -1; error = "job is " || state || "; use job retry for unfinished items"; end
        end
      end
    end
  end
  ignored = ""; call closeragstore preflight_store,ignored
  if preflight \= 0 then return commandfailure(operation,6,error)
  if prepare="true" then do
    fields=.ragresultfield[];fields[1]=.ragresultfield("job_id","string",job_filter);fields[2]=.ragresultfield("period","string",period);fields[3]=.ragresultfield("provider_calls","integer",0)
    records=.ragresultrecord[];records[1]=.ragresultrecord("job-continuation",fields)
    return .ragcommandresult(operation,"ok",0,"existing job prepared; job run starts its configured workers; holds and history retained",records)
  end
  started = .ragprocessstartresult
  tracer = .ragtracer(request.progress(), request.format()); call tracer.emit("controller", "start", "", "workers=" || count)
  status = startworkerprocesses(request.library(), count, poll_milliseconds, maximum_polls, job_filter, request.config_id(), request.profile_id(), request.config_file(), request.progress(), request.format(), started, error, maximum_items, config_lookup.config().workers().max_restarts(), config_lookup.config().workers().restart_backoff_ms(), config_lookup.config().workers().restart_window_seconds())
  worker_error = error
  vector_generations = 0; vector_state = "not-requested"
  if job_filter \= "" then do
    if _publishjobvectors(request.library(), config_lookup.config(), vector_generations, vector_state, error) \= 0 then return commandfailure(operation, 8, worker_error || "; vector index activation failed: " || error || "; retry job run " || job_filter)
    if vector_state \= "not-applicable" then call tracer.emit("vector", vector_state, job_filter, "generations=" || vector_generations)
  end
  call tracer.emit("controller", "complete", started.controller_id(), "workers=" || started.completed())
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("controller_id", "string", started.controller_id())
  fields[2] = .ragresultfield("workers_requested", "integer", started.requested())
  fields[3] = .ragresultfield("workers_completed", "integer", started.completed())
  fields[4] = .ragresultfield("workers_failed", "integer", started.failed())
  if vector_state \= "not-applicable" then do
    fields[5] = .ragresultfield("vector_generations", "integer", vector_generations)
    fields[6] = .ragresultfield("vector_state", "string", vector_state)
  end
  fields[fields.0 + 1] = .ragresultfield("workers_restarted", "integer", started.restarted())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-controller", fields)
  if status \= 0 then return .ragcommandresult(operation,"error",8,worker_error || "; vector index: " || vector_state || "; retry job run " || job_filter,records)
  return .ragcommandresult(operation, "ok", 0, "controller supervised the requested OS-process workers to completion", records)

_workerrun: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "worker run requires control access")
  if commandworkeroptions(request, "id parent host-id once follow poll-ms max-polls max-items job", "once follow", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 then return commandfailure(operation, 2, "worker run accepts no positional arguments")
  if request.config_id() = "" | request.profile_id() = "" then return commandfailure(operation, 2, "worker run requires --config and --profile")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  once = commandoption(request, "once", error); follow = commandoption(request, "follow", error)
  if (once = "") = (follow = "") then return commandfailure(operation, 2, "worker run requires exactly one of --once or --follow")
  mode = "once"; if follow \= "" then mode = "follow"
  instance_id = commandoption(request, "id", error); parent_id = commandoption(request, "parent", error); host_id = commandoption(request, "host-id", error); job_filter = commandoption(request, "job", error)
  poll_text = commandoption(request, "poll-ms", error); maximum_text = commandoption(request, "max-polls", error); items_text = commandoption(request, "max-items", error)
  poll_milliseconds = config_lookup.config().workers().poll_ms(); maximum_polls = 0; maximum_items = 0
  if poll_text \= "" then do
    if commandunsigned(poll_text) \= 1 then return commandfailure(operation, 2, "--poll-ms must be an integer")
    poll_milliseconds = poll_text as .int
  end
  if maximum_text \= "" then do
    if commandunsigned(maximum_text) \= 1 then return commandfailure(operation, 2, "--max-polls must be an integer")
    maximum_polls = maximum_text as .int
  end
  if items_text \= "" then do
    if commandunsigned(items_text) \= 1 then return commandfailure(operation, 2, "--max-items must be an integer")
    maximum_items = items_text as .int
  end
  if poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 | maximum_items < 0 | maximum_items > 1000000 then return commandfailure(operation, 2, "worker run requires poll-ms 10..60000 and max-polls/max-items 0..1000000")
  final_id = ""; processed = 0
  if runapplicationworker(request.library(), instance_id, parent_id, host_id, mode, job_filter, poll_milliseconds, maximum_polls, config_lookup.config(), profile_lookup.profile(), request.progress(), request.format(), final_id, processed, error, maximum_items) \= 0 then return commandfailure(operation, 1, error)
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("worker_id", "string", final_id)
  fields[2] = .ragresultfield("mode", "string", mode)
  fields[3] = .ragresultfield("job_filter", "string", job_filter)
  fields[4] = .ragresultfield("processor", "string", "application-ingestion-v1")
  fields[5] = .ragresultfield("items_processed", "integer", processed)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-run", fields)
  return .ragcommandresult(operation, "ok", 0, "worker process lifecycle completed through the configured ingestion processor", records)

_workerread: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "worker inspection requires read access")
  if commandworkeroptions(request, "id kind state local host-id stale-seconds limit", "local", error) \= 0 then return commandfailure(operation, 2, error)
  id = commandid(request, error)
  if error \= "" then return commandfailure(operation, 2, error)
  if operation = "worker.status" & id = "" then return commandfailure(operation, 2, "worker status requires one process id")
  kind_filter = commandoption(request, "kind", error); if kind_filter = "" then kind_filter = "all"
  if kind_filter \= "all" & kind_filter \= "controller" & kind_filter \= "worker" then return commandfailure(operation, 2, "--kind must be all, controller, or worker")
  requested_state_filter = commandoption(request, "state", error)
  state_filter = requested_state_filter
  if requested_state_filter = "stale" then state_filter = ""
  host_filter = commandoption(request, "host-id", error)
  local = commandoption(request, "local", error)
  if local \= "" then do
    if host_filter \= "" then return commandfailure(operation, 2, "--local and --host-id are mutually exclusive")
    host_filter = currenthostid()
  end
  stale_seconds = 15; limit = 100
  stale_text = commandoption(request, "stale-seconds", error); limit_text = commandoption(request, "limit", error)
  if stale_text \= "" then do
    if commandunsigned(stale_text) \= 1 then return commandfailure(operation, 2, "--stale-seconds must be an integer")
    stale_seconds = stale_text as .int
  end
  if limit_text \= "" then do
    if commandunsigned(limit_text) \= 1 then return commandfailure(operation, 2, "--limit must be an integer")
    limit = limit_text as .int
  end
  if stale_seconds < 1 | stale_seconds > 86400 | limit < 1 | limit > 100 then return commandfailure(operation, 2, "worker list requires stale-seconds 1..86400 and limit 1..100")
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
  processes = .ragprocessrecord[]; read_status = listprocesses(store, kind_filter, state_filter, host_filter, stale_seconds, limit, processes, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if read_status < 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 7, error); end
  records = .ragresultrecord[]; local_host = currenthostid()
  do i = 1 to processes.0
    process = processes[i]
    if id \= "" & process.instance_id() \= id then iterate
    if requested_state_filter = "stale" & process.classification() \= "stale" then iterate
    pid_check = "remote"
    if process.host_id() = local_host then do
      pid_check = "not-running"
      if process.state() \= "stopped" & process.state() \= "failed" then do
        pid_check = processpresence(process.pid(),process.host_id())
      end
    end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("instance_id", "string", process.instance_id())
    fields[2] = .ragresultfield("kind", "string", process.kind())
    fields[3] = .ragresultfield("parent_instance_id", "string", process.parent_instance_id())
    fields[4] = .ragresultfield("host_id", "string", process.host_id())
    fields[5] = .ragresultfield("pid", "integer", process.pid())
    fields[6] = .ragresultfield("process_start_token", "string", process.process_start_token())
    fields[7] = .ragresultfield("mode", "string", process.mode())
    fields[8] = .ragresultfield("job_filter", "string", process.job_filter())
    fields[9] = .ragresultfield("state", "string", process.state())
    fields[10] = .ragresultfield("classification", "string", process.classification())
    fields[11] = .ragresultfield("requested_state", "string", process.requested_state())
    fields[12] = .ragresultfield("current_item_id", "string", process.current_item_id())
    fields[13] = .ragresultfield("heartbeat_age_seconds", "integer", process.heartbeat_age())
    fields[14] = .ragresultfield("pid_check", "string", pid_check)
    fields[15] = .ragresultfield("detail", "string", process.detail())
    records[records.0 + 1] = .ragresultrecord("runtime-process", fields)
  end
  if id \= "" & records.0 = 0 then return commandfailure(operation, 5, "runtime process was not found")
  return .ragcommandresult(operation, "ok", 0, "bounded runtime registry read; heartbeat classification is authoritative and PID state is diagnostic", records)

_workerdrain: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "worker drain requires control access")
  if commandworkeroptions(request, "id", "", error) \= 0 then return commandfailure(operation, 2, error)
  instance_id = commandid(request, error)
  if error \= "" | instance_id = "" then return commandfailure(operation, 2, "worker drain requires one worker id")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  status = requestprocess(store, instance_id, "drain", error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status = -2 then return commandfailure(operation, 5, error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  fields = .ragresultfield[]; fields[1] = .ragresultfield("worker_id", "string", instance_id); fields[2] = .ragresultfield("requested_state", "string", "drain")
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-control", fields)
  return .ragcommandresult(operation, "ok", 0, "durable drain request recorded", records)

_workerprune: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "control") \= 1 then return commandfailure(operation, 4, "worker prune requires control access")
  positionals = request.positionals()
  if commandworkeroptions(request, "stale-seconds", "", error) \= 0 | positionals.0 \= 0 then return commandfailure(operation, 2, "worker prune accepts only --stale-seconds")
  stale_seconds = 300; stale_text = commandoption(request, "stale-seconds", error)
  if stale_text \= "" then do
    if commandunsigned(stale_text) \= 1 then return commandfailure(operation, 2, "--stale-seconds must be an integer")
    stale_seconds = stale_text as .int
  end
  if stale_seconds < 1 | stale_seconds > 86400 then return commandfailure(operation, 2, "worker prune requires stale-seconds 1..86400")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  deleted = 0; status = pruneprocesses(store, stale_seconds, deleted, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  fields = .ragresultfield[]; fields[1] = .ragresultfield("rows_deleted", "integer", deleted); fields[2] = .ragresultfield("stale_seconds", "integer", stale_seconds)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("worker-prune", fields)
  return .ragcommandresult(operation, "ok", 0, "terminal and explicitly stale runtime rows removed", records)

_ingestplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "plan") \= 1 then return commandfailure(operation, 4, "ingest planning requires plan access")
  if commandoptions(request, "source-set metadata-input document-date", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals(); source_set_id = commandoption(request, "source-set", error)
  if positionals.0 \= 0 | source_set_id = "" | request.config_id() = "" | request.profile_id() = "" then return commandfailure(operation, 2, "ingest planning requires one --source-set plus registered --config and --profile ids")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  source_sets = config_lookup.config().source_sets(); source_index = 0
  do i = 1 to source_sets.0
    if source_sets[i].source_set_id() = source_set_id then source_index = i
  end
  if source_index = 0 then return commandfailure(operation, 5, "source set is not registered")
  observations = .ragsourceobservation[]
  if collectfolderobservations(source_sets[source_index].root(), source_set_id, source_sets[source_index].retain_raw_artifact(), source_sets[source_index].maximum_file_bytes(), "surface-plan", observations, error, source_sets[source_index].include_patterns(), source_sets[source_index].maximum_depth()) < 0 then return commandfailure(operation, 1, error)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  domain_plan = .ragingestplan; chunks = profile_lookup.profile().chunk_policy().max_characters()
  plan_status = createingestplanconfigured(store, "folder:" || source_set_id, snapshot_id, "surface-ingest-v1", "surface-parser-v1", chunks, observations, config_lookup.config(), domain_plan, error)
  metadata = ""; metadata_path = ""; document_date=""; raw_metadata=.binary
  if plan_status=0 then document_date=commandoption(request,"document-date",error)
  if plan_status = 0 then metadata_path = commandoption(request,"metadata-input",error)
  if plan_status = 0 & metadata_path \= "" then do
    metadata_bytes = 0
    if readbinaryfilebounded(metadata_path,1048576,raw_metadata,metadata_bytes,error) \= 0 then plan_status = -1
  end
  if plan_status=0 then plan_status=prepareingestmetadata(store,domain_plan,observations,raw_metadata as .string,metadata,error,1,document_date)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  action = '{"source_set":' || jsonquote(source_set_id) || ',"ingest_plan":' || jsonquote(domain_plan.canonical()) || ',"ingest_digest":' || jsonquote(domain_plan.digest()) || ',"metadata":' || jsonquote(metadata) || '}'
  foundation_plan = .ragplan
  foundation_status = createfoundationplan(request.library(), request.config_id(), request.profile_id(), "ingest.apply", action, "ingest", registry, foundation_plan, error)
  if foundation_status = -2 then return commandfailure(operation, 6, error)
  if foundation_status \= 0 then return commandfailure(operation, 7, error)
  plan_fields = .ragresultfield[]
  plan_fields[1] = .ragresultfield("schema_version", "string", foundation_plan.schema_version()); plan_fields[2] = .ragresultfield("operation", "string", foundation_plan.operation()); plan_fields[3] = .ragresultfield("canonical_plan", "string", foundation_plan.payload()); plan_fields[4] = .ragresultfield("digest", "string", foundation_plan.digest()); plan_fields[5] = .ragresultfield("expires_at_epoch", "integer", foundation_plan.expires_at()); plan_fields[6] = .ragresultfield("required_capability", "string", "ingest"); plan_fields[7] = .ragresultfield("state", "string", "created"); plan_fields[8] = .ragresultfield("enqueued", "boolean", "false")
  preview_fields = .ragresultfield[]; preview_fields[1] = .ragresultfield("source_set", "string", source_set_id); preview_fields[2] = .ragresultfield("observations", "integer", observations.0); preview_fields[3] = .ragresultfield("ingest_digest", "string", domain_plan.digest())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("canonical-plan", plan_fields); records[2] = .ragresultrecord("ingest-preview", preview_fields)
  return .ragcommandresult(operation, "ok", 0, "source observations, discovery policy and glossary frozen into a canonical ingest plan without library writes", records)

_ingestapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "ingest") \= 1 then return commandfailure(operation, 4, "ingest apply requires ingest access")
  if commandoptions(request, "plan-json expect-digest", error) \= 0 then return commandfailure(operation, 2, error)
  plan_json = commandoption(request, "plan-json", error); digest = commandoption(request, "expect-digest", error)
  if error \= "" | plan_json = "" | digest = "" then return commandfailure(operation, 2, "apply requires plan JSON and reviewed digest")
  reviewed = .ragplan
  validation = validatefoundationplan(request.library(), request.config_id(), request.profile_id(), operation, plan_json, digest, registry, reviewed, error)
  if validation = -2 then return commandfailure(operation, 6, error)
  if validation \= 0 then return commandfailure(operation, 3, error)
  source_set_id = _actionstring(plan_json, "source_set", error)
  reviewed_ingest_plan = _actionstring(plan_json, "ingest_plan", error); reviewed_ingest_digest = _actionstring(plan_json, "ingest_digest", error)
  if error \= "" | reviewed_ingest_plan = "" | length(reviewed_ingest_digest) \= 64 | rxhash..sha256hex(reviewed_ingest_plan as .binary) \= reviewed_ingest_digest then return commandfailure(operation, 3, "reviewed ingest domain plan is missing or invalid")
  action_document = .jsondocument(plan_json); metadata = ""
  action_node = action_document.member(action_document.root(),"action")
  metadata_node = action_document.member(action_node,"metadata")
  if metadata_node > 0 then if action_document.node_string(metadata_node,metadata) \= 0 then return commandfailure(operation,3,"reviewed metadata must be a frozen manifest string")
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  source_sets = config_lookup.config().source_sets(); source_index = 0
  do i = 1 to source_sets.0
    if source_sets[i].source_set_id() = source_set_id then source_index = i
  end
  if source_index = 0 then return commandfailure(operation, 5, "source set is not registered")
  tracer = .ragtracer(request.progress(), request.format()); call tracer.emit("ingest", "start", source_set_id, "discovering sources")
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  captured_at = sqlreadtext(store.database(),"SELECT strftime('%Y-%m-%dT%H:%M:%fZ','now')")
  observations = .ragsourceobservation[]
  if collectfolderobservations(source_sets[source_index].root(), source_set_id, source_sets[source_index].retain_raw_artifact(), source_sets[source_index].maximum_file_bytes(), captured_at, observations, error, source_sets[source_index].include_patterns(), source_sets[source_index].maximum_depth()) < 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation, 1, error); end
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  domain_plan = .ragingestplan
  chunks = profile_lookup.profile().chunk_policy().max_characters()
  if createingestplanconfigured(store, "folder:" || source_set_id, snapshot_id, "surface-ingest-v1", "surface-parser-v1", chunks, observations, config_lookup.config(), domain_plan, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 1, error); end
  if domain_plan.canonical() \= reviewed_ingest_plan | domain_plan.digest() \= reviewed_ingest_digest then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 3, "source observations, discovery policy or glossary content no longer match the reviewed ingest plan"); end
  call tracer.emit("ingest", "waiting", source_set_id, "queueing durable work")
  result = applyingestplanconfigured(store, domain_plan, observations, config_lookup.config(), profile_lookup.profile(),metadata)
  close_error = ""; close_status = closeragstore(store, close_error)
  if result.ok() \= 1 | close_status \= 0 then do; if error = "" then error = result.error(); if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  call tracer.emit("ingest", "complete", source_set_id, "items=" || result.items_queued())
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("disposition", "string", result.disposition())
  fields[2] = .ragresultfield("generation", "integer", result.generation())
  fields[3] = .ragresultfield("sources_observed", "integer", result.sources_observed())
  fields[4] = .ragresultfield("sources_added", "integer", result.sources_added())
  fields[5] = .ragresultfield("sources_changed", "integer", result.sources_changed())
  fields[6] = .ragresultfield("sources_unchanged", "integer", result.sources_unchanged())
  fields[7] = .ragresultfield("items_queued", "integer", result.items_queued())
  fields[8] = .ragresultfield("provider_calls", "integer", result.provider_calls())
  if result.items_queued() = 0 then fields[9] = .ragresultfield("job_id", "null", "")
  else fields[9] = .ragresultfield("job_id", "string", "job-sha256:" || domain_plan.digest())
  records = .ragresultrecord[]; records[1] = .ragresultrecord("ingest-apply", fields)
  if result.disposition() = "metadata-only" then return .ragcommandresult(operation,"ok",0,"reviewed metadata published; source text, citations and vectors retained",records)
  if result.items_queued() = 0 then return .ragcommandresult(operation, "ok", 0, "source set is already current; no work or provider calls were queued", records)
  return .ragcommandresult(operation, "ok", 0, "reviewed ingest plan applied and durable work queued", records)

_publishjobvectors: procedure = .int
  arg library = .string, config = .ragconfig, expose generation_count = .int, expose state = .string, expose error = .string
  generation_count = 0; state = "not-applicable"; error = ""
  store = .ragstorehandle
  if openragstore(library, "readwrite", store, error) \= 0 then return -1
  /* The index contains committed embeddings, independent of job/worker state.
   * The embedding owner retains its snapshot and atomic publication checks. */
  if _publishconfiguredvector(store, config, generation_count, state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -1; end
  close_error = ""
  if closeragstore(store, close_error) \= 0 then do; error = close_error; return -1; end
  return 0

_publishconfiguredvector: procedure = .int
  arg store = .ragstorehandle, config = .ragconfig, expose generation_count = .int, expose state = .string, expose error = .string
  generation_count = 0; state = "not-applicable"; error = ""
  provider = roleproviderconfig(config, "embedding")
  if provider.provider_id() = "" | provider.kind() = "codex" then do; error = "configuration has no embedding-capable provider"; return -1; end
  embedding_role = rolebinding(config, "embedding"); profile_id = _embeddingprofileid(provider, embedding_role.embedding_dimensions()); current = sqlreadint(store.database(), "SELECT published_generation FROM library_meta WHERE singleton=1")
  active_chunks = sqlreadint(store.database(), "SELECT count(*) FROM revision_chunks WHERE visible_from_generation<=" || current || " AND (visible_to_generation IS NULL OR visible_to_generation>" || current || ")")
  if active_chunks = 0 then return 0
  covered = sqlreadint(store.database(), "SELECT count(DISTINCT rce.revision_chunk_id) FROM revision_chunk_embeddings rce JOIN embeddings e ON e.embedding_id=rce.embedding_id JOIN revision_chunks rc ON rc.revision_chunk_id=rce.revision_chunk_id WHERE e.embedding_profile_id=" || sqlquote(profile_id) || " AND rce.visible_from_generation<=" || current || " AND (rce.visible_to_generation IS NULL OR rce.visible_to_generation>" || current || ") AND rc.visible_from_generation<=" || current || " AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>" || current || ")")
  if covered = 0 then do; state = "pending-embeddings"; return 0; end
  vector_policy = config.vector(); generation = .ragvectorgenerationresult
  if buildannvectorgeneration(store, profile_id, vector_policy.maximum_rows(), vector_policy.centroids(), vector_policy.probes(), vector_policy.iterations(), vector_policy.maximum_sidecar_bytes(), generation, error) \= 0 then return -3
  generation_count = 1
  if generation.state() = "published" then state = "published"
  else state = "identical-no-op"
  return 0

_maintainapply: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "curate") \= 1 then return commandfailure(operation, 4, "maintain apply requires curate access")
  if commandoptions(request, "plan-json expect-digest", error) \= 0 then return commandfailure(operation, 2, error)
  plan_json = commandoption(request, "plan-json", error); digest = commandoption(request, "expect-digest", error)
  reviewed = .ragplan
  validation = validatefoundationplan(request.library(), request.config_id(), request.profile_id(), operation, plan_json, digest, registry, reviewed, error)
  if validation = -2 then return commandfailure(operation, 6, error)
  if validation \= 0 then return commandfailure(operation, 3, error)
  config_lookup = registry.config(request.config_id())
  if config_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration is not registered")
  config = config_lookup.config(); budget = config.budget(); workers = config.workers()
  provider = roleproviderconfig(config, "extractor")
  embedding_provider = roleproviderconfig(config, "embedding")
  if provider.provider_id() = "" then return commandfailure(operation, 3, "configuration has no extractor provider")
  route_id = provider.provider_id(); secret_reference = provider.credential().ref_string(); privacy = queryprivacy(config)
  store = .ragstorehandle
  if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
  reviewed_policy = ""; timing_json = ""
  if config.maintenance().mode() \= "reviewed" then do
    reviewed_policy = _actionstring(plan_json,"window_policy",error)
    timing_json = sqlreadtext(store.database(),"SELECT coalesce(json_extract(" || sqlquote(reviewed_policy) || ",'$.timing'),'')")
    if timing_json \= "" then do
      timing = .jsondocument(timing_json); timing_mode = ""; timing_request = ""; timing_start = 0
      decoded = timing.node_string(timing.member(timing.root(),"mode"),timing_mode); decoded = timing.node_string(timing.member(timing.root(),"requested"),timing_request); decoded = timing.node_int(timing.member(timing.root(),"started_epoch"),timing_start)
      time_minutes = ""; time_until = ""; time_overnight = ""; expected_timing = ""
      if timing_mode = "duration" then time_minutes = timing_request
      else if timing_mode = "until" then time_until = timing_request
      else if timing_mode = "overnight" then time_overnight = timing_request
      else do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,3,"reviewed maintenance timing mode is invalid"); end
      if timing_start < 1 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,3,"reviewed maintenance start time is invalid"); end
      timing_status = resolvemaintenancetime(store.database(),time_minutes,time_until,time_overnight,config.maintenance().window_seconds(),expected_timing,error,timing_start)
      if timing_status \= 0 | expected_timing \= timing_json then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,3,"reviewed maintenance timing is invalid or its local timezone changed"); end
      deadline = sqlreadint(store.database(),"SELECT json_extract(" || sqlquote(timing_json) || ",'$.deadline_epoch')")
      if timing_mode<>"duration" & deadline <= sqlreadint(store.database(),"SELECT unixepoch()") then do; ignored = ""; call closeragstore store,ignored; return _maintenanceskip(operation,timing_json); end
    end
  end
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  action_doc = .jsondocument(plan_json); enrichment_node = action_doc.member(action_doc.member(action_doc.root(),"action"),"enrichment_input")
  if enrichment_node > 0 then do
    enrichment_input = ""
    if action_doc.node_string(enrichment_node,enrichment_input) \= 0 then do; ignored=""; call closeragstore store,ignored; return commandfailure(operation,3,"invalid frozen enrichment input"); end
    return _enrichmentapply(request,registry,store,config,plan_json,digest,timing_json,enrichment_input,snapshot_id)
  end
  embedding_only = sqlreadint(store.database(),"SELECT coalesce(json_extract(" || sqlquote(reviewed_policy) || ",'$.embeddings_only'),0)") = 1
  source_id=sqlreadtext(store.database(),"SELECT coalesce(json_extract(" || sqlquote(reviewed_policy) || ",'$.source_id'),'')")
  plan = .ragimproveplan
  census = .ragmaintenancecensus
  plan_status = _preparemaintenance(store, config, snapshot_id, plan, census, error, embedding_only, source_id)
  reviewed_maintenance_digest = _actionstring(plan_json, "maintenance_digest", error)
  if plan_status = 0 & (reviewed_maintenance_digest = "" | reviewed_maintenance_digest \= census.digest()) then do; error = "reviewed maintenance digest does not match the current canonical census"; plan_status = -2; end
  if plan_status = 0 & config.maintenance().mode() \= "reviewed" then do
    profile_lookup = registry.profile(request.profile_id())
    if profile_lookup.found() \= 1 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation,5,"maintenance profile is unavailable"); end
    recovery_claim = .ragworkclaim
    recovery_status = claimnext(store,"","maintenance-recovery",config.workers().lease_seconds(),config.maintenance().maximum_attempts(),recovery_claim,error,0)
    if recovery_status < 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,error); end
    old_job = sqlreadtext(store.database(),"SELECT job_id FROM maintenance_windows WHERE state='active' ORDER BY created_epoch LIMIT 1")
    if old_job \= "" then if tickbacklogwindow(store,old_job,error) < 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,error); end
    policy_json = backlogpolicy(config,profile_lookup.profile(),plan.discovery_context(),timing_json,embedding_only,source_id)
    reviewed_policy = _actionstring(plan_json,"window_policy",error)
    if reviewed_policy \= policy_json then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,6,"reviewed maintenance window policy changed"); end
    run_id = ""; job_id = ""; items = 0
    plan_status = startbacklogwindow(store,census,snapshot_id,digest,policy_json,run_id,job_id,items,error)
    summary = backlogsummary(store.database(),job_id)
    close_error = ""; close_status = closeragstore(store,close_error)
    if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation,1,error); end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("job_id","string",job_id); fields[2] = .ragresultfield("run_id","string",run_id); fields[3] = .ragresultfield("work_items","integer",items); fields[4] = .ragresultfield("items","integer",items); fields[5] = .ragresultfield("disposition","string","backlog-window-created"); fields[6] = .ragresultfield("backlog","string",summary); fields[7] = .ragresultfield("provider_calls","integer",0)
    records = .ragresultrecord[]; records[1] = .ragresultrecord("maintain-apply",fields)
    return .ragcommandresult(operation,"ok",0,"durable maintenance window created within configured budgets",records)
  end
  apply_result = .ragimproveapplyresult(-1, "not-applied", "", 0, 0, 0, "maintenance plan was not applied")
  if plan_status = 0 then plan_status = applyconfiguredimproveplan(store, plan, request.profile_id(), provider.model(), provider.charging_basis(), budget.codex_turns(), apply_result, error)
  maintenance_result = .ragmaintenanceapplyresult
  if plan_status = 0 then plan_status = persistmaintenance(store, census, plan, apply_result, "reviewed", maintenance_result, error)
  repair_items = 0
  repair_planned = _maintenanceitemcount(census, "stale-embedding")
  work_call_ceiling = plan.model_call_budget() + repair_planned * embedding_provider.max_attempts(); if work_call_ceiling > budget.model_calls() then work_call_ceiling = budget.model_calls()
  job_id = ""; if plan_status = 0 then job_id = apply_result.job_id()
  if plan_status = 0 & job_id = "" & repair_planned > 0 then plan_status = ensuremaintenancejob(store, maintenance_result.run_id(), snapshot_id, work_call_ceiling, budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), job_id, error)
  embedding_inflight = workers.processes() * workers.max_in_flight(); if embedding_inflight < 1 then embedding_inflight = 1
  embedding_role = rolebinding(config, "embedding")
  embedding_input = budget.input_tokens() / embedding_inflight; if embedding_input > embedding_role.maximum_input_tokens() then embedding_input = embedding_role.maximum_input_tokens()
  embedding_cost = budget.cost_microunits() / embedding_inflight; if embedding_cost > embedding_role.maximum_call_cost_microunits() then embedding_cost = embedding_role.maximum_call_cost_microunits()
  if plan_status = 0 & job_id \= "" then plan_status = recordmaintenanceembeddingitems(store, maintenance_result.run_id(), job_id, request.profile_id(), embedding_provider.provider_id(), embedding_provider.model(), embedding_provider.charging_basis(), privacy, embedding_role.embedding_dimensions(), work_call_ceiling, embedding_input, embedding_cost, embedding_provider.timeout_ms(), repair_items, error)
  vector_generations = 0; vector_state = "not-applicable"
  if plan_status = 0 & job_id = "" then plan_status = _publishconfiguredvector(store, config, vector_generations, vector_state, error)
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  fields = .ragresultfield[]
  if job_id = "" then fields[1] = .ragresultfield("job_id", "null", "")
  else fields[1] = .ragresultfield("job_id", "string", job_id)
  fields[2] = .ragresultfield("disposition", "string", maintenance_result.disposition())
  fields[3] = .ragresultfield("items", "integer", maintenance_result.items())
  fields[4] = .ragresultfield("provider_calls", "integer", apply_result.provider_calls())
  fields[5] = .ragresultfield("secret_reference", "string", secret_reference)
  fields[6] = .ragresultfield("run_id", "string", maintenance_result.run_id())
  fields[7] = .ragresultfield("reviews_created", "integer", maintenance_result.reviews())
  fields[8] = .ragresultfield("embedding_repairs", "integer", repair_items)
  fields[9] = .ragresultfield("work_items", "integer", apply_result.items() + repair_items)
  fields[10] = .ragresultfield("vector_state", "string", vector_state)
  fields[11] = .ragresultfield("vector_generations", "integer", vector_generations)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("maintain-apply", fields)
  return .ragcommandresult(operation, "ok", 0, "reviewed maintenance census persisted and durable work queued", records)

_maintenanceskip: procedure = .ragcommandresult
  arg operation = .string, timing_json = .string
  fields = .ragresultfield[]; records = .ragresultrecord[]
  fields[1] = .ragresultfield("disposition","string","skipped")
  fields[2] = .ragresultfield("timing","string",timing_json)
  fields[3] = .ragresultfield("provider_calls","integer",0)
  fields[4] = .ragresultfield("work_items","integer",0)
  records[1] = .ragresultrecord("maintenance-skip",fields)
  return .ragcommandresult(operation,"ok",0,"maintenance skipped: outside the permitted window or deadline already passed",records)

_maintainplan: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "plan") \= 1 then return commandfailure(operation, 4, "maintenance planning requires plan access")
  if commandoptions(request, "minutes until overnight embeddings-only enrich-provenance input source", error) \= 0 then return commandfailure(operation, 2, error)
  positionals = request.positionals()
  if positionals.0 \= 0 | request.config_id() = "" | request.profile_id() = "" then return commandfailure(operation, 2, "maintenance planning requires registered --config and --profile ids and no positional arguments")
  config_lookup = registry.config(request.config_id())
  profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation, 5, "configuration or profile is not registered")
  config = config_lookup.config(); budget = config.budget(); workers = config.workers(); maintenance = config.maintenance()
  provider = roleproviderconfig(config, "extractor")
  embedding_provider = roleproviderconfig(config, "embedding")
  if provider.provider_id() = "" then return commandfailure(operation, 3, "configuration has no extractor provider")
  minutes = commandoption(request,"minutes",error); until_text = commandoption(request,"until",error); overnight = commandoption(request,"overnight",error)
  if maintenance.mode() = "reviewed" & (minutes \= "" | until_text \= "" | overnight \= "") then return commandfailure(operation,2,"maintenance timing options require automatic, supervised or manual mode")
  embedding_only = commandoption(request,"embeddings-only",error) = "true"
  if commandoption(request,"embeddings-only",error) \= "" & embedding_only = 0 then return commandfailure(operation,2,"--embeddings-only is an enabling flag")
  if embedding_only = 1 & maintenance.mode() = "reviewed" then return commandfailure(operation,2,"embedding-only maintenance requires automatic, supervised or manual mode")
  enrichment = commandoption(request,"enrich-provenance",error); enrichment_input = commandoption(request,"input",error)
  if embedding_only = 1 & enrichment = "true" then return commandfailure(operation,2,"choose embedding repair or provenance enrichment")
  if enrichment \= "" & enrichment \= "true" then return commandfailure(operation,2,"--enrich-provenance is an enabling flag")
  if (enrichment = "true") \= (enrichment_input \= "") then return commandfailure(operation,2,"provenance enrichment requires --enrich-provenance and --input FILE together")
  if enrichment = "true" & maintenance.mode() = "reviewed" then return commandfailure(operation,2,"provenance enrichment uses automatic, supervised or manual maintenance workers")
  source_id=commandoption(request,"source",error)
  if length(source_id)>512 | pos("00"x,source_id)>0 then return commandfailure(operation,2,"source must be at most 512 characters without NUL")
  if source_id<>"" & maintenance.mode()="reviewed" then return commandfailure(operation,2,"source-scoped maintenance requires automatic, supervised or manual mode")
  if source_id<>"" & enrichment="true" then return commandfailure(operation,2,"source selection applies to ordinary maintenance, not provenance enrichment")
  privacy = queryprivacy(config)
  store = .ragstorehandle
  if openragstore(request.library(), "readonly", store, error) \= 0 then return commandopenfailure(operation, error)
  if source_id<>"" then do
    if sqlreadint(store.database(),"SELECT count(*) FROM sources WHERE source_id=" || sqlquote(source_id) || " AND visible_to_generation IS NULL")<>1 then do;ignored="";call closeragstore store,ignored;return commandfailure(operation,5,"source was not found");end
  end
  timing_json = ""
  if maintenance.mode() \= "reviewed" then do
    timing_status = resolvemaintenancetime(store.database(),minutes,until_text,overnight,maintenance.window_seconds(),timing_json,error)
    if timing_status \= 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,2,error); end
    timing = .jsondocument(timing_json)
    if sqlreadint(store.database(),"SELECT json_extract(" || sqlquote(timing_json) || ",'$.skipped')") = 1 then do; ignored = ""; call closeragstore store,ignored; return _maintenanceskip(operation,timing_json); end
  end
  snapshot_id = currentconfigsnapshotid(store.database(), error)
  if enrichment = "true" then return _enrichmentplan(request,registry,store,config,profile_lookup.profile(),timing_json,enrichment_input)
  plan = .ragimproveplan
  census = .ragmaintenancecensus
  plan_status = _preparemaintenance(store, config, snapshot_id, plan, census, error, embedding_only, source_id)
  selection_json = ""
  if plan_status=0 & maintenance.mode()<>"reviewed" then selection_json = backlogselection(store.database(),.jsondocument(backlogpolicy(config,profile_lookup.profile(),plan.discovery_context(),timing_json,embedding_only,source_id)),0,min(98,maintenance.batch_items()),"")
  close_error = ""; close_status = closeragstore(store, close_error)
  if plan_status \= 0 | close_status \= 0 then do; if error = "" then error = close_error; return commandfailure(operation, 1, error); end
  foundation_plan = .ragplan
  action = '{"maintenance_digest":' || jsonquote(census.digest()) || '}'
  if maintenance.mode() \= "reviewed" then action = '{"maintenance_digest":' || jsonquote(census.digest()) || ',"window_policy":' || jsonquote(backlogpolicy(config,profile_lookup.profile(),plan.discovery_context(),timing_json,embedding_only,source_id)) || '}'
  foundation_status = createfoundationplan(request.library(), request.config_id(), request.profile_id(), "maintain.apply", action, "curate", registry, foundation_plan, error)
  if foundation_status = -2 then return commandfailure(operation, 6, error)
  if foundation_status \= 0 then return commandfailure(operation, 7, error)
  records = .ragresultrecord[]; plan_fields = .ragresultfield[]
  plan_fields[1] = .ragresultfield("schema_version", "string", foundation_plan.schema_version()); plan_fields[2] = .ragresultfield("operation", "string", foundation_plan.operation()); plan_fields[3] = .ragresultfield("canonical_plan", "string", foundation_plan.payload()); plan_fields[4] = .ragresultfield("digest", "string", foundation_plan.digest()); plan_fields[5] = .ragresultfield("expires_at_epoch", "integer", foundation_plan.expires_at()); plan_fields[6] = .ragresultfield("required_capability", "string", "curate"); plan_fields[7] = .ragresultfield("state", "string", "created"); plan_fields[8] = .ragresultfield("enqueued", "boolean", "false")
  plan_fields[9] = .ragresultfield("disposition","string","planned")
  records[1] = .ragresultrecord("canonical-plan", plan_fields); fields = .ragresultfield[]
  if embedding_only = 1 then provider = embedding_provider
  fields[1] = .ragresultfield("items_planned", "integer", census.item_count())
  plan_triggers = plan.triggers(); fields[2] = .ragresultfield("trigger_count", "integer", plan_triggers.0)
  fields[3] = .ragresultfield("provider_id", "string", provider.provider_id())
  fields[4] = .ragresultfield("provider_kind", "string", provider.kind())
  fields[5] = .ragresultfield("model", "string", provider.model())
  fields[6] = .ragresultfield("route_class", "string", provider.route_class())
  fields[7] = .ragresultfield("privacy", "string", privacy)
  fields[8] = .ragresultfield("charging_basis", "string", provider.charging_basis())
  fields[9] = .ragresultfield("maximum_calls", "integer", budget.model_calls())
  fields[10] = .ragresultfield("maximum_input_tokens", "integer", budget.input_tokens())
  fields[11] = .ragresultfield("maximum_output_tokens", "integer", budget.output_tokens())
  fields[12] = .ragresultfield("maximum_cost_microunits", "integer", budget.cost_microunits())
  fields[13] = .ragresultfield("maximum_codex_turns", "integer", budget.codex_turns())
  fields[14] = .ragresultfield("worker_processes", "integer", workers.processes())
  fields[15] = .ragresultfield("maintenance_digest", "string", census.digest())
  fields[16] = .ragresultfield("cognitive_items", "integer", plan.item_count())
  fields[17] = .ragresultfield("maintenance_plan", "string", census.canonical())
  fields[18] = .ragresultfield("embedding_profile_id", "string", census.embedding_profile_id())
  fields[19] = .ragresultfield("work_provider_calls", "integer", _maintenancecallcount(census))
  repair_count = _maintenanceitemcount(census, "stale-embedding")
  maximum_work_calls = plan.model_call_budget() + repair_count * embedding_provider.max_attempts(); if maximum_work_calls > budget.model_calls() then maximum_work_calls = budget.model_calls()
  fields[20] = .ragresultfield("maximum_work_provider_calls", "integer", maximum_work_calls)
  if maintenance.mode() \= "reviewed" then do
    fields[20] = .ragresultfield("maximum_work_provider_calls","integer",budget.model_calls())
    fields[21] = .ragresultfield("execution_mode","string",maintenance.mode())
    timing = .jsondocument(timing_json); resolved_start = 0; resolved_deadline = 0
    decoded = timing.node_int(timing.member(timing.root(),"started_epoch"),resolved_start); decoded = timing.node_int(timing.member(timing.root(),"deadline_epoch"),resolved_deadline)
    fields[22] = .ragresultfield("window_seconds","integer",resolved_deadline-resolved_start)
    fields[24] = .ragresultfield("timing","string",timing_json)
    provider_minutes = maintenance.provider_time_minutes()
    fields[25] = .ragresultfield("provider_time_minutes","integer",provider_minutes || "")
    fields[23] = .ragresultfield("scope","string","durable backlog discovery and selection at activation, within the shared window budget")
    fields[fields.0+1] = .ragresultfield("selection_deferred","boolean","true")
  end
  fields[fields.0+1] = .ragresultfield("embeddings_only","boolean",changestr("0",changestr("1",embedding_only || "","true"),"false"))
  if source_id<>"" then fields[fields.0+1]=.ragresultfield("source_id","string",source_id)
  if selection_json<>"" then fields[fields.0+1]=.ragresultfield("selection","string",selection_json)
  records[records.0 + 1] = .ragresultrecord("maintenance-preview", fields)
  if maintenance.mode()<>"reviewed" then return .ragcommandresult(operation,"ok",0,"bounded maintenance policy previewed; task selection occurs at activation",records)
  return .ragcommandresult(operation, "ok", 0, "bounded maintenance census and worklist created without library writes", records)

_preparemaintenance: procedure = .int
  arg store = .ragstorehandle, config = .ragconfig, snapshot_id = .string, expose plan = .ragimproveplan, expose census = .ragmaintenancecensus, expose error = .string, embedding_only = 0, source_id = ""
  error = ""; budget = config.budget(); workers = config.workers(); maintenance_policy = config.maintenance()
  extractor = roleproviderconfig(config, "extractor"); embedder = roleproviderconfig(config, "embedding"); extractor_role = rolebinding(config, "extractor"); embedding_role = rolebinding(config, "embedding")
  if snapshot_id = "" | budget.item_limit() < 1 | budget.item_limit() > 100000 | budget.model_calls() < 1 | (maintenance_policy.mode() = "reviewed" & budget.minutes() < 1) | extractor.provider_id() = "" | embedder.provider_id() = "" | embedder.kind() = "codex" then do; error = "maintenance requires positive item, provider-call and time budgets plus extractor and embedding providers"; return -1; end
  embedding_profile_id = _embeddingprofileid(embedder, embedding_role.embedding_dimensions())
  missing = 0
  if maintenance_policy.mode()="reviewed" then missing = _missingembeddingcount(store.database(), embedding_profile_id)
  if missing < 0 then do; error = "cannot calculate configured embedding coverage"; return -3; end
  batch_items = maintenance_policy.batch_items(); if batch_items > budget.item_limit() then batch_items = budget.item_limit()
  repair_reservation = missing; if repair_reservation > batch_items then repair_reservation = batch_items
  repair_call_budget = repair_reservation * embedder.max_attempts()
  if repair_call_budget > budget.model_calls() then do
    repair_reservation = (budget.model_calls() / embedder.max_attempts()) as .int; if repair_reservation < 1 & missing > 0 then repair_reservation = 1
    repair_call_budget = repair_reservation * embedder.max_attempts(); if repair_call_budget > budget.model_calls() then repair_call_budget = budget.model_calls()
  end
  available_cognitive_calls = budget.model_calls() - repair_call_budget
  if embedding_only = 1 | maintenance_policy.mode()<>"reviewed" then available_cognitive_calls = 0
  cognitive_limit = available_cognitive_calls
  remaining_items = batch_items - repair_reservation; if cognitive_limit > remaining_items then cognitive_limit = remaining_items
  cognitive_call_budget = cognitive_limit * extractor.max_attempts(); if cognitive_call_budget > available_cognitive_calls then cognitive_call_budget = available_cognitive_calls
  maximum_inflight = workers.processes() * workers.max_in_flight(); if maximum_inflight < 1 then maximum_inflight = 1
  maximum_call_input = budget.input_tokens() / maximum_inflight
  if maximum_call_input > extractor_role.maximum_input_tokens() then maximum_call_input = extractor_role.maximum_input_tokens()
  maximum_call_output = budget.output_tokens() / maximum_inflight; if maximum_call_output > extractor_role.maximum_output_tokens() then maximum_call_output = extractor_role.maximum_output_tokens()
  maximum_call_cost = budget.cost_microunits() / maximum_inflight; if maximum_call_cost > extractor_role.maximum_call_cost_microunits() then maximum_call_cost = extractor_role.maximum_call_cost_microunits()
  maximum_call_time = extractor.timeout_ms(); total_time = budget.minutes() * 60000
  if maintenance_policy.mode() \= "reviewed" then total_time = maintenance_policy.window_seconds() * 1000
  if maximum_call_time > total_time then maximum_call_time = total_time
  if cognitive_limit > 0 & (maximum_call_input < 1 | maximum_call_output < 1 | (extractor.charging_basis() = "monetary-api" & maximum_call_cost < 1) | maximum_call_time < 1) then do; error = "configured budget cannot safely admit maintenance extraction"; return -1; end
  privacy = queryprivacy(config)
  discovery = config.discovery(); glossary_loader = .ragglossaryloader(); glossary = glossary_loader.empty()
  if discovery.glossary_path() \= "" then do
    glossary_result = glossary_loader.load(discovery.glossary_path()); glossary = glossary_result.glossary(); error = glossary_result.error()
    if glossary_result.status() \= 0 then return -1
  end
  discovery_context = ""
  if creatediscoverycontext(glossary, "maintenance", discovery.ranked_limit(), discovery.max_mentions(), discovery.max_relationships(), discovery.max_notes(), discovery_context, error) \= 0 then return -1
  triggers = .string[]; triggers[1] = "bridge"; triggers[2] = "conflict"; triggers[3] = "maintenance-priority"; triggers[4] = "operator-review"; triggers[5] = "unprocessed-extraction"; triggers[6] = "unresolved"; triggers[7] = "weak-support"
  if createimproveplan(store, snapshot_id, "surface-claim-v1", "surface-prompt-v1", triggers, cognitive_limit, cognitive_call_budget, budget.input_tokens(), budget.output_tokens(), budget.cost_microunits(), total_time, maximum_call_input, maximum_call_output, maximum_call_cost, maximum_call_time, maximum_inflight, extractor.max_attempts(), privacy, extractor.provider_id(), extractor.credential().ref_string(), discovery_context, plan, error) \= 0 then return -3
  if maintenance_policy.mode()<>"reviewed" then do
    if embedding_only=0 & queryrouteallowed(extractor,privacy)<>1 then do;error="library privacy denies the configured maintenance extractor route";return -2;end
    if queryrouteallowed(embedder,privacy)<>1 then do;error="library privacy denies the configured maintenance embedding route";return -2;end
    return previewbacklogwindow(store.database(),embedding_profile_id,batch_items,embedding_only,census,error,source_id)
  end
  maximum_passes = plan.item_count() + 2
  do pass = 1 to maximum_passes
    if buildmaintenancecensus(store, plan, embedding_profile_id, batch_items, census, error, maintenance_policy.sparse_max_degree(), maintenance_policy.query_gap_min_occurrences(),embedding_only) \= 0 then return -3
    selected = _censuscognitivechunks(census)
    plan_chunks = plan.chunk_ids()
    if _samechunkset(plan_chunks, selected) = 1 then leave
    filtered = .ragimproveplan
    if filterimproveplan(plan, selected, filtered, error) \= 0 then return -3
    plan = filtered
  end
  selected = _censuscognitivechunks(census); plan_chunks = plan.chunk_ids()
  if _samechunkset(plan_chunks, selected) \= 1 then do; error = "maintenance worklist did not converge to its exact cognitive subset"; return -3; end
  calls = _maintenancecallcount(census)
  if calls > budget.model_calls() then do; error = "maintenance worklist exceeds the configured provider-call budget"; return -2; end
  if plan.item_count() > 0 & queryrouteallowed(extractor, privacy) \= 1 then do; error = "library privacy denies the configured maintenance extractor route"; return -2; end
  if calls > plan.item_count() & queryrouteallowed(embedder, privacy) \= 1 then do; error = "library privacy denies the configured maintenance embedding route"; return -2; end
  return 0

_censuscognitivechunks: procedure = .string[]
  arg census = .ragmaintenancecensus
  output = .string[]; types = census.item_types(); subjects = census.subject_ids()
  do i = 1 to types.0
    if types[i] = "concept-review" then output[output.0 + 1] = subjects[i]
  end
  return output

_maintenancecallcount: procedure = .int
  arg census = .ragmaintenancecensus
  count = 0; types = census.item_types()
  do i = 1 to types.0
    if types[i] = "concept-review" | types[i] = "stale-embedding" then count = count + 1
  end
  return count

_maintenanceitemcount: procedure = .int
  arg census = .ragmaintenancecensus, expected_type = .string
  count = 0; types = census.item_types()
  do i = 1 to types.0
    if types[i] = expected_type then count = count + 1
  end
  return count

_samechunkset: procedure = .int
  arg left_values = .string[], right_values = .string[]
  if left_values.0 \= right_values.0 then return 0
  do i = 1 to left_values.0
    if containscitation(right_values, left_values[i]) \= 1 then return 0
  end
  return 1

_embeddingprofileid: procedure = .string
  arg provider = .ragproviderconfig, dimension = .int
  envelope = "crexx-rag.embedding-input/1|" || provider.provider_id() || "|" || provider.kind() || "|" || provider.model() || "|" || dimension
  return "embedding-" || dimension || "-" || substr(rxhash..sha256hex(envelope as .binary), 1, 12)

_missingembeddingcount: procedure = .int
  arg database = .binary, embedding_profile_id = .string
  generation = sqlreadint(database, "SELECT published_generation FROM library_meta WHERE singleton=1")
  if generation < 1 then return -1
  return sqlreadint(database, "SELECT count(*) FROM revision_chunks rc WHERE rc.visible_from_generation<=" || generation || " AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>" || generation || ") AND NOT EXISTS(SELECT 1 FROM revision_chunk_embeddings rce JOIN embeddings e ON e.embedding_id=rce.embedding_id WHERE rce.revision_chunk_id=rc.revision_chunk_id AND e.embedding_profile_id=" || sqlquote(embedding_profile_id) || " AND rce.visible_from_generation<=" || generation || " AND (rce.visible_to_generation IS NULL OR rce.visible_to_generation>" || generation || "))")

_agentaction: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation = request.operation(); error = ""; apply = right(operation,6) = "-apply"
  kind = "resolution"; if pos("escalate",operation)>0 then kind = "escalation"
  required = "plan"; if apply then required = "curate"
  if commandhasaccess(request,required) \= 1 then return commandfailure(operation,4,"agent action requires " || required || " access")
  if commandoptions(request,"id response-json reason actor model plan-json expect-digest",error) \= 0 then return commandfailure(operation,2,error)
  config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
  if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then return commandfailure(operation,5,"configuration or profile is unavailable")
  config = config_lookup.config(); profile = profile_lookup.profile()
  canonical = commandoption(request,"plan-json",error); digest = commandoption(request,"expect-digest",error)
  id = commandid(request,error); response = commandoption(request,"response-json",error); reason = commandoption(request,"reason",error)
  actor = commandoption(request,"actor",error); model = commandoption(request,"model",error)
  if error \= "" then return commandfailure(operation,2,error)
  if apply & (id \= "" | response \= "" | reason \= "" | actor \= "" | model \= "") then return commandfailure(operation,2,"apply accepts only exact plan-json and expect-digest")
  if \apply & (canonical \= "" | digest \= "") then return commandfailure(operation,2,"planning accepts task inputs, not an existing plan")
  if actor = "" then actor = "external-agent"
  if model = "" then model = "unspecified"
  if kind = "resolution" & reason = "" then do; decoded = .jsondocument(response); ignored = decoded.node_string(decoded.member(decoded.root(),"reason"),reason); end
  store = .ragstorehandle; access = "readonly"; if apply then access = "readwrite"
  if openragstore(request.library(),access,store,error) \= 0 then return commandopenfailure(operation,error)
  if querysnapshotmatches(store,config,profile) \= 1 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,6,"configuration changes have not been applied; review config diff first"); end
  review_id = ""
  if apply then status = applyagentaction(store,config,profile,canonical,digest,kind,review_id,error)
  else status = planagentaction(store,config,profile,id,kind,response,reason,actor,model,canonical,error)
  ignored = ""; closed = closeragstore(store,ignored)
  if status \= 0 then return commandfailure(operation,3,error)
  if closed \= 0 then return commandfailure(operation,7,ignored)
  fields = .ragresultfield[]; fields[1] = .ragresultfield("kind","string",kind)
  fields[2] = .ragresultfield("digest","string",rxhash..sha256hex(canonical as .binary))
  fields[3] = .ragresultfield("canonical_plan","string",canonical)
  fields[4] = .ragresultfield("applied","boolean",commandboolean(apply))
  fields[5] = .ragresultfield("review_id","string",review_id)
  fields[6] = .ragresultfield("validation","string","task, grounding, profile types and impact checked; resolution apply queues mandatory review; acceptance revalidates lifecycle and current evidence")
  fields[7] = .ragresultfield("provider_calls","integer",0)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("agent-action",fields)
  document = .jsondocument(canonical); impact = document.node_get(document.member(document.root(),"impact"))
  records = commandeffectrecords(records,impact)
  return .ragcommandresult(operation,"ok",0,"evidence-bound external agent action",records)

_taskrefresh: procedure = .ragcommandresult
  arg request = .ragcommandrequest, registry = .ragregistry
  operation=request.operation(); apply=operation="maintain.refresh-apply"; error=""
  access="plan"; if apply then access="curate"
  if commandhasaccess(request,access)\=1 then return commandfailure(operation,4,"evidence refresh requires " || access || " access")
  if commandoptions(request,"id maximum-bytes maximum-concepts reason actor model plan-json expect-digest",error)\=0 then return commandfailure(operation,2,error)
  id=commandid(request,error); canonical=commandoption(request,"plan-json",error); digest=commandoption(request,"expect-digest",error)
  bytes=commandoption(request,"maximum-bytes",error); concepts=commandoption(request,"maximum-concepts",error)
  reason=commandoption(request,"reason",error); actor=commandoption(request,"actor",error); model=commandoption(request,"model",error)
  if apply & (id\="" | bytes\="" | concepts\="" | reason\="" | actor\="" | model\="") then return commandfailure(operation,2,"refresh apply accepts only exact plan-json and expect-digest")
  if \apply & (canonical\="" | digest\="" | id="") then return commandfailure(operation,2,"refresh planning requires a task ID, not an existing plan")
  if bytes="" then bytes="1048576"
  if concepts="" then concepts="1000"
  if commandunsigned(bytes)\=1 | length(bytes)>8 | commandunsigned(concepts)\=1 | length(concepts)>4 then return commandfailure(operation,2,"refresh ceilings must be bounded integers")
  if actor="" then actor="external-agent"
  if model="" then model="unspecified"
  config_lookup=registry.config(request.config_id()); profile_lookup=registry.profile(request.profile_id())
  if config_lookup.found()\=1 | profile_lookup.found()\=1 then return commandfailure(operation,5,"configuration or profile is not registered")
  config=config_lookup.config(); profile=profile_lookup.profile(); store=.ragstorehandle
  store_access="readonly"; if apply then store_access="readwrite"
  if openragstore(request.library(),store_access,store,error)\=0 then return commandopenfailure(operation,error)
  if querysnapshotmatches(store,config,profile)\=1 then do; ignored=""; call closeragstore store,ignored; return commandfailure(operation,6,"configuration changes have not been applied; review config diff first"); end
  successor=""; status=0
  if apply then status=applybacklogrefresh(store,config,profile,canonical,digest,successor,error)
  else do
    if sqliteexec(store.database(),"BEGIN")\=0 then do; status=-1; error="cannot begin refresh planning snapshot"; end
    else status=planbacklogrefresh(store,config,profile,id,bytes as .int,concepts as .int,reason,actor,model,canonical,error)
    call sqliteexec store.database(),"ROLLBACK"
  end
  ignored=""; closed=closeragstore(store,ignored)
  if status\=0 | closed\=0 then return commandfailure(operation,3,error || ignored)
  planned=.jsondocument(canonical); ignored=planned.node_string(planned.member(planned.root(),"successor_task_id"),successor)
  fields=.ragresultfield[]
  fields[1]=.ragresultfield("canonical_plan","string",canonical); fields[2]=.ragresultfield("digest","string",rxhash..sha256hex(canonical as .binary))
  fields[3]=.ragresultfield("successor_task_id","string",successor); fields[4]=.ragresultfield("applied","boolean",commandboolean(apply))
  fields[5]=.ragresultfield("provider_calls","integer",0)
  records=.ragresultrecord[]; records[1]=.ragresultrecord("task-evidence-refresh",fields)
  return .ragcommandresult(operation,"ok",0,"complete evidence refresh; apply supersedes the old task without changing corpus generation",records)

_maintainread: procedure = .ragcommandresult
  arg request = .ragcommandrequest
  operation = request.operation(); error = ""
  if commandhasaccess(request, "read") \= 1 then return commandfailure(operation, 4, "maintenance inspection requires read access")
  if commandoptions(request, "id cursor limit", error) \= 0 then return commandfailure(operation, 2, error)
  id = commandid(request, error)
  if error \= "" then return commandfailure(operation, 2, error)
  if operation = "maintain.inspect" & id = "" then return commandfailure(operation, 2, "maintain inspect requires a run, item, or note id")
  cursor = commandoption(request, "cursor", error); limit_text = commandoption(request, "limit", error); limit = 98
  if limit_text \= "" then do
    if commandunsigned(limit_text) \= 1 then return commandfailure(operation, 2, "maintenance limit must be an integer")
    limit = limit_text as .int
  end
  if error \= "" | limit < 1 | limit > 98 then return commandfailure(operation, 2, "maintenance limit must be 1 through 98")
  returned = 0; has_more = 0; next_cursor = ""; cursor_filter = ""
  store = .ragstorehandle
  store_access = "readwrite"; if operation = "maintain.inspect" then store_access = "readonly"
  if openragstore(request.library(), store_access, store, error) \= 0 then return commandopenfailure(operation, error)
  database = store.database(); records = .ragresultrecord[]
  if operation = "maintain.inspect" then do
    if (left(id,5) = "task:" | left(id,9) = "workflow:") & cursor \= "" then do
      if commandunsigned(cursor) \= 1 | length(cursor)>9 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,2,"task and workflow history cursor must be numeric and at most nine digits"); end
    end
    detail = inspectbacklog(database,id,cursor,limit)
    if detail \= "" then do
      fields = .ragresultfield[]; fields[1] = .ragresultfield("id","string",id); fields[2] = .ragresultfield("detail","string",detail); records[1] = .ragresultrecord("maintenance-detail",fields)
      if left(id,5) = "task:" then do
        subject_type = sqlreadtext(database,"SELECT subject_type FROM maintenance_tasks WHERE task_id=" || sqlquote(id))
        workflow = sqlreadtext(database,"SELECT workflow_id FROM maintenance_tasks WHERE task_id=" || sqlquote(id))
        fields[3] = .ragresultfield("response_schema","string",backlogschema(subject_type,workflow \= ""))
        records[1] = .ragresultrecord("maintenance-detail",fields)
      end
      if left(id,13) = "agent-action:" then do; fields[2] = .ragresultfield("canonical_plan","string",detail); records[1] = .ragresultrecord("agent-action",fields); end
      ignored = ""; call closeragstore store,ignored
      return .ragcommandresult(operation,"ok",0,"durable maintenance evidence and decisions",records)
    end
  end
  if operation = "maintain.status" then do
    run_id = id
    if run_id = "" then run_id = sqlreadtext(database, "SELECT run_id FROM maintenance_runs ORDER BY created_at DESC,run_id DESC LIMIT 1")
    if run_id = "" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 5, "no maintenance run exists"); end
    backlog_job = sqlreadtext(database,"SELECT job_id FROM maintenance_windows WHERE run_id=" || sqlquote(run_id))
    if cursor \= "" & backlog_job = "" then do
      cursor_score = sqlreadtext(database, "SELECT CAST(score AS TEXT) FROM maintenance_items WHERE run_id=" || sqlquote(run_id) || " AND item_id=" || sqlquote(cursor))
      if cursor_score = "" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 2, "maintenance cursor does not belong to this run"); end
      cursor_filter = " AND (score<" || cursor_score || " OR (score=" || cursor_score || " AND item_id>" || sqlquote(cursor) || "))"
    end
    backlog_job = sqlreadtext(database,"SELECT job_id FROM maintenance_windows WHERE run_id=" || sqlquote(run_id))
    if backlog_job \= "" then do
      summary = backlogsummary(database,backlog_job); fields = .ragresultfield[]; fields[1] = .ragresultfield("run_id","string",run_id); fields[2] = .ragresultfield("backlog","string",summary)
      records[1] = .ragresultrecord("maintenance-window",fields)
      prepared = .binary
      sql = "SELECT t.task_id,t.kind,t.subject_type,t.subject_id,t.state,t.workflow_id,t.question,t.attempt_count,t.last_error FROM maintenance_tasks t WHERE t.task_id>" || sqlquote(cursor) || " ORDER BY t.task_id LIMIT " || (limit+1)
      if sqliteprepare(database,sql,prepared) \= 0 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,"cannot inspect durable backlog"); end
      do forever
        step = sqlitestep(prepared); if step = 101 then leave
        if returned = limit then do; has_more = 1; leave; end
        task_id = ""; kind = ""; subject_type = ""; subject_id = ""; task_state = ""; workflow = ""; question = ""; attempts = 0; last_error = ""
        columns = sqlitecolumntext(prepared,0,task_id) | sqlitecolumntext(prepared,1,kind) | sqlitecolumntext(prepared,2,subject_type) | sqlitecolumntext(prepared,3,subject_id) | sqlitecolumntext(prepared,4,task_state) | sqlitecolumntext(prepared,5,workflow) | sqlitecolumntext(prepared,6,question) | sqlitecolumnint(prepared,7,attempts) | sqlitecolumntext(prepared,8,last_error)
        if step \= 100 | columns \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,7,"cannot read durable backlog"); end
        fields = .ragresultfield[]; fields[1] = .ragresultfield("task_id","string",task_id); fields[2] = .ragresultfield("kind","string",kind); fields[3] = .ragresultfield("subject_type","string",subject_type); fields[4] = .ragresultfield("subject_id","string",subject_id); fields[5] = .ragresultfield("state","string",task_state); fields[6] = .ragresultfield("workflow_id","string",workflow); fields[7] = .ragresultfield("question","string",question); fields[8] = .ragresultfield("attempts","integer",attempts); fields[9] = .ragresultfield("reason","string",last_error)
        records[records.0+1] = .ragresultrecord("maintenance-task",fields)
        returned = returned+1; next_cursor = task_id
      end
      call sqlitefinalize prepared
      fields = .ragresultfield[]; fields[1] = .ragresultfield("returned","integer",returned); fields[2] = .ragresultfield("has_more","boolean",commandboolean(has_more)); fields[3] = .ragresultfield("next_cursor","string",next_cursor); records[records.0+1] = .ragresultrecord("pagination",fields)
      ignored = ""; call closeragstore store,ignored
      return .ragcommandresult(operation,"ok",0,"durable maintenance backlog",records)
    end
    state = ""; pending = 0; review_count = 0
    if refreshmaintenance(store, run_id, state, pending, review_count, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, error); end
    prepared = .binary
    sql = "SELECT mode,state,expected_generation,plan_digest,created_at,COALESCE(completed_at,'') FROM maintenance_runs WHERE run_id=?1"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, run_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 5, "maintenance run was not found"); end
    mode = ""; stored_state = ""; generation = 0; digest = ""; created = ""; completed = ""
    columns = sqlitecolumntext(prepared, 0, mode) | sqlitecolumntext(prepared, 1, stored_state) | sqlitecolumnint(prepared, 2, generation) | sqlitecolumntext(prepared, 3, digest) | sqlitecolumntext(prepared, 4, created) | sqlitecolumntext(prepared, 5, completed); call sqlitefinalize prepared
    if columns \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot decode maintenance run"); end
    fields = .ragresultfield[]
    fields[1] = .ragresultfield("run_id", "string", run_id); fields[2] = .ragresultfield("state", "string", stored_state); fields[3] = .ragresultfield("mode", "string", mode); fields[4] = .ragresultfield("generation", "integer", generation); fields[5] = .ragresultfield("plan_digest", "string", digest); fields[6] = .ragresultfield("pending_items", "integer", pending); fields[7] = .ragresultfield("review_items", "integer", review_count); fields[8] = .ragresultfield("created_at", "string", created); fields[9] = .ragresultfield("completed_at", "string", completed)
    records[1] = .ragresultrecord("maintenance-run", fields)
    prepared = .binary
    sql = "SELECT item_id,item_type,subject_type,subject_id,score,state,trigger_json,diagnosis_json,action_json FROM maintenance_items WHERE run_id=?1" || cursor_filter || " ORDER BY score DESC,item_id LIMIT " || (limit + 1)
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, run_id) \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot prepare maintenance item status"); end
    do forever
      step = sqlitestep(prepared); if step = 101 then leave
      if step \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot read maintenance item status"); end
      if returned = limit then do; has_more = 1; leave; end
      item_id = ""; item_type = ""; subject_type = ""; subject = ""; item_state = ""; trigger = ""; diagnosis = ""; action = ""; score = 0
      columns = sqlitecolumntext(prepared, 0, item_id) | sqlitecolumntext(prepared, 1, item_type) | sqlitecolumntext(prepared, 2, subject_type) | sqlitecolumntext(prepared, 3, subject) | sqlitecolumnint(prepared, 4, score) | sqlitecolumntext(prepared, 5, item_state) | sqlitecolumntext(prepared, 6, trigger) | sqlitecolumntext(prepared, 7, diagnosis) | sqlitecolumntext(prepared, 8, action)
      if columns \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot decode maintenance item status"); end
      fields = .ragresultfield[]; fields[1] = .ragresultfield("item_id", "string", item_id); fields[2] = .ragresultfield("item_type", "string", item_type); fields[3] = .ragresultfield("subject_type", "string", subject_type); fields[4] = .ragresultfield("subject_id", "string", subject); fields[5] = .ragresultfield("score", "integer", score); fields[6] = .ragresultfield("state", "string", item_state); fields[7] = .ragresultfield("triggers", "string", trigger); fields[8] = .ragresultfield("diagnosis", "string", diagnosis); fields[9] = .ragresultfield("action", "string", action)
      records[records.0 + 1] = .ragresultrecord("maintenance-item", fields)
      returned = returned + 1; next_cursor = item_id
    end
    call sqlitefinalize prepared
  end
  else do
    if cursor \= "" then do
      cursor_score = sqlreadtext(database, "SELECT CAST(score AS TEXT) FROM maintenance_items WHERE (item_id=" || sqlquote(id) || " OR run_id=" || sqlquote(id) || ") AND item_id=" || sqlquote(cursor))
      if cursor_score = "" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 2, "maintenance cursor does not belong to this selection"); end
      cursor_filter = " AND (score<" || cursor_score || " OR (score=" || cursor_score || " AND item_id>" || sqlquote(cursor) || "))"
    end
    prepared = .binary
    sql = "SELECT item_id,run_id,item_type,subject_type,subject_id,score,state,trigger_json,diagnosis_json,action_json FROM maintenance_items WHERE (item_id=?1 OR run_id=?1)" || cursor_filter || " ORDER BY score DESC,item_id LIMIT " || (limit + 1)
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, id) \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot prepare maintenance inspection"); end
    do forever
      step = sqlitestep(prepared); if step = 101 then leave
      if step \= 100 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot read maintenance inspection"); end
      if returned = limit then do; has_more = 1; leave; end
      item_id = ""; run_id = ""; item_type = ""; subject_type = ""; subject = ""; item_state = ""; trigger = ""; diagnosis = ""; action = ""; score = 0
      columns = sqlitecolumntext(prepared, 0, item_id) | sqlitecolumntext(prepared, 1, run_id) | sqlitecolumntext(prepared, 2, item_type) | sqlitecolumntext(prepared, 3, subject_type) | sqlitecolumntext(prepared, 4, subject) | sqlitecolumnint(prepared, 5, score) | sqlitecolumntext(prepared, 6, item_state) | sqlitecolumntext(prepared, 7, trigger) | sqlitecolumntext(prepared, 8, diagnosis) | sqlitecolumntext(prepared, 9, action)
      if columns \= 0 then do; call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot decode maintenance inspection"); end
      fields = .ragresultfield[]; fields[1] = .ragresultfield("item_id", "string", item_id); fields[2] = .ragresultfield("run_id", "string", run_id); fields[3] = .ragresultfield("item_type", "string", item_type); fields[4] = .ragresultfield("subject_type", "string", subject_type); fields[5] = .ragresultfield("subject_id", "string", subject); fields[6] = .ragresultfield("score", "integer", score); fields[7] = .ragresultfield("state", "string", item_state); fields[8] = .ragresultfield("triggers", "string", trigger); fields[9] = .ragresultfield("diagnosis", "string", diagnosis); fields[10] = .ragresultfield("action", "string", action)
      records[records.0 + 1] = .ragresultrecord("maintenance-item", fields)
      returned = returned + 1; next_cursor = item_id
    end
    call sqlitefinalize prepared
    if records.0 = 0 then do
      prepared = .binary
      sql = "SELECT note_id,note_kind,text,importance,uncertainty,next_action,state,grounding_json,author,created_generation FROM analysis_notes WHERE note_id=?1"
      if sqliteprepare(database, sql, prepared) = 0 & sqlitebindtext(prepared, 1, id) = 0 & sqlitestep(prepared) = 100 then do
        note_id = ""; kind = ""; note_text = ""; next_action = ""; note_state = ""; grounding = ""; author = ""; importance = 0; uncertainty = 0; generation = 0
        columns = sqlitecolumntext(prepared, 0, note_id) | sqlitecolumntext(prepared, 1, kind) | sqlitecolumntext(prepared, 2, note_text) | sqlitecolumnint(prepared, 3, importance) | sqlitecolumnint(prepared, 4, uncertainty) | sqlitecolumntext(prepared, 5, next_action) | sqlitecolumntext(prepared, 6, note_state) | sqlitecolumntext(prepared, 7, grounding) | sqlitecolumntext(prepared, 8, author) | sqlitecolumnint(prepared, 9, generation)
        if columns = 0 then do
          fields = .ragresultfield[]; fields[1] = .ragresultfield("note_id", "string", note_id); fields[2] = .ragresultfield("kind", "string", kind); fields[3] = .ragresultfield("text", "string", note_text); fields[4] = .ragresultfield("importance", "integer", importance); fields[5] = .ragresultfield("uncertainty", "integer", uncertainty); fields[6] = .ragresultfield("next_action", "string", next_action); fields[7] = .ragresultfield("state", "string", note_state); fields[8] = .ragresultfield("grounding", "string", grounding); fields[9] = .ragresultfield("author", "string", author); fields[10] = .ragresultfield("generation", "integer", generation)
          records[1] = .ragresultrecord("analysis-note", fields)
        end
      end
      call sqlitefinalize prepared
    end
  end
  close_error = ""; if closeragstore(store, close_error) \= 0 then return commandfailure(operation, 7, close_error)
  if records.0 = 0 & cursor = "" then return commandfailure(operation, 5, "maintenance object was not found")
  if has_more = 0 then next_cursor = ""
  more_text = "false"; if has_more = 1 then more_text = "true"
  fields = .ragresultfield[]; fields[1] = .ragresultfield("returned", "integer", returned); fields[2] = .ragresultfield("has_more", "boolean", more_text); fields[3] = .ragresultfield("next_cursor", "string", next_cursor)
  records[records.0 + 1] = .ragresultrecord("maintenance-page", fields)
  return .ragcommandresult(operation, "ok", 0, "maintenance state and durable worklist inspected", records)

_reviewdecision: procedure = .ragcommandresult
  arg request = .ragcommandrequest, apply = .int, registry = .ragregistry
  operation = request.operation(); error = ""
  if commandhasaccess(request, "plan") \= 1 then return commandfailure(operation, 4, "review decision preview requires plan access")
  if commandworkeroptions(request, "id decision apply", "apply", error) \= 0 then return commandfailure(operation, 2, error)
  id = commandid(request, error); decision = commandoption(request, "decision", error); apply_value = commandoption(request, "apply", error)
  if id = "" | (decision \= "accept" & decision \= "reject" & decision \= "dismiss") then return commandfailure(operation, 2, "review decide requires an id and accept, reject, or dismiss")
  if apply_value = "true" then apply = 1
  if apply = 1 & commandhasaccess(request, "curate") \= 1 then return commandfailure(operation, 4, "review decision apply requires curate access")
  preview_store = .ragstorehandle
  if openragstore(request.library(),"readonly",preview_store,error) \= 0 then return commandopenfailure(operation,error)
  if sqliteexec(preview_store.database(),"BEGIN") \= 0 then do; ignored = ""; call closeragstore preview_store,ignored; return commandfailure(operation,7,"cannot open review preview snapshot"); end
  preview_plan = ""; preview_impact = "[]"
  preview_state = sqlreadtext(preview_store.database(),"SELECT state FROM reviews WHERE review_id=" || sqlquote(id))
  preview_type = sqlreadtext(preview_store.database(),"SELECT review_type FROM reviews WHERE review_id=" || sqlquote(id))
  if preview_type = "maintenance-external" & preview_state = "pending" & decision = "accept" then do
    config_lookup = registry.config(request.config_id()); profile_lookup = registry.profile(request.profile_id())
    if config_lookup.found() \= 1 | profile_lookup.found() \= 1 then do; ignored = ""; call sqliteexec preview_store.database(),"ROLLBACK"; call closeragstore preview_store,ignored; return commandfailure(operation,5,"external resolution configuration or profile is unavailable"); end
    if previewagentaction(preview_store,id,config_lookup.config(),profile_lookup.profile(),preview_plan,preview_impact,error) \= 0 then do; ignored = ""; call sqliteexec preview_store.database(),"ROLLBACK"; call closeragstore preview_store,ignored; return commandfailure(operation,3,error); end
  end
  call sqliteexec preview_store.database(),"ROLLBACK"
  ignored = ""; closed = closeragstore(preview_store,ignored)
  if closed \= 0 then return commandfailure(operation,7,ignored)
  if preview_state = "" then return commandfailure(operation,5,"review was not found")
  if preview_state \= "pending" then return commandfailure(operation,5,"review was already decided")
  fields = .ragresultfield[]
  fields[1] = .ragresultfield("review_id", "string", id)
  fields[2] = .ragresultfield("decision", "string", decision)
  fields[3] = .ragresultfield("would_write", "boolean", commandboolean(apply))
  fields[4] = .ragresultfield("applied", "boolean", "false")
  fields[5] = .ragresultfield("review_type","string",preview_type)
  fields[6] = .ragresultfield("current_state","string",preview_state)
  fields[7] = .ragresultfield("validation","string","pending review exists; acceptance revalidates current evidence during apply")
  if preview_plan \= "" then fields[8] = .ragresultfield("canonical_plan","string",preview_plan)
  records = .ragresultrecord[]; records[1] = .ragresultrecord("review-decision-preview", fields)
  if preview_plan \= "" then records = commandeffectrecords(records,preview_impact)
  if apply = 1 then do
    store = .ragstorehandle
    if openragstore(request.library(), "readwrite", store, error) \= 0 then return commandopenfailure(operation, error)
    database = store.database(); review_type = ""; proposal_json = ""; current_state = ""
    prepared = .binary
    if sqliteprepare(database, "SELECT review_type,proposal_json,state FROM reviews WHERE review_id=?1", prepared) \= 0 | sqlitebindtext(prepared, 1, id) \= 0 | sqlitestep(prepared) \= 100 then do
      call sqlitefinalize prepared; ignored = ""; call closeragstore store, ignored
      return commandfailure(operation, 5, "review was not found")
    end
    columns = sqlitecolumntext(prepared, 0, review_type) | sqlitecolumntext(prepared, 1, proposal_json) | sqlitecolumntext(prepared, 2, current_state)
    call sqlitefinalize prepared
    if columns \= 0 | current_state \= "pending" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 5, "pending review was not found or was already decided"); end
    promotion_disposition = "not-applicable"; promoted_claim = ""; promoted_support = ""; maintenance_item_id = ""; maintenance_item_type = ""; maintenance_action = ""; maintenance_expected = 0; maintenance_applied = 0; vector_generations = 0; vector_state = "not-applicable"
    if review_type = "maintenance-external" then do
      profile_lookup = registry.profile(request.profile_id()); config_lookup = registry.config(request.config_id())
      if profile_lookup.found() \= 1 | config_lookup.found() \= 1 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,5,"external resolution configuration or profile is unavailable"); end
      review_status = reviewagentaction(store,id,decision,config_lookup.config(),profile_lookup.profile(),error)
      ignored = ""; call closeragstore store,ignored
      if review_status \= 0 then return commandfailure(operation,3,error)
      fields = records[1].fields(); fields[4] = .ragresultfield("applied","boolean","true"); records[1] = .ragresultrecord("review-decision",fields)
      return .ragcommandresult(operation,"ok",0,"external resolution review applied with current evidence validation",records)
    end
    if review_type = "maintenance-resolution" then do
      profile_lookup = registry.profile(request.profile_id())
      if profile_lookup.found() \= 1 then do; ignored = ""; call closeragstore store,ignored; return commandfailure(operation,5,"resolution profile is unavailable"); end
      review_status = reviewbacklogdecision(store,id,decision,profile_lookup.profile(),error)
      ignored = ""; call closeragstore store,ignored
      if review_status \= 0 then return commandfailure(operation,3,error)
      fields[4] = .ragresultfield("applied","boolean","true"); records[1] = .ragresultrecord("review-decision",fields)
      return .ragcommandresult(operation,"ok",0,"durable resolution review applied with current evidence validation",records)
    end
    if decision = "accept" & review_type = "external-proposal" then do
      profile_lookup = registry.profile(request.profile_id()); config_lookup = registry.config(request.config_id())
      if profile_lookup.found() \= 1 | config_lookup.found() \= 1 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 5, "configuration or profile is not registered"); end
      external = .ragextractionproposal
      if decodeproposaljson(proposal_json, 1, external, error) \= 0 | external.profile_id() \= request.profile_id() then do
        if error = "" then error = "external proposal profile does not match the selected profile"
        ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 3, error)
      end
      proposal = internalizeproposal(external); policy = effectiveclaimpolicy(profile_lookup.profile())
      generation = sqlreadint(database, "SELECT published_generation FROM library_meta WHERE singleton=1")
      snapshot_id = currentconfigsnapshotid(database, error)
      promotion = .ragproposalresult
      if applyproposal(store, proposal, policy, generation, snapshot_id, promotion, error) \= 0 | (promotion.disposition() \= "accepted" & promotion.disposition() \= "identical-no-op") then do
        if error = "" then error = "accepted external proposal did not pass deterministic promotion"
        ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 3, error)
      end
      promotion_disposition = promotion.disposition(); promoted_claim = promotion.claim_id(); promoted_support = promotion.support_id()
      if _publishconfiguredvector(store, config_lookup.config(), vector_generations, vector_state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 8, "proposal generation is durable but ANN finalisation failed and can be safely retried: " || error); end
    end
    if left(review_type, 12) = "maintenance-" then do
      if _maintenancereview(database, proposal_json, review_type, maintenance_item_id, maintenance_item_type, maintenance_action, maintenance_expected, maintenance_applied, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 3, error); end
      if maintenance_applied > 0 & decision \= "accept" then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 6, "an already published lifecycle action can only complete its pending acceptance and ANN finalisation"); end
      if decision = "accept" & wordpos(maintenance_item_type, "synonym split merge type-correction retire restore") > 0 then do
        profile_lookup = registry.profile(request.profile_id()); config_lookup = registry.config(request.config_id())
        if profile_lookup.found() \= 1 | config_lookup.found() \= 1 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 5, "configuration or profile is not registered"); end
        lifecycle_disposition = ""; lifecycle_generation = maintenance_applied
        if maintenance_applied = 0 then do
          lifecycle_status = applylifecycleaction(store, profile_lookup.profile(), maintenance_item_id, maintenance_action, maintenance_expected, lifecycle_generation, lifecycle_disposition, error)
          if lifecycle_status \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 3, error); end
        end
        else lifecycle_disposition = maintenance_item_type || "-recovered"
        if _publishconfiguredvector(store, config_lookup.config(), vector_generations, vector_state, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 8, "lifecycle generation is durable but ANN finalisation failed and can be safely retried: " || error); end
        promotion_disposition = lifecycle_disposition
      end
    end
    state = decision || "ed"
    if decision = "accept" then state = "accepted"
    if sqliteexec(database, "BEGIN IMMEDIATE") \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot begin review decision"); end
    if maintenance_item_id \= "" then do
      item_state = "rejected"; if decision = "accept" then item_state = "applied"
      if maintenance_item_type = "claim-conflict" then do
        conflict_state = decision; if decision = "accept" then conflict_state = "confirmed"
        if sqliteexec(database, "UPDATE claim_conflicts SET review_state=" || sqlquote(conflict_state) || " WHERE conflict_id=(SELECT subject_id FROM maintenance_items WHERE item_id=" || sqlquote(maintenance_item_id) || ")") \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot apply conflict review outcome"); end
      end
      applied_sql = "NULL"; if decision = "accept" then applied_sql = "COALESCE(applied_generation,(SELECT published_generation FROM library_meta WHERE singleton=1))"
      if sqliteexec(database, "UPDATE maintenance_items SET state=" || sqlquote(item_state) || ",applied_generation=" || applied_sql || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE item_id=" || sqlquote(maintenance_item_id)) \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot persist maintenance review outcome"); end
      note_state = "resolved"; if decision = "reject" then note_state = "rejected"
      if sqliteexec(database, "UPDATE analysis_notes SET state=" || sqlquote(note_state) || ",updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE review_id=" || sqlquote(id)) \= 0 then do; call sqliteexec database, "ROLLBACK"; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot persist analysis-note review outcome"); end
    end
    prepared = .binary
    sql = "UPDATE reviews SET state=?2,decision_json=?3,decided_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE review_id=?1 AND state='pending'"
    decision_json = '{"schema":"crexx-rag.review-decision/1","decision":' || jsonquote(decision) || '}'
    bind_status = -1; step_status = -1
    if sqliteprepare(database, sql, prepared) = 0 then do
      bind_status = sqlitebindtext(prepared, 1, id) | sqlitebindtext(prepared, 2, state) | sqlitebindtext(prepared, 3, decision_json)
      step_status = sqlitestep(prepared)
    end
    call sqlitefinalize prepared
    changed = sqlreadint(database, "SELECT changes()")
    if bind_status \= 0 | step_status \= 101 | changed \= 1 then do
      call sqliteexec database, "ROLLBACK"
      ignored = ""; call closeragstore store, ignored
      return commandfailure(operation, 5, "pending review was not found or was already decided")
    end
    if sqliteexec(database, "COMMIT") \= 0 then do; ignored = ""; call closeragstore store, ignored; return commandfailure(operation, 7, "cannot commit review decision"); end
    close_error = ""
    if closeragstore(store, close_error) \= 0 then return commandfailure(operation, 7, close_error)
    fields[4] = .ragresultfield("applied", "boolean", "true")
    fields[5] = .ragresultfield("state", "string", state)
    fields[6] = .ragresultfield("promotion_disposition", "string", promotion_disposition)
    if promoted_claim \= "" then fields[7] = .ragresultfield("claim_id", "string", promoted_claim)
    if promoted_support \= "" then fields[8] = .ragresultfield("support_id", "string", promoted_support)
    if maintenance_item_id \= "" then fields[fields.0 + 1] = .ragresultfield("maintenance_item_id", "string", maintenance_item_id)
    if vector_state \= "not-applicable" then do
      fields[fields.0 + 1] = .ragresultfield("vector_state", "string", vector_state)
      fields[fields.0 + 1] = .ragresultfield("vector_generations", "integer", vector_generations)
    end
    records[1] = .ragresultrecord("review-decision", fields)
    return .ragcommandresult(operation, "ok", 0, "authorized review decision persisted through deterministic proposal validation", records)
  end
  return .ragcommandresult(operation, "ok", 0, "review decision preview produced without mutation", records)

_maintenancereview: procedure = .int
  arg database = .binary, proposal_json = .string, review_type = .string, expose item_id = .string, expose item_type = .string, expose action_json = .string, expose expected_generation = .int, expose applied_generation = .int, expose error = .string
  item_id = ""; item_type = ""; action_json = ""; expected_generation = 0; applied_generation = 0; error = ""
  document = .jsondocument(proposal_json)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" | document.node_count(document.root()) \= 4 then do; error = "maintenance review envelope is invalid"; return -1; end
  schema = ""
  if document.node_string(document.member(document.root(), "schema"), schema) \= 0 | document.node_string(document.member(document.root(), "maintenance_item_id"), item_id) \= 0 | document.node_int(document.member(document.root(), "expected_generation"), expected_generation) \= 0 | document.node_type(document.member(document.root(), "action")) \= "object" | schema \= "crexx-rag.maintenance-review/1" | item_id = "" | expected_generation < 1 then do; error = "maintenance review binding is invalid"; return -1; end
  prepared = .binary
  sql = "SELECT item_type,action_json,state,expected_generation,COALESCE(applied_generation,0) FROM maintenance_items WHERE item_id=?1"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, item_id) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; error = "maintenance review item was not found"; return -1; end
  item_state = ""; stored_expected = 0
  columns = sqlitecolumntext(prepared, 0, item_type) | sqlitecolumntext(prepared, 1, action_json) | sqlitecolumntext(prepared, 2, item_state) | sqlitecolumnint(prepared, 3, stored_expected) | sqlitecolumnint(prepared, 4, applied_generation); call sqlitefinalize prepared
  canonical = '{"schema":"crexx-rag.maintenance-review/1","maintenance_item_id":' || jsonquote(item_id) || ',"expected_generation":' || expected_generation || ',"action":' || action_json || '}'
  if columns \= 0 | review_type \= "maintenance-" || item_type | stored_expected \= expected_generation | proposal_json \= canonical | (item_state \= "review-required" & item_state \= "approved" & item_state \= "applied") | (item_state = "applied" & applied_generation < 1) then do; error = "maintenance review no longer matches its exact work item"; return -1; end
  return 0

_actionstring: procedure = .string
  arg plan_json = .string, name = .string, expose error = .string
  document = .jsondocument(plan_json); output = ""
  if document.valid() \= 1 then do; error = "reviewed plan JSON is invalid"; return ""; end
  action = document.member(document.root(), "action")
  if document.node_string(document.member(action, name), output) \= 0 then do; error = "reviewed plan action is invalid"; return ""; end
  return output

/* Replays retain immutable work reservations and must fit the current reviewed
 * budget. The repository persists this policy atomically with the new job. */
_replaybudget: procedure = .string
  arg config = .ragconfig
  budget = config.budget(); roles = config.roles(); providers = config.providers()
  maximum_input = 0; maximum_output = 0; maximum_cost = 0; maximum_time = 0; maximum_attempts = 1
  do i = 1 to roles.0
    maximum_input = max(maximum_input, roles[i].maximum_input_tokens())
    maximum_output = max(maximum_output, roles[i].maximum_output_tokens())
    maximum_cost = max(maximum_cost, roles[i].maximum_call_cost_microunits())
  end
  do i = 1 to providers.0
    maximum_time = max(maximum_time, providers[i].timeout_ms())
    maximum_attempts = max(maximum_attempts, providers[i].max_attempts())
  end
  maximum_input = min(maximum_input, budget.input_tokens()); maximum_output = min(maximum_output, budget.output_tokens()); maximum_cost = min(maximum_cost, budget.cost_microunits())
  time_budget = budget.minutes() * 60000; maximum_time = min(maximum_time, time_budget)
  return '{"time_budget_ms":' || time_budget || ',"maximum_call_input_tokens":' || maximum_input || ',"maximum_call_output_tokens":' || maximum_output || ',"maximum_call_cost":' || maximum_cost || ',"maximum_call_time_ms":' || maximum_time || ',"maximum_inflight_calls":' || config.workers().max_in_flight() || ',"maximum_attempts":' || maximum_attempts || '}'

_enrichmentplan: procedure = .ragcommandresult
  arg request=.ragcommandrequest, registry=.ragregistry, store=.ragstorehandle, config=.ragconfig, profile=.ragprofile, timing=.string, path=.string
  error=""; raw=.binary; bytes=0; census=.ragmaintenancecensus
  status=readbinaryfilebounded(path,1048576,raw,bytes,error)
  if status=0 then status=prepareenrichment(store.database(),raw as .string,config.maintenance().maximum_evidence_bytes(),census,error)
  policy=""
  if status=0 then policy=enrichmentpolicy(store.database(),config,profile,timing,census)
  ignored=""; close_status=closeragstore(store,ignored)
  if status\=0 | close_status\=0 then return commandfailure(request.operation(),3,error || ignored)
  if census.item_count()=0 then return _enrichmentskip(request.operation())
  action='{"maintenance_digest":' || jsonquote(census.digest()) || ',"window_policy":' || jsonquote(policy) || ',"enrichment_input":' || jsonquote(raw as .string) || '}'
  plan=.ragplan
  if createfoundationplan(request.library(),request.config_id(),request.profile_id(),"maintain.apply",action,"curate",registry,plan,error)\=0 then return commandfailure(request.operation(),3,error)
  fields=.ragresultfield[]; records=.ragresultrecord[]
  fields[1]=.ragresultfield("canonical_plan","string",plan.payload()); fields[2]=.ragresultfield("digest","string",plan.digest()); fields[3]=.ragresultfield("disposition","string","planned"); fields[4]=.ragresultfield("provider_calls","integer",0); fields[5]=.ragresultfield("enqueued","boolean","false")
  records[1]=.ragresultrecord("canonical-plan",fields)
  fields=.ragresultfield[]; fields[1]=.ragresultfield("maintenance_plan","string",census.canonical()); fields[2]=.ragresultfield("chunks","integer",census.item_count()); fields[3]=.ragresultfield("maximum_initial_calls","integer",census.item_count()); fields[4]=.ragresultfield("maximum_correction_calls","integer",census.item_count())
  records[2]=.ragresultrecord("provenance-preview",fields)
  return .ragcommandresult(request.operation(),"ok",0,"existing supports and metadata frozen for bounded provenance enrichment",records)

_enrichmentapply: procedure = .ragcommandresult
  arg request=.ragcommandrequest, registry=.ragregistry, store=.ragstorehandle, config=.ragconfig, plan_json=.string, digest=.string, timing=.string, input=.string, snapshot_id=.string
  error=""; census=.ragmaintenancecensus; profile_lookup=registry.profile(request.profile_id()); policy=""
  status=prepareenrichment(store.database(),input,config.maintenance().maximum_evidence_bytes(),census,error)
  reviewed_digest=_actionstring(plan_json,"maintenance_digest",error); reviewed_policy=_actionstring(plan_json,"window_policy",error)
  if status=0 & (profile_lookup.found()\=1 | reviewed_digest\=census.digest()) then do; status=-1; error="provenance worklist changed; re-plan"; end
  if status=0 then do
    policy=enrichmentpolicy(store.database(),config,profile_lookup.profile(),timing,census)
    if reviewed_policy\=policy then do; status=-1; error="reviewed provenance policy changed"; end
  end
  run_id=""; job_id=""; items=0
  if status=0 then status=startbacklogwindow(store,census,snapshot_id,digest,policy,run_id,job_id,items,error)
  ignored=""; close_status=closeragstore(store,ignored)
  if status\=0 | close_status\=0 then return commandfailure(request.operation(),3,error || ignored)
  fields=.ragresultfield[]; records=.ragresultrecord[]
  fields[1]=.ragresultfield("job_id","string",job_id); fields[2]=.ragresultfield("run_id","string",run_id); fields[3]=.ragresultfield("work_items","integer",items); fields[4]=.ragresultfield("items","integer",items); fields[5]=.ragresultfield("disposition","string","provenance-window-created"); fields[6]=.ragresultfield("provider_calls","integer",0)
  records[1]=.ragresultrecord("maintain-apply",fields)
  return .ragcommandresult(request.operation(),"ok",0,"bounded provenance window created; workers use the frozen existing support list",records)

_enrichmentskip: procedure = .ragcommandresult
  arg operation=.string
  fields=.ragresultfield[]; records=.ragresultrecord[]
  fields[1]=.ragresultfield("disposition","string","skipped"); fields[2]=.ragresultfield("provider_calls","integer",0); fields[3]=.ragresultfield("work_items","integer",0)
  records[1]=.ragresultrecord("maintenance-skip",fields)
  return .ragcommandresult(operation,"ok",0,"selected supports are already assessed; no provider work is needed",records)
