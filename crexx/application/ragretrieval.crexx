ragretrievaloptions: class
  _policy_version = .string
  _embedding_profile_id = .string
  _query_vector = .binary
  _lexical_limit = .int
  _vector_limit = .int
  _vector_scan_limit = .int
  _graph_hops = .int
  _passage_limit = .int
  _claim_limit = .int
  _lead_limit = .int
  _rrf_k = .int
  _graph_direction = .string
  _graph_boost_millionths = .int
  _graph_decay_millionths = .int
  _directness_bonus_millionths = .int
  _maximum_sidecar_bytes = .int
  _temporal_query = .string
  _time_unknown = .string

  *: factory
    arg policy_version = "retrieval-v1", embedding_profile_id = "", query_vector = .binary, lexical_limit = 24, vector_limit = 12, vector_scan_limit = 100000, graph_hops = 2, passage_limit = 12, claim_limit = 8, lead_limit = 8, rrf_k = 60, graph_direction = "both", graph_boost_millionths = 2000, graph_decay_millionths = 750000, directness_bonus_millionths = 1000, maximum_sidecar_bytes = 67108864, temporal_query = "", time_unknown = "include"
    _policy_version = policy_version
    _embedding_profile_id = embedding_profile_id
    _query_vector = query_vector
    _lexical_limit = lexical_limit
    _vector_limit = vector_limit
    _vector_scan_limit = vector_scan_limit
    _graph_hops = graph_hops
    _passage_limit = passage_limit
    _claim_limit = claim_limit
    _lead_limit = lead_limit
    _rrf_k = rrf_k
    _graph_direction = graph_direction
    _graph_boost_millionths = graph_boost_millionths
    _graph_decay_millionths = graph_decay_millionths
    _directness_bonus_millionths = directness_bonus_millionths
    _maximum_sidecar_bytes = maximum_sidecar_bytes
    _temporal_query = temporal_query; _time_unknown = time_unknown
    return

  policy_version: method = .string
    return _policy_version
  embedding_profile_id: method = .string
    return _embedding_profile_id
  query_vector: method = .binary
    return _query_vector
  lexical_limit: method = .int
    return _lexical_limit
  vector_limit: method = .int
    return _vector_limit
  vector_scan_limit: method = .int
    return _vector_scan_limit
  graph_hops: method = .int
    return _graph_hops
  passage_limit: method = .int
    return _passage_limit
  claim_limit: method = .int
    return _claim_limit
  lead_limit: method = .int
    return _lead_limit
  rrf_k: method = .int
    return _rrf_k
  graph_direction: method = .string
    return _graph_direction
  graph_boost_millionths: method = .int
    return _graph_boost_millionths
  graph_decay_millionths: method = .int
    return _graph_decay_millionths
  directness_bonus_millionths: method = .int
    return _directness_bonus_millionths
  maximum_sidecar_bytes: method = .int
    return _maximum_sidecar_bytes

  temporal_query: method = .string
    return _temporal_query
  time_unknown: method = .string
    return _time_unknown

ragretrievalresult: class
  _status = .int
  _state = .string
  _evidence = .ragevidence
  _candidate_count = .int
  _lexical_candidates = .int
  _vector_candidates = .int
  _graph_candidates = .int
  _lexical_passages = .int
  _vector_passages = .int
  _graph_passages = .int
  _vector_state = .string
  _error = .string

  *: factory
    arg status = .int, state = .string, evidence = .ragevidence, candidate_count = .int, lexical_candidates = .int, vector_candidates = .int, graph_candidates = .int, lexical_passages = .int, vector_passages = .int, graph_passages = .int, vector_state = .string, error = .string
    _status = status
    _state = state
    _evidence = evidence
    _candidate_count = candidate_count
    _lexical_candidates = lexical_candidates
    _vector_candidates = vector_candidates
    _graph_candidates = graph_candidates
    _lexical_passages = lexical_passages
    _vector_passages = vector_passages
    _graph_passages = graph_passages
    _vector_state = vector_state
    _error = error
    return

  status: method = .int
    return _status
  state: method = .string
    return _state
  evidence: method = .ragevidence
    return _evidence
  candidate_count: method = .int
    return _candidate_count
  lexical_candidates: method = .int
    return _lexical_candidates
  vector_candidates: method = .int
    return _vector_candidates
  graph_candidates: method = .int
    return _graph_candidates
  lexical_passages: method = .int
    return _lexical_passages
  vector_passages: method = .int
    return _vector_passages
  graph_passages: method = .int
    return _graph_passages
  vector_state: method = .string
    return _vector_state
  error: method = .string
    return _error

retrieveevidence: procedure = .int
  arg store = .ragstorehandle, profile = .ragprofile, question = .string, retrieval_options = .ragretrievaloptions, expose result = .ragretrievalresult, expose error = .string
  empty_evidence = _emptyevidence(question)
  result = .ragretrievalresult(-1, "error", empty_evidence, 0, 0, 0, 0, 0, 0, 0, "not-attempted", "retrieval input is invalid")
  error = ""
  if store.open() \= 1 | _validoptions(retrieval_options) \= 1 then do; error = "retrieval input is invalid"; return -1; end
  query_plan = .ragqueryplan
  if planquery(store, profile, question, retrieval_options.policy_version(), query_plan, error) \= 0 then return -2
  generation = query_plan.generation()
  library_id = _scalartext(store.database(), "SELECT library_id FROM library_meta WHERE singleton=1")
  if library_id = "" then do; error = "library identity is unavailable"; return -3; end

  candidate_ids = .string[]
  lexical_ranks = .int[]; vector_ranks = .int[]; graph_ranks = .int[]
  vector_scores = .float[]; graph_hops = .int[]; directness_values = .float[]
  claim_ids = .string[]; claim_hops = .int[]; claim_paths = .string[]; trace_notes = .string[]
  lexical_status = _lexical(store.database(), query_plan, retrieval_options.lexical_limit(), candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values, trace_notes, error)
  if lexical_status \= 0 then return -3

  vector_state = "disabled"
  if retrieval_options.embedding_profile_id() \= "" | binlength(retrieval_options.query_vector()) > 0 then do
    vector_status = _vector(store, generation, retrieval_options, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values, vector_state, trace_notes, error)
    if vector_status < 0 then return -3
  end
  if _graph(store.database(), generation, query_plan, retrieval_options.graph_hops(), retrieval_options.graph_direction(), candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values, claim_ids, claim_hops, trace_notes, error,retrieval_options,claim_paths) \= 0 then return -3

  passages = .ragpassage[]; selected_ids = .string[]; selected_sources = .string[]; selected_contents = .string[]
  scores = .float[]
  if _rankandpassages(store.database(), library_id, generation, profile, query_plan, retrieval_options, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values, scores, passages, selected_ids, selected_sources, selected_contents, trace_notes, error) \= 0 then return -3
  claims = .ragacceptedclaim[]
  if _claims(store.database(), library_id, generation, retrieval_options.claim_limit(), claim_ids, claim_hops, selected_ids, claims, trace_notes, error,retrieval_options,claim_paths) \= 0 then return -3
  ambiguities = query_plan.ambiguities()
  if _retrievedambiguities(store.database(), generation, selected_ids, ambiguities, error) \= 0 then return -3
  leads = .raggraphlead[]
  if _leads(store.database(), generation, selected_ids, claim_ids, retrieval_options.lead_limit(), leads, error) \= 0 then return -3
  analysis_notes = .raganalysisnote[]
  if _analysisnotes(store.database(), library_id, generation, selected_ids, 8, analysis_notes, error) \= 0 then return -3
  gaps = .string[]
  call _gaps(query_plan, passages, claims, ambiguities, vector_state, gaps)
  plan_strings = .string[]; variants = query_plan.variants()
  do i = 1 to variants.0
    plan_strings[i] = variants[i].kind() || ":" || variants[i].query()
  end
  if retrieval_options.temporal_query() \= "" then plan_strings[plan_strings.0+1] = "temporal:" || retrieval_options.temporal_query() || ";unknown=" || retrieval_options.time_unknown()
  trace_identity = rxhash..sha256hex(("crexx-rag.retrieval-trace/1" || "00"x || library_id || "00"x || generation || "00"x || query_plan.fingerprint() || "00"x || retrieval_options.temporal_query() || "00"x || retrieval_options.time_unknown() || "00"x || _join(selected_ids)) as .binary)
  trace_notes[trace_notes.0 + 1] = "policy=" || retrieval_options.policy_version()
  trace_notes[trace_notes.0 + 1] = "vector=" || vector_state
  trace_notes[trace_notes.0 + 1] = "candidates=" || candidate_ids.0 || ";selected=" || passages.0 || ";claims=" || claims.0 || ";leads=" || leads.0 || ";analysis-notes=" || analysis_notes.0
  trace_record = .ragtrace("trace-" || substr(trace_identity, 1, 24), plan_strings, trace_notes)
  guidance = "Answer only from passages and accepted claim support. Use resolved support voice and provenance; never treat capture or publication as historical validity or assertion time. RAG acceptance is validation, not historical truth. Primary and secondary describe evidence origin, not reliability. Proposed or hypothetical relationships must never be presented as enacted facts. Preserve unknown dates, precision, calendars, draft status, attribution, conflicts and temporal compatibility. Known evidence families indicate dependence; unknown independence is not independent confirmation. Exploratory leads and textual years are not typed claims."
  evidence = .ragevidence("crexx-rag.evidence/2", library_id, generation, question, plan_strings, passages, claims, ambiguities, leads, analysis_notes, gaps, trace_record, guidance, "")
  lexical_candidates = _nonzero(lexical_ranks); vector_candidates = _nonzero(vector_ranks); graph_candidates = _nonzero(graph_ranks)
  lexical_passages = _selectedchannels(selected_ids, candidate_ids, lexical_ranks); vector_passages = _selectedchannels(selected_ids, candidate_ids, vector_ranks); graph_passages = _selectedchannels(selected_ids, candidate_ids, graph_ranks)
  result = .ragretrievalresult(0, "complete", evidence, candidate_ids.0, lexical_candidates, vector_candidates, graph_candidates, lexical_passages, vector_passages, graph_passages, vector_state, "")
  return 0

recordquerygaps: procedure = .int
  arg store = .ragstorehandle, evidence = .ragevidence, expose recorded = .int, expose error = .string
  recorded = 0; error = ""
  if store.writable() \= 1 | (evidence.schema_version() \= "crexx-rag.evidence/1" & evidence.schema_version() \= "crexx-rag.evidence/2") | evidence.active_generation() < 1 then do; error = "query-gap recording input is invalid"; return -1; end
  gaps = evidence.gaps()
  if gaps.0 = 0 then return 0
  normalized_question = lower(strip(evidence.original_question()))
  question_identity = normalized_question; query_steps = evidence.query_plan()
  do i = 1 to query_steps.0
    if left(query_steps[i],9) = "temporal:" then question_identity = question_identity || "00"x || query_steps[i]
  end
  question_hash = rxhash..sha256hex(question_identity as .binary)
  trace_id = evidence.trace().trace_id(); database = store.database()
  if sqliteexec(database, "BEGIN IMMEDIATE") \= 0 then do; error = "cannot begin query-gap recording"; return -3; end
  do i = 1 to gaps.0
    gap_id = "gap-sha256:" || rxhash..sha256hex((question_hash || "00"x || gaps[i] || "00"x || evidence.active_generation()) as .binary)
    prepared = .binary
    sql = "INSERT INTO query_gaps(gap_id,question_hash,normalized_question,gap_text,trace_id,observed_generation,occurrence_count,state,first_observed_at,last_observed_at) VALUES(?1,?2,?3,?4,?5,?6,1,'open',strftime('%Y-%m-%dT%H:%M:%fZ','now'),strftime('%Y-%m-%dT%H:%M:%fZ','now')) ON CONFLICT(question_hash,gap_text,observed_generation) DO UPDATE SET occurrence_count=occurrence_count+1,trace_id=excluded.trace_id,last_observed_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE state='open'"
    if sqliteprepare(database, sql, prepared) \= 0 then return _querygaprollback(database, "cannot prepare query-gap recording", error)
    binds = sqlitebindtext(prepared, 1, gap_id) | sqlitebindtext(prepared, 2, question_hash) | sqlitebindtext(prepared, 3, normalized_question) | sqlitebindtext(prepared, 4, gaps[i]) | sqlitebindtext(prepared, 5, trace_id) | sqlitebindint(prepared, 6, evidence.active_generation())
    step_status = sqlitestep(prepared); call sqlitefinalize prepared
    if binds \= 0 | step_status \= 101 then return _querygaprollback(database, "cannot persist query gap", error)
    recorded = recorded + 1
  end
  if sqliteexec(database, "COMMIT") \= 0 then return _querygaprollback(database, "cannot commit query-gap recording", error)
  return 0

_querygaprollback: procedure = .int
  arg database = .binary, message = .string, expose error = .string
  call sqliteexec database, "ROLLBACK"
  error = message
  return -3

resolvecitation: procedure = .int
  arg store = .ragstorehandle, citation = .ragcitation, expose passage = .ragpassage, expose error = .string
  empty_channels = .string[]; empty_scores = .ragscore[]
  passage = .ragpassage(citation, "", "", "", 0.0, "", "", "", "", "", empty_channels, empty_scores)
  error = ""
  if store.open() \= 1 | citation.source() = "" | citation.revision() = "" | citation.span_start() < 0 | citation.span_end() <= citation.span_start() then do; error = "citation input is invalid"; return -1; end
  prepared = .binary
  sql = "SELECT s.observed_title,t.normalized_utf8,s.connector_type,r.captured_at,COALESCE(r.event_start_at,''),COALESCE(r.event_end_at,'') FROM source_revisions r JOIN sources s ON s.source_id=r.source_id JOIN source_revision_texts t ON t.text_id=r.text_id WHERE s.source_id=?1 AND r.revision_id=?2"
  if sqliteprepare(store.database(), sql, prepared) \= 0 | sqlitebindtext(prepared, 1, citation.source()) \= 0 | sqlitebindtext(prepared, 2, citation.revision()) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; error = "citation source or revision does not exist"; return -2; end
  title = ""; revision_text = ""; source_type = ""; captured_at = ""; event_start = ""; event_end = ""
  column_status = sqlitecolumntext(prepared, 0, title) | sqlitecolumntext(prepared, 1, revision_text) | sqlitecolumntext(prepared, 2, source_type) | sqlitecolumntext(prepared, 3, captured_at) | sqlitecolumntext(prepared, 4, event_start) | sqlitecolumntext(prepared, 5, event_end)
  call sqlitefinalize prepared
  revision_bytes = revision_text as .binary
  if column_status \= 0 | citation.span_end() > binlength(revision_bytes) then do; error = "citation UTF-8 span is outside the immutable revision"; return -2; end
  body = binsubstr(revision_bytes, citation.span_start() + 1, citation.span_end() - citation.span_start()) as .string
  channels = .string[]; channels[1] = "historical-resolution"
  generation = _scalarint(store.database(),"SELECT published_generation FROM library_meta WHERE singleton=1")
  metadata = sourcemetadata(store.database(),citation.revision(),citation.span_start(),citation.span_end(),generation)
  passage = .ragpassage(citation, title, body, source_type, 1.0, _capturevalue(store.database(),captured_at), event_start, event_end, "historical", "direct", channels, empty_scores,metadata,captured_at)
  return 0

parsecitation: procedure = .int
  arg value = .string, expose library_id = .string, expose citation = .ragcitation, expose error = .string
  library_id = ""; error = ""; empty_citation = .ragcitation("", "", "", 0, 0); citation = empty_citation
  source_marker = pos(":source-sha256:", value)
  revision_marker = pos(":revision-sha256:", value)
  span_marker = pos(":utf8-", value)
  if left(value, 10) \= "crexx-rag:" | source_marker <= 10 | revision_marker <= source_marker | span_marker <= revision_marker then do; error = "citation identity is invalid"; return -1; end
  library_id = substr(value, 11, source_marker - 11)
  source_id = substr(value, source_marker + 1, revision_marker - source_marker - 1)
  revision_id = substr(value, revision_marker + 1, span_marker - revision_marker - 1)
  span = substr(value, span_marker + 6); separator = pos("-", span)
  if library_id = "" | length(source_id) \= 78 | left(source_id, 14) \= "source-sha256:" | length(revision_id) \= 80 | left(revision_id, 16) \= "revision-sha256:" | separator < 2 then do; error = "citation identity is invalid"; return -1; end
  start_text = left(span, separator - 1); end_text = substr(span, separator + 1)
  if _digits(start_text) \= 1 | _digits(end_text) \= 1 then do; error = "citation span is invalid"; return -1; end
  span_start = start_text as .int; span_end = end_text as .int
  if span_start < 0 | span_end <= span_start then do; error = "citation span is invalid"; return -1; end
  if _stablecitation(library_id, source_id, revision_id, span_start, span_end) \= value then do; error = "citation identity is not canonical"; return -1; end
  citation = .ragcitation(value, source_id, revision_id, span_start, span_end)
  return 0

_lexical: procedure = .int
  arg database = .binary, plan = .ragqueryplan, maximum = .int, expose candidate_ids = .string[], expose lexical_ranks = .int[], expose vector_ranks = .int[], expose graph_ranks = .int[], expose vector_scores = .float[], expose graph_hops = .int[], expose directness_values = .float[], expose trace_notes = .string[], expose error = .string
  variants = plan.variants(); next_rank = 1
  variant_limit = maximum
  if variants.0 > 1 then do
    variant_limit = (maximum / variants.0) as .int
    if variant_limit < 1 then variant_limit = 1
  end
  do v = 1 to variants.0
    fts_query = variants[v].query()
    if fts_query = "" then iterate
    prepared = .binary
    sql = "SELECT revision_chunk_id,bm25(chunks_fts) FROM chunks_fts WHERE chunks_fts MATCH ?1 ORDER BY bm25(chunks_fts),revision_chunk_id LIMIT ?2"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, fts_query) \= 0 | sqlitebindint(prepared, 2, variant_limit) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare lexical retrieval"; return -1; end
    hits = 0
    do forever
      step_status = sqlitestep(prepared)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot execute lexical retrieval"; return -1; end
      chunk_id = ""; raw_score = 0.0
      if sqlitecolumntext(prepared, 0, chunk_id) \= 0 | sqlitecolumnreal(prepared, 1, raw_score) \= 0 then do; call sqlitefinalize prepared; error = "cannot decode lexical retrieval"; return -1; end
      existing_index = _candidateindex(candidate_ids, chunk_id)
      if existing_index = 0 & candidate_ids.0 >= maximum then iterate
      index = _candidate(chunk_id, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values)
      if lexical_ranks[index] = 0 then do; lexical_ranks[index] = next_rank; next_rank = next_rank + 1; end
      hits = hits + 1
    end
    call sqlitefinalize prepared
    trace_notes[trace_notes.0 + 1] = "lexical[" || variants[v].kind() || "]=" || hits || ";per-variant-limit=" || variant_limit
  end
  neighbor_count = _lexicalneighbors(database, plan.generation(), maximum, next_rank, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values, error)
  if neighbor_count < 0 then return -1
  trace_notes[trace_notes.0 + 1] = "lexical-context-neighbors=" || neighbor_count || ";candidate-ceiling=" || maximum
  return 0

_lexicalneighbors: procedure = .int
  arg database = .binary, generation = .int, maximum = .int, expose next_rank = .int, expose candidate_ids = .string[], expose lexical_ranks = .int[], expose vector_ranks = .int[], expose graph_ranks = .int[], expose vector_scores = .float[], expose graph_hops = .int[], expose directness_values = .float[], expose error = .string
  direct_count = candidate_ids.0; added = 0
  do i = 1 to direct_count
    if candidate_ids.0 >= maximum then leave
    prepared = .binary
    sql = "SELECT n.revision_chunk_id FROM revision_chunks rc JOIN revision_chunks n ON n.revision_id=rc.revision_id AND (n.ordinal=rc.ordinal-1 OR n.ordinal=rc.ordinal+1) WHERE rc.revision_chunk_id=?1 AND n.visible_from_generation<=?2 AND (n.visible_to_generation IS NULL OR n.visible_to_generation>?2) ORDER BY abs(n.ordinal-rc.ordinal),n.ordinal"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, candidate_ids[i]) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare lexical context expansion"; return -1; end
    do forever
      step_status = sqlitestep(prepared)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read lexical context expansion"; return -1; end
      neighbor_id = ""
      if sqlitecolumntext(prepared, 0, neighbor_id) \= 0 then do; call sqlitefinalize prepared; error = "cannot decode lexical context expansion"; return -1; end
      if _candidateindex(candidate_ids, neighbor_id) = 0 & candidate_ids.0 < maximum then do
        index = _candidate(neighbor_id, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values)
        if lexical_ranks[i] > 0 then lexical_ranks[index] = lexical_ranks[i]
        else do; lexical_ranks[index] = next_rank; next_rank = next_rank + 1; end
        added = added + 1
      end
    end
    call sqlitefinalize prepared
  end
  return added

_vector: procedure = .int
  arg store = .ragstorehandle, generation = .int, retrieval_options = .ragretrievaloptions, expose candidate_ids = .string[], expose lexical_ranks = .int[], expose vector_ranks = .int[], expose graph_ranks = .int[], expose vector_scores = .float[], expose graph_hops = .int[], expose directness_values = .float[], expose vector_state = .string, expose trace_notes = .string[], expose error = .string
  profile_id = retrieval_options.embedding_profile_id(); query_wire = retrieval_options.query_vector()
  if profile_id = "" | binlength(query_wire) = 0 then do; vector_state = "disabled-incomplete-options"; return 0; end
  dimension = _scalarint(store.database(), "SELECT dimension FROM embedding_profiles WHERE embedding_profile_id=" || _q(profile_id))
  if dimension < 1 | binlength(query_wire) \= dimension * 4 then do; vector_state = "fallback-query-dimension"; trace_notes[trace_notes.0 + 1] = "vector-fallback=query-dimension"; return 0; end
  store_status = .ragstorestatus; status_error = ""
  if storagestatus(store, store_status, status_error) \= 0 | store_status.manifest_state() \= "aligned" then do; vector_state = "fallback-manifest"; trace_notes[trace_notes.0 + 1] = "vector-fallback=manifest"; return 0; end
  prepared = .binary
  sql = "SELECT sidecar_name,sidecar_checksum,row_count,centroid_count,probe_count,semantic_generation FROM vector_generations WHERE state='published' AND algorithm='ivf-flat-v1' AND " || compatiblevectorpredicate("?1") || " AND embedding_profile_id=?2 AND dimension=?3"
  if sqliteprepare(store.database(), sql, prepared) \= 0 | sqlitebindint(prepared, 1, generation) \= 0 | sqlitebindtext(prepared, 2, profile_id) \= 0 | sqlitebindint(prepared, 3, dimension) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare ANN generation lookup"; return -1; end
  if sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; vector_state = "fallback-stale-or-missing-generation"; trace_notes[trace_notes.0 + 1] = "vector-fallback=stale-or-missing-generation"; return 0; end
  sidecar_name = ""; sidecar_checksum = ""; total_rows = 0; centroid_count = 0; probe_count = 0; index_generation = 0
  column_status = sqlitecolumntext(prepared, 0, sidecar_name) | sqlitecolumntext(prepared, 1, sidecar_checksum) | sqlitecolumnint(prepared, 2, total_rows) | sqlitecolumnint(prepared, 3, centroid_count) | sqlitecolumnint(prepared, 4, probe_count) | sqlitecolumnint(prepared, 5, index_generation)
  if column_status \= 0 | sqlitestep(prepared) \= 101 then do; call sqlitefinalize prepared; error = "ANN generation identity is ambiguous or invalid"; return -1; end
  call sqlitefinalize prepared
  raw = .binary; byte_count = 0
  if ragfile..readbinaryfilebounded(store.path() || "/" || sidecar_name, retrieval_options.maximum_sidecar_bytes(), raw, byte_count, error) \= 0 | rxhash..sha256hex(raw) \= sidecar_checksum then do; vector_state = "fallback-invalid-ann-sidecar"; trace_notes[trace_notes.0 + 1] = "vector-fallback=invalid-ann-sidecar"; error = ""; return 0; end
  document = .jsondocument(raw as .string)
  if document.valid() \= 1 | document.node_type(document.root()) \= "object" | document.node_count(document.root()) \= 12 then do; error = "ANN sidecar schema is invalid"; return -1; end
  root = document.root(); schema = ""; algorithm = ""; codec = ""; storage = ""; side_profile = ""; centroid_hex = ""
  side_generation = 0; side_dimension = 0; side_rows = 0; side_centroids = 0; side_probes = 0
  if document.node_string(document.member(root, "schema"), schema) \= 0 | document.node_string(document.member(root, "algorithm"), algorithm) \= 0 | document.node_string(document.member(root, "codec"), codec) \= 0 | document.node_string(document.member(root, "storage"), storage) \= 0 | document.node_int(document.member(root, "semantic_generation"), side_generation) \= 0 | document.node_string(document.member(root, "embedding_profile_id"), side_profile) \= 0 | document.node_int(document.member(root, "dimension"), side_dimension) \= 0 | document.node_int(document.member(root, "row_count"), side_rows) \= 0 | document.node_int(document.member(root, "centroid_count"), side_centroids) \= 0 | document.node_int(document.member(root, "probe_count"), side_probes) \= 0 | document.node_string(document.member(root, "centroids_f32le"), centroid_hex) \= 0 then do; error = "ANN sidecar fields are invalid"; return -1; end
  clusters_node = document.member(root, "clusters")
  if schema \= "crexx-rag.rxvector-ann/1" | algorithm \= "ivf-flat-v1" | codec \= "f32le-v1" | storage \= "sqlite-embedding-blobs" | side_generation \= index_generation | side_profile \= profile_id | side_dimension \= dimension | side_rows \= total_rows | side_centroids \= centroid_count | side_probes \= probe_count | length(centroid_hex) \= centroid_count * dimension * 8 | document.node_type(clusters_node) \= "array" | document.node_count(clusters_node) \= centroid_count then do; error = "ANN sidecar does not match the active generation"; return -1; end
  query_vector = rxvector..decodef32le(query_wire)
  centroid_wire = .binary
  if _hexwire(centroid_hex, centroid_wire) \= 0 then do; error = "ANN centroid encoding is invalid"; return -1; end
  centroid_vectors = rxvector..decodef32le(centroid_wire); centroid_ids = .packedint(centroid_count)
  do c = 0 to centroid_count - 1; call centroid_ids.set(c, c + 1); end
  if query_vector.size() \= dimension | centroid_vectors.size() \= centroid_count * dimension | centroid_ids.size() \= centroid_count then do; error = "ANN centroid probe owner shapes are invalid: query=" || query_vector.size() || ", matrix=" || centroid_vectors.size() || ", identities=" || centroid_ids.size(); return -1; end
  if _positivepackednorm(query_vector) \= 1 | _allrowspositive(centroid_vectors, centroid_count, dimension) \= 1 then do; error = "ANN centroid probe contains a zero-norm vector"; return -1; end
  probed_ids = .packedint(0); probe_scores = .packedfloat(0)
  call rxvector..topkcosine(centroid_vectors, centroid_ids, dimension, query_vector, probe_count, probed_ids, probe_scores)
  member_ids = .string[]; member_digests = .string[]
  do p = 0 to probed_ids.size() - 1
    cluster_number = probed_ids.get(p); cluster_node = document.element(clusters_node, cluster_number); encoded_cluster = 0
    members_node = document.member(cluster_node, "members")
    if document.node_type(cluster_node) \= "object" | document.node_count(cluster_node) \= 2 | document.node_int(document.member(cluster_node, "cluster"), encoded_cluster) \= 0 | encoded_cluster \= cluster_number | document.node_type(members_node) \= "array" then do; error = "ANN cluster is invalid"; return -1; end
    do m = 1 to document.node_count(members_node)
      member = document.element(members_node, m); chunk_id = ""; input_digest = ""
      if document.node_type(member) \= "object" | document.node_count(member) \= 2 | document.node_string(document.member(member, "revision_chunk_id"), chunk_id) \= 0 | document.node_string(document.member(member, "input_digest"), input_digest) \= 0 | chunk_id = "" | length(input_digest) \= 64 then do; error = "ANN cluster member is invalid"; return -1; end
      if _contains(member_ids, chunk_id) = 0 then do; member_ids[member_ids.0 + 1] = chunk_id; member_digests[member_ids.0] = input_digest; end
      if member_ids.0 > retrieval_options.vector_scan_limit() then do; vector_state = "fallback-ann-candidate-ceiling"; trace_notes[trace_notes.0 + 1] = "vector-fallback=ann-candidate-ceiling"; return 0; end
    end
  end
  if member_ids.0 < 1 then do; error = "ANN probes selected no members"; return -1; end
  page_size = 128; offset = 1; searched = 0
  member_sql = "SELECT e.vector FROM revision_chunk_embeddings rce JOIN embeddings e ON e.embedding_id=rce.embedding_id JOIN revision_chunks rc ON rc.revision_chunk_id=rce.revision_chunk_id WHERE rc.revision_chunk_id=?1 AND e.embedding_profile_id=?2 AND e.dimension=?3 AND e.input_digest=?5 AND rce.visible_from_generation<=?4 AND (rce.visible_to_generation IS NULL OR rce.visible_to_generation>?4) AND rc.visible_from_generation<=?4 AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>?4)"
  do while offset <= member_ids.0
    prepared = .binary
    if sqliteprepare(store.database(),member_sql,prepared) \= 0 then do; error = "cannot prepare ANN member lookup"; return -1; end
    page_wire = .binary; page_ids = .string[]; page_owners = .packedint(page_size); page_rows = 0
    scanned = 0
    do m = offset to member_ids.0
      if scanned >= page_size then leave
      scanned = scanned + 1
      if sqlitebindtext(prepared, 1, member_ids[m]) \= 0 | sqlitebindtext(prepared, 2, profile_id) \= 0 | sqlitebindint(prepared, 3, dimension) \= 0 | sqlitebindint(prepared, 4, generation) \= 0 | sqlitebindtext(prepared, 5, member_digests[m]) \= 0 then do; call sqlitefinalize prepared; error = "cannot bind ANN member vector"; return -1; end
      member_step = sqlitestep(prepared)
      if member_step = 100 then do
        vector_wire = .binary
        if sqlitecolumnblob(prepared, 0, vector_wire) \= 0 | binlength(vector_wire) \= dimension * 4 | sqlitestep(prepared) \= 101 then do; call sqlitefinalize prepared; error = "cannot decode unique ANN member vector"; return -1; end
        page_ids[page_ids.0 + 1] = member_ids[m]
        call page_owners.set(page_rows, page_ids.0)
        call binappend page_wire, vector_wire
        page_rows = page_rows + 1
      end
      else if member_step \= 101 then do; call sqlitefinalize prepared; error = "cannot resolve ANN member vector"; return -1; end
      if sqlitereset(prepared) \= 0 | sqliteclearbindings(prepared) \= 0 then do; call sqlitefinalize prepared; error = "cannot reset ANN member lookup"; return -1; end
    end
    call sqlitefinalize prepared
    offset = offset + scanned
    if page_ids.0 = 0 then iterate
    call page_owners.resize(page_rows)
    page_vectors = rxvector..decodef32le(page_wire)
    requested = retrieval_options.vector_limit()
    if requested > page_ids.0 then requested = page_ids.0
    if page_vectors.size() \= page_rows * dimension | page_owners.size() \= page_rows then do; error = "ANN member page owner shapes are invalid: matrix=" || page_vectors.size() || ", identities=" || page_owners.size() || ", rows=" || page_rows; return -1; end
    if _allrowspositive(page_vectors, page_rows, dimension) \= 1 then do; error = "ANN member page contains a zero-norm vector"; return -1; end
    result_ids = .packedint(0); result_scores = .packedfloat(0)
    call rxvector..topkcosine(page_vectors, page_owners, dimension, query_vector, requested, result_ids, result_scores)
    do i = 0 to result_ids.size() - 1
      owner = result_ids.get(i); similarity = result_scores.get(i)
      index = _candidate(page_ids[owner], candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values)
      if similarity > vector_scores[index] | vector_ranks[index] = 0 then vector_scores[index] = similarity
    end
    searched = searched + page_ids.0
  end
  call _rankvectors(candidate_ids, vector_ranks, vector_scores, retrieval_options.vector_limit())
  vector_state = "active-ann-ivf-rxvector"
  trace_notes[trace_notes.0 + 1] = "vector-candidates=" || searched || ";total-rows=" || total_rows || ";centroids=" || centroid_count || ";probes=" || probe_count || ";dimension=" || dimension || ";backend=rxvector-ivf-flat"
  return 0

_hexwire: procedure = .int
  arg hexadecimal = .string, expose wire = .binary
  hexadecimal_length = length(hexadecimal)
  if hexadecimal_length % 2 <> 0 then return -1
  byte_count = hexadecimal_length / 2
  call binresize wire, byte_count
  do offset = 0 to byte_count - 1
    byte_text = substr(hexadecimal, offset * 2 + 1, 2)
    if verify(byte_text, "0123456789abcdef") \= 0 then return -1
    <at..u8>(offset) wire = x2d(byte_text)
  end
  return 0

_positivepackednorm: procedure = .int
  arg vector = .packedfloat
  norm_squared = 0.0
  do i = 0 to vector.size() - 1
    value = vector.get(i); norm_squared = norm_squared + value * value
  end
  return norm_squared > 0.0

_allrowspositive: procedure = .int
  arg vectors = .packedfloat, rows = .int, dimension = .int
  do row = 0 to rows - 1
    norm_squared = 0.0
    do d = 0 to dimension - 1
      value = vectors.get(row * dimension + d); norm_squared = norm_squared + value * value
    end
    if norm_squared <= 0.0 then return 0
  end
  return 1

_graph: procedure = .int
  arg database = .binary, generation = .int, plan = .ragqueryplan, maximum_hops = .int, graph_direction = .string, expose candidate_ids = .string[], expose lexical_ranks = .int[], expose vector_ranks = .int[], expose graph_ranks = .int[], expose vector_scores = .float[], expose graph_hops = .int[], expose directness_values = .float[], expose claim_ids = .string[], expose claim_hops = .int[], expose trace_notes = .string[], expose error = .string, retrieval_options = .ragretrievaloptions, expose claim_paths = .string[]
  anchors = .string[]
  if _anchors(database, generation, plan.normalized_question(), anchors, error) \= 0 then return -1
  query_period = .ragperiod(retrieval_options.temporal_query()); filtered = retrieval_options.temporal_query() \= ""
  frontier = anchors; visited = .string[]; next_rank = 1
  frontier_low = .string[]; frontier_high = .string[]; frontier_paths = .string[]; frontier_unknown = .int[]
  do a = 1 to anchors.0
    frontier_low[a]=""; frontier_high[a]=""; frontier_paths[a]="[]"; frontier_unknown[a]=0
    if filtered then do; frontier_low[a]=query_period.lower(); frontier_high[a]=query_period.upper(); end
  end
  do hop = 1 to maximum_hops
    next_frontier = .string[]; next_low=.string[]; next_high=.string[]; next_paths=.string[]; next_unknown=.int[]; next_keys=.string[]
    do f = 1 to frontier.0
      concept_id = frontier[f]
      visit_key=concept_id || ":" || frontier_low[f] || ":" || frontier_high[f] || ":" || frontier_unknown[f]
      if _contains(visited,visit_key)=1 then iterate
      visited[visited.0+1]=visit_key
      prepared = .binary
      if graph_direction = "outbound" then sql = "SELECT c.claim_id,c.target_concept_id,s.revision_chunk_id,s.directness,c.qualifiers_json FROM claims c JOIN claim_support s ON s.claim_id=c.claim_id WHERE c.source_concept_id=?1 AND c.visible_from_generation<=?2 AND (c.visible_to_generation IS NULL OR c.visible_to_generation>?2) AND s.visible_from_generation<=?2 AND (s.visible_to_generation IS NULL OR s.visible_to_generation>?2) ORDER BY c.claim_id,s.support_id"
      else if graph_direction = "inbound" then sql = "SELECT c.claim_id,c.source_concept_id,s.revision_chunk_id,s.directness,c.qualifiers_json FROM claims c JOIN claim_support s ON s.claim_id=c.claim_id WHERE c.target_concept_id=?1 AND c.visible_from_generation<=?2 AND (c.visible_to_generation IS NULL OR c.visible_to_generation>?2) AND s.visible_from_generation<=?2 AND (s.visible_to_generation IS NULL OR s.visible_to_generation>?2) ORDER BY c.claim_id,s.support_id"
      else sql = "SELECT c.claim_id,CASE WHEN c.source_concept_id=?1 THEN c.target_concept_id ELSE c.source_concept_id END,s.revision_chunk_id,s.directness,c.qualifiers_json FROM claims c JOIN claim_support s ON s.claim_id=c.claim_id WHERE (c.source_concept_id=?1 OR c.target_concept_id=?1) AND c.visible_from_generation<=?2 AND (c.visible_to_generation IS NULL OR c.visible_to_generation>?2) AND s.visible_from_generation<=?2 AND (s.visible_to_generation IS NULL OR s.visible_to_generation>?2) ORDER BY c.claim_id,s.support_id"
      if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, concept_id) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare directed graph retrieval"; return -1; end
      do forever
        step_status = sqlitestep(prepared)
        if step_status = 101 then leave
        if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read directed graph retrieval"; return -1; end
        claim_id = ""; adjacent = ""; chunk_id = ""; directness = ""
        if sqlitecolumntext(prepared, 0, claim_id) \= 0 | sqlitecolumntext(prepared, 1, adjacent) \= 0 | sqlitecolumntext(prepared, 2, chunk_id) \= 0 | sqlitecolumntext(prepared, 3, directness) \= 0 then do; call sqlitefinalize prepared; error = "cannot decode directed graph retrieval"; return -1; end
        qualifiers=""; ignored=sqlitecolumntext(prepared,4,qualifiers); period=_period(qualifiers); period_match="not-requested"
        if filtered then period_match=periodcompatibility(period,query_period)
        if period_match="disjoint" | (period_match="unknown" & retrieval_options.time_unknown()="exclude") then iterate
        low=frontier_low[f]; high=frontier_high[f]; unknown=frontier_unknown[f]
        if period.lower()\="" then if low="" | period.lower()>low then low=period.lower()
        if period.upper()\="" then if high="" | period.upper()<high then high=period.upper()
        if period.lower()="" | period.upper()="" | period.uncertain()=1 then unknown=1
        disjoint=low\="" & high\="" & low>high
        if filtered & disjoint then do; trace_notes[trace_notes.0+1]="temporal-path-rejected=" || claim_id || ";reason=no-common-period"; iterate; end
        chain=frontier_paths[f]; chain=left(chain,length(chain)-1)
        if chain\="[" then chain=chain || ","
        chain=chain || jsonquote(claim_id) || "]"
        compatibility="possible-common-period"
        if disjoint then compatibility="non-contemporaneous"
        else if unknown then compatibility="unknown-common-period"
        path='{"claim_ids":' || chain || ',"possible_start":' || jsonquote(low) || ',"possible_end":' || jsonquote(high) || ',"compatibility":' || jsonquote(compatibility) || '}'
        qualifier_doc=.jsondocument(qualifiers); modality="asserted"; ignored=qualifier_doc.node_string(qualifier_doc.member(qualifier_doc.root(),"modality"),modality)
        index = _candidate(chunk_id, candidate_ids, lexical_ranks, vector_ranks, graph_ranks, vector_scores, graph_hops, directness_values)
        if graph_ranks[index] = 0 then do; graph_ranks[index] = next_rank; next_rank = next_rank + 1; graph_hops[index] = hop; end
        if directness = "direct" then directness_values[index] = 1.0
        if _contains(claim_ids, claim_id) = 0 then do; claim_ids[claim_ids.0 + 1] = claim_id; claim_hops[claim_hops.0 + 1] = hop; claim_paths[claim_paths.0+1]=path; end
        next_key=adjacent || ":" || low || ":" || high || ":" || unknown
        if _contains(next_keys,next_key)=1 then iterate
        if modality="asserted" & next_frontier.0<2048 then do
          next_keys[next_keys.0+1]=next_key
          n=next_frontier.0+1; next_frontier[n]=adjacent; next_low[n]=low; next_high[n]=high; next_paths[n]=chain; next_unknown[n]=unknown
        end
        else if next_frontier.0>=2048 then trace_notes[trace_notes.0+1]="temporal-frontier-truncated=2048"
      end
      call sqlitefinalize prepared
    end
    frontier = next_frontier; frontier_low=next_low; frontier_high=next_high; frontier_paths=next_paths; frontier_unknown=next_unknown
    if frontier.0 = 0 then leave
  end
  trace_notes[trace_notes.0 + 1] = "graph-anchors=" || anchors.0 || ";supported-claims=" || claim_ids.0 || ";traversal=" || graph_direction || ";claims-preserve-stored-direction=1"
  return 0

_rankandpassages: procedure = .int
  arg database = .binary, library_id = .string, generation = .int, profile = .ragprofile, plan = .ragqueryplan, retrieval_options = .ragretrievaloptions, candidate_ids = .string[], lexical_ranks = .int[], vector_ranks = .int[], graph_ranks = .int[], vector_scores = .float[], graph_hops = .int[], directness_values = .float[], expose final_scores = .float[], expose passages = .ragpassage[], expose selected_ids = .string[], expose selected_sources = .string[], expose selected_contents = .string[], expose trace_notes = .string[], expose error = .string
  lexical_weight = _weight(profile, "lexical", 1.0); vector_weight = _weight(profile, "semantic", 1.0); graph_weight = _weight(profile, "graph", 1.0)
  base_scores = .float[]; citations = .ragcitation[]; titles = .string[]; bodies = .string[]; source_types = .string[]
  captured_values = .string[]; event_starts = .string[]; event_ends = .string[]; evidence_classes = .string[]; source_ids = .string[]; content_ids = .string[]
  selected_flags = .int[]; excluded_flags = .int[]
  do i = 1 to candidate_ids.0
    rrf = 0.0
    if lexical_ranks[i] > 0 then rrf = rrf + lexical_weight / (retrieval_options.rrf_k() + lexical_ranks[i])
    if vector_ranks[i] > 0 then rrf = rrf + vector_weight / (retrieval_options.rrf_k() + vector_ranks[i])
    if graph_ranks[i] > 0 then rrf = rrf + graph_weight / (retrieval_options.rrf_k() + graph_ranks[i])
    graph_boost = 0.0
    if graph_hops[i] > 0 then graph_boost = (retrieval_options.graph_boost_millionths() / 1000000.0) * ((retrieval_options.graph_decay_millionths() / 1000000.0) ** (graph_hops[i] - 1))
    directness_bonus = directness_values[i] * (retrieval_options.directness_bonus_millionths() / 1000000.0)
    base_scores[i] = rrf + graph_boost + directness_bonus
    selected_flags[i] = 0; excluded_flags[i] = 0
  end
  if _chunks(database, library_id, generation, candidate_ids, citations, titles, bodies, source_types, captured_values, event_starts, event_ends, evidence_classes, source_ids, content_ids, error) \= 0 then return -1
  distinct_sources = _distinctcount(source_ids)
  source_cap = retrieval_options.passage_limit()
  if distinct_sources > 1 then do
    source_cap = ((retrieval_options.passage_limit() + distinct_sources - 1) / distinct_sources) as .int
    if source_cap < 3 then source_cap = 3
  end
  trace_notes[trace_notes.0 + 1] = "diversity-source-count=" || distinct_sources || ";per-source-cap=" || source_cap
  do while passages.0 < retrieval_options.passage_limit()
    best_index = 0; best_score = -1000000.0; best_duplicate_penalty = 0.0; best_source_quality = 0.0; best_temporal = 0.0
    do i = 1 to candidate_ids.0
      if selected_flags[i] = 1 | excluded_flags[i] = 1 then iterate
      if _sourcecount(selected_sources, source_ids[i]) >= source_cap then do
        excluded_flags[i] = 1
        trace_notes[trace_notes.0 + 1] = "diversity-skip=" || candidate_ids[i] || ";reason=source-cap"
        iterate
      end
      duplicate_penalty = 0.0
      if _contains(selected_contents, content_ids[i]) = 1 then duplicate_penalty = 0.05
      source_quality = 0.0
      if evidence_classes[i] = "narrative" then source_quality = 0.002
      if evidence_classes[i] = "index" | evidence_classes[i] = "caption" then source_quality = -0.002
      temporal = 0.0
      if _hasintent(plan.intents(), "time") = 1 & (event_starts[i] \= "" | event_ends[i] \= "") then temporal = 0.001
      adjusted = base_scores[i] + source_quality + temporal - duplicate_penalty
      if best_index = 0 | adjusted > best_score | (adjusted = best_score & candidate_ids[i] < candidate_ids[best_index]) then do
        best_index = i; best_score = adjusted; best_duplicate_penalty = duplicate_penalty; best_source_quality = source_quality; best_temporal = temporal
      end
    end
    if best_index = 0 then leave
    index = best_index; selected_flags[index] = 1; final_scores[index] = best_score
    channels = .string[]
    if lexical_ranks[index] > 0 then channels[channels.0 + 1] = "lexical"
    if vector_ranks[index] > 0 then channels[channels.0 + 1] = "vector"
    if graph_ranks[index] > 0 then channels[channels.0 + 1] = "graph"
    score_parts = .ragscore[]
    score_parts[score_parts.0 + 1] = .ragscore("rrf-final", best_score)
    if lexical_ranks[index] > 0 then score_parts[score_parts.0 + 1] = .ragscore("lexical-rank", lexical_ranks[index])
    if vector_ranks[index] > 0 then score_parts[score_parts.0 + 1] = .ragscore("vector-similarity", vector_scores[index])
    if graph_hops[index] > 0 then score_parts[score_parts.0 + 1] = .ragscore("graph-hop-decay", (retrieval_options.graph_decay_millionths() / 1000000.0) ** (graph_hops[index] - 1))
    score_parts[score_parts.0 + 1] = .ragscore("directness-bonus", directness_values[index] * (retrieval_options.directness_bonus_millionths() / 1000000.0))
    score_parts[score_parts.0 + 1] = .ragscore("temporal-relevance", best_temporal)
    score_parts[score_parts.0 + 1] = .ragscore("source-quality", best_source_quality)
    score_parts[score_parts.0 + 1] = .ragscore("duplication-penalty", best_duplicate_penalty)
    directness = "lead"
    if directness_values[index] > 0.0 then directness = "direct"
    passages[passages.0 + 1] = .ragpassage(citations[index], titles[index], bodies[index], source_types[index], 1.0, _capturevalue(database,captured_values[index]), event_starts[index], event_ends[index], evidence_classes[index], directness, channels, score_parts, provenancecontext(database,candidate_ids[index],generation), captured_values[index])
    selected_ids[selected_ids.0 + 1] = candidate_ids[index]; selected_sources[selected_sources.0 + 1] = source_ids[index]; selected_contents[selected_contents.0 + 1] = content_ids[index]
  end
  return 0

_claims: procedure = .int
  arg database = .binary, library_id = .string, generation = .int, maximum = .int, claim_ids = .string[], claim_hops = .int[], selected_chunks = .string[], expose claims = .ragacceptedclaim[], expose trace_notes = .string[], expose error = .string, retrieval_options = .ragretrievaloptions, claim_paths = .string[]
  do c = 1 to claim_ids.0
    if claims.0 >= maximum then leave
    prepared = .binary
    sql = "SELECT c.source_concept_id,sc.canonical_label,c.relationship_type,c.target_concept_id,tc.canonical_label,c.direction,COALESCE(c.effective_from,''),COALESCE(c.effective_to,''),c.qualifiers_json FROM claims c JOIN concepts sc ON sc.concept_id=c.source_concept_id JOIN concepts tc ON tc.concept_id=c.target_concept_id WHERE c.claim_id=?1 AND c.visible_from_generation<=?2 AND (c.visible_to_generation IS NULL OR c.visible_to_generation>?2)"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, claim_ids[c]) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare accepted claim"; return -1; end
    if sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; iterate; end
    source_id = ""; subject = ""; relationship = ""; target_id = ""; object = ""; direction = ""; effective_start = ""; effective_end = ""; qualifiers = ""
    column_status = sqlitecolumntext(prepared, 0, source_id) | sqlitecolumntext(prepared, 1, subject) | sqlitecolumntext(prepared, 2, relationship) | sqlitecolumntext(prepared, 3, target_id) | sqlitecolumntext(prepared, 4, object) | sqlitecolumntext(prepared, 5, direction) | sqlitecolumntext(prepared, 6, effective_start) | sqlitecolumntext(prepared, 7, effective_end) | sqlitecolumntext(prepared, 8, qualifiers)
    call sqlitefinalize prepared
    if column_status \= 0 then do; error = "cannot decode accepted claim"; return -1; end
    supports = .ragsupportcitation[]; support_selected = 0; asserted_at = ""
    support_statement = .binary
    sql = "SELECT s.revision_chunk_id,s.span_start,s.span_end,s.polarity,s.stance,s.attribution,s.lineage_group,rc.normalized_start,r.revision_id,r.source_id,r.captured_at,s.support_id,s.directness FROM claim_support s JOIN revision_chunks rc ON rc.revision_chunk_id=s.revision_chunk_id JOIN source_revisions r ON r.revision_id=rc.revision_id WHERE s.claim_id=?1 AND s.visible_from_generation<=?2 AND (s.visible_to_generation IS NULL OR s.visible_to_generation>?2) ORDER BY s.support_id"
    if sqliteprepare(database, sql, support_statement) \= 0 | sqlitebindtext(support_statement, 1, claim_ids[c]) \= 0 | sqlitebindint(support_statement, 2, generation) \= 0 then do; call sqlitefinalize support_statement; error = "cannot prepare claim support"; return -1; end
    do forever
      step_status = sqlitestep(support_statement)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize support_statement; error = "cannot read claim support"; return -1; end
      chunk_id = ""; span_start = 0; span_end = 0; polarity = ""; stance = ""; attribution = ""; lineage = ""; chunk_start = 0; revision_id = ""; support_source = ""; captured_at = ""; support_id = ""; directness = ""
      column_status = sqlitecolumntext(support_statement, 0, chunk_id) | sqlitecolumnint(support_statement, 1, span_start) | sqlitecolumnint(support_statement, 2, span_end) | sqlitecolumntext(support_statement, 3, polarity) | sqlitecolumntext(support_statement, 4, stance) | sqlitecolumntext(support_statement, 5, attribution) | sqlitecolumntext(support_statement, 6, lineage) | sqlitecolumnint(support_statement, 7, chunk_start) | sqlitecolumntext(support_statement, 8, revision_id) | sqlitecolumntext(support_statement, 9, support_source) | sqlitecolumntext(support_statement, 10, captured_at) | sqlitecolumntext(support_statement,11,support_id) | sqlitecolumntext(support_statement,12,directness)
      if column_status \= 0 then do; call sqlitefinalize support_statement; error = "cannot decode claim support"; return -1; end
      stable = _stablecitation(library_id, support_source, revision_id, chunk_start + span_start, chunk_start + span_end)
      citation = .ragcitation(stable, support_source, revision_id, chunk_start + span_start, chunk_start + span_end)
      supports[supports.0 + 1] = .ragsupportcitation(citation, polarity, stance, attribution, lineage,support_id,directness,supportmetadata(database,support_id,generation),sourcemetadata(database,revision_id,chunk_start+span_start,chunk_start+span_end,generation),supportfamilies(database,support_id,generation),_capturevalue(database,captured_at),captured_at)
      if _contains(selected_chunks, chunk_id) = 1 then support_selected = 1
    end
    call sqlitefinalize support_statement
    if supports.0 = 0 | support_selected = 0 then iterate
    conflicts = .string[]
    conflict_statement = .binary
    sql = "SELECT competing_claim_id||':'||review_state FROM claim_conflicts WHERE claim_id=?1 AND visible_from_generation<=?2 AND (visible_to_generation IS NULL OR visible_to_generation>?2) ORDER BY conflict_id"
    if sqliteprepare(database, sql, conflict_statement) \= 0 | sqlitebindtext(conflict_statement, 1, claim_ids[c]) \= 0 | sqlitebindint(conflict_statement, 2, generation) \= 0 then do; call sqlitefinalize conflict_statement; error = "cannot prepare claim conflict"; return -1; end
    do forever
      step_status = sqlitestep(conflict_statement)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize conflict_statement; error = "cannot read claim conflict"; return -1; end
      conflict = ""; if sqlitecolumntext(conflict_statement, 0, conflict) \= 0 then do; call sqlitefinalize conflict_statement; error = "cannot decode claim conflict"; return -1; end
      conflicts[conflicts.0 + 1] = conflict
    end
    call sqlitefinalize conflict_statement
    temporal_match="not-requested"
    if retrieval_options.temporal_query()\="" then temporal_match=periodcompatibility(_period(qualifiers),.ragperiod(retrieval_options.temporal_query()))
    confidence = 1.0
    breakdown = .ragscore[]; breakdown[1] = .ragscore("support-count", supports.0); breakdown[2] = .ragscore("hop-decay", 0.75 ** (claim_hops[c] - 1))
    claims[claims.0 + 1] = .ragacceptedclaim(claim_ids[c], subject, relationship, object, direction, confidence, effective_start, effective_end, asserted_at, supports, breakdown, conflicts,qualifiers,temporal_match,claim_paths[c],_families(supports))
  end
  trace_notes[trace_notes.0 + 1] = "accepted-claims=" || claims.0 || ";support-required=1"
  return 0

_retrievedambiguities: procedure = .int
  arg database = .binary, generation = .int, selected_ids = .string[], expose ambiguities = .string[], expose error = .string
  do i = 1 to selected_ids.0
    prepared = .binary
    sql = "SELECT DISTINCT ambiguity_id FROM ambiguity_candidates WHERE revision_chunk_id=?1 AND visible_from_generation<=?2 AND (visible_to_generation IS NULL OR visible_to_generation>?2) ORDER BY ambiguity_id"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, selected_ids[i]) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare ambiguity retrieval"; return -1; end
    do forever
      step_status = sqlitestep(prepared)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read ambiguity retrieval"; return -1; end
      ambiguity = ""; if sqlitecolumntext(prepared, 0, ambiguity) \= 0 then do; call sqlitefinalize prepared; error = "cannot decode ambiguity retrieval"; return -1; end
      if _contains(ambiguities, ambiguity) = 0 then ambiguities[ambiguities.0 + 1] = ambiguity
    end
    call sqlitefinalize prepared
  end
  return 0

_leads: procedure = .int
  arg database = .binary, generation = .int, selected_ids = .string[], accepted_claim_ids = .string[], maximum = .int, expose leads = .raggraphlead[], expose error = .string
  do i = 1 to selected_ids.0
    if leads.0 >= maximum then leave
    labels = .string[]; mentions = .string[]
    prepared = .binary
    sql = "SELECT m.mention_id,c.canonical_label FROM mentions m JOIN concepts c ON c.concept_id=m.concept_id WHERE m.revision_chunk_id=?1 AND m.visible_from_generation<=?2 AND (m.visible_to_generation IS NULL OR m.visible_to_generation>?2) ORDER BY m.mention_id LIMIT 3"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, selected_ids[i]) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare graph leads"; return -1; end
    do forever
      step_status = sqlitestep(prepared)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read graph leads"; return -1; end
      mention = ""; label = ""
      if sqlitecolumntext(prepared, 0, mention) \= 0 | sqlitecolumntext(prepared, 1, label) \= 0 then do; call sqlitefinalize prepared; error = "cannot decode graph leads"; return -1; end
      mentions[mentions.0 + 1] = mention; labels[labels.0 + 1] = label
    end
    call sqlitefinalize prepared
    if labels.0 >= 2 then leads[leads.0 + 1] = .raggraphlead(labels, "co-mention passage worth inspecting", mentions, "co-mention and adjacency do not establish a typed relationship")
  end
  return 0

_analysisnotes: procedure = .int
  arg database = .binary, library_id = .string, generation = .int, selected_ids = .string[], maximum = .int, expose notes = .raganalysisnote[], expose error = .string
  do i = 1 to selected_ids.0
    if notes.0 >= maximum then leave
    prepared = .binary
    sql = "SELECT DISTINCT n.note_id,n.note_kind,n.text,n.importance,n.uncertainty,n.next_action,n.state,n.author,l.object_type,l.object_id,s.source_id,r.revision_id,rc.normalized_start,l.span_start,l.span_end FROM analysis_notes n JOIN analysis_note_links l ON l.note_id=n.note_id JOIN revision_chunks rc ON rc.revision_chunk_id=l.revision_chunk_id JOIN source_revisions r ON r.revision_id=rc.revision_id JOIN sources s ON s.source_id=r.source_id WHERE n.state='active' AND l.revision_chunk_id=?1 AND rc.visible_from_generation<=?2 AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>?2) ORDER BY n.importance DESC,n.note_id LIMIT ?3"
    if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindtext(prepared, 1, selected_ids[i]) \= 0 | sqlitebindint(prepared, 2, generation) \= 0 | sqlitebindint(prepared, 3, maximum) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare analysis-note retrieval"; return -1; end
    do forever
      step_status = sqlitestep(prepared)
      if step_status = 101 then leave
      if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read analysis notes"; return -1; end
      note_id = ""; kind = ""; note_text = ""; next_action = ""; state = ""; author = ""; object_type = ""; object_id = ""; source_id = ""; revision_id = ""
      importance = 0; uncertainty = 0; chunk_start = 0; span_start = 0; span_end = 0
      columns = sqlitecolumntext(prepared, 0, note_id) | sqlitecolumntext(prepared, 1, kind) | sqlitecolumntext(prepared, 2, note_text) | sqlitecolumnint(prepared, 3, importance) | sqlitecolumnint(prepared, 4, uncertainty) | sqlitecolumntext(prepared, 5, next_action) | sqlitecolumntext(prepared, 6, state) | sqlitecolumntext(prepared, 7, author) | sqlitecolumntext(prepared, 8, object_type) | sqlitecolumntext(prepared, 9, object_id) | sqlitecolumntext(prepared, 10, source_id) | sqlitecolumntext(prepared, 11, revision_id) | sqlitecolumnint(prepared, 12, chunk_start) | sqlitecolumnint(prepared, 13, span_start) | sqlitecolumnint(prepared, 14, span_end)
      if columns \= 0 | note_id = "" | span_end <= span_start then do; call sqlitefinalize prepared; error = "cannot decode grounded analysis note"; return -1; end
      duplicate = 0
      do n = 1 to notes.0
        if notes[n].note_id() = note_id then duplicate = 1
      end
      if duplicate = 1 then iterate
      links = .string[]; links[1] = object_type || ":" || object_id
      citations = .ragcitation[]
      absolute_start = chunk_start + span_start; absolute_end = chunk_start + span_end
      citations[1] = .ragcitation(_stablecitation(library_id, source_id, revision_id, absolute_start, absolute_end), source_id, revision_id, absolute_start, absolute_end)
      notes[notes.0 + 1] = .raganalysisnote(note_id, kind, note_text, importance / 1000000.0, uncertainty / 1000000.0, next_action, state, author, links, citations)
      if notes.0 >= maximum then leave
    end
    call sqlitefinalize prepared
  end
  return 0

_gaps: procedure
  arg plan = .ragqueryplan, passages = .ragpassage[], claims = .ragacceptedclaim[], ambiguities = .string[], vector_state = .string, expose gaps = .string[]
  normalized_question = plan.normalized_question()
  missing_terms = ""; terms = plan.terms()
  do i = 1 to terms.0
    if terms[i].source() \= "question" | terms[i].occurrences() > 0 | terms[i].expansion() \= "" | _termpresent(passages, terms[i].term()) = 1 then iterate
    if missing_terms \= "" then missing_terms = missing_terms || ", "
    missing_terms = missing_terms || terms[i].term()
  end
  if missing_terms \= "" then gaps[gaps.0 + 1] = "No indexed corpus occurrence was found for query terms: " || missing_terms || "."
  if passages.0 = 0 then gaps[gaps.0 + 1] = "No active passage matched the deterministic query plan."
  if _hasintent(plan.intents(), "relationship") = 1 & claims.0 = 0 then gaps[gaps.0 + 1] = "No supported directed claim answered the requested relationship; graph or vector results remain leads."
  if ambiguities.0 > 0 then gaps[gaps.0 + 1] = "One or more query names remain ambiguous; do not transfer facts between senses."
  if left(vector_state, 8) = "fallback" then gaps[gaps.0 + 1] = "Semantic retrieval was unavailable or incompatible; lexical and graph retrieval remained active."
  variants = plan.variants(); phrase_requested = 0
  do i = 1 to variants.0
    if variants[i].kind() = "exact-phrase" then phrase_requested = 1
  end
  explicit_phrase_gap = 0; explicit_relationship_gap = 0; explicit_datastore_gap = 0; explicit_freshness_gap = 0; explicit_collective_gap = 0; explicit_verdict_gap = 0
  do i = 1 to passages.0
    body = lower(passages[i].text())
    if phrase_requested = 1 & (pos("does not occur", body) > 0 | pos("exact phrase is absent", body) > 0) then explicit_phrase_gap = 1
    if _hasintent(plan.intents(), "relationship") = 1 & ((pos("not evidence of", body) > 0 & pos("alliance", body) > 0) | pos("does not establish", body) > 0) then explicit_relationship_gap = 1
    if pos("datastore", normalized_question) > 0 & pos("evidence about the datastore", body) > 0 & pos("no", body) > 0 then explicit_datastore_gap = 1
    if (pos("replica", normalized_question) > 0 | pos("risk", normalized_question) > 0 | pos("failover", normalized_question) > 0) & pos("every replica is current", body) > 0 & pos("does not claim", body) > 0 then explicit_freshness_gap = 1
    if (pos("role", normalized_question) > 0 | pos("rannoch", normalized_question) > 0) & pos("lawful", normalized_question) = 0 & pos("unlawful", normalized_question) = 0 & pos("does not attribute the act", body) > 0 & pos("every member", body) > 0 then explicit_collective_gap = 1
    if (pos("lawful", normalized_question) > 0 | pos("unlawful", normalized_question) > 0) & pos("resolved fact about blame", body) > 0 then explicit_verdict_gap = 1
  end
  if explicit_phrase_gap = 1 then gaps[gaps.0 + 1] = "A returned source explicitly says the requested exact phrase does not occur in that source; do not generalize beyond the active fixture."
  else if phrase_requested = 1 & passages.0 = 0 then gaps[gaps.0 + 1] = "The requested exact phrase was not found in the active fixture; this is not a corpus-wide absence claim."
  if explicit_relationship_gap = 1 then gaps[gaps.0 + 1] = "A returned source explicitly says the observed adjacency does not establish the requested relationship."
  if explicit_datastore_gap = 1 then gaps[gaps.0 + 1] = "The returned fixture explicitly provides no evidence about the datastore used by the named service; do not transfer another sense's path."
  if explicit_freshness_gap = 1 then gaps[gaps.0 + 1] = "The returned fixture explicitly does not claim that every replica is current during failover."
  if explicit_collective_gap = 1 then gaps[gaps.0 + 1] = "The returned evidence does not attribute the act to every member of the named house."
  if explicit_verdict_gap = 1 then gaps[gaps.0 + 1] = "The returned source positions do not independently resolve a neutral legal verdict."
  return

_termpresent: procedure = .int
  arg passages = .ragpassage[], term = .string
  if term = "" then return 0
  suffixes = .string[]; suffixes[1] = "s"; suffixes[2] = "es"; suffixes[3] = "ed"; suffixes[4] = "ing"
  do i = 1 to passages.0
    text = lower(passages[i].text()); start = 1
    do forever
      marker = pos(term, text, start)
      if marker = 0 then leave
      previous = ""; if marker > 1 then previous = substr(text, marker - 1, 1)
      if _wordcharacter(previous) = 0 then do
        finish = marker + length(term); following = ""; if finish <= length(text) then following = substr(text, finish, 1)
        if _wordcharacter(following) = 0 then return 1
        do j = 1 to suffixes.0
          suffix = suffixes[j]
          suffix_finish = finish + length(suffix)
          if substr(text, finish, length(suffix)) = suffix then do
            after_suffix = ""; if suffix_finish <= length(text) then after_suffix = substr(text, suffix_finish, 1)
            if _wordcharacter(after_suffix) = 0 then return 1
          end
        end
      end
      start = marker + 1
    end
  end
  return 0

_wordcharacter: procedure = .int
  arg value = .string
  if value = "" then return 0
  return pos(value, "abcdefghijklmnopqrstuvwxyz0123456789_") > 0

_anchors: procedure = .int
  arg database = .binary, generation = .int, normalized_question = .string, expose anchors = .string[], expose error = .string
  /* Space-delimited substrings exactly match the existing phrase boundary
   * rule, including repeated spaces. Probe labels/aliases from this question. */
  sql = "WITH RECURSIVE boundaries(p) AS (VALUES(0) UNION ALL SELECT p+instr(substr(?2,p+1),' ') FROM boundaries WHERE instr(substr(?2,p+1),' ')>0),phrases(label) AS MATERIALIZED (SELECT DISTINCT substr(?2,a.p+1,b.p-a.p-1) FROM boundaries a JOIN boundaries b ON b.p>a.p+1),matches(origin,concept_id) AS (SELECT 0,c.concept_id FROM phrases p CROSS JOIN concepts c ON lower(c.canonical_label)=p.label WHERE c.visible_from_generation<=?1 AND (c.visible_to_generation IS NULL OR c.visible_to_generation>?1) UNION ALL SELECT 1,a.target_concept_id FROM phrases p CROSS JOIN aliases a ON lower(a.normalized_alias)=p.label WHERE a.target_concept_id IS NOT NULL AND a.visible_from_generation<=?1 AND (a.visible_to_generation IS NULL OR a.visible_to_generation>?1)) SELECT concept_id FROM matches GROUP BY concept_id ORDER BY min(origin),concept_id"
  prepared = .binary
  if sqliteprepare(database,sql,prepared)<>0 | sqlitebindint(prepared,1,generation)<>0 | sqlitebindtext(prepared,2,normalized_question || " ")<>0 then do;call sqlitefinalize prepared;error="cannot prepare indexed concept anchors";return -1;end
  do forever
    step=sqlitestep(prepared);if step=101 then leave
    concept_id=""
    if step<>100 | sqlitecolumntext(prepared,0,concept_id)<>0 then do;call sqlitefinalize prepared;error="cannot read indexed concept anchors";return -1;end
    if _contains(anchors,concept_id)=0 then anchors[anchors.0+1]=concept_id
  end
  call sqlitefinalize prepared
  return 0

_chunks: procedure = .int
  arg database = .binary, library_id = .string, generation = .int, chunk_ids = .string[], expose citations = .ragcitation[], expose titles = .string[], expose bodies = .string[], expose source_types = .string[], expose captured_values = .string[], expose event_starts = .string[], expose event_ends = .string[], expose evidence_classes = .string[], expose source_ids = .string[], expose content_ids = .string[], expose error = .string
  if chunk_ids.0 = 0 then return 0
  prepared = .binary
  sql = "WITH wanted(revision_chunk_id,ordinal) AS (VALUES" || _wanted(chunk_ids) || ") SELECT w.ordinal,rc.revision_chunk_id,s.source_id,s.observed_title,s.connector_type,r.revision_id,r.captured_at,COALESCE(r.event_start_at,''),COALESCE(r.event_end_at,''),rc.normalized_start,rc.normalized_end,rc.evidence_class,cc.content_id,cc.text FROM wanted w JOIN revision_chunks rc ON rc.revision_chunk_id=w.revision_chunk_id JOIN chunk_contents cc ON cc.content_id=rc.content_id JOIN source_revisions r ON r.revision_id=rc.revision_id JOIN sources s ON s.source_id=r.source_id WHERE rc.visible_from_generation<=?1 AND (rc.visible_to_generation IS NULL OR rc.visible_to_generation>?1) ORDER BY w.ordinal"
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitebindint(prepared, 1, generation) \= 0 then do; call sqlitefinalize prepared; error = "cannot prepare batched retrieved chunks"; return -1; end
  rows = 0
  do forever
    step_status = sqlitestep(prepared)
    if step_status = 101 then leave
    if step_status \= 100 then do; call sqlitefinalize prepared; error = "cannot read batched retrieved chunks"; return -1; end
    ordinal = 0; returned_id = ""; source_id = ""; title = ""; source_type = ""; revision_id = ""; captured = ""; event_start = ""; event_end = ""; start = 0; finish = 0; evidence_class = ""; content_id = ""; body = ""
    column_status = sqlitecolumnint(prepared, 0, ordinal) | sqlitecolumntext(prepared, 1, returned_id) | sqlitecolumntext(prepared, 2, source_id) | sqlitecolumntext(prepared, 3, title) | sqlitecolumntext(prepared, 4, source_type) | sqlitecolumntext(prepared, 5, revision_id) | sqlitecolumntext(prepared, 6, captured) | sqlitecolumntext(prepared, 7, event_start) | sqlitecolumntext(prepared, 8, event_end) | sqlitecolumnint(prepared, 9, start) | sqlitecolumnint(prepared, 10, finish) | sqlitecolumntext(prepared, 11, evidence_class) | sqlitecolumntext(prepared, 12, content_id) | sqlitecolumntext(prepared, 13, body)
    if column_status \= 0 | ordinal < 1 | ordinal > chunk_ids.0 | returned_id \= chunk_ids[ordinal] | start < 0 | finish <= start then do; call sqlitefinalize prepared; error = "retrieved chunk batch is invalid"; return -1; end
    citations[ordinal] = .ragcitation(_stablecitation(library_id, source_id, revision_id, start, finish), source_id, revision_id, start, finish)
    titles[ordinal] = title; bodies[ordinal] = body; source_types[ordinal] = source_type; captured_values[ordinal] = captured; event_starts[ordinal] = event_start; event_ends[ordinal] = event_end; evidence_classes[ordinal] = evidence_class; source_ids[ordinal] = source_id; content_ids[ordinal] = content_id
    rows = rows + 1
  end
  call sqlitefinalize prepared
  if rows \= chunk_ids.0 then do; error = "one or more retrieved chunks are not active"; return -1; end
  return 0

_wanted: procedure = .string
  arg ids = .string[]
  output = ""
  do i = 1 to ids.0
    if i > 1 then output = output || ","
    output = output || "(" || _q(ids[i]) || "," || i || ")"
  end
  return output

_nonzero: procedure = .int
  arg values = .int[]
  count = 0
  do i = 1 to values.0; if values[i] > 0 then count = count + 1; end
  return count

_selectedchannels: procedure = .int
  arg selected_ids = .string[], candidate_ids = .string[], ranks = .int[]
  count = 0
  do i = 1 to selected_ids.0
    candidate = _candidateindex(candidate_ids, selected_ids[i])
    if candidate > 0 & ranks[candidate] > 0 then count = count + 1
  end
  return count

_candidate: procedure = .int
  arg chunk_id = .string, expose candidate_ids = .string[], expose lexical_ranks = .int[], expose vector_ranks = .int[], expose graph_ranks = .int[], expose vector_scores = .float[], expose graph_hops = .int[], expose directness_values = .float[]
  do i = 1 to candidate_ids.0
    if candidate_ids[i] = chunk_id then return i
  end
  index = candidate_ids.0 + 1; candidate_ids[index] = chunk_id
  lexical_ranks[index] = 0; vector_ranks[index] = 0; graph_ranks[index] = 0; vector_scores[index] = 0.0; graph_hops[index] = 0; directness_values[index] = 0.0
  return index

_candidateindex: procedure = .int
  arg candidate_ids = .string[], chunk_id = .string
  do i = 1 to candidate_ids.0; if candidate_ids[i] = chunk_id then return i; end
  return 0

_rankvectors: procedure
  arg candidate_ids = .string[], expose ranks = .int[], scores = .float[], maximum = .int
  order = .int[]
  do i = 1 to candidate_ids.0
    if scores[i] \= 0.0 then order[order.0 + 1] = i
  end
  call _sortorder order, scores
  limit = maximum
  if order.0 < limit then limit = order.0
  do i = 1 to limit; ranks[order[i]] = i; end
  return

_sortorder: procedure
  arg expose order = .int[], scores = .float[]
  do i = 2 to order.0
    key = order[i]; j = i - 1
    do while j >= 1 & (scores[order[j]] < scores[key] | (scores[order[j]] = scores[key] & order[j] > key))
      order[j + 1] = order[j]; j = j - 1
    end
    order[j + 1] = key
  end
  return

_weight: procedure = .float
  arg profile = .ragprofile, name = .string, fallback = .float
  weights = profile.ranking_weights()
  do i = 1 to weights.0
    if weights[i].name() = name then return weights[i].value()
  end
  return fallback

_sourcecount: procedure = .int
  arg sources = .string[], source = .string
  count = 0
  do i = 1 to sources.0
    if sources[i] = source then count = count + 1
  end
  return count

_distinctcount: procedure = .int
  arg values = .string[]
  distinct = .string[]
  do i = 1 to values.0
    if _contains(distinct, values[i]) = 0 then distinct[distinct.0 + 1] = values[i]
  end
  return distinct.0

_hasintent: procedure = .int
  arg intents = .string[], expected = .string
  do i = 1 to intents.0
    if intents[i] = expected then return 1
  end
  return 0

_contains: procedure = .int
  arg values = .string[], value = .string
  do i = 1 to values.0
    if values[i] = value then return 1
  end
  return 0

_join: procedure = .string
  arg values = .string[]
  output = ""
  do i = 1 to values.0
    if output \= "" then output = output || "00"x
    output = output || values[i]
  end
  return output

_stablecitation: procedure = .string
  arg library_id = .string, source_id = .string, revision_id = .string, start = .int, finish = .int
  return "crexx-rag:" || library_id || ":" || source_id || ":" || revision_id || ":utf8-" || start || "-" || finish

_digits: procedure = .int
  arg value = .string
  if value = "" then return 0
  do i = 1 to length(value)
    if pos(substr(value, i, 1), "0123456789") = 0 then return 0
  end
  return 1

_validoptions: procedure = .int
  arg retrieval_options = .ragretrievaloptions
  if wordpos(retrieval_options.time_unknown(),"include exclude")=0 then return 0
  if retrieval_options.temporal_query()\="" then do; period=.ragperiod(retrieval_options.temporal_query()); if period.ok()=0 then return 0; end
  return retrieval_options.policy_version() \= "" & retrieval_options.lexical_limit() >= 1 & retrieval_options.lexical_limit() <= 1000 & retrieval_options.vector_limit() >= 1 & retrieval_options.vector_limit() <= 1000 & retrieval_options.vector_scan_limit() >= retrieval_options.vector_limit() & retrieval_options.vector_scan_limit() <= 1000000 & retrieval_options.graph_hops() >= 0 & retrieval_options.graph_hops() <= 4 & retrieval_options.passage_limit() >= 1 & retrieval_options.passage_limit() <= querypassagemaximum() & retrieval_options.claim_limit() >= 0 & retrieval_options.claim_limit() <= 8 & retrieval_options.lead_limit() >= 0 & retrieval_options.lead_limit() <= 8 & retrieval_options.rrf_k() >= 1 & retrieval_options.rrf_k() <= 10000 & retrieval_options.graph_boost_millionths() >= 0 & retrieval_options.graph_boost_millionths() <= 1000000 & retrieval_options.graph_decay_millionths() >= 1 & retrieval_options.graph_decay_millionths() <= 1000000 & retrieval_options.directness_bonus_millionths() >= 0 & retrieval_options.directness_bonus_millionths() <= 1000000 & retrieval_options.maximum_sidecar_bytes() >= 1048576 & retrieval_options.maximum_sidecar_bytes() <= 2000000000 & wordpos(retrieval_options.graph_direction(), "outbound inbound both") > 0

_scalarint: procedure = .int
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return -1; end
  value = -1; status = sqlitecolumnint(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return -1
  return value

_scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  value = ""; status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

_q: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "''") || "'"

_emptyevidence: procedure = .ragevidence
  arg question = .string
  query_plan = .string[]; passages = .ragpassage[]; claims = .ragacceptedclaim[]; ambiguities = .string[]; leads = .raggraphlead[]; analysis_notes = .raganalysisnote[]; gaps = .string[]; trace_notes = .string[]
  trace_record = .ragtrace("", query_plan, trace_notes)
  return .ragevidence("", "", 0, question, query_plan, passages, claims, ambiguities, leads, analysis_notes, gaps, trace_record, "", "")

_capturevalue: procedure = .string
  arg database=.binary, raw=.string
  if pos("T",raw)=0 | right(raw,1)\="Z" then return ""
  if _scalartext(database,"SELECT coalesce(datetime(" || _q(raw) || "),'')")="" then return ""
  return raw

_families: procedure = .string
  arg supports=.ragsupportcitation[]
  families=.string[]; unknown=0
  do i=1 to supports.0
    doc=.jsondocument(supports[i].evidence_families())
    if doc.node_count(doc.root())=0 then unknown=unknown+1
    do j=1 to doc.node_count(doc.root())
      family=""; ignored=doc.node_string(doc.element(doc.root(),j),family)
      if _contains(families,family)=0 then families[families.0+1]=family
    end
  end
  encoded="["
  do i=1 to families.0
    if i>1 then encoded=encoded || ","
    encoded=encoded || jsonquote(families[i])
  end
  return '{"raw_support_count":' || supports.0 || ',"known_family_count":' || families.0 || ',"known_families":' || encoded || '],"unknown_independence_supports":' || unknown || '}'

_period: procedure = .ragperiod
  arg qualifiers=.string
  doc=.jsondocument(qualifiers); node=doc.member(doc.root(),"temporal")
  if node<1 then return .ragperiod(periodunknown())
  return .ragperiod(doc.node_get(node))
