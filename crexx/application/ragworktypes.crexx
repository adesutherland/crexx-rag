ragworkproviderresult: class
  _status = .int
  _provider_id = .string
  _model = .string
  _request_id = .string
  _input_tokens = .int
  _output_tokens = .int
  _cost = .int
  _duration_ms = .int
  _retryable = .int
  _retry_delay_ms = .int
  _provider_called = .int
  _admission_deferred = .int
  _diagnostic_json = .string
  _citation_failure = .string
  _content_failure = .int
  _worker_failure = .string
  _outcome_uncertain = .int
  _attempt_limit = .int
  _resolution_json = .string
  _resolution_profile = .ragprofile
  _proposal = .ragextractionproposal
  _error = .string
  _has_proposal = .int
  _source_candidate_id = .string
  _target_candidate_id = .string
  _embedding = .ragworkembedding
  _provider_run_id = .string
  _charging_basis = .string
  _mentions = .ragworkmention[]
  _proposals = .ragworkproposal[]
  _notes = .ragworknote[]

  *: factory
    arg status = .int, provider_id = .string, model = .string, request_id = .string, input_tokens = .int, output_tokens = .int, cost = .int, duration_ms = .int, retryable = .int, proposal = .ragextractionproposal, error = .string, has_proposal = 1, source_candidate_id = "", target_candidate_id = "", embedding = .ragworkembedding("", "", "", "", "", 0, "", ''x as .binary), provider_run_id = "", charging_basis = "monetary-api", mentions = .ragworkmention[], proposals = .ragworkproposal[], notes = .ragworknote[], retry_delay_ms = 0, provider_called = 1
    _status = status; _provider_id = provider_id; _model = model; _request_id = request_id
    _input_tokens = input_tokens; _output_tokens = output_tokens; _cost = cost
    _duration_ms = duration_ms; _retryable = retryable; _retry_delay_ms = retry_delay_ms; _provider_called = provider_called; _proposal = proposal; _error = error
    _has_proposal = has_proposal; _source_candidate_id = source_candidate_id
    _target_candidate_id = target_candidate_id; _embedding = embedding
    _provider_run_id = provider_run_id; _charging_basis = charging_basis
    _mentions = mentions; _proposals = proposals; _notes = notes
    if _proposals.0 = 0 & has_proposal = 1 then _proposals[1] = .ragworkproposal(proposal, source_candidate_id, target_candidate_id)
    return
  resolution: method = .void
    arg value = .string, profile = .ragprofile
    _resolution_json = value; _resolution_profile = profile
    return
  resolution_json: method = .string
    return _resolution_json
  resolution_profile: method = .ragprofile
    return _resolution_profile
  status: method = .int
    return _status
  ok: method = .int
    return _status = 0
  provider_id: method = .string
    return _provider_id
  model: method = .string
    return _model
  request_id: method = .string
    return _request_id
  input_tokens: method = .int
    return _input_tokens
  output_tokens: method = .int
    return _output_tokens
  cost: method = .int
    return _cost
  duration_ms: method = .int
    return _duration_ms
  retryable: method = .int
    return _retryable
  retry_delay_ms: method = .int
    return _retry_delay_ms
  add_wait_ms: method = .void
    arg wait_ms = .int
    if wait_ms > 0 then _duration_ms = _duration_ms + wait_ms
    return
  set_worker_failure: method = .void
    arg message = .string, uncertain = 0
    _worker_failure = message; _outcome_uncertain = uncertain
    return
  worker_failure: method = .string
    return _worker_failure
  outcome_uncertain: method = .int
    return _outcome_uncertain
  set_attempt_limit: method = .void
    arg maximum = .int
    _attempt_limit = maximum
    return
  attempt_limit: method = .int
    return _attempt_limit
  citation_failure: method = .string
    return _citation_failure
  content_failure: method = .int
    return _content_failure
  set_content_failure: method = .void
    arg value = .int
    _content_failure = value
    return
  set_citation_failure: method = .void
    arg value = .string
    _citation_failure = value
    return
  diagnostic_json: method = .string
    return _diagnostic_json
  set_diagnostic: method = .void
    arg value = .string
    _diagnostic_json = value
    return
  provider_called: method = .int
    return _provider_called
  admission_deferred: method = .int
    return _admission_deferred
  set_admission_deferred: method = .void
    _admission_deferred = 1
    return
  proposal: method = .ragextractionproposal
    return _proposal
