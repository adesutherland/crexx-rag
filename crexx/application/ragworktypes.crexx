options levelg

namespace ragworktypes expose ragworkclaim ragcallreservation ragworkembedding ragworkmention ragworkproposal ragworknote ragworkproviderresult ragexternalrecovery ragworkprovider

import rxfnsb
import rxhash
import ragclaims
import ragprofile

/* Shared worker value contracts. No database, provider or orchestration owner
 * is imported here; receipt and usage services can depend on these types. */
ragworkclaim: class
  _status = .int
  _job_id = .string
  _item_id = .string
  _item_type = .string
  _input_hash = .string
  _worker_id = .string
  _fence = .int
  _attempt_id = .string
  _lease_until = .int
  _config_snapshot_id = .string

  *: factory
    arg status = .int, job_id = .string, item_id = .string, item_type = .string, input_hash = .string, worker_id = .string, fence = .int, attempt_id = .string, lease_until = .int, config_snapshot_id = .string
    _status = status; _job_id = job_id; _item_id = item_id; _item_type = item_type
    _input_hash = input_hash; _worker_id = worker_id; _fence = fence
    _attempt_id = attempt_id; _lease_until = lease_until
    _config_snapshot_id = config_snapshot_id
    return
  status: method = .int
    return _status
  claimed: method = .int
    return _status = 0 & _item_id \= ""
  job_id: method = .string
    return _job_id
  item_id: method = .string
    return _item_id
  item_type: method = .string
    return _item_type
  input_hash: method = .string
    return _input_hash
  worker_id: method = .string
    return _worker_id
  fence: method = .int
    return _fence
  attempt_id: method = .string
    return _attempt_id
  lease_until: method = .int
    return _lease_until
  config_snapshot_id: method = .string
    return _config_snapshot_id

ragcallreservation: class
  _status = .int
  _reservation_id = .string
  _job_id = .string
  _item_id = .string
  _attempt_id = .string
  _worker_id = .string
  _fence = .int
  _maximum_input_tokens = .int
  _maximum_output_tokens = .int
  _maximum_cost = .int
  _maximum_time_ms = .int
  _codex_turn = .int
  _reserved_input_tokens = .int
  _reserved_output_tokens = .int
  _reserved_cost = .int
  _reserved_time_ms = .int

  *: factory
    arg status = .int, reservation_id = .string, job_id = .string, item_id = .string, attempt_id = .string, worker_id = .string, fence = .int, maximum_input_tokens = .int, maximum_output_tokens = .int, maximum_cost = .int, maximum_time_ms = .int, codex_turn = 0, reserved_input_tokens = -1, reserved_output_tokens = -1, reserved_cost = -1, reserved_time_ms = -1
    _status = status; _reservation_id = reservation_id; _job_id = job_id
    _item_id = item_id; _attempt_id = attempt_id; _worker_id = worker_id
    _fence = fence; _maximum_input_tokens = maximum_input_tokens
    _maximum_output_tokens = maximum_output_tokens; _maximum_cost = maximum_cost
    _maximum_time_ms = maximum_time_ms
    _codex_turn = codex_turn
    if reserved_input_tokens < 0 then reserved_input_tokens = maximum_input_tokens
    if reserved_output_tokens < 0 then reserved_output_tokens = maximum_output_tokens
    if reserved_cost < 0 then reserved_cost = maximum_cost
    if reserved_time_ms < 0 then reserved_time_ms = maximum_time_ms
    _reserved_input_tokens = reserved_input_tokens
    _reserved_output_tokens = reserved_output_tokens
    _reserved_cost = reserved_cost
    _reserved_time_ms = reserved_time_ms
    return
  status: method = .int
    return _status
  reservation_id: method = .string
    return _reservation_id
  job_id: method = .string
    return _job_id
  item_id: method = .string
    return _item_id
  attempt_id: method = .string
    return _attempt_id
  worker_id: method = .string
    return _worker_id
  fence: method = .int
    return _fence
  maximum_input_tokens: method = .int
    return _maximum_input_tokens
  maximum_output_tokens: method = .int
    return _maximum_output_tokens
  maximum_cost: method = .int
    return _maximum_cost
  maximum_time_ms: method = .int
    return _maximum_time_ms
  codex_turn: method = .int
    return _codex_turn
  reserved_input_tokens: method = .int
    return _reserved_input_tokens
  reserved_output_tokens: method = .int
    return _reserved_output_tokens
  reserved_cost: method = .int
    return _reserved_cost
  reserved_time_ms: method = .int
    return _reserved_time_ms

ragworkembedding: class
  _revision_chunk_id = .string
  _embedding_profile_id = .string
  _input_digest = .string
  _provider_id = .string
  _model = .string
  _dimension = .int
  _envelope_fingerprint = .string
  _vector = .binary

  *: factory
    arg revision_chunk_id = .string, embedding_profile_id = .string, input_digest = .string, provider_id = .string, model = .string, dimension = .int, envelope_fingerprint = .string, vector = .binary
    _revision_chunk_id = revision_chunk_id; _embedding_profile_id = embedding_profile_id
    _input_digest = input_digest; _provider_id = provider_id; _model = model
    _dimension = dimension; _envelope_fingerprint = envelope_fingerprint; _vector = vector
    return
  revision_chunk_id: method = .string
    return _revision_chunk_id
  embedding_profile_id: method = .string
    return _embedding_profile_id
  input_digest: method = .string
    return _input_digest
  provider_id: method = .string
    return _provider_id
  model: method = .string
    return _model
  dimension: method = .int
    return _dimension
  envelope_fingerprint: method = .string
    return _envelope_fingerprint
  vector: method = .binary
    return _vector
  valid: method = .int
    return _revision_chunk_id \= "" & _embedding_profile_id \= "" & length(_input_digest) = 64 & _provider_id \= "" & _model \= "" & _dimension > 0 & _envelope_fingerprint \= "" & binlength(_vector) = _dimension * 4

ragworkmention: class
  _candidate_id = .string
  _concept_id = .string
  _label = .string
  _concept_type = .string
  _span_start = .int
  _span_end = .int
  _aliases = .string[]
  *: factory
    arg candidate_id = "", label = "", concept_type = "", span_start = 0, span_end = 0, aliases = .string[], concept_id = ""
    _concept_id = concept_id
    if _concept_id = "" then _concept_id = "concept-sha256:" || rxhash..sha256hex((lower(label) || "00"x || concept_type) as .binary)
    _candidate_id = candidate_id; _label = label; _concept_type = concept_type
    _span_start = span_start; _span_end = span_end; _aliases = aliases
    return
  concept_id: method = .string
    return _concept_id
  candidate_id: method = .string
    return _candidate_id
  label: method = .string
    return _label
  concept_type: method = .string
    return _concept_type
  span_start: method = .int
    return _span_start
  span_end: method = .int
    return _span_end
  aliases: method = .string[]
    return _aliases

ragworkproposal: class
  _proposal = .ragextractionproposal
  _source_candidate_id = .string
  _target_candidate_id = .string
  *: factory
    arg proposal = .ragextractionproposal, source_candidate_id = "", target_candidate_id = ""
    _proposal = proposal; _source_candidate_id = source_candidate_id; _target_candidate_id = target_candidate_id
    return
  proposal: method = .ragextractionproposal
    return _proposal
  source_candidate_id: method = .string
    return _source_candidate_id
  target_candidate_id: method = .string
    return _target_candidate_id

