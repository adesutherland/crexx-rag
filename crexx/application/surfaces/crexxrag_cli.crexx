options levelg

import rxfnsb
import rxfs
import ragcommand
import ragconfig
import ragconfigfile
import ragproduct
import ragproviderdiagnostics
import ragmcp
import operator_registry

/* Human-first native CLI.  The short commands below only compose the shared
 * product vocabulary; machine callers retain the exact canonical operations. */
main: procedure = .int
arg args = .string[]
if _wantshelp(args) = 1 then return _showhelp()
alias = ""; source_set = ""; worker_count = ""; provider_filter = ""; auto_confirm = 0
error = ""; config_path = ""; config_origin = ""
command_args = _configfileargs(args, config_path, error)
if error \= "" then return _clierror("config", "configuration", error, 3)

loaded_config = .ragconfig; config_loaded = 0
if config_path \= "" then config_origin = "--config-file"
else do
  environment_path = getenv("CREXXRAG_CONFIG")
  if environment_path \= "" then do
    config_path = environment_path
    config_origin = "CREXXRAG_CONFIG"
  end
  else if rxfs..isfile("crexxrag.conf") = 1 then do
    config_path = "crexxrag.conf"
    config_origin = "local default"
  end
end

registry = operatorregistry()
if config_path \= "" then do
  if loadconfigfile(config_path, loaded_config, error) \= 0 then return _clierror("config", "configuration", config_origin || " " || config_path || ": " || error, 3)
  registry = operatorregistryforconfig(loaded_config)
  if registry.valid() \= 1 then return _clierror("config", "configuration", "loaded configuration references an unregistered profile", 3)
  config_loaded = 1
end

command_args = _aliases(command_args, loaded_config, config_loaded, alias, source_set, worker_count, provider_filter, auto_confirm, error)
if error \= "" then return _clierror("parse", "usage", error, 2)
if (alias = "init" | alias = "guided-ingest" | alias = "guided-improve" | alias = "guided-provider-test" | alias = "serve-mcp") & config_loaded = 0 & _hasglobal(command_args, "config") = 0 then return _clierror("config", "configuration", "no configuration selected; checked --config-file, CREXXRAG_CONFIG, and ./crexxrag.conf", 3)

command_args = _defaults(command_args, loaded_config, config_loaded, alias)
request = .ragcommandrequest
if parsecommand(command_args, request, error) \= 0 then return _clierror("parse", "usage", error, 2)
if config_loaded = 1 then do
  if request.config_id() \= "" & request.config_id() \= loaded_config.config_id() then return _clierror("config", "configuration", "--config does not match " || config_origin || " " || config_path, 3)
  request = _bindrequestconfig(request, loaded_config.config_id(), config_path)
end

if alias = "guided-ingest" then return _guidedingest(request, registry, source_set, worker_count, auto_confirm)
if alias = "guided-improve" then return _guidedimprove(request, registry, worker_count, auto_confirm)
if alias = "guided-provider-test" then return _guidedprovidertest(request, registry, provider_filter, auto_confirm)
if alias = "serve-mcp" then return _servemcp(request, registry)
if alias = "provider-login" then do
  login_status = _ensurecodexlogin(registry, request.config_id())
  if login_status \= 0 then return login_status
end
result = dispatchproduct(request, registry)
return _showresult(result, request.format())

_wantshelp: procedure = .int
  arg args = .string[]
  if args.0 = 0 then return 1
  if args.0 = 1 & wordpos(args[1], "--help -h help") > 0 then return 1
  return 0

_showhelp: procedure = .int
  say "crexxrag - local evidence library"
  say ""
  say "Human workflow"
  say "  crexxrag init"
  say "  crexxrag ingest [SOURCE_SET] [--workers N] [--yes]"
  say "  crexxrag improve [--workers N] [--yes]"
  say "  crexxrag review list"
  say "  crexxrag query QUESTION"
  say "  crexxrag provider status"
  say "  crexxrag provider test [PROVIDER] [--yes]"
  say "  crexxrag provider login codex"
  say "  crexxrag doctor"
  say "  crexxrag serve mcp"
  say ""
  say "The current directory defaults are ./crexxrag.conf and ./library."
  say "Ingest and improve review privacy, providers and budget before starting workers."
  say ""
  say "Global options"
  say "  --config-file PATH        configuration file"
  say "  --library PATH            library folder"
  say "  --format human|json|ndjson"
  say "  --progress off|plain|ansi"
  say "  --access CAPABILITY       repeat or comma-separate for canonical commands"
  say ""
  say "Automation uses canonical commands such as ingest plan, ingest apply,"
  say "worker start, job status, query evidence, query answer and library verify."
  say "Agents can use the same local defaults through crexxrag serve mcp."
  return 0

_servemcp: procedure = .int
  arg request = .ragcommandrequest, registry = .ragregistry
  positionals = request.positionals(); command_options = request.command_options()
  if positionals.0 > 0 | command_options.0 > 0 then return _clierror("serve.mcp", "usage", "serve mcp accepts only global options", 2)
  if request.config_id() = "" | request.profile_id() = "" then return _clierror("serve.mcp", "configuration", "serve mcp requires a selected configuration and profile", 3)
  access = request.access(); access_text = ""
  do i = 1 to access.0
    if access_text \= "" then access_text = access_text || ","
    access_text = access_text || access[i]
  end
  do while lines("stdin") > 0
    response = mcpdispatchwithregistry(linein("stdin"), request.library(), request.config_id(), request.profile_id(), access_text, registry)
    if response \= "" then say response
  end
  return 0

_guidedingest: procedure = .int
  arg plan_request = .ragcommandrequest, registry = .ragregistry, source_set = .string, worker_override = .string, auto_confirm = .int
  if plan_request.format() \= "human" then return _clierror("parse", "usage", "guided ingest is human-only; machine callers use ingest plan, ingest apply, and worker start with --format json or ndjson", 2)
  config_lookup = registry.config(plan_request.config_id())
  if config_lookup.found() \= 1 then return _clierror("config", "configuration", "guided ingest configuration is not registered", 3)
  config = config_lookup.config(); workers = config.workers().processes()
  if worker_override \= "" then workers = worker_override as .int
  if workers < 1 | workers > config.workers().processes() then return _clierror("parse", "usage", "--workers must be within the configured process ceiling", 2)

  plan_result = dispatchproduct(plan_request, registry)
  if plan_result.exit_code() \= 0 then return _showresult(plan_result, "human")
  plan_json = _fieldvalue(plan_result, 1, "canonical_plan")
  digest = _fieldvalue(plan_result, 1, "digest")
  if plan_json = "" | digest = "" then return _clierror("render", "internal", "guided ingest plan did not expose its canonical bytes and digest", 10)
  say _plansummary(config, source_set, digest, workers)

  if auto_confirm = 0 then do
    call charout "stderr", "Continue? [y/N] "
    answer = lower(strip(linein("stdin")))
    if answer \= "y" & answer \= "yes" then do
      say "Cancelled: no library changes or provider calls were made."
      return 9
    end
  end

  access = plan_request.access(); empty_positionals = .string[]
  apply_options = .ragcommandoption[]
  apply_options[1] = .ragcommandoption("plan-json", plan_json, 0)
  apply_options[2] = .ragcommandoption("expect-digest", digest, 0)
  apply_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", plan_request.progress(), access, "ingest", "apply", "ingest.apply", apply_options, empty_positionals)
  apply_result = dispatchproduct(apply_request, registry)
  ignored = _showresult(apply_result, "human")
  if apply_result.exit_code() \= 0 then return apply_result.exit_code()
  items_queued = _fieldvalue(apply_result, 1, "items_queued")
  if items_queued = "" then return _clierror("render", "internal", "ingest apply did not expose its queued item count", 10)
  if items_queued = "0" then return 0
  job_id = _fieldvalue(apply_result, 1, "job_id")
  if job_id = "" then return _clierror("render", "internal", "ingest apply did not expose its durable job id", 10)

  worker_options = .ragcommandoption[]
  worker_options[1] = .ragcommandoption("count", workers || "", 0)
  worker_options[2] = .ragcommandoption("poll-ms", "100", 0)
  worker_options[3] = .ragcommandoption("max-polls", "100", 0)
  worker_options[4] = .ragcommandoption("job", job_id, 0)
  worker_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", plan_request.progress(), access, "worker", "start", "worker.start", worker_options, empty_positionals)
  worker_result = dispatchproduct(worker_request, registry)
  ignored = _showresult(worker_result, "human")
  if worker_result.exit_code() \= 0 then return worker_result.exit_code()

  status_options = .ragcommandoption[]; status_positionals = .string[]; status_positionals[1] = job_id
  status_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", "off", access, "job", "status", "job.status", status_options, status_positionals)
  status_result = dispatchproduct(status_request, registry)
  return _showresult(status_result, "human")

_guidedimprove: procedure = .int
  arg plan_request = .ragcommandrequest, registry = .ragregistry, worker_override = .string, auto_confirm = .int
  if plan_request.format() \= "human" then return _clierror("parse", "usage", "guided improvement is human-only; machine callers use improve plan, improve apply, and worker start with --format json or ndjson", 2)
  config_lookup = registry.config(plan_request.config_id())
  if config_lookup.found() \= 1 then return _clierror("config", "configuration", "guided improvement configuration is not registered", 3)
  config = config_lookup.config(); workers = config.workers().processes()
  if worker_override \= "" then workers = worker_override as .int
  if workers < 1 | workers > config.workers().processes() then return _clierror("parse", "usage", "--workers must be within the configured process ceiling", 2)

  plan_result = dispatchproduct(plan_request, registry)
  if plan_result.exit_code() \= 0 then return _showresult(plan_result, "human")
  plan_json = _fieldvalue(plan_result, 1, "canonical_plan")
  digest = _fieldvalue(plan_result, 1, "digest")
  if plan_json = "" | digest = "" then return _clierror("render", "internal", "guided improvement plan did not expose its canonical bytes and digest", 10)
  say _improveplansummary(config, plan_result, digest, workers)

  if auto_confirm = 0 then do
    call charout "stderr", "Continue? [y/N] "
    answer = lower(strip(linein("stdin")))
    if answer \= "y" & answer \= "yes" then do
      say "Cancelled: no library changes or provider calls were made."
      return 9
    end
  end

  access = plan_request.access(); empty_positionals = .string[]
  apply_options = .ragcommandoption[]
  apply_options[1] = .ragcommandoption("plan-json", plan_json, 0)
  apply_options[2] = .ragcommandoption("expect-digest", digest, 0)
  apply_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", plan_request.progress(), access, "improve", "apply", "improve.apply", apply_options, empty_positionals)
  apply_result = dispatchproduct(apply_request, registry)
  ignored = _showresult(apply_result, "human")
  if apply_result.exit_code() \= 0 then return apply_result.exit_code()
  items = _fieldvalue(apply_result, 1, "items")
  if items = "" then return _clierror("render", "internal", "improvement apply did not expose its queued item count", 10)
  if items = "0" then return 0
  job_id = _fieldvalue(apply_result, 1, "job_id")
  if job_id = "" then return _clierror("render", "internal", "improvement apply did not expose its durable job id", 10)

  worker_options = .ragcommandoption[]
  worker_options[1] = .ragcommandoption("count", workers || "", 0)
  worker_options[2] = .ragcommandoption("poll-ms", "100", 0)
  worker_options[3] = .ragcommandoption("max-polls", "100", 0)
  worker_options[4] = .ragcommandoption("job", job_id, 0)
  worker_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", plan_request.progress(), access, "worker", "start", "worker.start", worker_options, empty_positionals)
  worker_result = dispatchproduct(worker_request, registry)
  ignored = _showresult(worker_result, "human")
  if worker_result.exit_code() \= 0 then return worker_result.exit_code()

  status_options = .ragcommandoption[]; status_positionals = .string[]; status_positionals[1] = job_id
  status_request = .ragcommandrequest(plan_request.library(), plan_request.config_id(), plan_request.profile_id(), plan_request.config_file(), "human", "off", access, "job", "status", "job.status", status_options, status_positionals)
  status_result = dispatchproduct(status_request, registry)
  return _showresult(status_result, "human")

_guidedprovidertest: procedure = .int
  arg placeholder_request = .ragcommandrequest, registry = .ragregistry, provider_filter = .string, auto_confirm = .int
  if placeholder_request.format() \= "human" then return _clierror("provider.test", "usage", "guided provider testing is human-only; machine callers use provider test --provider ID with --format json or ndjson", 2)
  lookup = registry.config(placeholder_request.config_id())
  if lookup.found() \= 1 then return _clierror("provider.test", "configuration", "provider-test configuration is not registered", 3)
  config = lookup.config(); providers = config.providers(); selected = .int[]; planned_calls = 0
  do i = 1 to providers.0
    if provider_filter \= "" & providers[i].provider_id() \= provider_filter then iterate
    operations = _provideroperations(config, providers[i].provider_id())
    if operations = 0 then iterate
    selected[selected.0 + 1] = i; planned_calls = planned_calls + operations
  end
  if selected.0 = 0 then do
    if provider_filter \= "" then return _clierror("provider.test", "not-found", "selected provider is not registered and assigned to an application role", 5)
    return _clierror("provider.test", "configuration", "configuration has no role-bound providers to test", 3)
  end
  budget = config.budget()
  monetary = 0
  do i = 1 to selected.0
    if providers[selected[i]].charging_basis() = "monetary-api" then monetary = 1
  end
  say "Provider smoke plan"
  say ""
  say "  Data:              Public synthetic text only"
  say "  Provider calls:    " || planned_calls || " (configured ceiling " || budget.model_calls() || ")"
  say "  Input token limit: " || budget.input_tokens()
  say "  Output token limit: " || budget.output_tokens()
  if monetary = 1 then say "  Maximum API cost:  $" || _money(budget.cost_microunits())
  else say "  Monetary API cost: Not applicable"
  if budget.codex_turns() > 0 then do
    say "  Codex turn limit:  " || budget.codex_turns()
    say "  Minimum allowance: " || budget.minimum_codex_allowance_percent() || "%"
  end
  do i = 1 to selected.0
    provider = providers[selected[i]]; operation_text = _provideroperationtext(config, provider.provider_id())
    say "  Provider:          " || provider.provider_id() || " / " || provider.kind() || " / " || provider.model()
    say "    Route:           " || provider.route_class() || " (" || provider.charging_basis() || ")"
    say "    Validates:       " || operation_text
    if provider.kind() = "codex" then do
      diagnostic = .ragproviderdiagnostic; diagnostic_error = ""
      if codexdiagnostic(provider.timeout_ms(), diagnostic, diagnostic_error) = 0 then say "    Allowance:       " || diagnostic.allowance_available() || "% available"
      else say "    Allowance:       unavailable (" || diagnostic_error || ")"
    end
  end
  say ""
  say "No library content is read or changed. Hosted providers receive only the text shown by this smoke test."
  if planned_calls > budget.model_calls() then return _clierror("provider.test", "budget", "planned provider smoke calls exceed the configured per-command ceiling", 6)
  if auto_confirm = 0 then do
    call charout "stderr", "Continue? [y/N] "
    answer = lower(strip(linein("stdin")))
    if answer \= "y" & answer \= "yes" then do
      say "Cancelled: no provider calls were made."
      return 9
    end
  end
  access = placeholder_request.access(); empty_positionals = .string[]
  actual_calls = 0; actual_input = 0; actual_output = 0; actual_cost = 0
  do i = 1 to selected.0
    test_options = .ragcommandoption[]
    test_options[1] = .ragcommandoption("provider", providers[selected[i]].provider_id(), 0)
    test_request = .ragcommandrequest(placeholder_request.library(), placeholder_request.config_id(), placeholder_request.profile_id(), placeholder_request.config_file(), "human", placeholder_request.progress(), access, "provider", "test", "provider.test", test_options, empty_positionals)
    test_result = dispatchproduct(test_request, registry)
    ignored = _showresult(test_result, "human")
    if test_result.exit_code() \= 0 then return test_result.exit_code()
    completed_records = test_result.records()
    actual_calls = actual_calls + completed_records.0
    actual_input = actual_input + _resultsum(test_result, "input_tokens")
    actual_output = actual_output + _resultsum(test_result, "output_tokens")
    actual_cost = actual_cost + _resultsum(test_result, "estimated_cost_microunits")
    if actual_calls > budget.model_calls() | actual_input > budget.input_tokens() | actual_output > budget.output_tokens() | actual_cost > budget.cost_microunits() then return _clierror("provider.test", "budget", "combined provider smoke usage exceeded the reviewed configuration ceiling", 6)
  end
  say "Provider smoke complete"
  say "  Calls:              " || actual_calls
  say "  Input tokens:       " || actual_input
  say "  Output tokens:      " || actual_output
  if actual_cost > 0 then say "  Estimated API cost: $" || _money(actual_cost)
  return 0

_resultsum: procedure = .int
  arg result = .ragcommandresult, field_name = .string
  total = 0; records = result.records()
  do i = 1 to records.0
    fields = records[i].fields()
    do j = 1 to fields.0
      if fields[j].name() = field_name & datatype(fields[j].value(), "W") = 1 then total = total + (fields[j].value() as .int)
    end
  end
  return total

_provideroperations: procedure = .int
  arg config = .ragconfig, provider_id = .string
  embedding = 0; generation = 0; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].provider_id() \= provider_id then iterate
    if roles[i].role() = "embedding" then embedding = 1
    else generation = 1
  end
  return embedding + generation

_provideroperationtext: procedure = .string
  arg config = .ragconfig, provider_id = .string
  embedding = 0; generation = 0; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].provider_id() \= provider_id then iterate
    if roles[i].role() = "embedding" then embedding = 1
    else generation = 1
  end
  if embedding = 1 & generation = 1 then return "structured generation and 768-dimensional embeddings"
  if embedding = 1 then return "768-dimensional embedding generation"
  return "structured generation and exact citations"

_plansummary: procedure = .string
  arg config = .ragconfig, source_set_id = .string, digest = .string, workers = .int
  source_root = ""; privacy = ""; source_sets = config.source_sets()
  do i = 1 to source_sets.0
    if source_sets[i].source_set_id() = source_set_id then do
      source_root = source_sets[i].root(); privacy = source_sets[i].privacy()
    end
  end
  budget = config.budget(); providers = config.providers()
  cost = _money(budget.cost_microunits())
  extractor = _roleprovider(config, "extractor"); embeddings = _roleprovider(config, "embedding")
  output = "Ingestion plan"
  output = output || "0A0A"x || "  Source set:       " || source_set_id
  if source_root \= "" then output = output || "0A"x || "  Source folder:    " || source_root
  if privacy \= "" then output = output || "0A"x || "  Data policy:      " || privacy
  output = output || "0A"x || "  Maximum calls:    " || budget.model_calls()
  output = output || "0A"x || "  Input token limit: " || budget.input_tokens()
  output = output || "0A"x || "  Output token limit: " || budget.output_tokens()
  output = output || "0A"x || "  Worker processes: " || workers
  if extractor.provider_id() \= "" then do
    if extractor.kind() = "codex" then output = output || "0A"x || "  Extraction:       Codex using your ChatGPT subscription"
    else output = output || "0A"x || "  Extraction:       " || extractor.kind() || " / " || extractor.model()
  end
  if embeddings.provider_id() \= "" then do
    if embeddings.kind() = "openai-compatible" & embeddings.route_class() = "local" then output = output || "0A"x || "  Embeddings:       Local llama.cpp / " || embeddings.model()
    else output = output || "0A"x || "  Embeddings:       " || embeddings.kind() || " / " || embeddings.model()
  end
  if extractor.route_class() = "hosted" then output = output || "0A"x || "  Hosted data:      Public content only"
  if extractor.kind() = "codex" then do
    diagnostic = .ragproviderdiagnostic; diagnostic_error = ""
    if codexdiagnostic(extractor.timeout_ms(), diagnostic, diagnostic_error) = 0 then output = output || "0A"x || "  Codex allowance:  " || diagnostic.allowance_available() || "% available"
    else output = output || "0A"x || "  Codex allowance:  unavailable (" || diagnostic_error || ")"
    output = output || "0A"x || "  Codex turn limit: " || budget.codex_turns()
    output = output || "0A"x || "  Charging basis:   Subscription allowance"
  end
  monetary = 0
  do i = 1 to providers.0
    if providers[i].charging_basis() = "monetary-api" then monetary = 1
  end
  if monetary = 1 then output = output || "0A"x || "  Maximum API cost: $" || cost
  else output = output || "0A"x || "  Monetary API cost: Not applicable"
  output = output || "0A"x || "  Plan digest:      " || digest
  return output

_improveplansummary: procedure = .string
  arg config = .ragconfig, plan_result = .ragcommandresult, digest = .string, workers = .int
  provider = _roleprovider(config, "extractor"); budget = config.budget()
  items = _fieldvalue(plan_result, 2, "items_planned")
  triggers = _fieldvalue(plan_result, 2, "trigger_count")
  output = "Improvement plan"
  output = output || "0A0A"x || "  Items selected:   " || items
  output = output || "0A"x || "  Triggers checked: " || triggers
  output = output || "0A"x || "  Worker processes: " || workers
  if provider.kind() = "codex" then output = output || "0A"x || "  Extraction:       Codex using your ChatGPT subscription"
  else output = output || "0A"x || "  Extraction:       " || provider.kind() || " / " || provider.model()
  if provider.route_class() = "hosted" then output = output || "0A"x || "  Hosted data:      Public content only"
  output = output || "0A"x || "  Maximum calls:    " || budget.model_calls()
  output = output || "0A"x || "  Input token limit: " || budget.input_tokens()
  output = output || "0A"x || "  Output token limit: " || budget.output_tokens()
  if provider.kind() = "codex" then do
    diagnostic = .ragproviderdiagnostic; diagnostic_error = ""
    if codexdiagnostic(provider.timeout_ms(), diagnostic, diagnostic_error) = 0 then output = output || "0A"x || "  Codex allowance:  " || diagnostic.allowance_available() || "% available"
    else output = output || "0A"x || "  Codex allowance:  unavailable (" || diagnostic_error || ")"
    output = output || "0A"x || "  Codex turn limit: " || budget.codex_turns()
  end
  if provider.charging_basis() = "monetary-api" then output = output || "0A"x || "  Maximum API cost: $" || _money(budget.cost_microunits())
  else output = output || "0A"x || "  Monetary API cost: Not applicable"
  output = output || "0A"x || "  Plan digest:      " || digest
  return output

_roleprovider: procedure = .ragproviderconfig
  arg config = .ragconfig, role_name = .string
  provider_id = ""; roles = config.roles()
  do i = 1 to roles.0
    if roles[i].role() = role_name then provider_id = roles[i].provider_id()
  end
  providers = config.providers()
  do i = 1 to providers.0
    if providers[i].provider_id() = provider_id then return providers[i]
  end
  return .ragproviderconfig("", "", "", "", "", "", .ragsecretref(), 0, 0)

_money: procedure = .string
  arg microunits = .int
  value = strip(format(microunits / 1000000.0, , 6))
  do while pos(".", value) > 0 & right(value, 1) = "0"
    value = left(value, length(value) - 1)
  end
  if right(value, 1) = "." then value = left(value, length(value) - 1)
  return value

_showresult: procedure = .int
  arg result = .ragcommandresult, format = .string
  output = ""; error = ""
  if rendercommandresult(result, format, output, error) \= 0 then return _clierror("render", "internal", error, 10)
  say output
  return result.exit_code()

_fieldvalue: procedure = .string
  arg result = .ragcommandresult, record_index = .int, field_name = .string
  records = result.records()
  if record_index < 1 | record_index > records.0 then return ""
  fields = records[record_index].fields()
  do i = 1 to fields.0
    if fields[i].name() = field_name then return fields[i].value()
  end
  return ""

_defaults: procedure = .string[]
  arg args = .string[], config = .ragconfig, config_loaded = .int, alias = .string
  output = .string[]; noun_index = _nounindex(args); noun = ""; verb = ""
  if noun_index > 0 then do
    noun = args[noun_index]
    if noun_index < args.0 then verb = args[noun_index + 1]
  end
  if _requiresdefaultlibrary(noun, verb) = 1 & _hasglobal(args, "library") = 0 then do; output[output.0 + 1] = "--library"; output[output.0 + 1] = "./library"; end
  if config_loaded = 1 & _hasglobal(args, "config") = 0 then do; output[output.0 + 1] = "--config"; output[output.0 + 1] = config.config_id(); end
  if config_loaded = 1 & _hasglobal(args, "profile") = 0 then do
    profile_ids = config.profile_ids()
    if profile_ids.0 = 1 then do; output[output.0 + 1] = "--profile"; output[output.0 + 1] = profile_ids[1]; end
  end
  selected_format = _globalvalue(args, "format")
  if selected_format = "" then selected_format = "human"
  if selected_format = "human" & _hasglobal(args, "progress") = 0 then do; output[output.0 + 1] = "--progress"; output[output.0 + 1] = _defaultprogress(); end
  if _hasglobal(args, "access") = 0 then do
    if alias = "init" then do; output[output.0 + 1] = "--access"; output[output.0 + 1] = "admin"; end
    if alias = "guided-ingest" then do; output[output.0 + 1] = "--access"; output[output.0 + 1] = "ingest,control"; end
    if alias = "guided-improve" then do; output[output.0 + 1] = "--access"; output[output.0 + 1] = "curate"; end
    if alias = "guided-provider-test" then do; output[output.0 + 1] = "--access"; output[output.0 + 1] = "diagnose"; end
  end
  do i = 1 to args.0
    output[output.0 + 1] = args[i]
  end
  return output

_defaultprogress: procedure = .string
  if getenv("NO_COLOR") \= "" | lower(getenv("TERM")) = "dumb" | getenv("TERM") = "" then return "plain"
  return "ansi"

_aliases: procedure = .string[]
  arg args = .string[], config = .ragconfig, config_loaded = .int, expose alias = .string, expose source_set = .string, expose worker_count = .string, expose provider_filter = .string, expose auto_confirm = .int, expose error = .string
  alias = ""; source_set = ""; worker_count = ""; provider_filter = ""; auto_confirm = 0; error = ""
  noun_index = _nounindex(args)
  if noun_index = 0 then return args
  noun = args[noun_index]
  if noun = "init" then do
    if noun_index \= args.0 then do; error = "init accepts no arguments"; return args; end
    output = _prefix(args, noun_index)
    output[output.0 + 1] = "library"; output[output.0 + 1] = "init"; alias = "init"
    return output
  end
  if noun = "query" then do
    if noun_index < args.0 & wordpos(args[noun_index + 1], "search evidence answer trace timeline path") = 0 then do
      output = _prefix(args, noun_index)
      query_verb = "evidence"
      if config_loaded = 1 then do
        answerer = _roleprovider(config, "answerer")
        if answerer.provider_id() \= "" then query_verb = "answer"
      end
      output[output.0 + 1] = "query"; output[output.0 + 1] = query_verb
      do i = noun_index + 1 to args.0; output[output.0 + 1] = args[i]; end
      alias = "query"
      return output
    end
    return args
  end
  if noun = "provider" & noun_index < args.0 & args[noun_index + 1] = "login" then do
    if noun_index + 2 \= args.0 | args[noun_index + 2] \= "codex" then do; error = "provider login requires codex"; return args; end
    output = _prefix(args, noun_index)
    output[output.0 + 1] = "provider"; output[output.0 + 1] = "status"
    alias = "provider-login"
    return output
  end
  if noun = "provider" & noun_index < args.0 & args[noun_index + 1] = "test" & _globalvalue(args, "format") \= "json" & _globalvalue(args, "format") \= "ndjson" then do
    i = noun_index + 2
    do while i <= args.0
      token = args[i]
      if token = "--yes" then auto_confirm = 1
      else if left(token, 2) = "--" then do; error = "unknown guided provider-test option " || token; return args; end
      else if provider_filter = "" then provider_filter = token
      else do; error = "guided provider test accepts at most one provider id"; return args; end
      i = i + 1
    end
    output = _prefix(args, noun_index)
    output[output.0 + 1] = "provider"; output[output.0 + 1] = "status"
    alias = "guided-provider-test"
    return output
  end
  if noun = "serve" & noun_index < args.0 & args[noun_index + 1] = "mcp" then do
    if noun_index + 1 \= args.0 then do; error = "serve mcp accepts only global options"; return args; end
    alias = "serve-mcp"
    return args
  end
  if noun = "improve" then do
    if noun_index < args.0 & wordpos(args[noun_index + 1], "plan apply") > 0 then return args
    i = noun_index + 1
    do while i <= args.0
      token = args[i]
      if token = "--yes" then auto_confirm = 1
      else if token = "--workers" then do
        if i = args.0 then do; error = "--workers requires a value"; return args; end
        i = i + 1; worker_count = args[i]
      end
      else if left(token, 10) = "--workers=" then worker_count = substr(token, 11)
      else do; error = "unknown guided improvement option " || token; return args; end
      i = i + 1
    end
    if worker_count \= "" & _unsignedtext(worker_count) \= 1 then do; error = "--workers requires a positive integer"; return args; end
    output = _prefix(args, noun_index)
    output[output.0 + 1] = "improve"; output[output.0 + 1] = "plan"
    alias = "guided-improve"
    return output
  end
  if noun \= "ingest" then return args
  if noun_index < args.0 & wordpos(args[noun_index + 1], "plan apply") > 0 then return args

  i = noun_index + 1
  do while i <= args.0
    token = args[i]
    if token = "--yes" then auto_confirm = 1
    else if token = "--source-set" then do
      if i = args.0 then do; error = "--source-set requires a value"; return args; end
      i = i + 1; source_set = args[i]
    end
    else if left(token, 13) = "--source-set=" then source_set = substr(token, 14)
    else if token = "--workers" then do
      if i = args.0 then do; error = "--workers requires a value"; return args; end
      i = i + 1; worker_count = args[i]
    end
    else if left(token, 10) = "--workers=" then worker_count = substr(token, 11)
    else if left(token, 2) = "--" then do; error = "unknown guided ingest option " || token; return args; end
    else if source_set = "" then source_set = token
    else do; error = "guided ingest accepts at most one source set"; return args; end
    i = i + 1
  end
  if worker_count \= "" & _unsignedtext(worker_count) \= 1 then do; error = "--workers requires a positive integer"; return args; end
  if source_set = "" & config_loaded = 1 then do
    source_sets = config.source_sets()
    if source_sets.0 = 1 then source_set = source_sets[1].source_set_id()
  end
  if source_set = "" then do; error = "guided ingest requires a source set when configuration does not contain exactly one"; return args; end
  output = _prefix(args, noun_index)
  output[output.0 + 1] = "ingest"; output[output.0 + 1] = "plan"
  output[output.0 + 1] = "--source-set"; output[output.0 + 1] = source_set
  alias = "guided-ingest"
  return output

_ensurecodexlogin: procedure = .int
  arg registry = .ragregistry, config_id = .string
  lookup = registry.config(config_id)
  if lookup.found() \= 1 then return _clierror("provider.login", "configuration", "configuration is not registered", 3)
  configured = 0; providers = lookup.config().providers(); timeout_ms = 30000
  do i = 1 to providers.0
    if providers[i].kind() = "codex" then do; configured = 1; timeout_ms = providers[i].timeout_ms(); end
  end
  if configured \= 1 then return _clierror("provider.login", "not-found", "Codex is not configured", 5)
  diagnostic = .ragproviderdiagnostic; error = ""
  if codexdiagnostic(timeout_ms, diagnostic, error) = 0 then return 0
  if codexlogin(error) \= 0 then return _clierror("provider.login", "unavailable", error, 8)
  if codexdiagnostic(timeout_ms, diagnostic, error) \= 0 then return _clierror("provider.login", "unavailable", "Codex login completed but account status is unavailable: " || error, 8)
  return 0

_prefix: procedure = .string[]
  arg args = .string[], noun_index = .int
  output = .string[]
  do i = 1 to noun_index - 1; output[output.0 + 1] = args[i]; end
  return output

_nounindex: procedure = .int
  arg args = .string[]
  i = 1
  do while i <= args.0 & left(args[i], 2) = "--"
    if pos("=", args[i]) = 0 then i = i + 1
    i = i + 1
  end
  if i > args.0 then return 0
  return i

_hasglobal: procedure = .int
  arg args = .string[], name = .string
  return _globalvalue(args, name) \= ""

_globalvalue: procedure = .string
  arg args = .string[], name = .string
  i = 1
  do while i <= args.0 & left(args[i], 2) = "--"
    token = args[i]
    if token = "--" || name then do
      if i < args.0 then return args[i + 1]
      return ""
    end
    if left(token, length(name) + 3) = "--" || name || "=" then return substr(token, length(name) + 4)
    if pos("=", token) = 0 then i = i + 1
    i = i + 1
  end
  return ""

_requiresdefaultlibrary: procedure = .int
  arg noun = .string, verb = .string
  if noun = "" | noun = "doctor" | noun = "provider" | noun = "profile" then return 0
  if noun = "library" & verb = "restore" then return 0
  return 1

_unsignedtext: procedure = .int
  arg value = .string
  if value = "" | value = "0" then return 0
  do i = 1 to length(value)
    if pos(substr(value, i, 1), "0123456789") = 0 then return 0
  end
  return 1

_bindrequestconfig: procedure = .ragcommandrequest
  arg request = .ragcommandrequest, config_id = .string, config_path = .string
  selected_config = request.config_id(); if selected_config = "" then selected_config = config_id
  return .ragcommandrequest(request.library(), selected_config, request.profile_id(), config_path, request.format(), request.progress(), request.access(), request.noun(), request.verb(), request.operation(), request.command_options(), request.positionals())

_configfileargs: procedure = .string[]
  arg args = .string[], expose config_path = .string, expose error = .string
  config_path = ""; error = ""; output = .string[]; global_options = 1; i = 1
  do while i <= args.0
    token = args[i]
    if global_options = 1 & left(token, 2) = "--" then do
      if token = "--config-file" | left(token, 14) = "--config-file=" then do
        if config_path \= "" then do; error = "--config-file may be supplied once"; return output; end
        if token = "--config-file" then do
          if i = args.0 | left(args[i + 1], 2) = "--" then do; error = "--config-file requires a path"; return output; end
          i = i + 1; config_path = args[i]
        end
        else config_path = substr(token, 15)
        if config_path = "" | length(config_path) > 4096 | pos("00"x, config_path) > 0 then do; error = "--config-file path is invalid"; return output; end
      end
      else do
        output[output.0 + 1] = token
        if pos("=", token) = 0 & i < args.0 then do; i = i + 1; output[output.0 + 1] = args[i]; end
      end
    end
    else do; global_options = 0; output[output.0 + 1] = token; end
    i = i + 1
  end
  return output

_clierror: procedure = .int
  arg stage = .string, exit_name = .string, message = .string, code = .int
  say "ERROR " || stage || " [" || exit_name || "]: " || message
  return code
