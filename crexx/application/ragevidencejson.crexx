options levelg

namespace ragevidencejson expose encodeevidence encodeanswercontext encoderetrieval encodetraceprojection encodepathprojection encodetimelineprojection

import rxfnsb
import rxjson
import ragevidence
import ragperiod
import ragretrieval

encodeevidence: procedure = .int
  arg evidence = .ragevidence, maximum_bytes = 65536, expose output = .string, expose error = .string
  error = ""; output = ""
  if maximum_bytes < 1 | evidence.schema_version() = "" then do; error = "evidence encoding input is invalid"; return -1; end
  query_plan = evidence.query_plan(); passages = evidence.passages(); claims = evidence.claims()
  ambiguities = evidence.ambiguities(); leads = evidence.leads(); notes = evidence.analysis_notes(); gaps = evidence.gaps()
  encoded_plan = _strings(query_plan)
  encoded_passages = ""
  do i = 1 to passages.0
    if i > 1 then encoded_passages = encoded_passages || ","
    encoded_passages = encoded_passages || _passage(passages[i])
  end
  encoded_claims = ""
  do i = 1 to claims.0
    if i > 1 then encoded_claims = encoded_claims || ","
    encoded_claims = encoded_claims || _claim(claims[i])
  end
  encoded_leads = ""
  do i = 1 to leads.0
    if i > 1 then encoded_leads = encoded_leads || ","
    encoded_leads = encoded_leads || _lead(leads[i])
  end
  encoded_notes = ""
  do i = 1 to notes.0
    if i > 1 then encoded_notes = encoded_notes || ","
    encoded_notes = encoded_notes || _analysisnote(notes[i])
  end
  trace_record = evidence.trace()
  encoded_trace = '{"trace_id":' || jsonquote(trace_record.trace_id()) || ',"query_plan":' || _strings(trace_record.query_plan()) || ',"notes":' || _strings(trace_record.notes()) || '}'
  output = '{"schema":' || jsonquote("crexx-rag.evidence/2") || ',"library_id":' || jsonquote(evidence.library_id()) || ',"active_generation":' || evidence.active_generation() || ',"original_question":' || jsonquote(evidence.original_question()) || ',"query_plan":' || encoded_plan || ',"passages":[' || encoded_passages || '],"claims":[' || encoded_claims || '],"ambiguities":' || _strings(ambiguities) || ',"leads":[' || encoded_leads || '],"analysis_notes":[' || encoded_notes || '],"gaps":' || _strings(gaps) || ',"trace":' || encoded_trace || ',"answer_guidance":' || jsonquote(evidence.answer_guidance()) || ',"generated_answer":' || jsonquote(evidence.generated_answer()) || '}'
  if binlength(output as .binary) > maximum_bytes then do; error = "serialized evidence exceeds the configured byte ceiling"; output = ""; return -2; end
  return 0

encoderetrieval: procedure = .int
  arg retrieval = .ragretrievalresult, maximum_bytes = 65536, expose output = .string, expose error = .string
  evidence_output = ""
  if encodeevidence(retrieval.evidence(), maximum_bytes, evidence_output, error) \= 0 then do; output = ""; return -1; end
  output = '{"schema":"crexx-rag.retrieval-result/2","status":' || retrieval.status() || ',"state":' || jsonquote(retrieval.state()) || ',"candidate_count":' || retrieval.candidate_count() || ',"vector_state":' || jsonquote(retrieval.vector_state()) || ',"error":' || jsonquote(retrieval.error()) || ',"evidence":' || evidence_output || '}'
  if binlength(output as .binary) > maximum_bytes then do; error = "serialized retrieval result exceeds the configured byte ceiling"; output = ""; return -2; end
  return 0

encodeanswercontext: procedure = .int
  arg evidence = .ragevidence, maximum_bytes = 65536, expose output = .string, expose error = .string
  error = ""; output = ""
  if maximum_bytes < 1 | evidence.schema_version() = "" then do; error = "answer-context encoding input is invalid"; return -1; end
  passages = evidence.passages(); claims = evidence.claims(); leads = evidence.leads(); notes = evidence.analysis_notes()
  ambiguities = evidence.ambiguities(); gaps = evidence.gaps()
  encoded_passages = ""; encoded_claims = ""; encoded_leads = ""; encoded_notes = ""
  do i = 1 to passages.0
    if i > 1 then encoded_passages = encoded_passages || ","
    encoded_passages = encoded_passages || _answerpassage(passages[i])
  end
  do i = 1 to claims.0
    if i > 1 then encoded_claims = encoded_claims || ","
    encoded_claims = encoded_claims || _answerclaim(claims[i])
  end
  do i = 1 to leads.0
    if i > 1 then encoded_leads = encoded_leads || ","
    encoded_leads = encoded_leads || _answerlead(leads[i])
  end
  do i = 1 to notes.0
    if i > 1 then encoded_notes = encoded_notes || ","
    encoded_notes = encoded_notes || _answernote(notes[i])
  end
  output = '{"schema":"crexx-rag.answer-context/2","question":' || jsonquote(evidence.original_question()) || ',"passages":[' || encoded_passages || '],"accepted_claims":[' || encoded_claims || '],"ambiguities":' || _strings(ambiguities) || ',"graph_leads":[' || encoded_leads || '],"analysis_notes":[' || encoded_notes || '],"gaps":' || _strings(gaps) || ',"answer_guidance":' || jsonquote(evidence.answer_guidance()) || '}'
  if binlength(output as .binary) > maximum_bytes then return _boundedanswercontext(evidence,maximum_bytes,output,error)
  return 0

/* Drop only whole records. Qualifications and citations travel with each
 * retained claim; ambiguity, gaps and answer guidance are never stripped. */
_boundedanswercontext: procedure = .int
  arg evidence=.ragevidence, maximum_bytes=.int, expose output=.string, expose error=.string
  passages=evidence.passages(); claims=evidence.claims(); leads=evidence.leads(); notes=evidence.analysis_notes()
  passage_rows=.string[]; claim_rows=.string[]; lead_rows=.string[]; note_rows=.string[]
  do i=1 to passages.0; passage_rows[i]=_answerpassage(passages[i]); end
  do i=1 to claims.0; claim_rows[i]=_answerclaim(claims[i]); end
  do i=1 to leads.0; lead_rows[i]=_answerlead(leads[i]); end
  do i=1 to notes.0; note_rows[i]=_answernote(notes[i]); end
  pc=passages.0; cc=claims.0; lc=leads.0; nc=notes.0
  do forever
    if nc>0 then nc=nc-1
    else if lc>0 then lc=lc-1
    else if pc>0 then pc=pc-1
    else if cc>0 then cc=cc-1
    else do; error="answer context cannot retain mandatory qualifications within the byte ceiling"; output=""; return -2; end
    omitted='{"passages":' || (passages.0-pc) || ',"claims":' || (claims.0-cc) || ',"leads":' || (leads.0-lc) || ',"analysis_notes":' || (notes.0-nc) || '}'
    output='{"schema":"crexx-rag.answer-context/2","question":' || jsonquote(evidence.original_question()) || ',"passages":' || _prefixobjects(passage_rows,pc) || ',"accepted_claims":' || _prefixobjects(claim_rows,cc) || ',"ambiguities":' || _strings(evidence.ambiguities()) || ',"graph_leads":' || _prefixobjects(lead_rows,lc) || ',"analysis_notes":' || _prefixobjects(note_rows,nc) || ',"gaps":' || _strings(evidence.gaps()) || ',"answer_guidance":' || jsonquote(evidence.answer_guidance() || " Context is incomplete: whole records were omitted to meet the byte ceiling. Report this limitation; absence is not negative evidence.") || ',"truncation":{"incomplete":true,"omitted":' || omitted || '}}'
    if binlength(output as .binary)<=maximum_bytes then return 0
  end

_prefixobjects: procedure = .string
  arg rows=.string[], count=.int
  output="["
  do i=1 to count
    if i>1 then output=output || ","
    output=output || rows[i]
  end
  return output || "]"

encodetraceprojection: procedure = .int
  arg evidence = .ragevidence, maximum_bytes = 65536, expose output = .string, expose error = .string
  error = ""; trace_record = evidence.trace()
  output = '{"schema":"crexx-rag.query-trace/1","trace_id":' || jsonquote(trace_record.trace_id()) || ',"query_plan":' || _strings(trace_record.query_plan()) || ',"notes":' || _strings(trace_record.notes()) || '}'
  if trace_record.trace_id() = "" | binlength(output as .binary) > maximum_bytes then do; error = "serialized query trace exceeds the configured byte ceiling"; output = ""; return -1; end
  return 0

encodepathprojection: procedure = .int
  arg evidence = .ragevidence, maximum_bytes = 65536, expose output = .string, expose error = .string
  error = ""; claims = evidence.claims(); leads = evidence.leads(); encoded = ""; count = 0
  do i = 1 to claims.0
    supports = claims[i].supports(); citation_ids = .string[]
    do j = 1 to supports.0; citation_ids[j] = supports[j].citation().citation(); end
    if encoded \= "" then encoded = encoded || ","
    encoded = encoded || '{"kind":"accepted-claim","claim_id":' || jsonquote(claims[i].claim_id()) || ',"nodes":[' || jsonquote(claims[i].subject()) || ',' || jsonquote(claims[i].object()) || '],"relationship":' || jsonquote(claims[i].relationship_type()) || ',"direction":' || jsonquote(claims[i].direction()) || ',"citations":' || _strings(citation_ids) || ',"qualifiers":' || claims[i].qualifiers() || ',"temporal_match":' || jsonquote(claims[i].temporal_match()) || ',"temporal_path":' || claims[i].temporal_path() || '}'
    count = count + 1
  end
  do i = 1 to leads.0
    path = leads[i].path(); follow_question = ""; follow_target = ""
    do j = 2 to path.0
      if path[j] \= path[1] then do; follow_target = path[j]; leave; end
    end
    if follow_target \= "" then follow_question = "What is the relationship between " || path[1] || " and " || follow_target || "?"
    if encoded \= "" then encoded = encoded || ","
    encoded = encoded || '{"kind":"exploratory-lead","nodes":' || _strings(path) || ',"reason":' || jsonquote(leads[i].reason()) || ',"limitation":' || jsonquote(leads[i].limitation()) || ',"follow_question":' || jsonquote(follow_question) || '}'
    count = count + 1
  end
  output = '{"schema":"crexx-rag.query-paths/2","path_count":' || count || ',"paths":[' || encoded || ']}'
  if binlength(output as .binary) > maximum_bytes then do; error = "serialized query paths exceed the configured byte ceiling"; output = ""; return -1; end
  return 0

encodetimelineprojection: procedure = .int
  arg evidence=.ragevidence, maximum_bytes=65536, expose output=.string, expose error=.string
  error=""; entries=.string[]; keys=.string[]; unresolved=.string[]; seen=.string[]; leads="["; lead_count=0
  passages=evidence.passages(); claims=evidence.claims()
  do i=1 to passages.0
    source=.jsondocument(passages[i].source_metadata()); description=source.member(source.root(),"description"); provenance=source.member(source.root(),"provenance")
    fields="written_period published_period"
    do f=1 to 2
      field=word(fields,f); value=source.node_get(source.member(description,field))
      if value="" then value=periodunknown()
      identity=passages[i].citation().revision() || field || value
      if _containsstring(seen,identity)=1 then iterate
      seen[seen.0+1]=identity
      ground=source.node_get(source.member(provenance,field)); if ground="" then ground="{}"
      call _timelineentry field,value,passages[i].citation().citation(),"",ground,entries,keys,unresolved
    end
    years=.string[]; call _years passages[i].text(),years
    do y=1 to years.0
      if lead_count>0 then leads=leads || ","
      leads=leads || '{"kind":"unclassified-year-mention","year":' || jsonquote(years[y]) || ',"citation":' || jsonquote(passages[i].citation().citation()) || '}'
      lead_count=lead_count+1
    end
  end
  do i=1 to claims.0
    qualifiers=.jsondocument(claims[i].qualifiers()); value=qualifiers.node_get(qualifiers.member(qualifiers.root(),"temporal"))
    if value="" then value=periodunknown()
    supports=claims[i].supports(); citation=""
    if supports.0>0 then citation=supports[1].citation().citation()
    legacy='{"legacy_start":' || jsonquote(claims[i].effective_start_at()) || ',"legacy_end":' || jsonquote(claims[i].effective_end_at()) || ',"qualifiers":' || claims[i].qualifiers() || '}'
    call _timelineentry "historical-validity",value,citation,claims[i].claim_id(),legacy,entries,keys,unresolved
    do j=1 to supports.0
      metadata=.jsondocument(supports[j].provenance()); description=metadata.member(metadata.root(),"description")
      value=metadata.node_get(metadata.member(description,"asserted_period")); if value="" then value=periodunknown()
      ground=metadata.member(metadata.root(),"provenance"); provenance=metadata.node_get(metadata.member(ground,"asserted_period")); if provenance="" then provenance="{}"
      call _timelineentry "assertion-time",value,supports[j].citation().citation(),claims[i].claim_id(),provenance,entries,keys,unresolved
    end
  end
  output='{"schema":"crexx-rag.query-timeline/2","entry_count":' || entries.0 || ',"entries":' || _objects(entries) || ',"unresolved_count":' || unresolved.0 || ',"unresolved":' || _objects(unresolved) || ',"text_year_leads":' || leads || '],"ordering":"Gregorian possible lower bound; precision and uncertainty remain explicit"}'
  if binlength(output as .binary)>maximum_bytes then do; error="serialized query timeline exceeds the configured byte ceiling"; output=""; return -1; end
  return 0

_timelineentry: procedure
  arg kind=.string, value=.string, citation=.string, claim=.string, provenance=.string, expose entries=.string[], expose keys=.string[], expose unresolved=.string[]
  period=.ragperiod(value); comparison="unresolved"
  if period.ok()=1 & period.lower()\="" & period.uncertain()=0 then comparison="comparable-envelope"
  encoded='{"kind":' || jsonquote(kind) || ',"period":' || value || ',"citation":' || jsonquote(citation) || ',"claim_id":' || jsonquote(claim) || ',"provenance":' || provenance || ',"comparison":' || jsonquote(comparison) || '}'
  if comparison="unresolved" then do; unresolved[unresolved.0+1]=encoded; return; end
  key=period.lower() || kind || claim || citation; j=keys.0
  do while j>=1
    if keys[j]<=key then leave
    keys[j+1]=keys[j]; entries[j+1]=entries[j]; j=j-1
  end
  keys[j+1]=key; entries[j+1]=encoded
  return

_objects: procedure = .string
  arg values=.string[]
  output="["
  do i=1 to values.0
    if i>1 then output=output || ","
    output=output || values[i]
  end
  return output || "]"

_years: procedure
  arg value = .string, expose years = .string[]
  years = .string[]
  do i = 1 to length(value) - 3
    candidate = substr(value, i, 4)
    if _digits(candidate) \= 1 then iterate
    previous = ""; following = ""
    if i > 1 then previous = substr(value, i - 1, 1)
    if i + 3 < length(value) then following = substr(value, i + 4, 1)
    if _digit(previous) = 1 | _digit(following) = 1 then iterate
    year = candidate as .int
    if year < 1000 | year > 2999 | _containsstring(years, candidate) = 1 then iterate
    years[years.0 + 1] = candidate
  end
  return

_digits: procedure = .int
  arg value = .string
  if value = "" then return 0
  do i = 1 to length(value)
    if _digit(substr(value, i, 1)) \= 1 then return 0
  end
  return 1

_digit: procedure = .int
  arg value = .string
  return value \= "" & pos(value, "0123456789") > 0

_containsstring: procedure = .int
  arg values = .string[], expected = .string
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_citation: procedure = .string
  arg citation = .ragcitation
  return '{"id":' || jsonquote(citation.citation()) || ',"source_id":' || jsonquote(citation.source()) || ',"revision_id":' || jsonquote(citation.revision()) || ',"span":{"unit":"utf8","start":' || citation.span_start() || ',"end":' || citation.span_end() || '}}'

_score: procedure = .string
  arg score = .ragscore
  return '{"name":' || jsonquote(score.name()) || ',"value":' || score.value() || '}'

_passage: procedure = .string
  arg passage = .ragpassage
  channels = passage.retrieval_channels(); scores = passage.scores(); encoded_scores = ""
  do i = 1 to scores.0
    if i > 1 then encoded_scores = encoded_scores || ","
    encoded_scores = encoded_scores || _score(scores[i])
  end
  return '{"citation":' || _citation(passage.citation()) || ',"title":' || jsonquote(passage.title()) || ',"text":' || jsonquote(passage.text()) || ',"source_type":' || jsonquote(passage.source_type()) || ',"confidence":' || passage.confidence() || ',"captured_at":' || jsonquote(passage.captured_at()) || ',"event_start_at":' || jsonquote(passage.event_start_at()) || ',"event_end_at":' || jsonquote(passage.event_end_at()) || ',"evidence_class":' || jsonquote(passage.evidence_class()) || ',"directness":' || jsonquote(passage.directness()) || ',"retrieval_channels":' || _strings(channels) || ',"scores":[' || encoded_scores || ']' || ',"source_metadata":' || passage.source_metadata() || ',"raw_captured_at":' || jsonquote(passage.raw_captured_at()) || '}'

_support: procedure = .string
  arg support = .ragsupportcitation
  return '{"citation":' || _citation(support.citation()) || ',"polarity":' || jsonquote(support.polarity()) || ',"stance":' || jsonquote(support.stance()) || ',"attribution":' || jsonquote(support.attribution()) || ',"lineage":' || jsonquote(support.lineage()) || ',"support_id":' || jsonquote(support.support_id()) || ',"directness":' || jsonquote(support.directness()) || ',"provenance":' || support.provenance() || ',"source_metadata":' || support.source_metadata() || ',"evidence_families":' || support.evidence_families() || ',"captured_at":' || jsonquote(support.captured_at()) || ',"raw_captured_at":' || jsonquote(support.raw_captured_at()) || '}'

_claim: procedure = .string
  arg claim = .ragacceptedclaim
  supports = claim.supports(); breakdown = claim.confidence_breakdown(); conflicts = claim.conflicts()
  encoded_supports = ""; encoded_breakdown = ""
  do i = 1 to supports.0
    if i > 1 then encoded_supports = encoded_supports || ","
    encoded_supports = encoded_supports || _support(supports[i])
  end
  do i = 1 to breakdown.0
    if i > 1 then encoded_breakdown = encoded_breakdown || ","
    encoded_breakdown = encoded_breakdown || _score(breakdown[i])
  end
  return '{"claim_id":' || jsonquote(claim.claim_id()) || ',"subject":' || jsonquote(claim.subject()) || ',"relationship_type":' || jsonquote(claim.relationship_type()) || ',"object":' || jsonquote(claim.object()) || ',"direction":' || jsonquote(claim.direction()) || ',"confidence":' || claim.confidence() || ',"effective_start_at":' || jsonquote(claim.effective_start_at()) || ',"effective_end_at":' || jsonquote(claim.effective_end_at()) || ',"asserted_at":' || jsonquote(claim.asserted_at()) || ',"supports":[' || encoded_supports || '],"confidence_breakdown":[' || encoded_breakdown || '],"conflicts":' || _strings(conflicts) || ',"qualifiers":' || claim.qualifiers() || ',"temporal_match":' || jsonquote(claim.temporal_match()) || ',"temporal_path":' || claim.temporal_path() || ',"evidence_families":' || claim.evidence_families() || '}'

_lead: procedure = .string
  arg lead = .raggraphlead
  return '{"path":' || _strings(lead.path()) || ',"reason":' || jsonquote(lead.reason()) || ',"supporting_mentions":' || _strings(lead.supporting_mentions()) || ',"limitation":' || jsonquote(lead.limitation()) || '}'

_analysisnote: procedure = .string
  arg note = .raganalysisnote
  citations = note.citations(); encoded_citations = ""
  do i = 1 to citations.0
    if i > 1 then encoded_citations = encoded_citations || ","
    encoded_citations = encoded_citations || _citation(citations[i])
  end
  return '{"note_id":' || jsonquote(note.note_id()) || ',"kind":' || jsonquote(note.kind()) || ',"text":' || jsonquote(note.text()) || ',"importance":' || note.importance() || ',"uncertainty":' || note.uncertainty() || ',"next_action":' || jsonquote(note.next_action()) || ',"state":' || jsonquote(note.state()) || ',"author":' || jsonquote(note.author()) || ',"object_links":' || _strings(note.object_links()) || ',"citations":[' || encoded_citations || ']}'

_answerpassage: procedure = .string
  arg passage = .ragpassage
  return '{"citation":' || jsonquote(passage.citation().citation()) || ',"text":' || jsonquote(passage.text()) || ',"captured_at":' || jsonquote(passage.captured_at()) || ',"event_start_at":' || jsonquote(passage.event_start_at()) || ',"event_end_at":' || jsonquote(passage.event_end_at()) || ',"evidence_class":' || jsonquote(passage.evidence_class()) || ',"directness":' || jsonquote(passage.directness()) || ',"source_metadata":' || passage.source_metadata() || '}'

_answersupport: procedure = .string
  arg support = .ragsupportcitation
  return '{"citation":' || jsonquote(support.citation().citation()) || ',"polarity":' || jsonquote(support.polarity()) || ',"stance":' || jsonquote(support.stance()) || ',"attribution":' || jsonquote(support.attribution()) || ',"lineage":' || jsonquote(support.lineage()) || ',"directness":' || jsonquote(support.directness()) || ',"provenance":' || support.provenance() || ',"source_metadata":' || support.source_metadata() || ',"evidence_families":' || support.evidence_families() || '}'

_answerclaim: procedure = .string
  arg claim = .ragacceptedclaim
  supports = claim.supports(); encoded_supports = ""
  do i = 1 to supports.0
    if i > 1 then encoded_supports = encoded_supports || ","
    encoded_supports = encoded_supports || _answersupport(supports[i])
  end
  return '{"claim_id":' || jsonquote(claim.claim_id()) || ',"subject":' || jsonquote(claim.subject()) || ',"relationship_type":' || jsonquote(claim.relationship_type()) || ',"object":' || jsonquote(claim.object()) || ',"direction":' || jsonquote(claim.direction()) || ',"effective_start_at":' || jsonquote(claim.effective_start_at()) || ',"effective_end_at":' || jsonquote(claim.effective_end_at()) || ',"supports":[' || encoded_supports || ']' || ',"qualifiers":' || claim.qualifiers() || ',"temporal_match":' || jsonquote(claim.temporal_match()) || ',"temporal_path":' || claim.temporal_path() || ',"evidence_families":' || claim.evidence_families() || '}'

_answerlead: procedure = .string
  arg lead = .raggraphlead
  return '{"path":' || _strings(lead.path()) || ',"reason":' || jsonquote(lead.reason()) || ',"limitation":' || jsonquote(lead.limitation()) || '}'

_answernote: procedure = .string
  arg note = .raganalysisnote
  citations = note.citations(); citation_ids = .string[]
  do i = 1 to citations.0
    citation_ids[i] = citations[i].citation()
  end
  return '{"note_id":' || jsonquote(note.note_id()) || ',"kind":' || jsonquote(note.kind()) || ',"text":' || jsonquote(note.text()) || ',"uncertainty":' || note.uncertainty() || ',"next_action":' || jsonquote(note.next_action()) || ',"citations":' || _strings(citation_ids) || ',"factual_status":"analysis-only"}'

_strings: procedure = .string
  arg values = .string[]
  encoded = "["
  do i = 1 to values.0
    if i > 1 then encoded = encoded || ","
    encoded = encoded || jsonquote(values[i])
  end
  return encoded || "]"
