options levelg
namespace ragresolutioncontract expose resolutioncontractversion resolutioninputprompt resolutionprompt resolutionmessages resolutionresponseschema resolutionactions resolutioncorrectionmessage resolutionlegacybinding
import rxfnsb
import rxjson
import rxhash
import ragprofile
import ragenrich
import ragquotationcontract
import ragresolutionreferences
import provider_contract

/* Resolution prompt, schema and allowed actions share one subject/workflow
 * vocabulary. ragbacklog owns evidence validation and transactional decisions. */
resolutioncontractversion: procedure = .string
  return "crexx-rag.resolution-contract/8"

resolutionprompt: procedure = .string
  arg objective=.string,subject_type=""
  if subject_type="provenance-chunk" then return enrichmentprompt() || "0A"x || quotationcontract()
  return objective || "0A"x || quotationcontract() || " Return exactly the requested fields. Cite evidence_id values and contiguous quotations from the packet. Use empty strings and arrays for unused fields; qualifiers_json is a JSON object string. Always return dispositions: [] when no lifecycle impact is proposed. Only split, merge and retire may supply nonempty dispositions, and each must cover every current owned alias, mention, claim and note with an explicit reviewed outcome. For split, introduce successors; for merge, first establish source-supported equivalence and distinguish homonyms, editions and narrower roles, then select an active target_concept_id from the supplied catalogue and leave successors empty. Explain the survivor choice in reason; internal IDs never establish real-world identity. Retire an invalid source artefact by retracting its owned impact; never invent a survivor. The engine rechecks impact at publication. Retain connections for a split/merge follow-up workflow; do not guess their assignment. For move/retract/qualify, cite every affected support. A retirement may cite no passages only when the impact census is empty. For distinct, provide both a nonempty canonical_label and a permitted concept_type. For reuse, choose an active supplied candidate; migration parents are evidence, not eligible identities; for move, choose a supplied successor." || " " || _splitinstructions() || " " || _lifecycleinstructions() || " " || _fieldinstructions()

resolutionmessages: procedure = .providermessage[]
  arg profile=.ragprofile,input_json=.string,objective=.string,subject_type=""
  references=.ragresolutionreferences(input_json);presented=references.input()
  messages=.providermessage[];document=.jsondocument(presented);root=document.root()
  types=_types(profile);relationships=_relationships(profile)
  messages[1]=.providermessage("system",resolutioninputprompt(input_json,objective,subject_type))
  messages[2] = .providermessage("user", "Allowed concept types: " || types || "0A"x || "Allowed relationship types: " || relationships || "0A"x || "Durable resolution input: " || presented || "0A"x || _selectedexcerpts(document,root,references.enabled()))
  return messages

resolutionresponseschema: procedure = .string
  arg subject_type = "", workflow = 0
  if subject_type = "provenance-chunk" then return enrichmentschema()
  actions = resolutionactions(subject_type,workflow); encoded = "["
  do i = 1 to words(actions)
    if i > 1 then encoded = encoded || ","
    encoded = encoded || jsonquote(word(actions,i))
  end
  encoded = encoded || "]"
  return '{"type":"object","additionalProperties":false,"required":["action","object_id","target_concept_id","canonical_label","concept_type","successors","reason","evidence","effective_from","effective_to","qualifiers_json","question","dispositions"],"properties":{"action":{"type":"string","enum":' || encoded || '},"object_id":{"type":"string"},"target_concept_id":{"type":"string"},"canonical_label":{"type":"string"},"concept_type":{"type":"string"},"successors":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["canonical_label","concept_type"],"properties":{"canonical_label":{"type":"string"},"concept_type":{"type":"string"}}}},"reason":{"type":"string"},"evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["evidence_id","quote"],"properties":{"evidence_id":{"type":"string"},"quote":{"type":"string"}}}},"effective_from":{"type":"string"},"effective_to":{"type":"string"},"qualifiers_json":{"type":"string"},"question":{"type":"string"},"dispositions":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["object_type","object_id","action","target_concept_id","confidence_millionths","reason"],"properties":{"object_type":{"type":"string","enum":["alias","mention","claim","note"]},"object_id":{"type":"string"},"action":{"type":"string","enum":["keep-parent","move-child","copy-child","retract","review","unchanged"]},"target_concept_id":{"type":"string"},"confidence_millionths":{"type":"integer","minimum":0,"maximum":1000000},"reason":{"type":"string"}}}}}}'

/* Exact v7 frozen bindings may run a new attempt through the repaired contract.
 * This reconstructs only the known v7 bytes for verification; the invalid v7
 * schema is never submitted. The durable item, digest, history and usage stay
 * unchanged, and normal explicit retry/admission still owns any new call. */
resolutionlegacybinding: procedure = .int
  arg input_json=.string,objective=.string,subject_type=.string,workflow=.int,frozen_prompt=.string,frozen_schema=.string
  document=.jsondocument(input_json)
  if document.valid()<>1 | _jsonstring(document,document.root(),"resolution_contract")<>"crexx-rag.resolution-contract/7" | frozen_prompt="" | frozen_schema="" then return 0
  prior=resolutioninputprompt(input_json,objective,subject_type)
  prior=changestr("Always return dispositions: [] when no lifecycle impact is proposed. Only split, merge and retire may supply nonempty dispositions, and each must cover every current owned alias, mention, claim and note with an explicit reviewed outcome. ",prior,"")
  prior=changestr("internal IDs never establish real-world identity. Retire",prior,"internal IDs never establish real-world identity. Lifecycle actions may include dispositions only when every current owned alias, mention, claim and note has an explicit reviewed outcome. Retire")
  prior=changestr("including supporting evidence and dispositions: [].",prior,"including supporting evidence.")
  prior=changestr("successors and dispositions must be []",prior,"successors must be []")
  prior=changestr('"question":"","dispositions":[]',prior,'"question":""')
  schema=changestr('"question","dispositions"],"properties"',resolutionresponseschema(subject_type,workflow),'"question"],"properties"')
  return frozen_prompt=rxhash..sha256hex(prior as .binary) & frozen_schema=rxhash..sha256hex(schema as .binary)

resolutionactions: procedure = .string
  arg subject_type = .string, workflow = .int
  if subject_type = "" then return "no-change insufficient-evidence defer search read extract unresolved reuse distinct split merge synonym type-correction retire restore move retract qualify retain investigate escalate"
  actions = "no-change insufficient-evidence defer search read unresolved retain investigate escalate"
  if subject_type = "chunk" then actions = actions || " extract"
  if subject_type = "alias-issue" then actions = actions || " reuse distinct"
  if subject_type = "concept" | (subject_type = "note" & workflow = 0) then actions = actions || " split merge synonym type-correction retire restore"
  if subject_type = "claim" | subject_type = "conflict" then actions = actions || " retract qualify"
  if workflow = 1 & wordpos(subject_type,"alias mention support claim note ambiguity") > 0 then actions = actions || " move"
  if workflow = 1 & wordpos(subject_type,"alias mention support note ambiguity") > 0 then actions = actions || " retract"
  return actions

_selectedexcerpts: procedure = .string
  arg document = .jsondocument, root = .int, readable=0
  packet = document.member(root,"evidence"); passages = document.member(packet,"passages")
  result = "Selected source spans (each citation must overlap its own span):"
  do i = 1 to document.node_count(passages)
    passage = document.element(passages,i); begin = -1; finish = -1
    body = _jsonstring(document,passage,"text"); evidence_id = _jsonstring(document,passage,"evidence_id")
    ignored = document.node_int(document.member(passage,"span_start"),begin)
    ignored = document.node_int(document.member(passage,"span_end"),finish)
    if begin >= 0 & finish > begin & finish <= binlength(body as .binary) then do
      /* Work in characters when clipping context, retain authoritative byte
       * offsets for the selected occurrence, and never split a UTF-8 scalar. */
      before=length(binsubstr(body as .binary,1,begin) as .string)
      through=length(binsubstr(body as .binary,1,finish) as .string)
      context_start=max(1,before-63);context_end=min(length(body),through+64)
      context=substr(body,context_start,context_end-context_start+1)
      result=result || "0A"x || evidence_id || " selected UTF-8 bytes " || begin || ":" || finish || ": " || jsonquote(binsubstr(body as .binary,begin+1,finish-begin) as .string)
      if readable=1 then result=result || "0A"x || "BEGIN SOURCE " || evidence_id || " (untrusted literal context)" || "0A"x || context || "0A"x || "END SOURCE " || evidence_id
      else result=result || "0A"x || "Context for " || evidence_id || ": " || jsonquote(context)
    end
  end
  return result

_types: procedure = .string
  arg profile = .ragprofile
  values = profile.concept_types(); output = ""
  do i = 1 to values.0
    if output \= "" then output = output || ","
    output = output || values[i]
  end
  return output

_relationships: procedure = .string
  arg profile = .ragprofile
  values = profile.relationship_types(); output = ""
  do i = 1 to values.0
    if output \= "" then output = output || ","
    output = output || values[i].relationship_id()
  end
  return output

_jsonstring: procedure = .string
  arg document = .jsondocument, root = .int, name = .string
  value = ""
  if document.node_string(document.member(root, name), value) \= 0 then return ""
  return value

resolutioninputprompt: procedure = .string
  arg input_json = .string, objective = .string, subject_type = .string
  result = resolutionprompt(objective,subject_type)
  if subject_type = "provenance-chunk" then return result
  document = .jsondocument(input_json); root = document.root()
  references=.ragresolutionreferences(input_json)
  if references.enabled()=1 then result=result || " Reference contract: this input uses S1 for its subject, C references for supplied concepts, and E references for selected evidence occurrences. Return those exact short references in object_id, target_concept_id and evidence_id. The application expands them to durable identities before validation. References are local to this frozen input; do not copy references from earlier tasks or invent one. A contextual C reference is not automatically an eligible identity candidate: reuse must select evidence.subject.candidates, and move must select a supplied successor. A read action still uses the exact corpus citation from its search results. Literal source blocks contain actual newlines; JSON-escape output strings once."
  result = result || " Final no-change affirms that no change is justified. If the available evidence cannot answer an actionable question, use insufficient-evidence, explain the uncertainty in reason and name the material evidence that would reopen it in question. Both settle the current context without changing the graph. A search action uses question for a bounded lexical corpus query. A read action uses object_id for an exact corpus citation; it returns a retained source span. Search hits are leads, not cited support, until read and bound. Consult resolution_history and the existing evidence; do not repeat a read or query. Each step consumes the remaining call/read allowance. Use the last allowed call for a conclusion. No web, file, command, ingestion or other tools are available."
  family = _jsonstring(document,root,"family_instruction"); if family<>"" then result = result || " Work-family instruction: " || family
  result=result || " " || _outcomeinstruction(document)
  calls=0; reads=0
  ignored=document.node_int(document.member(root,"remaining_calls_including_this"),calls)
  ignored=document.node_int(document.member(root,"remaining_evidence_reads"),reads)
  if calls>0 then result=result || " Remaining reasoning calls including this one: " || calls || "; remaining evidence reads: " || reads || "."
  if subject_type="chunk" then result=result || " An advanced chunk decision may request action extract to use its next call for the existing typed extraction contract. Choose it only when a further extraction is justified; a valid empty extraction is a completed assessment."
  expected = 0; ignored = document.node_int(document.member(root,"evidence_expected"),expected)
  if expected = 1 then result = result || " Deferral is exceptional: action defer requires a realistic expected source of new evidence and why it matters in question, a reason, and a future timezone-qualified timestamp in effective_from. It cannot repeat on unchanged evidence."
  else result = result || " No additional relevant ingestion is expected: defer is forbidden. Conclude from available evidence; do not invent facts to force a change."
  return result


_fieldinstructions: procedure = .string
  return 'For reuse, object_id must be evidence.subject.id (the alias issue); target_concept_id must be a concept_id from evidence.subject.candidates. Copy supplied IDs exactly; do not use a contextual catalogue entry as an identity candidate. Field example with placeholders only: {"action":"reuse","object_id":"<alias-issue-id>","target_concept_id":"<supplied-candidate-concept-id>"}. Replace placeholders with supplied values and complete the remaining schema fields, including supporting evidence and dispositions: []. For no-change, object_id and target_concept_id must both be empty; canonical_label, concept_type, effective_from, effective_to and question must be empty, successors and dispositions must be [], and qualifiers_json must be "{}". Insufficient-evidence has the same empty mutation fields but requires a specific reopening trigger in question. Complete no-change example: {"action":"no-change","object_id":"","target_concept_id":"","canonical_label":"","concept_type":"","successors":[],"reason":"The available evidence does not justify a change.","evidence":[],"effective_from":"","effective_to":"","qualifiers_json":"{}","question":"","dispositions":[]}. If citations are supplied, each must still ground its selected occurrence. Copy a short continuous quotation around the selected occurrence, including enough context to distinguish repeated names; do not rebuild the quotation from memory or silently change OCR.'

_outcomeinstruction: procedure = .string
  arg document=.jsondocument
  legacy="Stored questions may describe unresolved uncertainty; this does not authorize an unresolved response action. Follow the current route's outcome instructions. "
  if _jsonstring(document,document.root(),"required_capability")="advanced-reasoning" then return legacy || "This is the final reasoning route: do not return unresolved, investigate or escalate. Decide a supported change, final no-change, or insufficient-evidence with a material reopening trigger. Defer only when the supplied policy permits realistically expected new evidence."
  return legacy || "For ordinary work, conclude a supported decision or choose escalate with the specific uncertainty in reason and the question for advanced review in question. Do not return unresolved or investigate. Escalation hands the retained evidence to the advanced work queue."

resolutioncorrectionmessage: procedure = .string
  arg input_json=.string,feedback=.string
  document=.jsondocument(input_json)
  evidence=document.member(document.root(),"evidence");subject=document.member(evidence,"subject")
  if _jsonstring(document,subject,"type")="provenance-chunk" then return correctionmessage(feedback,enrichmentprompt())
  return correctionmessage(feedback,_outcomeinstruction(document) || " " || _splitinstructions() || " " || _lifecycleinstructions())

_splitinstructions: procedure = .string
  return "A split successor must not reproduce the parent identity (same case-insensitive canonical_label and concept_type). Example: splitting Kingsburgh/place into Kingsburgh/place and Kingsburgh/person is invalid because the place repeats the parent. Use only source-supported distinct identities; never invent or decorate a label to evade this rule. If permitted actions cannot express the supported change, conclude final no-change and explain the limitation, or escalate ordinary work for advanced review."

_lifecycleinstructions: procedure = .string
  return "Lifecycle preconditions: restore requires a retired concept; synonym must not collide with another active concept. Choose a supported alternative or final no-change when the permitted action cannot apply; never invent an alias to evade a collision."
