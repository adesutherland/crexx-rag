ragevidence: class
  _schema_version = .string
  _library_id = .string
  _active_generation = .int
  _original_question = .string
  _query_plan = .string[]
  _passages = .ragpassage[]
  _claims = .ragacceptedclaim[]
  _ambiguities = .string[]
  _leads = .raggraphlead[]
  _analysis_notes = .raganalysisnote[]
  _gaps = .string[]
  _trace = .ragtrace
  _answer_guidance = .string
  _generated_answer = .string

  *: factory
    arg schema_version = .string, library_id = .string, active_generation = .int, original_question = .string, query_plan = .string[], passages = .ragpassage[], claims = .ragacceptedclaim[], ambiguities = .string[], leads = .raggraphlead[], analysis_notes = .raganalysisnote[], gaps = .string[], trace = .ragtrace, answer_guidance = .string, generated_answer = ""
    _schema_version = schema_version
    _library_id = library_id
    _active_generation = active_generation
    _original_question = original_question
    _query_plan = query_plan
    _passages = passages
    _claims = claims
    _ambiguities = ambiguities
    _leads = leads
    _analysis_notes = analysis_notes
    _gaps = gaps
    _trace = trace
    _answer_guidance = answer_guidance
    _generated_answer = generated_answer
    return

  schema_version: method = .string
    return _schema_version
  library_id: method = .string
    return _library_id
  active_generation: method = .int
    return _active_generation
  original_question: method = .string
    return _original_question
  query_plan: method = .string[]
    return _query_plan
  passages: method = .ragpassage[]
    return _passages
  claims: method = .ragacceptedclaim[]
    return _claims
  ambiguities: method = .string[]
    return _ambiguities
  leads: method = .raggraphlead[]
    return _leads
  analysis_notes: method = .raganalysisnote[]
    return _analysis_notes
  gaps: method = .string[]
    return _gaps
  trace: method = .ragtrace
    return _trace
  answer_guidance: method = .string
    return _answer_guidance
  generated_answer: method = .string
    return _generated_answer
  with_generated_answer: method = .ragevidence
    arg generated_answer = .string
    return .ragevidence(_schema_version, _library_id, _active_generation, _original_question, _query_plan, _passages, _claims, _ambiguities, _leads, _analysis_notes, _gaps, _trace, _answer_guidance, generated_answer)
