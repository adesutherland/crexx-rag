options levelg

namespace ragevidence expose ragscore ragcitation ragpassage ragsupportcitation ragacceptedclaim raggraphlead ragevidence

import ragmodel

ragscore: class
  _name = .string
  _value = .float

  *: factory
    arg name = .string, value = .float
    _name = name
    _value = value
    return

  name: method = .string
    return _name
  value: method = .float
    return _value

