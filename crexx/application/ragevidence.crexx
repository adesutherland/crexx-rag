options levelg

namespace ragevidence expose ragscore ragcitation ragpassage ragsupportcitation ragacceptedclaim raggraphlead raganalysisnote ragevidence

import ragmodel

ragscore: class
  _name = .string
  _value = .float

  *: factory
    arg name = .string, value = .float
    _name = name
    _value = value
    return

  name: method = .string
    return _name
  value: method = .float
    return _value

ragcitation: class
  _citation = .string
  _source = .string
  _revision = .string
  _span_start = .int
  _span_end = .int

  *: factory
    arg citation = .string, source = .string, revision = .string, span_start = .int, span_end = .int
    _citation = citation
    _source = source
    _revision = revision
    _span_start = span_start
    _span_end = span_end
    return

  citation: method = .string
    return _citation
  source: method = .string
    return _source
  revision: method = .string
    return _revision
  span_start: method = .int
    return _span_start
  span_end: method = .int
    return _span_end

ragpassage: class
  _citation = .ragcitation
  _title = .string
  _text = .string
  _source_type = .string
  _confidence = .float
  _captured_at = .string
  _event_start_at = .string
  _event_end_at = .string
  _evidence_class = .string
  _directness = .string
  _retrieval_channels = .string[]
  _scores = .ragscore[]

  _source_metadata = .string
  _raw_captured_at = .string

  *: factory
    arg citation = .ragcitation, title = .string, text = .string, source_type = .string, confidence = .float, captured_at = .string, event_start_at = .string, event_end_at = .string, evidence_class = .string, directness = .string, retrieval_channels = .string[], scores = .ragscore[], source_metadata = "{}", raw_captured_at = ""
    _citation = citation
    _title = title
    _text = text
    _source_type = source_type
    _confidence = confidence
    _captured_at = captured_at
    _event_start_at = event_start_at
    _event_end_at = event_end_at
    _evidence_class = evidence_class
    _directness = directness
    _retrieval_channels = retrieval_channels
    _scores = scores
    _source_metadata = source_metadata
    _raw_captured_at = raw_captured_at
    return

  citation: method = .ragcitation
    return _citation
  title: method = .string
    return _title
  text: method = .string
    return _text
  source_type: method = .string
    return _source_type
  confidence: method = .float
    return _confidence
  captured_at: method = .string
    return _captured_at
  event_start_at: method = .string
    return _event_start_at
  event_end_at: method = .string
    return _event_end_at
  evidence_class: method = .string
    return _evidence_class
  directness: method = .string
    return _directness
  retrieval_channels: method = .string[]
    return _retrieval_channels
  scores: method = .ragscore[]
    return _scores

  source_metadata: method = .string
    return _source_metadata
  raw_captured_at: method = .string
    return _raw_captured_at

