options levelg

namespace ragprocess expose ragprocessrecord ragprocessstartresult newprocessidentity reserveprocess activateprocess heartbeatprocess finishprocess requestprocess processrequest listprocesses pruneprocesses cleanupjobprocesses runidleworker runapplicationworker startworkerprocesses currentprocessid currenthostid processalive reserveworkerreplacement

import rxfnsb
import concurrency
import rxplatform
import rxfs
import rxsqlite
import ragstore
import ragconfig
import ragconfiguration
import ragprofile
import ragclaims
import ragclaimrules
import ragwork
import ragworktypes
import ragtrace
import ragapplicationprovider
import ragsupervision

/* Durable process coordination for the enduring application.  Runtime rows are
 * coordination state, not work-item ownership: ragwork leases and fences remain
 * authoritative once ingestion processors are attached in the next step. */
ragprocessrecord: class
  _instance_id = .string
  _kind = .string
  _parent_instance_id = .string
  _host_id = .string
  _pid = .int
  _process_start_token = .string
  _executable_identity = .string
  _mode = .string
  _job_filter = .string
  _state = .string
  _requested_state = .string
  _current_item_id = .string
  _started_at = .int
  _heartbeat_at = .int
  _heartbeat_age = .int
  _classification = .string
  _detail = .string

  *: factory
    arg instance_id = .string, kind = .string, parent_instance_id = .string, host_id = .string, pid = .int, process_start_token = .string, executable_identity = .string, mode = .string, job_filter = .string, state = .string, requested_state = .string, current_item_id = .string, started_at = .int, heartbeat_at = .int, heartbeat_age = .int, classification = .string, detail = .string
    _instance_id = instance_id
    _kind = kind
    _parent_instance_id = parent_instance_id
    _host_id = host_id
    _pid = pid
    _process_start_token = process_start_token
    _executable_identity = executable_identity
    _mode = mode
    _job_filter = job_filter
    _state = state
    _requested_state = requested_state
    _current_item_id = current_item_id
    _started_at = started_at
    _heartbeat_at = heartbeat_at
    _heartbeat_age = heartbeat_age
    _classification = classification
    _detail = detail
    return

  instance_id: method = .string
    return _instance_id
  kind: method = .string
    return _kind
  parent_instance_id: method = .string
    return _parent_instance_id
  host_id: method = .string
    return _host_id
  pid: method = .int
    return _pid
  process_start_token: method = .string
    return _process_start_token
  executable_identity: method = .string
    return _executable_identity
  mode: method = .string
    return _mode
  job_filter: method = .string
    return _job_filter
  state: method = .string
    return _state
  requested_state: method = .string
    return _requested_state
  current_item_id: method = .string
    return _current_item_id
  started_at: method = .int
    return _started_at
  heartbeat_at: method = .int
    return _heartbeat_at
  heartbeat_age: method = .int
    return _heartbeat_age
  classification: method = .string
    return _classification
  detail: method = .string
    return _detail

ragprocessstartresult: class
  _controller_id = .string
  _requested = .int
  _completed = .int
  _failed = .int
  _restarted = .int

  *: factory
    arg controller_id = .string, requested = .int, completed = .int, failed = .int, restarted = 0
    _controller_id = controller_id
    _requested = requested
    _completed = completed
    _failed = failed; _restarted = restarted
    return

  controller_id: method = .string
    return _controller_id
  requested: method = .int
    return _requested
  completed: method = .int
    return _completed
  failed: method = .int
    return _failed

  restarted: method = .int
    return _restarted

newprocessidentity: procedure = .string
  arg store = .ragstorehandle, kind = .string, expose error = .string
  error = ""
  if store.open() \= 1 | store.writable() \= 1 then do; error = "writable store is required"; return ""; end
  if kind \= "controller" & kind \= "worker" then do; error = "process kind is invalid"; return ""; end
  suffix = _scalartext(store.database(), "SELECT lower(hex(randomblob(16)))", error)
  if suffix = "" then return ""
  return kind || "-" || suffix

reserveprocess: procedure = .int
  arg store = .ragstorehandle, instance_id = .string, kind = .string, parent_instance_id = .string, host_id = .string, mode = .string, job_filter = .string, executable_identity = .string, expose error = .string
  error = ""
  if store.open() \= 1 | store.writable() \= 1 then do; error = "writable store is required"; return -1; end
  if _validtext(instance_id, 128, 0) \= 1 | _validtext(parent_instance_id, 128, 1) \= 1 | _validtext(host_id, 255, 0) \= 1 | _validtext(executable_identity, 4096, 0) \= 1 | _validtext(job_filter, 256, 1) \= 1 | (kind \= "controller" & kind \= "worker") | (mode \= "wait" & mode \= "once" & mode \= "follow") then do; error = "reserved process identity is invalid"; return -1; end
  prepared = .binary
  sql = "INSERT INTO runtime_instances(instance_id,kind,parent_instance_id,host_id,pid,process_start_token,executable_identity,mode,job_filter,state,requested_state,current_item_id,started_at,heartbeat_at,detail) VALUES(?1,?2,NULLIF(?3,''),?4,0,'',?5,?6,?7,'starting','none','',CAST(strftime('%s','now') AS INTEGER),CAST(strftime('%s','now') AS INTEGER),'reserved by controller')"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then return _sqlitefailure("prepare process reservation", error)
  binds = sqlitebindtext(prepared, 1, instance_id)
  binds = binds | sqlitebindtext(prepared, 2, kind)
  binds = binds | sqlitebindtext(prepared, 3, parent_instance_id)
  binds = binds | sqlitebindtext(prepared, 4, host_id)
  binds = binds | sqlitebindtext(prepared, 5, executable_identity)
  binds = binds | sqlitebindtext(prepared, 6, mode)
  binds = binds | sqlitebindtext(prepared, 7, job_filter)
  step = sqlitestep(prepared)
  call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then return _sqlitefailure("reserve process", error)
  return 0

activateprocess: procedure = .int
  arg store = .ragstorehandle, instance_id = .string, kind = .string, parent_instance_id = .string, host_id = .string, pid = .int, process_start_token = .string, executable_identity = .string, mode = .string, job_filter = .string, expose error = .string
  error = ""
  if _validtext(instance_id, 128, 0) \= 1 | _validtext(parent_instance_id, 128, 1) \= 1 | _validtext(host_id, 255, 0) \= 1 | pid <= 0 | _validtext(process_start_token, 128, 0) \= 1 | _validtext(executable_identity, 4096, 0) \= 1 | _validtext(job_filter, 256, 1) \= 1 | (kind \= "controller" & kind \= "worker") | (mode \= "wait" & mode \= "once" & mode \= "follow") then do; error = "active process identity is invalid"; return -1; end
  database = store.database(); prepared = .binary
  if beginwritetransaction(database,"begin process activation",error) \= 0 then return -2
  if kind = "controller" then do
    overlap = "(job_filter='' OR " || _sqlquote(job_filter) || "='' OR job_filter=" || _sqlquote(job_filter) || ")"
    if _scalarint(database,"SELECT count(*) FROM runtime_instances WHERE kind='controller' AND state NOT IN('stopped','failed') AND instance_id<>" || _sqlquote(instance_id) || " AND " || overlap,error) \= 0 then return _rollback(database,"job already has a controller; drain it or use job run after its process has exited",error)
  end
  sql = "UPDATE runtime_instances SET parent_instance_id=NULLIF(?2,''),host_id=?3,pid=?4,process_start_token=?5,executable_identity=?6,mode=?7,job_filter=?8,state='idle',current_item_id='',started_at=CAST(strftime('%s','now') AS INTEGER),heartbeat_at=CAST(strftime('%s','now') AS INTEGER),stopped_at=NULL,exit_code=NULL,detail='active' WHERE instance_id=?1 AND kind=?9 AND state='starting'"
  if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database, "prepare reserved process activation", error)
  binds = sqlitebindtext(prepared, 1, instance_id)
  binds = binds | sqlitebindtext(prepared, 2, parent_instance_id)
  binds = binds | sqlitebindtext(prepared, 3, host_id)
  binds = binds | sqlitebindint(prepared, 4, pid)
  binds = binds | sqlitebindtext(prepared, 5, process_start_token)
  binds = binds | sqlitebindtext(prepared, 6, executable_identity)
  binds = binds | sqlitebindtext(prepared, 7, mode)
  binds = binds | sqlitebindtext(prepared, 8, job_filter)
  binds = binds | sqlitebindtext(prepared, 9, kind)
  step = sqlitestep(prepared)
  call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then return _rollback(database, "activate reserved process", error)
  changed = _scalarint(database, "SELECT changes()", error)
  if error \= "" then return _rollback(database, "read process activation", error)
  if changed = 0 then do
    sql = "INSERT INTO runtime_instances(instance_id,kind,parent_instance_id,host_id,pid,process_start_token,executable_identity,mode,job_filter,state,requested_state,current_item_id,started_at,heartbeat_at,detail) VALUES(?1,?2,NULLIF(?3,''),?4,?5,?6,?7,?8,?9,'idle','none','',CAST(strftime('%s','now') AS INTEGER),CAST(strftime('%s','now') AS INTEGER),'active')"
    if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database, "prepare independent process activation", error)
    binds = sqlitebindtext(prepared, 1, instance_id)
    binds = binds | sqlitebindtext(prepared, 2, kind)
    binds = binds | sqlitebindtext(prepared, 3, parent_instance_id)
    binds = binds | sqlitebindtext(prepared, 4, host_id)
    binds = binds | sqlitebindint(prepared, 5, pid)
    binds = binds | sqlitebindtext(prepared, 6, process_start_token)
    binds = binds | sqlitebindtext(prepared, 7, executable_identity)
    binds = binds | sqlitebindtext(prepared, 8, mode)
    binds = binds | sqlitebindtext(prepared, 9, job_filter)
    step = sqlitestep(prepared)
    call sqlitefinalize prepared
    if binds \= 0 | step \= 101 then return _rollback(database, "activate independent process", error)
  end
  if sqliteexec(database, "COMMIT") \= 0 then return _rollback(database, "commit process activation", error)
  return 0

heartbeatprocess: procedure = .int
  arg store = .ragstorehandle, instance_id = .string, state = .string, current_item_id = .string, detail = .string, expose error = .string
  error = ""
  if (state \= "idle" & state \= "running" & state \= "draining") | _validtext(current_item_id, 256, 1) \= 1 | _validtext(detail, 1024, 1) \= 1 then do; error = "heartbeat state is invalid"; return -1; end
  prepared = .binary
  sql = "UPDATE runtime_instances SET state=?2,current_item_id=?3,heartbeat_at=CAST(strftime('%s','now') AS INTEGER),detail=?4 WHERE instance_id=?1 AND state NOT IN('stopped','failed')"
  /* A busy heartbeat has not admitted work or changed its row. Retry only
   * ordinary writer contention, within three existing busy-timeout waits.
   * A stale read snapshot needs transaction recovery, not statement retry. */
  do attempt = 1 to 3
    error = ""
    if sqliteprepare(store.database(), sql, prepared) \= 0 then return _sqlitefailure("prepare process heartbeat", error)
    binds = sqlitebindtext(prepared, 1, instance_id)
    if binds = 0 then binds = sqlitebindtext(prepared, 2, state)
    if binds = 0 then binds = sqlitebindtext(prepared, 3, current_item_id)
    if binds = 0 then binds = sqlitebindtext(prepared, 4, detail)
    if binds \= 0 then do
      ignored = _sqlitefailure("bind process heartbeat", error)
      call sqlitefinalize prepared
      return -2
    end
    step = sqlitestep(prepared)
    if step = 101 then do
      call sqlitefinalize prepared
      if _scalarint(store.database(), "SELECT changes()", error) \= 1 then do; if error = "" then error = "process heartbeat lost its active row"; return -2; end
      return 0
    end
    /* rxsqlite clears its session diagnostic on the next normal call. */
    boundary_code = 0; sqlite_code = 0; extended = 0; operation = ""; message = ""
    call sqliteerrorextended boundary_code, sqlite_code, extended, operation, message
    ignored = _sqlitefailure("write process heartbeat", error)
    call sqlitefinalize prepared
    if boundary_code \= -6 | sqlite_code \= 5 | (extended \= 5 & extended \= 261) then return -2
    if attempt = 3 then do; error = error || ";heartbeat_attempts=3"; return -2; end
    call writeoperatorline "crexxrag heartbeat " || instance_id || " retry=" || attempt || "/2: " || error
    call rxplatform..sleep (attempt * 100)
  end
  return -2

/* Keep the supervisor alive through ordinary writer contention, within the
 * worker lease. Other SQL errors still fail immediately. The low-level
 * heartbeat retains its independently tested three-attempt contract. */
_busyheartbeat: procedure = .int
  arg error = .string
  return pos("heartbeat",error)>0 & (pos(",sqlite=5,extended=5,",error)>0 | pos(",sqlite=5,extended=261,",error)>0)

_supervisorheartbeat: procedure = .int
  arg store = .ragstorehandle, id = .string, state = .string, item = .string, detail = .string, expose error = .string
  do cycle = 1 to 4
    status = heartbeatprocess(store,id,state,item,detail,error)
    if status = 0 | _busyheartbeat(error) = 0 then return status
    if cycle < 4 then call rxplatform..sleep 250
  end
  return -2

finishprocess: procedure = .int
  arg store = .ragstorehandle, instance_id = .string, state = .string, exit_code = .int, detail = .string, expose error = .string
  error = ""
  if (state \= "stopped" & state \= "failed") | _validtext(detail, 1024, 1) \= 1 then do; error = "terminal process state is invalid"; return -1; end
  database=store.database(); prepared = .binary
  if beginwritetransaction(database,"begin process finish",error) \= 0 then return -2
  sql = "UPDATE runtime_instances SET state=?2,current_item_id='',heartbeat_at=CAST(strftime('%s','now') AS INTEGER),stopped_at=CAST(strftime('%s','now') AS INTEGER),exit_code=?3,detail=?4 WHERE instance_id=?1"
  if sqliteprepare(database, sql, prepared) \= 0 then return _rollback(database,"prepare process finish", error)
  binds = sqlitebindtext(prepared, 1, instance_id)
  binds = binds | sqlitebindtext(prepared, 2, state)
  binds = binds | sqlitebindint(prepared, 3, exit_code)
  binds = binds | sqlitebindtext(prepared, 4, detail)
  step = sqlitestep(prepared)
  /* Finalizing clears the provider diagnostic; retain the failed write first. */
  if binds \= 0 | step \= 101 then ignored=_sqlitefailure("finish process",error)
  call sqlitefinalize prepared
  if error \= "" then return _rollback(database,"finish process", error)
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"commit process finish",error)
  return 0

requestprocess: procedure = .int
  arg store = .ragstorehandle, instance_id = .string, requested_state = .string, expose error = .string
  error = ""
  if (requested_state \= "drain" & requested_state \= "stop") | _validtext(instance_id, 128, 0) \= 1 then do; error = "process request must be drain or stop"; return -1; end
  prepared = .binary
  sql = "UPDATE runtime_instances SET requested_state=?2,detail='operator requested '||?2 WHERE instance_id=?1 AND kind='worker' AND state NOT IN('stopped','failed')"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then return _sqlitefailure("prepare process request", error)
  binds = sqlitebindtext(prepared, 1, instance_id)
  binds = binds | sqlitebindtext(prepared, 2, requested_state)
  step = sqlitestep(prepared)
  call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then return _sqlitefailure("request process state", error)
  if _scalarint(store.database(), "SELECT changes()", error) \= 1 then do; if error = "" then error = "active worker was not found"; return -2; end
  return 0

processrequest: procedure = .string
  arg store = .ragstorehandle, instance_id = .string, expose error = .string
  error = ""
  value = _scalartext(store.database(), "SELECT coalesce(requested_state,'') FROM runtime_instances WHERE instance_id=" || _sqlquote(instance_id), error)
  if value = "" & error = "" then error = "process row was not found"
  return value

listprocesses: procedure = .int
  arg store = .ragstorehandle, kind_filter = .string, state_filter = .string, host_filter = .string, stale_seconds = .int, limit = .int, expose records = .ragprocessrecord[], expose error = .string
  records = .ragprocessrecord[]; error = ""
  if stale_seconds < 1 | stale_seconds > 86400 | limit < 1 | limit > 100 then do; error = "process list bounds are invalid"; return -1; end
  if kind_filter \= "all" & kind_filter \= "controller" & kind_filter \= "worker" then do; error = "process kind filter is invalid"; return -1; end
  if state_filter \= "" & state_filter \= "starting" & state_filter \= "idle" & state_filter \= "running" & state_filter \= "draining" & state_filter \= "stopped" & state_filter \= "failed" then do; error = "process state filter is invalid"; return -1; end
  if _validtext(host_filter, 255, 1) \= 1 then do; error = "process host filter is invalid"; return -1; end
  database = store.database(); prepared = .binary
  sql = "SELECT instance_id,kind,coalesce(parent_instance_id,''),host_id,pid,process_start_token,executable_identity,mode,job_filter,state,requested_state,current_item_id,started_at,heartbeat_at,max(0,CAST(strftime('%s','now') AS INTEGER)-heartbeat_at),CASE WHEN state IN('stopped','failed') THEN state WHEN heartbeat_at < CAST(strftime('%s','now') AS INTEGER)-?1 THEN 'stale' ELSE state END,detail FROM runtime_instances WHERE (?2='all' OR kind=?2) AND (?3='' OR state=?3) AND (?4='' OR host_id=?4) ORDER BY kind,instance_id LIMIT ?5"
  if sqliteprepare(database, sql, prepared) \= 0 then return _sqlitefailure("prepare process list", error)
  binds = sqlitebindint(prepared, 1, stale_seconds)
  binds = binds | sqlitebindtext(prepared, 2, kind_filter)
  binds = binds | sqlitebindtext(prepared, 3, state_filter)
  binds = binds | sqlitebindtext(prepared, 4, host_filter)
  binds = binds | sqlitebindint(prepared, 5, limit)
  if binds \= 0 then do; call sqlitefinalize prepared; return _sqlitefailure("bind process list", error); end
  do forever
    step = sqlitestep(prepared)
    if step = 101 then leave
    if step \= 100 then do; call sqlitefinalize prepared; return _sqlitefailure("step process list", error); end
    texts = .string[13]; integers = .int[4]
    column_status = sqlitecolumntext(prepared, 0, texts[1])
    column_status = column_status | sqlitecolumntext(prepared, 1, texts[2])
    column_status = column_status | sqlitecolumntext(prepared, 2, texts[3])
    column_status = column_status | sqlitecolumntext(prepared, 3, texts[4])
    column_status = column_status | sqlitecolumnint(prepared, 4, integers[1])
    column_status = column_status | sqlitecolumntext(prepared, 5, texts[5])
    column_status = column_status | sqlitecolumntext(prepared, 6, texts[6])
    column_status = column_status | sqlitecolumntext(prepared, 7, texts[7])
    column_status = column_status | sqlitecolumntext(prepared, 8, texts[8])
    column_status = column_status | sqlitecolumntext(prepared, 9, texts[9])
    column_status = column_status | sqlitecolumntext(prepared, 10, texts[10])
    column_status = column_status | sqlitecolumntext(prepared, 11, texts[11])
    column_status = column_status | sqlitecolumnint(prepared, 12, integers[2])
    column_status = column_status | sqlitecolumnint(prepared, 13, integers[3])
    column_status = column_status | sqlitecolumnint(prepared, 14, integers[4])
    column_status = column_status | sqlitecolumntext(prepared, 15, texts[12])
    column_status = column_status | sqlitecolumntext(prepared, 16, texts[13])
    if column_status \= 0 then do; call sqlitefinalize prepared; return _sqlitefailure("read process list", error); end
    records[records.0 + 1] = .ragprocessrecord(texts[1], texts[2], texts[3], texts[4], integers[1], texts[5], texts[6], texts[7], texts[8], texts[9], texts[10], texts[11], integers[2], integers[3], integers[4], texts[12], texts[13])
  end
  call sqlitefinalize prepared
  return records.0

pruneprocesses: procedure = .int
  arg store = .ragstorehandle, stale_seconds = .int, expose deleted = .int, expose error = .string
  deleted = 0; error = ""
  if stale_seconds < 1 | stale_seconds > 86400 then do; error = "stale threshold must be 1 through 86400 seconds"; return -1; end
  prepared = .binary; database = store.database()
  /* An old heartbeat is a reason to inspect ownership, never proof of death.
   * Only this host can establish that an active PID has exited. */
  sql = "SELECT instance_id,coalesce(pid,0),heartbeat_at,state,coalesce(parent_instance_id,'') FROM runtime_instances WHERE state IN('stopped','failed') OR (host_id=" || _sqlquote(currenthostid()) || " AND heartbeat_at < unixepoch()-?1)"
  if sqliteprepare(store.database(), sql, prepared) \= 0 then return _sqlitefailure("prepare process prune", error)
  binds = sqlitebindint(prepared, 1, stale_seconds); step = 0
  ids = .string[]; pids = .int[]; beats = .int[]; states = .string[]; parents = .string[]
  do forever
    step = sqlitestep(prepared)
    if step \= 100 then leave
    index = ids.0+1; identity = ""; pid = 0; beat = 0; state = ""; parent = ""
    columns = sqlitecolumntext(prepared,0,identity) | sqlitecolumnint(prepared,1,pid) | sqlitecolumnint(prepared,2,beat) | sqlitecolumntext(prepared,3,state) | sqlitecolumntext(prepared,4,parent)
    if columns \= 0 then do; call sqlitefinalize prepared; return _sqlitefailure("read process prune candidates",error); end
    ids[index]=identity; pids[index]=pid; beats[index]=beat; states[index]=state; parents[index]=parent
  end
  call sqlitefinalize prepared
  if binds \= 0 | step \= 101 then return _sqlitefailure("prune process rows", error)
  do index = 1 to ids.0
    if states[index] \= "stopped" & states[index] \= "failed" then do
      if pids[index] > 0 & processalive(pids[index]) \= 0 then iterate
      if pids[index] = 0 & parents[index] \= "" then do
        parent_pid = _scalarint(database,"SELECT coalesce(max(pid),0) FROM runtime_instances WHERE instance_id=" || _sqlquote(parents[index]),error)
        if error \= "" then return -2
        if parent_pid > 0 & processalive(parent_pid) \= 0 then iterate
      end
    end
    sql = "DELETE FROM runtime_instances WHERE instance_id=" || _sqlquote(ids[index]) || " AND heartbeat_at=" || beats[index] || " AND coalesce(pid,0)=" || pids[index] || " AND state=" || _sqlquote(states[index])
    if beginwritetransaction(database,"begin process prune",error) \= 0 then return -2
    if sqliteexec(database,sql) \= 0 then return _rollback(database,"prune confirmed process rows",error)
    changed = _scalarint(database,"SELECT changes()",error)
    if error \= "" then return _rollback(database,error,error)
    if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"commit process prune",error)
    deleted = deleted + changed
  end
  return 0

/* One routine restart path. Drain only the recorded selected group, then
 * reuse durable work recovery after every process has exited. No budgets,
 * receipts or task history are removed, and no old worker is adopted. */
cleanupjobprocesses: procedure = .int
  arg store = .ragstorehandle, job_id = .string, wait_seconds = .int, expose error = .string
  error = ""; database = store.database(); presence = ""
  if store.writable() \= 1 | job_id = "" | wait_seconds < 1 | wait_seconds > 86400 then do; error = "job cleanup inputs are invalid"; return -1; end
  if beginwritetransaction(database,"begin selected job cleanup",error) \= 0 then return -2
  overlapping = _scalarint(database,"SELECT count(*) FROM runtime_instances WHERE job_filter='' AND state NOT IN('stopped','failed')",error)
  if overlapping \= 0 | error \= "" then return _rollback(database,"unfiltered process ownership overlaps this job; drain that group explicitly",error)
  selector = "job_filter=" || _sqlquote(job_id)
  ids = .string[]; pids = .int[]; hosts = .string[]; kinds = .string[]
  if _grouprows(database,selector,ids,pids,hosts,kinds,error) \= 0 then return _rollback(database,error,error)
  identities = "''"; controllers = "''"
  do i = 1 to ids.0
    if hosts[i] \= currenthostid() then return _rollback(database,"job has remote ownership; restart in its launcher's process domain",error)
    if pids[i] > 0 then do
      presence = processpresence(pids[i],hosts[i])
      if presence \= "alive" & presence \= "missing" then return _rollback(database,"job process visibility is unverified; retain ownership and inspect in the launcher's domain",error)
    end
    identities = identities || "," || _sqlquote(ids[i])
    if kinds[i] = "controller" then controllers = controllers || "," || _sqlquote(ids[i])
  end
  /* Children reserved while startup is ending still belong to these same
   * controllers. A concurrently created fresh group never enters this scope. */
  selector = selector || " AND (instance_id IN(" || identities || ") OR parent_instance_id IN(" || controllers || "))"
  if sqliteexec(database,"UPDATE runtime_instances SET requested_state='drain',detail='ordinary job restart requested drain' WHERE " || selector || " AND state NOT IN('stopped','failed')") \= 0 then return _rollback(database,"request selected group drain",error)
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"commit selected group drain",error)
  deadline = _scalarint(database,"SELECT unixepoch()",error)+max(60,wait_seconds)
  do forever
    if _grouprows(database,selector,ids,pids,hosts,kinds,error) \= 0 then return -2
    live = 0
    do i = 1 to ids.0
      if pids[i] <= 0 then iterate
      presence = processpresence(pids[i],hosts[i])
      if presence = "alive" then live = live+1
      else if presence \= "missing" then do; error = "job process visibility became unverified during cleanup; ownership retained"; return -2; end
    end
    if live = 0 then leave
    if _scalarint(database,"SELECT unixepoch()",error) >= deadline then do; error = "selected group has not drained; ownership retained, repeat job run after its calls settle"; return -2; end
    if error \= "" then return -2
    call rxplatform..sleep 100
  end
  do i = 1 to ids.0
    if kinds[i] \= "worker" then iterate
    active = _scalarint(database,"SELECT count(*) FROM job_items WHERE job_id=" || _sqlquote(job_id) || " AND worker_id=" || _sqlquote(ids[i]) || " AND state IN('running','cancel_requested')",error)
    if error \= "" then return -2
    if active > 0 then if recoverworkerclaims(store,job_id,ids[i],error) \= 0 then return -2
  end
  /* Materialize the final identities: deleting a controller clears child
   * parent links through the foreign key, including late startup reservations. */
  identities = "''"
  do i = 1 to ids.0
    identities = identities || "," || _sqlquote(ids[i])
  end
  if beginwritetransaction(database,"finish selected job cleanup",error) \= 0 then return -2
  if sqliteexec(database,"DELETE FROM runtime_instances WHERE instance_id IN(" || identities || ")") \= 0 then return _rollback(database,"remove exited selected group",error)
  if sqliteexec(database,"COMMIT") \= 0 then return _rollback(database,"commit selected group cleanup",error)
  return 0

_grouprows: procedure = .int
  arg database = .binary, selector = .string, expose ids = .string[], expose pids = .int[], expose hosts = .string[], expose kinds = .string[], expose error = .string
  ids = .string[]; pids = .int[]; hosts = .string[]; kinds = .string[]; prepared = .binary
  if sqliteprepare(database,"SELECT instance_id,pid,host_id,kind FROM runtime_instances WHERE " || selector || " ORDER BY instance_id",prepared) \= 0 then return _sqlitefailure("inspect selected group",error)
  do forever
    step = sqlitestep(prepared)
    if step = 101 then leave
    id = ""; pid = 0; host_id = ""; kind = ""
    columns = sqlitecolumntext(prepared,0,id) | sqlitecolumnint(prepared,1,pid) | sqlitecolumntext(prepared,2,host_id) | sqlitecolumntext(prepared,3,kind)
    if step \= 100 | columns \= 0 then do; call sqlitefinalize prepared; return _sqlitefailure("read selected group",error); end
    index = ids.0+1; ids[index] = id; pids[index] = pid; hosts[index] = host_id; kinds[index] = kind
  end
  call sqlitefinalize prepared
  return 0

_parentavailable: procedure = .int
  arg store = .ragstorehandle, parent_id = .string, expose error = .string
  if parent_id = "" then return 1
  prepared = .binary
  if sqliteprepare(store.database(),"SELECT pid,host_id,state,requested_state FROM runtime_instances WHERE instance_id=" || _sqlquote(parent_id) || " AND kind='controller'",prepared) \= 0 then return _sqlitefailure("inspect worker controller",error)
  step = sqlitestep(prepared)
  if step = 101 then do; call sqlitefinalize prepared; return 0; end
  pid = 0; host_id = ""; state = ""; requested = ""
  columns = sqlitecolumnint(prepared,0,pid) | sqlitecolumntext(prepared,1,host_id) | sqlitecolumntext(prepared,2,state) | sqlitecolumntext(prepared,3,requested)
  call sqlitefinalize prepared
  if step \= 100 | columns \= 0 then return _sqlitefailure("read worker controller",error)
  if requested \= "none" | state = "stopped" | state = "failed" | state = "draining" then return 0
  presence = processpresence(pid,host_id)
  if presence = "alive" then return 1
  if presence = "missing" then return 0
  error = "controller process visibility is unverified; worker will take no further work"
  return -1

currentprocessid: procedure = .int
  captured = .string[]; errors = .string[]
  address crexx "pid" output captured error errors
  if rc \= 0 | captured.0 \= 1 then return 0
  return captured[1] as .int

currenthostid: procedure = .string
  return rxplatform..host()

processalive: procedure = .int
  arg pid = .int
  presence = processpresence(pid,currenthostid())
  if presence = "alive" then return 1
  if presence = "missing" then return 0
  return -1

runidleworker: procedure = .int
  arg library = .string, instance_id = .string, parent_instance_id = .string, host_id = .string, mode = .string, job_filter = .string, poll_milliseconds = .int, maximum_polls = .int, expose final_id = .string, expose error = .string
  final_id = instance_id; error = ""
  if poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 | (mode \= "once" & mode \= "follow") | _validtext(instance_id, 128, 1) \= 1 | _validtext(parent_instance_id, 128, 1) \= 1 | _validtext(host_id, 255, 1) \= 1 | _validtext(job_filter, 256, 1) \= 1 then do; error = "worker poll bounds are invalid"; return -1; end
  store = .ragstorehandle
  if openragstore(library, "readwrite", store, error) \= 0 then return -2
  if host_id = "" then host_id = currenthostid()
  if final_id = "" then final_id = newprocessidentity(store, "worker", error)
  pid = currentprocessid()
  start_token = _scalartext(store.database(), "SELECT lower(hex(randomblob(16)))", error)
  executable = _executableidentity()
  if error \= "" | final_id = "" | pid <= 0 | start_token = "" then do; ignored = ""; call closeragstore store, ignored; if error = "" then error = "worker process identity is unavailable"; return -2; end
  if activateprocess(store, final_id, "worker", parent_instance_id, host_id, pid, start_token, executable, mode, job_filter, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -2; end
  polls = 0; status = 0
  do forever
    polls = polls + 1
    parent_available = _parentavailable(store,parent_instance_id,error)
    if parent_available < 0 then do; status = -2; leave; end
    if parent_available = 0 then leave
    if _supervisorheartbeat(store, final_id, "idle", "", "waiting for durable work", error) \= 0 then do; status = -2; leave; end
    requested = processrequest(store, final_id, error)
    if error \= "" then do; status = -2; leave; end
    if requested = "stop" | requested = "drain" then leave
    if mode = "once" then leave
    if maximum_polls > 0 & polls >= maximum_polls then leave
    call rxplatform..sleep poll_milliseconds
  end
  terminal = "stopped"; exit_code = 0; detail = "worker stopped cleanly"
  if status \= 0 then do; terminal = "failed"; exit_code = 1; detail = error; end
  finish_error = ""
  if finishprocess(store, final_id, terminal, exit_code, detail, finish_error) \= 0 & error = "" then error = finish_error
  close_error = ""; close_status = closeragstore(store, close_error)
  if close_status \= 0 & error = "" then error = close_error
  if status \= 0 | close_status \= 0 then return -2
  return 0

runapplicationworker: procedure = .int expose _shutdown_signal
  arg library = .string, instance_id = .string, parent_instance_id = .string, host_id = .string, mode = .string, job_filter = .string, poll_milliseconds = .int, maximum_polls = .int, config = .ragconfig, profile = .ragprofile, progress = .string, format = .string, expose final_id = .string, expose processed = .int, expose error = .string, maximum_items = 0
  _shutdown_signal = ""
  signal on term, posix_int, posix_hup call _requestshutdown
  status = -2
  do
    status = _runapplicationworker(library,instance_id,parent_instance_id,host_id,mode,job_filter,poll_milliseconds,maximum_polls,config,profile,progress,format,final_id,processed,error,maximum_items)
  on signal channel_error as problem
    error = "worker channel failure: " || problem.message()
  end
  if status \= 0 then call writeoperatorline "crexxrag worker " || instance_id || ": " || error
  return status

_runapplicationworker: procedure = .int expose _shutdown_signal
  arg library = .string, instance_id = .string, parent_instance_id = .string, host_id = .string, mode = .string, job_filter = .string, poll_milliseconds = .int, maximum_polls = .int, config = .ragconfig, profile = .ragprofile, progress = .string, format = .string, expose final_id = .string, expose processed = .int, expose error = .string, maximum_items = 0
  final_id = instance_id; processed = 0; error = ""; parent_available = 1
  if poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 | maximum_items < 0 | maximum_items > 1000000 | (mode \= "once" & mode \= "follow") | _validtext(instance_id, 128, 1) \= 1 | _validtext(parent_instance_id, 128, 1) \= 1 | _validtext(host_id, 255, 1) \= 1 | _validtext(job_filter, 256, 1) \= 1 then do; error = "worker poll bounds are invalid"; return -1; end
  store = .ragstorehandle
  if openragstore(library, "readwrite", store, error) \= 0 then return -2
  if checkworkerconfiguration(store,job_filter,config,profile,error) \= 0 then do; ignored = ""; call closeragstore store,ignored; return -2; end
  if host_id = "" then host_id = currenthostid()
  if final_id = "" then final_id = newprocessidentity(store, "worker", error)
  pid = currentprocessid(); start_token = _scalartext(store.database(), "SELECT lower(hex(randomblob(16)))", error); executable = _executableidentity()
  if error \= "" | final_id = "" | pid <= 0 | start_token = "" then do; ignored = ""; call closeragstore store, ignored; if error = "" then error = "worker process identity is unavailable"; return -2; end
  if activateprocess(store, final_id, "worker", parent_instance_id, host_id, pid, start_token, executable, mode, job_filter, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -2; end
  /* Register the whole group before any child starts publication. Otherwise
   * ingestion writers can starve the remaining startup registrations. */
  if parent_instance_id \= "" then do
    parent_state = ""; parent_available = 1
    do startup_poll = 1 to 600
      if _shutdown_signal \= "" then leave
      parent_available = _parentavailable(store,parent_instance_id,error)
      if parent_available \= 1 then leave
      parent_state = _scalartext(store.database(),"SELECT state FROM runtime_instances WHERE instance_id=" || _sqlquote(parent_instance_id),error)
      if error \= "" | parent_state = "running" | parent_state = "failed" | parent_state = "stopped" | parent_state = "draining" then leave
      call rxplatform..sleep 100
    end
    if parent_available = 0 | parent_state = "draining" | _shutdown_signal \= "" then do
      detail = "controller ended before group admission"
      if _shutdown_signal \= "" then detail = "shutdown requested: " || _shutdown_signal
      ignored = ""; call finishprocess store,final_id,"stopped",0,detail,ignored
      call closeragstore store,ignored
      return 0
    end
    if parent_state \= "running" | parent_available < 0 then do
      if error = "" then error = "controller did not admit the complete worker group"
      ignored = ""; call finishprocess store,final_id,"failed",1,error,ignored
      call closeragstore store,ignored
      return -2
    end
  end
  tracer = .ragtracer(progress, format); provider = .ragapplicationprovider(store, config, profile, tracer); policy = effectiveclaimpolicy(profile)
  workers = config.workers(); lease_seconds = workers.lease_seconds(); maximum_attempts = _providerattempts(config)
  polls = 0; status = 0; call tracer.emit("worker", "start", final_id, mode)
  do forever
    polls = polls + 1
    if _shutdown_signal \= "" then leave
    parent_available = _parentavailable(store,parent_instance_id,error)
    if parent_available < 0 then do; status = -2; leave; end
    if parent_available = 0 then leave
    if _supervisorheartbeat(store, final_id, "idle", "", "waiting for durable work", error) \= 0 then do; status = -2; leave; end
    requested = processrequest(store, final_id, error)
    if error \= "" then do; status = -2; leave; end
    if requested = "stop" | requested = "drain" then do; call tracer.emit("worker", "draining", final_id, requested); leave; end
    disposition = ""
    work_status = runworkeronce(store, job_filter, final_id, lease_seconds, maximum_attempts, policy, provider, disposition, error, profile, parent_instance_id)
    if work_status = 1 then do
      call tracer.emit("work", "idle", final_id, "no eligible item")
      if job_filter \= "" then do
        job_state = _scalartext(store.database(), "SELECT state FROM jobs WHERE job_id=" || _sqlquote(job_filter), error)
        if error \= "" then do; status = -2; leave; end
        closed_window = 0
        if job_state = "paused" then closed_window = _scalarint(store.database(),"SELECT count(*) FROM maintenance_windows WHERE job_id=" || _sqlquote(job_filter) || " AND state<>'active'",error)
        if job_state = "completed" | job_state = "completed_with_errors" | job_state = "failed" | job_state = "cancelled" | job_state = "paused" | closed_window = 1 then do
          call tracer.emit("job", "complete", job_filter, job_state)
          leave
        end
      end
      if mode = "follow" & (maximum_polls = 0 | polls < maximum_polls) then call rxplatform..sleep poll_milliseconds
    end
    else if work_status \= 0 then do; status = work_status; call tracer.emit("work", "failed", final_id, disposition); leave; end
    else do
      if disposition \= "provider-deferred" then processed = processed + 1
      else call rxplatform..sleep poll_milliseconds
      call tracer.emit("work", "processed", final_id, disposition)
      if _supervisorheartbeat(store, final_id, "running", "", disposition, error) \= 0 then do; status = -2; leave; end
    end
    if provider.health_error() \= "" then do; status = -4; error = provider.health_error(); leave; end
    if mode = "once" then leave
    if maximum_polls > 0 & polls >= maximum_polls then leave
    if maximum_items > 0 & processed >= maximum_items then leave
  end
  terminal = "stopped"; exit_code = 0; detail = "application worker stopped cleanly"
  if _shutdown_signal \= "" then detail = "shutdown requested: " || _shutdown_signal || "; current work drained"
  if status \= 0 then do; terminal = "failed"; exit_code = 1; detail = error; end
  if status \= 0 & sqlitebusyerror(error) = 1 then exit_code = 75
  if provider.health_error() \= "" then do; terminal = "failed"; exit_code = 75; detail = provider.health_error(); status = -4; end
  detail = left(detail,min(length(detail),900)) || ";processed=" || processed || ";polls=" || polls
  finish_error = ""; if finishprocess(store, final_id, terminal, exit_code, detail, finish_error) \= 0 & error = "" then error = finish_error
  do
    call provider.close()
    if provider.health_error() \= "" then do
      status = -4; error = provider.health_error(); ignored = ""
      call finishprocess store,final_id,"failed",75,left(error,min(length(error),900)) || ";processed=" || processed || ";polls=" || polls,ignored
    end
  on signal channel_error as problem
    status = -2; error = "worker provider cleanup failed: " || problem.message()
    ignored = ""; call finishprocess store,final_id,"failed",26,error,ignored
  end
  close_error = ""; close_status = closeragstore(store, close_error); if close_status \= 0 & error = "" then error = close_error
  if status \= 0 | close_status \= 0 then return -2
  call tracer.emit("worker", "complete", final_id, "processed=" || processed)
  return 0

startworkerprocesses: procedure = .int expose _shutdown_signal
  arg library = .string, count = .int, poll_milliseconds = .int, maximum_polls = .int, job_filter = .string, config_id = .string, profile_id = .string, config_file = .string, progress = .string, format = .string, expose result = .ragprocessstartresult, expose error = .string, maximum_items = 0, max_restarts = 2, restart_backoff_ms = 5000, restart_window_seconds = 3600
  _shutdown_signal = ""
  signal on term, posix_int, posix_hup call _requestshutdown
  status = -2
  do
    status = _startworkerprocesses(library,count,poll_milliseconds,maximum_polls,job_filter,config_id,profile_id,config_file,progress,format,result,error,maximum_items,max_restarts,restart_backoff_ms,restart_window_seconds)
  on signal channel_error as problem
    error = "controller channel failure: " || problem.message()
  end
  if status \= 0 then call writeoperatorline "crexxrag controller: " || error
  return status

_startworkerprocesses: procedure = .int expose _shutdown_signal
  arg library = .string, count = .int, poll_milliseconds = .int, maximum_polls = .int, job_filter = .string, config_id = .string, profile_id = .string, config_file = .string, progress = .string, format = .string, expose result = .ragprocessstartresult, expose error = .string, maximum_items = 0, max_restarts = 2, restart_backoff_ms = 5000, restart_window_seconds = 3600
  result = .ragprocessstartresult("", count, 0, count); error = ""
  if count < 1 | count > 32 | poll_milliseconds < 10 | poll_milliseconds > 60000 | maximum_polls < 0 | maximum_polls > 1000000 | maximum_items < 0 | maximum_items > 1000000 | _validtext(job_filter, 256, 1) \= 1 then do; error = "controller bounds are invalid"; return -1; end
  if restart_window_seconds < 1 | restart_window_seconds > 86400 | max_restarts < 0 | max_restarts > 10 | restart_backoff_ms < 10 | restart_backoff_ms > 60000 then do; error = "worker replacement policy is invalid"; return -1; end
  runtime = getenv("CREXXRAG_RUNTIME"); image = getenv("CREXXRAG_IMAGE"); load_path = getenv("CREXXRAG_LOAD_PATH"); self_executable = getenv("CREXXRAG_SELF")
  if runtime = "" & self_executable = "" then self_executable = rxfs..loadpath() || "/crexxrag"
  if runtime \= "" & (image = "" | load_path = "") then do; error = "linked application runtime metadata is incomplete"; return -2; end
  store = .ragstorehandle
  if openragstore(library, "readwrite", store, error) \= 0 then return -2
  host_id = currenthostid(); pid = currentprocessid()
  controller_id = newprocessidentity(store, "controller", error)
  start_token = _scalartext(store.database(), "SELECT lower(hex(randomblob(16)))", error)
  executable = _executableidentity()
  if error \= "" | controller_id = "" | pid <= 0 | start_token = "" then do; ignored = ""; call closeragstore store, ignored; if error = "" then error = "controller process identity is unavailable"; return -2; end
  if activateprocess(store, controller_id, "controller", "", host_id, pid, start_token, executable, "wait", job_filter, error) \= 0 then do; ignored = ""; call closeragstore store, ignored; return -2; end

  if recordsupervision(store,job_filter,controller_id,count,max_restarts,restart_window_seconds,error) \= 0 then do
    ignored = ""; call finishprocess store,controller_id,"failed",1,error,ignored; call closeragstore store,ignored
    return -2
  end

  config_names = .string[]; config_values = .channelvalue[]
  config_names[1] = "capacity"; config_values[1] = .channelvalue.integer_value(count)
  channel_config = .channelvalue.record_value("crexx.channel.child-process-provider", 1, config_names, config_values)
  children = .channel.open(5, 255, channel_config)
  null_input = .byteendpoint.null_endpoint(1)
  null_output = .byteendpoint.null_endpoint(2)
  worker_ids = .string[]; request_ids = .int[]; remaining_items = .int[]; remaining_polls = .int[]
  requests = .channelrequest[]
  pending = .int[]; replacement_ids = .string[]; launch_at = .int[]; slot_failed = .int[]; parked_at = .int[]; reconsider_at = .int[]
  do i = 1 to count
    worker_id = newprocessidentity(store, "worker", error)
    if worker_id = "" | reserveprocess(store, worker_id, "worker", controller_id, host_id, "follow", job_filter, executable, error) \= 0 then do
      call children.close(2)
      call null_input.close()
      call null_output.close()
      ignored = ""; call finishprocess store, controller_id, "failed", 1, error, ignored; call closeragstore store, ignored
      return -2
    end
    worker_ids[i] = worker_id; remaining_items[i] = maximum_items; remaining_polls[i] = maximum_polls
    pending[i] = 0; replacement_ids[i] = ""; launch_at[i] = 0; slot_failed[i] = 0; parked_at[i] = 0; reconsider_at[i] = 0
  end
  /* No child publishes while the controller is still reserving the group. */
  do i = 1 to count
    worker_id = worker_ids[i]
    arguments = _childarguments(runtime, image, load_path, library, worker_id, controller_id, host_id, poll_milliseconds, maximum_polls, job_filter, config_id, profile_id, config_file, maximum_items)
    envelope = _childenvelope(runtime, self_executable, arguments, null_input.provider_reference(), null_output.provider_reference())
    request = children.start(envelope, -1)
    requests[i] = request
    request_ids[i] = request.identity()
    admission = request.completion()
    if admission.available() = 1 then if admission.succeeded() = 0 then do
      error = "worker " || worker_id || " launch rejected: " || admission.message()
      leave
    end
  end

  tracer = .ragtracer(progress, format)
  completed = 0; failed = 0; restarted = 0; first_failure_detail = ""; group_ready = 0; draining = 0
  replacement_id = ""; delay_ms = 0; heartbeat_epoch = 0
  startup_deadline = _scalarint(store.database(),"SELECT unixepoch()",error) + 60
  do while error = ""
    completion = children.wait(100)
    if completed = count then call rxplatform..sleep 100
    heartbeat_error = ""
    requested = processrequest(store,controller_id,heartbeat_error)
    if heartbeat_error \= "" then do; error = heartbeat_error; leave; end
    if _shutdown_signal \= "" then requested = "drain"
    if draining = 0 & (requested = "drain" | requested = "stop") then do
      draining = 1
      if _shutdown_signal \= "" then if sqliteexec(store.database(),"UPDATE runtime_instances SET requested_state='drain' WHERE instance_id=" || _sqlquote(controller_id)) \= 0 then do; error = "cannot record controller shutdown request"; leave; end
      if sqliteexec(store.database(),"UPDATE runtime_instances SET requested_state='drain',detail='controller draining' WHERE parent_instance_id=" || _sqlquote(controller_id) || " AND state NOT IN('stopped','failed')") \= 0 then do; error = "cannot drain controller children"; leave; end
    end
    if group_ready = 0 & draining = 0 then do
      registered = _scalarint(store.database(),"SELECT count(*) FROM runtime_instances WHERE parent_instance_id=" || _sqlquote(controller_id) || " AND pid>0 AND state IN('idle','running')",heartbeat_error)
      if heartbeat_error \= "" then do; error = heartbeat_error; leave; end
      if registered = count then group_ready = 1
      else if _scalarint(store.database(),"SELECT unixepoch()",heartbeat_error) >= startup_deadline then do; error = "worker registration timed out: " || registered || "/" || count || " registered"; leave; end
    end
    controller_state = "idle"; controller_detail = "waiting for all worker registrations"
    if group_ready = 1 then do; controller_state = "running"; controller_detail = "supervising " || count || " worker processes"; end
    if draining = 1 then do; controller_state = "draining"; controller_detail = "waiting for selected children to drain"; end
    if _shutdown_signal \= "" then controller_detail = "shutdown requested: " || _shutdown_signal || "; " || controller_detail
    now_epoch = _scalarint(store.database(),"SELECT unixepoch()",heartbeat_error)
    if now_epoch \= heartbeat_epoch then do
      if _supervisorheartbeat(store, controller_id, controller_state, "", controller_detail, heartbeat_error) \= 0 then do; error = heartbeat_error; leave; end
      heartbeat_epoch = now_epoch
    end
    if completion.available() = 1 then do
      completed = completed + 1; exit_code = 1
      if completion.succeeded() = 1 & completion.has_value() = 1 then exit_code = completion.value().as_integer()
      if exit_code \= 0 then failed = failed + 1
      worker_index = 0
      do i = 1 to request_ids.0
        if request_ids[i] = completion.request_identity() then worker_index = i
      end
      if worker_index > 0 then do
        slot_failed[worker_index] = exit_code \= 0
        do
          call requests[worker_index].release()
        on signal channel_error as problem
          error = "worker child request release failed: " || problem.message()
        end
        if error \= "" then leave
        worker_state = "complete"; if exit_code \= 0 then worker_state = "failed"
        call tracer.emit("worker", worker_state, worker_ids[worker_index], "completed=" || completed || "/" || count)
        state = _scalartext(store.database(), "SELECT state FROM runtime_instances WHERE instance_id=" || _sqlquote(worker_ids[worker_index]), heartbeat_error)
        if heartbeat_error \= "" then do; error=heartbeat_error; leave; end
        if state = "starting" then do
          terminal = "failed"; detail = "child process exited with code " || exit_code || " before worker registration"
          if exit_code = 0 then do; terminal = "stopped"; detail = "child process completed before worker registration"; end
          if finishprocess(store,worker_ids[worker_index],terminal,exit_code,detail,error) \= 0 then leave
        end
        else if state \= "stopped" & state \= "failed" then do
          terminal = "failed"; detail = "child process exited with code " || exit_code || " after worker registration"
          if exit_code = 0 then do; terminal = "stopped"; detail = "child process completed after worker registration"; end
          if finishprocess(store,worker_ids[worker_index],terminal,exit_code,detail,error) \= 0 then leave
        end
        if exit_code \= 0 & first_failure_detail = "" then do
          detail_error = ""
          first_failure_detail = _scalartext(store.database(), "SELECT coalesce((SELECT detail FROM runtime_instances WHERE instance_id=" || _sqlquote(worker_ids[worker_index]) || "),'child process failed without a runtime detail')", detail_error)
          if detail_error \= "" then first_failure_detail = "child process failed without a readable runtime detail"
          call writeoperatorline "crexxrag worker " || worker_ids[worker_index] || ": " || first_failure_detail
        end
      end
      if group_ready = 1 & draining = 0 & worker_index > 0 & job_filter \= "" then do
        previous_id = worker_ids[worker_index]
        if recoverworkerclaims(store,job_filter,previous_id,error) \= 0 then leave
        used_items = _scalarint(store.database(),"SELECT count(*) FROM attempts WHERE worker_id=" || _sqlquote(previous_id) || " AND outcome<>'cancelled'",error)
        used_polls = _scalarint(store.database(),"SELECT CASE WHEN instr(detail,';polls=')>0 THEN CAST(substr(detail,instr(detail,';polls=')+7) AS INTEGER) ELSE 0 END FROM runtime_instances WHERE instance_id=" || _sqlquote(previous_id),error)
        if error \= "" then leave
        if maximum_items > 0 then remaining_items[worker_index] = max(0,remaining_items[worker_index]-used_items)
        if maximum_polls > 0 then remaining_polls[worker_index] = max(0,remaining_polls[worker_index]-used_polls)
        batch_available = (maximum_items = 0 | remaining_items[worker_index] > 0) & (maximum_polls = 0 | remaining_polls[worker_index] > 0)
        if batch_available then do
          pending[worker_index] = 1; reconsider_at[worker_index] = 0
          parked_at[worker_index] = _scalarint(store.database(),"SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)",error)
        end
      end
    end /* observed completion */

    /* Reconsider parked slots even when no child remains. Reservation and
     * launch delays never block observation or draining of healthy peers. */
    pending_count = 0
    do slot = 1 to count
      if pending[slot] = 0 then iterate
      previous_id = worker_ids[slot]
      if draining = 1 | replacementallowed(store,job_filter,previous_id,error) \= 1 then do
        if replacement_ids[slot] \= "" then do
          ignored = ""; call finishprocess store,replacement_ids[slot],"stopped",0,"replacement cancelled before launch",ignored
        end
        pending[slot] = 0; iterate
      end
      now_ms = _scalarint(store.database(),"SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)",error)
      if pending[slot] = 1 & maximum_polls > 0 then do
        idle_polls = ((now_ms-parked_at[slot])/poll_milliseconds) as .int
        if idle_polls > 0 then do
          remaining_polls[slot] = max(0,remaining_polls[slot]-idle_polls)
          parked_at[slot] = parked_at[slot]+idle_polls*poll_milliseconds
        end
        if remaining_polls[slot] = 0 then do; pending[slot] = 0; iterate; end
      end
      if pending[slot] = 1 & now_ms >= reconsider_at[slot] then do
        reconsider_at[slot] = now_ms+1000
        replacement_id = ""; delay_ms = 0
        replacement_status = reserveworkerreplacement(store,controller_id,previous_id,max_restarts,restart_backoff_ms,replacement_id,delay_ms,error,restart_window_seconds)
        if replacement_status < 0 then leave
        if replacement_status = 1 then do; pending[slot] = 0; iterate; end
        if replacement_status = 0 then do
          replacement_ids[slot] = replacement_id; pending[slot] = 2
          launch_at[slot] = _scalarint(store.database(),"SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)",error)+delay_ms
          call tracer.emit("worker","replacing",previous_id,"replacement=" || replacement_id)
        end
      end
      if pending[slot] = 2 then do
        now_ms = _scalarint(store.database(),"SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)",error)
        if now_ms >= launch_at[slot] & error = "" then do
          replacement_id = replacement_ids[slot]
          arguments = _childarguments(runtime,image,load_path,library,replacement_id,controller_id,host_id,poll_milliseconds,remaining_polls[slot],job_filter,config_id,profile_id,config_file,remaining_items[slot])
          envelope = _childenvelope(runtime,self_executable,arguments,null_input.provider_reference(),null_output.provider_reference())
          request = children.start(envelope,-1)
          requests[slot] = request; worker_ids[slot] = replacement_id; request_ids[slot] = request.identity()
          pending[slot] = 0; replacement_ids[slot] = ""
          completed = completed-1; restarted = restarted+1
          failed = failed-slot_failed[slot]; slot_failed[slot] = 0
        end
      end
      if pending[slot] > 0 then pending_count = pending_count+1
    end
    /* A slot failure never drains healthy admitted peers. Report unreplaced
     * failures after those peers finish; startup failure remains a group error. */
    if failed > 0 & group_ready = 0 & draining = 0 then do; error = "worker group startup failed: " || first_failure_detail; leave; end
    if completed = count & pending_count = 0 then leave
  end
  if error \= "" then do
    /* Publish failure and drain requests before waiting for child cleanup. */
    call writeoperatorline "crexxrag controller " || controller_id || ": " || error
    ignored = ""; call finishprocess store,controller_id,"failed",1,error,ignored
    do i = 1 to worker_ids.0
      ignored = ""; call requestprocess store,worker_ids[i],"drain",ignored
    end
  end
  call children.close(1)
  call null_input.close()
  call null_output.close()
  controller_state = "stopped"; controller_exit = 0; controller_detail = "all worker processes completed"
  if error \= "" | failed > 0 then do; controller_state = "failed"; controller_exit = 1; controller_detail = "one or more worker processes failed"; end
  if _shutdown_signal \= "" then controller_detail = "shutdown requested: " || _shutdown_signal || "; " || controller_detail
  finish_error = ""; call finishprocess store, controller_id, controller_state, controller_exit, controller_detail, finish_error
  close_error = ""; close_status = closeragstore(store, close_error)
  result = .ragprocessstartresult(controller_id, count, completed, failed, restarted)
  if error = "" then error = finish_error
  if error = "" then error = close_error
  if error = "" & failed > 0 then do
    error = "one or more worker processes failed"
    if first_failure_detail \= "" then error = error || ": " || first_failure_detail
  end
  if error \= "" | failed > 0 | close_status \= 0 then return -2
  return 0

/* CREXX delivers this at a VM signal point. Only remember the first request;
 * the ordinary loops own SQLite, claims, child draining and final cleanup. */
_requestshutdown: procedure = .signalaction expose _shutdown_signal
  arg condition = .signal
  _shutdown_signal = .string
  if _shutdown_signal = "" then do
    select condition.name()
      when "TERM" then _shutdown_signal = "SIGTERM"
      when "POSIX_INT" then _shutdown_signal = "SIGINT"
      when "POSIX_HUP" then _shutdown_signal = "SIGHUP"
    end
  end
  return .signalaction.skip()

/* Only explicitly unhealthy, fully exited workers are candidates. The caller
 * has already observed child completion before invoking this reservation. */
reserveworkerreplacement: procedure = .int
  arg store = .ragstorehandle, controller_id = .string, previous_id = .string, maximum = .int, initial_backoff_ms = .int, expose replacement_id = .string, expose delay_ms = .int, expose error = .string, window_seconds = 3600
  return ragsupervision..reserveworkerreplacement(store,controller_id,previous_id,maximum,initial_backoff_ms,replacement_id,delay_ms,error,window_seconds)

_childarguments: procedure = .channelvalue
  arg runtime = .string, image = .string, load_path = .string, library = .string, worker_id = .string, controller_id = .string, host_id = .string, poll_milliseconds = .int, maximum_polls = .int, job_filter = .string, config_id = .string, profile_id = .string, config_file = .string, maximum_items = .int
  args = .string[]
  if runtime \= "" then do
    args[args.0 + 1] = "-l"; args[args.0 + 1] = load_path
    args[args.0 + 1] = image; args[args.0 + 1] = "-a"
  end
  args[args.0 + 1] = "--library"; args[args.0 + 1] = library
  args[args.0 + 1] = "--config"; args[args.0 + 1] = config_id
  args[args.0 + 1] = "--profile"; args[args.0 + 1] = profile_id
  if config_file \= "" then do; args[args.0 + 1] = "--config-file"; args[args.0 + 1] = config_file; end
  args[args.0 + 1] = "--access"; args[args.0 + 1] = "control"
  args[args.0 + 1] = "--format"; args[args.0 + 1] = "json"
  args[args.0 + 1] = "--progress"; args[args.0 + 1] = "off"
  args[args.0 + 1] = "worker"; args[args.0 + 1] = "run"
  args[args.0 + 1] = "--id"; args[args.0 + 1] = worker_id
  args[args.0 + 1] = "--parent"; args[args.0 + 1] = controller_id
  args[args.0 + 1] = "--host-id"; args[args.0 + 1] = host_id
  args[args.0 + 1] = "--follow"
  args[args.0 + 1] = "--poll-ms"; args[args.0 + 1] = poll_milliseconds
  args[args.0 + 1] = "--max-polls"; args[args.0 + 1] = maximum_polls
  if maximum_items > 0 then do; args[args.0 + 1] = "--max-items"; args[args.0 + 1] = maximum_items; end
  if job_filter \= "" then do; args[args.0 + 1] = "--job"; args[args.0 + 1] = job_filter; end
  values = .channelvalue[]
  do i = 1 to args.0
    values[i] = .channelvalue.string_value(args[i])
  end
  return .channelvalue.array_value(values)

_providerattempts: procedure = .int
  arg config = .ragconfig
  maximum = 1; providers = config.providers()
  do i = 1 to providers.0
    if providers[i].max_attempts() > maximum then maximum = providers[i].max_attempts()
  end
  return maximum

_childenvelope: procedure = .channelvalue
  arg runtime = .string, self_executable = .string, arguments = .channelvalue, stdin_reference = .channelvalue, output_reference = .channelvalue
  executable = self_executable
  if runtime \= "" then executable = runtime
  names = .string[]; values = .channelvalue[]; empty = .channelvalue[]
  names[1] = "arguments"; values[1] = arguments
  names[2] = "bindings"; values[2] = .channelvalue.array_value(empty)
  names[3] = "environment"; values[3] = .channelvalue.null_value()
  names[4] = "executable"; values[4] = .channelvalue.string_value(executable)
  names[5] = "mode"; values[5] = .channelvalue.integer_value(0)
  /* Inherit stderr so startup failures and runtime panics reach the caller's
   * diagnostic log. Keep child JSON stdout out of the controller's result. */
  names[6] = "stderr"; values[6] = .channelvalue.null_value()
  names[7] = "stdin"; values[7] = stdin_reference
  names[8] = "stdout"; values[8] = output_reference
  names[9] = "workingDirectory"; values[9] = .channelvalue.null_value()
  return .channelvalue.record_value("crexx.channel.child-process-start", 1, names, values)

_executableidentity: procedure = .string
  runtime = getenv("CREXXRAG_RUNTIME"); image = getenv("CREXXRAG_IMAGE"); self_executable = getenv("CREXXRAG_SELF")
  if runtime \= "" then return runtime || " " || image
  if self_executable \= "" then return self_executable
  return rxfs..loadpath() || "/crexxrag"

_scalartext: procedure = .string
  arg database = .binary, sql = .string, expose error = .string
  prepared = .binary; value = ""
  if sqliteprepare(database, sql, prepared) \= 0 then do; ignored = _sqlitefailure("prepare text query", error); return ""; end
  step = sqlitestep(prepared)
  if step = 100 then status = sqlitecolumntext(prepared, 0, value)
  else status = -1
  call sqlitefinalize prepared
  if step \= 100 | status \= 0 then do; ignored = _sqlitefailure("read text query", error); return ""; end
  return value

_scalarint: procedure = .int
  arg database = .binary, sql = .string, expose error = .string
  prepared = .binary; value = -1
  if sqliteprepare(database, sql, prepared) \= 0 then do; ignored = _sqlitefailure("prepare integer query", error); return -1; end
  step = sqlitestep(prepared)
  if step = 100 then status = sqlitecolumnint(prepared, 0, value)
  else status = -1
  call sqlitefinalize prepared
  if step \= 100 | status \= 0 then do; ignored = _sqlitefailure("read integer query", error); return -1; end
  return value

_sqlquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "''") || "'"

_validtext: procedure = .int
  arg value = .string, maximum = .int, allow_empty = .int
  if length(value) > maximum | pos("00"x, value) > 0 then return 0
  if allow_empty = 0 & value = "" then return 0
  return 1

_sqlitefailure: procedure = .int
  arg prefix = .string, expose error = .string
  boundary_code = 0; sqlite_code = 0; sqlite_extended = 0; operation = ""; message = ""
  call sqliteerrorextended boundary_code, sqlite_code, sqlite_extended, operation, message
  error = prefix || ": " || message || " [boundary=" || boundary_code || ",sqlite=" || sqlite_code || ",extended=" || sqlite_extended || ",operation=" || operation || "]"
  return -2

_rollback: procedure = .int
  arg database = .binary, prefix = .string, expose error = .string
  if error = "" then ignored = _sqlitefailure(prefix, error)
  call sqliteexec database, "ROLLBACK"
  return -2
