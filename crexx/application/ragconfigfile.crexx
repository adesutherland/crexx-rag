options levelg

namespace ragconfigfile expose loadconfigfile parseconfigtext resolveconfigpath

import rxfnsb
import rxfs
import ragmodel
import ragconfig
import ragworkerdefaults
import ragpromptdefaults
import ragfile

/* Human configuration is data, never executable module selection. The parser
 * is intentionally small, bounded, strict, and projects only into ragconfig. */
loadconfigfile: procedure = .int
  arg path = .string, expose config = .ragconfig, expose error = .string
  config = invalidconfig(); error = ""
  if path = "" | length(path) > 4096 | pos("00"x, path) > 0 then return _fail("configuration file path is invalid", error)
  raw = .binary; bytes = 0
  if ragfile..readbinaryfilebounded(path, 65536, raw, bytes, error) \= 0 then do
    error = "configuration file could not be read within the 65536-byte ceiling: " || error
    return -1
  end
  absolute_path = resolveconfigpath(path, rxfs..cwd())
  directory = left(absolute_path, lastpos("/", absolute_path))
  return parseconfigtext(raw as .string, config, error, directory)

parseconfigtext: procedure = .int
  arg text = .string, expose config = .ragconfig, expose error = .string, base_directory = ""
  config = invalidconfig(); error = ""
  if length(text) < 1 | length(text) > 65536 then return _fail("configuration text must contain 1 through 65536 bytes", error)
  if pos("00"x, text) > 0 then return _fail("configuration text contains a NUL byte", error)
  keys = .string[]; values = .string[]; start = 1; line_number = 0
  do forever
    marker = pos("0A"x, text, start)
    if marker = 0 then line = substr(text, start)
    else line = substr(text, start, marker - start)
    line_number = line_number + 1
    if line_number > 512 then return _fail("configuration exceeds the 512-line ceiling", error)
    if right(line, 1) = "0D"x then line = left(line, length(line) - 1)
    if length(line) > 4096 then return _fail("configuration line " || line_number || " exceeds 4096 bytes", error)
    if _hascontrol(line) = 1 then return _fail("configuration line " || line_number || " contains a control character", error)
    line = strip(line)
    if line \= "" & left(line, 1) \= "#" then do
      equals = pos("=", line)
      if equals < 2 then return _fail("configuration line " || line_number || " must be key = value", error)
      key = strip(substr(line, 1, equals - 1)); value = strip(substr(line, equals + 1))
      if key = "" | value = "" | length(key) > 256 | length(value) > 4096 then return _fail("configuration line " || line_number || " has an invalid key or value", error)
      if key \= lower(key) | _validconfigkey(key) \= 1 then return _fail("configuration line " || line_number || " has unknown or invalid key " || key, error)
      if _contains(keys, key) = 1 then return _fail("configuration key is duplicated: " || key, error)
      keys[keys.0 + 1] = key; values[values.0 + 1] = value
      if keys.0 > 256 then return _fail("configuration exceeds the 256-setting ceiling", error)
    end
    if marker = 0 then leave
    start = marker + 1
  end

  format = _required(keys, values, "format", error)
  if error \= "" then return -1
  if format \= "crexx-rag.config/1" & format \= "crexx-rag.config/2" & format \= "crexx-rag.config/3" then return _fail("unsupported configuration format " || format, error)
  format_three = format = "crexx-rag.config/3"
  config_id = _required(keys, values, "config.id", error)
  version = _required(keys, values, "config.version", error)
  if error \= "" then return -1

  source_ids = .string[]
  if _entityids(keys, "source.", 32, source_ids, error) \= 0 then return -1
  if source_ids.0 = 0 then return _fail("configuration requires at least one source", error)
  source_sets = .ragsourceset[]
  do i = 1 to source_ids.0
    prefix = "source." || source_ids[i] || "."
    connector = _required(keys, values, prefix || "connector", error)
    root = _required(keys, values, prefix || "root", error)
    include_text = _required(keys, values, prefix || "include", error)
    stable_key = _required(keys, values, prefix || "stable_key", error)
    privacy = _required(keys, values, prefix || "privacy", error)
    retain_text = _required(keys, values, prefix || "retain_raw_artifact", error)
    if error \= "" then return -1
    if _safesourcepath(root) \= 1 then return _fail(prefix || "root contains traversal or a control character", error)
    root = resolveconfigpath(root, base_directory)
    patterns = .string[]
    if _csv(include_text, 32, 256, patterns, error) \= 0 then return -1
    do j = 1 to patterns.0
      if _safepattern(patterns[j]) \= 1 then return _fail(prefix || "include contains an unsafe pattern", error)
    end
    retain = 0
    if _boolean(retain_text, prefix || "retain_raw_artifact", retain, error) \= 0 then return -1
    maximum_file_bytes = 2147483647; maximum_depth = 64
    setting = _optional(keys, values, prefix || "maximum_file_bytes")
    if setting \= "" then if _uint(setting, 1, 2147483647, prefix || "maximum_file_bytes", maximum_file_bytes, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "maximum_depth")
    if setting \= "" then if _uint(setting, 0, 256, prefix || "maximum_depth", maximum_depth, error) \= 0 then return -1
    source_sets[i] = .ragsourceset(source_ids[i], connector, root, patterns, stable_key, privacy, retain, maximum_file_bytes, maximum_depth)
  end

  provider_ids = .string[]
  if _entityids(keys, "provider.", 16, provider_ids, error) \= 0 then return -1
  if provider_ids.0 = 0 then return _fail("configuration requires at least one provider", error)
  providers = .ragproviderconfig[]
  do i = 1 to provider_ids.0
    prefix = "provider." || provider_ids[i] || "."
    kind = _required(keys, values, prefix || "kind", error)
    base_url = _required(keys, values, prefix || "base_url", error)
    model = _required(keys, values, prefix || "model", error)
    route_class = _required(keys, values, prefix || "route_class", error)
    privacy_policy = _required(keys, values, prefix || "privacy_policy", error)
    credential_text = _required(keys, values, prefix || "credential", error)
    timeout_text = _required(keys, values, prefix || "timeout_ms", error)
    attempts_text = _required(keys, values, prefix || "max_attempts", error)
    if error \= "" then return -1
    if pos(" ", base_url) > 0 | pos("09"x, base_url) > 0 then return _fail(prefix || "base_url contains whitespace", error)
    credential = .ragsecretref
    if _secret(credential_text, prefix || "credential", credential, error) \= 0 then return -1
    timeout_ms = 0; max_attempts = 0
    if _uint(timeout_text, 1, 600000, prefix || "timeout_ms", timeout_ms, error) \= 0 then return -1
    if _uint(attempts_text, 1, 10, prefix || "max_attempts", max_attempts, error) \= 0 then return -1
    requests_per_minute = 60000; tokens_per_minute = 2000000000; concurrent_requests = 64
    initial_backoff_ms = 1000; maximum_backoff_ms = 60000; jitter_ms = 250
    setting = _optional(keys, values, prefix || "requests_per_minute")
    if setting \= "" then if _uint(setting, 1, 60000, prefix || "requests_per_minute", requests_per_minute, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "tokens_per_minute")
    if setting \= "" then if _uint(setting, 1, 2000000000, prefix || "tokens_per_minute", tokens_per_minute, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "concurrent_requests")
    if setting \= "" then if _uint(setting, 1, 64, prefix || "concurrent_requests", concurrent_requests, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "initial_backoff_ms")
    if setting \= "" then if _uint(setting, 1, 60000, prefix || "initial_backoff_ms", initial_backoff_ms, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "maximum_backoff_ms")
    if setting \= "" then if _uint(setting, 1, 600000, prefix || "maximum_backoff_ms", maximum_backoff_ms, error) \= 0 then return -1
    setting = _optional(keys, values, prefix || "jitter_ms")
    if setting \= "" then if _uint(setting, 0, 60000, prefix || "jitter_ms", jitter_ms, error) \= 0 then return -1
    context_tokens = 2000000000; maximum_output_tokens = 2000000000
    embedding_dimensions_minimum = 1; embedding_dimensions_maximum = 1000000; maximum_batch_size = 1024
    input_price = -1; output_price = -1; observed_date = "compatibility-default"
    if format_three = 1 then do
      if _uint(_required(keys, values, prefix || "context_tokens", error), 1, 2000000000, prefix || "context_tokens", context_tokens, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "maximum_output_tokens", error), 0, 2000000000, prefix || "maximum_output_tokens", maximum_output_tokens, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "embedding_dimensions_minimum", error), 0, 1000000, prefix || "embedding_dimensions_minimum", embedding_dimensions_minimum, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "embedding_dimensions_maximum", error), 0, 1000000, prefix || "embedding_dimensions_maximum", embedding_dimensions_maximum, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "maximum_batch_size", error), 1, 4096, prefix || "maximum_batch_size", maximum_batch_size, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "input_price_microunits_per_million", error), 0, 2000000000, prefix || "input_price_microunits_per_million", input_price, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "output_price_microunits_per_million", error), 0, 2000000000, prefix || "output_price_microunits_per_million", output_price, error) \= 0 then return -1
      observed_date = _required(keys, values, prefix || "catalog_observed_date", error)
      if error \= "" then return -1
      if length(observed_date) \= 10 then return _fail(prefix || "catalog_observed_date must use YYYY-MM-DD", error)
    end
    reasoning_effort = _optional(keys, values, prefix || "reasoning_effort")
    providers[i] = .ragproviderconfig(provider_ids[i], kind, base_url, model, route_class, privacy_policy, credential, timeout_ms, max_attempts, requests_per_minute, tokens_per_minute, concurrent_requests, initial_backoff_ms, maximum_backoff_ms, jitter_ms, context_tokens, maximum_output_tokens, embedding_dimensions_minimum, embedding_dimensions_maximum, maximum_batch_size, input_price, output_price, observed_date, reasoning_effort)
  end

  roles = .ragrolebinding[]
  role_names = "advisory extractor embedding answerer"
  do i = 1 to words(role_names)
    role_name = word(role_names, i)
    prefix = "role." || role_name || "."
    provider_id = _optional(keys, values, "role." || role_name)
    maximum_input_tokens = _roleinputdefault(role_name); maximum_output_tokens = _roleoutputdefault(role_name); maximum_call_cost = _rolecostdefault(role_name)
    dimensions = 0; batch_size = 1; temperature = 0; system_prompt = defaultroleprompt(role_name)
    if role_name = "embedding" then do; dimensions = 768; batch_size = 100; end
    if format_three = 1 then do
      provider_id = _required(keys, values, prefix || "provider", error)
      if _uint(_required(keys, values, prefix || "max_input_tokens", error), 1, 2000000000, prefix || "max_input_tokens", maximum_input_tokens, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "max_output_tokens", error), 0, 2000000000, prefix || "max_output_tokens", maximum_output_tokens, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "max_call_cost_microunits", error), 0, 2000000000, prefix || "max_call_cost_microunits", maximum_call_cost, error) \= 0 then return -1
      if _uint(_required(keys, values, prefix || "temperature_millionths", error), 0, 2000000, prefix || "temperature_millionths", temperature, error) \= 0 then return -1
      if role_name = "embedding" then do
        if _uint(_required(keys, values, prefix || "dimensions", error), 1, 1000000, prefix || "dimensions", dimensions, error) \= 0 then return -1
        if _uint(_required(keys, values, prefix || "batch_size", error), 1, 4096, prefix || "batch_size", batch_size, error) \= 0 then return -1
      end
      else do
        system_prompt = _optional(keys, values, prefix || "system_prompt")
        prompt_path = _optional(keys, values, prefix || "system_prompt_file")
        if (system_prompt = "" & prompt_path = "") | (system_prompt \= "" & prompt_path \= "") then return _fail(prefix || "requires exactly one of system_prompt or system_prompt_file", error)
        if prompt_path \= "" then do
          if _safesourcepath(prompt_path) \= 1 then return _fail(prefix || "system_prompt_file contains traversal or a control character", error)
          prompt_raw = .binary; prompt_bytes = 0
          if ragfile..readbinaryfilebounded(resolveconfigpath(prompt_path, base_directory), 16384, prompt_raw, prompt_bytes, error) \= 0 then return _fail(prefix || "system_prompt_file could not be read within 16384 bytes: " || error, error)
          system_prompt = prompt_raw as .string
          if strip(system_prompt) = "" | pos("00"x, system_prompt) > 0 then return _fail(prefix || "system_prompt_file is empty or contains a NUL byte", error)
        end
      end
    end
    /* Codex receipts include managed context in addition to our source packet.
     * Explicit format-3 envelopes remain authoritative. */
    if format_three = 0 & role_name = "extractor" then do
      do j = 1 to providers.0
        if providers[j].provider_id() = provider_id & providers[j].kind() = "codex" then maximum_input_tokens = 32768
      end
    end
    if provider_id \= "" then roles[roles.0 + 1] = .ragrolebinding(role_name, provider_id, maximum_input_tokens, maximum_output_tokens, maximum_call_cost, dimensions, batch_size, temperature, system_prompt)
  end

  profile_text = _required(keys, values, "profiles", error)
  if error \= "" then return -1
  profile_ids = .string[]
  if _csv(profile_text, 32, 64, profile_ids, error) \= 0 then return -1
  do i = 1 to profile_ids.0
    if validregistryid(profile_ids[i]) \= 1 then return _fail("profiles contains an invalid registered id", error)
  end
  profile_file_ids = .string[]
  if _entityids(keys, "profile.", 32, profile_file_ids, error) \= 0 then return -1
  profile_files = .ragprofilefilebinding[]
  do i = 1 to profile_file_ids.0
    prefix = "profile." || profile_file_ids[i] || "."
    profile_path = _required(keys, values, prefix || "file", error)
    if error \= "" then return -1
    if _contains(profile_ids, profile_file_ids[i]) \= 1 then return _fail(prefix || "file names a profile not selected by profiles", error)
    if _safesourcepath(profile_path) \= 1 then return _fail(prefix || "file contains traversal or a control character", error)
    profile_path = resolveconfigpath(profile_path, base_directory)
    profile_files[i] = .ragprofilefilebinding(profile_file_ids[i], profile_path)
  end

  minutes = 0; item_limit = 0; model_calls = 0; input_tokens = 0; output_tokens = 0; cost = 0; codex_turns = 0; minimum_codex_allowance = 0
  if _uint(_required(keys, values, "budget.minutes", error), 0, 10080, "budget.minutes", minutes, error) \= 0 then return -1
  if _uint(_required(keys, values, "budget.item_limit", error), 0, 1000000, "budget.item_limit", item_limit, error) \= 0 then return -1
  if _uint(_required(keys, values, "budget.model_calls", error), 0, 1000000, "budget.model_calls", model_calls, error) \= 0 then return -1
  if _uint(_required(keys, values, "budget.input_tokens", error), 0, 2000000000, "budget.input_tokens", input_tokens, error) \= 0 then return -1
  if _uint(_required(keys, values, "budget.output_tokens", error), 0, 2000000000, "budget.output_tokens", output_tokens, error) \= 0 then return -1
  if _uint(_required(keys, values, "budget.cost_microunits", error), 0, 2000000000, "budget.cost_microunits", cost, error) \= 0 then return -1
  codex_turns_text = _optional(keys, values, "budget.codex_turns")
  if codex_turns_text \= "" then do
    if _uint(codex_turns_text, 0, 1000000, "budget.codex_turns", codex_turns, error) \= 0 then return -1
  end
  minimum_codex_allowance_text = _optional(keys, values, "budget.minimum_codex_allowance_percent")
  if minimum_codex_allowance_text \= "" then do
    if _uint(minimum_codex_allowance_text, 0, 100, "budget.minimum_codex_allowance_percent", minimum_codex_allowance, error) \= 0 then return -1
  end
  if error \= "" then return -1

  processes = 0; max_in_flight = 0; lease_seconds = 0; poll_ms = workerdefault("poll_ms"); guided_deadline_seconds = workerdefault("guided_deadline_seconds"); max_restarts = workerdefault("max_restarts"); restart_backoff_ms = workerdefault("restart_backoff_ms"); restart_window_seconds = workerdefault("restart_window_seconds")
  if _uint(_required(keys, values, "worker.processes", error), 1, 32, "worker.processes", processes, error) \= 0 then return -1
  if _uint(_required(keys, values, "worker.max_in_flight", error), 1, 1, "worker.max_in_flight", max_in_flight, error) \= 0 then return -1
  if _uint(_required(keys, values, "worker.lease_seconds", error), 1, 86400, "worker.lease_seconds", lease_seconds, error) \= 0 then return -1
  setting = _optional(keys, values, "worker.restart_window_seconds")
  if setting \= "" then if _uint(setting, workerminimum("restart_window_seconds"), workermaximum("restart_window_seconds"), "worker.restart_window_seconds", restart_window_seconds, error) \= 0 then return -1
  setting = _optional(keys, values, "worker.max_restarts")
  if setting \= "" then if _uint(setting, workerminimum("max_restarts"), workermaximum("max_restarts"), "worker.max_restarts", max_restarts, error) \= 0 then return -1
  setting = _optional(keys, values, "worker.restart_backoff_ms")
  if setting \= "" then if _uint(setting, workerminimum("restart_backoff_ms"), workermaximum("restart_backoff_ms"), "worker.restart_backoff_ms", restart_backoff_ms, error) \= 0 then return -1
  setting = _optional(keys, values, "worker.poll_ms")
  if format_three = 1 then setting = _required(keys, values, "worker.poll_ms", error)
  if setting \= "" then if _uint(setting, workerminimum("poll_ms"), workermaximum("poll_ms"), "worker.poll_ms", poll_ms, error) \= 0 then return -1
  setting = _optional(keys, values, "worker.guided_deadline_seconds")
  if format_three = 1 then setting = _required(keys, values, "worker.guided_deadline_seconds", error)
  if setting \= "" then if _uint(setting, workerminimum("guided_deadline_seconds"), workermaximum("guided_deadline_seconds"), "worker.guided_deadline_seconds", guided_deadline_seconds, error) \= 0 then return -1
  if error \= "" then return -1

  schedule_ids = .string[]
  if _entityids(keys, "schedule.", 32, schedule_ids, error) \= 0 then return -1
  schedules = .ragschedule[]
  do i = 1 to schedule_ids.0
    prefix = "schedule." || schedule_ids[i] || "."
    trigger = _required(keys, values, prefix || "trigger", error)
    schedule_operation = _required(keys, values, prefix || "operation", error)
    enabled_text = _required(keys, values, prefix || "enabled", error)
    if error \= "" then return -1
    enabled = 0
    if _boolean(enabled_text, prefix || "enabled", enabled, error) \= 0 then return -1
    schedules[i] = .ragschedule(schedule_ids[i], trigger, enabled, schedule_operation)
  end

  discovery_mode = _optional(keys, values, "discovery.mode")
  if discovery_mode = "" then discovery_mode = "all"
  glossary_path = _optional(keys, values, "discovery.glossary_file")
  if glossary_path \= "" & _safesourcepath(glossary_path) \= 1 then return _fail("discovery.glossary_file contains traversal or a control character", error)
  if glossary_path \= "" then glossary_path = resolveconfigpath(glossary_path, base_directory)
  ranked_limit = 64; max_mentions = 16; max_relationships = 16; max_notes = 16
  setting = _optional(keys, values, "discovery.ranked_limit")
  if setting \= "" then if _uint(setting, 1, 1000000, "discovery.ranked_limit", ranked_limit, error) \= 0 then return -1
  setting = _optional(keys, values, "discovery.max_mentions")
  if setting \= "" then if _uint(setting, 1, 64, "discovery.max_mentions", max_mentions, error) \= 0 then return -1
  setting = _optional(keys, values, "discovery.max_relationships")
  if setting \= "" then if _uint(setting, 1, 64, "discovery.max_relationships", max_relationships, error) \= 0 then return -1
  setting = _optional(keys, values, "discovery.max_notes")
  if setting \= "" then if _uint(setting, 1, 64, "discovery.max_notes", max_notes, error) \= 0 then return -1
  discovery = .ragdiscoverypolicy(discovery_mode, glossary_path, ranked_limit, max_mentions, max_relationships, max_notes)

  vector_algorithm = _optional(keys, values, "vector.algorithm")
  if vector_algorithm = "" then vector_algorithm = "ivf-flat-v1"
  centroids = 16; probes = 4; iterations = 2; recall_minimum = 900000; maximum_rows = 1000000; maximum_sidecar_bytes = 67108864; embedding_maximum_items = 100000
  setting = _optional(keys, values, "vector.centroids")
  if setting \= "" then if _uint(setting, 1, 4096, "vector.centroids", centroids, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.probes")
  if setting \= "" then if _uint(setting, 1, 4096, "vector.probes", probes, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.iterations")
  if setting \= "" then if _uint(setting, 1, 16, "vector.iterations", iterations, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.recall_minimum_millionths")
  if setting \= "" then if _uint(setting, 1, 1000000, "vector.recall_minimum_millionths", recall_minimum, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.maximum_rows"); if format_three = 1 then setting = _required(keys, values, "vector.maximum_rows", error)
  if setting \= "" then if _uint(setting, 1, 1000000, "vector.maximum_rows", maximum_rows, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.maximum_sidecar_bytes"); if format_three = 1 then setting = _required(keys, values, "vector.maximum_sidecar_bytes", error)
  if setting \= "" then if _uint(setting, 1048576, 2000000000, "vector.maximum_sidecar_bytes", maximum_sidecar_bytes, error) \= 0 then return -1
  setting = _optional(keys, values, "vector.embedding_maximum_items"); if format_three = 1 then setting = _required(keys, values, "vector.embedding_maximum_items", error)
  if setting \= "" then if _uint(setting, 1, 1000000, "vector.embedding_maximum_items", embedding_maximum_items, error) \= 0 then return -1
  vector = .ragvectorpolicy(vector_algorithm, centroids, probes, iterations, recall_minimum, maximum_rows, maximum_sidecar_bytes, embedding_maximum_items)

  lexical_candidates = 48; vector_candidates = 12; vector_scan_limit = 100000; graph_hops = 3; passage_limit = 12; claim_limit = 8; lead_limit = 8; rrf_k = 60
  graph_boost = 2000; graph_decay = 750000; directness_bonus = 1000; graph_direction = _optional(keys, values, "retrieval.graph_direction"); if graph_direction = "" then graph_direction = "both"
  maximum_evidence_bytes = 262144
  setting = _optional(keys, values, "retrieval.lexical_candidates"); if setting \= "" then if _uint(setting, 1, 1000, "retrieval.lexical_candidates", lexical_candidates, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.vector_candidates"); if setting \= "" then if _uint(setting, 1, 1000, "retrieval.vector_candidates", vector_candidates, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.vector_scan_limit"); if setting \= "" then if _uint(setting, 1, 1000000, "retrieval.vector_scan_limit", vector_scan_limit, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.graph_hops"); if setting \= "" then if _uint(setting, 0, 4, "retrieval.graph_hops", graph_hops, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.passage_limit"); if setting \= "" then if _uint(setting, 1, querypassagemaximum(), "retrieval.passage_limit", passage_limit, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.claim_limit"); if setting \= "" then if _uint(setting, 0, 8, "retrieval.claim_limit", claim_limit, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.lead_limit"); if setting \= "" then if _uint(setting, 0, 8, "retrieval.lead_limit", lead_limit, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.rrf_k"); if setting \= "" then if _uint(setting, 1, 10000, "retrieval.rrf_k", rrf_k, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.graph_boost_millionths"); if setting \= "" then if _uint(setting, 0, 1000000, "retrieval.graph_boost_millionths", graph_boost, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.graph_decay_millionths"); if setting \= "" then if _uint(setting, 1, 1000000, "retrieval.graph_decay_millionths", graph_decay, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.directness_bonus_millionths"); if setting \= "" then if _uint(setting, 0, 1000000, "retrieval.directness_bonus_millionths", directness_bonus, error) \= 0 then return -1
  setting = _optional(keys, values, "retrieval.maximum_evidence_bytes"); if setting \= "" then if _uint(setting, 65536, 1048576, "retrieval.maximum_evidence_bytes", maximum_evidence_bytes, error) \= 0 then return -1
  retrieval = .ragretrievalpolicy(lexical_candidates, vector_candidates, vector_scan_limit, graph_hops, passage_limit, claim_limit, lead_limit, rrf_k, graph_boost, graph_decay, directness_bonus, graph_direction, maximum_evidence_bytes)

  sparse_max_degree = 1; query_gap_min_occurrences = 1; maintenance_batch_items = 1000
  setting = _optional(keys, values, "maintenance.sparse_max_degree"); if setting \= "" then if _uint(setting, 0, 1000, "maintenance.sparse_max_degree", sparse_max_degree, error) \= 0 then return -1
  setting = _optional(keys, values, "maintenance.query_gap_min_occurrences"); if setting \= "" then if _uint(setting, 1, 1000000, "maintenance.query_gap_min_occurrences", query_gap_min_occurrences, error) \= 0 then return -1
  setting = _optional(keys, values, "maintenance.batch_items"); if setting \= "" then if _uint(setting, 1, 100000, "maintenance.batch_items", maintenance_batch_items, error) \= 0 then return -1
  defaults = .ragmaintenancepolicy()
  mode = defaults.mode()
  setting = _optional(keys, values, "maintenance.mode"); if setting \= "" then mode = setting
  window_seconds = defaults.window_seconds()
  setting = _optional(keys, values, "maintenance.window_seconds"); if setting \= "" then if _uint(setting, 1, 86400, "maintenance.window_seconds", window_seconds, error) \= 0 then return -1
  automatic_actions = defaults.automatic_actions()
  setting = _optional(keys, values, "maintenance.automatic_actions"); if setting \= "" then automatic_actions = setting
  maximum_impact = defaults.maximum_impact()
  setting = _optional(keys, values, "maintenance.maximum_impact"); if setting \= "" then if _uint(setting, 1, 100000, "maintenance.maximum_impact", maximum_impact, error) \= 0 then return -1
  maximum_attempts = defaults.maximum_attempts()
  setting = _optional(keys, values, "maintenance.maximum_attempts"); if setting \= "" then if _uint(setting, 1, 10, "maintenance.maximum_attempts", maximum_attempts, error) \= 0 then return -1
  retry_seconds = defaults.retry_seconds()
  setting = _optional(keys, values, "maintenance.retry_seconds"); if setting \= "" then if _uint(setting, 1, 604800, "maintenance.retry_seconds", retry_seconds, error) \= 0 then return -1
  maximum_evidence_bytes = defaults.maximum_evidence_bytes()
  setting = _optional(keys, values, "maintenance.maximum_evidence_bytes"); if setting \= "" then if _uint(setting, 1024, 1048576, "maintenance.maximum_evidence_bytes", maximum_evidence_bytes, error) \= 0 then return -1
  resolution_prompt = defaults.resolution_prompt()
  setting = _optional(keys, values, "maintenance.resolution_prompt"); if setting \= "" then resolution_prompt = setting
  provider_time_minutes = 0
  setting = _optional(keys, values, "maintenance.provider_time_minutes"); if setting \= "" then if _uint(setting, 0, 10080, "maintenance.provider_time_minutes", provider_time_minutes, error) \= 0 then return -1
  maintenance = .ragmaintenancepolicy(sparse_max_degree, query_gap_min_occurrences, maintenance_batch_items, mode, window_seconds, automatic_actions, maximum_impact, maximum_attempts, retry_seconds, maximum_evidence_bytes, resolution_prompt, provider_time_minutes)

  capture_threshold = 50; cooldown_seconds = 900; maximum_staleness_seconds = 86400; work_minimum_change = 25; work_relative_millionths = 50000; dead_letter_minimum_change = 25; review_minimum_change = 10; narrative_output_tokens = 1024
  setting = _optional(keys, values, "observation.capture_threshold"); if setting \= "" then if _uint(setting, 1, 1000000, "observation.capture_threshold", capture_threshold, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.cooldown_seconds"); if setting \= "" then if _uint(setting, 0, 604800, "observation.cooldown_seconds", cooldown_seconds, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.maximum_staleness_seconds"); if setting \= "" then if _uint(setting, 1, 31536000, "observation.maximum_staleness_seconds", maximum_staleness_seconds, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.work_minimum_change"); if setting \= "" then if _uint(setting, 1, 1000000, "observation.work_minimum_change", work_minimum_change, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.work_relative_millionths"); if setting \= "" then if _uint(setting, 1, 1000000, "observation.work_relative_millionths", work_relative_millionths, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.dead_letter_minimum_change"); if setting \= "" then if _uint(setting, 1, 1000000, "observation.dead_letter_minimum_change", dead_letter_minimum_change, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.review_minimum_change"); if setting \= "" then if _uint(setting, 1, 1000000, "observation.review_minimum_change", review_minimum_change, error) \= 0 then return -1
  setting = _optional(keys, values, "observation.narrative_output_tokens"); if setting \= "" then if _uint(setting, 256, 8192, "observation.narrative_output_tokens", narrative_output_tokens, error) \= 0 then return -1
  observation = .ragobservationpolicy(capture_threshold, cooldown_seconds, maximum_staleness_seconds, work_minimum_change, work_relative_millionths, dead_letter_minimum_change, review_minimum_change, narrative_output_tokens)

  plan_ttl_seconds = 3600; setting = _optional(keys, values, "plan.ttl_seconds")
  if setting \= "" then if _uint(setting, 1, 604800, "plan.ttl_seconds", plan_ttl_seconds, error) \= 0 then return -1
  candidate = .ragconfig(config_id, version, source_sets, providers, roles, profile_ids, .ragbudget(minutes, item_limit, model_calls, input_tokens, output_tokens, cost, codex_turns, minimum_codex_allowance), .ragworkerpolicy(processes, max_in_flight, lease_seconds, poll_ms, guided_deadline_seconds, max_restarts, restart_backoff_ms, restart_window_seconds), schedules, discovery, vector, retrieval, maintenance, observation, profile_files, plan_ttl_seconds)
  validation = validateconfig(candidate)
  if validation.ok() \= 1 then do
    issues = validation.issues()
    return _fail("configuration validation failed at " || issues[1].path() || ": " || issues[1].message(), error)
  end
  config = candidate
  return 0

_validconfigkey: procedure = .int
  arg key = .string
  if left(key,7) = "worker." & workersettingknown(substr(key,8)) = 1 then return 1
  if wordpos(key, "plan.ttl_seconds format config.id config.version profiles budget.minutes budget.item_limit budget.model_calls budget.input_tokens budget.output_tokens budget.cost_microunits budget.codex_turns budget.minimum_codex_allowance_percent worker.processes worker.max_in_flight worker.lease_seconds discovery.mode discovery.glossary_file discovery.ranked_limit discovery.max_mentions discovery.max_relationships discovery.max_notes vector.algorithm vector.centroids vector.probes vector.iterations vector.recall_minimum_millionths vector.maximum_rows vector.maximum_sidecar_bytes vector.embedding_maximum_items retrieval.lexical_candidates retrieval.vector_candidates retrieval.vector_scan_limit retrieval.graph_hops retrieval.passage_limit retrieval.claim_limit retrieval.lead_limit retrieval.rrf_k retrieval.graph_boost_millionths retrieval.graph_decay_millionths retrieval.directness_bonus_millionths retrieval.graph_direction retrieval.maximum_evidence_bytes maintenance.mode maintenance.provider_time_minutes maintenance.window_seconds maintenance.automatic_actions maintenance.maximum_impact maintenance.maximum_attempts maintenance.retry_seconds maintenance.maximum_evidence_bytes maintenance.resolution_prompt maintenance.sparse_max_degree maintenance.query_gap_min_occurrences maintenance.batch_items observation.capture_threshold observation.cooldown_seconds observation.maximum_staleness_seconds observation.work_minimum_change observation.work_relative_millionths observation.dead_letter_minimum_change observation.review_minimum_change observation.narrative_output_tokens") > 0 then return 1
  if _entitykey(key, "source.", "connector root include stable_key privacy retain_raw_artifact maximum_file_bytes maximum_depth") = 1 then return 1
  if _entitykey(key, "provider.", "kind base_url model route_class privacy_policy credential timeout_ms max_attempts requests_per_minute tokens_per_minute concurrent_requests initial_backoff_ms maximum_backoff_ms jitter_ms context_tokens maximum_output_tokens embedding_dimensions_minimum embedding_dimensions_maximum maximum_batch_size input_price_microunits_per_million output_price_microunits_per_million catalog_observed_date reasoning_effort") = 1 then return 1
  if _entitykey(key, "schedule.", "operation trigger enabled") = 1 then return 1
  if _entitykey(key, "profile.", "file") = 1 then return 1
  if left(key, 5) = "role." then do
    rest = substr(key, 6); marker = pos(".", rest)
    if marker = 0 then return wordpos(rest, "advisory extractor embedding answerer") > 0
    role = substr(rest, 1, marker - 1); field = substr(rest, marker + 1)
    if wordpos(role, "advisory extractor embedding answerer") = 0 then return 0
    return wordpos(field, "provider max_input_tokens max_output_tokens max_call_cost_microunits dimensions batch_size temperature_millionths system_prompt system_prompt_file") > 0
  end
  return 0

/* Resolve once when loading configuration, so every consumer and child worker
 * uses the same path and canonical identity regardless of working directory.
 * Pure parseconfigtext callers may omit the base for in-memory fixtures. */
resolveconfigpath: procedure = .string
  arg path = .string, base_directory = .string
  if base_directory = "" then return path
  path = changestr("\", path, "/"); base_directory = changestr("\", base_directory, "/")
  if left(path, 1) \= "/" & substr(path, 2, 1) \= ":" then path = base_directory || "/" || path
  prefix = "/"; start = 2
  if substr(path, 2, 1) = ":" then do; prefix = left(path, 2) || "/"; start = 4; end
  if left(path, 2) = "//" then prefix = "//"
  parts = .string[]; part_count = 0
  do forever
    marker = pos("/", path, start)
    part = substr(path, start); if marker > 0 then part = substr(path, start, marker - start)
    if part = ".." then do
      if part_count > 0 then part_count = part_count - 1
    end
    else if part \= "" & part \= "." then do; part_count = part_count + 1; parts[part_count] = part; end
    if marker = 0 then leave
    start = marker + 1
  end
  output = prefix
  do i = 1 to part_count
    if i > 1 then output = output || "/"
    output = output || parts[i]
  end
  return output

_entitykey: procedure = .int
  arg key = .string, prefix = .string, allowed_fields = .string
  if left(key, length(prefix)) \= prefix then return 0
  rest = substr(key, length(prefix) + 1); marker = pos(".", rest)
  if marker < 2 | marker = length(rest) then return 0
  identifier = substr(rest, 1, marker - 1); field = substr(rest, marker + 1)
  if pos(".", field) > 0 | validregistryid(identifier) \= 1 then return 0
  return wordpos(field, allowed_fields) > 0

_entityids: procedure = .int
  arg keys = .string[], prefix = .string, maximum = .int, expose ids = .string[], expose error = .string
  clear ids
  do i = 1 to keys.0
    if left(keys[i], length(prefix)) \= prefix then iterate
    rest = substr(keys[i], length(prefix) + 1); marker = pos(".", rest)
    identifier = substr(rest, 1, marker - 1)
    if _contains(ids, identifier) = 0 then ids[ids.0 + 1] = identifier
    if ids.0 > maximum then return _fail("configuration exceeds the " || maximum || "-entry ceiling for " || prefix, error)
  end
  return 0

_required: procedure = .string
  arg keys = .string[], values = .string[], key = .string, expose error = .string
  value = _optional(keys, values, key)
  if value = "" & error = "" then error = "configuration requires " || key
  return value

_optional: procedure = .string
  arg keys = .string[], values = .string[], key = .string
  do i = 1 to keys.0
    if keys[i] = key then return values[i]
  end
  return ""

_csv: procedure = .int
  arg text = .string, maximum_items = .int, maximum_item_bytes = .int, expose output = .string[], expose error = .string
  clear output; start = 1
  do forever
    marker = pos(",", text, start)
    if marker = 0 then value = strip(substr(text, start))
    else value = strip(substr(text, start, marker - start))
    if value = "" | length(value) > maximum_item_bytes then return _fail("configuration list contains an empty or oversized item", error)
    if _contains(output, value) = 1 then return _fail("configuration list contains duplicate item " || value, error)
    output[output.0 + 1] = value
    if output.0 > maximum_items then return _fail("configuration list exceeds the " || maximum_items || "-item ceiling", error)
    if marker = 0 then leave
    start = marker + 1
  end
  return 0

_uint: procedure = .int
  arg text = .string, minimum = .int, maximum = .int, name = .string, expose value = .int, expose error = .string
  value = 0
  if error \= "" then return -1
  if text = "" | length(text) > 10 then return _fail(name || " must be a bounded unsigned integer", error)
  if length(text) > 1 & left(text, 1) = "0" then return _fail(name || " must use canonical integer syntax", error)
  do i = 1 to length(text)
    if pos(substr(text, i, 1), "0123456789") = 0 then return _fail(name || " must be an unsigned integer", error)
  end
  value = text as .int
  if value < minimum | value > maximum then return _fail(name || " is outside its supported range", error)
  return 0

_boolean: procedure = .int
  arg text = .string, name = .string, expose value = .int, expose error = .string
  value = 0
  if text = "true" then do; value = 1; return 0; end
  if text = "false" then return 0
  return _fail(name || " must be true or false", error)

_secret: procedure = .int
  arg text = .string, name = .string, expose secret = .ragsecretref, expose error = .string
  secret = .ragsecretref()
  if text = "none" then return 0
  if left(text, 4) \= "env:" then return _fail(name || " must be none or an env:NAME reference; literal secrets are forbidden", error)
  env_name = substr(text, 5)
  if validenvname(env_name) \= 1 then return _fail(name || " has an invalid environment-variable name", error)
  secret = .ragsecretref("env", env_name)
  return 0

_safesourcepath: procedure = .int
  arg path = .string
  if path = "" | length(path) > 4096 | _hascontrol(path) = 1 then return 0
  normalized = changestr("\", path, "/")
  if normalized = ".." | left(normalized, 3) = "../" | right(normalized, 3) = "/.." | pos("/../", normalized) > 0 then return 0
  return 1

_safepattern: procedure = .int
  arg pattern = .string
  if pattern = "" | length(pattern) > 256 | left(pattern, 1) = "/" | left(pattern, 1) = "\" then return 0
  return _safesourcepath(pattern)

_hascontrol: procedure = .int
  arg value = .string
  do i = 1 to length(value)
    code = c2d(substr(value, i, 1))
    if code < 32 | code = 127 then return 1
  end
  return 0

_contains: procedure = .int
  arg values = .string[], expected = .string
  do i = 1 to values.0
    if values[i] = expected then return 1
  end
  return 0

_fail: procedure = .int
  arg message = .string, expose error = .string
  if error = "" then error = message
  return -1

_roleinputdefault: procedure = .int
  arg role = .string
  if role = "answerer" | role = "advisory" then return 65536
  return 8192

_roleoutputdefault: procedure = .int
  arg role = .string
  if role = "embedding" then return 0
  if role = "extractor" | role = "advisory" then return 4096
  return 1024

_rolecostdefault: procedure = .int
  arg role = .string
  if role = "embedding" then return 1000
  return 100000
