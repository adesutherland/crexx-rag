    _status = status; _reservation_id = reservation_id; _job_id = job_id
    _item_id = item_id; _attempt_id = attempt_id; _worker_id = worker_id
    _fence = fence; _maximum_input_tokens = maximum_input_tokens
    _maximum_output_tokens = maximum_output_tokens; _maximum_cost = maximum_cost
    _maximum_time_ms = maximum_time_ms
    _codex_turn = codex_turn
    if reserved_input_tokens < 0 then reserved_input_tokens = maximum_input_tokens
    if reserved_output_tokens < 0 then reserved_output_tokens = maximum_output_tokens
    if reserved_cost < 0 then reserved_cost = maximum_cost
    if reserved_time_ms < 0 then reserved_time_ms = maximum_time_ms
    _reserved_input_tokens = reserved_input_tokens
    _reserved_output_tokens = reserved_output_tokens
    _reserved_cost = reserved_cost
    _reserved_time_ms = reserved_time_ms
    return
  status: method = .int
    return _status
  reservation_id: method = .string
    return _reservation_id
  job_id: method = .string
    return _job_id
  item_id: method = .string
    return _item_id
  attempt_id: method = .string
    return _attempt_id
  worker_id: method = .string
    return _worker_id
  fence: method = .int
    return _fence
  maximum_input_tokens: method = .int
    return _maximum_input_tokens
  maximum_output_tokens: method = .int
    return _maximum_output_tokens
  maximum_cost: method = .int
    return _maximum_cost
  maximum_time_ms: method = .int
    return _maximum_time_ms
  codex_turn: method = .int
    return _codex_turn
  reserved_input_tokens: method = .int
    return _reserved_input_tokens
  reserved_output_tokens: method = .int
    return _reserved_output_tokens
  reserved_cost: method = .int
    return _reserved_cost
  reserved_time_ms: method = .int
    return _reserved_time_ms

