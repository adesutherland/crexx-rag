options levelg

namespace ragwork expose ragworkclaim ragcallreservation ragworkembedding ragworkproviderresult ragexternalrecovery ragworkprovider claimnext heartbeat configurejobbudget reservecall beginexternalrun updateexternalrunusage updateexternalrunturn updateexternalrunallowance completeexternalrun recoverexternalrun settlecall failattempt skipitem requestcancel acknowledgecancel pausejob resumejob drainjob retrydeadletter readjobstatus runworkeronce runworkerfollow

import rxfnsb
import rxjson
import rxhash
import rxplatform
import sqlite_boundary
import ragstore
import ragjob
import ragclaims

/* Durable improvement work uses database-clock leases and per-item monotonic
 * fencing. Provider work happens after claim commit and before a short fenced
 * promotion transaction. */
ragworkclaim: class
  _status = .int
  _job_id = .string
  _item_id = .string
  _item_type = .string
  _input_hash = .string
  _worker_id = .string
  _fence = .int
  _attempt_id = .string
  _lease_until = .int
  _config_snapshot_id = .string

  *: factory
    arg status = .int, job_id = .string, item_id = .string, item_type = .string, input_hash = .string, worker_id = .string, fence = .int, attempt_id = .string, lease_until = .int, config_snapshot_id = .string
    _status = status; _job_id = job_id; _item_id = item_id; _item_type = item_type
    _input_hash = input_hash; _worker_id = worker_id; _fence = fence
    _attempt_id = attempt_id; _lease_until = lease_until
    _config_snapshot_id = config_snapshot_id
    return
  status: method = .int
    return _status
  claimed: method = .int
    return _status = 0 & _item_id \= ""
  job_id: method = .string
    return _job_id
  item_id: method = .string
    return _item_id
  item_type: method = .string
    return _item_type
  input_hash: method = .string
    return _input_hash
  worker_id: method = .string
    return _worker_id
  fence: method = .int
    return _fence
  attempt_id: method = .string
    return _attempt_id
  lease_until: method = .int
    return _lease_until
  config_snapshot_id: method = .string
    return _config_snapshot_id

