    if reserved_output_tokens < 0 then reserved_output_tokens = maximum_output_tokens
    if reserved_cost < 0 then reserved_cost = maximum_cost
    if reserved_time_ms < 0 then reserved_time_ms = maximum_time_ms
    _reserved_input_tokens = reserved_input_tokens
    _reserved_output_tokens = reserved_output_tokens
    _reserved_cost = reserved_cost
    _reserved_time_ms = reserved_time_ms
    return
