  _status = .int
  _disposition = .string
  _job_id = .string
  _items = .int
  _library_writes = .int
  _provider_calls = .int
  _error = .string

  *: factory
    arg status = .int, disposition = .string, job_id = .string, items = .int, library_writes = .int, provider_calls = .int, error = .string
    _status = status; _disposition = disposition; _job_id = job_id; _items = items
    _library_writes = library_writes; _provider_calls = provider_calls; _error = error
    return
  status: method = .int
    return _status
  ok: method = .int
    return _status = 0
  disposition: method = .string
    return _disposition
  job_id: method = .string
    return _job_id
  items: method = .int
    return _items
  library_writes: method = .int
    return _library_writes
  provider_calls: method = .int
    return _provider_calls
  error: method = .string
    return _error

