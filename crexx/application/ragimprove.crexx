  _expected_generation = .int
  _config_snapshot_id = .string
  _policy_version = .string
  _prompt_version = .string
  _triggers = .string[]
  _maximum_items = .int
  _model_call_budget = .int
  _input_token_budget = .int
  _output_token_budget = .int
  _cost_budget = .int
  _time_budget_ms = .int
  _maximum_call_input_tokens = .int
  _maximum_call_output_tokens = .int
  _maximum_call_cost = .int
  _maximum_call_time_ms = .int
  _maximum_inflight_calls = .int
  _maximum_attempts = .int
  _privacy_class = .string
  _route_id = .string
  _secret_reference = .string
  _chunk_ids = .string[]
  _content_ids = .string[]
  _input_hashes = .string[]
  _scores = .int[]
  _canonical = .string
  _digest = .string

  *: factory
    arg schema = .string, expected_generation = .int, config_snapshot_id = .string, policy_version = .string, prompt_version = .string, triggers = .string[], maximum_items = .int, model_call_budget = .int, input_token_budget = .int, output_token_budget = .int, cost_budget = .int, time_budget_ms = .int, maximum_call_input_tokens = .int, maximum_call_output_tokens = .int, maximum_call_cost = .int, maximum_call_time_ms = .int, maximum_inflight_calls = .int, maximum_attempts = .int, privacy_class = .string, route_id = .string, secret_reference = .string, chunk_ids = .string[], content_ids = .string[], input_hashes = .string[], scores = .int[], canonical = .string, digest = .string
    _schema = schema; _expected_generation = expected_generation
    _config_snapshot_id = config_snapshot_id; _policy_version = policy_version; _prompt_version = prompt_version
    _triggers = triggers; _maximum_items = maximum_items
    _model_call_budget = model_call_budget; _input_token_budget = input_token_budget
    _output_token_budget = output_token_budget; _cost_budget = cost_budget; _time_budget_ms = time_budget_ms
    _maximum_call_input_tokens = maximum_call_input_tokens; _maximum_call_output_tokens = maximum_call_output_tokens
    _maximum_call_cost = maximum_call_cost; _maximum_call_time_ms = maximum_call_time_ms
    _maximum_inflight_calls = maximum_inflight_calls; _maximum_attempts = maximum_attempts
    _privacy_class = privacy_class; _route_id = route_id; _secret_reference = secret_reference
    _chunk_ids = chunk_ids; _content_ids = content_ids; _input_hashes = input_hashes; _scores = scores
    _canonical = canonical; _digest = digest
    return
  schema: method = .string
    return _schema
  expected_generation: method = .int
    return _expected_generation
  config_snapshot_id: method = .string
    return _config_snapshot_id
  policy_version: method = .string
    return _policy_version
  prompt_version: method = .string
    return _prompt_version
  triggers: method = .string[]
    return _triggers
  maximum_items: method = .int
    return _maximum_items
  model_call_budget: method = .int
    return _model_call_budget
  input_token_budget: method = .int
    return _input_token_budget
  output_token_budget: method = .int
    return _output_token_budget
  cost_budget: method = .int
    return _cost_budget
  time_budget_ms: method = .int
    return _time_budget_ms
  maximum_call_input_tokens: method = .int
    return _maximum_call_input_tokens
  maximum_call_output_tokens: method = .int
    return _maximum_call_output_tokens
  maximum_call_cost: method = .int
    return _maximum_call_cost
  maximum_call_time_ms: method = .int
    return _maximum_call_time_ms
  maximum_inflight_calls: method = .int
    return _maximum_inflight_calls
  maximum_attempts: method = .int
    return _maximum_attempts
  privacy_class: method = .string
    return _privacy_class
