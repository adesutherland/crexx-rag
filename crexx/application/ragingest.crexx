options levelg

namespace ragingest expose ragsourceobservation ragnormalizedsource ragchunk ragingestplan ragingestresult ragtermstatistics normalizebytes chunktext createingestplan applyingestplan applyingestplanconfigured termstatistics

import rxfnsb
import rxjson
import rxhash
import sqlite_boundary
import ragstore
import ragconfig
import ragprofile

/* Phase-3 ingestion is deliberately expressed in Level G. Native facilities
 * provide only generic SHA-256 and SQLite boundaries. Observations and plans
 * expose no setters: the caller may transfer them, but apply always recomputes
 * their canonical identities before any write transaction begins. */
ragsourceobservation: class
  _connector_type = .string
  _stable_key = .string
  _previous_stable_key = .string
  _observed_uri = .string
  _observed_title = .string
  _mime_type = .string
  _encoding = .string
  _format = .string
  _raw = .binary
  _retain_raw = .int
  _external_reference = .string
  _expected_raw_digest = .string
  _metadata = .string
  _captured_at = .string

  *: factory
    arg connector_type = .string, stable_key = .string, previous_stable_key = .string, observed_uri = .string, observed_title = .string, mime_type = .string, encoding = .string, format = .string, raw = .binary, retain_raw = .int, external_reference = .string, expected_raw_digest = .string, metadata = .string, captured_at = .string
    _connector_type = connector_type
    _stable_key = stable_key
    _previous_stable_key = previous_stable_key
    _observed_uri = observed_uri
    _observed_title = observed_title
    _mime_type = mime_type
    _encoding = encoding
    _format = format
    _raw = raw
    _retain_raw = retain_raw
    _external_reference = external_reference
    _expected_raw_digest = expected_raw_digest
    _metadata = metadata
    _captured_at = captured_at
    return

  connector_type: method = .string
    return _connector_type
  stable_key: method = .string
    return _stable_key
  previous_stable_key: method = .string
    return _previous_stable_key
  observed_uri: method = .string
    return _observed_uri
  observed_title: method = .string
    return _observed_title
  mime_type: method = .string
    return _mime_type
  encoding: method = .string
    return _encoding
  format: method = .string
    return _format
  raw: method = .binary
    return _raw
  retain_raw: method = .int
    return _retain_raw
  external_reference: method = .string
    return _external_reference
  expected_raw_digest: method = .string
    return _expected_raw_digest
  metadata: method = .string
    return _metadata
