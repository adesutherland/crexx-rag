providerroutepolicy: class
  _route_class = .string
  _allow_local = .int
  _allow_restricted = .int
  _allow_public = .int

  *: factory
    arg route_class = .string, allow_local = .int, allow_restricted = .int, allow_public = .int
    _route_class = route_class
    _allow_local = allow_local
    _allow_restricted = allow_restricted
    _allow_public = allow_public
    return

  route_class: method = .string
    return _route_class
  permits: method = .int
    arg privacy_class = .string
    if privacy_class = "local" then return _allow_local
    if privacy_class = "restricted" then return _allow_restricted
    if privacy_class = "public" then return _allow_public
    return 0

