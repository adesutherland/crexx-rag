  *: factory
    arg provider = .string, chat = .int, structured = .int, embeddings = .int, batch_embeddings = .int, streaming = .int, cancellation = .int, context_tokens = .int, batch_size = .int, input_modalities = "text", output_modalities = "text", request_format = "provider-specific", connection_reuse = 0
