    return _message

embeddingrecord: class
  _codec = .string
  _count = .int
  _payload = .binary

  *: factory
    arg codec = .string, count = .int, payload = .binary
    _codec = codec
    _count = count
    _payload = payload
    return

  codec: method = .string
    return _codec
  count: method = .int
    return _count
  payload: method = .binary
    return _payload
  valid: method = .int
    if _codec \= "f32le-v1" | _count < 0 then return 0
    return binlength(_payload) = _count * 4

providerresult: class
  _status = .int
  _provider = .string
  _model = .string
  _request_id = .string
  _content = .string
  _diagnostic_content = .string
  _finish_reason = .string
  _embeddings = .embeddingrecord[]
  _usage = .providerusage
  _latency_us = .int
