    _provider = ""
    _model = ""
    _request_id = ""
    _content = ""
    _diagnostic_content = ""
    _finish_reason = ""
    _embeddings = vectors
    _usage = .providerusage()
    _latency_us = 0
    _error = .providererror()
    return

  set_generation: method = .void
    arg provider = .string, model = .string, request_id = .string, content = .string, finish_reason = .string, usage = .providerusage, latency_us = .int
    vectors = .embeddingrecord[]
    _status = 0
    _provider = provider
    _model = model
    _request_id = request_id
    _content = content
    _diagnostic_content = ""
    _finish_reason = finish_reason
    _embeddings = vectors
    _usage = usage
    _latency_us = latency_us
    _error = .providererror()
    return

  set_embeddings: method = .void
    arg provider = .string, model = .string, request_id = .string, vectors = .embeddingrecord[], usage = .providerusage, latency_us = .int
    _status = 0
    _provider = provider
    _model = model
    _request_id = request_id
    _content = ""
    _diagnostic_content = ""
    _finish_reason = "complete"
    _embeddings = vectors
    _usage = usage
    _latency_us = latency_us
    _error = .providererror()
    return

  set_failure: method = .void
    arg provider = .string, model = .string, request_id = .string, error = .providererror, usage = .providerusage(), latency_us = 0
    vectors = .embeddingrecord[]
    _status = error.code()
    _provider = provider
    _model = model
    _request_id = request_id
    _content = ""
    _diagnostic_content = ""
    _finish_reason = "error"
    _embeddings = vectors
    _usage = usage
    _latency_us = latency_us
    _error = error
    return

  set_diagnostic_content: method = .void
    arg content=.string
    _diagnostic_content=content
    return

