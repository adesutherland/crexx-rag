    _chat = chat
    _structured = structured
    _embeddings = embeddings
    _batch_embeddings = batch_embeddings
    _streaming = streaming
    _cancellation = cancellation
    _context_tokens = context_tokens
    _batch_size = batch_size
    _input_modalities = input_modalities
    _output_modalities = output_modalities
    _request_format = request_format
    _connection_reuse = connection_reuse
