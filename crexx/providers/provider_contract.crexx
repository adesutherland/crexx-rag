    return _embeddings
  usage: method = .providerusage
    return _usage
  latency_us: method = .int
    return _latency_us
  error: method = .providererror
    return _error

provider: interface
  capabilities: method = .providercapabilities
  generate: method = .providerresult
    arg request = .providerrequest
  generate_structured: method = .providerresult
    arg request = .providerrequest
  embed: method = .providerresult
    arg request = .providerrequest
  embed_batch: method = .providerresult
    arg request = .providerrequest
  cancel: method = .providerresult
    arg request_id = .string

validateproviderrequest: procedure = .providererror
  arg request = .providerrequest
  operation = request.operation()
  if operation \= "generate" & operation \= "generate_structured" & operation \= "embed" & operation \= "embed_batch" then return .providererror("invalid_request", -101, 0, 0, 0, "unsupported operation")
  if request.model() = "" then return .providererror("invalid_request", -101, 0, 0, 0, "model is required")
  if request.timeout_ms() <= 0 then return .providererror("invalid_request", -101, 0, 0, 0, "timeout must be positive")
  if request.max_attempts() < 1 | request.max_attempts() > 10 then return .providererror("invalid_request", -101, 0, 0, 0, "max attempts must be from 1 through 10")
  if request.max_output_tokens() < 0 then return .providererror("invalid_request", -101, 0, 0, 0, "maximum output tokens cannot be negative")
  if request.embedding_dimensions() < 0 then return .providererror("invalid_request", -101, 0, 0, 0, "embedding dimensions cannot be negative")
  if request.temperature_millionths() < -1 | request.temperature_millionths() > 2000000 then return .providererror("invalid_request", -101, 0, 0, 0, "temperature millionths must be unspecified or from zero through two million")
  if request.initial_backoff_ms() < 1 | request.maximum_backoff_ms() < request.initial_backoff_ms() | request.maximum_backoff_ms() > 3600000 | request.jitter_ms() < 0 | request.jitter_ms() > request.maximum_backoff_ms() then return .providererror("invalid_request", -101, 0, 0, 0, "retry backoff policy is invalid")
  if request.temperature_millionths() >= 0 & operation \= "generate" & operation \= "generate_structured" then return .providererror("invalid_request", -101, 0, 0, 0, "temperature is only valid for generation")
  if request.reasoning_effort() \= "" then do
    if words(request.reasoning_effort()) \= 1 | wordpos(request.reasoning_effort(), "none minimal low medium high xhigh max") = 0 | (operation \= "generate" & operation \= "generate_structured") then return .providererror("invalid_request", -101, 0, 0, 0, "reasoning effort is invalid for this generation request")
  end
  if request.stream_requested() \= 0 & operation \= "generate" & operation \= "generate_structured" then return .providererror("invalid_request", -101, 0, 0, 0, "streaming is only valid for generation")
  privacy = request.privacy_class()
  if privacy \= "local" & privacy \= "internal" & privacy \= "restricted" & privacy \= "public" then return .providererror("invalid_request", -101, 0, 0, 0, "privacy class is invalid")
  if request.idempotency_key() = "" | request.request_id() = "" then return .providererror("invalid_request", -101, 0, 0, 0, "request identity is required")
  if operation = "generate" | operation = "generate_structured" then do
    messages = request.messages()
    if messages.0 < 1 then return .providererror("invalid_request", -101, 0, 0, 0, "generation messages are required")
    do i = 1 to messages.0
      modality = messages[i].modality()
      if modality \= "text" & modality \= "image_url" & modality \= "document_url" & modality \= "audio_url" then return .providererror("invalid_request", -101, 0, 0, 0, "message modality is invalid")
      if modality = "text" & messages[i].content() = "" then return .providererror("invalid_request", -101, 0, 0, 0, "text message content is required")
      if modality \= "text" & messages[i].source() = "" then return .providererror("invalid_request", -101, 0, 0, 0, "media message source is required")
    end
  end
  if operation = "embed" | operation = "embed_batch" then do
    inputs = request.inputs()
    if inputs.0 < 1 then return .providererror("invalid_request", -101, 0, 0, 0, "embedding inputs are required")
  end
  if operation = "generate_structured" & request.schema() = "" then return .providererror("invalid_request", -101, 0, 0, 0, "structured schema is required")
  return .providererror()

validateprovideroperation: procedure = .providererror
  arg request = .providerrequest, expected = .string
  validation = validateproviderrequest(request)
  if validation.code() \= 0 then return validation
  if request.operation() \= expected then return .providererror("invalid_request", -101, 0, 0, 0, "request operation does not match provider method")
  return .providererror()

validateproviderroute: procedure = .providererror
  arg request = .providerrequest, route_class = .string
  if route_class \= "local" & route_class \= "hosted" then return .providererror("configuration", -122, 0, 0, 0, "provider route class is invalid")
  /* Route classification describes transport; source labels do not override
   * the application's configured provider selection. */
  return .providererror()

validatestructuredresponse: procedure = .providererror
  arg content = .string, schema = .string
  response_document = .jsondocument(content)
  if response_document.valid() = 0 then return .providererror("structured_validation", -123, 0, 0, 0, "structured response is not valid JSON")
  schema_document = .jsondocument(schema)
  if schema_document.valid() = 0 then return .providererror("invalid_request", -101, 0, 0, 0, "structured schema is not valid JSON")
  response_root = response_document.root()
  schema_root = schema_document.root()
  schema_type_node = schema_document.member(schema_root, "type")
  schema_type = ""
  if schema_document.node_type(schema_type_node) = "string" then ignored = schema_document.node_string(schema_type_node, schema_type)
  if schema_type \= "" & response_document.node_type(response_root) \= schema_type then return .providererror("structured_validation", -123, 0, 0, 0, "structured response root type does not match schema")
  required_node = schema_document.member(schema_root, "required")
  do i = 1 to schema_document.node_count(required_node)
    required_name_node = schema_document.element(required_node, i)
    required_name = ""
    if schema_document.node_string(required_name_node, required_name) \= 0 then return .providererror("invalid_request", -101, 0, 0, 0, "structured schema required entries must be strings")
    response_member = response_document.member(response_root, required_name)
    if response_member <= 0 then return .providererror("structured_validation", -123, 0, 0, 0, "structured response is missing required member: " || required_name)
    properties_node = schema_document.member(schema_root, "properties")
    property_node = schema_document.member(properties_node, required_name)
    property_type_node = schema_document.member(property_node, "type")
    property_type = ""
    if schema_document.node_type(property_type_node) = "string" then ignored = schema_document.node_string(property_type_node, property_type)
    type_matches = response_document.node_type(response_member) = property_type
    if property_type = "integer" then do
      integer_value = .int
      type_matches = response_document.node_int(response_member, integer_value) = 0
    end
    if property_type \= "" & type_matches = 0 then return .providererror("structured_validation", -123, 0, 0, 0, "structured response member type does not match schema: " || required_name)
  end
  return .providererror()
