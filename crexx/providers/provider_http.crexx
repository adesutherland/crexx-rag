options levelg

namespace provider_http expose providerhttpresponse providerhttptransport providerretrydelay

import rxfnsb
import rxjson
import rxfnsg
import rxsocket
import _rxhttpcore
import provider_contract

providerhttpresponse: class
  _status = .int
  _http_status = .int
  _body = .string
  _category = .string
  _message = .string
  _retryable = .int
  _attempts = .int
  _retry_delay_ms = .int
  _latency_us = .int
  _provider_request_id = .string

  *: factory
    _status = 0
    _http_status = 0
    _body = ""
    _category = "none"
    _message = ""
    _retryable = 0
    _attempts = 0
    _retry_delay_ms = 0
    _latency_us = 0
    _provider_request_id = ""
    return

  set_success: method = .void
    arg body = .string, http_status = .int, attempts = .int, retry_delay_ms = .int, latency_us = .int, provider_request_id = .string
    _status = 0
    _http_status = http_status
    _body = body
    _category = "none"
    _message = ""
    _retryable = 0
    _attempts = attempts
    _retry_delay_ms = retry_delay_ms
    _latency_us = latency_us
    _provider_request_id = provider_request_id
    return

  set_failure: method = .void
    arg status = .int, http_status = .int, category = .string, message = .string, retryable = .int, attempts = .int, retry_delay_ms = .int, latency_us = .int
    _status = status
    _http_status = http_status
    _body = ""
    _category = category
    _message = message
    _retryable = retryable
    _attempts = attempts
    _retry_delay_ms = retry_delay_ms
    _latency_us = latency_us
    _provider_request_id = ""
    return

  status: method = .int
    return _status
  http_status: method = .int
    return _http_status
  body: method = .string
    return _body
  category: method = .string
    return _category
  message: method = .string
    return _message
  retryable: method = .int
    return _retryable
  attempts: method = .int
    return _attempts
  retry_delay_ms: method = .int
    return _retry_delay_ms
  latency_us: method = .int
    return _latency_us
  provider_request_id: method = .string
    return _provider_request_id

providerdirectresponse: class
  _transport_status = .int
  _http_status = .int
  _headers = .string
  _body = .string
  _error = .string

  new: factory
    arg transport_status = .int, http_status = .int, headers = .string, body = .string, error = .string
    _transport_status = transport_status
    _http_status = http_status
    _headers = headers
    _body = body
    _error = error
    return

  transport_status: method = .int
    return _transport_status
  http_status: method = .int
    return _http_status
  headers: method = .string
    return _headers
  body: method = .string
    return _body
  error: method = .string
    return _error

providerhttptransport: class
  _host = .string
  _port = .int
  _tls = .int
  _protocol = .string
  _api_key = .string
  _route_class = .string

  *: factory
    arg host = .string, port = .int, tls = .int, protocol = .string, api_key = .string, route_class = .string
    _host = host
    _port = port
    _tls = tls
    _protocol = protocol
    _api_key = api_key
    _route_class = route_class
    return

  post: method = .providerhttpresponse
    arg request = .providerrequest, path = .string, body = .string
    route_error = validateproviderroute(request, _route_class)
    if route_error.code() \= 0 then return _policy_failure(route_error)
    if _route_class = "hosted" & _api_key = "" then return _configuration_failure("provider credential is unavailable")
    policy = .httppolicy.safe()
    timeout_ms = request.timeout_ms()
    if timeout_ms > 600000 then timeout_ms = 600000
    call policy.set_timeouts(timeout_ms, timeout_ms, timeout_ms, timeout_ms, timeout_ms, timeout_ms)
    return _post_direct(request, path, body, policy)

  _post_direct: method = .providerhttpresponse
    arg request = .providerrequest, path = .string, body = .string, policy = .httppolicy
    started = time("us")
    retry_delay_ms = 0
    do attempt = 1 to request.max_attempts()
      headers = .httpheaders.json()
      call headers.add("Idempotency-Key", request.idempotency_key())
      call headers.add("X-Client-Request-Id", request.request_id())
      if _protocol = "openai" then call headers.add("Authorization", "Bearer " || _api_key)
      else if _protocol = "anthropic" then do
        call headers.add("x-api-key", _api_key)
        call headers.add("anthropic-version", "2023-06-01")
      end
      else if _protocol = "gemini" then call headers.add("x-goog-api-key", _api_key)
      response = _exchange(path, body, headers, policy)
      response_body = response.body()
      transport_status = response.transport_status()
      http_status = response.http_status()
      if transport_status = 0 & http_status >= 200 & http_status < 300 then do
        provider_request_id = http_header_value(response.headers(), "x-request-id")
        if provider_request_id = "" then provider_request_id = http_header_value(response.headers(), "request-id")
        result = .providerhttpresponse()
        call result.set_success(response_body, http_status, attempt, retry_delay_ms, _elapsed_us(started), provider_request_id)
        return result
      end
      status = transport_status
      if status = 0 then status = http_status
      retryable = _retryable(transport_status, http_status)
      if retryable \= 0 & attempt < request.max_attempts() then do
        delay_ms = _retry_delay_ms(request, attempt, response.headers())
        call _wait_ms delay_ms
        retry_delay_ms = retry_delay_ms + delay_ms
        iterate
      end
      message = _response_error_message(response_body)
      if message = "" then message = response.error()
      category = "http"
      if transport_status = -6 | transport_status = -10 | transport_status = -11 | transport_status = -12 then do; category = "timeout"; status = -5; end
      else if transport_status = -1 | transport_status = -2 | transport_status = -3 | transport_status = -7 | transport_status = -8 then do; category = "connection"; status = -3; end
      result = .providerhttpresponse()
      if retryable \= 0 then retry_delay_ms = retry_delay_ms + _retry_delay_ms(request, attempt, response.headers())
      call result.set_failure(status, http_status, category, message, retryable, attempt, retry_delay_ms, _elapsed_us(started))
      return result
    end
    return _configuration_failure("retry loop exhausted")

  _exchange: method = .providerdirectresponse
    arg path = .string, body = .string, headers = .httpheaders, policy = .httppolicy
    socket = socketcreate()
    if socket <= 0 then return .providerdirectresponse.new(-1, 0, "", "", "HTTP socketcreate failed")
    connection_budget = policy.dns_timeout() + policy.connect_timeout()
    if _tls \= 0 then connection_budget = connection_budget + policy.tls_timeout()
    if sockettimeout(socket, connection_budget) \= 0 then do
      message = "HTTP connection timeout setup failed: " || socketerror(socket)
      ignored = socketclose(socket)
      return .providerdirectresponse.new(-2, 0, "", "", message)
    end
    if _tls \= 0 then connect_status = socketconnecttls(socket, _host, _port)
    else connect_status = socketconnect(socket, _host, _port)
    if connect_status \= 0 then do
      message = "HTTP DNS/connect/TLS failed or exceeded its combined budget: " || socketerror(socket)
      ignored = socketclose(socket)
      return .providerdirectresponse.new(-3, 0, "", "", message)
    end
    if sockettimeout(socket, policy.request_timeout()) \= 0 then do
      message = "HTTP request timeout setup failed: " || socketerror(socket)
      ignored = socketclose(socket)
      return .providerdirectresponse.new(-2, 0, "", "", message)
    end
    request_wire = http_build_request("POST", _host, _port, path, body as .binary, headers.content_type(), headers.wire(), "close", "identity")
    offset = 0
    total = binlength(request_wire)
    do while offset < total
      piece = binsubstr(request_wire, offset + 1, total - offset)
      sent = socketsendb(socket, piece)
      if sent <= 0 | sent > total - offset then do
        message = "HTTP socket send failed or timed out: " || socketerror(socket)
        ignored = socketclose(socket)
        return .providerdirectresponse.new(-4, 0, "", "", message)
      end
      offset = offset + sent
    end
    if sockettimeout(socket, policy.response_timeout()) \= 0 then do
      message = "HTTP response timeout setup failed: " || socketerror(socket)
      ignored = socketclose(socket)
      return .providerdirectresponse.new(-2, 0, "", "", message)
    end
    response_wire = ''x as .binary
    ended = 0
    do forever
      chunk = socketrecvb(socket, 8192)
      socket_state = socketstatus(socket)
      if binlength(chunk) > 0 then call binappend response_wire, chunk
      if binlength(response_wire) > 8650752 then do
        ignored = socketclose(socket)
        return .providerdirectresponse.new(-22, 0, "", "", "HTTP response exceeds the configured safety ceiling")
      end
      if http_response_complete(response_wire) then leave
      if socket_state = 1 then do
        ended = 1
        leave
      end
      if socket_state = 2 then do
        ignored = socketclose(socket)
        return .providerdirectresponse.new(-6, 0, "", "", "HTTP response timed out")
      end
      if socket_state = 3 then do
        ignored = socketclose(socket)
        return .providerdirectresponse.new(-7, 0, "", "", "HTTP response would block")
      end
      if socket_state < 0 | binlength(chunk) = 0 then do
        message = "HTTP socket receive failed: " || socketerror(socket)
        ignored = socketclose(socket)
        return .providerdirectresponse.new(-8, 0, "", "", message)
      end
    end
    ignored = socketclose(socket)
    parsed = http_parse_response(response_wire)
    if parsed.error_code() < 0 then return .providerdirectresponse.new(parsed.error_code(), parsed.status(), parsed.headers(), parsed.body() as .string, parsed.error())
    encoding = translate(strip(http_header_value(parsed.headers(), "Content-Encoding")))
    if encoding \= "" & encoding \= "IDENTITY" then return .providerdirectresponse.new(-24, parsed.status(), parsed.headers(), "", "HTTP direct response requires identity Content-Encoding")
    return .providerdirectresponse.new(0, parsed.status(), parsed.headers(), parsed.body() as .string, parsed.error())

  _policy_failure: method = .providerhttpresponse
    arg failure = .providererror
    result = .providerhttpresponse()
    call result.set_failure(failure.code(), 0, failure.category(), failure.message(), 0, 0, 0, 0)
    return result

  _configuration_failure: method = .providerhttpresponse
    arg message = .string
    result = .providerhttpresponse()
    call result.set_failure(-122, 0, "configuration", message, 0, 0, 0, 0)
    return result

_retryable: procedure = .int
  arg status = .int, http_status = .int
  if status = -1 | status = -2 | status = -3 | status = -6 | status = -7 | status = -8 | status = -10 | status = -11 | status = -12 then return 1
  if http_status = 408 | http_status = 429 | http_status >= 500 then return 1
  return 0

_response_error_message: procedure = .string
  arg body = .string
  document = .jsondocument(body)
  if document.valid() = 0 then return ""
  error_node = document.member(document.root(), "error")
  message_node = document.member(error_node, "message")
  message = ""
  if document.node_type(message_node) = "string" then ignored = document.node_string(message_node, message)
  return message

_elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

_retry_delay_ms: procedure = .int
  arg request = .providerrequest, failed_attempt = .int, headers = .string
  return providerretrydelay(request,failed_attempt,headers)

providerretrydelay: procedure = .int
  arg request = .providerrequest, failed_attempt = .int, headers = .string, now_epoch = -1
  delay_ms = request.initial_backoff_ms()
  do i = 2 to failed_attempt
    delay_ms = min(request.maximum_backoff_ms(),delay_ms * 2)
  end
  identity = request.request_id(); seed = 0
  do i = 1 to length(identity)
    seed = (seed * 31 + c2d(substr(identity,i,1))) % 1000000007
  end
  jitter = request.jitter_ms()
  if jitter > 0 then delay_ms = delay_ms + ((seed + failed_attempt * 53) % (jitter + 1))
  if delay_ms > request.maximum_backoff_ms() then delay_ms = request.maximum_backoff_ms()
  retry_after = strip(http_header_value(headers, "Retry-After")); server_delay = 0
  if _digits(retry_after) = 1 & length(retry_after) <= 12 then server_delay = (retry_after as .int) * 1000
  else if length(retry_after) = 29 & substr(retry_after,4,2) = ", " & right(retry_after,4) = " GMT" then do
    clock = substr(retry_after,18,8)
    if substr(clock,3,1) = ":" & substr(clock,6,1) = ":" & _digits(left(clock,2) || substr(clock,4,2) || right(clock,2)) = 1 then do
      hours = left(clock,2) as .int; minutes = substr(clock,4,2) as .int; seconds = right(clock,2) as .int
      if hours < 24 & minutes < 60 & seconds < 60 then do
        server_epoch = -1
        do
          server_epoch = (date("EP",substr(retry_after,6,11),"N") as .int) + hours*3600 + minutes*60 + seconds
        on signal invalid_arguments
          server_epoch = -1
        end
        if now_epoch < 0 then do
          /* Public clock functions give civil and UTC time. Select the UTC
           * day using the standard timezone offset, allowing daylight saving. */
          day = .int; local_seconds = .int; utc = .string
          do forever
            day = date("EP") as .int; local_seconds = time("S") as .int; utc = time("UTC")
            if day = (date("EP") as .int) then leave
          end
          utc_seconds = (left(utc,2) as .int)*3600 + (substr(utc,4,2) as .int)*60 + (right(utc,2) as .int)
          offset = local_seconds-utc_seconds; standard_offset = -(time("ZD") as .int)
          do while offset-standard_offset > 43200; offset = offset-86400; end
          do while offset-standard_offset < -43200; offset = offset+86400; end
          now_epoch = day+local_seconds-offset
        end
        if server_epoch > now_epoch then server_delay = (server_epoch-now_epoch)*1000
      end
    end
  end
  /* The local cap limits our exponential policy, never a server's not-before. */
  if server_delay > delay_ms then delay_ms = server_delay
  return delay_ms

_digits: procedure = .int
  arg value = .string
  if value = "" then return 0
  do i = 1 to length(value)
    if pos(substr(value, i, 1), "0123456789") = 0 then return 0
  end
  return 1

_wait_ms: procedure = .void
  arg milliseconds = .int
  if milliseconds <= 0 then return
  seconds = milliseconds / 1000.0
  address crexx "sleep " || seconds
  return
