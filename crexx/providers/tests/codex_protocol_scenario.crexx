options levelg

import rxfs
import provider_contract
import codex_provider

main: procedure = .int
  arg args = .string[]
  if args.0 < 2 | args.0 > 3 then do
    say "usage: codex_provider_live_probe CODEX_EXECUTABLE EMPTY_WORK_DIR [ACCOUNT_CYCLES]"
    return 2
  end
  if rxfs..isfile(args[1]) \= 1 | rxfs..isdir(args[2]) \= 1 then do
    say "FAIL: probe paths are unavailable"
    return 2
  end
  observer = .codexnoopobserver()
  provider = .codexprovider(args[1], args[2], observer)
  account_type = ""; plan_type = ""; used_percent = -1; error = ""
  cycles = 1
  if args.0 = 3 then cycles = args[3] as .int
  if cycles < 1 | cycles > 20000 then return 2
  do cycle = 1 to cycles
    if provider.account_status(120000, account_type, plan_type, used_percent, error) \= 0 | account_type = "" | used_percent < 0 | used_percent > 100 then do
      call provider.close()
      say "FAIL: managed account status at cycle " || cycle || ": " || error
      return 1
    end
  end
  messages = .providermessage[]; inputs = .string[]
  messages[1] = .providermessage("user", "Return an object whose ok field is true.")
  schema = '{"type":"object","additionalProperties":false,"required":["ok"],"properties":{"ok":{"type":"boolean"}}}'
  request = .providerrequest("generate_structured", "probe", "default", messages, inputs, schema, 120000, 1, "public", "codex-live-probe", "codex-live-probe", 32, 0, 0, 0, 1000, 60000, 250, "low")
  result = provider.generate_structured(request)
  call provider.close()
  if provider.health_error() \= "" then do
    say "FAIL: provider cleanup " || provider.health_error()
    return 1
  end
  if result.status() \= 0 then do
    failure = result.error()
    say "FAIL: " || failure.category() || " " || failure.message()
    return 1
  end
  say "PASS: Codex App Server returned managed account status and schema-validated structured output"
  return 0
