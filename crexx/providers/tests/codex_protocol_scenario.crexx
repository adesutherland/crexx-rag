options levelg

import rxfs
import rxfnsb
import provider_contract
import codex_provider

main: procedure = .int
  arg args = .string[]
  if args.0 < 2 | args.0 > 4 then do
    say "usage: codex_provider_live_probe CODEX_EXECUTABLE EMPTY_WORK_DIR [ACCOUNT_CYCLES]"
    return 2
  end
  if rxfs..isfile(args[1]) \= 1 | rxfs..isdir(args[2]) \= 1 then do
    say "FAIL: probe paths are unavailable"
    return 2
  end
  observer = .codexnoopobserver()
  provider = .codexprovider(args[1], args[2], observer)
  if args.0=4 then if args[4]="terminal-error" then do
    scenario=getenv("CREXXRAG_CODEX_FIXTURE_FAILURE")
    expected_code=-103;expected_http=0;expected_retry=0
    if scenario="invalid-schema" | scenario="invalid-schema-start" | scenario="unsafe-terminal" then do;expected_code=-101;expected_http=400;end
    if scenario="auth-terminal" then do;expected_code=-104;expected_http=401;end
    if scenario="rate-terminal" then do;expected_code=-429;expected_http=429;expected_retry=1;end
    if scenario="transient-terminal" then do;expected_code=-103;expected_http=503;expected_retry=1;end
    if scenario="interrupted-terminal" then expected_code=-105
    messages=.providermessage[];inputs=.string[]
    messages[1]=.providermessage("user","Return the synthetic ok field.")
    schema='{"type":"object","additionalProperties":false,"required":["ok"],"properties":{"ok":{"type":"boolean"}}}'
    request=.providerrequest("generate_structured","probe","default",messages,inputs,schema,5000,1,"public","terminal-fixture","terminal-fixture",32,0,0,0,1000,60000,250,"low")
    thread_id="";turn_id="";error=""
    if provider.start_thread(request,thread_id,error)<>0 then do;say "FAIL: start thread " || error;return 1;end
    started=provider.start_structured_turn(request,thread_id,turn_id,error)
    if scenario="invalid-schema-start" then do
      failure=provider.turn_error()
      if started=0 | failure.code()<>expected_code | failure.http_status()<>expected_http | failure.retryable()<>0 | pos("invalid_json_schema",failure.message())=0 then do;say "FAIL: start rejection " || error;return 1;end
    end
    else do
      if started<>0 then do;say "FAIL: turn start " || error;return 1;end
      result=provider.wait_structured(request,thread_id,turn_id)
      failure=result.error()
      if result.status()<>expected_code | failure.http_status()<>expected_http | failure.retryable()<>expected_retry then do;say "FAIL: terminal classification " || scenario || " " || failure.message();return 1;end
      if scenario="invalid-schema" & (pos("invalid_json_schema",failure.message())=0 | pos("text.format.schema",failure.message())=0) then do;say "FAIL: structured upstream detail lost";return 1;end
      if scenario="unsafe-terminal" & (pos("PRIVATE",failure.message())>0 | pos("private-token",failure.message())>0 | pos("invalid_json_schema",failure.message())=0) then do;say "FAIL: untrusted upstream message leaked source or lost safe code";return 1;end
      state="";content="";error=""
      if provider.inspect_turn_fresh(thread_id,turn_id,5000,state,content,error)<>0 then do;say "FAIL: exact turn read " || error;return 1;end
      observed=provider.turn_error()
      if observed.code()<>expected_code | observed.http_status()<>expected_http | observed.retryable()<>expected_retry then do;say "FAIL: read-back classification " || observed.message();return 1;end
      if scenario="unsafe-terminal" & pos("PRIVATE",observed.message())>0 then do;say "FAIL: read-back leaked source text";return 1;end
      recovered=provider.recover_structured(request,thread_id,turn_id,7,2)
      if recovered.status()<>expected_code | recovered.error().http_status()<>expected_http | recovered.error().retryable()<>expected_retry | recovered.usage().input_tokens()<>7 | recovered.usage().output_tokens()<>2 then do;say "FAIL: recovered receipt classification";return 1;end
    end
    call provider.close()
    say "PASS: terminal Codex classification " || scenario
    return 0
  end
  if args.0 = 4 then if args[4] = "utf8-fragments" | args[4] = "utf8-invalid" then do
    error="";account_type="";plan_type="";used_percent=-1
    status=provider.account_status(5000,account_type,plan_type,used_percent,error)
    call provider.close()
    if args[4]="utf8-fragments" then do
      if status<>0 | account_type<>"chatgpt" | plan_type<>"pro-é漢🦄" | used_percent<>12 then do
        say "FAIL: fragmented UTF-8 changed or aborted account data: " || error
        return 1
      end
    end
    else if status=0 | pos("invalid UTF-8",error)=0 then do
      say "FAIL: invalid UTF-8 did not become a bounded provider error: " || error
      return 1
    end
    say "PASS: UTF-8 framing " || args[4]
    return 0
  end
  if args.0 = 4 then if args[4] = "deadline-healthy" then do
    messages = .providermessage[]; inputs = .string[]
    messages[1] = .providermessage("user","Return an object whose ok field is true.")
    schema = '{"type":"object","required":["ok"],"properties":{"ok":{"type":"boolean"}}}'
    request = .providerrequest("generate_structured","probe","default",messages,inputs,schema,2000,1,"public","deadline","deadline",32,0,0,0,1000,60000,250,"low")
    /* The series must outlive one allowance, proving each operation resets
     * its clock rather than accidentally succeeding within the first budget. */
    series_started=time("us")
    do cycle=1 to 4
      call provider.begin_operation(2000)
      error="";account_type="";plan_type="";used_percent=-1;thread_id="";turn_id=""
      started=time("us")
      status=provider.account_status(10000,account_type,plan_type,used_percent,error)
      if status=0 then status=provider.start_thread(request,thread_id,error)
      if status=0 then status=provider.start_structured_turn(request,thread_id,turn_id,error)
      if status=0 then do;result=provider.wait_structured(request,thread_id,turn_id);status=result.status();if status<>0 then error=result.error().message();end
      elapsed=time("us")-started;if elapsed<0 then elapsed=elapsed+86400000000
      call provider.end_operation()
      if status<>0 | elapsed<400000 | elapsed>2000000 then do;say "FAIL: healthy delayed operation " || cycle || " expired early: " || elapsed || " " || error;return 1;end
    end
    series_elapsed=time("us")-series_started;if series_elapsed<0 then series_elapsed=series_elapsed+86400000000
    if series_elapsed<=2000000 then do;say "FAIL: healthy series did not exercise operation clock reset";return 1;end
    call provider.close()
    say "PASS: healthy delayed operations retain their full allowance"
    return 0
  end
  if args.0 = 4 then do
    messages = .providermessage[]; inputs = .string[]
    messages[1] = .providermessage("user","Return an object whose ok field is true.")
    schema = '{"type":"object","required":["ok"],"properties":{"ok":{"type":"boolean"}}}'
    request = .providerrequest("generate_structured","probe","default",messages,inputs,schema,200,1,"public","deadline","deadline",32,0,0,0,1000,60000,250,"low")
    error = ""; account_type = ""; plan_type = ""; used_percent = -1; status = 0
    started = time("us"); call provider.begin_operation(200)
    if args[4] \= "turn-noise" then status = provider.account_status(10000,account_type,plan_type,used_percent,error)
    else do
      thread_id = ""; turn_id = ""
      status = provider.start_thread(request,thread_id,error)
      if status = 0 then status = provider.start_structured_turn(request,thread_id,turn_id,error)
      if status = 0 then do; result = provider.wait_structured(request,thread_id,turn_id); status = result.status(); end
    end
    elapsed = time("us")-started; if elapsed < 0 then elapsed = elapsed+86400000000
    call provider.close()
    if status = 0 | elapsed < 150000 | elapsed > 2000000 then do; say "FAIL: notifications changed the operation deadline: " || elapsed; return 1; end
    say "PASS: noisy " || args[4] || " respected the shared deadline"
    return 0
  end
  account_type = ""; plan_type = ""; used_percent = -1; error = ""
  cycles = 1
  if args.0 = 3 then cycles = args[3] as .int
  if cycles < 1 | cycles > 20000 then return 2
  do cycle = 1 to cycles
    if provider.account_status(120000, account_type, plan_type, used_percent, error) \= 0 | account_type = "" | used_percent < 0 | used_percent > 100 then do
      call provider.close()
      say "FAIL: managed account status at cycle " || cycle || ": " || error
      return 1
    end
  end
  messages = .providermessage[]; inputs = .string[]
  messages[1] = .providermessage("user", "Return an object whose ok field is true.")
  schema = '{"type":"object","additionalProperties":false,"required":["ok"],"properties":{"ok":{"type":"boolean"}}}'
  request = .providerrequest("generate_structured", "probe", "default", messages, inputs, schema, 120000, 1, "public", "codex-live-probe", "codex-live-probe", 32, 0, 0, 0, 1000, 60000, 250, "low")
  result = provider.generate_structured(request)
  call provider.close()
  if provider.health_error() \= "" then do
    say "FAIL: provider cleanup " || provider.health_error()
    return 1
  end
  if result.status() \= 0 then do
    failure = result.error()
    say "FAIL: " || failure.category() || " " || failure.message()
    return 1
  end
  say "PASS: Codex App Server returned managed account status and schema-validated structured output"
  return 0
