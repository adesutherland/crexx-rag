options levelg

import rxfnsb
import sqlite_boundary
import ragstore
import ragingest
import ragfolder
import ragclaims
import ragimprove
import ragjob
import ragwork

tutorialprovider: class implements .ragworkprovider
  _proposal = .ragextractionproposal

  *: factory
    arg proposal = .ragextractionproposal
    _proposal = proposal
    return

  extract: method = .ragworkproviderresult
    arg claim = .ragworkclaim
    return .ragworkproviderresult(0, "tutorial-fixture", "deterministic-v1", "request-" || claim.attempt_id(), 96, 48, 0, 5, 0, _proposal, "")

scalartext: procedure = .string
  arg database = .binary, sql = .string
  prepared = .binary
  if sqliteprepare(database, sql, prepared) \= 0 | sqlitestep(prepared) \= 100 then do; call sqlitefinalize prepared; return ""; end
  value = ""; status = sqlitecolumntext(prepared, 0, value); call sqlitefinalize prepared
  if status \= 0 then return ""
  return value

promote: procedure = .string
  arg store = .ragstorehandle, candidate_label = .string, canonical_label = .string, concept_type = .string, policy = .ragclaimpolicy, expose error = .string
  candidate = scalartext(store.database(), "SELECT c.candidate_id FROM candidate_mentions c JOIN candidate_decisions d ON d.candidate_id=c.candidate_id AND d.state='accepted' WHERE c.normalized_candidate='" || candidate_label || "' AND c.visible_to_generation IS NULL ORDER BY c.candidate_id LIMIT 1")
  aliases = .string[]; aliases[1] = candidate_label; ambiguity = .string[]; concept_id = ""
  if promotemention(store, candidate, canonical_label, concept_type, aliases, ambiguity, policy, "config-tutorial-p4", concept_id, error) \= 0 then return ""
  return concept_id

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
library_path = args[1]; fixture_root = args[2]
error = ""; store = .ragstorehandle
if initragstore(library_path, "tutorial-phase4", "config-tutorial-p4", "tutorial", "1", "balanced", "profile-hash-tutorial-p4", "config-hash-tutorial-p4", '{}', store, error) \= 0 then do; say "ERROR=" || error; return 1; end
observations = .ragsourceobservation[]
if collectfolderobservations(fixture_root, "architecture-mini", 1, 1048576, "2026-08-23T12:00:00Z", observations, error) \= 3 then do; say "ERROR=" || error; return 1; end
ingest_plan = .ragingestplan
if createingestplan(store, "folder:architecture-mini", "config-tutorial-p4", "tutorial-claim-policy-v1", "tutorial-parser-v1", 512, observations, ingest_plan, error) \= 0 then do; say "ERROR=" || error; return 1; end
ingest = applyingestplan(store, ingest_plan, observations)
if ingest.ok() \= 1 then do; say "ERROR=" || ingest.error(); return 1; end
say '{"step":"ingest","generation":2,"sources":3,"chunks":5,"provider_calls":0}'

claim_policy = .ragclaimpolicy("tutorial-claim-policy-v1", "database|service", "depends-on", 1000, 700, 600, 500, 300)
identity = promote(store, "identity", "Identity Gateway", "service", claim_policy, error)
cedar = promote(store, "cedar", "Cedar Store", "database", claim_policy, error)
if identity = "" | cedar = "" then do; say "ERROR=" || error; return 1; end
say '{"step":"concepts","generation":4,"canonical":2,"ambiguities":0}'

chunk = scalartext(store.database(), "SELECT c.revision_chunk_id FROM revision_chunks c JOIN chunk_contents t ON t.content_id=c.content_id WHERE t.text LIKE '%Identity Gateway authenticates%' AND c.visible_to_generation IS NULL LIMIT 1")
body = scalartext(store.database(), "SELECT t.text FROM revision_chunks c JOIN chunk_contents t ON t.content_id=c.content_id WHERE c.revision_chunk_id='" || chunk || "'")
span_start = pos("Identity Gateway", body) - 1
span_end = pos("Cedar Store.", body) - 1 + length("Cedar Store.")
proposal = .ragextractionproposal("crexx-rag.extraction-proposal/1", "tutorial-proposal", "claim", identity, "Identity Gateway", "service", "depends-on", cedar, "Cedar Store", "database", "outbound", '{}', "2026-08-23T00:00:00Z", "", chunk, span_start, span_end, "support", "assertion", "direct", "", "tutorial-independent-source", 950000, "tutorial-fixture", "deterministic-v1", "tutorial-request", "tutorial-prompt-v1", "tutorial-extractor-v1", "fixture://architecture-mini/README.md", "balanced", 0)
validation = .ragproposalvalidation
if validateproposal(store, proposal, claim_policy, validation, error) \= 0 | validation.disposition() \= "accepted" then do; say "ERROR=" || error || validation.reason(); return 1; end
rank = .ragextractionrank
if rankchunk(store, chunk, "tutorial-claim-policy-v1", rank, error) \= 0 then do; say "ERROR=" || error; return 1; end
say '{"step":"validate","disposition":"accepted","direction":"outbound","stance":"assertion","lineage":"explicit","rank_fingerprint":"sha256"}'

triggers = .string[]; triggers[1] = "profile-change"
improve_plan = .ragimproveplan
if createimproveplan(store, "config-tutorial-p4", "tutorial-claim-policy-v1", "tutorial-prompt-v1", triggers, 5, 15, 4096, 8192, 500000, 1000000, 256, 512, 100000, 120000, 1, 3, "public", "tutorial-fixture-route", "env:OPENAI_API_KEY", improve_plan, error) \= 0 then do; say "ERROR=" || error; return 1; end
say '{"step":"improve-plan","schema":"crexx-rag.improve-plan/1","items":5,"model_call_budget":15,"trigger":"profile-change","secret_reference":"env:OPENAI_API_KEY"}'
apply_result = .ragimproveapplyresult
if applyimproveplan(store, improve_plan, apply_result, error) \= 0 then do; say "ERROR=" || error; return 1; end
say '{"step":"improve-apply","state":"queued","items":5,"provider_calls":0}'

provider = .tutorialprovider(proposal); processed = 0
if runworkerfollow(store, apply_result.job_id(), "tutorial-worker", 10, 3, 10, 2, 0, claim_policy, provider, processed, error) \= 0 then do; say "ERROR=" || error; return 1; end
job_status = .ragjobstatus
if readjobstatus(store, apply_result.job_id(), job_status, error) \= 0 then do; say "ERROR=" || error; return 1; end
say '{"step":"worker","processed":' || processed || ',"job_state":"' || job_status.state() || '","claims":1,"supports":1,"provider_calls":5}'

replay = .ragproposalresult
if applyproposal(store, proposal, claim_policy, 5, "config-tutorial-p4", replay, error) \= 0 then do; say "ERROR=" || error; return 1; end
say '{"step":"replay","disposition":"' || replay.disposition() || '","generation":' || replay.generation() || ',"library_writes":' || replay.writes() || '}'
call closeragstore store, error
return 0
