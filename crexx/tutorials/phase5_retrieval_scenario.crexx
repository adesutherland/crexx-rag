options levelg

import rxfnsb
import rxhash
import provider_contract
import ragstore
import ragingest
import ragfolder
import ragprofile
import it_architecture_profile
import ragquery
import ragembedding
import ragretrieval
import ragevidencejson

tutorialembeddingprovider: class implements .provider
  _calls = .int

  *: factory
    _calls = 0
    return

  calls: method = .int
    return _calls
  capabilities: method = .providercapabilities
    return .providercapabilities("fixture", 1, 1, 1, 1, 0, 0, 8192, 2)
  generate: method = .providerresult
    arg request = .providerrequest
    result = .providerresult(); call result.set_failure("fixture", request.model(), request.request_id(), .providererror("unsupported", -120, 0, 0, 0, "generation is not used by this tutorial"))
    return result
  generate_structured: method = .providerresult
    arg request = .providerrequest
    result = .providerresult(); call result.set_failure("fixture", request.model(), request.request_id(), .providererror("unsupported", -120, 0, 0, 0, "generation is not used by this tutorial"))
    return result
  embed: method = .providerresult
    arg request = .providerrequest
    _calls = _calls + 1; inputs = request.inputs(); vectors = .embeddingrecord[]
    vectors[1] = .embeddingrecord("f32le-v1", 4, tutorialvector(inputs[1]))
    result = .providerresult(); call result.set_embeddings("fixture", request.model(), request.request_id(), vectors, .providerusage(3, 0, 1, 0), 1000)
    return result
  embed_batch: method = .providerresult
    arg request = .providerrequest
    _calls = _calls + 1; inputs = request.inputs(); vectors = .embeddingrecord[]
    do i = 1 to inputs.0
      vectors[i] = .embeddingrecord("f32le-v1", 4, tutorialvector(inputs[i]))
    end
    result = .providerresult(); call result.set_embeddings("fixture", request.model(), request.request_id(), vectors, .providerusage(inputs.0 * 3, 0, inputs.0, 0), 1000)
    return result
  cancel: method = .providerresult
    arg request_id = .string
    result = .providerresult(); call result.set_failure("fixture", "", request_id, .providererror("unsupported", -120, 0, 0, 0, "cancellation is not used by this tutorial"))
    return result

tutorialvector: procedure = .binary
  arg text = .string
  lower_text = lower(text); values = .float[]
  do i = 1 to 4; values[i] = 0.0; end
  if pos("identity", lower_text) > 0 | pos("authentic", lower_text) > 0 then values[1] = 1.0
  if pos("cedar", lower_text) > 0 | pos("policy", lower_text) > 0 | pos("store", lower_text) > 0 then values[2] = 1.0
  if pos("audit", lower_text) > 0 | pos("decision", lower_text) > 0 then values[3] = 1.0
  if pos("vault", lower_text) > 0 | pos("credential", lower_text) > 0 then values[4] = 1.0
  if values[1] + values[2] + values[3] + values[4] = 0.0 then values[1] = 0.1
  payload = .binary; call binresize payload, 16
  do i = 1 to 4; <at..f32>((i - 1) * 4) payload = values[i]; end
  return payload

queryvector: procedure = .binary
  arg backend = .provider, question = .string
  messages = .providermessage[]; inputs = .string[]; inputs[1] = question
  request = .providerrequest("embed", "embedding", "tutorial-embedding", messages, inputs, "", 1000, 1, "local", "tutorial-query", "tutorial-query", 0, 4, 0)
  output = backend.embed(request); vectors = output.embeddings()
  if output.status() \= 0 | vectors.0 \= 1 then return ''x as .binary
  return vectors[1].payload()

fail: procedure = .int
  arg message = .string
  say "ERROR=" || message
  return 1

main: procedure = .int
arg args = .string[]
if args.0 < 2 then return 2
library_path = args[1]; fixture_root = args[2]
error = ""; store = .ragstorehandle
if initragstore(library_path, "tutorial-phase5", "config-tutorial-p5", "tutorial", "1", "it-architecture-profile", "profile-hash-tutorial-p5", "config-hash-tutorial-p5", '{}', store, error) \= 0 then return fail(error)
observations = .ragsourceobservation[]
if collectfolderobservations(fixture_root, "architecture-mini", 1, 1048576, "2026-08-23T12:00:00Z", observations, error) \= 3 then return fail(error)
ingest_plan = .ragingestplan
if createingestplan(store, "folder:architecture-mini", "config-tutorial-p5", "tutorial-retrieval-v1", "tutorial-parser-v1", 512, observations, ingest_plan, error) \= 0 then return fail(error)
ingest = applyingestplan(store, ingest_plan, observations)
if ingest.ok() \= 1 then return fail(ingest.error())

profile = itarchitectureprofile(); question = "Where is the authorization policy retained?"
query_plan = .ragqueryplan
if planquery(store, profile, question, "tutorial-retrieval-v1", query_plan, error) \= 0 | length(query_plan.fingerprint()) \= 64 then return fail(error)
say '{"step":"plan","schema":"' || query_plan.schema() || '","fingerprint":"sha256","provider_calls":0}'

provider = .tutorialembeddingprovider()
envelope = rxhash..sha256hex("tutorial-envelope-v1" as .binary)
if registerembeddingprofile(store, "tutorial-embedding", "fixture", "tutorial-embedding", 4, envelope, error) \= 0 then return fail(error)
embedding = .ragembeddingresult
if embedmissing(store, "tutorial-embedding", provider, "local", "local", 100, 2, 1000, embedding, error) \= 0 | embedding.state() \= "complete" then return fail(error)
say '{"step":"embed","state":"complete","embedded":' || embedding.embedded() || ',"provider_calls":' || embedding.provider_calls() || ',"credentials_used":0}'

vector_generation = .ragvectorgenerationresult
if buildexactvectorgeneration(store, "tutorial-embedding", 1000, vector_generation, error) \= 0 | vector_generation.state() \= "published" then return fail(error)
say '{"step":"publish-vector","state":"published","dimension":' || vector_generation.dimension() || ',"rows":' || vector_generation.rows() || ',"format":"rxvec"}'

retrieval_options = .ragretrievaloptions("tutorial-retrieval-v1", "tutorial-embedding", queryvector(provider, question), 24, 12, 1000, 2, 6, 4, 4, 60)
retrieval = .ragretrievalresult
if retrieveevidence(store, profile, question, retrieval_options, retrieval, error) \= 0 | retrieval.vector_state() \= "active-exact-rxvector" then return fail(error)
evidence = retrieval.evidence(); passages = .ragpassage[]; passages = evidence.passages()
if passages.0 < 1 then return fail("retrieval returned no passage")
say '{"step":"retrieve","state":"complete","vector_state":"active-exact-rxvector","passages":' || passages.0 || ',"candidate_ceiling":24}'

context = ""
if encodeanswercontext(evidence, 65536, context, error) \= 0 | pos('"schema":"crexx-rag.answer-context/1"', context) = 0 | pos('"citation":"crexx-rag:', context) = 0 then return fail(error)
say '{"step":"answer-context","schema":"crexx-rag.answer-context/1","bounded_bytes":65536,"stable_citations":true}'

resolved = .ragpassage
if resolvecitation(store, passages[1].citation(), resolved, error) \= 0 | resolved.text() = "" then return fail(error)
say '{"step":"resolve","immutable_revision":true,"utf8_byte_span":true,"same_library":true}'
call closeragstore store, error
return 0
