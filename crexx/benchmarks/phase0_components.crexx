options levelb

import rxfnsb
import rxjson
import rxhttp

arg args = .string[]

vm_name = "unknown"
provider_port = 18765
if args.0 >= 1 then vm_name = args[1]
if args.0 >= 2 then provider_port = args[2]

say "runtime,component,elapsed_us,operations,bytes,checksum,status"

algorithm_iterations = 2000
algorithm_checksum = 0
start = time("us")
do i = 1 to algorithm_iterations
  text = translate("Identity Gateway depends on Cedar Store and Vault Service " || i)
  algorithm_checksum = algorithm_checksum + pos("CEDAR STORE", text) + words(text)
end
say row(vm_name, "crexx_algorithm", elapsed_us(start), algorithm_iterations, 0, algorithm_checksum, "ok")

payload = '{"candidates":[{"content":{"parts":[{"text":"Cedar Store \\u2713"}]}}],"usageMetadata":{"promptTokenCount":8},"nullable":null,"items":[1,2,3]}'
json_iterations = 1000
parse_checksum = 0
start = time("us")
do i = 1 to json_iterations
  text = jsonget(payload, "candidates.1.content.parts.1.text")
  token_count = jsonget(payload, "usageMetadata.promptTokenCount")
  if jsontype(payload, "nullable") = "null" then parse_checksum = parse_checksum + length(text) + token_count
end
say row(vm_name, "json_parse", elapsed_us(start), json_iterations, length(payload), parse_checksum, "ok")

record_count = 512
texts = .string[]
scores = .float[]
types = .string[]
record_checksum = 0.0
start = time("us")
do i = 1 to record_count
  texts[i] = "record-" || i || "-Cedar Store"
  scores[i] = (i as .float) / 10.0
  types[i] = "data-object"
  record_checksum = record_checksum + length(texts[i]) + scores[i]
end
record_elapsed = elapsed_us(start)
say row(vm_name, "record_materialize", record_elapsed, record_count, 0, record_checksum, "ok")

encode_iterations = 1000
encode_checksum = 0
keys = .string[]
values = .string[]
keys[1] = "text"
keys[2] = "score"
keys[3] = "nullable"
start = time("us")
do i = 1 to encode_iterations
  values[1] = jsonquote("Cedar Store " || i)
  values[2] = i
  values[3] = "null"
  encoded = jsonobject(keys, values)
  encode_checksum = encode_checksum + length(encoded)
end
say row(vm_name, "json_encode", elapsed_us(start), encode_iterations, 0, encode_checksum, "ok")

client = .httpclient("127.0.0.1", provider_port, 5000, 0)
request_body = '{"prompt":"phase0 deterministic provider wait"}'
start = time("us")
response = client.post("/v1/generate", request_body, "application/json")
provider_elapsed = elapsed_us(start)
provider_status = "ok"
if client.status() <> 0 then provider_status = "error-" || client.status()
if pos('"text":"loopback-ok"', response) = 0 then provider_status = "malformed"
say row(vm_name, "provider_wait", provider_elapsed, 1, length(response), (length(response) as .float), provider_status)

if provider_status <> "ok" then exit 1
exit 0

elapsed_us: procedure = .int
  arg start = .int
  elapsed = time("us") - start
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

row: procedure = .string
  arg runtime = .string, component = .string, elapsed = .int, operations = .int, bytes = .int, checksum = .float, status = .string
  return runtime || "," || component || "," || elapsed || "," || operations || "," || bytes || "," || checksum || "," || status
